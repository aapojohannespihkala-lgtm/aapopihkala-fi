{
  "name": "aapopihkala-fi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/current/electricity",
      "/api/current/electricity-month",
      "/api/current/hsl",
      "/api/current/markets",
      "/api/current/news",
      "/api/current/liiga",
      "/api/current/liiga-schedule"
    ]
  },
  "d1_databases": [
    {
      "binding": "HSL_MODEL_DB",
      "database_name": "aapopihkala-hsl-eta",
      "database_id": "9a761c4f-4c08-46b1-a0bd-480af8d4d5a1"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
