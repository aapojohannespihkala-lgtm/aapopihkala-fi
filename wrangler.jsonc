{
  "name": "aapopihkala-fi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-06",
  "secrets": {
    "required": ["DIGITRANSIT_API_KEY"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/current/electricity",
      "/api/current/electricity-month",
      "/api/current/hsl",
      "/api/current/markets",
      "/api/current/widget",
      "/api/current/widget-v2",
      "/api/current/news",
      "/api/current/liiga",
      "/api/current/liiga-schedule"
    ]
  },
  "observability": {
    "enabled": true
  }
}
