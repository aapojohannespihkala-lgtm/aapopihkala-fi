---
interface Props {
  class?: string;
  autoRotate?: boolean;
  buzz?: boolean;
  enableZoom?: boolean;
  scale?: number;
  cameraDistance?: number;
}

const {
  class: className,
  autoRotate = true,
  buzz = true,
  enableZoom = true,
  scale = 1,
  cameraDistance = 6.8,
} = Astro.props;
---

<div
  class:list={['point-bee', className]}
  data-point-bee
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-buzz={buzz ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-scale={scale}
  data-camera-distance={cameraDistance}
  aria-hidden="true"
>
  <canvas class="point-bee__canvas" data-point-bee-canvas></canvas>
</div>

<style>
  .point-bee {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 280px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .point-bee:active {
    cursor: grabbing;
  }

  .point-bee__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-point-bee]');

    roots.forEach(async (root) => {
      if (root.dataset.pointBeeInitialized === 'true') return;
      root.dataset.pointBeeInitialized = 'true';

      const canvas = root.querySelector('[data-point-bee-canvas]');
      if (!canvas) return;

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        );

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const wantsAutoRotate = root.dataset.autoRotate !== 'false';
        const wantsBuzz = root.dataset.buzz !== 'false';
        const wantsZoom = root.dataset.enableZoom !== 'false';
        const requestedScale = Number(root.dataset.scale ?? '1');
        const requestedCameraDistance = Number(root.dataset.cameraDistance ?? '6.8');
        const displayScale = Number.isFinite(requestedScale) ? requestedScale : 1;
        const cameraDistance = Number.isFinite(requestedCameraDistance)
          ? requestedCameraDistance
          : 6.8;

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        });

        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
        renderer.setClearColor(0xffffff, 0);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
        camera.position.set(0, 0.12, cameraDistance);

        const specimen = new THREE.Group();
        specimen.rotation.x = -0.06;
        specimen.rotation.z = 0.035;
        specimen.scale.setScalar(displayScale);
        scene.add(specimen);

        const controls = new OrbitControls(camera, renderer.domElement);
        controls.enablePan = false;
        controls.enableZoom = wantsZoom;
        controls.minDistance = 5.2;
        controls.maxDistance = 9.8;
        controls.zoomSpeed = 0.55;
        controls.enableDamping = true;
        controls.dampingFactor = 0.055;
        controls.rotateSpeed = 0.55;
        controls.target.set(0, 0.08, 0);
        controls.autoRotate = wantsAutoRotate && !reducedMotion;
        controls.autoRotateSpeed = 0.3;

        const bodyPointMaterial = new THREE.PointsMaterial({
          color: 0x30332f,
          size: 0.03,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.82,
        });

        const bandPointMaterial = new THREE.PointsMaterial({
          color: 0x687067,
          size: 0.031,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.72,
        });

        const wingPointMaterial = new THREE.PointsMaterial({
          color: 0x59695d,
          size: 0.023,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.42,
        });

        const wingLineMaterial = new THREE.LineBasicMaterial({
          color: 0x69756b,
          transparent: true,
          opacity: 0.48,
        });

        const appendageMaterial = new THREE.LineBasicMaterial({
          color: 0x596158,
          transparent: true,
          opacity: 0.7,
        });

        const bodyPositions = [];
        const bandPositions = [];
        const bodyGeometries = [];
        const lineGeometries = [];

        const addEllipsoidPoints = (
          center,
          radiusX,
          radiusY,
          radiusZ,
          latSteps,
          lonSteps,
          target = bodyPositions
        ) => {
          for (let lat = 1; lat < latSteps; lat += 1) {
            const phi = (lat / latSteps) * Math.PI;
            const sinPhi = Math.sin(phi);
            const cosPhi = Math.cos(phi);

            for (let lon = 0; lon < lonSteps; lon += 1) {
              const theta = (lon / lonSteps) * Math.PI * 2;
              target.push(
                center.x + Math.cos(theta) * sinPhi * radiusX,
                center.y + cosPhi * radiusY,
                center.z + Math.sin(theta) * sinPhi * radiusZ
              );
            }
          }
        };

        const abdomenRows = 64;
        const abdomenSides = 22;

        for (let yi = 0; yi <= abdomenRows; yi += 1) {
          const t = yi / abdomenRows;
          const y = THREE.MathUtils.lerp(-1.15, 0.22, t);
          const silhouette = Math.pow(Math.max(0, Math.sin(Math.PI * t)), 0.56);
          const radiusX = 0.13 + 0.31 * silhouette;
          const radiusZ = 0.11 + 0.27 * silhouette;
          const centerX = 0.025 * Math.sin(t * Math.PI * 1.2);

          const bandWave = 0.5 + 0.5 * Math.sin((t * 5.15 - 0.42) * Math.PI * 2);
          const isBand = t > 0.12 && t < 0.9 && bandWave > 0.7;

          for (let ai = 0; ai < abdomenSides; ai += 1) {
            const angle = (ai / abdomenSides) * Math.PI * 2;
            const target = isBand ? bandPositions : bodyPositions;
            target.push(
              centerX + Math.cos(angle) * radiusX,
              y,
              Math.sin(angle) * radiusZ
            );
          }
        }

        addEllipsoidPoints(
          new THREE.Vector3(0, 0.38, 0),
          0.4,
          0.48,
          0.35,
          24,
          30
        );

        addEllipsoidPoints(
          new THREE.Vector3(0, 0.98, 0),
          0.285,
          0.3,
          0.265,
          20,
          26
        );

        const bodyGeometry = new THREE.BufferGeometry();
        bodyGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(bodyPositions, 3)
        );
        bodyGeometries.push(bodyGeometry);
        specimen.add(new THREE.Points(bodyGeometry, bodyPointMaterial));

        const bandGeometry = new THREE.BufferGeometry();
        bandGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(bandPositions, 3)
        );
        bodyGeometries.push(bandGeometry);
        specimen.add(new THREE.Points(bandGeometry, bandPointMaterial));

        const makeLine = (points, material = appendageMaterial) => {
          const geometry = new THREE.BufferGeometry().setFromPoints(points);
          lineGeometries.push(geometry);
          return new THREE.Line(geometry, material);
        };

        const makeWingSurface = (side, rear = false) => {
          const group = new THREE.Group();
          group.position.set(side * 0.12, 0.38, 0);

          const positions = [];
          const lengthSteps = rear ? 36 : 52;
          const widthSteps = rear ? 20 : 28;
          const length = rear ? 0.95 : 1.42;
          const baseWidth = rear ? 0.38 : 0.55;
          const yRise = rear ? 0.16 : 0.34;

          for (let li = 0; li <= lengthSteps; li += 1) {
            const u = li / lengthSteps;
            const taper = Math.pow(Math.sin(Math.PI * Math.min(0.98, u + 0.02)), 0.58);
            const halfWidth = baseWidth * taper * (1 - 0.17 * u);

            for (let wi = 0; wi <= widthSteps; wi += 1) {
              const v = THREE.MathUtils.lerp(-1, 1, wi / widthSteps);
              const x = side * (0.05 + u * length);
              const y = yRise * u + v * halfWidth;
              const z = 0.035 * Math.sin(Math.PI * u) * (1 - v * v);
              positions.push(x, y, z);
            }
          }

          const geometry = new THREE.BufferGeometry();
          geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
          bodyGeometries.push(geometry);
          group.add(new THREE.Points(geometry, wingPointMaterial));

          const outline = [];
          const outlineSteps = 58;

          for (let i = 0; i <= outlineSteps; i += 1) {
            const u = i / outlineSteps;
            const taper = Math.pow(Math.sin(Math.PI * Math.min(0.98, u + 0.02)), 0.58);
            const halfWidth = baseWidth * taper * (1 - 0.17 * u);
            outline.push(
              new THREE.Vector3(
                side * (0.05 + u * length),
                yRise * u + halfWidth,
                0.003
              )
            );
          }

          for (let i = outlineSteps; i >= 0; i -= 1) {
            const u = i / outlineSteps;
            const taper = Math.pow(Math.sin(Math.PI * Math.min(0.98, u + 0.02)), 0.58);
            const halfWidth = baseWidth * taper * (1 - 0.17 * u);
            outline.push(
              new THREE.Vector3(
                side * (0.05 + u * length),
                yRise * u - halfWidth,
                0.003
              )
            );
          }

          outline.push(outline[0].clone());
          group.add(makeLine(outline, wingLineMaterial));

          const centerVein = [];
          for (let i = 0; i <= 28; i += 1) {
            const u = i / 28;
            centerVein.push(
              new THREE.Vector3(
                side * (0.05 + u * length * 0.94),
                yRise * u,
                0.006
              )
            );
          }
          group.add(makeLine(centerVein, wingLineMaterial));

          return group;
        };

        const leftWings = new THREE.Group();
        const rightWings = new THREE.Group();

        const leftForeWing = makeWingSurface(-1, false);
        const leftRearWing = makeWingSurface(-1, true);
        const rightForeWing = makeWingSurface(1, false);
        const rightRearWing = makeWingSurface(1, true);

        leftRearWing.position.y -= 0.18;
        leftRearWing.rotation.z = -0.16;
        rightRearWing.position.y -= 0.18;
        rightRearWing.rotation.z = 0.16;

        leftWings.add(leftForeWing, leftRearWing);
        rightWings.add(rightForeWing, rightRearWing);
        specimen.add(leftWings, rightWings);

        const legAnchors = [0.62, 0.34, 0.06];
        legAnchors.forEach((anchorY, index) => {
          [-1, 1].forEach((side) => {
            const forward = 0.26 - index * 0.2;
            const kneeY = anchorY - 0.34 - index * 0.04;
            const reach = 0.68 + index * 0.11;
            const curve = new THREE.CatmullRomCurve3([
              new THREE.Vector3(side * 0.22, anchorY, -0.02),
              new THREE.Vector3(side * 0.45, kneeY, forward),
              new THREE.Vector3(side * reach, kneeY - 0.28, forward + 0.08),
              new THREE.Vector3(side * (reach + 0.24), kneeY - 0.36, forward + 0.03),
            ]);
            specimen.add(makeLine(curve.getPoints(24)));
          });
        });

        [-1, 1].forEach((side) => {
          const curve = new THREE.CatmullRomCurve3([
            new THREE.Vector3(side * 0.11, 1.18, 0),
            new THREE.Vector3(side * 0.2, 1.4, 0.025),
            new THREE.Vector3(side * 0.38, 1.55, 0.06),
            new THREE.Vector3(side * 0.55, 1.6, 0.075),
          ]);
          specimen.add(makeLine(curve.getPoints(28)));
        });

        const resize = () => {
          const rect = root.getBoundingClientRect();
          const width = Math.max(1, Math.round(rect.width));
          const height = Math.max(1, Math.round(rect.height));

          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(root);
        resize();

        let isVisible = true;
        let isDocumentVisible = !document.hidden;
        let animationFrame = 0;

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting);
          },
          { rootMargin: '160px' }
        );
        intersectionObserver.observe(root);

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden;
        };
        document.addEventListener('visibilitychange', handleVisibility);

        const animatesBee = wantsBuzz && !reducedMotion;

        const animate = (time) => {
          animationFrame = requestAnimationFrame(animate);
          if (!isVisible || !isDocumentVisible) return;

          controls.update();

          if (animatesBee) {
            const phase = time * 0.018;
            const wingAngle = 0.16 + 0.46 * (0.5 + 0.5 * Math.sin(phase));

            leftWings.rotation.y = wingAngle;
            rightWings.rotation.y = -wingAngle;

            specimen.position.y = 0.014 * Math.sin(time * 0.0062);
            specimen.position.x = 0.008 * Math.sin(time * 0.0084 + 0.7);
            specimen.rotation.z = 0.035 + 0.01 * Math.sin(time * 0.0041);
          } else {
            leftWings.rotation.y = 0.22;
            rightWings.rotation.y = -0.22;
          }

          renderer.render(scene, camera);
        };

        animationFrame = requestAnimationFrame(animate);

        const cleanup = () => {
          cancelAnimationFrame(animationFrame);
          document.removeEventListener('visibilitychange', handleVisibility);
          resizeObserver.disconnect();
          intersectionObserver.disconnect();
          controls.dispose();

          bodyGeometries.forEach((geometry) => geometry.dispose());
          lineGeometries.forEach((geometry) => geometry.dispose());

          bodyPointMaterial.dispose();
          bandPointMaterial.dispose();
          wingPointMaterial.dispose();
          wingLineMaterial.dispose();
          appendageMaterial.dispose();
          renderer.dispose();
        };

        window.addEventListener('pagehide', cleanup, { once: true });
      } catch (error) {
        console.error('PointBee failed to initialize:', error);
      }
    });
  })();
</script>
