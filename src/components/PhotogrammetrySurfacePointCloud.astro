<div class="photogrammetry-surface-point-cloud" data-photogrammetry-surface-point-cloud aria-label="Pyöriteltävä fotogrammetrian pinnan pistepilvi">
  <canvas class="photogrammetry-surface-point-cloud__canvas" data-photogrammetry-surface-point-cloud-canvas></canvas>
  <p class="photogrammetry-surface-point-cloud__status" data-photogrammetry-surface-point-cloud-status>Ladataan pistepilveä...</p>
</div>

<style>
  .photogrammetry-surface-point-cloud {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 420px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .photogrammetry-surface-point-cloud:active {
    cursor: grabbing;
  }

  .photogrammetry-surface-point-cloud__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }

  .photogrammetry-surface-point-cloud__status {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: 0;
    color: var(--stone-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .photogrammetry-surface-point-cloud__status[hidden] {
    display: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-photogrammetry-surface-point-cloud]');

    const estimateGeometryArea = (geometry, THREE) => {
      const position = geometry.getAttribute('position');
      if (!position || position.count < 3) return 0;

      const a = new THREE.Vector3();
      const b = new THREE.Vector3();
      const c = new THREE.Vector3();
      const ab = new THREE.Vector3();
      const ac = new THREE.Vector3();
      let area = 0;
      const index = geometry.getIndex();

      if (index) {
        for (let i = 0; i + 2 < index.count; i += 3) {
          a.fromBufferAttribute(position, index.getX(i));
          b.fromBufferAttribute(position, index.getX(i + 1));
          c.fromBufferAttribute(position, index.getX(i + 2));
          ab.subVectors(b, a);
          ac.subVectors(c, a);
          area += ab.cross(ac).length() * 0.5;
        }
      } else {
        for (let i = 0; i + 2 < position.count; i += 3) {
          a.fromBufferAttribute(position, i);
          b.fromBufferAttribute(position, i + 1);
          c.fromBufferAttribute(position, i + 2);
          ab.subVectors(b, a);
          ac.subVectors(c, a);
          area += ab.cross(ac).length() * 0.5;
        }
      }

      return area;
    };

    roots.forEach(async (root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.photogrammetrySurfacePointCloudInitialized === 'true') return;
      root.dataset.photogrammetrySurfacePointCloudInitialized = 'true';

      const canvas = root.querySelector('[data-photogrammetry-surface-point-cloud-canvas]');
      const status = root.querySelector('[data-photogrammetry-surface-point-cloud-status]');
      if (!(canvas instanceof HTMLCanvasElement)) return;

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        );
        const { GLTFLoader } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/loaders/GLTFLoader.js/+esm'
        );
        const { MeshSurfaceSampler } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/math/MeshSurfaceSampler.js/+esm'
        );

        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.setClearColor(0x000000, 0);
        renderer.outputColorSpace = THREE.SRGBColorSpace;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(36, 1, 0.01, 1000);
        const controls = new OrbitControls(camera, canvas);
        controls.enableDamping = true;
        controls.dampingFactor = 0.06;
        controls.enablePan = true;
        controls.enableZoom = true;
        controls.target.set(0, 0, 0);

        const loader = new GLTFLoader();
        loader.load(
          '/lab/photogrammetry-2026-09-04.glb',
          (gltf) => {
            const model = gltf.scene;
            model.updateMatrixWorld(true);

            const box = new THREE.Box3().setFromObject(model);
            const center = box.getCenter(new THREE.Vector3());
            const size = box.getSize(new THREE.Vector3());
            const radius = Math.max(size.x, size.y, size.z) * 0.5 || 1;

            const meshEntries = [];
            let totalArea = 0;

            model.traverse((child) => {
              if (!(child instanceof THREE.Mesh)) return;
              if (!(child.geometry instanceof THREE.BufferGeometry)) return;

              const area = estimateGeometryArea(child.geometry, THREE);
              if (area <= 0) return;

              child.updateWorldMatrix(true, false);
              meshEntries.push({ mesh: child, area });
              totalArea += area;
            });

            if (!meshEntries.length || totalArea <= 0) {
              if (status instanceof HTMLElement) status.textContent = 'Pistepilveä ei voitu muodostaa';
              return;
            }

            const cloudGroup = new THREE.Group();
            const totalPointBudget = 22000;

            meshEntries.forEach(({ mesh, area }) => {
              const sampleCount = Math.max(800, Math.round(totalPointBudget * (area / totalArea)));
              const sampler = new MeshSurfaceSampler(mesh).build();
              const positions = new Float32Array(sampleCount * 3);
              const sampledPosition = new THREE.Vector3();
              const sampledNormal = new THREE.Vector3();
              const worldPosition = new THREE.Vector3();

              for (let i = 0; i < sampleCount; i += 1) {
                sampler.sample(sampledPosition, sampledNormal);
                worldPosition.copy(sampledPosition).applyMatrix4(mesh.matrixWorld).sub(center);
                positions[i * 3] = worldPosition.x;
                positions[i * 3 + 1] = worldPosition.y;
                positions[i * 3 + 2] = worldPosition.z;
              }

              const pointGeometry = new THREE.BufferGeometry();
              pointGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

              const sourceMaterial = Array.isArray(mesh.material) ? mesh.material[0] : mesh.material;
              const pointColor = sourceMaterial?.color instanceof THREE.Color
                ? sourceMaterial.color.clone()
                : new THREE.Color(0x59695d);

              if (pointColor.r > 0.92 && pointColor.g > 0.92 && pointColor.b > 0.92) {
                pointColor.set(0x59695d);
              }

              const pointMaterial = new THREE.PointsMaterial({
                color: pointColor,
                size: Math.max(radius * 0.0105, 0.0035),
                sizeAttenuation: true,
                transparent: true,
                opacity: 0.96,
                depthWrite: false,
              });

              cloudGroup.add(new THREE.Points(pointGeometry, pointMaterial));
            });

            scene.add(cloudGroup);

            // Symmetric stylized eyewear. The frame is built as thin 3D tubes so
            // the outline remains readable from oblique angles and while orbiting.
            const glasses = new THREE.Group();
            const frameMaterial = new THREE.MeshBasicMaterial({
              color: 0x2f3732,
              transparent: true,
              opacity: 0.97,
              depthTest: true,
              depthWrite: true,
            });

            const frameRadius = Math.max(radius * 0.0042, 0.0015);
            const makeTube = (points, closed = false, tubeRadius = frameRadius) => {
              const curve = new THREE.CatmullRomCurve3(points, closed, 'centripetal', 0.5);
              const geometry = new THREE.TubeGeometry(
                curve,
                Math.max(28, points.length * 6),
                tubeRadius,
                7,
                closed
              );
              return new THREE.Mesh(geometry, frameMaterial);
            };

            const glassesY = size.y * 0.115;
            const frontZ = box.max.z - center.z + radius * 0.018;
            const lensCenterX = size.x * 0.145;
            const lensRx = size.x * 0.105;
            const lensRy = size.y * 0.073;

            const buildLens = (side) => {
              const points = [];
              const cx = side * lensCenterX;
              const segments = 48;

              for (let i = 0; i < segments; i += 1) {
                const t = (i / segments) * Math.PI * 2;
                const c = Math.cos(t);
                const s = Math.sin(t);

                // Rounded-rectangular lens shape with a slightly calmer brow line.
                const shapedX = Math.sign(c) * Math.pow(Math.abs(c), 0.82);
                const shapedY = Math.sign(s) * Math.pow(Math.abs(s), 0.9);
                const browScale = shapedY > 0 ? 0.93 : 1.0;
                const x = cx + lensRx * shapedX;
                const y = glassesY + lensRy * shapedY * browScale;

                // Gentle depth curvature follows a plausible face plane.
                const outerness = Math.min(1, Math.abs(x) / Math.max(size.x * 0.34, 0.001));
                const z = frontZ - radius * 0.016 * outerness;
                points.push(new THREE.Vector3(x, y, z));
              }

              return makeTube(points, true);
            };

            const leftLens = buildLens(-1);
            const rightLens = buildLens(1);

            const innerLeftX = -lensCenterX + lensRx * 0.96;
            const innerRightX = lensCenterX - lensRx * 0.96;
            const bridge = makeTube([
              new THREE.Vector3(innerLeftX, glassesY + lensRy * 0.08, frontZ),
              new THREE.Vector3(innerLeftX * 0.48, glassesY + lensRy * 0.30, frontZ + radius * 0.004),
              new THREE.Vector3(0, glassesY + lensRy * 0.34, frontZ + radius * 0.006),
              new THREE.Vector3(innerRightX * 0.48, glassesY + lensRy * 0.30, frontZ + radius * 0.004),
              new THREE.Vector3(innerRightX, glassesY + lensRy * 0.08, frontZ),
            ]);

            const buildTemple = (side) => {
              const outerX = side * (lensCenterX + lensRx * 0.98);
              return makeTube([
                new THREE.Vector3(outerX, glassesY + lensRy * 0.18, frontZ - radius * 0.012),
                new THREE.Vector3(side * size.x * 0.30, glassesY + lensRy * 0.16, frontZ - size.z * 0.035),
                new THREE.Vector3(side * size.x * 0.37, glassesY + lensRy * 0.02, frontZ - size.z * 0.12),
                new THREE.Vector3(side * size.x * 0.39, glassesY - lensRy * 0.12, frontZ - size.z * 0.19),
              ], false, frameRadius * 0.9);
            };

            const leftTemple = buildTemple(-1);
            const rightTemple = buildTemple(1);

            // Small symmetric hinge accents make the frame read as eyewear rather
            // than two floating loops while keeping the styling lightweight.
            const hingeGeometry = new THREE.SphereGeometry(frameRadius * 1.5, 10, 7);
            const leftHinge = new THREE.Mesh(hingeGeometry, frameMaterial);
            const rightHinge = new THREE.Mesh(hingeGeometry, frameMaterial);
            leftHinge.position.set(-(lensCenterX + lensRx), glassesY + lensRy * 0.15, frontZ - radius * 0.012);
            rightHinge.position.set(lensCenterX + lensRx, glassesY + lensRy * 0.15, frontZ - radius * 0.012);

            glasses.add(leftLens, rightLens, bridge, leftTemple, rightTemple, leftHinge, rightHinge);
            scene.add(glasses);

            camera.near = Math.max(radius / 1000, 0.001);
            camera.far = Math.max(radius * 100, 100);
            camera.position.set(radius * 1.7, radius * 0.85, radius * 2.0);
            camera.updateProjectionMatrix();

            controls.target.set(0, 0, 0);
            controls.minDistance = Math.max(radius * 0.18, 0.01);
            controls.maxDistance = radius * 12;
            controls.update();

            if (status instanceof HTMLElement) status.hidden = true;
          },
          undefined,
          () => {
            if (status instanceof HTMLElement) status.textContent = '3D-mallia ei voitu ladata';
          }
        );

        const resize = () => {
          const width = Math.max(1, root.clientWidth);
          const height = Math.max(1, root.clientHeight);
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        const observer = new ResizeObserver(resize);
        observer.observe(root);
        resize();

        const animate = () => {
          controls.update();
          renderer.render(scene, camera);
          requestAnimationFrame(animate);
        };
        animate();
      } catch {
        if (status instanceof HTMLElement) status.textContent = 'Pistepilvikatselinta ei voitu ladata';
      }
    });
  })();
</script>
