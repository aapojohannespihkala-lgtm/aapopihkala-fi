<div class="meshy-point-surface-v7" data-meshy-point-surface-v7 aria-label="Pyöriteltävä Meshy-pistepinta vol 7">
  <canvas class="meshy-point-surface-v7__canvas" data-meshy-point-surface-v7-canvas></canvas>
  <p class="meshy-point-surface-v7__status" data-meshy-point-surface-v7-status>Ladataan pistepintaa...</p>
</div>

<style>
  .meshy-point-surface-v7 {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 420px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .meshy-point-surface-v7:active { cursor: grabbing; }

  .meshy-point-surface-v7__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }

  .meshy-point-surface-v7__status {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: 0;
    color: var(--stone-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .meshy-point-surface-v7__status[hidden] { display: none; }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-meshy-point-surface-v7]');

    const estimateGeometryArea = (geometry, THREE) => {
      const position = geometry.getAttribute('position');
      if (!position || position.count < 3) return 0;

      const a = new THREE.Vector3();
      const b = new THREE.Vector3();
      const c = new THREE.Vector3();
      const ab = new THREE.Vector3();
      const ac = new THREE.Vector3();
      const index = geometry.getIndex();
      let area = 0;

      if (index) {
        for (let i = 0; i + 2 < index.count; i += 3) {
          a.fromBufferAttribute(position, index.getX(i));
          b.fromBufferAttribute(position, index.getX(i + 1));
          c.fromBufferAttribute(position, index.getX(i + 2));
          ab.subVectors(b, a);
          ac.subVectors(c, a);
          area += ab.cross(ac).length() * 0.5;
        }
      } else {
        for (let i = 0; i + 2 < position.count; i += 3) {
          a.fromBufferAttribute(position, i);
          b.fromBufferAttribute(position, i + 1);
          c.fromBufferAttribute(position, i + 2);
          ab.subVectors(b, a);
          ac.subVectors(c, a);
          area += ab.cross(ac).length() * 0.5;
        }
      }

      return area;
    };

    roots.forEach(async (root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.meshyPointSurfaceV7Initialized === 'true') return;
      root.dataset.meshyPointSurfaceV7Initialized = 'true';

      const canvas = root.querySelector('[data-meshy-point-surface-v7-canvas]');
      const status = root.querySelector('[data-meshy-point-surface-v7-status]');
      if (!(canvas instanceof HTMLCanvasElement)) return;

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        );
        const { GLTFLoader } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/loaders/GLTFLoader.js/+esm'
        );
        const { MeshSurfaceSampler } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/math/MeshSurfaceSampler.js/+esm'
        );

        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.setClearColor(0x000000, 0);
        renderer.outputColorSpace = THREE.SRGBColorSpace;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(36, 1, 0.01, 1000);
        const controls = new OrbitControls(camera, canvas);
        controls.enableDamping = true;
        controls.dampingFactor = 0.06;
        controls.enablePan = true;
        controls.enableZoom = true;
        controls.target.set(0, 0, 0);

        const loader = new GLTFLoader();
        loader.load(
          '/lab/meshy-pixelated-poise.glb',
          (gltf) => {
            const model = gltf.scene;
            model.updateMatrixWorld(true);

            const box = new THREE.Box3().setFromObject(model);
            const center = box.getCenter(new THREE.Vector3());
            const size = box.getSize(new THREE.Vector3());
            const radius = Math.max(size.x, size.y, size.z) * 0.5 || 1;

            const meshEntries = [];
            let totalArea = 0;

            model.traverse((child) => {
              if (!(child instanceof THREE.Mesh)) return;
              if (!(child.geometry instanceof THREE.BufferGeometry)) return;
              const area = estimateGeometryArea(child.geometry, THREE);
              if (area <= 0) return;
              child.updateWorldMatrix(true, false);
              meshEntries.push({ mesh: child, area });
              totalArea += area;
            });

            if (!meshEntries.length || totalArea <= 0) {
              if (status instanceof HTMLElement) status.textContent = 'Pistepintaa ei voitu muodostaa';
              return;
            }

            // Vol 4:n pohja pidetään samana: 42k pintapistettä, lasialueen 2x näytteistys,
            // kaulan leikkauspinnan vaimennus ja kamerasyvyyteen perustuva häivytys.
            const acceptedPositions = [];
            const acceptedBaseColors = [];
            const totalPointBudget = 42000;
            const backgroundColor = new THREE.Color(0xe9e9e4);
            const tempColor = new THREE.Color();

            meshEntries.forEach(({ mesh, area }) => {
              const baseTarget = Math.max(1400, Math.round(totalPointBudget * (area / totalArea)));
              const sampler = new MeshSurfaceSampler(mesh).build();
              const sampledPosition = new THREE.Vector3();
              const sampledNormal = new THREE.Vector3();
              const worldPosition = new THREE.Vector3();
              const worldNormal = new THREE.Vector3();
              const normalMatrix = new THREE.Matrix3().getNormalMatrix(mesh.matrixWorld);
              const sourceMaterial = Array.isArray(mesh.material) ? mesh.material[0] : mesh.material;
              const pointColor = sourceMaterial?.color instanceof THREE.Color
                ? sourceMaterial.color.clone()
                : new THREE.Color(0x6c786f);

              if (pointColor.r > 0.94 && pointColor.g > 0.94 && pointColor.b > 0.94) {
                pointColor.set(0x6c786f);
              }

              const lowerBandTop = -size.y * 0.31;
              const lowerBandBottom = -size.y * 0.44;
              const maxAttempts = baseTarget * 20;
              let acceptedForMesh = 0;
              let attempts = 0;

              while (acceptedForMesh < baseTarget && attempts < maxAttempts) {
                attempts += 1;
                sampler.sample(sampledPosition, sampledNormal);
                worldPosition.copy(sampledPosition).applyMatrix4(mesh.matrixWorld).sub(center);
                worldNormal.copy(sampledNormal).applyMatrix3(normalMatrix).normalize();

                const inNeckCutBand = worldPosition.y < lowerBandTop && worldPosition.y > lowerBandBottom;
                const nearlyHorizontalSurface = Math.abs(worldNormal.y) > 0.72;
                if (inNeckCutBand && nearlyHorizontalSurface && Math.random() > 0.12) continue;

                const nx = size.x > 0 ? worldPosition.x / (size.x * 0.5) : 0;
                const ny = size.y > 0 ? worldPosition.y / (size.y * 0.5) : 0;
                const nz = size.z > 0 ? worldPosition.z / (size.z * 0.5) : 0;

                const eyeBand = ny > -0.02 && ny < 0.34;
                const centralFaceBand = Math.abs(nx) < 0.62;
                const frontBias = nz > -0.18;
                const glassesZone = eyeBand && centralFaceBand && frontBias;

                const repetitions = glassesZone ? 2 : 1;
                for (let repeat = 0; repeat < repetitions && acceptedForMesh < baseTarget; repeat += 1) {
                  acceptedPositions.push(worldPosition.x, worldPosition.y, worldPosition.z);
                  acceptedBaseColors.push(pointColor.r, pointColor.g, pointColor.b);
                  acceptedForMesh += 1;
                }
              }
            });

            const pointCount = Math.floor(acceptedPositions.length / 3);
            if (!pointCount) {
              if (status instanceof HTMLElement) status.textContent = 'Pistepintaa ei voitu muodostaa';
              return;
            }

            const geometry = new THREE.BufferGeometry();
            geometry.setAttribute('position', new THREE.Float32BufferAttribute(acceptedPositions, 3));
            geometry.setAttribute('color', new THREE.Float32BufferAttribute(acceptedBaseColors, 3));

            const material = new THREE.PointsMaterial({
              size: Math.max(radius * 0.0085, 0.0035),
              sizeAttenuation: true,
              transparent: true,
              opacity: 0.98,
              depthWrite: false,
              vertexColors: true,
            });
            scene.add(new THREE.Points(geometry, material));

            // Vol 7: tumma lisäkerros rajataan vain silmälasien kehyksiin ja sankoihin.
            // Kehykset tunnistetaan kahden linssin elliptisistä reunavyöhykkeistä sekä sillasta.
            // Sangat rajataan hyvin kapealle korkeudelle ja ne katkaistaan ennen korvan etureunaa.
            const glassesPositions = [];
            const glassesBaseColor = new THREE.Color(0x344038);

            meshEntries.forEach(({ mesh }) => {
              const position = mesh.geometry.getAttribute('position');
              if (!position) return;
              const worldPosition = new THREE.Vector3();

              for (let i = 0; i < position.count; i += 1) {
                worldPosition.fromBufferAttribute(position, i).applyMatrix4(mesh.matrixWorld).sub(center);

                const nx = size.x > 0 ? worldPosition.x / (size.x * 0.5) : 0;
                const ny = size.y > 0 ? worldPosition.y / (size.y * 0.5) : 0;
                const nz = size.z > 0 ? worldPosition.z / (size.z * 0.5) : 0;

                // Kehysten rajaus. Ellipsit seuraavat GLB:n oikeita linssikehyksiä,
                // ja korkea z-raja estää tummennusta osumasta silmiin, ihoon tai kulmakarvoihin.
                const leftLensRing = Math.pow((nx + 0.34) / 0.29, 2) + Math.pow((ny - 0.155) / 0.105, 2);
                const rightLensRing = Math.pow((nx - 0.34) / 0.29, 2) + Math.pow((ny - 0.155) / 0.105, 2);
                const onLensFrame = (
                  ((leftLensRing > 0.82 && leftLensRing < 1.18) ||
                    (rightLensRing > 0.82 && rightLensRing < 1.18)) &&
                  nz > 0.76
                );
                const onBridge = Math.abs(nx) < 0.14 && ny > 0.17 && ny < 0.22 && nz > 0.82;

                // Sankojen rajaus. nz > -0.12 katkaisee tumman osuuden juuri ennen korvan alkua,
                // eikä tumma kerros jatku korvan päälle tai sen taakse.
                const onTemple = (
                  Math.abs(nx) > 0.70 && Math.abs(nx) < 0.95 &&
                  ny > 0.18 && ny < 0.22 &&
                  nz > -0.12 && nz < 0.75
                );

                if (!(onLensFrame || onBridge || onTemple)) continue;
                glassesPositions.push(worldPosition.x, worldPosition.y, worldPosition.z);
              }
            });

            let glassesPositionAttribute = null;
            let glassesColorAttribute = null;
            let glassesBaseColors = null;
            let glassesDepthSamples = null;

            if (glassesPositions.length) {
              const glassesGeometry = new THREE.BufferGeometry();
              glassesGeometry.setAttribute('position', new THREE.Float32BufferAttribute(glassesPositions, 3));

              const glassesCount = Math.floor(glassesPositions.length / 3);
              const glassesColors = new Float32Array(glassesCount * 3);
              for (let i = 0; i < glassesCount; i += 1) {
                glassesColors[i * 3] = glassesBaseColor.r;
                glassesColors[i * 3 + 1] = glassesBaseColor.g;
                glassesColors[i * 3 + 2] = glassesBaseColor.b;
              }
              glassesGeometry.setAttribute('color', new THREE.BufferAttribute(glassesColors, 3));

              const glassesMaterial = new THREE.PointsMaterial({
                size: Math.max(radius * 0.0092, 0.0038),
                sizeAttenuation: true,
                transparent: true,
                opacity: 0.98,
                depthWrite: false,
                vertexColors: true,
              });
              scene.add(new THREE.Points(glassesGeometry, glassesMaterial));

              glassesPositionAttribute = glassesGeometry.getAttribute('position');
              glassesColorAttribute = glassesGeometry.getAttribute('color');
              glassesBaseColors = Float32Array.from(glassesColorAttribute.array);
              glassesDepthSamples = new Float32Array(glassesCount);
            }

            const positionAttribute = geometry.getAttribute('position');
            const colorAttribute = geometry.getAttribute('color');
            const baseColors = Float32Array.from(colorAttribute.array);
            const cameraSpacePoint = new THREE.Vector3();
            const depthSamples = new Float32Array(pointCount);
            const lastCameraPosition = new THREE.Vector3(Number.POSITIVE_INFINITY, Number.POSITIVE_INFINITY, Number.POSITIVE_INFINITY);
            const lastCameraQuaternion = new THREE.Quaternion();

            const updateDepthShading = () => {
              let minDepth = Number.POSITIVE_INFINITY;
              let maxDepth = Number.NEGATIVE_INFINITY;

              for (let i = 0; i < pointCount; i += 1) {
                cameraSpacePoint.fromBufferAttribute(positionAttribute, i).applyMatrix4(camera.matrixWorldInverse);
                const depth = -cameraSpacePoint.z;
                depthSamples[i] = depth;
                if (depth < minDepth) minDepth = depth;
                if (depth > maxDepth) maxDepth = depth;
              }

              const depthRange = Math.max(maxDepth - minDepth, 0.0001);

              for (let i = 0; i < pointCount; i += 1) {
                const depth01 = (depthSamples[i] - minDepth) / depthRange;
                const fade = Math.min(0.78, Math.max(0, depth01 * 0.88));
                tempColor.setRGB(
                  baseColors[i * 3],
                  baseColors[i * 3 + 1],
                  baseColors[i * 3 + 2]
                ).lerp(backgroundColor, fade);
                colorAttribute.setXYZ(i, tempColor.r, tempColor.g, tempColor.b);
              }
              colorAttribute.needsUpdate = true;

              // Myös tumma lasikerros seuraa täsmälleen vol 4:n syvyyshäivytystä.
              if (glassesPositionAttribute && glassesColorAttribute && glassesBaseColors && glassesDepthSamples) {
                const glassesCount = glassesPositionAttribute.count;
                for (let i = 0; i < glassesCount; i += 1) {
                  cameraSpacePoint.fromBufferAttribute(glassesPositionAttribute, i).applyMatrix4(camera.matrixWorldInverse);
                  glassesDepthSamples[i] = -cameraSpacePoint.z;
                }

                for (let i = 0; i < glassesCount; i += 1) {
                  const depth01 = (glassesDepthSamples[i] - minDepth) / depthRange;
                  const fade = Math.min(0.78, Math.max(0, depth01 * 0.88));
                  tempColor.setRGB(
                    glassesBaseColors[i * 3],
                    glassesBaseColors[i * 3 + 1],
                    glassesBaseColors[i * 3 + 2]
                  ).lerp(backgroundColor, fade);
                  glassesColorAttribute.setXYZ(i, tempColor.r, tempColor.g, tempColor.b);
                }
                glassesColorAttribute.needsUpdate = true;
              }
            };

            camera.near = Math.max(radius / 1000, 0.001);
            camera.far = Math.max(radius * 100, 100);
            camera.position.set(radius * 1.65, radius * 0.85, radius * 2.05);
            camera.updateProjectionMatrix();

            controls.target.set(0, 0, 0);
            controls.minDistance = Math.max(radius * 0.18, 0.01);
            controls.maxDistance = radius * 12;
            controls.update();
            updateDepthShading();
            lastCameraPosition.copy(camera.position);
            lastCameraQuaternion.copy(camera.quaternion);

            root.__meshyPointSurfaceV7Tick = () => {
              const moved = lastCameraPosition.distanceToSquared(camera.position) > 0.000001;
              const turned = 1 - Math.abs(lastCameraQuaternion.dot(camera.quaternion)) > 0.000001;
              if (moved || turned) {
                updateDepthShading();
                lastCameraPosition.copy(camera.position);
                lastCameraQuaternion.copy(camera.quaternion);
              }
            };

            if (status instanceof HTMLElement) status.hidden = true;
          },
          undefined,
          () => {
            if (status instanceof HTMLElement) status.textContent = '3D-mallia ei voitu ladata';
          }
        );

        const resize = () => {
          const width = Math.max(1, root.clientWidth);
          const height = Math.max(1, root.clientHeight);
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        const observer = new ResizeObserver(resize);
        observer.observe(root);
        resize();

        const animate = () => {
          controls.update();
          if (typeof root.__meshyPointSurfaceV7Tick === 'function') root.__meshyPointSurfaceV7Tick();
          renderer.render(scene, camera);
          requestAnimationFrame(animate);
        };
        animate();
      } catch {
        if (status instanceof HTMLElement) status.textContent = 'Pistepintakatselinta ei voitu ladata';
      }
    });
  })();
</script>
