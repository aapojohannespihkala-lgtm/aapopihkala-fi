<div class="site-grid-easter-egg" data-site-grid aria-hidden="true">
  <span class="site-grid-label">GRID / 32</span>
</div>

<div class="site-scroll-readout" data-scroll-readout aria-hidden="true">
  <span data-scroll-y>Y 0000</span>
  <span class="site-scroll-readout__separator">/</span>
  <span data-scroll-percent>0%</span>
</div>

<div class="site-a-readout" data-a-readout data-mode="" aria-hidden="true">
  <span class="site-a-readout__cross"></span>
  <span class="site-a-readout__label" data-a-readout-label>X 0000 / Y 0000 / ELEV +15.0</span>
</div>

<div class="site-a-axis" data-a-axis aria-hidden="true">
  <span class="site-a-axis__vertical" data-a-axis-vertical></span>
  <span class="site-a-axis__horizontal" data-a-axis-horizontal></span>
</div>

<div class="site-area-overlay" data-area-overlay aria-hidden="true">
  <svg class="site-area-svg" data-area-svg preserveAspectRatio="none" aria-hidden="true">
    <g class="site-area-topography" data-area-topography>
      <g class="site-area-points" data-area-points></g>
      <path class="site-area-contours" data-area-contours />
    </g>
    <path class="site-area-outline" data-area-path />
    <circle class="site-area-start" data-area-start r="4" />
    <g class="site-area-centroid-symbol" data-area-centroid-symbol>
      <circle class="site-area-centroid-ring" cx="0" cy="0" r="8" />
      <line x1="-12" y1="0" x2="12" y2="0" />
      <line x1="0" y1="-12" x2="0" y2="12" />
      <circle class="site-area-centroid-dot" cx="0" cy="0" r="1.6" />
    </g>
  </svg>
  <span class="site-area-label" data-area-label>AREA / DRAW</span>
  <span class="site-area-hint" data-area-hint>AREA / HOLD + DRAW</span>
</div>

<style>
  .site-grid-easter-egg {
    position: fixed;
    inset: 64px 0 0;
    z-index: 45;
    pointer-events: none;
    opacity: 0;
    background-image:
      linear-gradient(rgba(89, 105, 93, 0.075) 1px, transparent 1px),
      linear-gradient(90deg, rgba(89, 105, 93, 0.075) 1px, transparent 1px);
    background-size: 32px 32px;
    transition: opacity 120ms ease;
  }

  .site-grid-easter-egg.is-visible {
    opacity: 1;
  }

  .site-grid-label {
    position: absolute;
    right: 22px;
    bottom: 18px;
    color: var(--moss);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.58rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .site-scroll-readout {
    position: fixed;
    right: 22px;
    bottom: 42px;
    z-index: 46;
    display: flex;
    align-items: center;
    gap: 6px;
    pointer-events: none;
    opacity: 0;
    color: var(--moss-deep);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.47rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.05em;
    transform: translateY(3px);
    transition: opacity 140ms ease, transform 140ms ease;
  }

  .site-scroll-readout.is-visible {
    opacity: 0.72;
    transform: translateY(0);
  }

  .site-scroll-readout__separator {
    color: var(--stone-light);
  }

  .site-a-readout {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 75;
    width: 18px;
    height: 18px;
    pointer-events: none;
    opacity: 0;
    color: var(--moss-deep);
    transform: translate(-9px, -9px);
    transition: opacity 90ms ease;
  }

  .site-a-readout.is-visible {
    opacity: 0.84;
  }

  .site-a-readout__cross::before,
  .site-a-readout__cross::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .site-a-readout__cross::before {
    width: 18px;
    height: 1px;
  }

  .site-a-readout__cross::after {
    width: 1px;
    height: 18px;
  }

  .site-a-readout__label {
    position: absolute;
    left: 15px;
    top: 12px;
    padding: 3px 5px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--line-soft);
    color: var(--moss-deep);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.47rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .site-a-readout[data-mode='cross'] .site-a-readout__label,
  .site-a-readout[data-mode=''] .site-a-readout__label {
    display: none;
  }

  .site-a-axis {
    position: fixed;
    inset: 0;
    z-index: 71;
    pointer-events: none;
    opacity: 0;
    transition: opacity 90ms ease;
  }

  .site-a-axis.is-visible {
    opacity: 0.36;
  }

  .site-a-axis__vertical,
  .site-a-axis__horizontal {
    position: absolute;
    background: var(--moss-deep);
  }

  .site-a-axis__vertical {
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
  }

  .site-a-axis__horizontal {
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
  }

  .site-area-overlay {
    position: fixed;
    inset: 0;
    z-index: 73;
    display: none;
    pointer-events: none;
  }

  .site-area-overlay.is-visible {
    display: block;
  }

  .site-area-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .site-area-outline {
    fill: rgba(89, 105, 93, 0.018);
    stroke: var(--moss-deep);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    transition: stroke-width 100ms ease, fill 100ms ease;
  }

  .site-area-overlay.is-hovering-area .site-area-outline,
  .site-area-overlay.is-rotating-area .site-area-outline {
    fill: rgba(89, 105, 93, 0.032);
    stroke-width: 1.2;
  }

  .site-area-point {
    fill: var(--moss);
    stroke: none;
    opacity: 0.58;
  }

  .site-area-point.is-edge {
    fill: var(--moss-deep);
    opacity: 0.84;
  }

  .site-area-point.is-high {
    opacity: 0.72;
  }

  .site-area-contours {
    fill: none;
    stroke: var(--moss-deep);
    stroke-width: 0.72;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.34;
  }

  .site-area-start {
    fill: var(--page);
    stroke: var(--moss-deep);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }

  .site-area-centroid-symbol {
    opacity: 0;
    color: var(--moss-deep);
  }

  .site-area-centroid-symbol.is-visible {
    opacity: 0.86;
  }

  .site-area-centroid-symbol line,
  .site-area-centroid-ring {
    fill: rgba(255, 255, 255, 0.9);
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .site-area-centroid-symbol line {
    fill: none;
  }

  .site-area-centroid-dot {
    fill: currentColor;
    stroke: var(--page);
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }

  .site-area-label,
  .site-area-hint {
    position: absolute;
    padding: 3px 5px;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--line-soft);
    color: var(--moss-deep);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.47rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .site-area-label {
    left: 0;
    top: 0;
    opacity: 0;
    transition: opacity 90ms ease;
  }

  .site-area-label.is-visible {
    opacity: 0.82;
  }

  .site-area-hint {
    left: 22px;
    bottom: 22px;
    opacity: 0.7;
  }

  :global(body.site-a-mode),
  :global(body.site-a-mode *) {
    cursor: none !important;
  }

  :global(.post-date[data-date-easter-egg]) {
    cursor: pointer;
    transition: color 120ms ease;
  }

  :global(.post-date[data-date-easter-egg]:hover),
  :global(.post-date[data-date-easter-egg]:focus-visible) {
    color: var(--moss-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-grid-easter-egg,
    .site-scroll-readout,
    .site-a-readout,
    .site-a-axis,
    .site-area-label,
    .site-area-outline,
    :global(.post-date[data-date-easter-egg]) {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const svgNamespace = 'http://www.w3.org/2000/svg'
    const grid = document.querySelector('[data-site-grid]')
    const aReadout = document.querySelector('[data-a-readout]')
    const aReadoutLabel = document.querySelector('[data-a-readout-label]')
    const aAxis = document.querySelector('[data-a-axis]')
    const aAxisVertical = document.querySelector('[data-a-axis-vertical]')
    const aAxisHorizontal = document.querySelector('[data-a-axis-horizontal]')
    const areaOverlay = document.querySelector('[data-area-overlay]')
    const areaSvg = document.querySelector('[data-area-svg]')
    const areaPath = document.querySelector('[data-area-path]')
    const areaStart = document.querySelector('[data-area-start]')
    const areaPointsGroup = document.querySelector('[data-area-points]')
    const areaContoursPath = document.querySelector('[data-area-contours]')
    const areaCentroidSymbol = document.querySelector('[data-area-centroid-symbol]')
    const areaLabel = document.querySelector('[data-area-label]')
    const areaHint = document.querySelector('[data-area-hint]')

    if (
      !grid ||
      !aReadout ||
      !aAxis ||
      !areaOverlay ||
      !areaSvg ||
      !areaPath ||
      !areaStart ||
      !areaPointsGroup ||
      !areaContoursPath ||
      !areaCentroidSymbol ||
      !areaLabel ||
      !areaHint
    ) return

    if (grid.dataset.siteShortcutsInitialized === 'true') return
    grid.dataset.siteShortcutsInitialized = 'true'

    const isTypingTarget = (target) => {
      if (!(target instanceof Element)) return false
      return Boolean(target.closest('input, textarea, select, [contenteditable="true"]'))
    }

    const blockedLegacyKeys = new Set(['g', 'm', 'c', 'n', 'p', 'e', 's'])
    const aModes = ['cross', 'elev', 'grid', 'area', null]

    let activeMode = null
    let aModeIndex = -1
    let pointer = {
      x: window.innerWidth * 0.5,
      y: window.innerHeight * 0.5,
    }

    let drawingArea = false
    let areaFinished = false
    let areaPoints = []
    let areaSourcePoints = []
    let areaSurfacePoints = []
    let areaContourSegments = []
    let measuredArea = 0
    let areaCentroid = null

    let rotatingArea = false
    let areaYaw = 0
    let areaPitch = 0
    let rotationStartPointer = null
    let rotationStartYaw = 0
    let rotationStartPitch = 0

    const setAreaViewBox = () => {
      areaSvg.setAttribute('viewBox', `0 0 ${window.innerWidth} ${window.innerHeight}`)
    }

    const padCoordinate = (value) =>
      String(Math.max(0, Math.round(value))).padStart(4, '0')

    const updateAreaCursorLabel = () => {
      if (!aReadoutLabel || activeMode !== 'area') return

      if (rotatingArea) {
        aReadoutLabel.textContent = 'AREA / ROTATE 3D'
        return
      }

      if (drawingArea) {
        aReadoutLabel.textContent = isNearStart(pointer.x, pointer.y)
          ? 'AREA / JOIN'
          : 'AREA / DRAW'
        return
      }

      if (areaFinished && pointInPolygon(pointer, areaPoints)) {
        aReadoutLabel.textContent = 'AREA / DRAG TO ROTATE'
        return
      }

      aReadoutLabel.textContent = areaFinished
        ? 'AREA / DRAW NEW'
        : 'AREA / DRAW'
    }

    const updateReadoutPosition = () => {
      aReadout.style.left = `${pointer.x}px`
      aReadout.style.top = `${pointer.y}px`

      if (aAxisVertical) aAxisVertical.style.left = `${pointer.x}px`
      if (aAxisHorizontal) aAxisHorizontal.style.top = `${pointer.y}px`

      if (aReadoutLabel && (activeMode === 'elev' || activeMode === 'grid')) {
        const y = Math.max(0, Math.min(window.innerHeight, pointer.y))
        const level = ((window.innerHeight - y) / Math.max(1, window.innerHeight)) * 30
        aReadoutLabel.textContent =
          `X ${padCoordinate(pointer.x)} / Y ${padCoordinate(pointer.y)} / ELEV +${level.toFixed(1)}`
      }

      updateAreaCursorLabel()
    }

    const polygonArea = (points) => {
      if (points.length < 3) return 0

      let sum = 0

      for (let i = 0; i < points.length; i += 1) {
        const current = points[i]
        const next = points[(i + 1) % points.length]
        sum += current.x * next.y - next.x * current.y
      }

      return Math.abs(sum) * 0.5
    }

    const polygonCentroid = (points) => {
      if (points.length < 3) {
        return points[0] ?? { x: pointer.x, y: pointer.y }
      }

      let signedArea = 0
      let cx = 0
      let cy = 0

      for (let i = 0; i < points.length; i += 1) {
        const current = points[i]
        const next = points[(i + 1) % points.length]
        const factor = current.x * next.y - next.x * current.y
        signedArea += factor
        cx += (current.x + next.x) * factor
        cy += (current.y + next.y) * factor
      }

      if (Math.abs(signedArea) < 0.001) {
        const average = points.reduce(
          (result, point) => ({
            x: result.x + point.x,
            y: result.y + point.y,
          }),
          { x: 0, y: 0 }
        )

        return {
          x: average.x / points.length,
          y: average.y / points.length,
        }
      }

      return {
        x: cx / (3 * signedArea),
        y: cy / (3 * signedArea),
      }
    }

    const polygonBounds = (points) => {
      const xs = points.map((point) => point.x)
      const ys = points.map((point) => point.y)

      return {
        minX: Math.min(...xs),
        maxX: Math.max(...xs),
        minY: Math.min(...ys),
        maxY: Math.max(...ys),
      }
    }

    const pointInPolygon = (point, points) => {
      if (points.length < 3) return false

      let inside = false

      for (let i = 0, j = points.length - 1; i < points.length; j = i, i += 1) {
        const current = points[i]
        const previous = points[j]
        const crosses =
          current.y > point.y !== previous.y > point.y &&
          point.x <
            ((previous.x - current.x) * (point.y - current.y)) /
              (previous.y - current.y || 0.00001) +
              current.x

        if (crosses) inside = !inside
      }

      return inside
    }

    const distanceToSegment = (point, start, end) => {
      const dx = end.x - start.x
      const dy = end.y - start.y

      if (dx === 0 && dy === 0) {
        return Math.hypot(point.x - start.x, point.y - start.y)
      }

      const t = Math.max(
        0,
        Math.min(
          1,
          ((point.x - start.x) * dx + (point.y - start.y) * dy) /
            (dx * dx + dy * dy)
        )
      )

      const projection = {
        x: start.x + t * dx,
        y: start.y + t * dy,
      }

      return Math.hypot(point.x - projection.x, point.y - projection.y)
    }

    const distanceToPolygonEdge = (point, points) => {
      let minimum = Infinity

      for (let i = 0; i < points.length; i += 1) {
        const current = points[i]
        const next = points[(i + 1) % points.length]
        minimum = Math.min(minimum, distanceToSegment(point, current, next))
      }

      return minimum
    }

    const simplifyPoints = (points, epsilon = 5.5) => {
      if (points.length <= 2) return points.slice()

      const start = points[0]
      const end = points[points.length - 1]
      let farthestDistance = 0
      let farthestIndex = -1

      for (let i = 1; i < points.length - 1; i += 1) {
        const distance = distanceToSegment(points[i], start, end)

        if (distance > farthestDistance) {
          farthestDistance = distance
          farthestIndex = i
        }
      }

      if (farthestDistance <= epsilon || farthestIndex < 0) {
        return [start, end]
      }

      const firstHalf = simplifyPoints(points.slice(0, farthestIndex + 1), epsilon)
      const secondHalf = simplifyPoints(points.slice(farthestIndex), epsilon)

      return firstHalf.slice(0, -1).concat(secondHalf)
    }

    const isNearStart = (x, y) => {
      if (areaPoints.length < 8 || areaFinished) return false
      const start = areaPoints[0]
      return Math.hypot(x - start.x, y - start.y) <= 15
    }

    const setAreaLabel = (text, x, y) => {
      const estimatedWidth = 170
      const left = Math.max(10, Math.min(window.innerWidth - estimatedWidth - 10, x))
      const top = Math.max(70, Math.min(window.innerHeight - 30, y))

      areaLabel.textContent = text
      areaLabel.style.left = `${Math.round(left)}px`
      areaLabel.style.top = `${Math.round(top)}px`
      areaLabel.classList.add('is-visible')
    }

    const setAreaHint = (text) => {
      areaHint.textContent = text
    }

    const reliefHeight = (x, y) => {
      if (!areaCentroid) return 0

      const dx = x - areaCentroid.x
      const dy = y - areaCentroid.y

      return (
        Math.sin(dx * 0.020 + dy * 0.004) * 5.4 +
        Math.sin(dy * 0.026 - dx * 0.003) * 3.1 +
        Math.sin((dx + dy) * 0.012) * 2.1
      )
    }

    const deterministicJitter = (x, y, seed) => {
      const value = Math.sin(x * 12.9898 + y * 78.233 + seed * 37.719) * 43758.5453
      return value - Math.floor(value) - 0.5
    }

    const projectAreaPoint = (point) => {
      if (!areaCentroid) return { x: point.x, y: point.y, scale: 1 }

      const localX = point.x - areaCentroid.x
      const localY = point.y - areaCentroid.y
      const localZ = point.z ?? 0

      const cosPitch = Math.cos(areaPitch)
      const sinPitch = Math.sin(areaPitch)
      const cosYaw = Math.cos(areaYaw)
      const sinYaw = Math.sin(areaYaw)

      const pitchedY = localY * cosPitch - localZ * sinPitch
      const pitchedZ = localY * sinPitch + localZ * cosPitch
      const rotatedX = localX * cosYaw + pitchedZ * sinYaw
      const rotatedZ = -localX * sinYaw + pitchedZ * cosYaw
      const perspectiveDistance = 700
      const denominator = Math.max(170, perspectiveDistance + rotatedZ)
      const perspective = perspectiveDistance / denominator

      return {
        x: areaCentroid.x + rotatedX * perspective,
        y: areaCentroid.y + pitchedY * perspective,
        scale: perspective,
      }
    }

    const clearAreaTopography = () => {
      areaSurfacePoints = []
      areaContourSegments = []
      areaPointsGroup.replaceChildren()
      areaContoursPath.setAttribute('d', '')
    }

    const addContourSegment = (start, end, level) => {
      const midpoint = {
        x: (start.x + end.x) * 0.5,
        y: (start.y + end.y) * 0.5,
      }

      if (!pointInPolygon(midpoint, areaSourcePoints)) return

      areaContourSegments.push({
        start: { x: start.x, y: start.y, z: level },
        end: { x: end.x, y: end.y, z: level },
      })
    }

    const buildContourSegments = (bounds, step) => {
      const samples = []
      let minimum = Infinity
      let maximum = -Infinity

      for (let y = bounds.minY; y <= bounds.maxY + step; y += step) {
        for (let x = bounds.minX; x <= bounds.maxX + step; x += step) {
          const z = reliefHeight(x, y)
          samples.push(z)
          minimum = Math.min(minimum, z)
          maximum = Math.max(maximum, z)
        }
      }

      if (!samples.length || !Number.isFinite(minimum) || !Number.isFinite(maximum)) return

      const levels = Array.from(
        { length: 5 },
        (_, index) => minimum + ((index + 1) / 6) * (maximum - minimum)
      )

      const interpolate = (a, b, level) => {
        const denominator = b.z - a.z
        const t = Math.abs(denominator) < 0.00001 ? 0.5 : (level - a.z) / denominator
        return {
          x: a.x + (b.x - a.x) * t,
          y: a.y + (b.y - a.y) * t,
        }
      }

      const crossesLevel = (a, b, level) =>
        (a.z < level && b.z >= level) || (b.z < level && a.z >= level)

      for (const level of levels) {
        for (let y = bounds.minY; y < bounds.maxY; y += step) {
          for (let x = bounds.minX; x < bounds.maxX; x += step) {
            const p00 = { x, y, z: reliefHeight(x, y) }
            const p10 = { x: x + step, y, z: reliefHeight(x + step, y) }
            const p11 = { x: x + step, y: y + step, z: reliefHeight(x + step, y + step) }
            const p01 = { x, y: y + step, z: reliefHeight(x, y + step) }
            const edges = [
              [p00, p10],
              [p10, p11],
              [p11, p01],
              [p01, p00],
            ]
            const intersections = []

            for (const [start, end] of edges) {
              if (crossesLevel(start, end, level)) {
                intersections.push(interpolate(start, end, level))
              }
            }

            if (intersections.length === 2) {
              addContourSegment(intersections[0], intersections[1], level)
            } else if (intersections.length === 4) {
              addContourSegment(intersections[0], intersections[1], level)
              addContourSegment(intersections[2], intersections[3], level)
            }
          }
        }
      }
    }

    const buildAreaTopography = () => {
      clearAreaTopography()

      if (!areaFinished || !areaCentroid || areaSourcePoints.length < 3) return

      const bounds = polygonBounds(areaSourcePoints)
      const boundsWidth = Math.max(1, bounds.maxX - bounds.minX)
      const boundsHeight = Math.max(1, bounds.maxY - bounds.minY)
      const targetPointCount = 900
      const pointStep = Math.max(12, Math.sqrt((boundsWidth * boundsHeight) / targetPointCount))

      let pointIndex = 0

      for (let y = bounds.minY; y <= bounds.maxY; y += pointStep) {
        for (let x = bounds.minX; x <= bounds.maxX; x += pointStep) {
          const jittered = {
            x: x + deterministicJitter(x, y, 1) * pointStep * 0.42,
            y: y + deterministicJitter(x, y, 2) * pointStep * 0.42,
          }

          if (!pointInPolygon(jittered, areaSourcePoints)) continue

          const z = reliefHeight(jittered.x, jittered.y)
          const edgeDistance = distanceToPolygonEdge(jittered, areaSourcePoints)
          const edge = edgeDistance <= Math.max(16, pointStep * 1.65)
          const high = z > 3.2
          const radius = edge ? 1.55 : 1.18
          const element = document.createElementNS(svgNamespace, 'circle')
          element.classList.add('site-area-point')
          if (edge) element.classList.add('is-edge')
          if (high) element.classList.add('is-high')
          element.dataset.areaPointIndex = String(pointIndex)
          areaPointsGroup.append(element)

          areaSurfacePoints.push({
            x: jittered.x,
            y: jittered.y,
            z,
            radius,
            element,
          })
          pointIndex += 1
        }
      }

      buildContourSegments(bounds, Math.max(18, pointStep * 1.45))
    }

    const updateCentroidSymbol = () => {
      if (!areaFinished || !areaCentroid) {
        areaCentroidSymbol.classList.remove('is-visible')
        return
      }

      areaCentroidSymbol.setAttribute(
        'transform',
        `translate(${areaCentroid.x} ${areaCentroid.y})`
      )
      areaCentroidSymbol.classList.add('is-visible')
    }

    const renderAreaTopography = () => {
      if (!areaFinished) {
        areaContoursPath.setAttribute('d', '')
        return
      }

      for (const point of areaSurfacePoints) {
        const projected = projectAreaPoint(point)
        point.element.setAttribute('cx', String(projected.x))
        point.element.setAttribute('cy', String(projected.y))
        point.element.setAttribute(
          'r',
          String(Math.max(0.78, Math.min(2.2, point.radius * projected.scale)))
        )
      }

      const contourPath = areaContourSegments
        .map((segment) => {
          const start = projectAreaPoint(segment.start)
          const end = projectAreaPoint(segment.end)
          return `M ${start.x} ${start.y} L ${end.x} ${end.y}`
        })
        .join(' ')

      areaContoursPath.setAttribute('d', contourPath)
      updateCentroidSymbol()
    }

    const clearAreaVisuals = () => {
      drawingArea = false
      areaFinished = false
      rotatingArea = false
      areaPoints = []
      areaSourcePoints = []
      measuredArea = 0
      areaCentroid = null
      areaYaw = 0
      areaPitch = 0
      rotationStartPointer = null
      areaPath.setAttribute('d', '')
      areaStart.setAttribute('cx', '0')
      areaStart.setAttribute('cy', '0')
      areaStart.style.opacity = '0'
      areaCentroidSymbol.classList.remove('is-visible')
      areaLabel.classList.remove('is-visible')
      areaLabel.textContent = 'AREA / DRAW'
      areaOverlay.classList.remove('is-hovering-area', 'is-rotating-area')
      clearAreaTopography()
      setAreaHint('AREA / HOLD + DRAW')
      updateAreaCursorLabel()
    }

    const renderArea = (closed = areaFinished) => {
      if (!areaPoints.length) {
        areaPath.setAttribute('d', '')
        areaStart.style.opacity = '0'
        updateCentroidSymbol()
        return
      }

      const d = areaPoints
        .map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`)
        .join(' ')

      areaPath.setAttribute('d', closed ? `${d} Z` : d)

      const start = areaPoints[0]
      areaStart.setAttribute('cx', String(start.x))
      areaStart.setAttribute('cy', String(start.y))
      areaStart.style.opacity = closed ? '0' : '0.82'
      updateCentroidSymbol()
    }

    const projectArea3D = () => {
      if (!areaFinished || !areaCentroid || !areaSourcePoints.length) return

      areaPoints = areaSourcePoints.map((point) => projectAreaPoint({ ...point, z: 0 }))
      renderArea(true)
      renderAreaTopography()
    }

    const updateFinishedAreaLabel = () => {
      if (!areaFinished || !areaCentroid) return
      setAreaLabel(
        `AREA / ${Math.round(measuredArea)} px²`,
        areaCentroid.x + 14,
        areaCentroid.y - 16
      )
    }

    const startAreaDrawing = (x, y) => {
      clearAreaVisuals()
      drawingArea = true
      areaPoints = [{ x, y }]
      renderArea(false)
      setAreaLabel('AREA / DRAW', x + 16, y + 16)
      setAreaHint('AREA / RELEASE TO CLOSE')
      updateAreaCursorLabel()
    }

    const addAreaPoint = (x, y) => {
      if (!drawingArea) return

      const last = areaPoints[areaPoints.length - 1]
      if (!last) return

      if (Math.hypot(x - last.x, y - last.y) >= 5) {
        areaPoints.push({ x, y })
      }

      renderArea(false)

      const nearStart = isNearStart(x, y)
      setAreaLabel(
        nearStart ? 'AREA / CLOSE' : 'AREA / DRAW',
        x + 16,
        y + 16
      )
      setAreaHint(nearStart ? 'AREA / RELEASE TO JOIN' : 'AREA / RELEASE TO CLOSE')
      updateAreaCursorLabel()
    }

    const finishAreaDrawing = (x, y, snapToStart = false) => {
      if (!drawingArea) return

      const start = areaPoints[0]
      const endPoint = snapToStart && start
        ? { ...start }
        : { x, y }
      const last = areaPoints[areaPoints.length - 1]

      if (!last || Math.hypot(endPoint.x - last.x, endPoint.y - last.y) >= 3) {
        areaPoints.push(endPoint)
      }

      drawingArea = false

      if (areaPoints.length < 4) {
        clearAreaVisuals()
        return
      }

      let rawPoints = areaPoints.slice()
      const rawLast = rawPoints[rawPoints.length - 1]

      if (
        rawPoints.length > 1 &&
        Math.hypot(rawLast.x - rawPoints[0].x, rawLast.y - rawPoints[0].y) <= 1
      ) {
        rawPoints = rawPoints.slice(0, -1)
      }

      const simplified = simplifyPoints(rawPoints, 5.5)
      areaSourcePoints = simplified.length >= 3 ? simplified : rawPoints
      measuredArea = polygonArea(areaSourcePoints)

      if (areaSourcePoints.length < 3 || measuredArea < 25) {
        clearAreaVisuals()
        return
      }

      areaFinished = true
      areaCentroid = polygonCentroid(areaSourcePoints)
      areaYaw = 0
      areaPitch = 0
      areaPoints = areaSourcePoints.map((point) => ({ ...point }))
      buildAreaTopography()
      projectArea3D()
      updateFinishedAreaLabel()
      setAreaHint('AREA / DRAG TO ROTATE TOPOGRAPHY')
      updateAreaCursorLabel()
    }

    const beginAreaRotation = (x, y) => {
      if (!areaFinished || !areaCentroid) return false
      if (!pointInPolygon({ x, y }, areaPoints)) return false

      rotatingArea = true
      rotationStartPointer = { x, y }
      rotationStartYaw = areaYaw
      rotationStartPitch = areaPitch
      areaOverlay.classList.add('is-rotating-area')
      setAreaHint('AREA / ROTATE TOPOGRAPHY')
      updateAreaCursorLabel()
      return true
    }

    const rotateAreaToPointer = (x, y) => {
      if (!rotatingArea || !rotationStartPointer) return

      const dx = x - rotationStartPointer.x
      const dy = y - rotationStartPointer.y

      areaYaw = rotationStartYaw + dx * 0.012
      areaPitch = rotationStartPitch - dy * 0.012

      projectArea3D()
      updateFinishedAreaLabel()
      setAreaHint(
        `AREA / X ${((areaPitch * 180) / Math.PI).toFixed(1)}° / Y ${((areaYaw * 180) / Math.PI).toFixed(1)}°`
      )
      updateAreaCursorLabel()
    }

    const endAreaRotation = () => {
      if (!rotatingArea) return
      rotatingArea = false
      rotationStartPointer = null
      areaOverlay.classList.remove('is-rotating-area')
      setAreaHint('AREA / DRAG TO ROTATE TOPOGRAPHY')
      updateAreaCursorLabel()
    }

    const updateAreaHover = (x, y) => {
      if (!areaFinished || drawingArea || rotatingArea) {
        areaOverlay.classList.remove('is-hovering-area')
        updateAreaCursorLabel()
        return
      }

      const inside = pointInPolygon({ x, y }, areaPoints)
      areaOverlay.classList.toggle('is-hovering-area', inside)
      setAreaHint(inside ? 'AREA / DRAG TO ROTATE TOPOGRAPHY' : 'AREA / HOLD + DRAW NEW')
      updateAreaCursorLabel()
    }

    const setMode = (mode) => {
      activeMode = mode

      document.body.classList.toggle('site-a-mode', Boolean(mode))
      aReadout.dataset.mode = mode ?? ''
      aReadout.classList.toggle('is-visible', Boolean(mode))
      aAxis.classList.toggle('is-visible', mode === 'elev' || mode === 'grid')
      grid.classList.toggle('is-visible', mode === 'grid')
      areaOverlay.classList.toggle('is-visible', mode === 'area')

      clearAreaVisuals()
      updateReadoutPosition()
    }

    const cycleAMode = () => {
      aModeIndex = (aModeIndex + 1) % aModes.length
      setMode(aModes[aModeIndex])
    }

    const resetAMode = () => {
      aModeIndex = -1
      setMode(null)
    }

    const handleKeydown = (event) => {
      if (event.defaultPrevented) return
      if (event.metaKey || event.ctrlKey || event.altKey) return
      if (isTypingTarget(event.target)) return

      const key = event.key.toLowerCase()

      if (key === 'a') {
        event.preventDefault()
        event.stopImmediatePropagation()
        cycleAMode()
        return
      }

      if (key === 'l') {
        event.preventDefault()
        event.stopImmediatePropagation()
        window.location.assign('/lab/')
        return
      }

      if (blockedLegacyKeys.has(key)) {
        event.preventDefault()
        event.stopImmediatePropagation()
        return
      }

      if (key === 'escape') {
        resetAMode()
      }
    }

    const handlePointerMove = (event) => {
      pointer = {
        x: event.clientX,
        y: event.clientY,
      }

      updateReadoutPosition()

      if (activeMode !== 'area') return

      if (rotatingArea) {
        rotateAreaToPointer(event.clientX, event.clientY)
        return
      }

      if (drawingArea) {
        addAreaPoint(event.clientX, event.clientY)
        return
      }

      updateAreaHover(event.clientX, event.clientY)
    }

    const handlePointerDown = (event) => {
      if (event.button !== 0) return

      pointer = {
        x: event.clientX,
        y: event.clientY,
      }

      updateReadoutPosition()

      if (activeMode !== 'area') return

      event.preventDefault()
      event.stopPropagation()

      if (beginAreaRotation(event.clientX, event.clientY)) return
      startAreaDrawing(event.clientX, event.clientY)
    }

    const handlePointerUp = (event) => {
      if (event.button !== 0 || activeMode !== 'area') return

      if (rotatingArea) {
        event.preventDefault()
        event.stopPropagation()
        endAreaRotation()
        updateAreaHover(event.clientX, event.clientY)
        return
      }

      if (!drawingArea) return

      event.preventDefault()
      event.stopPropagation()
      finishAreaDrawing(
        event.clientX,
        event.clientY,
        isNearStart(event.clientX, event.clientY)
      )
      updateAreaHover(event.clientX, event.clientY)
    }

    const handlePointerCancel = () => {
      if (activeMode !== 'area') return

      if (rotatingArea) {
        endAreaRotation()
        return
      }

      if (drawingArea) clearAreaVisuals()
    }

    const initializeDateEasterEggs = () => {
      document.querySelectorAll('time.post-date').forEach((dateElement) => {
        if (!(dateElement instanceof HTMLElement)) return
        if (dateElement.dataset.dateEasterEgg === 'true') return

        const datetime = dateElement.getAttribute('datetime')
        if (!datetime) return

        dateElement.dataset.dateEasterEgg = 'true'
        dateElement.dataset.originalDate = dateElement.textContent ?? ''
        dateElement.dataset.isoDate = datetime.slice(0, 10)
        dateElement.dataset.isoVisible = 'false'
        dateElement.tabIndex = 0
        dateElement.setAttribute('role', 'button')
        dateElement.setAttribute('title', 'Toggle date format')

        const toggleDate = () => {
          const showIso = dateElement.dataset.isoVisible !== 'true'
          dateElement.dataset.isoVisible = showIso ? 'true' : 'false'
          dateElement.textContent = showIso
            ? dateElement.dataset.isoDate ?? ''
            : dateElement.dataset.originalDate ?? ''
        }

        dateElement.addEventListener('click', toggleDate)
        dateElement.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return
          event.preventDefault()
          toggleDate()
        })
      })
    }

    const handleResize = () => {
      setAreaViewBox()
      updateReadoutPosition()

      if (activeMode === 'area') clearAreaVisuals()
    }

    setAreaViewBox()
    setMode(null)

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeDateEasterEggs, { once: true })
    } else {
      initializeDateEasterEggs()
    }

    window.addEventListener('keydown', handleKeydown, true)
    window.addEventListener('pointermove', handlePointerMove, { passive: true })
    window.addEventListener('pointerdown', handlePointerDown, true)
    window.addEventListener('pointerup', handlePointerUp, true)
    window.addEventListener('pointercancel', handlePointerCancel, true)
    window.addEventListener('resize', handleResize, { passive: true })

    window.addEventListener(
      'pagehide',
      () => {
        window.removeEventListener('keydown', handleKeydown, true)
        window.removeEventListener('pointermove', handlePointerMove)
        window.removeEventListener('pointerdown', handlePointerDown, true)
        window.removeEventListener('pointerup', handlePointerUp, true)
        window.removeEventListener('pointercancel', handlePointerCancel, true)
        window.removeEventListener('resize', handleResize)
        document.body.classList.remove('site-a-mode')
      },
      { once: true }
    )
  })()
</script>

<script>
  import { initializeScrollReadout } from '../features/interactions/scrollReadout';

  initializeScrollReadout();
</script>
