---
interface Props {
  areaPolish?: boolean;
}

const { areaPolish = false } = Astro.props;
---

<div class="site-grid-easter-egg" data-site-grid aria-hidden="true">
  <span class="site-grid-label">GRID / 32</span>
</div>

<div class="site-scroll-readout" data-scroll-readout aria-hidden="true">
  <span data-scroll-y>Y 0000</span>
  <span class="site-scroll-readout__separator">/</span>
  <span data-scroll-percent>0%</span>
</div>

<div class="site-a-readout" data-a-readout data-mode="" aria-hidden="true">
  <span class="site-a-readout__cross"></span>
  <span class="site-a-readout__label" data-a-readout-label>X 0000 / Y 0000 / ELEV +15.0</span>
</div>

<div class="site-a-axis" data-a-axis aria-hidden="true">
  <span class="site-a-axis__vertical" data-a-axis-vertical></span>
  <span class="site-a-axis__horizontal" data-a-axis-horizontal></span>
</div>

<div
  class="site-area-overlay"
  data-area-overlay
  data-area-polish={areaPolish ? 'true' : 'false'}
  aria-hidden="true"
>
  <svg class="site-area-svg" data-area-svg preserveAspectRatio="none" aria-hidden="true">
    <g class="site-area-topography" data-area-topography>
      <g class="site-area-points" data-area-points></g>
      <path class="site-area-contours" data-area-contours />
    </g>
    <path class="site-area-outline" data-area-path />
    <circle class="site-area-start" data-area-start r="4" />
    <g class="site-area-centroid-symbol" data-area-centroid-symbol>
      <circle class="site-area-centroid-ring" cx="0" cy="0" r="8" />
      <line x1="-12" y1="0" x2="12" y2="0" />
      <line x1="0" y1="-12" x2="0" y2="12" />
      <circle class="site-area-centroid-dot" cx="0" cy="0" r="1.6" />
    </g>
  </svg>
  <span class="site-area-label" data-area-label>AREA / DRAW</span>
  <span class="site-area-hint" data-area-hint>AREA / HOLD + DRAW</span>
</div>

{
  areaPolish && (
    <>
      <div class="site-area-mode-grid" data-area-mode-grid aria-hidden="true">
        <span class="site-area-mode-grid__label">GRID / 32</span>
      </div>

      <svg
        class="site-area-free-select"
        data-area-free-select
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path class="site-area-free-select__contrast" data-area-free-select-contrast />
        <path class="site-area-free-select__fill" data-area-free-select-fill />
        <path class="site-area-free-select__stroke" data-area-free-select-path />
      </svg>

      <div class="site-area-raster-surface" data-area-raster-surface aria-hidden="true">
        <div class="site-area-raster-plane" data-area-raster-plane>
          <img class="site-area-raster-image" data-area-raster-image alt="" />
          <span class="site-area-raster-wash"></span>
          <svg
            class="site-area-raster-outline"
            data-area-raster-outline
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path data-area-raster-outline-path />
          </svg>
        </div>
      </div>
    </>
  )
}

<style>
  .site-grid-easter-egg {
    position: fixed;
    inset: 64px 0 0;
    z-index: 45;
    pointer-events: none;
    opacity: 0;
    background-image:
      linear-gradient(rgba(89, 105, 93, 0.075) 1px, transparent 1px),
      linear-gradient(90deg, rgba(89, 105, 93, 0.075) 1px, transparent 1px);
    background-size: 32px 32px;
    transition: opacity 120ms ease;
  }

  .site-grid-easter-egg.is-visible {
    opacity: 1;
  }

  .site-grid-label {
    position: absolute;
    right: 22px;
    bottom: 18px;
    color: var(--moss);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.58rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .site-scroll-readout {
    position: fixed;
    right: 22px;
    bottom: 42px;
    z-index: 46;
    display: flex;
    align-items: center;
    gap: 6px;
    pointer-events: none;
    opacity: 0;
    color: var(--moss-deep);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.47rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.05em;
    transform: translateY(3px);
    transition: opacity 140ms ease, transform 140ms ease;
  }

  .site-scroll-readout.is-visible {
    opacity: 0.72;
    transform: translateY(0);
  }

  .site-scroll-readout__separator {
    color: var(--stone-light);
  }

  .site-a-readout {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 75;
    width: 18px;
    height: 18px;
    pointer-events: none;
    opacity: 0;
    color: var(--moss-deep);
    transform: translate(-9px, -9px);
    transition: opacity 90ms ease;
  }

  .site-a-readout.is-visible {
    opacity: 0.84;
  }

  .site-a-readout__cross::before,
  .site-a-readout__cross::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .site-a-readout__cross::before {
    width: 18px;
    height: 1px;
  }

  .site-a-readout__cross::after {
    width: 1px;
    height: 18px;
  }

  .site-a-readout__label {
    position: absolute;
    left: 15px;
    top: 12px;
    padding: 3px 5px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--line-soft);
    color: var(--moss-deep);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.47rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .site-a-readout[data-mode='cross'] .site-a-readout__label,
  .site-a-readout[data-mode=''] .site-a-readout__label {
    display: none;
  }

  .site-a-axis {
    position: fixed;
    inset: 0;
    z-index: 71;
    pointer-events: none;
    opacity: 0;
    transition: opacity 90ms ease;
  }

  .site-a-axis.is-visible {
    opacity: 0.36;
  }

  .site-a-axis__vertical,
  .site-a-axis__horizontal {
    position: absolute;
    background: var(--moss-deep);
  }

  .site-a-axis__vertical {
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
  }

  .site-a-axis__horizontal {
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
  }

  .site-area-overlay {
    position: fixed;
    inset: 0;
    z-index: 73;
    display: none;
    pointer-events: none;
  }

  .site-area-overlay.is-visible {
    display: block;
  }

  .site-area-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .site-area-outline {
    fill: rgba(89, 105, 93, 0.018);
    stroke: var(--moss-deep);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    transition: stroke-width 100ms ease, fill 100ms ease;
  }

  .site-area-overlay.is-hovering-area .site-area-outline,
  .site-area-overlay.is-rotating-area .site-area-outline {
    fill: rgba(89, 105, 93, 0.032);
    stroke-width: 1.2;
  }

  .site-area-point {
    fill: var(--moss);
    stroke: none;
    opacity: 0.58;
  }

  .site-area-point.is-edge {
    fill: var(--moss-deep);
    opacity: 0.84;
  }

  .site-area-point.is-high {
    opacity: 0.72;
  }

  .site-area-contours {
    fill: none;
    stroke: var(--moss-deep);
    stroke-width: 0.72;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.34;
  }

  .site-area-start {
    fill: var(--page);
    stroke: var(--moss-deep);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }

  .site-area-centroid-symbol {
    opacity: 0;
    color: var(--moss-deep);
  }

  .site-area-centroid-symbol.is-visible {
    opacity: 0.86;
  }

  .site-area-centroid-symbol line,
  .site-area-centroid-ring {
    fill: rgba(255, 255, 255, 0.9);
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .site-area-centroid-symbol line {
    fill: none;
  }

  .site-area-centroid-dot {
    fill: currentColor;
    stroke: var(--page);
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }

  .site-area-label,
  .site-area-hint {
    position: absolute;
    padding: 3px 5px;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--line-soft);
    color: var(--moss-deep);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.47rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .site-area-label {
    left: 0;
    top: 0;
    opacity: 0;
    transition: opacity 90ms ease;
  }

  .site-area-label.is-visible {
    opacity: 0.82;
  }

  .site-area-hint {
    left: 22px;
    bottom: 22px;
    opacity: 0.7;
  }

  .site-area-overlay[data-area-polish='true'] .site-area-topography,
  .site-area-overlay[data-area-polish='true'] .site-area-centroid-symbol,
  .site-area-overlay[data-area-polish='true'] .site-area-centroid-symbol.is-visible,
  .site-area-overlay[data-area-polish='true'] .site-area-start {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  .site-area-overlay[data-area-polish='true'] .site-area-outline,
  .site-area-overlay[data-area-polish='true'].is-hovering-area .site-area-outline,
  .site-area-overlay[data-area-polish='true'].is-rotating-area .site-area-outline {
    fill: none !important;
    stroke: transparent !important;
    opacity: 0 !important;
  }

  .site-area-overlay[data-area-polish='true'] .site-area-hint {
    opacity: 0.62;
  }

  .site-area-mode-grid {
    position: fixed;
    inset: 64px 0 0;
    z-index: 45;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    background-image:
      linear-gradient(rgba(89, 105, 93, 0.075) 1px, transparent 1px),
      linear-gradient(90deg, rgba(89, 105, 93, 0.075) 1px, transparent 1px);
    background-size: 32px 32px;
    transition: opacity 120ms ease;
  }

  .site-area-mode-grid.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .site-area-mode-grid__label {
    position: absolute;
    right: 22px;
    bottom: 18px;
    color: var(--moss);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.58rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .site-area-free-select {
    position: fixed;
    inset: 0;
    z-index: 74;
    display: none;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .site-area-free-select.is-visible {
    display: block;
  }

  .site-area-free-select__contrast {
    fill: rgba(255, 255, 255, 0.14);
    stroke: none;
    mix-blend-mode: screen;
    vector-effect: non-scaling-stroke;
  }

  .site-area-free-select__fill {
    fill: rgba(18, 112, 47, 0.24);
    stroke: none;
    vector-effect: non-scaling-stroke;
  }

  .site-area-free-select__stroke,
  .site-area-raster-outline path {
    fill: none;
    stroke: rgba(248, 252, 249, 0.98);
    stroke-width: 0.9;
    stroke-dasharray: 2 2.8;
    stroke-linecap: butt;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
    filter:
      drop-shadow(0 0 0.45px rgba(255, 255, 255, 0.96))
      drop-shadow(0 0 0.7px rgba(35, 73, 47, 0.58));
  }

  .site-area-raster-surface {
    position: fixed;
    inset: 0;
    z-index: 74;
    display: none;
    pointer-events: none;
    overflow: visible;
  }

  .site-area-raster-surface.is-visible {
    display: block;
  }

  .site-area-raster-plane {
    position: fixed;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    transform-style: preserve-3d;
    backface-visibility: visible;
    will-change: transform;
  }

  .site-area-raster-image,
  .site-area-raster-wash,
  .site-area-raster-outline {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .site-area-raster-image {
    object-fit: fill;
    user-select: none;
  }

  .site-area-raster-wash {
    background: rgba(18, 112, 47, 0.25);
  }

  .site-area-raster-outline {
    overflow: visible;
  }

  :global(body.site-a-mode),
  :global(body.site-a-mode *) {
    cursor: none !important;
  }

  :global(.post-date[data-date-easter-egg]) {
    cursor: pointer;
    transition: color 120ms ease;
  }

  :global(.post-date[data-date-easter-egg]:hover),
  :global(.post-date[data-date-easter-egg]:focus-visible) {
    color: var(--moss-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-grid-easter-egg,
    .site-scroll-readout,
    .site-a-readout,
    .site-a-axis,
    .site-area-label,
    .site-area-outline,
    .site-area-mode-grid,
    .site-area-free-select,
    .site-area-raster-plane,
    :global(.post-date[data-date-easter-egg]) {
      transition: none;
    }
  }
</style>

<script>
  import { initializeACoordinateInteraction } from '../features/interactions/aCoordinate';
  import { initializeAreaInteraction } from '../features/interactions/area';
  import { initializeDateFormatToggle } from '../features/interactions/dateFormatToggle';
  import { initializeGridInteraction } from '../features/interactions/grid';
  import { initializeLegacyShortcuts } from '../features/interactions/legacyShortcuts';
  import { initializeScrollReadout } from '../features/interactions/scrollReadout';

  initializeACoordinateInteraction();
  initializeAreaInteraction();
  initializeDateFormatToggle();
  initializeGridInteraction();
  initializeLegacyShortcuts();
  initializeScrollReadout();
</script>
