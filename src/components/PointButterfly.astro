---
interface Props {
  class?: string;
  autoRotate?: boolean;
  flap?: boolean;
  showVeins?: boolean;
  enableZoom?: boolean;
  scale?: number;
  cameraDistance?: number;
}

const {
  class: className,
  autoRotate = true,
  flap = true,
  showVeins = true,
  enableZoom = true,
  scale = 1,
  cameraDistance = 7.2,
} = Astro.props;
---

<div
  class:list={['point-butterfly', className]}
  data-point-butterfly
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-flap={flap ? 'true' : 'false'}
  data-show-veins={showVeins ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-scale={scale}
  data-camera-distance={cameraDistance}
  aria-hidden="true"
>
  <canvas class="point-butterfly__canvas" data-point-butterfly-canvas></canvas>
</div>

<style>
  .point-butterfly {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 280px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .point-butterfly:active {
    cursor: grabbing;
  }

  .point-butterfly__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-point-butterfly]');

    roots.forEach(async (root) => {
      if (root.dataset.butterflyInitialized === 'true') return;
      root.dataset.butterflyInitialized = 'true';

      const canvas = root.querySelector('[data-point-butterfly-canvas]');
      if (!canvas) return;

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        );

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const wantsAutoRotate = root.dataset.autoRotate !== 'false';
        const wantsFlap = root.dataset.flap !== 'false';
        const wantsVeins = root.dataset.showVeins !== 'false';
        const wantsZoom = root.dataset.enableZoom !== 'false';
        const requestedScale = Number(root.dataset.scale ?? '1');
        const requestedCameraDistance = Number(root.dataset.cameraDistance ?? '7.2');
        const displayScale = Number.isFinite(requestedScale) ? requestedScale : 1;
        const cameraDistance = Number.isFinite(requestedCameraDistance)
          ? requestedCameraDistance
          : 7.2;

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        });

        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
        renderer.setClearColor(0xffffff, 0);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
        camera.position.set(0, 0.18, cameraDistance);

        const specimen = new THREE.Group();
        specimen.rotation.x = -0.05;
        specimen.rotation.z = -0.035;
        specimen.scale.setScalar(displayScale);
        scene.add(specimen);

        const controls = new OrbitControls(camera, renderer.domElement);
        controls.enablePan = false;
        controls.enableZoom = wantsZoom;
        controls.minDistance = 5.6;
        controls.maxDistance = 10.4;
        controls.zoomSpeed = 0.55;
        controls.enableDamping = true;
        controls.dampingFactor = 0.055;
        controls.rotateSpeed = 0.55;
        controls.target.set(0, 0.26, 0);
        controls.autoRotate = wantsAutoRotate && !reducedMotion;
        controls.autoRotateSpeed = 0.34;

        const pointMaterial = new THREE.PointsMaterial({
          color: 0x353832,
          size: 0.026,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.68,
        });

        const bodyPointMaterial = new THREE.PointsMaterial({
          color: 0x30332f,
          size: 0.03,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.82,
        });

        const veinMaterial = new THREE.LineBasicMaterial({
          color: 0x59695d,
          transparent: true,
          opacity: 0.62,
        });

        const edgeMaterial = new THREE.LineBasicMaterial({
          color: 0x59695d,
          transparent: true,
          opacity: 0.78,
        });

        const antennaMaterial = new THREE.LineBasicMaterial({
          color: 0x59695d,
          transparent: true,
          opacity: 0.72,
        });

        const thetaMin = -1.02;
        const thetaMax = 1.2;

        const outerRadius = (theta) => {
          const u = (theta - thetaMin) / (thetaMax - thetaMin);
          const taper = Math.pow(Math.max(0, Math.sin(Math.PI * u)), 0.48);
          const upperLobe = 0.78 * Math.exp(-((theta - 0.62) ** 2) / 0.22);
          const lowerLobe = 0.42 * Math.exp(-((theta + 0.52) ** 2) / 0.16);
          const waist = -0.18 * Math.exp(-((theta + 0.02) ** 2) / 0.08);
          return 0.34 + taper * (1.36 + upperLobe + lowerLobe + waist);
        };

        const wingCamber = (radiusFraction, theta) => {
          const centerLift = Math.sin(Math.PI * radiusFraction);
          const directional = 0.65 + 0.35 * Math.cos(theta * 1.4 - 0.1);
          return 0.065 * centerLift * directional;
        };

        const makeWing = (side) => {
          const group = new THREE.Group();
          const positions = [];
          const thetaSteps = 74;
          const radialSteps = 30;

          for (let ti = 0; ti <= thetaSteps; ti += 1) {
            const theta = THREE.MathUtils.lerp(thetaMin, thetaMax, ti / thetaSteps);
            const radiusMax = outerRadius(theta);

            for (let ri = 0; ri <= radialSteps; ri += 1) {
              const f = ri / radialSteps;
              const radiusFraction = 0.08 + f * 0.92;
              const radius = radiusMax * radiusFraction;
              const x = side * radius * Math.cos(theta);
              const y = 0.04 + radius * Math.sin(theta);
              const z = wingCamber(radiusFraction, theta);

              positions.push(x, y, z);
            }
          }

          const geometry = new THREE.BufferGeometry();
          geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));

          const points = new THREE.Points(geometry, pointMaterial);
          group.add(points);

          const veinGroup = new THREE.Group();
          veinGroup.visible = wantsVeins;

          const makeLine = (points, material = veinMaterial) => {
            const geometry = new THREE.BufferGeometry().setFromPoints(points);
            const line = new THREE.Line(geometry, material);
            veinGroup.add(line);
          };

          const veinAngles = [-0.78, -0.52, -0.24, 0.05, 0.31, 0.58, 0.83, 1.03];

          veinAngles.forEach((theta) => {
            const radiusMax = outerRadius(theta) * 0.96;
            const linePoints = [];

            for (let i = 0; i <= 22; i += 1) {
              const f = THREE.MathUtils.lerp(0.1, 1, i / 22);
              const radius = radiusMax * f;
              linePoints.push(
                new THREE.Vector3(
                  side * radius * Math.cos(theta),
                  0.04 + radius * Math.sin(theta),
                  wingCamber(f, theta) + 0.01
                )
              );
            }

            makeLine(linePoints);
          });

          [0.43, 0.63, 0.81].forEach((fraction, index) => {
            const linePoints = [];
            const start = thetaMin + 0.13;
            const end = thetaMax - 0.12;

            for (let i = 0; i <= 56; i += 1) {
              const theta = THREE.MathUtils.lerp(start, end, i / 56);
              const radius = outerRadius(theta) * fraction;
              linePoints.push(
                new THREE.Vector3(
                  side * radius * Math.cos(theta),
                  0.04 + radius * Math.sin(theta),
                  wingCamber(fraction, theta) + 0.011
                )
              );
            }

            makeLine(linePoints, index === 1 ? edgeMaterial : veinMaterial);
          });

          const edgePoints = [];
          for (let i = 0; i <= 100; i += 1) {
            const theta = THREE.MathUtils.lerp(thetaMin, thetaMax, i / 100);
            const radius = outerRadius(theta);
            edgePoints.push(
              new THREE.Vector3(
                side * radius * Math.cos(theta),
                0.04 + radius * Math.sin(theta),
                wingCamber(1, theta) + 0.008
              )
            );
          }
          makeLine(edgePoints, edgeMaterial);

          group.add(veinGroup);

          return {
            group,
            geometry,
            veinGroup,
          };
        };

        const leftWing = makeWing(-1);
        const rightWing = makeWing(1);
        specimen.add(leftWing.group, rightWing.group);

        const bodyPositions = [];
        const bodyRows = 58;
        const bodySides = 12;

        for (let yi = 0; yi <= bodyRows; yi += 1) {
          const y = THREE.MathUtils.lerp(-1.05, 1.12, yi / bodyRows);
          const normalized = (y + 1.05) / 2.17;
          const abdomen = 0.105 * (0.72 + 0.28 * Math.sin(Math.PI * normalized));
          const thorax = 0.065 * Math.exp(-((y - 0.2) ** 2) / 0.12);
          const radius = abdomen + thorax;

          for (let ai = 0; ai < bodySides; ai += 1) {
            const angle = (ai / bodySides) * Math.PI * 2;
            bodyPositions.push(
              Math.cos(angle) * radius,
              y,
              Math.sin(angle) * radius * 0.82
            );
          }
        }

        const headRadius = 0.16;
        for (let lat = 0; lat <= 10; lat += 1) {
          const phi = (lat / 10) * Math.PI;
          for (let lon = 0; lon < 14; lon += 1) {
            const theta = (lon / 14) * Math.PI * 2;
            bodyPositions.push(
              Math.sin(phi) * Math.cos(theta) * headRadius,
              1.18 + Math.cos(phi) * headRadius,
              Math.sin(phi) * Math.sin(theta) * headRadius * 0.9
            );
          }
        }

        const bodyGeometry = new THREE.BufferGeometry();
        bodyGeometry.setAttribute('position', new THREE.Float32BufferAttribute(bodyPositions, 3));
        const body = new THREE.Points(bodyGeometry, bodyPointMaterial);
        specimen.add(body);

        const antennaGeometries = [];
        [-1, 1].forEach((side) => {
          const curve = new THREE.CatmullRomCurve3([
            new THREE.Vector3(side * 0.06, 1.27, 0),
            new THREE.Vector3(side * 0.16, 1.48, 0.015),
            new THREE.Vector3(side * 0.34, 1.67, 0.04),
            new THREE.Vector3(side * 0.57, 1.77, 0.055),
          ]);
          const points = curve.getPoints(28);
          const geometry = new THREE.BufferGeometry().setFromPoints(points);
          antennaGeometries.push(geometry);
          specimen.add(new THREE.Line(geometry, antennaMaterial));
        });

        const resize = () => {
          const rect = root.getBoundingClientRect();
          const width = Math.max(1, Math.round(rect.width));
          const height = Math.max(1, Math.round(rect.height));

          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(root);
        resize();

        let isVisible = true;
        let isDocumentVisible = !document.hidden;
        let animationFrame = 0;

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting);
          },
          { rootMargin: '160px' }
        );
        intersectionObserver.observe(root);

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden;
        };
        document.addEventListener('visibilitychange', handleVisibility);

        const animatesWings = wantsFlap && !reducedMotion;

        const animate = (time) => {
          animationFrame = requestAnimationFrame(animate);
          if (!isVisible || !isDocumentVisible) return;

          controls.update();

          if (animatesWings) {
            const phase = time * 0.00145;
            const eased = 0.5 + 0.5 * Math.sin(phase);
            const flapAngle = THREE.MathUtils.lerp(0.08, 0.36, eased);

            leftWing.group.rotation.y = flapAngle;
            rightWing.group.rotation.y = -flapAngle;

            specimen.position.y = 0.018 * Math.sin(phase * 0.62);
            specimen.rotation.z = -0.035 + 0.012 * Math.sin(phase * 0.38);
          } else {
            leftWing.group.rotation.y = 0.16;
            rightWing.group.rotation.y = -0.16;
          }

          renderer.render(scene, camera);
        };

        animationFrame = requestAnimationFrame(animate);

        const cleanup = () => {
          cancelAnimationFrame(animationFrame);
          document.removeEventListener('visibilitychange', handleVisibility);
          resizeObserver.disconnect();
          intersectionObserver.disconnect();
          controls.dispose();

          leftWing.geometry.dispose();
          rightWing.geometry.dispose();
          bodyGeometry.dispose();
          antennaGeometries.forEach((geometry) => geometry.dispose());

          leftWing.veinGroup.children.forEach((child) => child.geometry.dispose());
          rightWing.veinGroup.children.forEach((child) => child.geometry.dispose());

          pointMaterial.dispose();
          bodyPointMaterial.dispose();
          veinMaterial.dispose();
          edgeMaterial.dispose();
          antennaMaterial.dispose();
          renderer.dispose();
        };

        window.addEventListener('pagehide', cleanup, { once: true });
      } catch (error) {
        console.error('PointButterfly failed to initialize:', error);
      }
    });
  })();
</script>
