<div
  class="homepage-contour-lens"
  data-homepage-contour-lens
  aria-hidden="true"
>
  <svg
    class="homepage-contour-lens__svg"
    viewBox="0 0 180 180"
    aria-hidden="true"
  >
    <path d="M90 16 C126 15 156 39 162 72 C168 107 148 143 115 158 C82 173 40 160 22 129 C4 98 13 57 42 34 C55 23 71 17 90 16 Z" />
    <path d="M91 33 C121 32 145 51 149 77 C153 104 137 131 111 142 C86 153 54 145 39 121 C24 97 29 68 49 49 C60 39 74 34 91 33 Z" />
    <path d="M92 49 C114 48 133 61 137 81 C140 102 127 121 108 130 C89 138 66 132 55 115 C44 98 47 77 62 63 C70 55 80 50 92 49 Z" />
    <path d="M92 64 C109 64 122 74 124 88 C126 103 117 116 103 122 C89 128 73 123 66 111 C58 99 61 84 71 75 C77 69 84 65 92 64 Z" />
    <path d="M92 77 C103 77 112 84 113 93 C114 103 108 111 99 115 C90 119 80 116 75 108 C70 100 72 90 79 84 C82 80 87 78 92 77 Z" />
  </svg>

  <span class="homepage-contour-lens__label">CONTOUR / TRACE</span>
