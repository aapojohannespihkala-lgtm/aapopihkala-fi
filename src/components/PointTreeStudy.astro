---
interface Props {
  class?: string
  autoRotate?: boolean
  enableZoom?: boolean
  scale?: number
  cameraDistance?: number
}

const {
  class: className,
  autoRotate = true,
  enableZoom = true,
  scale = 1,
  cameraDistance = 9.6,
} = Astro.props
---

<div
  class:list={['point-tree-study', className]}
  data-point-tree-study
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-scale={scale}
  data-camera-distance={cameraDistance}
  aria-hidden="true"
>
  <canvas class="point-tree-study__canvas" data-point-tree-study-canvas></canvas>
</div>

<style>
  .point-tree-study {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 320px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .point-tree-study:active {
    cursor: grabbing;
  }

  .point-tree-study__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-point-tree-study]')

    roots.forEach(async (root) => {
      if (root.dataset.pointTreeStudyInitialized === 'true') return
      root.dataset.pointTreeStudyInitialized = 'true'

      const canvas = root.querySelector('[data-point-tree-study-canvas]')
      if (!canvas) return

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm')
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        )

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const wantsAutoRotate = root.dataset.autoRotate !== 'false'
        const wantsZoom = root.dataset.enableZoom !== 'false'

        const requestedScale = Number(root.dataset.scale ?? '1')
        const requestedCameraDistance = Number(root.dataset.cameraDistance ?? '9.6')
        const displayScale = Number.isFinite(requestedScale) ? requestedScale : 1
        const camDistance = Number.isFinite(requestedCameraDistance)
          ? requestedCameraDistance
          : 9.6

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        })

        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6))
        renderer.setClearColor(0xffffff, 0)

        const scene = new THREE.Scene()
        const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100)
        camera.position.set(6.1, 3.85, camDistance)

        const specimen = new THREE.Group()
        specimen.scale.setScalar(displayScale)
        specimen.rotation.y = -0.2
        specimen.rotation.x = -0.02
        scene.add(specimen)

        const groundGroup = new THREE.Group()
        const woodyGroup = new THREE.Group()
        const canopyGroup = new THREE.Group()
        const contourGroup = new THREE.Group()
        const fineRootGroup = new THREE.Group()

        specimen.add(groundGroup, woodyGroup, canopyGroup, contourGroup, fineRootGroup)

        const controls = new OrbitControls(camera, renderer.domElement)
        controls.enablePan = false
        controls.enableZoom = wantsZoom
        controls.enableDamping = true
        controls.dampingFactor = 0.055
        controls.rotateSpeed = 0.5
        controls.target.set(0, 1.25, 0)
        controls.autoRotate = wantsAutoRotate && !reducedMotion
        controls.autoRotateSpeed = 0.18

        if (wantsZoom) {
          controls.minDistance = 8.1
          controls.maxDistance = 13.0
          controls.zoomSpeed = 0.5
        } else {
          const lockedDistance = camera.position.length()
          controls.minDistance = lockedDistance
          controls.maxDistance = lockedDistance
        }

        const woodyMaterial = new THREE.PointsMaterial({
          color: 0x30332f,
          size: 0.027,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.86,
        })

        const canopyMaterial = new THREE.PointsMaterial({
          color: 0x454a44,
          size: 0.022,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.34,
        })

        const fineRootMaterial = new THREE.PointsMaterial({
          color: 0x5d675e,
          size: 0.0185,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.24,
        })

        const groundPointMaterial = new THREE.PointsMaterial({
          color: 0x8d938c,
          size: 0.014,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.1,
        })

        const contourMaterial = new THREE.LineBasicMaterial({
          color: 0x667067,
          transparent: true,
          opacity: 0.17,
        })

        const groundLineMaterial = new THREE.LineBasicMaterial({
          color: 0x7f877f,
          transparent: true,
          opacity: 0.16,
        })

        const hash = (value, salt = 0) => {
          const x = Math.sin(value * 127.1 + salt * 311.7) * 43758.5453123
          return x - Math.floor(x)
        }

        const addTubeCloud = (
          target,
          curve,
          segmentCount,
          pointsPerSegment,
          startRadius,
          endRadius,
          seedOffset,
          flatten = 0.9
        ) => {
          const tangent = new THREE.Vector3()
          const normal = new THREE.Vector3()
          const binormal = new THREE.Vector3()
          const upY = new THREE.Vector3(0, 1, 0)
          const upX = new THREE.Vector3(1, 0, 0)

          for (let si = 0; si <= segmentCount; si += 1) {
            const t = si / segmentCount
            const center = curve.getPoint(t)
            tangent.copy(curve.getTangent(t)).normalize()

            const up = Math.abs(tangent.dot(upY)) > 0.9 ? upX : upY
            normal.crossVectors(up, tangent).normalize()
            binormal.crossVectors(tangent, normal).normalize()

            const baseRadius = THREE.MathUtils.lerp(startRadius, endRadius, t)

            for (let pi = 0; pi < pointsPerSegment; pi += 1) {
              const n = seedOffset * 10000 + si * 137 + pi * 19
              const angle = hash(n, 1) * Math.PI * 2
              const radius =
                Math.sqrt(hash(n, 2)) *
                baseRadius *
                (0.84 + 0.28 * hash(n, 3))
              const axial = (hash(n, 4) - 0.5) * baseRadius * 0.42

              const offset = new THREE.Vector3()
                .copy(normal)
                .multiplyScalar(Math.cos(angle) * radius)
                .add(
                  new THREE.Vector3()
                    .copy(binormal)
                    .multiplyScalar(Math.sin(angle) * radius * flatten)
                )
                .add(
                  new THREE.Vector3()
                    .copy(tangent)
                    .multiplyScalar(axial)
                )

              target.push(
                center.x + offset.x,
                center.y + offset.y,
                center.z + offset.z
              )
            }
          }
        }

        const woodyPositions = []
        const branchTips = []
        const primaryRootCurves = []
        const secondaryRootCurves = []

        const trunkCurve = new THREE.CatmullRomCurve3([
          new THREE.Vector3(0, -0.12, 0),
          new THREE.Vector3(0.02, 0.55, 0.01),
          new THREE.Vector3(0.04, 1.2, 0.02),
          new THREE.Vector3(0.02, 1.85, 0),
          new THREE.Vector3(-0.02, 2.36, -0.02),
        ])

        addTubeCloud(woodyPositions, trunkCurve, 86, 12, 0.2, 0.065, 1, 0.9)

        const flareAngles = [0.15, 1.35, 2.55, 3.7, 4.9, 5.75]
        flareAngles.forEach((angle, index) => {
          const curve = new THREE.CatmullRomCurve3([
            new THREE.Vector3(0, -0.1, 0),
            new THREE.Vector3(
              Math.cos(angle) * 0.14,
              -0.13,
              Math.sin(angle) * 0.14
            ),
            new THREE.Vector3(
              Math.cos(angle + 0.08) * 0.34,
              -0.2,
              Math.sin(angle + 0.08) * 0.34
            ),
          ])
          addTubeCloud(woodyPositions, curve, 16, 11, 0.14, 0.07, 20 + index, 0.92)
        })

        const primaryBranchDefs = [
          { y: 1.1, angle: 3.02, length: 1.8, rise: 0.8 },
          { y: 1.2, angle: 0.05, length: 1.92, rise: 0.72 },
          { y: 1.33, angle: 4.08, length: 1.65, rise: 0.95 },
          { y: 1.4, angle: 0.15 + 1.0, length: 1.72, rise: 0.9 },
          { y: 1.58, angle: 5.25, length: 1.46, rise: 0.92 },
          { y: 1.7, angle: 2.1, length: 1.38, rise: 1.0 },
          { y: 1.9, angle: 0.82, length: 1.14, rise: 0.95 },
        ]

        primaryBranchDefs.forEach((def, index) => {
          const side = index % 2 === 0 ? 1 : -1
          const start = new THREE.Vector3(0.015 * side, def.y, 0)
          const p1 = new THREE.Vector3(
            Math.cos(def.angle) * def.length * 0.22,
            def.y + def.rise * 0.18,
            Math.sin(def.angle) * def.length * 0.22
          )
          const p2 = new THREE.Vector3(
            Math.cos(def.angle + 0.08 * side) * def.length * 0.5,
            def.y + def.rise * 0.44,
            Math.sin(def.angle + 0.08 * side) * def.length * 0.5
          )
          const p3 = new THREE.Vector3(
            Math.cos(def.angle - 0.06 * side) * def.length * 0.76,
            def.y + def.rise * 0.76,
            Math.sin(def.angle - 0.06 * side) * def.length * 0.76
          )
          const tip = new THREE.Vector3(
            Math.cos(def.angle) * def.length,
            def.y + def.rise,
            Math.sin(def.angle) * def.length
          )

          const curve = new THREE.CatmullRomCurve3([start, p1, p2, p3, tip])
          addTubeCloud(
            woodyPositions,
            curve,
            34,
            index < 4 ? 9 : 8,
            index < 4 ? 0.075 : 0.06,
            0.018,
            100 + index,
            0.88
          )

          branchTips.push(tip.clone())

          const splitTs = index < 4 ? [0.5, 0.72] : [0.6]
          splitTs.forEach((t, splitIndex) => {
            const anchor = curve.getPoint(t)
            const tangent = curve.getTangent(t).normalize()
            const tangentAngle = Math.atan2(tangent.z, tangent.x)
            const turn = (splitIndex === 0 ? 1 : -1) * (0.55 + 0.11 * index)
            const childAngle = tangentAngle + turn
            const childLength = 0.62 + 0.11 * hash(index * 17 + splitIndex, 10)
            const childTip = new THREE.Vector3(
              anchor.x + Math.cos(childAngle) * childLength,
              anchor.y + 0.3 + 0.2 * hash(index * 23 + splitIndex, 11),
              anchor.z + Math.sin(childAngle) * childLength
            )
            const childMid = new THREE.Vector3(
              THREE.MathUtils.lerp(anchor.x, childTip.x, 0.5),
              anchor.y + 0.2,
              THREE.MathUtils.lerp(anchor.z, childTip.z, 0.5) + 0.1 * side
            )
            const childCurve = new THREE.CatmullRomCurve3([
              anchor.clone(),
              childMid,
              childTip,
            ])

            addTubeCloud(
              woodyPositions,
              childCurve,
              22,
              6,
              0.038,
              0.012,
              150 + index * 4 + splitIndex,
              0.86
            )

            branchTips.push(childTip.clone())
          })
        })

        const rootDefs = [
          { angle: 0.12, length: 2.95, depth: 0.48 },
          { angle: 0.9, length: 2.5, depth: 0.54 },
          { angle: 1.72, length: 2.72, depth: 0.5 },
          { angle: 2.55, length: 2.38, depth: 0.6 },
          { angle: 3.35, length: 3.05, depth: 0.5 },
          { angle: 4.15, length: 2.62, depth: 0.56 },
          { angle: 4.92, length: 2.42, depth: 0.62 },
          { angle: 5.72, length: 2.8, depth: 0.5 },
        ]

        rootDefs.forEach((def, index) => {
          const bend = (index % 2 === 0 ? 1 : -1) * (0.08 + 0.05 * hash(index, 20))
          const points = [
            new THREE.Vector3(0, -0.12, 0),
            new THREE.Vector3(
              Math.cos(def.angle) * def.length * 0.22,
              -0.18,
              Math.sin(def.angle) * def.length * 0.22
            ),
            new THREE.Vector3(
              Math.cos(def.angle + bend) * def.length * 0.52,
              -0.27 - def.depth * 0.22,
              Math.sin(def.angle + bend) * def.length * 0.52
            ),
            new THREE.Vector3(
              Math.cos(def.angle - bend * 0.7) * def.length * 0.78,
              -0.34 - def.depth * 0.5,
              Math.sin(def.angle - bend * 0.7) * def.length * 0.78
            ),
            new THREE.Vector3(
              Math.cos(def.angle) * def.length,
              -0.38 - def.depth,
              Math.sin(def.angle) * def.length
            ),
          ]

          const curve = new THREE.CatmullRomCurve3(points)
          primaryRootCurves.push(curve)
          addTubeCloud(
            woodyPositions,
            curve,
            34,
            8,
            index < 4 ? 0.074 : 0.062,
            0.018,
            220 + index,
            0.92
          )

          const splitTs = [0.48, 0.7]
          splitTs.forEach((t, splitIndex) => {
            const anchor = curve.getPoint(t)
            const tangent = curve.getTangent(t).normalize()
            const tangentAngle = Math.atan2(tangent.z, tangent.x)
            const turn = (splitIndex === 0 ? 1 : -1) * (0.5 + 0.12 * hash(index, 25))
            const childAngle = tangentAngle + turn
            const childLength = 0.7 + 0.28 * hash(index * 13 + splitIndex, 26)
            const childTip = new THREE.Vector3(
              anchor.x + Math.cos(childAngle) * childLength,
              anchor.y - 0.12 - 0.08 * hash(index, 27),
              anchor.z + Math.sin(childAngle) * childLength
            )
            const childCurve = new THREE.CatmullRomCurve3([
              anchor.clone(),
              new THREE.Vector3(
                THREE.MathUtils.lerp(anchor.x, childTip.x, 0.55),
                anchor.y - 0.08,
                THREE.MathUtils.lerp(anchor.z, childTip.z, 0.55)
              ),
              childTip,
            ])

            secondaryRootCurves.push(childCurve)
            addTubeCloud(
              woodyPositions,
              childCurve,
              22,
              6,
              0.038,
              0.011,
              280 + index * 3 + splitIndex,
              0.9
            )
          })
        })

        const woodyGeometry = new THREE.BufferGeometry()
        woodyGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(woodyPositions, 3)
        )
        woodyGroup.add(new THREE.Points(woodyGeometry, woodyMaterial))

        const canopyPositions = []
        const canopyCenters = [
          ...branchTips,
          new THREE.Vector3(-0.8, 2.5, 0.55),
          new THREE.Vector3(0.7, 2.45, -0.65),
          new THREE.Vector3(0.05, 2.82, 0.05),
          new THREE.Vector3(-0.15, 2.28, -0.05),
        ]

        canopyCenters.forEach((center, centerIndex) => {
          const rx = 0.52 + 0.25 * hash(centerIndex, 31)
          const ry = 0.36 + 0.18 * hash(centerIndex, 32)
          const rz = 0.52 + 0.25 * hash(centerIndex, 33)
          const count = 460 + Math.round(160 * hash(centerIndex, 34))

          for (let i = 0; i < count; i += 1) {
            const seed = centerIndex * 10000 + i + 1
            const theta = hash(seed, 35) * Math.PI * 2
            const phi = Math.acos(2 * hash(seed, 36) - 1)
            const shell = 0.18 + 0.82 * Math.pow(hash(seed, 37), 0.42)
            const surfaceBias = 0.72 + 0.28 * Math.pow(hash(seed, 38), 0.25)
            const radius = shell * surfaceBias

            const x = center.x + Math.sin(phi) * Math.cos(theta) * rx * radius
            const y = center.y + Math.cos(phi) * ry * radius
            const z = center.z + Math.sin(phi) * Math.sin(theta) * rz * radius

            const gapNoise =
              Math.sin((x + centerIndex * 0.2) * 4.2) *
              Math.cos((z - centerIndex * 0.1) * 3.7) +
              0.55 * Math.sin(y * 5.3 + centerIndex)

            if (gapNoise < -0.72 && hash(seed, 39) < 0.62) continue

            canopyPositions.push(
              x + (hash(seed, 40) - 0.5) * 0.028,
              y + (hash(seed, 41) - 0.5) * 0.024,
              z + (hash(seed, 42) - 0.5) * 0.028
            )
          }
        })

        const canopyGeometry = new THREE.BufferGeometry()
        canopyGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(canopyPositions, 3)
        )
        canopyGroup.add(new THREE.Points(canopyGeometry, canopyMaterial))

        const fineRootPositions = []
        const allRootCurves = [...primaryRootCurves, ...secondaryRootCurves]

        allRootCurves.forEach((curve, curveIndex) => {
          const samples = curveIndex < primaryRootCurves.length ? 42 : 28
          const localDensity = curveIndex < primaryRootCurves.length ? 13 : 9

          for (let si = 0; si <= samples; si += 1) {
            const t = si / samples
            const center = curve.getPoint(t)
            const tangent = curve.getTangent(t).normalize()
            const lateral = new THREE.Vector3(-tangent.z, 0, tangent.x).normalize()
            const spread = 0.055 + 0.32 * Math.pow(t, 1.25)

            for (let pi = 0; pi < localDensity; pi += 1) {
              const seed = curveIndex * 100000 + si * 101 + pi
              const side = (hash(seed, 51) - 0.5) * 2
              const along = (hash(seed, 52) - 0.5) * spread * 0.8
              const lateralSpread = side * spread * (0.35 + 0.75 * hash(seed, 53))
              const depth = -Math.abs(hash(seed, 54) - 0.2) * spread * 0.42

              fineRootPositions.push(
                center.x + lateral.x * lateralSpread + tangent.x * along,
                center.y + depth + (hash(seed, 55) - 0.5) * 0.035,
                center.z + lateral.z * lateralSpread + tangent.z * along
              )
            }
          }
        })

        rootDefs.forEach((def, rootIndex) => {
          const tipX = Math.cos(def.angle) * def.length
          const tipZ = Math.sin(def.angle) * def.length

          for (let i = 0; i < 140; i += 1) {
            const seed = rootIndex * 1000 + i
            const angle = def.angle + (hash(seed, 61) - 0.5) * 1.15
            const reach = 0.12 + 0.58 * Math.pow(hash(seed, 62), 0.7)
            fineRootPositions.push(
              tipX + Math.cos(angle) * reach,
              -0.75 - Math.abs(hash(seed, 63) - 0.2) * 0.22,
              tipZ + Math.sin(angle) * reach
            )
          }
        })

        const fineRootGeometry = new THREE.BufferGeometry()
        fineRootGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(fineRootPositions, 3)
        )
        fineRootGroup.add(new THREE.Points(fineRootGeometry, fineRootMaterial))

        const makeIrregularLoop = ({
          centerX,
          centerY,
          centerZ,
          rx,
          rz,
          phase,
          wobble,
        }) => {
          const points = []
          const count = 120

          for (let i = 0; i <= count; i += 1) {
            const a = (i / count) * Math.PI * 2
            const shape =
              1 +
              wobble * Math.sin(a * 3 + phase) +
              wobble * 0.55 * Math.cos(a * 5 - phase * 0.7)

            points.push(
              new THREE.Vector3(
                centerX + Math.cos(a) * rx * shape,
                centerY + 0.035 * Math.sin(a * 2 + phase),
                centerZ + Math.sin(a) * rz * shape
              )
            )
          }

          const geometry = new THREE.BufferGeometry().setFromPoints(points)
          contourGroup.add(new THREE.Line(geometry, contourMaterial))
        }

        ;[
          { centerX: -0.72, centerY: 2.48, centerZ: 0.55, rx: 0.88, rz: 0.72, phase: 0.2, wobble: 0.07 },
          { centerX: 0.72, centerY: 2.42, centerZ: -0.48, rx: 0.9, rz: 0.76, phase: 1.1, wobble: 0.065 },
          { centerX: 0.02, centerY: 2.78, centerZ: 0.02, rx: 1.0, rz: 0.94, phase: 2.0, wobble: 0.055 },
          { centerX: -0.05, centerY: 2.2, centerZ: 0.0, rx: 1.42, rz: 1.36, phase: 2.7, wobble: 0.05 },
        ].forEach(makeIrregularLoop)

        const groundPositions = []
        const groundRadius = 3.25

        for (let i = 0; i < 1700; i += 1) {
          const angle = hash(i + 1, 71) * Math.PI * 2
          const radius = groundRadius * Math.sqrt(hash(i + 1, 72))
          const irregularity = 1 + 0.08 * Math.sin(angle * 2.4) + 0.05 * Math.cos(angle * 5.1)
          const x = Math.cos(angle) * radius * irregularity
          const z = Math.sin(angle) * radius * irregularity
          const y =
            0.012 * Math.sin(x * 1.4 + z * 0.6) +
            0.009 * Math.cos(z * 1.8 - x * 0.4)

          if (hash(i + 1, 73) < 0.2 + 0.25 * radius / groundRadius) continue
          groundPositions.push(x, y, z)
        }

        const groundGeometry = new THREE.BufferGeometry()
        groundGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(groundPositions, 3)
        )
        groundGroup.add(new THREE.Points(groundGeometry, groundPointMaterial))

        const groundCurve = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-3.0, 0.025, -0.22),
          new THREE.Vector3(-1.8, 0.02, -0.12),
          new THREE.Vector3(-0.6, 0.015, 0.02),
          new THREE.Vector3(0.65, 0.02, -0.04),
          new THREE.Vector3(1.8, 0.025, 0.12),
          new THREE.Vector3(3.0, 0.03, 0.18),
        ])
        const groundLineGeometry = new THREE.BufferGeometry().setFromPoints(
          groundCurve.getPoints(90)
        )
        groundGroup.add(new THREE.Line(groundLineGeometry, groundLineMaterial))

        const resize = () => {
          const rect = root.getBoundingClientRect()
          const width = Math.max(1, Math.round(rect.width))
          const height = Math.max(1, Math.round(rect.height))

          renderer.setSize(width, height, false)
          camera.aspect = width / height
          camera.updateProjectionMatrix()
        }

        const resizeObserver = new ResizeObserver(resize)
        resizeObserver.observe(root)
        resize()

        let isVisible = true
        let isDocumentVisible = !document.hidden
        let animationFrame = 0

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting)
          },
          { rootMargin: '160px' }
        )

        intersectionObserver.observe(root)

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden
        }

        document.addEventListener('visibilitychange', handleVisibility)

        const animate = (time) => {
          animationFrame = requestAnimationFrame(animate)
          if (!isVisible || !isDocumentVisible) return

          controls.update()

          if (!reducedMotion) {
            const phase = time * 0.00034
            canopyMaterial.opacity = 0.335 + 0.012 * Math.sin(phase)
            canopyMaterial.size = 0.022 + 0.0008 * Math.sin(phase * 1.3)
            contourGroup.rotation.y = 0.004 * Math.sin(phase * 0.55)
          }

          renderer.render(scene, camera)
        }

        animationFrame = requestAnimationFrame(animate)

        const cleanup = () => {
          cancelAnimationFrame(animationFrame)
          document.removeEventListener('visibilitychange', handleVisibility)
          resizeObserver.disconnect()
          intersectionObserver.disconnect()
          controls.dispose()

          specimen.traverse((child) => {
            if (child.geometry) child.geometry.dispose()
          })

          woodyMaterial.dispose()
          canopyMaterial.dispose()
          fineRootMaterial.dispose()
          groundPointMaterial.dispose()
          contourMaterial.dispose()
          groundLineMaterial.dispose()
          renderer.dispose()
        }

        window.addEventListener('pagehide', cleanup, { once: true })
      } catch (error) {
        console.error('PointTreeStudy failed to initialize:', error)
      }
    })
  })()
</script>
