---
import AboutPortraitSection from './AboutPortraitSection.astro';
import AboutPortraitPolish from './AboutPortraitPolish.astro';
import AboutAxisMotion from './AboutAxisMotion.astro';
import type { SiteLanguage } from '../config/site';

interface Props {
  lang: SiteLanguage;
}

const { lang } = Astro.props;
---

<div class="homepage-about-embed" data-homepage-about-embed>
  <AboutPortraitPolish />
  <AboutAxisMotion />
  <AboutPortraitSection lang={lang} />
</div>

<style is:global>
  .homepage-about-embed {
    position: relative;
    min-height: calc(100svh - 64px);
    padding-block: clamp(88px, 12svh, 132px);
  }

  .homepage-about-embed > .about-portrait {
    width: 100%;
    margin: 0;
  }

  .hero-about-link {
    display: none !important;
  }

  @media (max-width: 640px) {
    .homepage-about-embed {
      min-height: calc(100svh - 64px);
      padding-block: clamp(64px, 10svh, 96px);
    }
  }
</style>

<script is:inline>
  (() => {
    const section = document.querySelector('[data-homepage-about-embed]')
    const feed = document.querySelector('.main-container > .feed')

    if (!section || !feed) return
    if (section.dataset.homepageAboutEmbedMounted === 'true') return

    section.dataset.homepageAboutEmbedMounted = 'true'
    feed.before(section)
  })()
</script>
