<div class="meshy-point-surface-v6" data-meshy-point-surface-v6 aria-label="Pyöriteltävä Meshy-pistepinta vol 6">
  <canvas class="meshy-point-surface-v6__canvas" data-meshy-point-surface-v6-canvas></canvas>
  <p class="meshy-point-surface-v6__status" data-meshy-point-surface-v6-status>Ladataan pistepintaa...</p>
</div>

<style>
  .meshy-point-surface-v6 {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 420px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .meshy-point-surface-v6:active { cursor: grabbing; }

  .meshy-point-surface-v6__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }

  .meshy-point-surface-v6__status {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: 0;
    color: var(--stone-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .meshy-point-surface-v6__status[hidden] { display: none; }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-meshy-point-surface-v6]');

    const estimateGeometryArea = (geometry, THREE) => {
      const position = geometry.getAttribute('position');
      if (!position || position.count < 3) return 0;

      const a = new THREE.Vector3();
      const b = new THREE.Vector3();
      const c = new THREE.Vector3();
      const ab = new THREE.Vector3();
      const ac = new THREE.Vector3();
      const index = geometry.getIndex();
      let area = 0;

      if (index) {
        for (let i = 0; i + 2 < index.count; i += 3) {
          a.fromBufferAttribute(position, index.getX(i));
          b.fromBufferAttribute(position, index.getX(i + 1));
          c.fromBufferAttribute(position, index.getX(i + 2));
          ab.subVectors(b, a);
          ac.subVectors(c, a);
          area += ab.cross(ac).length() * 0.5;
        }
      } else {
        for (let i = 0; i + 2 < position.count; i += 3) {
          a.fromBufferAttribute(position, i);
          b.fromBufferAttribute(position, i + 1);
          c.fromBufferAttribute(position, i + 2);
          ab.subVectors(b, a);
          ac.subVectors(c, a);
          area += ab.cross(ac).length() * 0.5;
        }
      }

      return area;
    };

    roots.forEach(async (root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.meshyPointSurfaceV6Initialized === 'true') return;
      root.dataset.meshyPointSurfaceV6Initialized = 'true';

      const canvas = root.querySelector('[data-meshy-point-surface-v6-canvas]');
      const status = root.querySelector('[data-meshy-point-surface-v6-status]');
      if (!(canvas instanceof HTMLCanvasElement)) return;

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        );
        const { GLTFLoader } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/loaders/GLTFLoader.js/+esm'
        );
        const { MeshSurfaceSampler } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/math/MeshSurfaceSampler.js/+esm'
        );

        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.setClearColor(0x000000, 0);
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.autoClear = false;

        const depthScene = new THREE.Scene();
        const hiddenScene = new THREE.Scene();
        const visibleScene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(36, 1, 0.01, 1000);
        const controls = new OrbitControls(camera, canvas);
        controls.enableDamping = true;
        controls.dampingFactor = 0.06;
        controls.enablePan = true;
        controls.enableZoom = true;
        controls.target.set(0, 0, 0);

        const depthTarget = new THREE.WebGLRenderTarget(1, 1, {
          minFilter: THREE.NearestFilter,
          magFilter: THREE.NearestFilter,
          depthBuffer: true,
          stencilBuffer: false,
        });
        depthTarget.texture.generateMipmaps = false;
        depthTarget.depthTexture = new THREE.DepthTexture(1, 1);
        depthTarget.depthTexture.format = THREE.DepthFormat;
        depthTarget.depthTexture.type = THREE.UnsignedIntType;

        const loader = new GLTFLoader();
        loader.load(
          '/lab/meshy-pixelated-poise.glb',
          (gltf) => {
            const model = gltf.scene;
            model.updateMatrixWorld(true);

            const box = new THREE.Box3().setFromObject(model);
            const center = box.getCenter(new THREE.Vector3());
            const size = box.getSize(new THREE.Vector3());
            const radius = Math.max(size.x, size.y, size.z) * 0.5 || 1;

            const meshEntries = [];
            let totalArea = 0;

            model.traverse((child) => {
              if (!(child instanceof THREE.Mesh)) return;
              if (!(child.geometry instanceof THREE.BufferGeometry)) return;

              const area = estimateGeometryArea(child.geometry, THREE);
              if (area <= 0) return;

              child.updateWorldMatrix(true, false);
              meshEntries.push({ mesh: child, area });
              totalArea += area;
            });

            if (!meshEntries.length || totalArea <= 0) {
              if (status instanceof HTMLElement) status.textContent = 'Pistepintaa ei voitu muodostaa';
              return;
            }

            const acceptedPositions = [];
            const basePointBudget = 46000;
            const glassesPointBudget = 18000;

            const isSuppressedNeckCut = (worldPosition, worldNormal) => {
              const lowerBandTop = -size.y * 0.31;
              const lowerBandBottom = -size.y * 0.44;
              const inNeckCutBand = worldPosition.y < lowerBandTop && worldPosition.y > lowerBandBottom;
              const nearlyHorizontalSurface = Math.abs(worldNormal.y) > 0.72;
              return inNeckCutBand && nearlyHorizontalSurface;
            };

            const isGlassesZone = (worldPosition) => {
              const nx = size.x > 0 ? worldPosition.x / (size.x * 0.5) : 0;
              const ny = size.y > 0 ? worldPosition.y / (size.y * 0.5) : 0;
              const nz = size.z > 0 ? worldPosition.z / (size.z * 0.5) : 0;
              return ny > -0.10 && ny < 0.34 && Math.abs(nx) < 0.72 && nz > 0.58;
            };

            const sampleIntoCloud = (mesh, target, filter) => {
              const sampler = new MeshSurfaceSampler(mesh).build();
              const sampledPosition = new THREE.Vector3();
              const sampledNormal = new THREE.Vector3();
              const worldPosition = new THREE.Vector3();
              const worldNormal = new THREE.Vector3();
              const normalMatrix = new THREE.Matrix3().getNormalMatrix(mesh.matrixWorld);
              const maxAttempts = Math.max(target * 90, 4000);
              let accepted = 0;
              let attempts = 0;

              while (accepted < target && attempts < maxAttempts) {
                attempts += 1;
                sampler.sample(sampledPosition, sampledNormal);
                worldPosition.copy(sampledPosition).applyMatrix4(mesh.matrixWorld).sub(center);
                worldNormal.copy(sampledNormal).applyMatrix3(normalMatrix).normalize();

                if (isSuppressedNeckCut(worldPosition, worldNormal) && Math.random() > 0.10) continue;
                if (filter && !filter(worldPosition)) continue;

                acceptedPositions.push(worldPosition.x, worldPosition.y, worldPosition.z);
                accepted += 1;
              }
            };

            meshEntries.forEach(({ mesh, area }) => {
              const baseTarget = Math.max(1400, Math.round(basePointBudget * (area / totalArea)));
              sampleIntoCloud(mesh, baseTarget, null);
            });

            meshEntries.forEach(({ mesh, area }) => {
              const glassesTarget = Math.max(350, Math.round(glassesPointBudget * (area / totalArea)));
              sampleIntoCloud(mesh, glassesTarget, isGlassesZone);
            });

            const pointCount = Math.floor(acceptedPositions.length / 3);
            if (!pointCount) {
              if (status instanceof HTMLElement) status.textContent = 'Pistepintaa ei voitu muodostaa';
              return;
            }

            const geometry = new THREE.BufferGeometry();
            geometry.setAttribute('position', new THREE.Float32BufferAttribute(acceptedPositions, 3));

            const sharedUniforms = {
              uDepthTexture: { value: depthTarget.depthTexture },
              uResolution: { value: new THREE.Vector2(1, 1) },
              uViewportHeight: { value: 1 },
              uNear: { value: 0.01 },
              uFar: { value: 1000 },
              uPointWorldSize: { value: Math.max(radius * 0.0085, 0.0035) },
              uDepthTolerance: { value: Math.max(radius * 0.022, 0.004) },
            };

            const vertexShader = `
              uniform float uViewportHeight;
              uniform float uPointWorldSize;

              void main() {
                vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
                gl_Position = projectionMatrix * mvPosition;

                float viewDepth = max(-mvPosition.z, 0.001);
                float pixelsPerUnit = projectionMatrix[1][1] * uViewportHeight * 0.5 / viewDepth;
                gl_PointSize = clamp(uPointWorldSize * pixelsPerUnit, 1.0, 4.5);
              }
            `;

            const depthHelpers = `
              uniform sampler2D uDepthTexture;
              uniform vec2 uResolution;
              uniform float uNear;
              uniform float uFar;
              uniform float uDepthTolerance;

              float perspectiveDepthToViewZ(float invClipZ, float nearPlane, float farPlane) {
                return (nearPlane * farPlane) / ((farPlane - nearPlane) * invClipZ - farPlane);
              }

              float hiddenFactor() {
                vec2 uv = gl_FragCoord.xy / uResolution;
                float sceneDepth = texture2D(uDepthTexture, uv).x;
                float pointViewZ = perspectiveDepthToViewZ(gl_FragCoord.z, uNear, uFar);
                float sceneViewZ = perspectiveDepthToViewZ(sceneDepth, uNear, uFar);
                float behindDistance = sceneViewZ - pointViewZ;
                return smoothstep(uDepthTolerance, uDepthTolerance * 3.5, behindDistance);
              }

              float roundPointAlpha() {
                float distanceFromCenter = length(gl_PointCoord - vec2(0.5));
                if (distanceFromCenter > 0.5) discard;
                return 1.0 - smoothstep(0.34, 0.50, distanceFromCenter);
              }
            `;

            const hiddenMaterial = new THREE.ShaderMaterial({
              uniforms: sharedUniforms,
              vertexShader,
              fragmentShader: `
                ${depthHelpers}
                void main() {
                  float hidden = hiddenFactor();
                  if (hidden < 0.02) discard;
                  float edge = roundPointAlpha();
                  vec3 color = vec3(0.76, 0.79, 0.77);
                  gl_FragColor = vec4(color, 0.14 * hidden * edge);
                }
              `,
              transparent: true,
              depthTest: false,
              depthWrite: false,
            });

            const visibleMaterial = new THREE.ShaderMaterial({
              uniforms: sharedUniforms,
              vertexShader,
              fragmentShader: `
                ${depthHelpers}
                void main() {
                  float hidden = hiddenFactor();
                  if (hidden > 0.985) discard;
                  float edge = roundPointAlpha();
                  vec3 color = vec3(0.33, 0.39, 0.35);
                  gl_FragColor = vec4(color, 0.98 * (1.0 - hidden) * edge);
                }
              `,
              transparent: true,
              depthTest: false,
              depthWrite: false,
            });

            hiddenScene.add(new THREE.Points(geometry, hiddenMaterial));
            visibleScene.add(new THREE.Points(geometry, visibleMaterial));

            const depthMaterial = new THREE.MeshBasicMaterial({
              colorWrite: false,
              depthWrite: true,
              depthTest: true,
              side: THREE.DoubleSide,
            });

            meshEntries.forEach(({ mesh }) => {
              const depthMesh = new THREE.Mesh(mesh.geometry, depthMaterial);
              depthMesh.matrixAutoUpdate = false;
              depthMesh.frustumCulled = false;
              depthMesh.matrix
                .makeTranslation(-center.x, -center.y, -center.z)
                .multiply(mesh.matrixWorld);
              depthScene.add(depthMesh);
            });

            camera.near = Math.max(radius / 1000, 0.001);
            camera.far = Math.max(radius * 100, 100);
            camera.position.set(radius * 1.65, radius * 0.85, radius * 2.05);
            camera.updateProjectionMatrix();

            sharedUniforms.uNear.value = camera.near;
            sharedUniforms.uFar.value = camera.far;

            controls.target.set(0, 0, 0);
            controls.minDistance = Math.max(radius * 0.18, 0.01);
            controls.maxDistance = radius * 12;
            controls.update();

            root.__meshyPointSurfaceV6Resize = (width, height) => {
              const drawingBufferSize = renderer.getDrawingBufferSize(new THREE.Vector2());
              depthTarget.setSize(drawingBufferSize.x, drawingBufferSize.y);
              sharedUniforms.uResolution.value.set(drawingBufferSize.x, drawingBufferSize.y);
              sharedUniforms.uViewportHeight.value = drawingBufferSize.y;
            };

            if (status instanceof HTMLElement) status.hidden = true;
          },
          undefined,
          () => {
            if (status instanceof HTMLElement) status.textContent = '3D-mallia ei voitu ladata';
          }
        );

        const resize = () => {
          const width = Math.max(1, root.clientWidth);
          const height = Math.max(1, root.clientHeight);
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
          if (typeof root.__meshyPointSurfaceV6Resize === 'function') {
            root.__meshyPointSurfaceV6Resize(width, height);
          }
        };

        const observer = new ResizeObserver(resize);
        observer.observe(root);
        resize();

        const animate = () => {
          controls.update();

          renderer.setRenderTarget(depthTarget);
          renderer.clear(true, true, true);
          renderer.render(depthScene, camera);

          renderer.setRenderTarget(null);
          renderer.clear(true, true, true);
          renderer.render(hiddenScene, camera);
          renderer.render(visibleScene, camera);

          requestAnimationFrame(animate);
        };
        animate();
      } catch (error) {
        console.error('Pixelated Poise vol 6 viewer failed', error);
        if (status instanceof HTMLElement) status.textContent = 'Pistepintakatselinta ei voitu ladata';
      }
    });
  })();
</script>
