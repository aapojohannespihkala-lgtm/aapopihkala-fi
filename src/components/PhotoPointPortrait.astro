---
interface Props {
  class?: string;
  autoRotate?: boolean;
  enableZoom?: boolean;
  scale?: number;
  cameraDistance?: number;
}

const {
  class: className,
  autoRotate = true,
  enableZoom = true,
  scale = 1,
  cameraDistance = 6.2,
} = Astro.props;
---

<div
  class:list={['photo-point-portrait', className]}
  data-photo-point-portrait
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-scale={scale}
  data-camera-distance={cameraDistance}
  role="img"
  aria-label="Valokuva-aineistosta rakennettu pyöriteltävä 3D-pistepilvimuotokuva"
>
  <canvas class="photo-point-portrait__canvas" data-photo-point-portrait-canvas></canvas>
  <span class="photo-point-portrait__status" data-photo-point-portrait-status>loading photo cloud</span>
</div>

<style>
  .photo-point-portrait {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 320px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .photo-point-portrait:active { cursor: grabbing; }

  .photo-point-portrait__canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .photo-point-portrait__status {
    position: absolute;
    left: 12px;
    bottom: 10px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stone-light, #999);
    transition: opacity 160ms ease;
    pointer-events: none;
  }

  .photo-point-portrait[data-ready='true'] .photo-point-portrait__status { opacity: 0; }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-photo-point-portrait]')

    roots.forEach(async (root) => {
      if (root.dataset.photoPointPortraitInitialized === 'true') return
      root.dataset.photoPointPortraitInitialized = 'true'

      const canvas = root.querySelector('[data-photo-point-portrait-canvas]')
      const status = root.querySelector('[data-photo-point-portrait-status]')
      if (!canvas) return

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm')
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        )

        const clamp = (value, min, max) => Math.max(min, Math.min(max, value))
        const lerp = (a, b, t) => a + (b - a) * t
        const deg = (value) => THREE.MathUtils.degToRad(value)
        const smoothstep = (a, b, x) => {
          const t = clamp((x - a) / (b - a), 0, 1)
          return t * t * (3 - 2 * t)
        }
        const gaussian = (x, y, cx, cy, sx, sy) => {
          const dx = (x - cx) / sx
          const dy = (y - cy) / sy
          return Math.exp(-0.5 * (dx * dx + dy * dy))
        }

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const wantsAutoRotate = root.dataset.autoRotate !== 'false'
        const wantsZoom = root.dataset.enableZoom !== 'false'
        const requestedScale = Number(root.dataset.scale ?? '1')
        const requestedCameraDistance = Number(root.dataset.cameraDistance ?? '6.2')
        const displayScale = Number.isFinite(requestedScale) ? requestedScale : 1
        const cameraDistance = Number.isFinite(requestedCameraDistance) ? requestedCameraDistance : 6.2

        const makeSampler = (src) =>
          new Promise((resolve, reject) => {
            const image = new Image()
            image.decoding = 'async'
            image.onload = () => {
              const sampleCanvas = document.createElement('canvas')
              sampleCanvas.width = 220
              sampleCanvas.height = 275
              const context = sampleCanvas.getContext('2d', { willReadFrequently: true })
              if (!context) {
                reject(new Error('2D canvas unavailable'))
                return
              }
              context.drawImage(image, 0, 0, sampleCanvas.width, sampleCanvas.height)
              const pixels = context.getImageData(0, 0, sampleCanvas.width, sampleCanvas.height).data
              resolve((u, v) => {
                const x = Math.round(clamp(u, 0, 1) * (sampleCanvas.width - 1))
                const y = Math.round(clamp(v, 0, 1) * (sampleCanvas.height - 1))
                const i = (y * sampleCanvas.width + x) * 4
                return [pixels[i] / 255, pixels[i + 1] / 255, pixels[i + 2] / 255]
              })
            }
            image.onerror = () => reject(new Error(`Failed to load ${src}`))
            image.src = src
          })

        const [sampleFront, sampleSide] = await Promise.all([
          makeSampler('/lab/portrait-front.jpg'),
          makeSampler('/lab/portrait-side.jpg'),
        ])

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
          powerPreference: 'high-performance',
        })
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5))
        renderer.setClearColor(0xffffff, 0)
        renderer.outputColorSpace = THREE.SRGBColorSpace

        const scene = new THREE.Scene()
        const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 100)
        camera.position.set(0, 0.02, cameraDistance)

        const portrait = new THREE.Group()
        portrait.position.y = -0.04
        portrait.rotation.y = deg(-16)
        portrait.scale.setScalar(displayScale)
        scene.add(portrait)

        const controls = new OrbitControls(camera, renderer.domElement)
        controls.enablePan = false
        controls.enableZoom = wantsZoom
        controls.minDistance = 4.7
        controls.maxDistance = 8.8
        controls.zoomSpeed = 0.48
        controls.enableDamping = true
        controls.dampingFactor = 0.06
        controls.rotateSpeed = 0.48
        controls.target.set(0, 0.02, 0)
        controls.minAzimuthAngle = deg(-34)
        controls.maxAzimuthAngle = deg(58)
        controls.minPolarAngle = deg(76)
        controls.maxPolarAngle = deg(104)
        controls.autoRotate = wantsAutoRotate && !reducedMotion
        controls.autoRotateSpeed = 0.12

        const widthKeys = [
          [-1.5, 0.08],
          [-1.34, 0.34],
          [-1.12, 0.56],
          [-0.88, 0.69],
          [-0.58, 0.77],
          [-0.25, 0.81],
          [0.12, 0.83],
          [0.48, 0.84],
          [0.82, 0.83],
          [1.08, 0.79],
          [1.3, 0.7],
          [1.5, 0.43],
          [1.62, 0.08],
        ]
        const depthKeys = [
          [-1.5, 0.08],
          [-1.28, 0.35],
          [-0.92, 0.5],
          [-0.5, 0.59],
          [0.0, 0.66],
          [0.48, 0.7],
          [0.92, 0.7],
          [1.24, 0.64],
          [1.48, 0.48],
          [1.62, 0.08],
        ]

        const sampleCurve = (keys, y) => {
          if (y <= keys[0][0]) return keys[0][1]
          for (let i = 0; i < keys.length - 1; i += 1) {
            const a = keys[i]
            const b = keys[i + 1]
            if (y <= b[0]) {
              let t = clamp((y - a[0]) / (b[0] - a[0]), 0, 1)
              t = t * t * (3 - 2 * t)
              return lerp(a[1], b[1], t)
            }
          }
          return keys[keys.length - 1][1]
        }

        const widthAt = (y) => sampleCurve(widthKeys, y)
        const depthAt = (y) => sampleCurve(depthKeys, y)

        const surfacePoint = (y, angle) => {
          const cos = Math.cos(angle)
          const sin = Math.sin(angle)
          const front = Math.max(0, sin)
          const frontMask = front ** 2.3

          let x = cos * widthAt(y)
          let z = sin * depthAt(y)

          const cheek =
            gaussian(x, y, -0.39, -0.02, 0.21, 0.26) +
            gaussian(x, y, 0.39, -0.02, 0.21, 0.26)
          z += 0.07 * cheek * frontMask

          const sockets =
            gaussian(x, y, -0.34, 0.29, 0.18, 0.12) +
            gaussian(x, y, 0.34, 0.29, 0.18, 0.12)
          z -= 0.085 * sockets * frontMask

          z += 0.18 * gaussian(x, y, 0, 0.22, 0.1, 0.38) * frontMask
          z += 0.27 * gaussian(x, y, 0, -0.07, 0.13, 0.13) * frontMask
          z += 0.034 * gaussian(x, y, 0, -0.43, 0.22, 0.07) * frontMask
          z += 0.048 * gaussian(x, y, 0, -0.53, 0.23, 0.08) * frontMask
          z += 0.07 * gaussian(x, y, 0, -0.85, 0.31, 0.19) * frontMask

          const jawTaper = smoothstep(-0.75, -1.42, y)
          x *= 1 - jawTaper * 0.08

          if (y > 1.0) {
            const hair = smoothstep(1.0, 1.58, y)
            z += 0.055 * (1 - hair) * front
            x *= 1 + 0.02 * (1 - hair)
          }

          return new THREE.Vector3(x, y, z)
        }

        const positions = []
        const colors = []
        let seed = 19890417
        const random = () => {
          seed = (seed * 1664525 + 1013904223) >>> 0
          return seed / 4294967296
        }

        const frontViewAngle = Math.PI * 0.5 + deg(18)
        const sideViewAngle = 0
        const frontRightX = Math.sin(frontViewAngle)
        const frontRightZ = -Math.cos(frontViewAngle)

        const gradeColor = (rgb) => {
          const luma = rgb[0] * 0.2126 + rgb[1] * 0.7152 + rgb[2] * 0.0722
          const saturation = 1.12
          const contrast = 1.1
          return rgb.map((channel) => {
            const saturated = luma + (channel - luma) * saturation
            return clamp((saturated - 0.5) * contrast + 0.5, 0, 1)
          })
        }

        const rows = 132
        const sides = 176

        for (let yi = 0; yi <= rows; yi += 1) {
          const y = lerp(-1.5, 1.62, yi / rows)
          const width = Math.max(0.08, widthAt(y))
          const depth = Math.max(0.08, depthAt(y))

          for (let ai = 0; ai < sides; ai += 1) {
            if (random() < 0.018) continue

            const angle = (ai / sides) * Math.PI * 2
            const point = surfacePoint(y, angle)
            const radialX = Math.cos(angle)
            const radialZ = Math.sin(angle)

            const frontFacing = Math.max(
              0,
              radialX * Math.cos(frontViewAngle) + radialZ * Math.sin(frontViewAngle)
            )
            const sideFacing = Math.max(
              0,
              radialX * Math.cos(sideViewAngle) + radialZ * Math.sin(sideViewAngle)
            )

            const frontHorizontal = point.x * frontRightX + point.z * frontRightZ
            const frontU = 0.5 + (frontHorizontal / Math.max(width, 0.5)) * 0.45
            const frontV = 0.015 + ((1.62 - y) / 3.12) * 0.9

            const sideU = 0.52 - (point.z / Math.max(depth, 0.45)) * 0.43
            const sideV = 0.02 + ((1.62 - y) / 3.12) * 0.88

            const frontRgb = gradeColor(sampleFront(frontU, frontV))
            const sideRgb = gradeColor(sampleSide(sideU, sideV))

            const frontWeight = frontFacing ** 3.5
            const sideWeight = sideFacing ** 4
            const totalWeight = frontWeight + sideWeight

            let rgb
            if (totalWeight > 0.025) {
              const fw = frontWeight / totalWeight
              const sw = sideWeight / totalWeight
              rgb = [
                frontRgb[0] * fw + sideRgb[0] * sw,
                frontRgb[1] * fw + sideRgb[1] * sw,
                frontRgb[2] * fw + sideRgb[2] * sw,
              ]
            } else {
              const dim = 0.56 + Math.max(0, radialZ) * 0.12
              rgb = [0.54 * dim, 0.5 * dim, 0.46 * dim]
            }

            point.x += (random() - 0.5) * 0.0018
            point.y += (random() - 0.5) * 0.0018
            point.z += (random() - 0.5) * 0.0018

            const c = new THREE.Color(rgb[0], rgb[1], rgb[2]).convertSRGBToLinear()
            positions.push(point.x, point.y, point.z)
            colors.push(c.r, c.g, c.b)
          }
        }

        const geometry = new THREE.BufferGeometry()
        geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3))
        geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3))

        const pointTextureCanvas = document.createElement('canvas')
        pointTextureCanvas.width = pointTextureCanvas.height = 32
        const pointTextureContext = pointTextureCanvas.getContext('2d')
        if (pointTextureContext) {
          pointTextureContext.fillStyle = '#fff'
          pointTextureContext.beginPath()
          pointTextureContext.arc(16, 16, 12.5, 0, Math.PI * 2)
          pointTextureContext.fill()
        }
        const pointTexture = new THREE.CanvasTexture(pointTextureCanvas)

        const material = new THREE.PointsMaterial({
          size: 0.026,
          sizeAttenuation: true,
          vertexColors: true,
          map: pointTexture,
          alphaTest: 0.22,
          transparent: true,
          opacity: 1,
        })

        portrait.add(new THREE.Points(geometry, material))

        const resize = () => {
          const rect = root.getBoundingClientRect()
          const width = Math.max(1, Math.round(rect.width))
          const height = Math.max(1, Math.round(rect.height))
          renderer.setSize(width, height, false)
          camera.aspect = width / height
          camera.updateProjectionMatrix()
        }

        const resizeObserver = new ResizeObserver(resize)
        resizeObserver.observe(root)
        resize()

        let animationFrame = 0
        let isVisible = true
        let isDocumentVisible = !document.hidden

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting)
          },
          { rootMargin: '160px' }
        )
        intersectionObserver.observe(root)

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden
        }
        document.addEventListener('visibilitychange', handleVisibility)

        const animate = () => {
          animationFrame = requestAnimationFrame(animate)
          if (!isVisible || !isDocumentVisible) return
          controls.update()
          renderer.render(scene, camera)
        }

        root.dataset.ready = 'true'
        if (status) status.textContent = 'photo cloud ready'
        animationFrame = requestAnimationFrame(animate)

        window.addEventListener(
          'pagehide',
          () => {
            cancelAnimationFrame(animationFrame)
            resizeObserver.disconnect()
            intersectionObserver.disconnect()
            document.removeEventListener('visibilitychange', handleVisibility)
            controls.dispose()
            geometry.dispose()
            material.dispose()
            pointTexture.dispose()
            renderer.dispose()
          },
          { once: true }
        )
      } catch (error) {
        console.error('Photo point portrait failed to initialize', error)
        if (status) status.textContent = 'photo cloud unavailable'
      }
    })
  })()
</script>
