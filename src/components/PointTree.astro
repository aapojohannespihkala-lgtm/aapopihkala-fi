---
interface Props {
  class?: string;
  autoRotate?: boolean;
  enableZoom?: boolean;
  showRoots?: boolean;
  showContext?: boolean;
}

const {
  class: className,
  autoRotate = true,
  enableZoom = true,
  showRoots = true,
  showContext = true,
} = Astro.props;
---

<div
  class:list={['point-tree', className]}
  data-point-tree
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-show-roots={showRoots ? 'true' : 'false'}
  data-show-context={showContext ? 'true' : 'false'}
  aria-hidden="true"
>
  <canvas class="point-tree__canvas" data-point-tree-canvas></canvas>
</div>

<style>
  .point-tree {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 320px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .point-tree:active {
    cursor: grabbing;
  }

  .point-tree__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-point-tree]');

    roots.forEach(async (root) => {
      if (root.dataset.pointTreeInitialized === 'true') return;
      root.dataset.pointTreeInitialized = 'true';

      const canvas = root.querySelector('[data-point-tree-canvas]');
      if (!canvas) return;

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        );

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const wantsAutoRotate = root.dataset.autoRotate !== 'false';
        const wantsZoom = root.dataset.enableZoom !== 'false';
        const wantsRoots = root.dataset.showRoots !== 'false';
        const wantsContext = root.dataset.showContext !== 'false';

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        });

        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
        renderer.setClearColor(0xffffff, 0);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(37, 1, 0.1, 100);
        camera.position.set(5.7, 3.35, 9.0);

        const specimen = new THREE.Group();
        specimen.rotation.y = -0.18;
        scene.add(specimen);

        const controls = new OrbitControls(camera, renderer.domElement);
        controls.enablePan = false;
        controls.enableZoom = wantsZoom;
        controls.enableDamping = true;
        controls.dampingFactor = 0.055;
        controls.rotateSpeed = 0.5;
        controls.minPolarAngle = Math.PI * 0.24;
        controls.maxPolarAngle = Math.PI * 0.70;
        controls.target.set(0, 0.72, 0);
        controls.autoRotate = wantsAutoRotate && !reducedMotion;
        controls.autoRotateSpeed = 0.22;

        if (wantsZoom) {
          controls.minDistance = 7.7;
          controls.maxDistance = 12.0;
          controls.zoomSpeed = 0.5;
        }

        const canopyPointMaterial = new THREE.PointsMaterial({
          color: 0x353832,
          size: 0.024,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.57,
        });

        const trunkPointMaterial = new THREE.PointsMaterial({
          color: 0x30332f,
          size: 0.03,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.78,
        });

        const rootPointMaterial = new THREE.PointsMaterial({
          color: 0x596158,
          size: 0.021,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.42,
        });

        const branchLineMaterial = new THREE.LineBasicMaterial({
          color: 0x59695d,
          transparent: true,
          opacity: 0.34,
        });

        const rootLineMaterial = new THREE.LineBasicMaterial({
          color: 0x697168,
          transparent: true,
          opacity: 0.28,
        });

        const groundLineMaterial = new THREE.LineBasicMaterial({
          color: 0x9ba098,
          transparent: true,
          opacity: 0.2,
        });

        const contextLineMaterial = new THREE.LineBasicMaterial({
          color: 0x7c8279,
          transparent: true,
          opacity: 0.26,
        });

        const canopy = new THREE.Group();
        const trunk = new THREE.Group();
        const rootField = new THREE.Group();
        const context = new THREE.Group();

        specimen.add(canopy, trunk, rootField, context);

        const hash = (value, salt = 0) => {
          const x = Math.sin(value * 127.1 + salt * 311.7) * 43758.5453123;
          return x - Math.floor(x);
        };

        const makeLine = (points, material) => {
          const geometry = new THREE.BufferGeometry().setFromPoints(points);
          return new THREE.Line(geometry, material);
        };

        const crownWidth = (t) => {
          const bell = Math.pow(Math.max(0, Math.sin(Math.PI * t)), 0.62);
          const upper = 0.17 * Math.exp(-((t - 0.68) ** 2) / 0.035);
          const lower = 0.1 * Math.exp(-((t - 0.27) ** 2) / 0.04);
          return 0.34 + 1.92 * bell + upper + lower;
        };

        const crownDepth = (t) => {
          const bell = Math.pow(Math.max(0, Math.sin(Math.PI * t)), 0.74);
          return 0.28 + 1.28 * bell;
        };

        const crownCenterX = (t) =>
          -0.1 +
          0.12 * Math.sin(t * 4.6 + 0.2) +
          0.045 * Math.sin(t * 11.2);

        const crownCenterZ = (t) =>
          0.055 * Math.sin(t * 5.8 - 0.4);

        const crownY = (t) => 0.9 + t * 2.35;

        const canopyPositions = [];
        const canopyPointCount = 10200;

        for (let i = 0; i < canopyPointCount; i += 1) {
          const tRaw = hash(i + 1, 1);
          const t = 0.02 + tRaw * 0.96;
          const angle = hash(i + 1, 2) * Math.PI * 2;
          const radial = Math.sqrt(hash(i + 1, 3));
          const irregularity =
            1 +
            0.055 * Math.sin(angle * 3.0 + t * 5.4) +
            0.035 * Math.cos(angle * 5.0 - t * 7.2) +
            (hash(i + 1, 4) - 0.5) * 0.055;

          const x =
            crownCenterX(t) +
            Math.cos(angle) * crownWidth(t) * radial * irregularity;
          const z =
            crownCenterZ(t) +
            Math.sin(angle) * crownDepth(t) * radial * irregularity;
          const y =
            crownY(t) +
            (hash(i + 1, 5) - 0.5) * 0.065;

          canopyPositions.push(x, y, z);
        }

        const canopyGeometry = new THREE.BufferGeometry();
        canopyGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(canopyPositions, 3)
        );

        canopy.add(new THREE.Points(canopyGeometry, canopyPointMaterial));

        const trunkPositions = [];
        const trunkRows = 72;
        const trunkSides = 11;

        for (let yi = 0; yi <= trunkRows; yi += 1) {
          const t = yi / trunkRows;
          const y = -0.06 + t * 2.35;
          const centerX = 0.025 * Math.sin(t * 3.2);
          const centerZ = 0.028 * Math.sin(t * 4.3 + 0.6);
          const radius =
            0.14 -
            0.06 * t +
            0.025 * Math.exp(-((t - 0.58) ** 2) / 0.075);

          for (let ai = 0; ai < trunkSides; ai += 1) {
            const angle = (ai / trunkSides) * Math.PI * 2;
            trunkPositions.push(
              centerX + Math.cos(angle) * radius,
              y,
              centerZ + Math.sin(angle) * radius * 0.82
            );
          }
        }

        const trunkGeometry = new THREE.BufferGeometry();
        trunkGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(trunkPositions, 3)
        );

        trunk.add(new THREE.Points(trunkGeometry, trunkPointMaterial));

        const branchCurves = [
          [
            new THREE.Vector3(0.01, 1.2, 0),
            new THREE.Vector3(-0.35, 1.5, 0.04),
            new THREE.Vector3(-0.92, 1.8, 0.08),
          ],
          [
            new THREE.Vector3(0.02, 1.42, 0.01),
            new THREE.Vector3(0.36, 1.7, 0.02),
            new THREE.Vector3(1.02, 2.02, 0.07),
          ],
          [
            new THREE.Vector3(0.01, 1.6, 0),
            new THREE.Vector3(-0.04, 1.9, -0.08),
            new THREE.Vector3(-0.26, 2.24, -0.2),
          ],
          [
            new THREE.Vector3(0.02, 1.58, 0),
            new THREE.Vector3(0.08, 1.88, 0.08),
            new THREE.Vector3(0.34, 2.2, 0.22),
          ],
        ];

        branchCurves.forEach((controlPoints) => {
          const curve = new THREE.CatmullRomCurve3(controlPoints);
          trunk.add(makeLine(curve.getPoints(30), branchLineMaterial));
        });

        const rootGeometry = new THREE.BufferGeometry();
        const rootPositions = [];

        if (wantsRoots) {
          const rootPointCount = 8200;

          for (let i = 0; i < rootPointCount; i += 1) {
            const angle = hash(i + 1, 21) * Math.PI * 2;
            const radial = Math.sqrt(hash(i + 1, 22));
            const irregularity =
              1 +
              0.085 * Math.sin(angle * 2.1) +
              0.045 * Math.cos(angle * 5.2) +
              (hash(i + 1, 23) - 0.5) * 0.06;

            const reachX = 3.35 * radial * irregularity;
            const reachZ = 2.35 * radial * irregularity;
            const depthPotential = 0.26 + 0.78 * (1 - radial);
            const depth =
              0.06 +
              Math.pow(hash(i + 1, 24), 1.85) * depthPotential;

            const x = Math.cos(angle) * reachX;
            const z = Math.sin(angle) * reachZ;
            const y =
              -0.07 -
              depth +
              0.055 * Math.sin(angle * 3.0 + radial * 5.0);

            rootPositions.push(x, y, z);
          }

          rootGeometry.setAttribute(
            'position',
            new THREE.Float32BufferAttribute(rootPositions, 3)
          );

          rootField.add(new THREE.Points(rootGeometry, rootPointMaterial));

          const rootDirections = [-2.55, -1.6, -0.72, 0.15, 0.92, 1.86, 2.65];

          rootDirections.forEach((angle, index) => {
            const points = [new THREE.Vector3(0, -0.08, 0)];

            for (let step = 1; step <= 26; step += 1) {
              const f = step / 26;
              const reach = 3.05 * Math.pow(f, 1.04);
              const sideWander =
                0.11 * Math.sin(f * 5.2 + index * 0.9);
              const x =
                Math.cos(angle) * reach +
                Math.cos(angle + Math.PI / 2) * sideWander;
              const z =
                Math.sin(angle) * reach * 0.72 +
                Math.sin(angle + Math.PI / 2) * sideWander * 0.7;
              const y =
                -0.09 -
                0.48 * Math.pow(f, 1.2) +
                0.05 * Math.sin(f * 4.0 + index);

              points.push(new THREE.Vector3(x, y, z));
            }

            rootField.add(makeLine(points, rootLineMaterial));
          });
        }

        context.visible = wantsContext;

        const groundLine = makeLine(
          [
            new THREE.Vector3(-3.8, -0.02, 0.02),
            new THREE.Vector3(3.8, -0.02, 0.02),
          ],
          groundLineMaterial
        );
        context.add(groundLine);

        const setbackCurve = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-3.8, -0.05, 1.75),
          new THREE.Vector3(-1.9, -0.05, 1.72),
          new THREE.Vector3(-1.15, -0.05, 2.08),
          new THREE.Vector3(0, -0.05, 2.48),
          new THREE.Vector3(1.15, -0.05, 2.08),
          new THREE.Vector3(1.9, -0.05, 1.72),
          new THREE.Vector3(3.8, -0.05, 1.75),
        ]);
        context.add(makeLine(setbackCurve.getPoints(64), contextLineMaterial));

        const resize = () => {
          const rect = root.getBoundingClientRect();
          const width = Math.max(1, Math.round(rect.width));
          const height = Math.max(1, Math.round(rect.height));

          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(root);
        resize();

        let isVisible = true;
        let isDocumentVisible = !document.hidden;
        let animationFrame = 0;

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting);
          },
          { rootMargin: '160px' }
        );

        intersectionObserver.observe(root);

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden;
        };

        document.addEventListener('visibilitychange', handleVisibility);

        const animate = (time) => {
          animationFrame = requestAnimationFrame(animate);
          if (!isVisible || !isDocumentVisible) return;

          controls.update();

          if (!reducedMotion) {
            const phase = time * 0.00062;
            const crownPulse = 0.5 + 0.5 * Math.sin(phase);
            const rootPulse = 0.5 + 0.5 * Math.sin(phase - 0.75);

            canopy.scale.x = 0.985 + crownPulse * 0.035;
            canopy.scale.z = 0.988 + crownPulse * 0.028;
            canopy.position.y = 0.012 * Math.sin(phase * 0.85);

            rootField.scale.x = 0.975 + rootPulse * 0.055;
            rootField.scale.z = 0.975 + rootPulse * 0.05;

            specimen.rotation.z = -0.012 + 0.012 * Math.sin(phase * 0.48);
          }

          renderer.render(scene, camera);
        };

        animationFrame = requestAnimationFrame(animate);

        const cleanup = () => {
          cancelAnimationFrame(animationFrame);
          document.removeEventListener('visibilitychange', handleVisibility);
          resizeObserver.disconnect();
          intersectionObserver.disconnect();
          controls.dispose();

          specimen.traverse((child) => {
            if (child.geometry) child.geometry.dispose();
          });

          canopyPointMaterial.dispose();
          trunkPointMaterial.dispose();
          rootPointMaterial.dispose();
          branchLineMaterial.dispose();
          rootLineMaterial.dispose();
          groundLineMaterial.dispose();
          contextLineMaterial.dispose();
          renderer.dispose();
        };

        window.addEventListener('pagehide', cleanup, { once: true });
      } catch (error) {
        console.error('PointTree failed to initialize:', error);
      }
    });
  })();
</script>
