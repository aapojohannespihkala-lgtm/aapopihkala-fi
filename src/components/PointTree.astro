---
interface Props {
  class?: string;
  autoRotate?: boolean;
  enableZoom?: boolean;
  showRoots?: boolean;
  showContext?: boolean;
}

const {
  class: className,
  autoRotate = true,
  enableZoom = true,
  showRoots = true,
  showContext = true,
} = Astro.props;
---

<div
  class:list={['point-tree', className]}
  data-point-tree
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-show-roots={showRoots ? 'true' : 'false'}
  data-show-context={showContext ? 'true' : 'false'}
  aria-hidden="true"
>
  <canvas class="point-tree__canvas" data-point-tree-canvas></canvas>
</div>

<style>
  .point-tree {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 320px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .point-tree:active {
    cursor: grabbing;
  }

  .point-tree__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-point-tree]');

    roots.forEach(async (root) => {
      if (root.dataset.pointTreeInitialized === 'true') return;
      root.dataset.pointTreeInitialized = 'true';

      const canvas = root.querySelector('[data-point-tree-canvas]');
      if (!canvas) return;

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        );

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const wantsAutoRotate = root.dataset.autoRotate !== 'false';
        const wantsZoom = root.dataset.enableZoom !== 'false';
        const wantsRoots = root.dataset.showRoots !== 'false';
        const wantsContext = root.dataset.showContext !== 'false';

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        });

        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
        renderer.setClearColor(0xffffff, 0);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(37, 1, 0.1, 100);
        camera.position.set(5.7, 3.1, 9.3);

        const specimen = new THREE.Group();
        specimen.rotation.y = -0.18;
        specimen.rotation.x = -0.015;
        scene.add(specimen);

        const structureGroup = new THREE.Group();
        const canopyGroup = new THREE.Group();
        const rootHaloGroup = new THREE.Group();
        const accentGroup = new THREE.Group();
        const contextGroup = new THREE.Group();

        specimen.add(
          structureGroup,
          canopyGroup,
          rootHaloGroup,
          accentGroup,
          contextGroup
        );

        const controls = new OrbitControls(camera, renderer.domElement);
        controls.enablePan = false;
        controls.enableZoom = wantsZoom;
        controls.enableDamping = true;
        controls.dampingFactor = 0.055;
        controls.rotateSpeed = 0.5;
        controls.minPolarAngle = Math.PI * 0.24;
        controls.maxPolarAngle = Math.PI * 0.70;
        controls.target.set(0, 0.9, 0);
        controls.autoRotate = wantsAutoRotate && !reducedMotion;
        controls.autoRotateSpeed = 0.2;

        if (wantsZoom) {
          controls.minDistance = 7.6;
          controls.maxDistance = 12.1;
          controls.zoomSpeed = 0.5;
        } else {
          const lockedDistance = camera.position.length();
          controls.minDistance = lockedDistance;
          controls.maxDistance = lockedDistance;
        }

        const structureMaterial = new THREE.PointsMaterial({
          color: 0x30332f,
          size: 0.03,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.82,
        });

        const canopyMaterial = new THREE.PointsMaterial({
          color: 0x353832,
          size: 0.023,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.55,
        });

        const rootHaloMaterial = new THREE.PointsMaterial({
          color: 0x596158,
          size: 0.02,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.32,
        });

        const accentMaterial = new THREE.LineBasicMaterial({
          color: 0x667066,
          transparent: true,
          opacity: 0.16,
        });

        const contextMaterial = new THREE.LineBasicMaterial({
          color: 0x92978f,
          transparent: true,
          opacity: 0.16,
        });

        const hash = (value, salt = 0) => {
          const x = Math.sin(value * 127.1 + salt * 311.7) * 43758.5453123;
          return x - Math.floor(x);
        };

        const makeLine = (points, material, closed = false) => {
          const geometry = new THREE.BufferGeometry().setFromPoints(points);
          return closed
            ? new THREE.LineLoop(geometry, material)
            : new THREE.Line(geometry, material);
        };

        const structurePositions = [];

        const addTubeCloud = ({
          curve,
          segments,
          density,
          startRadius,
          endRadius,
          seed,
          flatten = 1,
        }) => {
          const tangent = new THREE.Vector3();
          const normal = new THREE.Vector3();
          const binormal = new THREE.Vector3();
          const upY = new THREE.Vector3(0, 1, 0);
          const upX = new THREE.Vector3(1, 0, 0);

          for (let si = 0; si <= segments; si += 1) {
            const t = si / segments;
            const center = curve.getPoint(t);
            tangent.copy(curve.getTangent(t)).normalize();

            const up = Math.abs(tangent.dot(upY)) > 0.9 ? upX : upY;
            normal.crossVectors(up, tangent).normalize();
            binormal.crossVectors(tangent, normal).normalize();

            const baseRadius = THREE.MathUtils.lerp(startRadius, endRadius, t);

            for (let pi = 0; pi < density; pi += 1) {
              const n = seed * 10000 + si * 137 + pi * 19;
              const angle = hash(n, 1) * Math.PI * 2;
              const radius =
                Math.sqrt(hash(n, 2)) *
                baseRadius *
                (0.82 + 0.32 * hash(n, 3));
              const axial =
                (hash(n, 4) - 0.5) * baseRadius * 0.5;

              const offset = new THREE.Vector3()
                .copy(normal)
                .multiplyScalar(Math.cos(angle) * radius)
                .add(
                  new THREE.Vector3()
                    .copy(binormal)
                    .multiplyScalar(Math.sin(angle) * radius * flatten)
                )
                .add(
                  new THREE.Vector3()
                    .copy(tangent)
                    .multiplyScalar(axial)
                );

              structurePositions.push(
                center.x + offset.x,
                center.y + offset.y,
                center.z + offset.z
              );
            }
          }
        };

        const trunkCurve = new THREE.CatmullRomCurve3([
          new THREE.Vector3(0, -0.03, 0),
          new THREE.Vector3(0.02, 0.72, 0.015),
          new THREE.Vector3(0.035, 1.42, 0.02),
          new THREE.Vector3(0.02, 2.1, 0.01),
        ]);

        addTubeCloud({
          curve: trunkCurve,
          segments: 82,
          density: 14,
          startRadius: 0.16,
          endRadius: 0.075,
          seed: 1,
          flatten: 0.86,
        });

        const branchDefs = [
          [[0.01, 1.08, 0], [-0.3, 1.38, 0.02], [-0.82, 1.72, 0.06], [-1.45, 2.08, 0.1]],
          [[0.02, 1.28, 0.01], [0.36, 1.55, 0.02], [0.9, 1.86, 0.05], [1.48, 2.14, 0.08]],
          [[0.02, 1.5, 0], [-0.06, 1.78, -0.07], [-0.3, 2.14, -0.2]],
          [[0.02, 1.55, 0], [0.11, 1.84, 0.08], [0.38, 2.18, 0.23]],
          [[0.01, 0.9, 0], [-0.26, 1.15, -0.03], [-0.68, 1.43, -0.08]],
          [[0.02, 0.98, 0.01], [0.28, 1.2, 0.02], [0.68, 1.48, 0.05]],
        ];

        branchDefs.forEach((definition, index) => {
          addTubeCloud({
            curve: new THREE.CatmullRomCurve3(
              definition.map(([x, y, z]) => new THREE.Vector3(x, y, z))
            ),
            segments: definition.length === 4 ? 40 : 28,
            density: definition.length === 4 ? 9 : 7,
            startRadius: definition.length === 4 ? 0.078 : 0.055,
            endRadius: definition.length === 4 ? 0.02 : 0.016,
            seed: 10 + index,
            flatten: 0.86,
          });
        });

        if (wantsRoots) {
          const rootDefs = [
            [[0, -0.03, 0], [-0.32, -0.12, 0.06], [-0.9, -0.23, 0.14], [-1.72, -0.34, 0.2], [-2.65, -0.43, 0.22]],
            [[0, -0.03, 0], [0.34, -0.11, 0.02], [1.02, -0.22, 0.03], [1.9, -0.34, 0.0], [2.78, -0.43, -0.02]],
            [[0, -0.03, 0], [-0.1, -0.11, -0.26], [-0.36, -0.23, -0.78], [-0.73, -0.34, -1.48], [-1.02, -0.44, -2.22]],
            [[0, -0.03, 0], [0.14, -0.1, 0.22], [0.55, -0.22, 0.74], [1.08, -0.34, 1.4], [1.75, -0.44, 2.02]],
            [[0, -0.03, 0], [0.12, -0.11, -0.14], [0.32, -0.22, -0.56], [0.55, -0.35, -1.18], [0.82, -0.44, -1.9]],
            [[0, -0.03, 0], [-0.16, -0.1, 0.18], [-0.55, -0.2, 0.62], [-1.08, -0.32, 1.05], [-1.7, -0.42, 1.42]],
          ];

          rootDefs.forEach((definition, index) => {
            addTubeCloud({
              curve: new THREE.CatmullRomCurve3(
                definition.map(([x, y, z]) => new THREE.Vector3(x, y, z))
              ),
              segments: 38,
              density: 9,
              startRadius: 0.08,
              endRadius: 0.022,
              seed: 30 + index,
              flatten: 0.74,
            });
          });
        }

        const structureGeometry = new THREE.BufferGeometry();
        structureGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(structurePositions, 3)
        );
        structureGroup.add(new THREE.Points(structureGeometry, structureMaterial));

        const crownWidth = (t) => {
          const bell = Math.pow(Math.max(0, Math.sin(Math.PI * t)), 0.61);
          const upper = 0.16 * Math.exp(-((t - 0.68) ** 2) / 0.032);
          const lower = 0.1 * Math.exp(-((t - 0.27) ** 2) / 0.04);
          return 0.33 + 2.02 * bell + upper + lower;
        };

        const crownDepth = (t) => {
          const bell = Math.pow(Math.max(0, Math.sin(Math.PI * t)), 0.74);
          return 0.27 + 1.36 * bell;
        };

        const crownCenterX = (t) =>
          -0.1 +
          0.12 * Math.sin(t * 4.5 + 0.2) +
          0.04 * Math.sin(t * 10.9);

        const crownCenterZ = (t) =>
          0.05 * Math.sin(t * 5.6 - 0.35);

        const crownY = (t) => 0.98 + t * 2.32;

        const canopyPositions = [];
        const canopyPointCount = 11600;

        for (let i = 0; i < canopyPointCount; i += 1) {
          const t = 0.025 + hash(i + 1, 41) * 0.95;
          const angle = hash(i + 1, 42) * Math.PI * 2;
          const radial = Math.sqrt(hash(i + 1, 43));
          const irregularity =
            1 +
            0.05 * Math.sin(angle * 3 + t * 5.2) +
            0.032 * Math.cos(angle * 5 - t * 7.1) +
            (hash(i + 1, 44) - 0.5) * 0.06;

          canopyPositions.push(
            crownCenterX(t) + Math.cos(angle) * crownWidth(t) * radial * irregularity,
            crownY(t) + (hash(i + 1, 45) - 0.5) * 0.075,
            crownCenterZ(t) + Math.sin(angle) * crownDepth(t) * radial * irregularity
          );
        }

        const canopyGeometry = new THREE.BufferGeometry();
        canopyGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(canopyPositions, 3)
        );
        canopyGroup.add(new THREE.Points(canopyGeometry, canopyMaterial));

        const rootHaloPositions = [];

        if (wantsRoots) {
          const rootHaloCount = 8200;

          for (let i = 0; i < rootHaloCount; i += 1) {
            const angle = hash(i + 1, 51) * Math.PI * 2;
            const radial = Math.pow(hash(i + 1, 52), 0.68);
            const irregularity =
              1 +
              0.085 * Math.sin(angle * 2.1) +
              0.04 * Math.cos(angle * 5.1) +
              (hash(i + 1, 53) - 0.5) * 0.1;

            const reach = 3.5 * radial * irregularity;
            const x = Math.cos(angle) * reach * 1.03;
            const z = Math.sin(angle) * reach * 0.72;
            const y =
              -0.1 -
              0.34 * radial +
              (hash(i + 1, 54) - 0.5) * 0.06;

            rootHaloPositions.push(x, y, z);
          }
        }

        const rootHaloGeometry = new THREE.BufferGeometry();
        rootHaloGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(rootHaloPositions, 3)
        );
        rootHaloGroup.add(new THREE.Points(rootHaloGeometry, rootHaloMaterial));

        [0.35, 0.69].forEach((t) => {
          const points = [];

          for (let ai = 0; ai <= 88; ai += 1) {
            const angle = (ai / 88) * Math.PI * 2;
            const wobble =
              1 +
              0.035 * Math.sin(angle * 3 + t * 4) +
              0.02 * Math.cos(angle * 5 - t * 6);

            points.push(
              new THREE.Vector3(
                crownCenterX(t) + Math.cos(angle) * crownWidth(t) * wobble,
                crownY(t),
                crownCenterZ(t) + Math.sin(angle) * crownDepth(t) * wobble
              )
            );
          }

          accentGroup.add(makeLine(points, accentMaterial, true));
        });

        if (wantsRoots) {
          const points = [];
          const radius = 3.05;

          for (let ai = 0; ai <= 92; ai += 1) {
            const angle = (ai / 92) * Math.PI * 2;
            const wobble =
              1 +
              0.05 * Math.sin(angle * 2.2) +
              0.025 * Math.cos(angle * 5.2);

            points.push(
              new THREE.Vector3(
                Math.cos(angle) * radius * wobble * 1.03,
                -0.26,
                Math.sin(angle) * radius * wobble * 0.7
              )
            );
          }

          accentGroup.add(makeLine(points, accentMaterial, true));
        }

        contextGroup.visible = wantsContext;

        contextGroup.add(
          makeLine(
            [
              new THREE.Vector3(-4.2, -0.025, 0),
              new THREE.Vector3(4.2, -0.025, 0),
            ],
            contextMaterial
          )
        );

        const setbackCurve = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-3.8, -0.07, 1.9),
          new THREE.Vector3(-1.9, -0.07, 1.86),
          new THREE.Vector3(-0.95, -0.07, 2.28),
          new THREE.Vector3(0, -0.07, 2.58),
          new THREE.Vector3(0.95, -0.07, 2.28),
          new THREE.Vector3(1.9, -0.07, 1.86),
          new THREE.Vector3(3.8, -0.07, 1.9),
        ]);
        contextGroup.add(makeLine(setbackCurve.getPoints(58), contextMaterial));

        const resize = () => {
          const rect = root.getBoundingClientRect();
          const width = Math.max(1, Math.round(rect.width));
          const height = Math.max(1, Math.round(rect.height));

          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(root);
        resize();

        let isVisible = true;
        let isDocumentVisible = !document.hidden;
        let animationFrame = 0;

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting);
          },
          { rootMargin: '160px' }
        );
        intersectionObserver.observe(root);

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden;
        };
        document.addEventListener('visibilitychange', handleVisibility);

        const animate = (time) => {
          animationFrame = requestAnimationFrame(animate);
          if (!isVisible || !isDocumentVisible) return;

          controls.update();

          if (!reducedMotion) {
            const phase = time * 0.00058;
            const breath = 0.5 + 0.5 * Math.sin(phase);

            canopyGroup.scale.x = 0.985 + breath * 0.035;
            canopyGroup.scale.z = 0.988 + breath * 0.027;
            canopyGroup.position.y = 0.012 * Math.sin(phase * 0.82);

            rootHaloGroup.scale.x = 0.978 + breath * 0.045;
            rootHaloGroup.scale.z = 0.98 + breath * 0.04;

            specimen.rotation.z = -0.01 + 0.01 * Math.sin(phase * 0.5);
          }

          renderer.render(scene, camera);
        };

        animationFrame = requestAnimationFrame(animate);

        const cleanup = () => {
          cancelAnimationFrame(animationFrame);
          document.removeEventListener('visibilitychange', handleVisibility);
          resizeObserver.disconnect();
          intersectionObserver.disconnect();
          controls.dispose();

          specimen.traverse((child) => {
            if (child.geometry) child.geometry.dispose();
          });

          structureMaterial.dispose();
          canopyMaterial.dispose();
          rootHaloMaterial.dispose();
          accentMaterial.dispose();
          contextMaterial.dispose();
          renderer.dispose();
        };

        window.addEventListener('pagehide', cleanup, { once: true });
      } catch (error) {
        console.error('PointTree failed to initialize:', error);
      }
    });
  })();
</script>
