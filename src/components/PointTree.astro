---
interface Props {
  class?: string
  autoRotate?: boolean
  enableZoom?: boolean
  scale?: number
  cameraDistance?: number
  showHints?: boolean
}

const {
  class: className,
  autoRotate = true,
  enableZoom = true,
  scale = 1,
  cameraDistance = 9.2,
  showHints = false,
} = Astro.props
---

<div
  class:list={['point-tree', className]}
  data-point-tree
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-scale={scale}
  data-camera-distance={cameraDistance}
  data-show-hints={showHints ? 'true' : 'false'}
  aria-hidden="true"
>
  <canvas class="point-tree__canvas" data-point-tree-canvas></canvas>
</div>

<style>
  .point-tree {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 320px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .point-tree:active {
    cursor: grabbing;
  }

  .point-tree__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-point-tree]')

    roots.forEach(async (root) => {
      if (root.dataset.pointTreeInitialized === 'true') return
      root.dataset.pointTreeInitialized = 'true'

      const canvas = root.querySelector('[data-point-tree-canvas]')
      if (!canvas) return

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm')
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        )

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const wantsAutoRotate = root.dataset.autoRotate !== 'false'
        const wantsZoom = root.dataset.enableZoom !== 'false'
        const wantsHints = root.dataset.showHints === 'true'

        const requestedScale = Number(root.dataset.scale ?? '1')
        const requestedCameraDistance = Number(root.dataset.cameraDistance ?? '9.2')

        const displayScale = Number.isFinite(requestedScale) ? requestedScale : 1
        const camDistance = Number.isFinite(requestedCameraDistance)
          ? requestedCameraDistance
          : 9.2

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        })

        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6))
        renderer.setClearColor(0xffffff, 0)

        const scene = new THREE.Scene()

        const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100)
        camera.position.set(6.35, 4.4, camDistance)

        const specimen = new THREE.Group()
        specimen.scale.setScalar(displayScale)
        specimen.rotation.y = -0.16
        specimen.rotation.x = -0.02
        scene.add(specimen)

        const structureGroup = new THREE.Group()
        const canopyGroup = new THREE.Group()
        const fineRootGroup = new THREE.Group()
        const hintGroup = new THREE.Group()

        specimen.add(structureGroup, canopyGroup, fineRootGroup, hintGroup)
        hintGroup.visible = wantsHints

        const controls = new OrbitControls(camera, renderer.domElement)
        controls.enablePan = false
        controls.enableZoom = wantsZoom
        controls.enableDamping = true
        controls.dampingFactor = 0.055
        controls.rotateSpeed = 0.52
        controls.minPolarAngle = Math.PI * 0.22
        controls.maxPolarAngle = Math.PI * 0.74
        controls.target.set(0, 1.45, 0)
        controls.autoRotate = wantsAutoRotate && !reducedMotion
        controls.autoRotateSpeed = 0.2

        if (wantsZoom) {
          controls.minDistance = 7.8
          controls.maxDistance = 12.8
          controls.zoomSpeed = 0.55
        } else {
          const lockedDistance = camera.position.length()
          controls.minDistance = lockedDistance
          controls.maxDistance = lockedDistance
        }

        const structureMaterial = new THREE.PointsMaterial({
          color: 0x2f322e,
          size: 0.027,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.84,
        })

        const canopyMaterial = new THREE.PointsMaterial({
          color: 0x373a36,
          size: 0.023,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.34,
        })

        const fineRootMaterial = new THREE.PointsMaterial({
          color: 0x5e665f,
          size: 0.02,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.22,
        })

        const hintLineMaterial = new THREE.LineBasicMaterial({
          color: 0x727a72,
          transparent: true,
          opacity: 0.1,
        })

        const hash = (value, salt = 0) => {
          const x = Math.sin(value * 127.1 + salt * 311.7) * 43758.5453123
          return x - Math.floor(x)
        }

        const makeLine = (points, material, closed = false) => {
          const geometry = new THREE.BufferGeometry().setFromPoints(points)
          return closed
            ? new THREE.LineLoop(geometry, material)
            : new THREE.Line(geometry, material)
        }

        const addTubeCloud = (
          target,
          curve,
          segmentCount,
          pointsPerSegment,
          startRadius,
          endRadius,
          elliptic = 0.9,
          axialJitter = 0.34
        ) => {
          const tangent = new THREE.Vector3()
          const normal = new THREE.Vector3()
          const binormal = new THREE.Vector3()
          const upA = new THREE.Vector3(0, 1, 0)
          const upB = new THREE.Vector3(1, 0, 0)

          for (let si = 0; si <= segmentCount; si += 1) {
            const t = si / segmentCount
            const center = curve.getPoint(t)
            tangent.copy(curve.getTangent(t)).normalize()

            const up = Math.abs(tangent.y) > 0.92 ? upB : upA
            normal.crossVectors(up, tangent).normalize()
            binormal.crossVectors(tangent, normal).normalize()

            const radius = THREE.MathUtils.lerp(startRadius, endRadius, t)

            for (let pi = 0; pi < pointsPerSegment; pi += 1) {
              const seed = si * 1009 + pi * 917 + target.length * 0.013
              const angle = hash(seed, 1) * Math.PI * 2
              const rr = Math.sqrt(hash(seed, 2)) * radius * (0.84 + 0.28 * hash(seed, 3))
              const axial = (hash(seed, 4) - 0.5) * radius * axialJitter

              const offset = new THREE.Vector3()
                .copy(normal)
                .multiplyScalar(Math.cos(angle) * rr)
                .add(
                  new THREE.Vector3()
                    .copy(binormal)
                    .multiplyScalar(Math.sin(angle) * rr * elliptic)
                )
                .add(
                  new THREE.Vector3()
                    .copy(tangent)
                    .multiplyScalar(axial)
                )

              target.push(
                center.x + offset.x,
                center.y + offset.y,
                center.z + offset.z
              )
            }
          }
        }

        const structurePositions = []
        const branchAnchors = []
        const rootAnchors = []

        const trunkCurve = new THREE.CatmullRomCurve3([
          new THREE.Vector3(0, -0.14, 0),
          new THREE.Vector3(0.02, 0.48, 0.02),
          new THREE.Vector3(0.04, 1.2, 0.02),
          new THREE.Vector3(0.02, 1.95, 0.0),
          new THREE.Vector3(0, 2.38, 0),
        ])

        addTubeCloud(structurePositions, trunkCurve, 84, 10, 0.2, 0.075, 0.9, 0.28)

        const flareCurves = [
          [
            new THREE.Vector3(0, -0.22, 0),
            new THREE.Vector3(-0.14, -0.12, 0.04),
            new THREE.Vector3(-0.28, -0.04, 0.08),
          ],
          [
            new THREE.Vector3(0, -0.22, 0),
            new THREE.Vector3(0.16, -0.12, 0.02),
            new THREE.Vector3(0.3, -0.04, 0.06),
          ],
          [
            new THREE.Vector3(0, -0.22, 0),
            new THREE.Vector3(0.04, -0.12, -0.16),
            new THREE.Vector3(0.1, -0.04, -0.28),
          ],
        ]

        flareCurves.forEach((points) => {
          addTubeCloud(
            structurePositions,
            new THREE.CatmullRomCurve3(points),
            14,
            18,
            0.18,
            0.11,
            0.92,
            0.22
          )
        })

        const branchDefs = [
          { points: [new THREE.Vector3(0.02, 1.12, 0.02), new THREE.Vector3(-0.22, 1.38, 0.04), new THREE.Vector3(-0.66, 1.74, 0.08), new THREE.Vector3(-1.18, 2.05, 0.12), new THREE.Vector3(-1.62, 2.22, 0.18)], start: 0.08, end: 0.022 },
          { points: [new THREE.Vector3(0.02, 1.22, 0.02), new THREE.Vector3(0.22, 1.44, 0.02), new THREE.Vector3(0.72, 1.78, 0.02), new THREE.Vector3(1.26, 2.04, 0.05), new THREE.Vector3(1.72, 2.2, 0.1)], start: 0.078, end: 0.022 },
          { points: [new THREE.Vector3(0.02, 1.26, 0.02), new THREE.Vector3(-0.06, 1.52, -0.18), new THREE.Vector3(-0.26, 1.84, -0.6), new THREE.Vector3(-0.52, 2.1, -1.06), new THREE.Vector3(-0.78, 2.24, -1.42)], start: 0.062, end: 0.018 },
          { points: [new THREE.Vector3(0.02, 1.28, 0.02), new THREE.Vector3(0.1, 1.54, 0.2), new THREE.Vector3(0.34, 1.84, 0.62), new THREE.Vector3(0.62, 2.08, 1.04), new THREE.Vector3(0.92, 2.2, 1.38)], start: 0.06, end: 0.018 },
          { points: [new THREE.Vector3(0.01, 1.46, 0.02), new THREE.Vector3(-0.02, 1.74, 0.16), new THREE.Vector3(0.06, 2.04, 0.5), new THREE.Vector3(0.18, 2.28, 0.88)], start: 0.048, end: 0.017 },
          { points: [new THREE.Vector3(0.01, 1.42, 0.02), new THREE.Vector3(-0.12, 1.68, -0.08), new THREE.Vector3(-0.38, 1.94, -0.26), new THREE.Vector3(-0.62, 2.1, -0.44)], start: 0.046, end: 0.016 },
          { points: [new THREE.Vector3(0.02, 1.04, 0.02), new THREE.Vector3(-0.22, 1.26, -0.04), new THREE.Vector3(-0.58, 1.48, -0.1), new THREE.Vector3(-0.88, 1.62, -0.18)], start: 0.048, end: 0.016 },
          { points: [new THREE.Vector3(0.02, 1.06, 0.02), new THREE.Vector3(0.2, 1.28, 0.06), new THREE.Vector3(0.52, 1.5, 0.18), new THREE.Vector3(0.82, 1.64, 0.34)], start: 0.048, end: 0.016 },
        ]

        branchDefs.forEach((branch, index) => {
          const curve = new THREE.CatmullRomCurve3(branch.points)
          addTubeCloud(structurePositions, curve, 28, index < 2 ? 8 : 7, branch.start, branch.end, 0.88, 0.24)
          branchAnchors.push(branch.points[branch.points.length - 1])
          branchAnchors.push(branch.points[Math.max(1, branch.points.length - 2)])
        })

        const rootDefs = [
          { points: [new THREE.Vector3(0, -0.08, 0), new THREE.Vector3(-0.28, -0.14, 0.08), new THREE.Vector3(-0.92, -0.26, 0.18), new THREE.Vector3(-1.76, -0.36, 0.26), new THREE.Vector3(-2.64, -0.44, 0.34)], start: 0.082, end: 0.026 },
          { points: [new THREE.Vector3(0, -0.08, 0), new THREE.Vector3(0.3, -0.14, 0.04), new THREE.Vector3(0.98, -0.24, 0.06), new THREE.Vector3(1.84, -0.34, 0.06), new THREE.Vector3(2.78, -0.43, 0.04)], start: 0.082, end: 0.026 },
          { points: [new THREE.Vector3(0, -0.08, 0), new THREE.Vector3(-0.08, -0.15, -0.22), new THREE.Vector3(-0.28, -0.25, -0.74), new THREE.Vector3(-0.56, -0.35, -1.44), new THREE.Vector3(-0.82, -0.42, -2.2)], start: 0.058, end: 0.02 },
          { points: [new THREE.Vector3(0, -0.08, 0), new THREE.Vector3(0.14, -0.15, 0.22), new THREE.Vector3(0.46, -0.25, 0.76), new THREE.Vector3(0.88, -0.35, 1.42), new THREE.Vector3(1.34, -0.42, 2.08)], start: 0.058, end: 0.02 },
          { points: [new THREE.Vector3(0, -0.08, 0), new THREE.Vector3(-0.18, -0.14, 0.18), new THREE.Vector3(-0.58, -0.24, 0.62), new THREE.Vector3(-1.08, -0.34, 1.1), new THREE.Vector3(-1.54, -0.42, 1.54)], start: 0.05, end: 0.018 },
          { points: [new THREE.Vector3(0, -0.08, 0), new THREE.Vector3(0.1, -0.14, -0.18), new THREE.Vector3(0.28, -0.24, -0.58), new THREE.Vector3(0.52, -0.34, -1.14), new THREE.Vector3(0.76, -0.42, -1.74)], start: 0.05, end: 0.018 },
          { points: [new THREE.Vector3(0, -0.08, 0), new THREE.Vector3(0.2, -0.14, 0.12), new THREE.Vector3(0.62, -0.23, 0.4), new THREE.Vector3(1.16, -0.32, 0.74), new THREE.Vector3(1.66, -0.4, 1.02)], start: 0.046, end: 0.017 },
          { points: [new THREE.Vector3(0, -0.08, 0), new THREE.Vector3(-0.12, -0.15, -0.12), new THREE.Vector3(-0.42, -0.24, -0.38), new THREE.Vector3(-0.82, -0.33, -0.72), new THREE.Vector3(-1.18, -0.4, -1.02)], start: 0.046, end: 0.017 },
        ]

        rootDefs.forEach((rootDef, index) => {
          const curve = new THREE.CatmullRomCurve3(rootDef.points)
          addTubeCloud(structurePositions, curve, 28, index < 2 ? 8 : 7, rootDef.start, rootDef.end, 0.92, 0.2)
          rootAnchors.push(rootDef.points[rootDef.points.length - 1])
          rootAnchors.push(rootDef.points[Math.max(1, rootDef.points.length - 2)])
        })

        const structureGeometry = new THREE.BufferGeometry()
        structureGeometry.setAttribute('position', new THREE.Float32BufferAttribute(structurePositions, 3))
        const structurePoints = new THREE.Points(structureGeometry, structureMaterial)
        structureGroup.add(structurePoints)

        const canopyPositions = []
        const canopyClusters = [
          { center: [-1.45, 2.18, -0.12], rx: 0.78, ry: 0.56, rz: 0.76, count: 740 },
          { center: [-1.02, 2.44, -0.92], rx: 0.8, ry: 0.58, rz: 0.78, count: 720 },
          { center: [-0.18, 2.68, -1.18], rx: 0.82, ry: 0.62, rz: 0.8, count: 760 },
          { center: [0.82, 2.56, -1.02], rx: 0.82, ry: 0.58, rz: 0.8, count: 760 },
          { center: [1.46, 2.26, -0.26], rx: 0.78, ry: 0.54, rz: 0.74, count: 680 },
          { center: [1.42, 2.22, 0.56], rx: 0.78, ry: 0.54, rz: 0.74, count: 680 },
          { center: [0.74, 2.52, 1.12], rx: 0.84, ry: 0.6, rz: 0.82, count: 780 },
          { center: [-0.18, 2.7, 1.22], rx: 0.86, ry: 0.64, rz: 0.84, count: 820 },
          { center: [-1.04, 2.42, 1.0], rx: 0.8, ry: 0.58, rz: 0.78, count: 740 },
          { center: [-1.4, 2.18, 0.22], rx: 0.76, ry: 0.52, rz: 0.72, count: 660 },
          { center: [0.04, 2.92, 0.02], rx: 0.92, ry: 0.54, rz: 0.92, count: 840 },
          { center: [0.06, 2.32, 0.02], rx: 1.06, ry: 0.66, rz: 1.02, count: 960 },
        ]

        canopyClusters.forEach((cluster, clusterIndex) => {
          for (let i = 0; i < cluster.count; i += 1) {
            const seed = clusterIndex * 100000 + i + 1
            const u = hash(seed, 11)
            const v = hash(seed, 12)
            const w = hash(seed, 13)
            const theta = u * Math.PI * 2
            const phi = Math.acos(2 * v - 1)
            const radius = 0.28 + 0.72 * Math.pow(w, 0.46)
            const nx = Math.sin(phi) * Math.cos(theta)
            const ny = Math.cos(phi)
            const nz = Math.sin(phi) * Math.sin(theta)
            const x = cluster.center[0] + nx * cluster.rx * radius + (hash(seed, 14) - 0.5) * 0.045
            const y = cluster.center[1] + ny * cluster.ry * radius + (hash(seed, 15) - 0.5) * 0.045
            const z = cluster.center[2] + nz * cluster.rz * radius + (hash(seed, 16) - 0.5) * 0.045
            canopyPositions.push(x, y, z)
          }
        })

        branchAnchors.forEach((anchor, idx) => {
          for (let i = 0; i < 160; i += 1) {
            const seed = idx * 1000 + i + 1
            const theta = hash(seed, 21) * Math.PI * 2
            const phi = Math.acos(2 * hash(seed, 22) - 1)
            const radius = 0.06 + 0.28 * Math.pow(hash(seed, 23), 0.52)
            canopyPositions.push(
              anchor.x + Math.sin(phi) * Math.cos(theta) * radius,
              anchor.y + Math.cos(phi) * radius * 0.7,
              anchor.z + Math.sin(phi) * Math.sin(theta) * radius
            )
          }
        })

        const canopyGeometry = new THREE.BufferGeometry()
        canopyGeometry.setAttribute('position', new THREE.Float32BufferAttribute(canopyPositions, 3))
        const canopyPoints = new THREE.Points(canopyGeometry, canopyMaterial)
        canopyGroup.add(canopyPoints)

        const fineRootPositions = []

        for (let i = 0; i < 2600; i += 1) {
          const angle = hash(i + 1, 31) * Math.PI * 2
          const radial = 0.24 + 3.1 * Math.pow(hash(i + 1, 32), 0.72)
          const irregularity = 1 + 0.08 * Math.sin(angle * 2.3) + 0.06 * Math.cos(angle * 4.8) + (hash(i + 1, 33) - 0.5) * 0.16
          const x = Math.cos(angle) * radial * irregularity
          const z = Math.sin(angle) * radial * irregularity * 0.94
          const y = -0.18 - 0.22 * Math.pow(radial / 3.2, 1.08) + (hash(i + 1, 34) - 0.5) * 0.07
          fineRootPositions.push(x, y, z)
        }

        rootAnchors.forEach((anchor, idx) => {
          for (let i = 0; i < 170; i += 1) {
            const seed = idx * 1000 + i + 1
            const theta = hash(seed, 41) * Math.PI * 2
            const rr = 0.05 + 0.34 * Math.pow(hash(seed, 42), 0.7)
            fineRootPositions.push(
              anchor.x + Math.cos(theta) * rr,
              anchor.y + (hash(seed, 43) - 0.5) * 0.08,
              anchor.z + Math.sin(theta) * rr * 0.92
            )
          }
        })

        const fineRootGeometry = new THREE.BufferGeometry()
        fineRootGeometry.setAttribute('position', new THREE.Float32BufferAttribute(fineRootPositions, 3))
        const fineRootPoints = new THREE.Points(fineRootGeometry, fineRootMaterial)
        fineRootGroup.add(fineRootPoints)

        if (wantsHints) {
          const crownHint = []
          for (let i = 0; i <= 72; i += 1) {
            const a = (i / 72) * Math.PI * 2
            const wobble = 1 + 0.03 * Math.sin(a * 3) + 0.02 * Math.cos(a * 5)
            crownHint.push(new THREE.Vector3(Math.cos(a) * 2.05 * wobble, 2.42, Math.sin(a) * 1.98 * wobble))
          }
          hintGroup.add(makeLine(crownHint, hintLineMaterial, true))

          const rootHint = []
          for (let i = 0; i <= 72; i += 1) {
            const a = (i / 72) * Math.PI * 2
            const wobble = 1 + 0.04 * Math.sin(a * 2.6) + 0.02 * Math.cos(a * 4.4)
            rootHint.push(new THREE.Vector3(Math.cos(a) * 3.04 * wobble, -0.38, Math.sin(a) * 2.62 * wobble * 0.74))
          }
          hintGroup.add(makeLine(rootHint, hintLineMaterial, true))
        }

        const resize = () => {
          const rect = root.getBoundingClientRect()
          const width = Math.max(1, Math.round(rect.width))
          const height = Math.max(1, Math.round(rect.height))
          renderer.setSize(width, height, false)
          camera.aspect = width / height
          camera.updateProjectionMatrix()
        }

        const resizeObserver = new ResizeObserver(resize)
        resizeObserver.observe(root)
        resize()

        let isVisible = true
        let isDocumentVisible = !document.hidden
        let animationFrame = 0

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting)
          },
          { rootMargin: '160px' }
        )

        intersectionObserver.observe(root)

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden
        }

        document.addEventListener('visibilitychange', handleVisibility)

        const animate = (time) => {
          animationFrame = requestAnimationFrame(animate)
          if (!isVisible || !isDocumentVisible) return
          controls.update()
          if (!reducedMotion) {
            const phase = time * 0.00042
            specimen.rotation.y = -0.16 + 0.02 * Math.sin(phase * 0.6)
            specimen.rotation.z = 0.008 * Math.sin(phase * 0.82)
            structureGroup.rotation.z = 0.004 * Math.sin(phase * 1.1)
            canopyGroup.position.x = 0.03 * Math.sin(phase * 0.9)
            canopyGroup.position.y = 0.015 * Math.sin(phase * 1.04)
            canopyGroup.rotation.z = 0.01 * Math.sin(phase * 1.06)
          }
          renderer.render(scene, camera)
        }

        animationFrame = requestAnimationFrame(animate)

        const cleanup = () => {
          cancelAnimationFrame(animationFrame)
          document.removeEventListener('visibilitychange', handleVisibility)
          resizeObserver.disconnect()
          intersectionObserver.disconnect()
          controls.dispose()
          specimen.traverse((child) => {
            if (child.geometry) child.geometry.dispose()
          })
          structureMaterial.dispose()
          canopyMaterial.dispose()
          fineRootMaterial.dispose()
          hintLineMaterial.dispose()
          renderer.dispose()
        }

        window.addEventListener('pagehide', cleanup, { once: true })
      } catch (error) {
        console.error('PointTree failed to initialize:', error)
      }
    })
  })()
</script>
