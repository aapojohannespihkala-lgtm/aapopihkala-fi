---
interface Props {
  class?: string;
  autoRotate?: boolean;
  enableZoom?: boolean;
  showRoots?: boolean;
  showContext?: boolean;
}

const {
  class: className,
  autoRotate = true,
  enableZoom = true,
  showRoots = true,
  showContext = true,
} = Astro.props;
---

<div
  class:list={['point-tree', className]}
  data-point-tree
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-show-roots={showRoots ? 'true' : 'false'}
  data-show-context={showContext ? 'true' : 'false'}
  aria-hidden="true"
>
  <canvas class="point-tree__canvas" data-point-tree-canvas></canvas>
</div>

<style>
  .point-tree {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 320px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .point-tree:active {
    cursor: grabbing;
  }

  .point-tree__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-point-tree]');

    roots.forEach(async (root) => {
      if (root.dataset.pointTreeInitialized === 'true') return;
      root.dataset.pointTreeInitialized = 'true';

      const canvas = root.querySelector('[data-point-tree-canvas]');
      if (!canvas) return;

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        );

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const wantsAutoRotate = root.dataset.autoRotate !== 'false';
        const wantsZoom = root.dataset.enableZoom !== 'false';
        const wantsRoots = root.dataset.showRoots !== 'false';
        const wantsContext = root.dataset.showContext !== 'false';

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        });

        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
        renderer.setClearColor(0xffffff, 0);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
        camera.position.set(5.3, 3.25, 7.6);

        const specimen = new THREE.Group();
        specimen.rotation.y = -0.16;
        scene.add(specimen);

        const controls = new OrbitControls(camera, renderer.domElement);
        controls.enablePan = false;
        controls.enableZoom = wantsZoom;
        controls.enableDamping = true;
        controls.dampingFactor = 0.055;
        controls.rotateSpeed = 0.52;
        controls.minPolarAngle = Math.PI * 0.22;
        controls.maxPolarAngle = Math.PI * 0.72;
        controls.target.set(0, 0.72, 0);
        controls.autoRotate = wantsAutoRotate && !reducedMotion;
        controls.autoRotateSpeed = 0.25;

        if (wantsZoom) {
          controls.minDistance = 7.1;
          controls.maxDistance = 11.6;
          controls.zoomSpeed = 0.5;
        }

        const pointMaterial = new THREE.PointsMaterial({
          color: 0x353832,
          size: 0.026,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.68,
        });

        const trunkPointMaterial = new THREE.PointsMaterial({
          color: 0x30332f,
          size: 0.032,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.84,
        });

        const canopyLineMaterial = new THREE.LineBasicMaterial({
          color: 0x59695d,
          transparent: true,
          opacity: 0.58,
        });

        const majorLineMaterial = new THREE.LineBasicMaterial({
          color: 0x59695d,
          transparent: true,
          opacity: 0.76,
        });

        const rootLineMaterial = new THREE.LineBasicMaterial({
          color: 0x747970,
          transparent: true,
          opacity: 0.45,
        });

        const contextLineMaterial = new THREE.LineBasicMaterial({
          color: 0x747970,
          transparent: true,
          opacity: 0.72,
        });

        const faintLineMaterial = new THREE.LineBasicMaterial({
          color: 0xa1a69e,
          transparent: true,
          opacity: 0.34,
        });

        const canopy = new THREE.Group();
        const trunk = new THREE.Group();
        const rootField = new THREE.Group();
        const context = new THREE.Group();

        specimen.add(canopy, trunk, rootField, context);

        const makeLine = (points, material, closed = false) => {
          const geometry = new THREE.BufferGeometry().setFromPoints(points);
          return closed
            ? new THREE.LineLoop(geometry, material)
            : new THREE.Line(geometry, material);
        };

        const canopyWidth = (t) => {
          const bell = Math.pow(Math.max(0, Math.sin(Math.PI * t)), 0.68);
          const upperShoulder = 0.2 * Math.exp(-((t - 0.68) ** 2) / 0.028);
          const lowerShoulder = 0.13 * Math.exp(-((t - 0.28) ** 2) / 0.035);
          return 0.42 + 1.68 * bell + upperShoulder + lowerShoulder;
        };

        const canopyDepth = (t) => {
          const bell = Math.pow(Math.max(0, Math.sin(Math.PI * t)), 0.82);
          return 0.34 + 1.12 * bell;
        };

        const canopyCenterX = (t) =>
          -0.12 +
          0.14 * Math.sin(t * 5.1) +
          0.055 * Math.sin(t * 10.7 + 0.6);

        const canopyCenterZ = (t) =>
          0.04 * Math.sin(t * 6.3 - 0.2);

        const canopyY = (t) => 0.92 + t * 2.18;

        const edgeWobble = (angle, t) =>
          1 +
          0.055 * Math.sin(angle * 3.0 + t * 5.2) +
          0.035 * Math.cos(angle * 5.0 - t * 7.4);

        const canopyPositions = [];
        const canopyLevels = 28;
        const canopyAngles = 72;
        const shellFractions = [0.2, 0.42, 0.66, 0.84, 1];

        for (let yi = 0; yi <= canopyLevels; yi += 1) {
          const t = yi / canopyLevels;
          const y = canopyY(t);

          for (const shell of shellFractions) {
            for (let ai = 0; ai < canopyAngles; ai += 1) {
              const angle = (ai / canopyAngles) * Math.PI * 2;
              const wobble = edgeWobble(angle, t);
              const x =
                canopyCenterX(t) +
                Math.cos(angle) * canopyWidth(t) * shell * wobble;
              const z =
                canopyCenterZ(t) +
                Math.sin(angle) * canopyDepth(t) * shell * wobble;

              canopyPositions.push(x, y, z);
            }
          }
        }

        const canopyGeometry = new THREE.BufferGeometry();
        canopyGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(canopyPositions, 3)
        );

        canopy.add(new THREE.Points(canopyGeometry, pointMaterial));

        [0.13, 0.28, 0.44, 0.6, 0.76, 0.9].forEach((t, index) => {
          const points = [];

          for (let ai = 0; ai <= 96; ai += 1) {
            const angle = (ai / 96) * Math.PI * 2;
            const wobble = edgeWobble(angle, t);

            points.push(
              new THREE.Vector3(
                canopyCenterX(t) + Math.cos(angle) * canopyWidth(t) * wobble,
                canopyY(t),
                canopyCenterZ(t) + Math.sin(angle) * canopyDepth(t) * wobble
              )
            );
          }

          canopy.add(
            makeLine(
              points,
              index === 2 || index === 4
                ? majorLineMaterial
                : canopyLineMaterial,
              true
            )
          );
        });

        const trunkPositions = [];
        const trunkRows = 72;
        const trunkSides = 12;

        for (let yi = 0; yi <= trunkRows; yi += 1) {
          const t = yi / trunkRows;
          const y = -0.62 + t * 2.72;
          const centerX = 0.025 * Math.sin(t * 3.4);
          const centerZ = 0.035 * Math.sin(t * 4.1 + 0.5);
          const radius =
            0.135 -
            0.055 * t +
            0.035 * Math.exp(-((t - 0.58) ** 2) / 0.08);

          for (let ai = 0; ai < trunkSides; ai += 1) {
            const angle = (ai / trunkSides) * Math.PI * 2;

            trunkPositions.push(
              centerX + Math.cos(angle) * radius,
              y,
              centerZ + Math.sin(angle) * radius * 0.82
            );
          }
        }

        const trunkGeometry = new THREE.BufferGeometry();
        trunkGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(trunkPositions, 3)
        );

        trunk.add(new THREE.Points(trunkGeometry, trunkPointMaterial));

        trunk.add(
          makeLine(
            [
              new THREE.Vector3(0, -0.66, 0),
              new THREE.Vector3(0.02, 2.12, 0),
            ],
            majorLineMaterial
          )
        );

        const branchCurves = [
          [
            new THREE.Vector3(0, 1.14, 0),
            new THREE.Vector3(-0.38, 1.46, 0.04),
            new THREE.Vector3(-1.08, 1.83, 0.1),
          ],
          [
            new THREE.Vector3(0.02, 1.34, 0.02),
            new THREE.Vector3(0.42, 1.64, 0.02),
            new THREE.Vector3(1.18, 1.98, 0.08),
          ],
          [
            new THREE.Vector3(0, 1.52, 0),
            new THREE.Vector3(-0.06, 1.82, -0.08),
            new THREE.Vector3(-0.28, 2.2, -0.24),
          ],
        ];

        branchCurves.forEach((controlPoints) => {
          const curve = new THREE.CatmullRomCurve3(controlPoints);
          trunk.add(makeLine(curve.getPoints(30), canopyLineMaterial));
        });

        const rootLines = [];

        if (wantsRoots) {
          const rootRings = [
            { radius: 1.35, y: -0.12, major: true },
            { radius: 1.85, y: -0.2, major: false },
            { radius: 2.35, y: -0.28, major: true },
            { radius: 2.85, y: -0.36, major: false },
            { radius: 3.35, y: -0.44, major: true },
          ];

          rootRings.forEach((ring, index) => {
            const points = [];

            for (let ai = 0; ai <= 104; ai += 1) {
              const angle = (ai / 104) * Math.PI * 2;
              const wobble =
                1 +
                0.08 * Math.sin(angle * 2.2 + index * 0.8) +
                0.04 * Math.cos(angle * 5.1 - index * 0.7);

              points.push(
                new THREE.Vector3(
                  Math.cos(angle) * ring.radius * wobble * 1.1,
                  ring.y,
                  Math.sin(angle) * ring.radius * wobble * 0.72
                )
              );
            }

            const line = makeLine(
              points,
              ring.major ? majorLineMaterial : rootLineMaterial,
              true
            );

            rootField.add(line);
            rootLines.push(line);
          });

          [-1.18, -0.62, -0.08, 0.54, 1.1, 2.3].forEach((angle) => {
            const points = [new THREE.Vector3(0, -0.08, 0)];

            for (let i = 1; i <= 22; i += 1) {
              const f = i / 22;
              const reach = 3.2 * Math.pow(f, 1.08);

              points.push(
                new THREE.Vector3(
                  Math.cos(angle) * reach + 0.12 * Math.sin(f * 5.2 + angle),
                  -0.08 - 0.38 * Math.pow(f, 1.16),
                  Math.sin(angle) * reach * 0.66 + 0.08 * Math.cos(f * 4.4)
                )
              );
            }

            const line = makeLine(points, rootLineMaterial);
            rootField.add(line);
            rootLines.push(line);
          });
        }

        const groundLine = makeLine(
          [
            new THREE.Vector3(-4.5, -0.02, 0),
            new THREE.Vector3(4.5, -0.02, 0),
          ],
          faintLineMaterial
        );

        context.add(groundLine);

        const makeContextGeometry = (offsetZ = 0) => {
          const positions = [];

          for (let i = 0; i <= 72; i += 1) {
            positions.push(0, 0, 0);
          }

          const geometry = new THREE.BufferGeometry();
          geometry.setAttribute(
            'position',
            new THREE.Float32BufferAttribute(positions, 3)
          );
          geometry.userData.offsetZ = offsetZ;
          return geometry;
        };

        const contextGeometryA = makeContextGeometry(0);
        const contextGeometryB = makeContextGeometry(0.28);
        const contextLineA = new THREE.Line(contextGeometryA, contextLineMaterial);
        const contextLineB = new THREE.Line(contextGeometryB, faintLineMaterial);

        context.add(contextLineA, contextLineB);
        context.visible = wantsContext;

        const updateContextLine = (geometry, clearance) => {
          const attr = geometry.getAttribute('position');
          const offsetZ = geometry.userData.offsetZ || 0;
          const count = attr.count;

          for (let i = 0; i < count; i += 1) {
            const f = i / (count - 1);
            const x = THREE.MathUtils.lerp(-4.4, 4.4, f);
            const treeInfluence = Math.exp(-(x * x) / 1.65);
            const z =
              1.05 +
              offsetZ +
              clearance * treeInfluence +
              0.025 * Math.sin(x * 1.6);

            attr.setXYZ(i, x, -0.58, z);
          }

          attr.needsUpdate = true;
        };

        updateContextLine(contextGeometryA, 0.72);
        updateContextLine(contextGeometryB, 0.5);

        const resize = () => {
          const rect = root.getBoundingClientRect();
          const width = Math.max(1, Math.round(rect.width));
          const height = Math.max(1, Math.round(rect.height));

          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(root);
        resize();

        let isVisible = true;
        let isDocumentVisible = !document.hidden;
        let animationFrame = 0;

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting);
          },
          { rootMargin: '160px' }
        );

        intersectionObserver.observe(root);

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden;
        };

        document.addEventListener('visibilitychange', handleVisibility);

        const animate = (time) => {
          animationFrame = requestAnimationFrame(animate);
          if (!isVisible || !isDocumentVisible) return;

          controls.update();

          if (!reducedMotion) {
            const phase = time * 0.00075;
            const growth = 0.5 + 0.5 * Math.sin(phase);

            canopy.scale.x = 0.94 + growth * 0.11;
            canopy.scale.z = 0.95 + growth * 0.08;
            canopy.position.y = 0.018 * Math.sin(phase * 0.8);

            rootField.scale.x = 0.92 + growth * 0.18;
            rootField.scale.z = 0.92 + growth * 0.15;

            specimen.rotation.z = -0.018 + 0.018 * Math.sin(phase * 0.55);

            const clearance = THREE.MathUtils.lerp(0.35, 0.9, growth);
            updateContextLine(contextGeometryA, clearance);
            updateContextLine(contextGeometryB, clearance * 0.68);
          }

          renderer.render(scene, camera);
        };

        animationFrame = requestAnimationFrame(animate);

        const cleanup = () => {
          cancelAnimationFrame(animationFrame);
          document.removeEventListener('visibilitychange', handleVisibility);
          resizeObserver.disconnect();
          intersectionObserver.disconnect();
          controls.dispose();

          specimen.traverse((child) => {
            if (child.geometry) child.geometry.dispose();
          });

          pointMaterial.dispose();
          trunkPointMaterial.dispose();
          canopyLineMaterial.dispose();
          majorLineMaterial.dispose();
          rootLineMaterial.dispose();
          contextLineMaterial.dispose();
          faintLineMaterial.dispose();
          renderer.dispose();
        };

        window.addEventListener('pagehide', cleanup, { once: true });
      } catch (error) {
        console.error('PointTree failed to initialize:', error);
      }
    });
  })();
</script>
