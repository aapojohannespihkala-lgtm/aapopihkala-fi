<style is:global>
  html body .homepage-sheet-stamp,
  html body .homepage-language-meta-box,
  html body .hero-location-coordinate {
    color: var(--moss-deep) !important;
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace !important;
    font-size: 0.47rem !important;
    font-weight: 500 !important;
    line-height: 1 !important;
    letter-spacing: 0.05em !important;
  }

  html body .language-switch__meta {
    display: none !important;
  }

  @media (hover: hover) and (pointer: fine) {
    html body .homepage-sheet-stamp,
    html body .homepage-language-meta-box {
      position: fixed !important;
      z-index: 61 !important;
      display: flex !important;
      align-items: center !important;
      gap: 6px !important;
      box-sizing: border-box !important;
      padding: 5px 7px !important;
      pointer-events: none !important;
      background: rgba(255, 255, 255, 0.92) !important;
      border: 1px solid var(--line-soft) !important;
      color: var(--moss-deep) !important;
      text-transform: uppercase !important;
      white-space: nowrap !important;
      opacity: 0 !important;
      transition: none !important;
    }

    html body .homepage-sheet-stamp {
      left: var(--homepage-meta-left, 0px) !important;
      top: var(--homepage-meta-top, 72px) !important;
      transform: translateY(-2px) !important;
    }

    html body .homepage-language-meta-box {
      left: var(--homepage-language-meta-left, 0px) !important;
      top: var(--homepage-language-meta-top, 72px) !important;
      transform: translateY(-2px) !important;
    }

    html body.meta-home-hover .homepage-sheet-stamp,
    html body.meta-language-hover .homepage-language-meta-box {
      opacity: 0.82 !important;
      transform: translateY(0) !important;
      transition:
        opacity 100ms ease,
        transform 100ms ease !important;
    }

    html body .hero-location-coordinate {
      max-width: 0 !important;
      opacity: 0 !important;
      transform: translateX(-4px) !important;
      transition: none !important;
    }

    html body .hero-location-trigger:hover .hero-location-coordinate,
    html body .hero-location-trigger:focus-visible .hero-location-coordinate {
      max-width: 190px !important;
      opacity: 0.82 !important;
      transform: translateX(0) !important;
      transition:
        max-width 120ms ease 250ms,
        opacity 100ms ease 250ms,
        transform 120ms ease 250ms !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html body.meta-home-hover .homepage-sheet-stamp,
    html body.meta-language-hover .homepage-language-meta-box,
    html body .hero-location-trigger:hover .hero-location-coordinate,
    html body .hero-location-trigger:focus-visible .hero-location-coordinate {
      transition-duration: 0ms !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const homeLink = document.querySelector('.topbar-name')
    const languageLink = document.querySelector('.language-switch')
    const topbar = document.querySelector('.topbar')
    const sheetStamp = document.querySelector('[data-homepage-sheet-stamp]')
    const sourceLanguageMeta = document.querySelector('.language-switch__meta')

    if (!homeLink || !languageLink || !sheetStamp || !sourceLanguageMeta) return
    if (sheetStamp.dataset.hoverMetaInitialized === 'true') return
    sheetStamp.dataset.hoverMetaInitialized = 'true'

    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)')
    if (!finePointer.matches) return

    const languageMetaBox = document.createElement('span')
    languageMetaBox.className = 'homepage-language-meta-box'
    languageMetaBox.dataset.languageHoverBox = 'true'
    languageMetaBox.setAttribute('aria-hidden', 'true')
    languageMetaBox.textContent = sourceLanguageMeta.textContent?.trim() ?? ''
    document.body.append(languageMetaBox)

    let homeHoverTimer = 0
    let languageHoverTimer = 0

    const getMetaTop = () => {
      const bannerBottom = topbar?.getBoundingClientRect().bottom
      if (typeof bannerBottom === 'number') return bannerBottom + 8

      return Math.max(
        homeLink.getBoundingClientRect().bottom,
        languageLink.getBoundingClientRect().bottom
      ) + 8
    }

    const positionHomeMeta = () => {
      const rect = homeLink.getBoundingClientRect()
      sheetStamp.style.setProperty('--homepage-meta-left', `${Math.round(rect.left)}px`)
      sheetStamp.style.setProperty('--homepage-meta-top', `${Math.round(getMetaTop())}px`)
    }

    const positionLanguageMeta = () => {
      const rect = languageLink.getBoundingClientRect()
      languageMetaBox.style.setProperty(
        '--homepage-language-meta-left',
        `${Math.round(rect.left)}px`
      )
      languageMetaBox.style.setProperty(
        '--homepage-language-meta-top',
        `${Math.round(getMetaTop())}px`
      )
    }

    const showHomeMeta = () => {
      window.clearTimeout(homeHoverTimer)
      positionHomeMeta()
      homeHoverTimer = window.setTimeout(() => {
        positionHomeMeta()
        document.body.classList.add('meta-home-hover')
      }, 250)
    }

    const hideHomeMeta = () => {
      window.clearTimeout(homeHoverTimer)
      document.body.classList.remove('meta-home-hover')
    }

    const showLanguageMeta = () => {
      window.clearTimeout(languageHoverTimer)
      positionLanguageMeta()
      languageHoverTimer = window.setTimeout(() => {
        positionLanguageMeta()
        document.body.classList.add('meta-language-hover')
      }, 250)
    }

    const hideLanguageMeta = () => {
      window.clearTimeout(languageHoverTimer)
      document.body.classList.remove('meta-language-hover')
    }

    const handleResize = () => {
      positionHomeMeta()
      positionLanguageMeta()
    }

    positionHomeMeta()
    positionLanguageMeta()

    homeLink.addEventListener('pointerenter', showHomeMeta)
    homeLink.addEventListener('pointerleave', hideHomeMeta)
    homeLink.addEventListener('focus', showHomeMeta)
    homeLink.addEventListener('blur', hideHomeMeta)

    languageLink.addEventListener('pointerenter', showLanguageMeta)
    languageLink.addEventListener('pointerleave', hideLanguageMeta)
    languageLink.addEventListener('focus', showLanguageMeta)
    languageLink.addEventListener('blur', hideLanguageMeta)

    window.addEventListener('resize', handleResize, { passive: true })

    window.addEventListener(
      'pagehide',
      () => {
        hideHomeMeta()
        hideLanguageMeta()
        languageMetaBox.remove()
        homeLink.removeEventListener('pointerenter', showHomeMeta)
        homeLink.removeEventListener('pointerleave', hideHomeMeta)
        homeLink.removeEventListener('focus', showHomeMeta)
        homeLink.removeEventListener('blur', hideHomeMeta)
        languageLink.removeEventListener('pointerenter', showLanguageMeta)
        languageLink.removeEventListener('pointerleave', hideLanguageMeta)
        languageLink.removeEventListener('focus', showLanguageMeta)
        languageLink.removeEventListener('blur', hideLanguageMeta)
        window.removeEventListener('resize', handleResize)
      },
      { once: true }
    )
  })()
</script>
