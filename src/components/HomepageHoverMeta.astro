<style is:global>
  html body .homepage-sheet-stamp,
  html body .homepage-language-meta-box,
  html body .homepage-linkedin-meta-box,
  html body .hero-location-coordinate {
    color: var(--moss-deep) !important;
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace !important;
    font-size: 0.47rem !important;
    font-weight: 500 !important;
    line-height: 1 !important;
    letter-spacing: 0.05em !important;
  }

  html body .language-switch__meta {
    display: none !important;
  }

  html body .hero-linkedin-terminal {
    transition:
      max-width 310ms cubic-bezier(0.22, 1, 0.36, 1) !important,
      opacity 70ms linear !important,
      transform 310ms cubic-bezier(0.22, 1, 0.36, 1) !important;
  }

  html body .hero-linkedin-terminal.is-active {
    max-width: 310px !important;
  }

  @media (hover: hover) and (pointer: fine) {
    html body .homepage-sheet-stamp,
    html body .homepage-language-meta-box,
    html body .homepage-linkedin-meta-box {
      position: fixed !important;
      z-index: 61 !important;
      display: flex !important;
      align-items: center !important;
      gap: 6px !important;
      box-sizing: border-box !important;
      padding: 5px 7px !important;
      pointer-events: none !important;
      background: rgba(255, 255, 255, 0.92) !important;
      border: 1px solid var(--line-soft) !important;
      color: var(--moss-deep) !important;
      text-transform: uppercase !important;
      white-space: nowrap !important;
      opacity: 0 !important;
      transition: none !important;
    }

    html body .homepage-sheet-stamp {
      left: var(--homepage-meta-left, 0px) !important;
      top: var(--homepage-meta-top, 72px) !important;
      transform: translateY(-2px) !important;
    }

    html body .homepage-language-meta-box {
      left: var(--homepage-language-meta-left, 0px) !important;
      top: var(--homepage-language-meta-top, 72px) !important;
      transform: translateY(-2px) !important;
    }

    html body .homepage-linkedin-meta-box {
      left: var(--homepage-linkedin-meta-left, 0px) !important;
      top: var(--homepage-linkedin-meta-top, 72px) !important;
      transform: translateY(-2px) !important;
    }

    html body.meta-home-hover .homepage-sheet-stamp,
    html body.meta-language-hover .homepage-language-meta-box,
    html body.meta-linkedin-hover .homepage-linkedin-meta-box {
      opacity: 0.82 !important;
      transform: translateY(0) !important;
      transition:
        opacity 100ms ease,
        transform 100ms ease !important;
    }

    html body .hero-location-coordinate {
      position: relative !important;
      top: 1.5px !important;
      align-self: center !important;
      max-width: 0 !important;
      opacity: 0 !important;
      transform: translateX(0) !important;
      transition: none !important;
    }

    html body .hero-location-trigger:hover .hero-location-coordinate,
    html body .hero-location-trigger:focus-visible .hero-location-coordinate {
      max-width: 190px !important;
      opacity: 0.82 !important;
      transform: translateX(9px) !important;
      transition:
        max-width 120ms ease 250ms,
        opacity 100ms ease 250ms,
        transform 120ms ease 250ms !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html body.meta-home-hover .homepage-sheet-stamp,
    html body.meta-language-hover .homepage-language-meta-box,
    html body.meta-linkedin-hover .homepage-linkedin-meta-box,
    html body .hero-location-trigger:hover .hero-location-coordinate,
    html body .hero-location-trigger:focus-visible .hero-location-coordinate,
    html body .hero-linkedin-terminal {
      transition-duration: 0ms !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const homeLink = document.querySelector('.topbar-name')
    const languageLink = document.querySelector('.language-switch')
    const linkedinLink = document.querySelector('.linkedin-link')
    const topbar = document.querySelector('.topbar')
    const sheetStamp = document.querySelector('[data-homepage-sheet-stamp]')
    const sourceLanguageMeta = document.querySelector('.language-switch__meta')

    if (
      !homeLink ||
      !languageLink ||
      !linkedinLink ||
      !sheetStamp ||
      !sourceLanguageMeta
    ) return

    if (sheetStamp.dataset.hoverMetaInitialized === 'true') return
    sheetStamp.dataset.hoverMetaInitialized = 'true'

    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)')
    if (!finePointer.matches) return

    const languageMetaBox = document.createElement('span')
    languageMetaBox.className = 'homepage-language-meta-box'
    languageMetaBox.dataset.languageHoverBox = 'true'
    languageMetaBox.setAttribute('aria-hidden', 'true')
    languageMetaBox.textContent = sourceLanguageMeta.textContent?.trim() ?? ''
    document.body.append(languageMetaBox)

    const linkedinMetaBox = document.createElement('span')
    linkedinMetaBox.className = 'homepage-linkedin-meta-box'
    linkedinMetaBox.dataset.linkedinHoverBox = 'true'
    linkedinMetaBox.setAttribute('aria-hidden', 'true')
    linkedinMetaBox.textContent = 'NETWORK / HUMAN LAYER'
    document.body.append(linkedinMetaBox)

    const linkedinTitle = linkedinLink.getAttribute('title')
    linkedinLink.removeAttribute('title')

    let homeHoverTimer = 0
    let languageHoverTimer = 0
    let linkedinHoverTimer = 0

    const getMetaTop = () => {
      const bannerBottom = topbar?.getBoundingClientRect().bottom
      if (typeof bannerBottom === 'number') return bannerBottom + 8

      return Math.max(
        homeLink.getBoundingClientRect().bottom,
        languageLink.getBoundingClientRect().bottom,
        linkedinLink.getBoundingClientRect().bottom
      ) + 8
    }

    const positionHomeMeta = () => {
      const rect = homeLink.getBoundingClientRect()
      sheetStamp.style.setProperty('--homepage-meta-left', `${Math.round(rect.left)}px`)
      sheetStamp.style.setProperty('--homepage-meta-top', `${Math.round(getMetaTop())}px`)
    }

    const positionLanguageMeta = () => {
      const rect = languageLink.getBoundingClientRect()
      languageMetaBox.style.setProperty(
        '--homepage-language-meta-left',
        `${Math.round(rect.left)}px`
      )
      languageMetaBox.style.setProperty(
        '--homepage-language-meta-top',
        `${Math.round(getMetaTop())}px`
      )
    }

    const positionLinkedinMeta = () => {
      const rect = linkedinLink.getBoundingClientRect()
      linkedinMetaBox.style.setProperty(
        '--homepage-linkedin-meta-left',
        `${Math.round(rect.left)}px`
      )
      linkedinMetaBox.style.setProperty(
        '--homepage-linkedin-meta-top',
        `${Math.round(getMetaTop())}px`
      )
    }

    const showHomeMeta = () => {
      window.clearTimeout(homeHoverTimer)
      positionHomeMeta()
      homeHoverTimer = window.setTimeout(() => {
        positionHomeMeta()
        document.body.classList.add('meta-home-hover')
      }, 250)
    }

    const hideHomeMeta = () => {
      window.clearTimeout(homeHoverTimer)
      document.body.classList.remove('meta-home-hover')
    }

    const showLanguageMeta = () => {
      window.clearTimeout(languageHoverTimer)
      positionLanguageMeta()
      languageHoverTimer = window.setTimeout(() => {
        positionLanguageMeta()
        document.body.classList.add('meta-language-hover')
      }, 250)
    }

    const hideLanguageMeta = () => {
      window.clearTimeout(languageHoverTimer)
      document.body.classList.remove('meta-language-hover')
    }

    const showLinkedinMeta = () => {
      window.clearTimeout(linkedinHoverTimer)
      positionLinkedinMeta()
      linkedinHoverTimer = window.setTimeout(() => {
        positionLinkedinMeta()
        document.body.classList.add('meta-linkedin-hover')
      }, 250)
    }

    const hideLinkedinMeta = () => {
      window.clearTimeout(linkedinHoverTimer)
      document.body.classList.remove('meta-linkedin-hover')
    }

    const handleResize = () => {
      positionHomeMeta()
      positionLanguageMeta()
      positionLinkedinMeta()
    }

    positionHomeMeta()
    positionLanguageMeta()
    positionLinkedinMeta()

    homeLink.addEventListener('pointerenter', showHomeMeta)
    homeLink.addEventListener('pointerleave', hideHomeMeta)
    homeLink.addEventListener('focus', showHomeMeta)
    homeLink.addEventListener('blur', hideHomeMeta)

    languageLink.addEventListener('pointerenter', showLanguageMeta)
    languageLink.addEventListener('pointerleave', hideLanguageMeta)
    languageLink.addEventListener('focus', showLanguageMeta)
    languageLink.addEventListener('blur', hideLanguageMeta)

    linkedinLink.addEventListener('pointerenter', showLinkedinMeta)
    linkedinLink.addEventListener('pointerleave', hideLinkedinMeta)
    linkedinLink.addEventListener('focus', showLinkedinMeta)
    linkedinLink.addEventListener('blur', hideLinkedinMeta)

    window.addEventListener('resize', handleResize, { passive: true })

    window.addEventListener(
      'pagehide',
      () => {
        hideHomeMeta()
        hideLanguageMeta()
        hideLinkedinMeta()
        languageMetaBox.remove()
        linkedinMetaBox.remove()

        if (linkedinTitle !== null) {
          linkedinLink.setAttribute('title', linkedinTitle)
        }

        homeLink.removeEventListener('pointerenter', showHomeMeta)
        homeLink.removeEventListener('pointerleave', hideHomeMeta)
        homeLink.removeEventListener('focus', showHomeMeta)
        homeLink.removeEventListener('blur', hideHomeMeta)
        languageLink.removeEventListener('pointerenter', showLanguageMeta)
        languageLink.removeEventListener('pointerleave', hideLanguageMeta)
        languageLink.removeEventListener('focus', showLanguageMeta)
        languageLink.removeEventListener('blur', hideLanguageMeta)
        linkedinLink.removeEventListener('pointerenter', showLinkedinMeta)
        linkedinLink.removeEventListener('pointerleave', hideLinkedinMeta)
        linkedinLink.removeEventListener('focus', showLinkedinMeta)
        linkedinLink.removeEventListener('blur', hideLinkedinMeta)
        window.removeEventListener('resize', handleResize)
      },
      { once: true }
    )
  })()

  ;(() => {
    const link = document.querySelector('[data-linkedin-terminal-link]')
    const terminal = document.querySelector('[data-linkedin-terminal]')
    const text = document.querySelector('[data-linkedin-terminal-text]')
    const cursor = document.querySelector('[data-linkedin-terminal-cursor]')

    if (!link || !terminal || !text || !cursor) return
    if (link.dataset.linkedinTerminalRandomized === 'true') return
    link.dataset.linkedinTerminalRandomized = 'true'

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const storageKey = 'aapo-linkedin-terminal-recent-v1'
    const messages = [
      "HELLO?",
      "YES, YOU.",
      "CAN YOU HEAR THIS?",
      "OPEN CHANNEL?",
      "STILL THERE?",
      "YOU FOUND THE HUMAN.",
      "HUMAN NODE ONLINE.",
      "SAY SOMETHING.",
      "DON'T JUST HOVER.",
      "I SEE THE CURSOR.",
      "CHANNEL AVAILABLE.",
      "YOU MAY SPEAK NOW.",
      "CONNECTION POSSIBLE.",
      "NO BOT HERE.",
      "THIS LINE IS FOR YOU.",
      "GO AHEAD.",
      "TRY HELLO.",
      "SIGNAL RECEIVED.",
      "CONTACT WINDOW OPEN.",
      "ARE YOU STILL READING?",
      "YES, THIS CHANGES.",
      "YOU CAME BACK.",
      "WE NOTICED.",
      "CURSOR DETECTED.",
      "PEER FOUND.",
      "HUMAN ON THE OTHER END.",
      "READY WHEN YOU ARE.",
      "SEND A SIGNAL.",
      "OPEN A CONVERSATION.",
      "THERE IS SOMEONE HERE.",
      "THIS IS NOT AN ERROR.",
      "NOTHING TO DEBUG.",
      "YOU CAN CLICK THIS.",
      "WE CAN TALK.",
      "MAKE CONTACT.",
      "LINK ESTABLISHED.",
      "AWAITING INPUT.",
      "YOUR MOVE.",
      "INPUT WELCOME.",
      "NO PASSWORD REQUIRED.",
      "ACCESS: HUMAN.",
      "COMMUNICATION ENABLED.",
      "ENDPOINT RESPONDING.",
      "PING?",
      "PONG.",
      "YOU LOOK CURIOUS.",
      "CURIOSITY ACCEPTED.",
      "STAY A SECOND.",
      "ONE MORE SECOND.",
      "THERE YOU ARE.",
      "HELLO FROM THE PAGE.",
      "THE PAGE SAYS HI.",
      "THIS BIT IS ALIVE.",
      "NOT EVERYTHING IS STATIC.",
      "YOU TRIGGERED THIS.",
      "THANKS FOR HOVERING.",
      "YOU FOUND A SIDE CHANNEL.",
      "SIDE CHANNEL OPEN.",
      "PRIVATE LINE? NOT REALLY.",
      "PUBLIC HUMAN INTERFACE.",
      "CONVERSATION MODE READY.",
      "SAY THE FIRST THING.",
      "START WITH HELLO.",
      "WORDS WORK HERE.",
      "TRANSMIT THOUGHT.",
      "REQUEST A RESPONSE.",
      "CONTACT PROTOCOL READY.",
      "NO FORM. JUST TALK.",
      "SKIP THE FORMALITIES.",
      "THE HUMAN IS REACHABLE.",
      "REMOTE HUMAN AVAILABLE.",
      "NETWORK PATH FOUND.",
      "ROUTE TO HUMAN FOUND.",
      "CONNECTION LOOKS GOOD.",
      "LATENCY: HUMAN.",
      "SIGNAL QUALITY: GOOD.",
      "NODE STATUS: AWAKE.",
      "NODE STATUS: LISTENING.",
      "LISTENER AVAILABLE.",
      "YOU HAVE THE FLOOR.",
      "MICROPHONE OPTIONAL.",
      "TEXT IS FINE.",
      "THIS COULD BE A MESSAGE.",
      "MAKE IT A MESSAGE.",
      "CLICK TO CONTINUE.",
      "CONTINUE OFF-SITE.",
      "EXIT TO LINKEDIN?",
      "OPEN HUMAN PROFILE?",
      "PROCEED TO CONTACT?",
      "READY TO CONNECT?",
      "CONNECTION REQUEST?",
      "WOULD YOU LIKE TO TALK?",
      "THE DOOR IS OPEN.",
      "NO SECRET HANDSHAKE.",
      "HANDSHAKE ACCEPTED.",
      "SESSION AVAILABLE.",
      "NEW SESSION?",
      "INITIATE CONTACT.",
      "ESTABLISH HUMAN LINK.",
      "SAY HELLO →",
      "THE PAGE IS WATCHING BACK.",
      "YOU PAUSED. I NOTICED.",
      "THAT HOVER WAS DELIBERATE.",
      "YOU ALMOST LEFT.",
      "STILL PRETENDING THIS IS STATIC?",
      "THE CURSOR GAVE YOU AWAY.",
      "YOU'RE BACK ON THIS LINE.",
      "THIS WAS WAITING FOR YOU.",
      "THE PAGE REMEMBERS NOTHING. PROBABLY.",
      "YOU LOOKED HERE TWICE.",
      "SOMEONE MOVED THE CURSOR.",
      "THAT WAS YOU, RIGHT?",
      "THE INTERFACE BLINKED FIRST.",
      "YOU FOUND THE QUIET PART.",
      "THIS CORNER HAS A VOICE.",
      "THE LINK WAS EXPECTING YOU.",
      "YOU ARE NOW PART OF THE UI.",
      "THE PAGE HAS QUESTIONS.",
      "IT KNOWS YOU'RE STILL HERE.",
      "YOU CAN STOP HOVERING NOW.",
      "OR DON'T.",
      "WE HAVE EYE CONTACT.",
      "THIS IS GETTING PERSONAL.",
      "YOU READ THE SMALL PRINT.",
      "THE SMALL PRINT READ YOU.",
      "NO ONE TOLD IT TO SAY THAT.",
      "THAT LINE WASN'T THERE BEFORE.",
      "DID YOU EXPECT A TOOLTIP?",
      "TOOLTIP REFUSED.",
      "THE PAGE IS IMPROVISING.",
      "FIELD NOTE: HUMAN DETECTED.",
      "SITE VISIT IN PROGRESS.",
      "EDGE EFFECT DETECTED.",
      "ECOTONE: HUMAN / MACHINE.",
      "DESIRE LINE FOUND.",
      "CONTOUR LEADS HERE.",
      "YOU CROSSED THE BOUNDARY.",
      "CENTROID SAYS HELLO.",
      "NO LEGEND REQUIRED.",
      "MAP ≠ TERRITORY.",
      "THE SITE IS TALKING BACK.",
      "GROUND TRUTH: SOMEONE IS HERE.",
      "COORDINATES WITHHELD.",
      "UNMAPPED CONNECTION.",
      "PATH DEPENDENCY DETECTED.",
      "THIS ROUTE WAS NOT PLANNED.",
      "FOLLOW THE DESIRE LINE.",
      "THE EDGE IS ACTIVE.",
      "TOPOLOGY BEFORE BIOGRAPHY.",
      "FORM FOLLOWS CONTACT.",
      "LESS INTERFACE. MORE HUMAN.",
      "THE MEDIUM IS THE HOVER.",
      "THIS IS NOT A PROFILE.",
      "AURA DETECTED.",
      "AUTHOR STILL AVAILABLE.",
      "RHIZOME NODE FOUND.",
      "ACTOR-NETWORK ACTIVE.",
      "THE SPECTACLE IS BUFFERING.",
      "DÉRIVE COMPLETE. HUMAN FOUND.",
      "A PATTERN LANGUAGE FOR HELLO.",
      "EYES ON THE CURSOR.",
      "PROFILE ≠ PERSON.",
      "SIMULACRUM DETECTED.",
      "FOLLOW THE WHITE CURSOR.",
      "RED PILL NOT REQUIRED.",
      "THERE IS NO SPOON HERE.",
      "WAKE UP. IT'S JUST LINKEDIN.",
      "HELLO, FRIEND.",
      "MORE HUMAN THAN PROFILE.",
      "OPEN THE PROFILE DOOR?",
      "END OF LINE?",
      "GHOST IN THE PROFILE?",
      "THE CONTACT IS OUT THERE.",
      "DON'T PANIC. JUST SAY HELLO.",
      "THIS ISN'T AN EPISODE. YET.",
      "WORK SELF DETECTED.",
      "EVERYTHING IN ITS RIGHT TAB.",
      "THIS MUST BE THE PROFILE.",
      "IS THERE LIFE ON LINKEDIN?",
      "THE LINK IS NOT WHAT IT SEEMS.",
      "I'M SORRY. THIS LINK CAN OPEN.",
      "MORE HUMAN THAN USER.",
      "EVERYTHING IN ITS RIGHT PROFILE.",
      "WELCOME TO THE MACHINE. WRONG MACHINE.",
      "SHINE ON, CURIOUS POINTER.",
      "NO SURPRISES. SOMEONE IS HERE.",
      "HOW TO DISAPPEAR? NOT HERE.",
      "THE PAGE HAS A HIDDEN TRACK.",
      "SPIRAL OUT. CLICK THROUGH.",
      "THE GRID IS PART OF THE STORY.",
      "MEANWHILE, IN ANOTHER PANEL...",
      "THIS PANEL KNOWS IT IS A PANEL.",
      "YOUR CURSOR FOUND THE BLACK HOLE.",
      "WHO WATCHES THE HOVER?",
      "THE INCAL POINTS ELSEWHERE.",
      "LOOK BEHIND YOU. A THREE-HEADED LINK.",
      "THE RIFF IS SLOW. THE LINK IS FAST.",
      "POST-ROCK BUILDUP: CLICK PENDING.",
      "THE WALL HAS A HYPERLINK.",
      "FORM AND CONTENT ARE TALKING."
    ]

    let recent = []
    let active = false
    const timers = []

    try {
      const stored = JSON.parse(window.sessionStorage.getItem(storageKey) ?? '[]')
      if (Array.isArray(stored)) {
        recent = stored
          .filter((value) => Number.isInteger(value) && value >= 0 && value < messages.length)
          .slice(-20)
      }
    } catch {}

    const clearTimers = () => {
      while (timers.length) {
        window.clearTimeout(timers.pop())
      }
    }

    const after = (delay, callback) => {
      const timer = window.setTimeout(callback, delay)
      timers.push(timer)
    }

    const remember = (index) => {
      recent.push(index)
      if (recent.length > 20) recent.splice(0, recent.length - 20)

      try {
        window.sessionStorage.setItem(storageKey, JSON.stringify(recent))
      } catch {}
    }

    const pickMessage = () => {
      const blocked = new Set(recent)
      const available = messages
        .map((_, index) => index)
        .filter((index) => !blocked.has(index))
      const index = available[Math.floor(Math.random() * available.length)]
      remember(index)
      return messages[index]
    }

    const setText = (value) => {
      text.textContent = value
    }

    const typeMessage = (message, index = 0) => {
      if (!active) return

      setText(message.slice(0, index))

      if (index >= message.length) {
        if (Math.random() < 0.3) {
          after(85, () => {
            if (!active) return
            text.classList.add('is-glitching')
            after(21, () => active && text.classList.remove('is-glitching'))
          })
        }
        return
      }

      const character = message[index]
      const punctuation = /[?.!:→]/.test(character)
      const delay = punctuation
        ? 55 + Math.random() * 45
        : 27 + Math.random() * 18

      after(delay, () => typeMessage(message, index + 1))
    }

    const stop = () => {
      active = false
      clearTimers()
      terminal.classList.remove('is-active')
      text.classList.remove('is-glitching')
      cursor.classList.remove('is-visible')
      setText('')
    }

    const start = () => {
      if (active) return
      active = true
      clearTimers()
      const message = pickMessage()

      if (reducedMotion) {
        terminal.classList.add('is-active')
        cursor.classList.add('is-visible')
        setText(message)
        return
      }

      after(140, () => {
        if (!active) return
        terminal.classList.add('is-active')
        cursor.classList.add('is-visible')
      })

      after(205, () => {
        if (!active) return
        typeMessage(message, 1)
      })
    }

    const interceptStart = (event) => {
      event.stopImmediatePropagation()
      start()
    }

    const interceptStop = (event) => {
      event.stopImmediatePropagation()
      stop()
    }

    stop()

    link.addEventListener('pointerenter', interceptStart, true)
    link.addEventListener('pointerleave', interceptStop, true)
    link.addEventListener('focus', interceptStart, true)
    link.addEventListener('blur', interceptStop, true)

    window.addEventListener(
      'pagehide',
      () => {
        stop()
        link.removeEventListener('pointerenter', interceptStart, true)
        link.removeEventListener('pointerleave', interceptStop, true)
        link.removeEventListener('focus', interceptStart, true)
        link.removeEventListener('blur', interceptStop, true)
      },
      { once: true }
    )
  })()
</script>
