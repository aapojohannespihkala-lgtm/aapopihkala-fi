---
interface Props {
  class?: string
  autoRotate?: boolean
  animate?: boolean
  enableZoom?: boolean
  scale?: number
  cameraDistance?: number
}

const {
  class: className,
  autoRotate = true,
  animate = true,
  enableZoom = true,
  scale = 1,
  cameraDistance = 6.8,
} = Astro.props
---

<div
  class:list={['segmented-ring', className]}
  data-segmented-ring
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-animate={animate ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-scale={scale}
  data-camera-distance={cameraDistance}
  aria-hidden="true"
>
  <canvas
    class="segmented-ring__canvas"
    data-segmented-ring-canvas
  ></canvas>
</div>

<style>
  .segmented-ring {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 280px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .segmented-ring:active {
    cursor: grabbing;
  }

  .segmented-ring__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-segmented-ring]')

    roots.forEach(async (root) => {
      if (root.dataset.segmentedRingInitialized === 'true') return
      root.dataset.segmentedRingInitialized = 'true'

      const canvas = root.querySelector('[data-segmented-ring-canvas]')
      if (!canvas) return

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm')
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        )

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const wantsAutoRotate = root.dataset.autoRotate !== 'false'
        const wantsAnimation = root.dataset.animate !== 'false' && !reducedMotion
        const wantsZoom = root.dataset.enableZoom !== 'false'
        const requestedScale = Number(root.dataset.scale ?? '1')
        const requestedCameraDistance = Number(root.dataset.cameraDistance ?? '6.8')
        const displayScale = Number.isFinite(requestedScale) ? requestedScale : 1
        const cameraDistance = Number.isFinite(requestedCameraDistance)
          ? requestedCameraDistance
          : 6.8

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        })
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6))
        renderer.setClearColor(0xffffff, 0)

        const scene = new THREE.Scene()
        const camera = new THREE.PerspectiveCamera(36, 1, 0.1, 100)
        camera.position.set(0.2, 0.3, cameraDistance)

        const ringGroup = new THREE.Group()
        ringGroup.scale.setScalar(displayScale)
        ringGroup.rotation.x = -0.07
        ringGroup.rotation.y = 0.1
        scene.add(ringGroup)

        const controls = new OrbitControls(camera, renderer.domElement)
        controls.enablePan = false
        controls.enableZoom = wantsZoom
        controls.enableDamping = true
        controls.dampingFactor = 0.055
        controls.rotateSpeed = 0.55
        controls.target.set(0, 0, 0)
        controls.autoRotate = wantsAutoRotate && !reducedMotion
        controls.autoRotateSpeed = 0.2

        if (wantsZoom) {
          controls.minDistance = 4.9
          controls.maxDistance = 8.9
          controls.zoomSpeed = 0.5
        } else {
          const direction = camera.position.clone().sub(controls.target).normalize()
          camera.position.copy(controls.target).add(direction.multiplyScalar(cameraDistance))
          controls.minDistance = cameraDistance
          controls.maxDistance = cameraDistance
        }

        const majorRadius = 1.485
        const tubeRadius = 0.335
        const angleSteps = 150
        const tubeSteps = 22
        const capRadiusSteps = 8
        const capAngleSteps = 22

        const deg = (value) => value * Math.PI / 180

        const fieldPositions = []
        const capPositions = []

        const addTubeArc = (startAngle, endAngle) => {
          const arcLength = endAngle - startAngle

          for (let angleIndex = 0; angleIndex <= angleSteps; angleIndex += 1) {
            const angle = startAngle + arcLength * (angleIndex / angleSteps)
            const cosAngle = Math.cos(angle)
            const sinAngle = Math.sin(angle)

            for (let tubeIndex = 0; tubeIndex < tubeSteps; tubeIndex += 1) {
              const tubeAngle = Math.PI * 2 * (tubeIndex / tubeSteps)
              const radialDistance = majorRadius + tubeRadius * Math.cos(tubeAngle)

              fieldPositions.push(
                cosAngle * radialDistance,
                sinAngle * radialDistance,
                tubeRadius * Math.sin(tubeAngle)
              )
            }
          }

          ;[startAngle, endAngle].forEach((angle) => {
            const cosAngle = Math.cos(angle)
            const sinAngle = Math.sin(angle)

            for (let radiusIndex = 0; radiusIndex <= capRadiusSteps; radiusIndex += 1) {
              const radius = tubeRadius * (radiusIndex / capRadiusSteps)
              const samples = radiusIndex === 0 ? 1 : capAngleSteps

              for (let capIndex = 0; capIndex < samples; capIndex += 1) {
                const capAngle = samples === 1 ? 0 : Math.PI * 2 * (capIndex / samples)
                const radialOffset = radius * Math.cos(capAngle)
                const z = radius * Math.sin(capAngle)
                const ringRadius = majorRadius + radialOffset

                capPositions.push(
                  cosAngle * ringRadius,
                  sinAngle * ringRadius,
                  z
                )
              }
            }
          })
        }

        addTubeArc(deg(142), deg(308))
        addTubeArc(deg(322), deg(488))

        const fieldGeometry = new THREE.BufferGeometry()
        fieldGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(fieldPositions, 3)
        )

        const fieldMaterial = new THREE.PointsMaterial({
          color: 0x56635b,
          size: 0.024,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.62,
        })

        const capGeometry = new THREE.BufferGeometry()
        capGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(capPositions, 3)
        )

        const capMaterial = new THREE.PointsMaterial({
          color: 0x353832,
          size: 0.025,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.72,
        })

        ringGroup.add(
          new THREE.Points(fieldGeometry, fieldMaterial),
          new THREE.Points(capGeometry, capMaterial)
        )

        const resize = () => {
          const rect = root.getBoundingClientRect()
          const width = Math.max(1, Math.round(rect.width))
          const height = Math.max(1, Math.round(rect.height))

          renderer.setSize(width, height, false)
          camera.aspect = width / height
          camera.updateProjectionMatrix()
        }

        const resizeObserver = new ResizeObserver(resize)
        resizeObserver.observe(root)
        resize()

        let isVisible = true
        let isDocumentVisible = !document.hidden
        let animationFrame = 0
        let previousTime = performance.now()

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting)
          },
          { rootMargin: '160px' }
        )
        intersectionObserver.observe(root)

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden
        }
        document.addEventListener('visibilitychange', handleVisibility)

        const animateFrame = (time) => {
          animationFrame = requestAnimationFrame(animateFrame)
          if (!isVisible || !isDocumentVisible) {
            previousTime = time
            return
          }

          const delta = Math.min(0.05, Math.max(0, (time - previousTime) / 1000))
          previousTime = time
          const seconds = time * 0.001

          if (wantsAnimation) {
            ringGroup.rotation.z += delta * 0.16
            ringGroup.rotation.x = -0.07 + Math.sin(seconds * 0.34) * 0.09
            ringGroup.rotation.y = 0.1 + Math.sin(seconds * 0.27 + 0.8) * 0.08
          }

          controls.update()
          renderer.render(scene, camera)
        }

        animationFrame = requestAnimationFrame(animateFrame)

        const cleanup = () => {
          cancelAnimationFrame(animationFrame)
          document.removeEventListener('visibilitychange', handleVisibility)
          resizeObserver.disconnect()
          intersectionObserver.disconnect()
          controls.dispose()
          fieldGeometry.dispose()
          capGeometry.dispose()
          fieldMaterial.dispose()
          capMaterial.dispose()
          renderer.dispose()
        }

        window.addEventListener('pagehide', cleanup, { once: true })
      } catch (error) {
        console.error('SegmentedRing failed to initialize:', error)
      }
    })
  })()
</script>
