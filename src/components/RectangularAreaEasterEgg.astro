</style>

<script is:inline>
  (() => {
    const initialize = () => {
      const gridBackdrop = document.querySelector('[data-area-mode-grid]')
      const root = document.querySelector('[data-rect-area]')
      const svg = document.querySelector('[data-rect-area-svg]')
      const contrast = document.querySelector('[data-rect-area-contrast]')
      const fill = document.querySelector('[data-rect-area-fill]')
      const stroke = document.querySelector('[data-rect-area-stroke]')
      const hint = document.querySelector('[data-rect-area-hint]')
      const readout = document.querySelector('[data-a-readout]')
      const readoutLabel = document.querySelector('[data-a-readout-label]')

      if (!gridBackdrop || !root || !svg || !contrast || !fill || !stroke || !hint || !readout || !readoutLabel) return
      if (root.dataset.rectAreaInitialized === 'true') return
      root.dataset.rectAreaInitialized = 'true'

      let rectActive = false
      let drawing = false
      let finished = false
      let startPoint = null
      let endPoint = null
      let previousMode = readout.dataset.mode ?? ''

      const setCadTheme = (visible) => {
        document.documentElement.classList.toggle('site-rect-cad-theme', visible)
        document.body.classList.toggle('site-rect-cad-theme', visible)
      }

      const setViewBox = () => {
        svg.setAttribute('viewBox', `0 0 ${window.innerWidth} ${window.innerHeight}`)
      }

      const syncGrid = (mode = readout.dataset.mode ?? '') => {
        gridBackdrop.classList.toggle('is-visible', mode === 'area' || mode === 'rect')
      }

      const setGeometry = (start, end) => {
        if (!start || !end) return { x: 0, y: 0, width: 0, height: 0 }

        const x = Math.min(start.x, end.x)
        const y = Math.min(start.y, end.y)
        const width = Math.abs(end.x - start.x)
        const height = Math.abs(end.y - start.y)

        for (const element of [contrast, fill, stroke]) {
          element.setAttribute('x', String(x))
          element.setAttribute('y', String(y))
          element.setAttribute('width', String(width))
          element.setAttribute('height', String(height))
        }

        return { x, y, width, height }
      }

      const clearGeometry = () => {
        for (const element of [contrast, fill, stroke]) {
          element.setAttribute('x', '0')
          element.setAttribute('y', '0')
          element.setAttribute('width', '0')
          element.setAttribute('height', '0')
        }
      }

      const setReadout = (text) => {
        readoutLabel.textContent = text
      }

      const activate = () => {
        rectActive = true
        drawing = false
        finished = false
        startPoint = null
        endPoint = null
        previousMode = 'rect'

        document.body.classList.add('site-a-mode')
        readout.dataset.mode = 'rect'
        readout.classList.add('is-visible')
        root.classList.add('is-visible')
        setCadTheme(true)
        syncGrid('rect')
        hint.textContent = 'RECT / HOLD + DRAW'
        setReadout('RECT / DRAW')
        setViewBox()
        clearGeometry()
      }

      const deactivate = () => {
        rectActive = false
        drawing = false
        finished = false
        startPoint = null
        endPoint = null
        root.classList.remove('is-visible')
        setCadTheme(false)
        clearGeometry()
      }

      const handleModeChange = () => {
        const nextMode = readout.dataset.mode ?? ''

        if (rectActive) {
          if (nextMode !== 'rect') {
            deactivate()
            previousMode = nextMode
          }
          syncGrid(nextMode)
          return
        }

        if (previousMode === 'area' && nextMode === '') {
          activate()
          return
        }

        previousMode = nextMode
        syncGrid(nextMode)
      }

      const handlePointerDown = (event) => {
        if (!rectActive || event.button !== 0) return

        event.preventDefault()
        event.stopPropagation()

        drawing = true
        finished = false
        startPoint = { x: event.clientX, y: event.clientY }
        endPoint = { ...startPoint }
        setGeometry(startPoint, endPoint)
        setReadout('RECT / DRAW')
        hint.textContent = 'RECT / RELEASE TO CLOSE'
      }

      const handlePointerMove = (event) => {
        if (!rectActive) return

        readout.style.left = `${event.clientX}px`
        readout.style.top = `${event.clientY}px`

        if (!drawing || !startPoint) {
          setReadout(finished ? 'RECT / DRAW NEW' : 'RECT / DRAW')
          return
        }

        endPoint = { x: event.clientX, y: event.clientY }
        const rect = setGeometry(startPoint, endPoint)
        setReadout(`RECT / ${Math.round(rect.width)} × ${Math.round(rect.height)} px`)
      }

      const handlePointerUp = (event) => {
        if (!rectActive || !drawing || event.button !== 0 || !startPoint) return

        event.preventDefault()
        event.stopPropagation()

        endPoint = { x: event.clientX, y: event.clientY }
        const rect = setGeometry(startPoint, endPoint)
        drawing = false

        if (rect.width < 4 || rect.height < 4) {
          finished = false
          startPoint = null
          endPoint = null
          clearGeometry()
          setReadout('RECT / DRAW')
          hint.textContent = 'RECT / HOLD + DRAW'
          return
        }

        finished = true
        const area = Math.round(rect.width * rect.height)
        setReadout(`RECT / ${Math.round(rect.width)} × ${Math.round(rect.height)} px`)
        hint.textContent = `RECT / ${area} px² / HOLD + DRAW NEW`
      }

      const handlePointerCancel = () => {
        if (!rectActive || !drawing) return
        drawing = false
        finished = false
        startPoint = null
        endPoint = null
        clearGeometry()
        setReadout('RECT / DRAW')
        hint.textContent = 'RECT / HOLD + DRAW'
      }

      const observer = new MutationObserver(handleModeChange)
      observer.observe(readout, {
        attributes: true,
        attributeFilter: ['data-mode'],
      })

      window.addEventListener('pointerdown', handlePointerDown)
      window.addEventListener('pointermove', handlePointerMove, { passive: false })
      window.addEventListener('pointerup', handlePointerUp)
      window.addEventListener('pointercancel', handlePointerCancel)
      window.addEventListener('resize', setViewBox, { passive: true })
      setViewBox()
      syncGrid()
      setCadTheme(false)

      window.addEventListener(
        'pagehide',
        () => {
          observer.disconnect()
          window.removeEventListener('pointerdown', handlePointerDown)
          window.removeEventListener('pointermove', handlePointerMove)
          window.removeEventListener('pointerup', handlePointerUp)
          window.removeEventListener('pointercancel', handlePointerCancel)
          window.removeEventListener('resize', setViewBox)
          gridBackdrop.classList.remove('is-visible')
          deactivate()
        },
        { once: true }
      )
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize, { once: true })
    } else {
      initialize()
    }
  })()
</script>
