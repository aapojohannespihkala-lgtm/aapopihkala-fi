  @media (prefers-reduced-motion: reduce) {
    html.site-rect-cad-theme,
    html.site-rect-cad-theme body,
    html.site-rect-cad-theme .main-container,
    html.site-rect-cad-theme .hero,
    html.site-rect-cad-theme .topbar,
    html.site-rect-cad-theme .morphing-topography__canvas,
    html.site-rect-cad-theme .post-interactive-graphic canvas,
    html.site-rect-cad-theme .post-graphic-image,
    .site-rect-area {
      transition: none !important;
