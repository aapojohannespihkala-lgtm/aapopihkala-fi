  }

  .site-rect-area__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .site-rect-area__contrast,
  .site-rect-area__fill,
  .site-rect-area__stroke {
    vector-effect: non-scaling-stroke;
  }

  .site-rect-area__contrast {
    fill: rgba(255, 255, 255, 0.08);
    stroke: none;
    mix-blend-mode: screen;
  }

  .site-rect-area__fill {
    fill: rgba(38, 126, 76, 0.34);
    stroke: none;
  }

  .site-rect-area__stroke {
    fill: none;
    stroke: rgba(245, 250, 252, 0.98);
    stroke-width: 0.9;
    stroke-dasharray: 2 2.8;
    stroke-linecap: butt;
    stroke-linejoin: miter;
    filter:
      drop-shadow(0 0 0.45px rgba(255, 255, 255, 0.96))
