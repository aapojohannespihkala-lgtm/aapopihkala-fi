---
import MeshyPixelatedPoiseVol4 from './MeshyPixelatedPoiseVol4.astro';
import type { SiteLanguage } from '../config/site';

interface Props {
  lang: SiteLanguage;
}

const { lang } = Astro.props;

const content = {
  fi: {
    kicker: 'ABOUT / LUONNOS',
    title: 'Tietoa minusta',
    primary: 'Esittelyteksti tulossa.',
    secondary: 'Tähän tulee myöhemmin lyhyt kuvaus minusta, työstäni ja tavastani katsoa maisemaa.',
    placeholderOne: 'BIO / TBD',
    placeholderTwo: 'TYÖ / TBD',
    placeholderThree: 'NÄKÖKULMA / TBD',
    hint: 'Vedä pyörittääksesi',
  },
  en: {
    kicker: 'ABOUT / DRAFT',
    title: 'About me',
    primary: 'Introduction pending.',
    secondary: 'A short description about me, my work and the way I look at landscapes will live here later.',
    placeholderOne: 'BIO / TBD',
    placeholderTwo: 'WORK / TBD',
    placeholderThree: 'PERSPECTIVE / TBD',
    hint: 'Drag to rotate',
  },
} as const;

const t = content[lang];
---

<section class="about-portrait" aria-labelledby="about-portrait-title">
  <div class="about-portrait__row">
    <div class="about-portrait__copy">
      <p class="about-portrait__kicker">{t.kicker}</p>

      <h1 id="about-portrait-title">{t.title}</h1>

      <div class="about-portrait__description">
        <p class="about-portrait__primary">{t.primary}</p>
        <p class="about-portrait__secondary">{t.secondary}</p>
      </div>

      <div class="about-portrait__placeholders" aria-label="Placeholder content">
        <span>{t.placeholderOne}</span>
        <span>{t.placeholderTwo}</span>
        <span>{t.placeholderThree}</span>
      </div>
    </div>

    <div class="about-portrait__visual">
      <div class="about-portrait__frame">
        <span class="about-portrait__corner about-portrait__corner--tl" aria-hidden="true"></span>
        <span class="about-portrait__corner about-portrait__corner--tr" aria-hidden="true"></span>
        <span class="about-portrait__corner about-portrait__corner--bl" aria-hidden="true"></span>
        <span class="about-portrait__corner about-portrait__corner--br" aria-hidden="true"></span>
        <span class="about-portrait__axis about-portrait__axis--x" aria-hidden="true"></span>
        <span class="about-portrait__axis about-portrait__axis--y" aria-hidden="true"></span>

        <div class="about-portrait__viewport">
          <MeshyPixelatedPoiseVol4
            enableZoom={false}
            enablePan={false}
            cameraX={0}
            cameraFov={38}
            cameraDistance={4.6}
            cameraHeight={0}
            targetY={0}
          />
        </div>

        <div class="about-portrait__frame-meta" aria-hidden="true">
          <span>SCAN / 11</span>
          <span>XYZ / FREE ORBIT</span>
        </div>
      </div>

      <p class="about-portrait__hint">{t.hint}</p>
    </div>
  </div>
</section>

<style>
  .about-portrait {
    min-height: calc(100svh - 64px);
    display: flex;
    align-items: center;
    padding: 0;
    color: var(--ink);
  }

  .about-portrait__row {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 360px);
    align-items: center;
    gap: clamp(32px, 5vw, 52px);
    transform: translateY(clamp(14px, 3vh, 28px));
  }

  .about-portrait__copy {
    position: relative;
    min-width: 0;
    max-width: 470px;
  }

  .about-portrait__kicker,
  .about-portrait__placeholders,
  .about-portrait__hint,
  .about-portrait__frame-meta {
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .about-portrait__kicker {
    position: absolute;
    left: 0;
    bottom: calc(100% + 16px);
    margin: 0;
    color: var(--stone-light);
    font-size: 0.5rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .about-portrait h1 {
    margin: 0 0 32px;
    color: var(--ink);
    font-family:
      "Times New Roman",
      Times,
      serif;
    font-size: clamp(3.4rem, 6.4vw, 4.5rem);
    font-weight: 400;
    line-height: 0.97;
    letter-spacing: -0.046em;
  }

  .about-portrait__description {
    max-width: 470px;
  }

  .about-portrait__description p {
    margin: 0;
  }

  .about-portrait__primary {
    color: var(--ink-soft);
    font-size: 1.07rem;
    font-weight: 450;
    line-height: 1.55;
    letter-spacing: -0.009em;
  }

  .about-portrait__secondary {
    max-width: 460px;
    margin-top: 4px !important;
    color: var(--stone);
    font-size: 1.06rem;
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.009em;
  }

  .about-portrait__placeholders {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    color: var(--stone-light);
    font-size: 0.47rem;
    line-height: 1.4;
  }

  .about-portrait__placeholders span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .about-portrait__placeholders span + span::before {
    content: '/';
    color: var(--line);
  }

  .about-portrait__visual {
    min-width: 0;
    width: 100%;
  }

  .about-portrait__frame {
    position: relative;
    width: 100%;
    height: clamp(360px, 55svh, 500px);
    overflow: hidden;
    border: 1px solid var(--line-soft);
    background:
      linear-gradient(var(--line-soft), var(--line-soft)) 50% 0 / 1px 8px no-repeat,
      linear-gradient(var(--line-soft), var(--line-soft)) 50% 100% / 1px 8px no-repeat,
      linear-gradient(90deg, var(--line-soft), var(--line-soft)) 0 50% / 8px 1px no-repeat,
      linear-gradient(90deg, var(--line-soft), var(--line-soft)) 100% 50% / 8px 1px no-repeat;
  }

  .about-portrait__viewport {
    position: absolute;
    inset: 18px;
  }

  .about-portrait__viewport :global(.meshy-point-surface) {
    min-height: 100%;
  }

  .about-portrait__corner {
    position: absolute;
    width: 18px;
    height: 18px;
    z-index: 2;
    pointer-events: none;
  }

  .about-portrait__corner::before,
  .about-portrait__corner::after {
    content: '';
    position: absolute;
    background: var(--moss);
    opacity: 0.56;
  }

  .about-portrait__corner::before {
    width: 18px;
    height: 1px;
  }

  .about-portrait__corner::after {
    width: 1px;
    height: 18px;
  }

  .about-portrait__corner--tl { top: 10px; left: 10px; }
  .about-portrait__corner--tr { top: 10px; right: 10px; transform: rotate(90deg); }
  .about-portrait__corner--br { right: 10px; bottom: 10px; transform: rotate(180deg); }
  .about-portrait__corner--bl { left: 10px; bottom: 10px; transform: rotate(270deg); }

  .about-portrait__axis {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    background: var(--line-soft);
    opacity: 0.48;
  }

  .about-portrait__axis--x {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }

  .about-portrait__axis--y {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }

  .about-portrait__frame-meta {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 10px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--stone-light);
    font-size: 0.4rem;
    pointer-events: none;
  }

  .about-portrait__hint {
    margin: 7px 0 0;
    color: var(--stone-light);
    font-size: 0.42rem;
    text-align: right;
  }

  @media (max-width: 800px) {
    .about-portrait__row {
      grid-template-columns: minmax(0, 1fr) minmax(270px, 320px);
      gap: 28px;
    }

    .about-portrait__frame {
      height: clamp(340px, 52svh, 450px);
    }
  }

  @media (max-width: 640px) {
    .about-portrait {
      min-height: auto;
      padding: 96px 0 72px;
    }

    .about-portrait__row {
      grid-template-columns: 1fr;
      gap: 42px;
      transform: none;
    }

    .about-portrait__kicker {
      position: static;
      margin: 0 0 16px;
    }

    .about-portrait h1 {
      font-size: clamp(3.2rem, 15vw, 4.1rem);
    }

    .about-portrait__visual {
      width: min(100%, 390px);
      justify-self: center;
    }

    .about-portrait__frame {
      height: min(112vw, 500px);
      min-height: 360px;
    }

    .about-portrait__viewport {
      inset: 14px;
    }
  }
</style>

<style is:global>
  html.site-night-mode .about-portrait .meshy-point-surface__canvas {
    filter: invert(1) grayscale(1) brightness(1.72) contrast(1.12);
    opacity: 0.94;
    transition: filter 180ms ease, opacity 180ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    html.site-night-mode .about-portrait .meshy-point-surface__canvas {
      transition: none;
    }
  }
</style>
