---
import MeshyPixelatedPoiseVol4 from './MeshyPixelatedPoiseVol4.astro';
import type { SiteLanguage } from '../config/site';

interface Props {
  lang: SiteLanguage;
}

const { lang } = Astro.props;

const content = {
  fi: {
    kicker: 'ABOUT / LUONNOS',
    title: 'Tietoa minusta',
    primary: 'Esittelyteksti tulossa.',
    secondary: 'Tähän tulee myöhemmin lyhyt kuvaus minusta, työstäni ja tavastani katsoa maisemaa.',
    placeholderOne: 'BIO / TBD',
    placeholderTwo: 'TYÖ / TBD',
    placeholderThree: 'NÄKÖKULMA / TBD',
    hint: 'Vedä pyörittääksesi',
  },
  en: {
    kicker: 'ABOUT / DRAFT',
    title: 'About me',
    primary: 'Introduction pending.',
    secondary: 'A short description about me, my work and the way I look at landscapes will live here later.',
    placeholderOne: 'BIO / TBD',
    placeholderTwo: 'WORK / TBD',
    placeholderThree: 'PERSPECTIVE / TBD',
    hint: 'Drag to rotate',
  },
} as const;

const t = content[lang];
---

<section class="about-portrait" aria-labelledby="about-portrait-title">
  <div class="about-portrait__row">
    <div class="about-portrait__copy">
      <p class="about-portrait__kicker">{t.kicker}</p>

      <h1 id="about-portrait-title">{t.title}</h1>

      <div class="about-portrait__description">
        <p class="about-portrait__primary">{t.primary}</p>
        <p class="about-portrait__secondary">{t.secondary}</p>
      </div>

      <div class="about-portrait__placeholders" aria-label="Placeholder content">
        <span>{t.placeholderOne}</span>
        <span>{t.placeholderTwo}</span>
        <span>{t.placeholderThree}</span>
      </div>
    </div>

    <div class="about-portrait__visual">
      <div class="about-portrait__viewport">
        <MeshyPixelatedPoiseVol4
          enableZoom={false}
          enablePan={false}
          cameraX={0}
          cameraFov={38}
          cameraDistance={6.4}
          cameraHeight={0}
          targetY={0}
        />
      </div>

      <p class="about-portrait__hint">{t.hint}</p>
    </div>
  </div>
</section>

<style>
  .about-portrait {
    min-height: calc(100svh - 64px);
    display: flex;
    align-items: center;
    padding: 0;
    color: var(--ink);
  }

  .about-portrait__row {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(34px, 6vw, 72px);
    transform: translateY(clamp(14px, 3vh, 28px));
  }

  .about-portrait__copy {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 470px;
  }

  .about-portrait__kicker,
  .about-portrait__placeholders,
  .about-portrait__hint {
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .about-portrait__kicker {
    margin: 0 0 18px;
    color: var(--stone-light);
    font-size: 0.5rem;
    font-weight: 600;
  }

  .about-portrait h1 {
    margin: 0 0 32px;
    color: var(--ink);
    font-family:
      "Times New Roman",
      Times,
      serif;
    font-size: clamp(3.5rem, 7vw, 4.5rem);
    font-weight: 400;
    line-height: 0.97;
    letter-spacing: -0.046em;
  }

  .about-portrait__description {
    max-width: 470px;
    margin-bottom: 0;
  }

  .about-portrait__description p {
    margin: 0;
  }

  .about-portrait__primary {
    color: var(--ink-soft);
    font-size: 1.07rem;
    font-weight: 450;
    line-height: 1.55;
    letter-spacing: -0.009em;
  }

  .about-portrait__secondary {
    max-width: 460px;
    margin-top: 4px !important;
    color: var(--stone);
    font-size: 1.06rem;
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.009em;
  }

  .about-portrait__placeholders {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    color: var(--stone-light);
    font-size: 0.47rem;
    line-height: 1.4;
  }

  .about-portrait__placeholders span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .about-portrait__placeholders span + span::before {
    content: '/';
    color: var(--line);
  }

  .about-portrait__visual {
    width: 250px;
    flex: 0 0 250px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .about-portrait__viewport {
    width: 250px;
    height: 330px;
  }

  .about-portrait__viewport :global(.meshy-point-surface) {
    min-height: 0;
  }

  .about-portrait__hint {
    margin: 8px 0 0;
    color: var(--stone-light);
    font-size: 0.42rem;
    text-align: center;
  }

  @media (max-width: 800px) {
    .about-portrait__row {
      gap: 30px;
    }

    .about-portrait__visual,
    .about-portrait__viewport {
      width: 220px;
    }

    .about-portrait__visual {
      flex-basis: 220px;
    }

    .about-portrait__viewport {
      height: 300px;
    }
  }

  @media (max-width: 640px) {
    .about-portrait {
      min-height: auto;
      padding: 96px 0 72px;
    }

    .about-portrait__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 46px;
      transform: none;
    }

    .about-portrait h1 {
      font-size: clamp(3.2rem, 15vw, 4.1rem);
    }

    .about-portrait__visual {
      width: min(100%, 280px);
      flex-basis: auto;
      align-self: center;
    }

    .about-portrait__viewport {
      width: 100%;
      height: 340px;
    }
  }
</style>

<style is:global>
  html.site-night-mode .about-portrait .meshy-point-surface__canvas {
    filter: invert(1) grayscale(1) brightness(1.72) contrast(1.12);
    opacity: 0.94;
    transition: filter 180ms ease, opacity 180ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    html.site-night-mode .about-portrait .meshy-point-surface__canvas {
      transition: none;
    }
  }
</style>
