---
import MeshyPixelatedPoiseVol4 from './MeshyPixelatedPoiseVol4.astro';
import type { SiteLanguage } from '../config/site';

interface Props {
  lang: SiteLanguage;
}

const { lang } = Astro.props;

const content = {
  fi: {
    index: 'ABOUT / DRAFT 01',
    scan: 'PROFILE SCAN / LIVE',
    title: '[ Esittelyteksti tulossa ]',
    body: 'Tähän tulee myöhemmin lyhyt esittely minusta, työstäni ja tavastani katsoa maisemaa.',
    bodySecondary: 'Nykyinen versio on tarkoituksella keskeneräinen. Sillä välin profiiliskannaus saa hoitaa suurimman osan puhumisesta.',
    baseLabel: 'STATUS',
    baseValue: 'Luonnos / kesken',
    fieldLabel: 'CONTENT',
    fieldValue: 'Esittely / TBD',
    modelLabel: 'MODEL',
    modelValue: 'Pistepilvi / 3D',
    hint: 'Vedä pyörittääksesi · rullaa zoomataksesi',
  },
  en: {
    index: 'ABOUT / DRAFT 01',
    scan: 'PROFILE SCAN / LIVE',
    title: '[ About text pending ]',
    body: 'A short introduction about me, my work and the way I look at landscapes will live here later.',
    bodySecondary: 'This version is intentionally unfinished. For now, the profile scan can do most of the talking.',
    baseLabel: 'STATUS',
    baseValue: 'Draft / in progress',
    fieldLabel: 'CONTENT',
    fieldValue: 'About / TBD',
    modelLabel: 'MODEL',
    modelValue: 'Point cloud / 3D',
    hint: 'Drag to rotate · scroll to zoom',
  },
} as const;

const t = content[lang];
---

<section class="about-portrait" data-homepage-about aria-labelledby="about-portrait-title">
  <header class="about-portrait__header">
    <p class="about-portrait__index">{t.index}</p>
    <p class="about-portrait__scan">{t.scan}</p>
  </header>

  <div class="about-portrait__grid">
    <div class="about-portrait__copy">
      <h2 id="about-portrait-title">{t.title}</h2>

      <div class="about-portrait__body">
        <p>{t.body}</p>
        <p>{t.bodySecondary}</p>
      </div>

      <dl class="about-portrait__meta">
        <div>
          <dt>{t.baseLabel}</dt>
          <dd>{t.baseValue}</dd>
        </div>
        <div>
          <dt>{t.fieldLabel}</dt>
          <dd>{t.fieldValue}</dd>
        </div>
        <div>
          <dt>{t.modelLabel}</dt>
          <dd>{t.modelValue}</dd>
        </div>
      </dl>
    </div>

    <div class="about-portrait__visual">
      <div class="about-portrait__frame">
        <span class="about-portrait__corner about-portrait__corner--tl" aria-hidden="true"></span>
        <span class="about-portrait__corner about-portrait__corner--tr" aria-hidden="true"></span>
        <span class="about-portrait__corner about-portrait__corner--bl" aria-hidden="true"></span>
        <span class="about-portrait__corner about-portrait__corner--br" aria-hidden="true"></span>
        <span class="about-portrait__axis about-portrait__axis--x" aria-hidden="true"></span>
        <span class="about-portrait__axis about-portrait__axis--y" aria-hidden="true"></span>

        <div class="about-portrait__viewport">
          <MeshyPixelatedPoiseVol4 />
        </div>

        <div class="about-portrait__frame-meta" aria-hidden="true">
          <span>SCAN / 11</span>
          <span>XYZ / FREE ORBIT</span>
        </div>
      </div>

      <p class="about-portrait__hint">{t.hint}</p>
    </div>
  </div>
</section>

<style>
  .about-portrait {
    position: relative;
    margin: clamp(38px, 7vw, 92px) 0 clamp(72px, 11vw, 150px);
    padding: 0 0 clamp(54px, 7vw, 92px);
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    color: var(--ink);
  }

  .about-portrait__header {
    min-height: 46px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--line-soft);
  }

  .about-portrait__index,
  .about-portrait__scan,
  .about-portrait__hint,
  .about-portrait__frame-meta,
  .about-portrait__meta dt {
    margin: 0;
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .about-portrait__index {
    color: var(--moss-deep);
    font-size: 0.58rem;
    font-weight: 600;
  }

  .about-portrait__scan {
    color: var(--stone);
    font-size: 0.49rem;
  }

  .about-portrait__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(420px, 1.18fr);
    gap: clamp(38px, 7vw, 108px);
    align-items: center;
    padding-top: clamp(48px, 7vw, 92px);
  }

  .about-portrait__copy {
    align-self: center;
  }

  .about-portrait__copy h2 {
    max-width: 14ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.65rem, 3.2vw, 3.15rem);
    font-weight: 430;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .about-portrait__body {
    max-width: 38rem;
    margin-top: clamp(28px, 3.6vw, 48px);
    display: grid;
    gap: 14px;
  }

  .about-portrait__body p {
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(0.92rem, 1.15vw, 1.05rem);
    line-height: 1.62;
  }

  .about-portrait__body p + p {
    color: var(--stone);
  }

  .about-portrait__meta {
    margin: clamp(34px, 4vw, 56px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-soft);
  }

  .about-portrait__meta > div {
    min-width: 0;
    padding: 11px 12px 0 0;
  }

  .about-portrait__meta > div + div {
    padding-left: 12px;
    border-left: 1px solid var(--line-soft);
  }

  .about-portrait__meta dt {
    color: var(--stone-light);
    font-size: 0.45rem;
  }

  .about-portrait__meta dd {
    margin: 5px 0 0;
    color: var(--ink-soft);
    font-size: 0.68rem;
    line-height: 1.35;
  }

  .about-portrait__visual {
    min-width: 0;
  }

  .about-portrait__frame {
    position: relative;
    min-height: clamp(430px, 50vw, 610px);
    overflow: hidden;
    border: 1px solid var(--line-soft);
    background:
      linear-gradient(var(--line-soft), var(--line-soft)) 50% 0 / 1px 8px no-repeat,
      linear-gradient(var(--line-soft), var(--line-soft)) 50% 100% / 1px 8px no-repeat,
      linear-gradient(90deg, var(--line-soft), var(--line-soft)) 0 50% / 8px 1px no-repeat,
      linear-gradient(90deg, var(--line-soft), var(--line-soft)) 100% 50% / 8px 1px no-repeat;
  }

  .about-portrait__viewport {
    position: absolute;
    inset: 22px;
  }

  .about-portrait__viewport :global(.meshy-point-surface) {
    min-height: 100%;
  }

  .about-portrait__corner {
    position: absolute;
    width: 18px;
    height: 18px;
    z-index: 2;
    pointer-events: none;
  }

  .about-portrait__corner::before,
  .about-portrait__corner::after {
    content: '';
    position: absolute;
    background: var(--moss);
    opacity: 0.56;
  }

  .about-portrait__corner::before {
    width: 18px;
    height: 1px;
  }

  .about-portrait__corner::after {
    width: 1px;
    height: 18px;
  }

  .about-portrait__corner--tl { top: 10px; left: 10px; }
  .about-portrait__corner--tr { top: 10px; right: 10px; transform: rotate(90deg); }
  .about-portrait__corner--br { right: 10px; bottom: 10px; transform: rotate(180deg); }
  .about-portrait__corner--bl { left: 10px; bottom: 10px; transform: rotate(270deg); }

  .about-portrait__axis {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    background: var(--line-soft);
    opacity: 0.48;
  }

  .about-portrait__axis--x {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }

  .about-portrait__axis--y {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }

  .about-portrait__frame-meta {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 12px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--stone-light);
    font-size: 0.43rem;
    pointer-events: none;
  }

  .about-portrait__hint {
    margin-top: 9px;
    color: var(--stone-light);
    font-size: 0.44rem;
    text-align: right;
  }

  @media (max-width: 880px) {
    .about-portrait__grid {
      grid-template-columns: 1fr;
      gap: 46px;
    }

    .about-portrait__copy h2 {
      max-width: 17ch;
    }

    .about-portrait__frame {
      min-height: min(76vw, 560px);
    }
  }

  @media (max-width: 560px) {
    .about-portrait {
      margin-top: 32px;
      padding-bottom: 48px;
    }

    .about-portrait__header {
      min-height: 40px;
    }

    .about-portrait__grid {
      padding-top: 38px;
      gap: 38px;
    }

    .about-portrait__meta {
      grid-template-columns: 1fr;
    }

    .about-portrait__meta > div,
    .about-portrait__meta > div + div {
      padding: 10px 0;
      border-left: 0;
      border-bottom: 1px solid var(--line-soft);
    }

    .about-portrait__frame {
      min-height: 112vw;
      max-height: 520px;
    }

    .about-portrait__viewport {
      inset: 10px;
    }

    .about-portrait__frame-meta {
      left: 10px;
      right: 10px;
      bottom: 8px;
    }
  }
</style>

<script is:inline>
  (() => {
    const section = document.querySelector('[data-homepage-about]')
    const feed = document.querySelector('.main-container > .feed')

    if (!section || !feed) return
    if (section.dataset.homepageAboutMounted === 'true') return

    section.dataset.homepageAboutMounted = 'true'
    feed.before(section)
  })()
</script>
