---
import MeshyPixelatedPoiseVol4 from './MeshyPixelatedPoiseVol4.astro';
import type { SiteLanguage } from '../config/site';

interface Props {
  lang: SiteLanguage;
}

const { lang } = Astro.props;

const content = {
  fi: {
    kicker: 'ABOUT / PROFIILI',
    title: 'Tietoa minusta',
    primary: 'Olen Espoossa toimiva maisema-arkkitehti.',
    secondary: 'Tarkastelen maisema-arkkitehtuuria kaupunkien, ihmisten ja luonnon rajapinnassa. Sivustolla kirjoitan muun muassa kaupunkiluonnosta, hulevesien hallinnasta, biodiversiteetistä ja kaupunkiympäristön suunnittelusta.',
    topicOne: 'ESPOO / SUOMI',
    topicTwo: 'MAISEMA-ARKKITEHTUURI',
    topicThree: 'KAUPUNKI + LUONTO',
    topicsLabel: 'Aiheita',
    hint: 'Vedä pyörittääksesi',
  },
  en: {
    kicker: 'ABOUT / PROFILE',
    title: 'About me',
    primary: 'I am a landscape architect based in Espoo, Finland.',
    secondary: 'I approach landscape architecture at the intersection of cities, people and nature. On this site I write about urban nature, stormwater management, biodiversity and urban planning.',
    topicOne: 'ESPOO / FINLAND',
    topicTwo: 'LANDSCAPE ARCHITECTURE',
    topicThree: 'CITIES + NATURE',
    topicsLabel: 'Topics',
    hint: 'Drag to rotate',
  },
} as const;

const t = content[lang];
---

<section class="about-portrait" aria-labelledby="about-portrait-title">
  <div class="about-portrait__row">
    <div class="about-portrait__copy">
      <p class="about-portrait__kicker">{t.kicker}</p>

      <h1 id="about-portrait-title">{t.title}</h1>

      <div class="about-portrait__description">
        <p class="about-portrait__primary">{t.primary}</p>
        <p class="about-portrait__secondary">{t.secondary}</p>
      </div>

      <div class="about-portrait__placeholders" aria-label={t.topicsLabel}>
        <span>{t.topicOne}</span>
        <span>{t.topicTwo}</span>
        <span>{t.topicThree}</span>
      </div>
    </div>

    <div class="about-portrait__visual">
      <div class="about-portrait__frame" data-about-portrait-frame>
        <span class="about-portrait__corner about-portrait__corner--tl" aria-hidden="true"></span>
        <span class="about-portrait__corner about-portrait__corner--tr" aria-hidden="true"></span>
        <span class="about-portrait__corner about-portrait__corner--bl" aria-hidden="true"></span>
        <span class="about-portrait__corner about-portrait__corner--br" aria-hidden="true"></span>
        <span class="about-portrait__axis about-portrait__axis--x" aria-hidden="true"></span>
        <span class="about-portrait__axis about-portrait__axis--y" aria-hidden="true"></span>

        <div class="about-portrait__viewport">
          <MeshyPixelatedPoiseVol4
            enableZoom={false}
            enablePan={false}
            enableIdleMotion={true}
            enableSurfaceProbe={true}
            idleYawRange={14}
            idlePitchRange={8}
            cameraX={0}
            cameraFov={38}
            cameraDistance={3.8}
            cameraHeight={0}
            targetY={0}
          />
        </div>

        <div class="about-portrait__voice" data-about-portrait-voice aria-hidden="true">
          <span class="about-portrait__voice-status" data-about-portrait-voice-status>
            SUBJECT / PROTESTING
          </span>
          <span class="about-portrait__voice-line" data-about-portrait-voice-line>
            &gt; why are you pulling my hair
          </span>
        </div>

        <div class="about-portrait__frame-meta" aria-hidden="true">
          <span>SCAN / 11</span>
          <span>XYZ / SURFACE PROBE</span>
        </div>
      </div>

      <p class="about-portrait__hint">{t.hint}</p>
    </div>
  </div>
</section>

<style>
  .about-portrait {
    min-height: calc(100svh - 64px);
    display: flex;
    align-items: center;
    padding: 0;
    color: var(--ink);
  }

  .about-portrait__row {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 360px);
    align-items: center;
    gap: clamp(32px, 5vw, 52px);
    transform: translateY(clamp(14px, 3vh, 28px));
  }

  .about-portrait__copy {
    position: relative;
    min-width: 0;
    max-width: 470px;
  }

  .about-portrait__kicker,
  .about-portrait__placeholders,
  .about-portrait__hint,
  .about-portrait__frame-meta {
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .about-portrait__kicker {
    position: absolute;
    left: 0;
    bottom: calc(100% + 16px);
    margin: 0;
    color: var(--stone-light);
    font-size: 0.5rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .about-portrait h1 {
    margin: 0 0 32px;
    color: var(--ink);
    font-family:
      "Times New Roman",
      Times,
      serif;
    font-size: clamp(3.4rem, 6.4vw, 4.5rem);
    font-weight: 400;
    line-height: 0.97;
    letter-spacing: -0.046em;
  }

  .about-portrait__description {
    max-width: 470px;
  }

  .about-portrait__description p {
    margin: 0;
  }

  .about-portrait__primary {
    color: var(--ink-soft);
    font-size: 1.07rem;
    font-weight: 450;
    line-height: 1.55;
    letter-spacing: -0.009em;
  }

  .about-portrait__secondary {
    max-width: 460px;
    margin-top: 4px !important;
    color: var(--stone);
    font-size: 1.06rem;
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.009em;
  }

  .about-portrait__placeholders {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    color: var(--stone-light);
    font-size: 0.47rem;
    line-height: 1.4;
  }

  .about-portrait__placeholders span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .about-portrait__placeholders span + span::before {
    content: '/';
    color: var(--line);
  }

  .about-portrait__visual {
    min-width: 0;
    width: 100%;
  }

  .about-portrait__frame {
    position: relative;
    width: 100%;
    height: clamp(360px, 55svh, 500px);
    overflow: hidden;
    border: 1px solid var(--line-soft);
    background:
      linear-gradient(var(--line-soft), var(--line-soft)) 50% 0 / 1px 8px no-repeat,
      linear-gradient(var(--line-soft), var(--line-soft)) 50% 100% / 1px 8px no-repeat,
      linear-gradient(90deg, var(--line-soft), var(--line-soft)) 0 50% / 8px 1px no-repeat,
      linear-gradient(90deg, var(--line-soft), var(--line-soft)) 100% 50% / 8px 1px no-repeat;
  }

  .about-portrait__viewport {
    position: absolute;
    inset: 18px;
  }

  .about-portrait__viewport :global(.meshy-point-surface) {
    min-height: 100%;
  }

  .about-portrait__voice {
    position: absolute;
    top: 42px;
    right: 16px;
    z-index: 3;
    display: grid;
    justify-items: end;
    gap: 4px;
    max-width: calc(100% - 32px);
    pointer-events: none;
    opacity: 0;
    transform: translateY(-3px);
    transition:
      opacity 140ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    text-align: right;
  }

  .about-portrait__voice.is-visible {
    opacity: 0.82;
    transform: translateY(0);
  }

  .about-portrait__voice-status {
    color: var(--stone-light);
    font-size: 0.38rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .about-portrait__voice-line {
    max-width: 290px;
    color: var(--moss);
    font-size: 0.48rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.035em;
    text-transform: lowercase;
  }

  .about-portrait__corner {
    --corner-x: 0px;
    --corner-y: 0px;
    --corner-rotation: 0deg;
    position: absolute;
    width: 18px;
    height: 18px;
    z-index: 2;
    pointer-events: none;
    transform: translate(var(--corner-x), var(--corner-y)) rotate(var(--corner-rotation));
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-portrait__corner::before,
  .about-portrait__corner::after {
    content: '';
    position: absolute;
    background: var(--moss);
    opacity: 0.56;
  }

  .about-portrait__corner::before {
    width: 18px;
    height: 1px;
  }

  .about-portrait__corner::after {
    width: 1px;
    height: 18px;
  }

  .about-portrait__corner--tl {
    top: 10px;
    left: 10px;
  }

  .about-portrait__corner--tr {
    top: 10px;
    right: 10px;
    --corner-rotation: 90deg;
  }

  .about-portrait__corner--br {
    right: 10px;
    bottom: 10px;
    --corner-rotation: 180deg;
  }

  .about-portrait__corner--bl {
    left: 10px;
    bottom: 10px;
    --corner-rotation: 270deg;
  }

  .about-portrait__frame.is-model-hovered .about-portrait__corner--tl {
    --corner-x: -3px;
    --corner-y: -3px;
  }

  .about-portrait__frame.is-model-hovered .about-portrait__corner--tr {
    --corner-x: 3px;
    --corner-y: -3px;
  }

  .about-portrait__frame.is-model-hovered .about-portrait__corner--br {
    --corner-x: 3px;
    --corner-y: 3px;
  }

  .about-portrait__frame.is-model-hovered .about-portrait__corner--bl {
    --corner-x: -3px;
    --corner-y: 3px;
  }

  .about-portrait__frame.is-model-active .about-portrait__corner {
    transition-duration: 120ms;
  }

  .about-portrait__frame.is-model-active .about-portrait__corner--tl {
    --corner-x: 2px;
    --corner-y: 2px;
  }

  .about-portrait__frame.is-model-active .about-portrait__corner--tr {
    --corner-x: -2px;
    --corner-y: 2px;
  }

  .about-portrait__frame.is-model-active .about-portrait__corner--br {
    --corner-x: -2px;
    --corner-y: -2px;
  }

  .about-portrait__frame.is-model-active .about-portrait__corner--bl {
    --corner-x: 2px;
    --corner-y: -2px;
  }

  .about-portrait__axis {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    background: var(--line-soft);
    opacity: 0.48;
  }

  .about-portrait__axis--x {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }

  .about-portrait__axis--y {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }

  .about-portrait__frame-meta {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 10px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--stone-light);
    font-size: 0.4rem;
    pointer-events: none;
  }

  .about-portrait__frame-meta span {
    display: inline-block;
    transform: translate(0, 0);
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-portrait__frame.is-model-hovered .about-portrait__frame-meta span:first-child {
    transform: translate(-3px, 3px);
  }

  .about-portrait__frame.is-model-hovered .about-portrait__frame-meta span:last-child {
    transform: translate(3px, 3px);
  }

  .about-portrait__frame.is-model-active .about-portrait__frame-meta span {
    transition-duration: 120ms;
  }

  .about-portrait__frame.is-model-active .about-portrait__frame-meta span:first-child {
    transform: translate(2px, -2px);
  }

  .about-portrait__frame.is-model-active .about-portrait__frame-meta span:last-child {
    transform: translate(-2px, -2px);
  }

  .about-portrait__hint {
    margin: 7px 0 0;
    color: var(--stone-light);
    font-size: 0.42rem;
    text-align: right;
  }

  @media (max-width: 800px) {
    .about-portrait__row {
      grid-template-columns: minmax(0, 1fr) minmax(270px, 320px);
      gap: 28px;
    }

    .about-portrait__frame {
      height: clamp(340px, 52svh, 450px);
    }
  }

  @media (max-width: 640px) {
    .about-portrait {
      min-height: auto;
      padding: 96px 0 72px;
    }

    .about-portrait__row {
      grid-template-columns: 1fr;
      gap: 42px;
      transform: none;
    }

    .about-portrait__kicker {
      position: static;
      margin: 0 0 16px;
    }

    .about-portrait h1 {
      font-size: clamp(3.2rem, 15vw, 4.1rem);
    }

    .about-portrait__visual {
      width: min(100%, 390px);
      justify-self: center;
    }

    .about-portrait__frame {
      height: min(112vw, 500px);
      min-height: 360px;
    }

    .about-portrait__viewport {
      inset: 14px;
    }

    .about-portrait__voice {
      top: 38px;
      right: 14px;
      max-width: calc(100% - 28px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-portrait__corner,
    .about-portrait__frame-meta span,
    .about-portrait__voice {
      transition: none;
    }
  }
</style>

<style is:global>
  @media (hover: hover) and (pointer: fine) {
    .about-portrait .meshy-point-surface--probe,
    .about-portrait .meshy-point-surface--probe .meshy-point-surface__canvas,
    .about-portrait .meshy-point-surface--probe:active,
    .about-portrait .meshy-point-surface--probe:active .meshy-point-surface__canvas {
      cursor: crosshair !important;
    }
  }

  .about-portrait .meshy-point-surface__probe {
    opacity: 0;
    color: var(--moss-deep);
  }

  .about-portrait .meshy-point-surface__probe.is-visible {
    opacity: 1;
  }

  .about-portrait .meshy-point-surface__probe-cross {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3px;
    height: 3px;
    box-sizing: border-box;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: var(--page);
    transform: translate(-50%, -50%);
    z-index: 0;
  }

  .about-portrait .meshy-point-surface__probe-cross::before,
  .about-portrait .meshy-point-surface__probe-cross::after {
    opacity: 0.72;
    z-index: -1;
  }

  .about-portrait .meshy-point-surface__probe-label {
    left: 13px !important;
    top: -1px !important;
    right: auto !important;
    bottom: auto !important;
    display: flex;
    align-items: baseline;
    gap: 6px;
    min-width: max-content;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--moss);
    font-size: 0.48rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.06em;
  }

  .about-portrait .meshy-point-surface__probe-secondary {
    color: var(--moss);
  }

  .about-portrait .meshy-point-surface__probe.is-left .meshy-point-surface__probe-label {
    left: auto !important;
    right: 13px !important;
  }

  .about-portrait .meshy-point-surface__probe.is-up .meshy-point-surface__probe-label {
    top: auto !important;
    bottom: -1px !important;
  }

  html.site-night-mode .about-portrait .meshy-point-surface__canvas {
    filter: invert(1) grayscale(1) brightness(1.72) contrast(1.12);
    opacity: 0.94;
    transition: filter 180ms ease, opacity 180ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    html.site-night-mode .about-portrait .meshy-point-surface__canvas {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const frames = document.querySelectorAll('[data-about-portrait-frame]');

    const primaryComments = [
      'why are you pulling my hair',
      'careful with the face',
      "okay, i get it. i'm 3d.",
      'you can let go now',
      "i'm not a stress ball",
      'orbit responsibly',
      'please respect the topology',
      'my neck was not designed for this',
      'are you testing the model or me',
      'i have approximately 42,000 reasons to be nervous',
      'did the cursor come with a permit',
      'this feels less like interaction and more like fieldwork',
    ];

    const escalationComments = [
      'this is becoming personal',
      'you have thoroughly established the third dimension',
      'still here. still being rotated.',
      'please return my face to its original coordinate system',
      "i'm filing this under excessive orbit",
      'that is enough user testing for one neck',
    ];

    frames.forEach((frame) => {
      if (!(frame instanceof HTMLElement)) return;
      if (frame.dataset.cornerInteractionInitialized === 'true') return;
      frame.dataset.cornerInteractionInitialized = 'true';

      const model = frame.querySelector('[data-meshy-point-surface]');
      const voice = frame.querySelector('[data-about-portrait-voice]');
      const voiceStatus = frame.querySelector('[data-about-portrait-voice-status]');
      const voiceLine = frame.querySelector('[data-about-portrait-voice-line]');
      if (!(model instanceof HTMLElement)) return;

      const canSpeak =
        voice instanceof HTMLElement &&
        voiceStatus instanceof HTMLElement &&
        voiceLine instanceof HTMLElement;

      let pointerDown = false;
      let dragDistance = 0;
      let lastPointerX = 0;
      let lastPointerY = 0;
      let dragTimersStarted = false;
      let firstTimer = 0;
      let secondTimer = 0;
      let hideTimer = 0;
      let cooldownUntil = 0;
      let voiceShownThisDrag = false;
      let lastComment = '';

      const randomBetween = (min, max) => min + Math.random() * (max - min);

      const setHovered = (hovered) => {
        frame.classList.toggle('is-model-hovered', hovered);
      };

      const setActive = (active) => {
        frame.classList.toggle('is-model-active', active);
      };

      const clearDragTimers = () => {
        window.clearTimeout(firstTimer);
        window.clearTimeout(secondTimer);
        firstTimer = 0;
        secondTimer = 0;
      };

      const hideVoice = () => {
        if (!canSpeak) return;
        voice.classList.remove('is-visible');
      };

      const chooseComment = (pool) => {
        const candidates = pool.filter((comment) => comment !== lastComment);
        const source = candidates.length ? candidates : pool;
        const comment = source[Math.floor(Math.random() * source.length)];
        lastComment = comment;
        return comment;
      };

      const showVoice = (stage) => {
        if (!canSpeak || !pointerDown) return;

        const concerned = stage === 'concerned';
        voiceStatus.textContent = concerned
          ? 'SUBJECT / CONCERNED'
          : 'SUBJECT / PROTESTING';
        voiceLine.textContent = `> ${chooseComment(
          concerned ? escalationComments : primaryComments
        )}`;
        voice.classList.add('is-visible');
        voiceShownThisDrag = true;
      };

      const startDragTimers = () => {
        if (!canSpeak || dragTimersStarted) return;
        if (performance.now() < cooldownUntil) return;

        dragTimersStarted = true;
        firstTimer = window.setTimeout(() => showVoice('protesting'), 3000);
        secondTimer = window.setTimeout(
          () => showVoice('concerned'),
          randomBetween(7200, 9000)
        );
      };

      const finishDrag = () => {
        if (!pointerDown) return;

        pointerDown = false;
        setActive(false);
        clearDragTimers();
        dragTimersStarted = false;

        if (voiceShownThisDrag) {
          cooldownUntil = performance.now() + randomBetween(20000, 30000);
          window.clearTimeout(hideTimer);
          hideTimer = window.setTimeout(hideVoice, 2400);
        }
      };

      model.addEventListener('pointerenter', () => setHovered(true));
      model.addEventListener('pointerleave', () => {
        setHovered(false);
        if (!pointerDown) setActive(false);
      });

      model.addEventListener('pointerdown', (event) => {
        pointerDown = true;
        dragDistance = 0;
        dragTimersStarted = false;
        voiceShownThisDrag = false;
        lastPointerX = event.clientX;
        lastPointerY = event.clientY;
        window.clearTimeout(hideTimer);
        hideVoice();
        setActive(true);
      });

      model.addEventListener(
        'pointermove',
        (event) => {
          if (!pointerDown) return;

          const dx = event.clientX - lastPointerX;
          const dy = event.clientY - lastPointerY;
          dragDistance += Math.hypot(dx, dy);
          lastPointerX = event.clientX;
          lastPointerY = event.clientY;

          if (dragDistance >= 8) startDragTimers();
        },
        { passive: true }
      );

      model.addEventListener('pointerup', finishDrag);
      model.addEventListener('pointercancel', finishDrag);
      window.addEventListener('pointerup', finishDrag, true);
      window.addEventListener('pointercancel', finishDrag, true);
    });
  })();
</script>
