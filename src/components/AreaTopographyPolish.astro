<svg
  class="site-area-free-select"
  data-area-free-select
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path class="site-area-free-select__fill" data-area-free-select-fill />
  <path class="site-area-free-select__stroke" data-area-free-select-path />
</svg>

<style is:global>
  html body .site-area-topography,
  html body .site-area-centroid-symbol,
  html body .site-area-centroid-symbol.is-visible,
  html body .site-area-start {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  html body .site-area-outline,
  html body .site-area-overlay.is-hovering-area .site-area-outline,
  html body .site-area-overlay.is-rotating-area .site-area-outline {
    fill: none !important;
    stroke: transparent !important;
    opacity: 0 !important;
  }

  .site-area-free-select {
    position: fixed;
    inset: 0;
    z-index: 74;
    display: none;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .site-area-free-select.is-visible {
    display: block;
  }

  .site-area-free-select__fill {
    fill: rgba(18, 112, 47, 0.27);
    stroke: none;
    vector-effect: non-scaling-stroke;
  }

  .site-area-free-select__stroke {
    fill: none;
    stroke: rgba(246, 251, 247, 0.98);
    stroke-width: 0.9;
    stroke-dasharray: 2 2.8;
    stroke-linecap: butt;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
    filter:
      drop-shadow(0 0 0.45px rgba(255, 255, 255, 0.98))
      drop-shadow(0 0 0.7px rgba(35, 73, 47, 0.58));
  }

  html body .site-area-selected-object {
    filter:
      brightness(0)
      invert(1)
      drop-shadow(0 0 0.65px rgba(34, 69, 46, 0.82))
      drop-shadow(0 0 1.2px rgba(255, 255, 255, 0.98)) !important;
  }

  html body .site-area-selected-object.hero-secondary,
  html body .site-area-selected-object.hero-primary,
  html body h1.site-area-selected-object,
  html body .site-area-selected-object.hero-location-trigger,
  html body .site-area-selected-object.hero-linkedin {
    text-shadow:
      0 0 0.7px rgba(34, 69, 46, 0.9),
      0 0 1.4px rgba(255, 255, 255, 0.98) !important;
  }

  html body .site-area-hint {
    opacity: 0.62;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-area-free-select,
    html body .site-area-selected-object {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const initialize = () => {
      const selectionSvg = document.querySelector('[data-area-free-select]')
      const selectionFill = document.querySelector('[data-area-free-select-fill]')
      const selectionPath = document.querySelector('[data-area-free-select-path]')
      const overlay = document.querySelector('[data-area-overlay]')
      const nativePath = document.querySelector('[data-area-path]')
      const centroidSymbol = document.querySelector('[data-area-centroid-symbol]')

      if (
        !selectionSvg ||
        !selectionFill ||
        !selectionPath ||
        !overlay ||
        !nativePath ||
        !centroidSymbol
      ) return

      if (selectionSvg.dataset.areaFreeSelectInitialized === 'true') return
      selectionSvg.dataset.areaFreeSelectInitialized = 'true'

      const selectedClass = 'site-area-selected-object'
      const selectionCandidates = Array.from(
        document.querySelectorAll(
          '.hero h1, .hero-primary, .hero-secondary, .hero-location-trigger, .hero-linkedin, .hero-art--interactive [data-morphing-topography], .topbar-name, .language-switch, .linkedin-link'
        )
      )

      let persistentPoints = []
      let syncFrame = 0

      const parsePathPoints = () => {
        const d = nativePath.getAttribute('d') ?? ''
        const values = d.match(/[-+]?(?:\d*\.)?\d+(?:e[-+]?\d+)?/gi)
        if (!values || values.length < 2) return []

        const numbers = values.map(Number).filter(Number.isFinite)
        const points = []

        for (let index = 0; index + 1 < numbers.length; index += 2) {
          points.push({
            x: numbers[index],
            y: numbers[index + 1],
          })
        }

        return points
      }

      const pathFromPoints = (points) => {
        if (!points.length) return ''

        return `${points
          .map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`)
          .join(' ')} Z`
      }

      const pointInPolygon = (point, points) => {
        let inside = false

        for (let index = 0, previous = points.length - 1; index < points.length; previous = index, index += 1) {
          const currentPoint = points[index]
          const previousPoint = points[previous]
          const crosses =
            currentPoint.y > point.y !== previousPoint.y > point.y &&
            point.x <
              ((previousPoint.x - currentPoint.x) * (point.y - currentPoint.y)) /
                (previousPoint.y - currentPoint.y || 0.00001) +
                currentPoint.x

          if (crosses) inside = !inside
        }

        return inside
      }

      const orientation = (a, b, c) =>
        (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)

      const segmentsIntersect = (a, b, c, d) => {
        const abC = orientation(a, b, c)
        const abD = orientation(a, b, d)
        const cdA = orientation(c, d, a)
        const cdB = orientation(c, d, b)
        return abC * abD <= 0 && cdA * cdB <= 0
      }

      const polygonIntersectsRect = (points, rect) => {
        if (points.length < 3 || rect.width <= 0 || rect.height <= 0) return false

        const corners = [
          { x: rect.left, y: rect.top },
          { x: rect.right, y: rect.top },
          { x: rect.right, y: rect.bottom },
          { x: rect.left, y: rect.bottom },
        ]

        if (corners.some((corner) => pointInPolygon(corner, points))) return true

        if (
          points.some(
            (point) =>
              point.x >= rect.left &&
              point.x <= rect.right &&
              point.y >= rect.top &&
              point.y <= rect.bottom
          )
        ) return true

        const rectEdges = [
          [corners[0], corners[1]],
          [corners[1], corners[2]],
          [corners[2], corners[3]],
          [corners[3], corners[0]],
        ]

        for (let index = 0; index < points.length; index += 1) {
          const start = points[index]
          const end = points[(index + 1) % points.length]

          for (const [rectStart, rectEnd] of rectEdges) {
            if (segmentsIntersect(start, end, rectStart, rectEnd)) return true
          }
        }

        return false
      }

      const clearSelectedObjects = () => {
        selectionCandidates.forEach((element) => {
          element.classList.remove(selectedClass)
        })
      }

      const updateSelectedObjects = (points) => {
        selectionCandidates.forEach((element) => {
          const rect = element.getBoundingClientRect()
          element.classList.toggle(selectedClass, polygonIntersectsRect(points, rect))
        })
      }

      const hide = () => {
        selectionSvg.classList.remove('is-visible')
        selectionFill.setAttribute('d', '')
        selectionPath.setAttribute('d', '')
        clearSelectedObjects()
      }

      const render = (points) => {
        if (!overlay.classList.contains('is-visible') || points.length < 3) {
          hide()
          return
        }

        const path = pathFromPoints(points)

        selectionSvg.setAttribute('viewBox', `0 0 ${window.innerWidth} ${window.innerHeight}`)
        selectionFill.setAttribute('d', path)
        selectionPath.setAttribute('d', path)
        selectionSvg.classList.add('is-visible')
        updateSelectedObjects(points)
      }

      const sync = () => {
        syncFrame = 0

        if (!overlay.classList.contains('is-visible')) {
          persistentPoints = []
          hide()
          return
        }

        const d = nativePath.getAttribute('d') ?? ''
        const points = parsePathPoints()
        const finished = centroidSymbol.classList.contains('is-visible')

        if (finished && points.length >= 3) {
          persistentPoints = points.map((point) => ({ ...point }))
          render(persistentPoints)
          return
        }

        if (d.trim()) {
          persistentPoints = []
          render(points)
          return
        }

        if (persistentPoints.length >= 3) {
          render(persistentPoints)
          return
        }

        hide()
      }

      const scheduleSync = () => {
        if (syncFrame) return
        syncFrame = window.requestAnimationFrame(sync)
      }

      const observer = new MutationObserver(scheduleSync)

      observer.observe(nativePath, {
        attributes: true,
        attributeFilter: ['d'],
      })

      observer.observe(centroidSymbol, {
        attributes: true,
        attributeFilter: ['class'],
      })

      observer.observe(overlay, {
        attributes: true,
        attributeFilter: ['class'],
      })

      const handleResize = () => {
        selectionSvg.setAttribute('viewBox', `0 0 ${window.innerWidth} ${window.innerHeight}`)
        scheduleSync()
      }

      window.addEventListener('resize', handleResize, { passive: true })
      scheduleSync()

      window.addEventListener(
        'pagehide',
        () => {
          observer.disconnect()
          window.removeEventListener('resize', handleResize)
          if (syncFrame) window.cancelAnimationFrame(syncFrame)
          persistentPoints = []
          hide()
        },
        { once: true }
      )
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize, { once: true })
    } else {
      initialize()
    }
  })()
</script>
