---
import MorphingTopography from './MorphingTopography.astro';
---

<div class="site-area-live-topography" data-area-live-topography aria-hidden="true">
  <MorphingTopography
    class="site-area-live-topography__graphic"
    autoRotate={false}
    morph={true}
    showContours={true}
    enableZoom={false}
  />
</div>

<style is:global>
  html body .site-area-topography {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  html body .site-area-outline {
    fill: none !important;
    stroke: var(--moss-deep) !important;
    stroke-width: 0.72px !important;
    opacity: 0.42 !important;
  }

  html body .site-area-overlay.is-hovering-area .site-area-outline,
  html body .site-area-overlay.is-rotating-area .site-area-outline {
    fill: none !important;
    stroke-width: 0.86px !important;
    opacity: 0.62 !important;
  }

  html body .site-area-centroid-symbol {
    opacity: 0 !important;
  }

  html body .site-area-centroid-symbol.is-visible {
    opacity: 0.58 !important;
  }

  html body .site-area-centroid-symbol line,
  html body .site-area-centroid-ring {
    stroke-width: 0.76px !important;
  }

  html body .site-area-centroid-ring {
    fill: rgba(255, 255, 255, 0.66) !important;
  }

  html body .site-area-centroid-dot {
    r: 1.05px !important;
  }

  .site-area-live-topography {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 72;
    display: none;
    width: 1px;
    height: 1px;
    pointer-events: none;
    overflow: hidden;
    opacity: 0;
    background: transparent;
    transform: translateZ(0);
  }

  .site-area-live-topography.is-visible {
    display: block;
    opacity: 1;
  }

  html body .site-area-live-topography__graphic {
    position: absolute !important;
    left: -18% !important;
    top: -18% !important;
    width: 136% !important;
    height: 136% !important;
    min-height: 0 !important;
    margin: 0 !important;
    overflow: hidden !important;
    pointer-events: none !important;
    cursor: default !important;
  }

  html body .site-area-live-topography__graphic canvas {
    width: 100% !important;
    height: 100% !important;
    pointer-events: none !important;
    touch-action: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-area-live-topography {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const initialize = () => {
      const liveTopography = document.querySelector('[data-area-live-topography]')
      const overlay = document.querySelector('[data-area-overlay]')
      const outline = document.querySelector('[data-area-path]')
      const centroidSymbol = document.querySelector('[data-area-centroid-symbol]')

      if (!liveTopography || !overlay || !outline || !centroidSymbol) return
      if (liveTopography.dataset.areaLiveTopographyInitialized === 'true') return
      liveTopography.dataset.areaLiveTopographyInitialized = 'true'

      let updateFrame = 0

      const hide = () => {
        liveTopography.classList.remove('is-visible')
        liveTopography.style.removeProperty('clip-path')
        liveTopography.style.removeProperty('-webkit-clip-path')
      }

      const parsePathPoints = () => {
        const d = outline.getAttribute('d') ?? ''
        const values = d.match(/[-+]?(?:\d*\.)?\d+(?:e[-+]?\d+)?/gi)

        if (!values || values.length < 6) return []

        const numbers = values.map(Number).filter(Number.isFinite)
        const points = []

        for (let index = 0; index + 1 < numbers.length; index += 2) {
          points.push({
            x: numbers[index],
            y: numbers[index + 1],
          })
        }

        return points
      }

      const sync = () => {
        updateFrame = 0

        const finished = centroidSymbol.classList.contains('is-visible')
        const areaModeVisible = overlay.classList.contains('is-visible')
        const points = parsePathPoints()

        if (!finished || !areaModeVisible || points.length < 3) {
          hide()
          return
        }

        const xs = points.map((point) => point.x)
        const ys = points.map((point) => point.y)
        const minX = Math.min(...xs)
        const maxX = Math.max(...xs)
        const minY = Math.min(...ys)
        const maxY = Math.max(...ys)
        const width = Math.max(1, maxX - minX)
        const height = Math.max(1, maxY - minY)

        const polygon = points
          .map((point) => {
            const x = ((point.x - minX) / width) * 100
            const y = ((point.y - minY) / height) * 100
            return `${x.toFixed(3)}% ${y.toFixed(3)}%`
          })
          .join(', ')

        liveTopography.style.left = `${minX}px`
        liveTopography.style.top = `${minY}px`
        liveTopography.style.width = `${width}px`
        liveTopography.style.height = `${height}px`
        liveTopography.style.clipPath = `polygon(${polygon})`
        liveTopography.style.webkitClipPath = `polygon(${polygon})`
        liveTopography.classList.add('is-visible')
      }

      const scheduleSync = () => {
        if (updateFrame) return
        updateFrame = window.requestAnimationFrame(sync)
      }

      const observer = new MutationObserver(scheduleSync)

      observer.observe(outline, {
        attributes: true,
        attributeFilter: ['d'],
      })

      observer.observe(centroidSymbol, {
        attributes: true,
        attributeFilter: ['class'],
      })

      observer.observe(overlay, {
        attributes: true,
        attributeFilter: ['class'],
      })

      window.addEventListener('resize', scheduleSync, { passive: true })
      scheduleSync()

      window.addEventListener(
        'pagehide',
        () => {
          observer.disconnect()
          if (updateFrame) window.cancelAnimationFrame(updateFrame)
          window.removeEventListener('resize', scheduleSync)
          hide()
        },
        { once: true }
      )
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize, { once: true })
    } else {
      initialize()
    }
  })()
</script>
