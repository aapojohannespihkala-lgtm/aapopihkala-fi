<svg
  class="site-area-free-select"
  data-area-free-select
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path class="site-area-free-select__contrast" data-area-free-select-contrast />
  <path class="site-area-free-select__fill" data-area-free-select-fill />
  <path class="site-area-free-select__stroke" data-area-free-select-path />
</svg>

<style is:global>
  html body .site-area-topography,
  html body .site-area-centroid-symbol,
  html body .site-area-centroid-symbol.is-visible,
  html body .site-area-start {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  html body .site-area-outline,
  html body .site-area-overlay.is-hovering-area .site-area-outline,
  html body .site-area-overlay.is-rotating-area .site-area-outline {
    fill: none !important;
    stroke: transparent !important;
    opacity: 0 !important;
  }

  .site-area-free-select {
    position: fixed;
    inset: 0;
    z-index: 74;
    display: none;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .site-area-free-select.is-visible {
    display: block;
  }

  .site-area-free-select__contrast {
    fill: rgb(255, 255, 255);
    stroke: none;
    mix-blend-mode: difference;
    vector-effect: non-scaling-stroke;
  }

  .site-area-free-select__fill {
    fill: rgba(18, 112, 47, 0.34);
    stroke: none;
    vector-effect: non-scaling-stroke;
  }

  .site-area-free-select__stroke {
    fill: none;
    stroke: rgba(248, 252, 249, 0.98);
    stroke-width: 0.9;
    stroke-dasharray: 2 2.8;
    stroke-linecap: butt;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
    filter:
      drop-shadow(0 0 0.45px rgba(255, 255, 255, 0.96))
      drop-shadow(0 0 0.7px rgba(35, 73, 47, 0.58));
  }

  html body .site-area-hint {
    opacity: 0.62;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-area-free-select {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const initialize = () => {
      const selectionSvg = document.querySelector('[data-area-free-select]')
      const selectionContrast = document.querySelector('[data-area-free-select-contrast]')
      const selectionFill = document.querySelector('[data-area-free-select-fill]')
      const selectionPath = document.querySelector('[data-area-free-select-path]')
      const overlay = document.querySelector('[data-area-overlay]')
      const nativePath = document.querySelector('[data-area-path]')
      const centroidSymbol = document.querySelector('[data-area-centroid-symbol]')

      if (
        !selectionSvg ||
        !selectionContrast ||
        !selectionFill ||
        !selectionPath ||
        !overlay ||
        !nativePath ||
        !centroidSymbol
      ) return

      if (selectionSvg.dataset.areaFreeSelectInitialized === 'true') return
      selectionSvg.dataset.areaFreeSelectInitialized = 'true'

      let persistentPoints = []
      let syncFrame = 0

      const parsePathPoints = () => {
        const d = nativePath.getAttribute('d') ?? ''
        const values = d.match(/[-+]?(?:\d*\.)?\d+(?:e[-+]?\d+)?/gi)
        if (!values || values.length < 2) return []

        const numbers = values.map(Number).filter(Number.isFinite)
        const points = []

        for (let index = 0; index + 1 < numbers.length; index += 2) {
          points.push({
            x: numbers[index],
            y: numbers[index + 1],
          })
        }

        return points
      }

      const pathFromPoints = (points) => {
        if (!points.length) return ''

        return `${points
          .map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`)
          .join(' ')} Z`
      }

      const hide = () => {
        selectionSvg.classList.remove('is-visible')
        selectionContrast.setAttribute('d', '')
        selectionFill.setAttribute('d', '')
        selectionPath.setAttribute('d', '')
      }

      const render = (points) => {
        if (!overlay.classList.contains('is-visible') || points.length < 3) {
          hide()
          return
        }

        const path = pathFromPoints(points)

        selectionSvg.setAttribute('viewBox', `0 0 ${window.innerWidth} ${window.innerHeight}`)
        selectionContrast.setAttribute('d', path)
        selectionFill.setAttribute('d', path)
        selectionPath.setAttribute('d', path)
        selectionSvg.classList.add('is-visible')
      }

      const sync = () => {
        syncFrame = 0

        if (!overlay.classList.contains('is-visible')) {
          persistentPoints = []
          hide()
          return
        }

        const d = nativePath.getAttribute('d') ?? ''
        const points = parsePathPoints()
        const finished = centroidSymbol.classList.contains('is-visible')

        if (finished && points.length >= 3) {
          persistentPoints = points.map((point) => ({ ...point }))
          render(persistentPoints)
          return
        }

        if (d.trim()) {
          persistentPoints = []
          render(points)
          return
        }

        if (persistentPoints.length >= 3) {
          render(persistentPoints)
          return
        }

        hide()
      }

      const scheduleSync = () => {
        if (syncFrame) return
        syncFrame = window.requestAnimationFrame(sync)
      }

      const observer = new MutationObserver(scheduleSync)

      observer.observe(nativePath, {
        attributes: true,
        attributeFilter: ['d'],
      })

      observer.observe(centroidSymbol, {
        attributes: true,
        attributeFilter: ['class'],
      })

      observer.observe(overlay, {
        attributes: true,
        attributeFilter: ['class'],
      })

      const handleResize = () => {
        selectionSvg.setAttribute('viewBox', `0 0 ${window.innerWidth} ${window.innerHeight}`)
        scheduleSync()
      }

      window.addEventListener('resize', handleResize, { passive: true })
      scheduleSync()

      window.addEventListener(
        'pagehide',
        () => {
          observer.disconnect()
          window.removeEventListener('resize', handleResize)
          if (syncFrame) window.cancelAnimationFrame(syncFrame)
          persistentPoints = []
          hide()
        },
        { once: true }
      )
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize, { once: true })
    } else {
      initialize()
    }
  })()
</script>
