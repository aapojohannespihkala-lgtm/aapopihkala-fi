<div
  class="site-area-free-select"
  data-area-free-select
  aria-hidden="true"
></div>

<svg
  class="site-area-free-select-outline"
  data-area-free-select-outline
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path data-area-free-select-path />
</svg>

<style is:global>
  html body .site-area-topography,
  html body .site-area-centroid-symbol,
  html body .site-area-centroid-symbol.is-visible,
  html body .site-area-start {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  html body .site-area-outline,
  html body .site-area-overlay.is-hovering-area .site-area-outline,
  html body .site-area-overlay.is-rotating-area .site-area-outline {
    fill: none !important;
    stroke: transparent !important;
    opacity: 0 !important;
  }

  .site-area-free-select {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 72;
    display: none;
    width: 1px;
    height: 1px;
    pointer-events: none;
    overflow: hidden;
    background: rgba(18, 112, 47, 0.26);
    -webkit-backdrop-filter:
      grayscale(0.18)
      sepia(0.28)
      saturate(1.5)
      hue-rotate(56deg)
      contrast(1.045);
    backdrop-filter:
      grayscale(0.18)
      sepia(0.28)
      saturate(1.5)
      hue-rotate(56deg)
      contrast(1.045);
  }

  .site-area-free-select::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: rgba(12, 91, 38, 0.08);
  }

  .site-area-free-select.is-visible {
    display: block;
  }

  .site-area-free-select-outline {
    position: fixed;
    inset: 0;
    z-index: 74;
    display: none;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .site-area-free-select-outline.is-visible {
    display: block;
  }

  .site-area-free-select-outline path {
    fill: none;
    stroke: rgba(242, 248, 243, 0.96);
    stroke-width: 0.9;
    stroke-dasharray: 2.2 3.1;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 0.55px rgba(45, 78, 55, 0.78));
  }

  html body .site-area-hint {
    opacity: 0.62;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-area-free-select,
    .site-area-free-select-outline {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const initialize = () => {
      const selection = document.querySelector('[data-area-free-select]')
      const selectionSvg = document.querySelector('[data-area-free-select-outline]')
      const selectionPath = document.querySelector('[data-area-free-select-path]')
      const overlay = document.querySelector('[data-area-overlay]')
      const nativePath = document.querySelector('[data-area-path]')
      const centroidSymbol = document.querySelector('[data-area-centroid-symbol]')

      if (
        !selection ||
        !selectionSvg ||
        !selectionPath ||
        !overlay ||
        !nativePath ||
        !centroidSymbol
      ) return

      if (selection.dataset.areaFreeSelectInitialized === 'true') return
      selection.dataset.areaFreeSelectInitialized = 'true'

      let persistentPoints = []
      let syncFrame = 0
      let resettingNativeArea = false

      const parsePathPoints = () => {
        const d = nativePath.getAttribute('d') ?? ''
        const values = d.match(/[-+]?(?:\d*\.)?\d+(?:e[-+]?\d+)?/gi)
        if (!values || values.length < 2) return []

        const numbers = values.map(Number).filter(Number.isFinite)
        const points = []

        for (let index = 0; index + 1 < numbers.length; index += 2) {
          points.push({
            x: numbers[index],
            y: numbers[index + 1],
          })
        }

        return points
      }

      const pathFromPoints = (points) => {
        if (!points.length) return ''

        return `${points
          .map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`)
          .join(' ')} Z`
      }

      const hide = () => {
        selection.classList.remove('is-visible')
        selectionSvg.classList.remove('is-visible')
        selection.style.removeProperty('clip-path')
        selection.style.removeProperty('-webkit-clip-path')
        selectionPath.setAttribute('d', '')
      }

      const render = (points) => {
        if (!overlay.classList.contains('is-visible') || points.length < 3) {
          hide()
          return
        }

        const xs = points.map((point) => point.x)
        const ys = points.map((point) => point.y)
        const minX = Math.min(...xs)
        const maxX = Math.max(...xs)
        const minY = Math.min(...ys)
        const maxY = Math.max(...ys)
        const width = Math.max(1, maxX - minX)
        const height = Math.max(1, maxY - minY)
        const localPoints = points.map((point) => ({
          x: point.x - minX,
          y: point.y - minY,
        }))

        const polygonCss = localPoints
          .map((point) => {
            const x = (point.x / width) * 100
            const y = (point.y / height) * 100
            return `${x.toFixed(3)}% ${y.toFixed(3)}%`
          })
          .join(', ')

        selection.style.left = `${minX}px`
        selection.style.top = `${minY}px`
        selection.style.width = `${width}px`
        selection.style.height = `${height}px`
        selection.style.clipPath = `polygon(${polygonCss})`
        selection.style.webkitClipPath = `polygon(${polygonCss})`
        selection.classList.add('is-visible')

        selectionSvg.setAttribute('viewBox', `0 0 ${window.innerWidth} ${window.innerHeight}`)
        selectionPath.setAttribute('d', pathFromPoints(points))
        selectionSvg.classList.add('is-visible')
      }

      const clearNativeFinishedArea = () => {
        if (resettingNativeArea) return
        resettingNativeArea = true

        window.dispatchEvent(new Event('resize'))

        resettingNativeArea = false
      }

      const sync = () => {
        syncFrame = 0

        if (!overlay.classList.contains('is-visible')) {
          persistentPoints = []
          hide()
          return
        }

        const d = nativePath.getAttribute('d') ?? ''
        const points = parsePathPoints()
        const finished = centroidSymbol.classList.contains('is-visible')

        if (finished && points.length >= 3) {
          persistentPoints = points.map((point) => ({ ...point }))
          render(persistentPoints)
          window.requestAnimationFrame(clearNativeFinishedArea)
          return
        }

        if (d.trim()) {
          persistentPoints = []
          render(points)
          return
        }

        if (persistentPoints.length >= 3) {
          render(persistentPoints)
          return
        }

        hide()
      }

      const scheduleSync = () => {
        if (syncFrame) return
        syncFrame = window.requestAnimationFrame(sync)
      }

      const observer = new MutationObserver(scheduleSync)

      observer.observe(nativePath, {
        attributes: true,
        attributeFilter: ['d'],
      })

      observer.observe(centroidSymbol, {
        attributes: true,
        attributeFilter: ['class'],
      })

      observer.observe(overlay, {
        attributes: true,
        attributeFilter: ['class'],
      })

      const handleResize = () => {
        if (resettingNativeArea) return
        persistentPoints = []
        hide()
        scheduleSync()
      }

      window.addEventListener('resize', handleResize, { passive: true })
      scheduleSync()

      window.addEventListener(
        'pagehide',
        () => {
          observer.disconnect()
          window.removeEventListener('resize', handleResize)
          if (syncFrame) window.cancelAnimationFrame(syncFrame)
          persistentPoints = []
          hide()
        },
        { once: true }
      )
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize, { once: true })
    } else {
      initialize()
    }
  })()
</script>
