<div class="site-area-island" data-area-island aria-hidden="true">
  <canvas class="site-area-island__canvas" data-area-island-canvas></canvas>
</div>

<style is:global>
  html body .site-area-topography {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  html body .site-area-outline {
    fill: none !important;
    stroke: rgba(96, 128, 148, 0.92) !important;
    stroke-width: 0.76px !important;
    opacity: 0.62 !important;
  }

  html body .site-area-overlay.is-hovering-area .site-area-outline,
  html body .site-area-overlay.is-rotating-area .site-area-outline {
    fill: none !important;
    stroke: rgba(86, 119, 140, 0.96) !important;
    stroke-width: 0.9px !important;
    opacity: 0.78 !important;
  }

  html body .site-area-centroid-symbol {
    opacity: 0 !important;
  }

  html body .site-area-centroid-symbol.is-visible {
    opacity: 0.42 !important;
  }

  html body .site-area-centroid-symbol line,
  html body .site-area-centroid-ring {
    stroke-width: 0.68px !important;
  }

  html body .site-area-centroid-ring {
    fill: rgba(255, 255, 255, 0.54) !important;
  }

  .site-area-island {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 72;
    display: none;
    width: 1px;
    height: 1px;
    pointer-events: none;
    overflow: hidden;
    opacity: 0;
    background: transparent;
    transform: translateZ(0);
  }

  .site-area-island.is-visible {
    display: block;
    opacity: 1;
  }

  .site-area-island__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-area-island {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const initialize = () => {
      const island = document.querySelector('[data-area-island]')
      const canvas = document.querySelector('[data-area-island-canvas]')
      const overlay = document.querySelector('[data-area-overlay]')
      const outline = document.querySelector('[data-area-path]')
      const centroidSymbol = document.querySelector('[data-area-centroid-symbol]')

      if (!island || !canvas || !overlay || !outline || !centroidSymbol) return
      if (island.dataset.areaIslandInitialized === 'true') return
      island.dataset.areaIslandInitialized = 'true'

      const context = canvas.getContext('2d')
      if (!context) return

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      let polygon = []
      let width = 1
      let height = 1
      let columns = 0
      let rows = 0
      let insideMask = []
      let shoreField = []
      let heights = []
      let visible = false
      let islandSeed = 0
      let syncFrame = 0
      let animationFrame = 0
      let lastDrawAt = -Infinity
      let wasFinished = false
      let documentVisible = !document.hidden

      const clamp = (value, minimum, maximum) =>
        Math.max(minimum, Math.min(maximum, value))

      const lerp = (start, end, amount) => start + (end - start) * amount

      const paletteStops = [
        { at: 0, rgb: [112, 143, 164] },
        { at: 0.3, rgb: [116, 151, 148] },
        { at: 0.58, rgb: [153, 160, 121] },
        { at: 0.8, rgb: [174, 149, 96] },
        { at: 1, rgb: [188, 129, 78] },
      ]

      const terrainColor = (value, alpha = 1, darken = 0) => {
        const t = clamp(value, 0, 1)
        let start = paletteStops[0]
        let end = paletteStops[paletteStops.length - 1]

        for (let index = 0; index < paletteStops.length - 1; index += 1) {
          const current = paletteStops[index]
          const next = paletteStops[index + 1]

          if (t >= current.at && t <= next.at) {
            start = current
            end = next
            break
          }
        }

        const span = Math.max(0.0001, end.at - start.at)
        const local = clamp((t - start.at) / span, 0, 1)
        const factor = 1 - darken
        const red = Math.round(lerp(start.rgb[0], end.rgb[0], local) * factor)
        const green = Math.round(lerp(start.rgb[1], end.rgb[1], local) * factor)
        const blue = Math.round(lerp(start.rgb[2], end.rgb[2], local) * factor)

        return `rgba(${red}, ${green}, ${blue}, ${alpha})`
      }

      const terrainTone = (terrainHeight, shore) =>
        clamp(shore * 0.64 + terrainHeight * 0.36, 0, 1)

      const parsePathPoints = () => {
        const d = outline.getAttribute('d') ?? ''
        const values = d.match(/[-+]?(?:\d*\.)?\d+(?:e[-+]?\d+)?/gi)
        if (!values || values.length < 6) return []

        const numbers = values.map(Number).filter(Number.isFinite)
        const points = []

        for (let index = 0; index + 1 < numbers.length; index += 2) {
          points.push({
            x: numbers[index],
            y: numbers[index + 1],
          })
        }

        return points
      }

      const pointInPolygon = (point, points) => {
        let inside = false

        for (let i = 0, j = points.length - 1; i < points.length; j = i, i += 1) {
          const current = points[i]
          const previous = points[j]
          const crosses =
            current.y > point.y !== previous.y > point.y &&
            point.x <
              ((previous.x - current.x) * (point.y - current.y)) /
                (previous.y - current.y || 0.00001) +
                current.x

          if (crosses) inside = !inside
        }

        return inside
      }

      const distanceToSegment = (point, start, end) => {
        const dx = end.x - start.x
        const dy = end.y - start.y

        if (dx === 0 && dy === 0) {
          return Math.hypot(point.x - start.x, point.y - start.y)
        }

        const amount = clamp(
          ((point.x - start.x) * dx + (point.y - start.y) * dy) /
            (dx * dx + dy * dy),
          0,
          1
        )

        const projection = {
          x: start.x + dx * amount,
          y: start.y + dy * amount,
        }

        return Math.hypot(point.x - projection.x, point.y - projection.y)
      }

      const distanceToPolygonEdge = (point, points) => {
        let minimum = Infinity

        for (let index = 0; index < points.length; index += 1) {
          minimum = Math.min(
            minimum,
            distanceToSegment(point, points[index], points[(index + 1) % points.length])
          )
        }

        return minimum
      }

      const polygonArea = (points) => {
        let sum = 0

        for (let index = 0; index < points.length; index += 1) {
          const current = points[index]
          const next = points[(index + 1) % points.length]
          sum += current.x * next.y - next.x * current.y
        }

        return Math.abs(sum) * 0.5
      }

      const createPolygonPath = () => {
        const path = new Path2D()
        if (!polygon.length) return path

        path.moveTo(polygon[0].x, polygon[0].y)

        for (let index = 1; index < polygon.length; index += 1) {
          path.lineTo(polygon[index].x, polygon[index].y)
        }

        path.closePath()
        return path
      }

      const broadRelief = (x, y, phase) => {
        const angle = 0.55 + Math.sin(islandSeed * 0.73) * 0.28
        const cos = Math.cos(angle)
        const sin = Math.sin(angle)
        const rx = x * cos - y * sin
        const ry = x * sin + y * cos

        const ridge =
          0.16 * Math.exp(-((rx + 0.16) ** 2 * 3.2 + (ry - 0.02) ** 2 * 1.5))

        const shoulder =
          0.11 * Math.exp(-((x - 0.34) ** 2 * 5.8 + (y + 0.23) ** 2 * 4.1))

        const secondKnoll =
          0.075 * Math.exp(-((x + 0.42) ** 2 * 6.8 + (y - 0.28) ** 2 * 5.2))

        const saddle =
          -0.075 * Math.exp(-((x - 0.03) ** 2 * 8.2 + (y - 0.12) ** 2 * 7.2))

        const waves =
          0.062 * Math.sin(x * 2.45 + y * 0.92 + islandSeed + phase * 0.18) +
          0.044 * Math.cos(y * 2.9 - x * 0.72 + islandSeed * 0.63 - phase * 0.13) +
          0.026 * Math.sin((x + y) * 3.65 + islandSeed * 0.31 + phase * 0.11)

        return ridge + shoulder + secondKnoll + saddle + waves
      }

      const buildBaseField = () => {
        columns = clamp(Math.round(width / 7.2), 40, 92)
        rows = clamp(Math.round(height / 7.2), 36, 86)

        insideMask = Array.from({ length: rows + 1 }, () => Array(columns + 1).fill(false))
        shoreField = Array.from({ length: rows + 1 }, () => Array(columns + 1).fill(0))
        heights = Array.from({ length: rows + 1 }, () => Array(columns + 1).fill(0))

        let maximumDistance = 0

        for (let row = 0; row <= rows; row += 1) {
          const y = (row / rows) * height

          for (let column = 0; column <= columns; column += 1) {
            const x = (column / columns) * width
            const point = { x, y }
            const inside = pointInPolygon(point, polygon)

            insideMask[row][column] = inside
            if (!inside) continue

            const distance = distanceToPolygonEdge(point, polygon)
            shoreField[row][column] = distance
            maximumDistance = Math.max(maximumDistance, distance)
          }
        }

        maximumDistance = Math.max(0.0001, maximumDistance)

        for (let row = 0; row <= rows; row += 1) {
          for (let column = 0; column <= columns; column += 1) {
            if (!insideMask[row][column]) continue
            shoreField[row][column] = clamp(shoreField[row][column] / maximumDistance, 0, 1)
          }
        }
      }

      const updateHeights = (phase) => {
        let maximumHeight = 0

        for (let row = 0; row <= rows; row += 1) {
          const ny = (row / rows) * 2 - 1

          for (let column = 0; column <= columns; column += 1) {
            if (!insideMask[row][column]) {
              heights[row][column] = 0
              continue
            }

            const nx = (column / columns) * 2 - 1
            const shore = shoreField[row][column]
            const baseRise = Math.pow(shore, 0.82)
            const irregularity = broadRelief(nx, ny, phase)
            const heightValue = Math.max(0, baseRise * (0.8 + irregularity))

            heights[row][column] = heightValue
            maximumHeight = Math.max(maximumHeight, heightValue)
          }
        }

        maximumHeight = Math.max(0.0001, maximumHeight)

        for (let row = 0; row <= rows; row += 1) {
          for (let column = 0; column <= columns; column += 1) {
            if (!insideMask[row][column]) continue
            heights[row][column] = clamp(heights[row][column] / maximumHeight, 0, 1)
          }
        }
      }

      const drawValueWash = () => {
        const stepX = width / columns
        const stepY = height / rows
        const bandCount = 16
        const bands = Array.from({ length: bandCount }, () => [])

        for (let row = 0; row <= rows; row += 1) {
          const y = (row / rows) * height

          for (let column = 0; column <= columns; column += 1) {
            if (!insideMask[row][column]) continue

            const x = (column / columns) * width
            const tone = terrainTone(heights[row][column], shoreField[row][column])
            const band = clamp(Math.round(tone * (bandCount - 1)), 0, bandCount - 1)

            bands[band].push({
              x: x - stepX * 0.58,
              y: y - stepY * 0.58,
              width: stepX * 1.16,
              height: stepY * 1.16,
            })
          }
        }

        context.save()

        bands.forEach((cells, bandIndex) => {
          if (!cells.length) return

          const tone = bandIndex / Math.max(1, bandCount - 1)
          context.fillStyle = terrainColor(tone, 0.26 + tone * 0.1)

          cells.forEach((cell) => {
            context.fillRect(cell.x, cell.y, cell.width, cell.height)
          })
        })

        context.restore()
      }

      const drawPointCloud = (lift) => {
        const stepX = width / columns
        const stepY = height / rows
        const radius = clamp(Math.min(stepX, stepY) * 0.09, 0.5, 0.92)
        const bandCount = 12
        const bands = Array.from({ length: bandCount }, () => [])

        for (let row = 0; row <= rows; row += 1) {
          const baseY = (row / rows) * height

          for (let column = 0; column <= columns; column += 1) {
            if (!insideMask[row][column]) continue

            const baseX = (column / columns) * width
            const terrainHeight = heights[row][column]
            const shore = shoreField[row][column]
            const tone = terrainTone(terrainHeight, shore)
            const band = clamp(Math.round(tone * (bandCount - 1)), 0, bandCount - 1)
            const jitter = Math.sin((column + 1) * 19.71 + (row + 1) * 7.37 + islandSeed) * 0.32
            const x = baseX + jitter
            const y = baseY - terrainHeight * lift
            const dotRadius = radius * (0.9 + terrainHeight * 0.3)

            bands[band].push({ x, y, radius: dotRadius })
          }
        }

        context.save()

        bands.forEach((points, bandIndex) => {
          if (!points.length) return

          const tone = bandIndex / Math.max(1, bandCount - 1)
          const alpha = 0.62 + tone * 0.14
          context.fillStyle = terrainColor(tone, alpha, 0.04)
          context.beginPath()

          points.forEach((point) => {
            context.moveTo(point.x + point.radius, point.y)
            context.arc(point.x, point.y, point.radius, 0, Math.PI * 2)
          })

          context.fill()
        })

        context.restore()
      }

      const interpolateContour = (level, a, b, heightA, heightB) => {
        const delta = heightB - heightA
        const amount = Math.abs(delta) < 0.000001 ? 0.5 : (level - heightA) / delta

        return {
          x: a.x + (b.x - a.x) * amount,
          y: a.y + (b.y - a.y) * amount,
        }
      }

      const drawContours = (lift) => {
        const stepX = width / columns
        const stepY = height / rows
        const levels = [0.08, 0.16, 0.24, 0.32, 0.4, 0.48, 0.56, 0.64, 0.72, 0.8, 0.88]

        levels.forEach((level, levelIndex) => {
          context.save()
          context.beginPath()
          context.lineCap = 'round'
          context.lineJoin = 'round'
          context.lineWidth = levelIndex % 3 === 0 ? 0.94 : 0.66
          context.strokeStyle = terrainColor(
            level,
            levelIndex % 3 === 0 ? 0.82 : 0.56,
            levelIndex % 3 === 0 ? 0.2 : 0.12
          )

          const addSegment = (a, b) => {
            context.moveTo(a.x, a.y - level * lift)
            context.lineTo(b.x, b.y - level * lift)
          }

          for (let row = 0; row < rows; row += 1) {
            const y0 = row * stepY
            const y1 = y0 + stepY

            for (let column = 0; column < columns; column += 1) {
              if (
                !insideMask[row][column] ||
                !insideMask[row][column + 1] ||
                !insideMask[row + 1][column + 1] ||
                !insideMask[row + 1][column]
              ) {
                continue
              }

              const x0 = column * stepX
              const x1 = x0 + stepX
              const h0 = heights[row][column]
              const h1 = heights[row][column + 1]
              const h2 = heights[row + 1][column + 1]
              const h3 = heights[row + 1][column]
              const p0 = { x: x0, y: y0 }
              const p1 = { x: x1, y: y0 }
              const p2 = { x: x1, y: y1 }
              const p3 = { x: x0, y: y1 }
              const hits = []

              if ((h0 < level) !== (h1 < level)) {
                hits.push(interpolateContour(level, p0, p1, h0, h1))
              }

              if ((h1 < level) !== (h2 < level)) {
                hits.push(interpolateContour(level, p1, p2, h1, h2))
              }

              if ((h2 < level) !== (h3 < level)) {
                hits.push(interpolateContour(level, p2, p3, h2, h3))
              }

              if ((h3 < level) !== (h0 < level)) {
                hits.push(interpolateContour(level, p3, p0, h3, h0))
              }

              if (hits.length === 2) {
                addSegment(hits[0], hits[1])
              } else if (hits.length === 4) {
                const center = (h0 + h1 + h2 + h3) * 0.25

                if (center >= level) {
                  addSegment(hits[0], hits[3])
                  addSegment(hits[1], hits[2])
                } else {
                  addSegment(hits[0], hits[1])
                  addSegment(hits[2], hits[3])
                }
              }
            }
          }

          context.stroke()
          context.restore()
        })
      }

      const draw = (phase = 0) => {
        if (!visible || !polygon.length || !columns || !rows) return

        updateHeights(phase)

        const dpr = Math.min(window.devicePixelRatio || 1, 1.6)
        const pixelWidth = Math.max(1, Math.round(width * dpr))
        const pixelHeight = Math.max(1, Math.round(height * dpr))

        if (canvas.width !== pixelWidth || canvas.height !== pixelHeight) {
          canvas.width = pixelWidth
          canvas.height = pixelHeight
        }

        context.setTransform(dpr, 0, 0, dpr, 0, 0)
        context.clearRect(0, 0, width, height)

        const polygonPath = createPolygonPath()
        context.save()
        context.clip(polygonPath)

        const lift = clamp(Math.min(width, height) * 0.095, 10, 34)
        drawValueWash()
        drawPointCloud(lift)
        drawContours(lift)

        context.restore()
      }

      const hide = () => {
        visible = false
        wasFinished = false
        island.classList.remove('is-visible')
        island.style.removeProperty('clip-path')
        island.style.removeProperty('-webkit-clip-path')
        context.clearRect(0, 0, canvas.width, canvas.height)
      }

      const sync = () => {
        syncFrame = 0

        const finished = centroidSymbol.classList.contains('is-visible')
        const areaModeVisible = overlay.classList.contains('is-visible')
        const points = parsePathPoints()

        if (!finished || !areaModeVisible || points.length < 3) {
          hide()
          return
        }

        const xs = points.map((point) => point.x)
        const ys = points.map((point) => point.y)
        const minX = Math.min(...xs)
        const maxX = Math.max(...xs)
        const minY = Math.min(...ys)
        const maxY = Math.max(...ys)

        width = Math.max(1, maxX - minX)
        height = Math.max(1, maxY - minY)

        polygon = points.map((point) => ({
          x: point.x - minX,
          y: point.y - minY,
        }))

        if (!wasFinished) {
          const area = polygonArea(polygon)
          islandSeed = ((area % 9973) / 9973) * Math.PI * 2 + polygon.length * 0.137
        }

        wasFinished = true

        const polygonCss = polygon
          .map((point) => {
            const x = (point.x / width) * 100
            const y = (point.y / height) * 100
            return `${x.toFixed(3)}% ${y.toFixed(3)}%`
          })
          .join(', ')

        island.style.left = `${minX}px`
        island.style.top = `${minY}px`
        island.style.width = `${width}px`
        island.style.height = `${height}px`
        island.style.clipPath = `polygon(${polygonCss})`
        island.style.webkitClipPath = `polygon(${polygonCss})`
        island.classList.add('is-visible')
        visible = true

        buildBaseField()
        draw(performance.now() * 0.001)
      }

      const scheduleSync = () => {
        if (syncFrame) return
        syncFrame = window.requestAnimationFrame(sync)
      }

      const observer = new MutationObserver(scheduleSync)

      observer.observe(outline, {
        attributes: true,
        attributeFilter: ['d'],
      })

      observer.observe(centroidSymbol, {
        attributes: true,
        attributeFilter: ['class'],
      })

      observer.observe(overlay, {
        attributes: true,
        attributeFilter: ['class'],
      })

      const animate = (time) => {
        animationFrame = window.requestAnimationFrame(animate)

        if (reducedMotion || !visible || !documentVisible) return
        if (time - lastDrawAt < 150) return

        lastDrawAt = time
        draw(time * 0.001)
      }

      const handleVisibility = () => {
        documentVisible = !document.hidden
      }

      document.addEventListener('visibilitychange', handleVisibility)
      window.addEventListener('resize', scheduleSync, { passive: true })

      scheduleSync()
      animationFrame = window.requestAnimationFrame(animate)

      window.addEventListener(
        'pagehide',
        () => {
          observer.disconnect()
          document.removeEventListener('visibilitychange', handleVisibility)
          window.removeEventListener('resize', scheduleSync)
          if (syncFrame) window.cancelAnimationFrame(syncFrame)
          if (animationFrame) window.cancelAnimationFrame(animationFrame)
          hide()
        },
        { once: true }
      )
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize, { once: true })
    } else {
      initialize()
    }
  })()
</script>
