---
import type {
  CollectionEntry,
} from 'astro:content';

import PointButterfly from './PointButterfly.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: 'fi' | 'en';
  postNumber: string;
  displayDate: string;
  perspectiveLabel: string;
  sourceLabel: string;
  headingLevel?: 'h1' | 'h2';
  titleHref?: string;
}

const {
  post,
  lang,
  postNumber,
  displayDate,
  perspectiveLabel,
  sourceLabel,
  headingLevel = 'h2',
  titleHref,
} = Astro.props;

const localizedPost =
  post.data[lang];

const publishedAt =
  post.data.publishedAt;

if (!publishedAt) {
  throw new Error(
    `FeedPost requires a published post: ${post.id}`
  );
}

const Heading =
  headingLevel;

const interactiveGraphic =
  post.data.interactiveGraphic;

/* =========================================================
   SOURCES

   Supports both:
   - old single-source format
   - new sources array
   ========================================================= */

const sources =
  'sources' in post.data
    ? post.data.sources.map(
        (source) => ({
          url:
            source.url,

          name:
            source[lang].name,

          linkText:
            source[lang].linkText,

          title:
            source[lang].title,
        })
      )
    : [
        {
          url:
            post.data.sourceUrl,

          name:
            post.data[lang]
              .sourceName,

          linkText:
            post.data[lang]
              .sourceLinkText,

          title:
            post.data[lang]
              .sourceTitle,
        },
      ];

const primarySource =
  sources[0];

const displayedSourceLabel =
  sources.length > 1
    ? lang === 'fi'
      ? 'Lähteet'
      : 'Sources'
    : sourceLabel;
---

<article class="feed-post">
  <div class="post-index-row">
    <span class="post-index">
      {postNumber}
    </span>

    <span class="post-index-line"></span>
  </div>

  <p class="post-meta">
    <time
      class="post-date"
      datetime={publishedAt}
    >
      {displayDate}
    </time>

    {
      localizedPost.tags.map(
        (tag) => (
          <>
            <span
              class="post-meta-separator"
              aria-hidden="true"
            >
              /
            </span>

            <span>
              {tag}
            </span>
          </>
        )
      )
    }
  </p>

  <Heading class="post-title">
    {
      titleHref
        ? (
            <a
              class="post-title-link"
              href={titleHref}
            >
              {localizedPost.title}
            </a>
          )
        : localizedPost.title
    }
  </Heading>

  <div class="post-news">
    <p>
      {localizedPost.intro}
    </p>

    <a
      class="post-news-link"
      href={primarySource.url}
      target="_blank"
      rel="noopener"
      title={primarySource.title}
    >
      <span>
        {primarySource.linkText}
      </span>

      <span
        class="post-news-link-arrow"
        aria-hidden="true"
      >
        ↗
      </span>
    </a>
  </div>

  <p class="post-perspective-label">
    {perspectiveLabel}
  </p>

  <div class="post-body">
    {
      localizedPost.perspective.map(
        (paragraph) => (
          <p>
            {paragraph}
          </p>
        )
      )
    }
  </div>

  {
    interactiveGraphic === 'butterfly'
      ? (
          <figure
            class="post-graphic post-graphic--interactive"
            role="img"
            aria-label={localizedPost.graphicAlt ?? ''}
          >
            <div class="post-interactive-graphic">
              <PointButterfly class="post-butterfly" />
            </div>
          </figure>
        )
      : post.data.graphic && (
          <figure class="post-graphic">
            <img
              class="post-graphic-image"
              src={post.data.graphic}
              alt={
                localizedPost.graphicAlt ??
                ''
              }
              loading="lazy"
              decoding="async"
            />
          </figure>
        )
  }

  <div class="source">
    <span class="source-label">
      {displayedSourceLabel}
    </span>

    <div class="source-links">
      {
        sources.map(
          (source) => (
            <a
              class="source-link"
              href={source.url}
              target="_blank"
              rel="noopener"
              title={source.title}
            >
              <span>
                {source.name}
              </span>

              <span
                class="source-arrow"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          )
        )
      }
    </div>
  </div>
</article>

<style>
  .post-title-link {
    color: inherit;
    text-decoration: none;
  }

  .source-links {
    display: flex;
    flex-wrap: wrap;
    gap:
      8px
      18px;
  }

  .post-graphic--interactive {
    overflow: hidden;
  }

  .post-interactive-graphic {
    width: 100%;
    aspect-ratio: 1200 / 220;
    min-height: 96px;
    max-height: 124px;
    overflow: hidden;
    pointer-events: none;
  }

  .post-interactive-graphic :global(.post-butterfly) {
    min-height: 0;
    cursor: default;
  }
</style>
