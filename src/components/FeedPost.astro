---
import type {
  CollectionEntry,
} from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: 'fi' | 'en';
  postNumber: string;
  displayDate: string;
  perspectiveLabel: string;
  sourceLabel: string;
  headingLevel?: 'h1' | 'h2';
}

const {
  post,
  lang,
  postNumber,
  displayDate,
  perspectiveLabel,
  sourceLabel,
  headingLevel = 'h2',
} = Astro.props;

const localizedPost =
  post.data[lang];

const publishedAt =
  post.data.publishedAt;

if (!publishedAt) {
  throw new Error(
    `FeedPost requires a published post: ${post.id}`
  );
}

const Heading =
  headingLevel;
---

<article class="feed-post">
  <div class="post-index-row">
    <span class="post-index">
      {postNumber}
    </span>

    <span class="post-index-line"></span>
  </div>

  <p class="post-meta">
    <time
      class="post-date"
      datetime={publishedAt}
    >
      {displayDate}
    </time>

    {
      localizedPost.tags.map(
        (tag) => (
          <>
            <span
              class="post-meta-separator"
              aria-hidden="true"
            >
              /
            </span>

            <span>
              {tag}
            </span>
          </>
        )
      )
    }
  </p>

  <Heading class="post-title">
    {localizedPost.title}
  </Heading>

  <div class="post-news">
    <p>
      {localizedPost.intro}
    </p>

    <a
      class="post-news-link"
      href={post.data.sourceUrl}
      target="_blank"
      rel="noopener"
      title={localizedPost.sourceTitle}
    >
      <span>
        {localizedPost.sourceLinkText}
      </span>

      <span
        class="post-news-link-arrow"
        aria-hidden="true"
      >
        ↗
      </span>
    </a>
  </div>

  <p class="post-perspective-label">
    {perspectiveLabel}
  </p>

  <div class="post-body">
    {
      localizedPost.perspective.map(
        (paragraph) => (
          <p>
            {paragraph}
          </p>
        )
      )
    }
  </div>

  {
    post.data.graphic && (
      <figure class="post-graphic">
        <img
          class="post-graphic-image"
          src={post.data.graphic}
          alt={
            localizedPost.graphicAlt ??
            ''
          }
          loading="lazy"
          decoding="async"
        />
      </figure>
    )
  }

  <div class="source">
    <span class="source-label">
      {sourceLabel}
    </span>

    <a
      class="source-link"
      href={post.data.sourceUrl}
      target="_blank"
      rel="noopener"
      title={localizedPost.sourceTitle}
    >
      <span>
        {localizedPost.sourceName}
      </span>

      <span
        class="source-arrow"
        aria-hidden="true"
      >
        ↗
      </span>
    </a>
  </div>
</article>
