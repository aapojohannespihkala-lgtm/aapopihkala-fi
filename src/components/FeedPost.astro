---
import type {
  CollectionEntry,
} from 'astro:content';

import PointButterfly from './PointButterfly.astro';
import TreeField from './TreeField.astro';
import RiverFlow from './RiverFlow.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: 'fi' | 'en';
  postNumber: string;
  displayDate: string;
  perspectiveLabel: string;
  sourceLabel: string;
  headingLevel?: 'h1' | 'h2';
  titleHref?: string;
}

const {
  post,
  lang,
  postNumber,
  displayDate,
  perspectiveLabel,
  sourceLabel,
  headingLevel = 'h2',
  titleHref,
} = Astro.props;

const localizedPost =
  post.data[lang];

const publishedAt =
  post.data.publishedAt;

if (!publishedAt) {
  throw new Error(
    `FeedPost requires a published post: ${post.id}`
  );
}

const Heading =
  headingLevel;

const interactiveGraphic =
  post.data.interactiveGraphic;

/* =========================================================
   SOURCES

   Supports both:
   - old single-source format
   - new sources array
   ========================================================= */

const sources =
  'sources' in post.data
    ? post.data.sources.map(
        (source) => ({
          url:
            source.url,

          name:
            source[lang].name,

          linkText:
            source[lang].linkText,

          title:
            source[lang].title,
        })
      )
    : [
        {
          url:
            post.data.sourceUrl,

          name:
            post.data[lang]
              .sourceName,

          linkText:
            post.data[lang]
              .sourceLinkText,

          title:
            post.data[lang]
              .sourceTitle,
        },
      ];

const primarySource =
  sources[0];

const displayedSourceLabel =
  sources.length > 1
    ? lang === 'fi'
      ? 'Lähteet'
      : 'Sources'
    : sourceLabel;
---

<article class="feed-post">
  <p class="post-meta">
    <time
      class="post-date"
      datetime={publishedAt}
    >
      {displayDate}
    </time>

    {
      localizedPost.tags.map(
        (tag) => (
          <>
            <span
              class="post-meta-separator"
              aria-hidden="true"
            >
              /
            </span>

            <span>
              {tag}
            </span>
          </>
        )
      )
    }
  </p>

  <Heading class="post-title">
    {
      titleHref
        ? (
            <a
              class="post-title-link"
              href={titleHref}
            >
              {localizedPost.title}
            </a>
          )
        : localizedPost.title
    }
  </Heading>

  <div class="post-news">
    <p>
      {localizedPost.intro}
    </p>

    <a
      class="post-news-link"
      href={primarySource.url}
      target="_blank"
      rel="noopener"
      title={primarySource.title}
    >
      <span>
        {primarySource.linkText}
      </span>

      <span
        class="post-news-link-arrow"
        aria-hidden="true"
      >
        ↗
      </span>
    </a>
  </div>

  <p class="post-perspective-label">
    {perspectiveLabel}
  </p>

  <div class="post-body">
    {
      localizedPost.perspective.map(
        (paragraph) => (
          <p>
            {paragraph}
          </p>
        )
      )
    }
  </div>

  <div class="source">
    <span class="source-label">
      {displayedSourceLabel}
    </span>

    <div class="source-links">
      {
        sources.map(
          (source) => (
            <a
              class="source-link"
              href={source.url}
              target="_blank"
              rel="noopener"
              title={source.title}
            >
              <span>
                {source.name}
              </span>

              <span
                class="source-arrow"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          )
        )
      }
    </div>
  </div>

  {
    interactiveGraphic === 'butterfly'
      ? (
          <figure
            class="post-graphic post-graphic--interactive"
            role="img"
            aria-label={localizedPost.graphicAlt ?? ''}
          >
            <div class="post-interactive-graphic" data-post-interactive-graphic>
              <PointButterfly
                class="post-butterfly"
                enableZoom={false}
                scale={1.08}
                cameraDistance={8.2}
              />
              <span
                class="post-interaction-hit post-interaction-hit--butterfly"
                data-post-interaction-hit
                aria-hidden="true"
              ></span>
            </div>
          </figure>
        )
      : interactiveGraphic === 'tree'
        ? (
            <figure
              class="post-graphic post-graphic--interactive"
              role="img"
              aria-label={localizedPost.graphicAlt ?? ''}
            >
              <div class="post-interactive-graphic" data-post-interactive-graphic>
                <TreeField
                  class="post-tree"
                  enableZoom={false}
                  scale={1.15}
                  cameraDistance={10.8}
                />
                <span
                  class="post-interaction-hit post-interaction-hit--tree"
                  data-post-interaction-hit
                  aria-hidden="true"
                ></span>
              </div>
            </figure>
          )
      : interactiveGraphic === 'stormwater'
        ? (
            <figure
              class="post-graphic post-graphic--interactive"
              role="img"
              aria-label={localizedPost.graphicAlt ?? ''}
            >
              <div
                class="post-interactive-graphic post-interactive-graphic--waterdrop"
                data-post-interactive-graphic
              >
                <RiverFlow
                  class="post-river-flow"
                  enableZoom={false}
                  scale={1.08}
                />
                <span
                  class="post-interaction-hit post-interaction-hit--waterdrop"
                  data-post-interaction-hit
                  aria-hidden="true"
                ></span>
              </div>
            </figure>
          )
        : post.data.graphic && (
            <figure class="post-graphic">
              <img
                class="post-graphic-image"
                src={post.data.graphic}
                alt={
                  localizedPost.graphicAlt ??
                  ''
                }
                loading="lazy"
                decoding="async"
              />
            </figure>
          )
  }

  <div class="post-divider" aria-hidden="true"></div>
</article>

<style>
  .post-title-link {
    color: inherit;
    text-decoration: none;
  }

  .source-links {
    display: flex;
    flex-wrap: wrap;
    gap:
      8px
      18px;
  }

  .post-graphic--interactive {
    overflow: visible;
  }

  .post-interactive-graphic {
    position: relative;
    width: 100%;
    height: clamp(108px, 12vw, 118px);
    margin-left: 0;
    overflow: hidden;
    transform: translateX(-37%);
  }

  .post-interactive-graphic--waterdrop {
    height: clamp(124px, 14vw, 145px);
  }

  .post-interaction-hit {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: 2;
    display: block;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .post-interaction-hit--butterfly {
    width: clamp(140px, 20vw, 180px);
  }

  .post-interaction-hit--tree {
    width: clamp(150px, 22vw, 200px);
  }

  .post-interaction-hit--waterdrop {
    width: clamp(100px, 15vw, 140px);
  }

  .post-interactive-graphic :global(.post-butterfly),
  .post-interactive-graphic :global(.post-tree),
  .post-interactive-graphic :global(.post-river-flow) {
    min-height: 0;
    cursor: default;
  }

  .post-interactive-graphic :global(.point-butterfly__canvas),
  .post-interactive-graphic :global(.tree-field__canvas),
  .post-interactive-graphic :global(.river-flow__canvas) {
    touch-action: pan-y !important;
    cursor: default;
  }

  .post-divider {
    width: 100%;
    max-width: 640px;
    margin-top: 20px;
    border-top: 1px solid var(--line-soft);
  }

  @media (max-width: 640px) {
    .post-interactive-graphic {
      transform: translateX(-26%);
    }

    .post-divider {
      margin-top: 18px;
    }
  }
</style>

<script is:inline>
  (() => {
    const graphics = document.querySelectorAll('[data-post-interactive-graphic]');

    graphics.forEach((graphic) => {
      if (graphic.dataset.hitAreaInitialized === 'true') return;
      graphic.dataset.hitAreaInitialized = 'true';

      const canvas = graphic.querySelector('canvas');
      const hitArea = graphic.querySelector('[data-post-interaction-hit]');
      if (!canvas || !hitArea) return;

      let isDragging = false;

      const isInsideHitArea = (event) => {
        const rect = hitArea.getBoundingClientRect();
        return (
          event.clientX >= rect.left &&
          event.clientX <= rect.right &&
          event.clientY >= rect.top &&
          event.clientY <= rect.bottom
        );
      };

      const updateCursor = (event) => {
        if (isDragging) {
          canvas.style.cursor = 'grabbing';
          return;
        }

        canvas.style.cursor = isInsideHitArea(event)
          ? 'grab'
          : 'default';
      };

      canvas.addEventListener(
        'pointerdown',
        (event) => {
          if (!isInsideHitArea(event)) {
            event.stopImmediatePropagation();
            return;
          }

          isDragging = true;
          canvas.style.cursor = 'grabbing';
        },
        true
      );

      canvas.addEventListener(
        'pointermove',
        updateCursor,
        { passive: true }
      );

      canvas.addEventListener(
        'pointerup',
        (event) => {
          isDragging = false;
          updateCursor(event);
        },
        true
      );

      canvas.addEventListener(
        'pointercancel',
        () => {
          isDragging = false;
          canvas.style.cursor = 'default';
        },
        true
      );

      canvas.addEventListener(
        'pointerleave',
        () => {
          if (!isDragging) {
            canvas.style.cursor = 'default';
          }
        },
        { passive: true }
      );
    });
  })();
</script>
