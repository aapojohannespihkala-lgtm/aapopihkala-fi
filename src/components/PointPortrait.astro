---
interface Props { class?: string; autoRotate?: boolean; enableZoom?: boolean; scale?: number; cameraDistance?: number; }
const { class: className, autoRotate = true, enableZoom = true, scale = 1, cameraDistance = 7 } = Astro.props;
---
<div class:list={['point-portrait', className]} data-point-portrait data-auto-rotate={autoRotate ? 'true':'false'} data-enable-zoom={enableZoom ? 'true':'false'} data-scale={scale} data-camera-distance={cameraDistance} role="img" aria-label="Pyöriteltävä realistinen 3D-pistepilvimuotokuva">
  <canvas data-point-portrait-canvas></canvas><span data-point-portrait-status>loading point cloud</span>
</div>
<style>
.point-portrait{position:relative;width:100%;height:100%;min-height:300px;overflow:hidden;cursor:grab;user-select:none}.point-portrait:active{cursor:grabbing}.point-portrait canvas{display:block;width:100%;height:100%;touch-action:none}.point-portrait span{position:absolute;left:12px;bottom:10px;font:0.58rem ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;letter-spacing:.08em;text-transform:uppercase;opacity:.42;pointer-events:none;transition:opacity .16s}.point-portrait[data-ready='true'] span{opacity:0}
</style>
<script is:inline>
(()=>{document.querySelectorAll('[data-point-portrait]').forEach(async root=>{if(root.dataset.pointPortraitInitialized==='true')return;root.dataset.pointPortraitInitialized='true';const canvas=root.querySelector('[data-point-portrait-canvas]'),status=root.querySelector('[data-point-portrait-status]');if(!canvas)return;try{
const THREE=await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');const{OrbitControls}=await import('https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm');
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),lerp=(a,b,t)=>a+(b-a)*t,deg=v=>THREE.MathUtils.degToRad(v);const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches,wantsAuto=root.dataset.autoRotate!=='false',wantsZoom=root.dataset.enableZoom!=='false';
const loadSampler=src=>new Promise((resolve,reject)=>{const im=new Image();im.decoding='async';im.onload=()=>{const c=document.createElement('canvas');c.width=c.height=512;const x=c.getContext('2d',{willReadFrequently:true});if(!x)return reject(new Error('2d unavailable'));x.drawImage(im,0,0,512,512);const p=x.getImageData(0,0,512,512).data;resolve((u,v)=>{const X=Math.round(clamp(u,0,1)*511),Y=Math.round(clamp(v,0,1)*511),i=(Y*512+X)*4;return[p[i]/255,p[i+1]/255,p[i+2]/255]})};im.onerror=reject;im.src='/lab/aapo-head-source.jpg'});const sample=await loadSampler('/lab/aapo-head-source.jpg');
const renderer=new THREE.WebGLRenderer({canvas,antialias:true,alpha:true,powerPreference:'high-performance'});renderer.setPixelRatio(Math.min(devicePixelRatio||1,1.7));renderer.setClearColor(0xffffff,0);renderer.outputColorSpace=THREE.SRGBColorSpace;const scene=new THREE.Scene(),camera=new THREE.PerspectiveCamera(33,1,.1,100);camera.position.set(0,.03,Number(root.dataset.cameraDistance)||7);const portrait=new THREE.Group();portrait.scale.setScalar(Number(root.dataset.scale)||1);portrait.position.y=-.02;scene.add(portrait);
const controls=new OrbitControls(camera,renderer.domElement);controls.enablePan=false;controls.enableZoom=wantsZoom;controls.minDistance=5;controls.maxDistance=9.4;controls.zoomSpeed=.5;controls.enableDamping=true;controls.dampingFactor=.06;controls.rotateSpeed=.5;controls.target.set(0,.03,0);controls.minAzimuthAngle=deg(-55);controls.maxAzimuthAngle=deg(55);controls.minPolarAngle=deg(72);controls.maxPolarAngle=deg(108);
const mats=[new THREE.PointsMaterial({size:.019,sizeAttenuation:true,vertexColors:true,transparent:true,opacity:.98}),new THREE.PointsMaterial({size:.016,sizeAttenuation:true,vertexColors:true,transparent:true,opacity:.72}),new THREE.PointsMaterial({color:0x251b17,size:.026,sizeAttenuation:true,transparent:true,opacity:.96})],geos=[];let seed=19890417;const rnd=()=>{seed=(seed*1664525+1013904223)>>>0;return seed/4294967296};
const keysW=[[-1.3,.44],[-1.08,.59],[-.82,.69],[-.46,.78],[-.08,.83],[.34,.86],[.76,.89],[1.08,.87],[1.34,.72],[1.49,.38]],keysD=[[-1.3,.35],[-1.02,.5],[-.55,.59],[-.06,.65],[.46,.7],[.9,.72],[1.22,.67],[1.46,.43]];const curve=(k,y)=>{if(y<=k[0][0])return k[0][1];for(let i=0;i<k.length-1;i++){const a=k[i],b=k[i+1];if(y<=b[0]){let t=clamp((y-a[0])/(b[0]-a[0]),0,1);t=t*t*(3-2*t);return lerp(a[1],b[1],t)}}return k[k.length-1][1]},W=y=>curve(keysW,y),D=y=>curve(keysD,y),g=(x,y,cx,cy,sx,sy)=>Math.exp(-.5*(((x-cx)/sx)**2+((y-cy)/sy)**2));
const surf=(y,a)=>{const c=Math.cos(a),s=Math.sin(a),f=Math.max(0,s),fm=f**2.05,sm=Math.abs(c)**2.2;let x=c*W(y),z=s*D(y);z+=.065*(g(x,y,-.41,-.04,.21,.27)+g(x,y,.41,-.04,.21,.27))*fm;z-=.082*(g(x,y,-.34,.25,.19,.14)+g(x,y,.34,.25,.19,.14))*fm;z+=.035*(g(x,y,-.34,.43,.23,.1)+g(x,y,.34,.43,.23,.1))*fm;z+=(.19*g(x,y,0,.2,.11,.39)+.23*g(x,y,0,-.08,.14,.14)+.055*g(x,y,0,-.2,.2,.1))*fm;z+=.033*g(x,y,0,-.43,.24,.075)*fm+.048*g(x,y,0,-.53,.25,.085)*fm+.064*g(x,y,0,-.83,.35,.21)*fm;z-=.018*sm*clamp((y+.24)/1.45,0,1);return new THREE.Vector3(x,y,z)};
const fallback=(y,f)=>y>.88?[.34,.27,.21]:y<-1.02?[.68,.68,.64]:[.72+.08*f,.53+.07*f,.45+.06*f];const suspicious=(rgb,y)=>{const[r,g,b]=rgb,M=Math.max(r,g,b),m=Math.min(r,g,b),sat=M-m;return(g>r*1.1&&g>b*1.08)||(b>r*1.18&&M>.62)||(sat<.04&&M>.88&&y>-.9)};const color=(p,y,a)=>{const s=Math.sin(a),f=clamp((s+.05)/1.05,0,1),edge=clamp(Math.abs(p.x)/Math.max(.001,W(y)),0,1);let u=.50+p.x/1.72,v=(1.48-y)/2.78,rgb=sample(u,v),fb=fallback(y,f);if(suspicious(rgb,y))rgb=fb;const shade=1-.22*edge-.12*Math.max(0,-s);return[clamp(rgb[0]*shade,0,1),clamp(rgb[1]*shade,0,1),clamp(rgb[2]*shade,0,1)]};
const fp=[],fc=[],rp=[],rc=[];for(let yi=0;yi<=138;yi++){const y=lerp(-1.3,1.49,yi/138);for(let ai=0;ai<176;ai++){if(rnd()<.055)continue;const a=ai/176*Math.PI*2,p=surf(y,a),s=Math.sin(a),j=s>-.08?.0024:.0035;p.x+=(rnd()-.5)*j;p.y+=(rnd()-.5)*j;p.z+=(rnd()-.5)*j;const c=color(p,y,a),P=s>-.08?fp:rp,C=s>-.08?fc:rc;P.push(p.x,p.y,p.z);C.push(...c)}}const add=(P,C,m)=>{const q=new THREE.BufferGeometry();q.setAttribute('position',new THREE.Float32BufferAttribute(P,3));q.setAttribute('color',new THREE.Float32BufferAttribute(C,3));geos.push(q);portrait.add(new THREE.Points(q,m))};add(fp,fc,mats[0]);add(rp,rc,mats[1]);
const curvePts=pts=>{const P=[];pts.forEach(p=>P.push(p.x,p.y,p.z));const q=new THREE.BufferGeometry();q.setAttribute('position',new THREE.Float32BufferAttribute(P,3));geos.push(q);portrait.add(new THREE.Points(q,mats[2]))},ellipse=(cx,cy,w,h,z,r=0)=>{const P=[];for(let i=0;i<150;i++){const a=i/150*Math.PI*2,c=Math.cos(a),s=Math.sin(a),e=.56,lx=Math.sign(c)*Math.abs(c)**e*w*.5,ly=Math.sign(s)*Math.abs(s)**e*h*.5;P.push(new THREE.Vector3(cx+lx*Math.cos(r)-ly*Math.sin(r),cy+lx*Math.sin(r)+ly*Math.cos(r),z))}return P};curvePts(ellipse(-.34,.22,.61,.41,.765,-.02));curvePts(ellipse(.34,.22,.61,.41,.765,.02));curvePts([new THREE.Vector3(-.05,.23,.78),new THREE.Vector3(0,.247,.787),new THREE.Vector3(.05,.23,.78)]);[-1,1].forEach(s=>curvePts(new THREE.CatmullRomCurve3([new THREE.Vector3(s*.65,.24,.72),new THREE.Vector3(s*.78,.23,.58),new THREE.Vector3(s*.86,.08,.06)]).getPoints(70)));
const hp=[],hc=[];for(let i=0;i<2500;i++){const t=rnd()**.76,x=lerp(-.56,.61,t)+(rnd()-.5)*.18,crown=Math.max(0,1-(clamp((x+.04)/.9,-1,1))**2),y=1.16+crown*.24+(1-t)*.1+(rnd()-.5)*.035,z=.24+(1-t)*.39+(rnd()-.5)*.07;let c=sample(clamp(.5+x/1.72,.08,.92),clamp((1.48-y)/2.78,.02,.34));if(suspicious(c,y))c=[.34,.26,.2];hp.push(x,y,z);hc.push(c[0]*.9,c[1]*.9,c[2]*.9)}add(hp,hc,mats[1]);
let last=performance.now()-9000,raf=0,prev=performance.now(),yaw=0;const touch=()=>last=performance.now();canvas.addEventListener('pointerdown',touch,{passive:true});canvas.addEventListener('wheel',touch,{passive:true});controls.addEventListener('start',touch);const resize=()=>{const r=root.getBoundingClientRect(),w=Math.max(1,r.width),h=Math.max(1,r.height);renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix()},obs=new ResizeObserver(resize);obs.observe(root);resize();const loop=t=>{const d=Math.min(50,t-prev);prev=t;const auto=wantsAuto&&!reduced&&t-last>4200,target=auto?Math.sin(t*.00024)*.27:0;yaw+=(target-yaw)*Math.min(1,d*.0028);portrait.rotation.y=yaw;controls.update();renderer.render(scene,camera);raf=requestAnimationFrame(loop)};root.dataset.ready='true';if(status)status.textContent='point cloud ready';raf=requestAnimationFrame(loop);addEventListener('pagehide',()=>{cancelAnimationFrame(raf);obs.disconnect();controls.dispose();geos.forEach(g=>g.dispose());mats.forEach(m=>m.dispose());renderer.dispose()},{once:true});
}catch(e){console.error('Point portrait failed',e);if(status)status.textContent='point cloud unavailable'}})})();
</script>
