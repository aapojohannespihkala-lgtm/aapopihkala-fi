---
interface Props { class?: string; autoRotate?: boolean; enableZoom?: boolean; scale?: number; cameraDistance?: number; }
const { class: className, autoRotate = true, enableZoom = true, scale = 1, cameraDistance = 5.9 } = Astro.props;
---
<div class:list={['point-portrait', className]} data-point-portrait data-auto-rotate={autoRotate ? 'true' : 'false'} data-enable-zoom={enableZoom ? 'true' : 'false'} data-scale={scale} data-camera-distance={cameraDistance} role="img" aria-label="Pyöriteltävä valokuva-aineistoon perustuva 3D-pistepilvimuotokuva">
  <canvas class="point-portrait__canvas" data-point-portrait-canvas></canvas>
</div>
<style>
.point-portrait{position:relative;width:100%;height:100%;min-height:300px;overflow:hidden;background:transparent;cursor:grab;user-select:none;-webkit-user-select:none}.point-portrait:active{cursor:grabbing}.point-portrait__canvas{display:block;width:100%;height:100%;background:transparent;touch-action:none}
</style>
<script is:inline>
(()=>{
const FW=28,FH=35;
const FRONT='';
const SIDE='';
const dec=s=>{const b=atob(s),a=new Uint8Array(b.length);for(let i=0;i<b.length;i++)a[i]=b.charCodeAt(i);return a};
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),lerp=(a,b,t)=>a+(b-a)*t;
const sample=(keys,y)=>{if(y<=keys[0][0])return keys[0][1];for(let i=0;i<keys.length-1;i++){const a=keys[i],b=keys[i+1];if(y<=b[0]){let t=clamp((y-a[0])/(b[0]-a[0]),0,1);t=t*t*(3-2*t);return lerp(a[1],b[1],t)}}return keys[keys.length-1][1]};
const WKEY=[[-1.28,.42],[-1,.60],[-.6,.72],[-.1,.82],[.45,.86],[.9,.88],[1.2,.80],[1.5,.48]],DKEY=[[-1.28,.34],[-1,.48],[-.5,.60],[0,.68],[.5,.72],[1,.70],[1.3,.60],[1.5,.40]];
const gauss=(x,y,cx,cy,sx,sy)=>Math.exp(-.5*(((x-cx)/sx)**2+((y-cy)/sy)**2));
document.querySelectorAll('[data-point-portrait]').forEach(async root=>{if(root.dataset.pointPortraitInitialized==='true')return;root.dataset.pointPortraitInitialized='true';const canvas=root.querySelector('[data-point-portrait-canvas]');if(!canvas)return;try{
const THREE=await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');const{OrbitControls}=await import('https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm');
const front=dec(FRONT),side=dec(SIDE),reduced=matchMedia('(prefers-reduced-motion: reduce)').matches,wantsAuto=root.dataset.autoRotate!=='false',wantsZoom=root.dataset.enableZoom!=='false';
const renderer=new THREE.WebGLRenderer({canvas,antialias:true,alpha:true,powerPreference:'high-performance'});renderer.setPixelRatio(Math.min(devicePixelRatio||1,1.5));renderer.setClearColor(0xffffff,0);const scene=new THREE.Scene(),camera=new THREE.PerspectiveCamera(32,1,.1,100);camera.position.set(0,.05,Number(root.dataset.cameraDistance)||5.9);const portrait=new THREE.Group();portrait.position.y=-.02;portrait.scale.setScalar(Number(root.dataset.scale)||1);scene.add(portrait);
const controls=new OrbitControls(camera,renderer.domElement);controls.enablePan=false;controls.enableZoom=wantsZoom;controls.minDistance=4.6;controls.maxDistance=8.2;controls.zoomSpeed=.52;controls.enableDamping=true;controls.dampingFactor=.06;controls.rotateSpeed=.46;controls.target.set(0,.05,0);controls.minAzimuthAngle=THREE.MathUtils.degToRad(-50);controls.maxAzimuthAngle=THREE.MathUtils.degToRad(50);controls.minPolarAngle=THREE.MathUtils.degToRad(72);controls.maxPolarAngle=THREE.MathUtils.degToRad(108);
let seed=19890417;const rnd=()=>{seed=(seed*1664525+1013904223)>>>0;return seed/4294967296},P=[],C=[],push=(x,y,z,r,g,b,j=.004)=>{P.push(x+(rnd()-.5)*j,y+(rnd()-.5)*j,z+(rnd()-.5)*j);C.push(r/255,g/255,b/255)};
for(let ay=0;ay<FH;ay++)for(let ax=0;ax<FW;ax++){const i=(ay*FW+ax)*4,a=front[i+3];if(a<70)continue;const sx=(ax+.5)/FW*512,sy=(ay+.5)/FH*640,y=(340-sy)/210,w=sample(WKEY,y),d=sample(DKEY,y),x=(sx-260)/220*.92;if(Math.abs(x)>w*1.08)continue;let z=d*Math.sqrt(Math.max(0,1-(x/Math.max(w,.001))**2));z+=.24*gauss(x,y,0,.02,.12,.25)+.05*(gauss(x,y,-.32,-.05,.18,.23)+gauss(x,y,.32,-.05,.18,.23))-.05*(gauss(x,y,-.30,.28,.17,.12)+gauss(x,y,.30,.28,.17,.12))+.03*gauss(x,y,0,-.45,.25,.09);const r=front[i],g=front[i+1],b=front[i+2];if(g>r*1.35&&g>b*1.15&&y<1.25)continue;for(let k=0;k<5;k++)push(x,y,z+(k-2)*.002,r,g,b,.012)}
for(let ay=0;ay<FH;ay++)for(let ax=0;ax<FW;ax++){const i=(ay*FW+ax)*4,a=side[i+3];if(a<80)continue;const sx=(ax+.5)/FW*512,sy=(ay+.5)/FH*640,y=(350-sy)/215,w=sample(WKEY,y),d=sample(DKEY,y),z=(270-sx)/220*.9;if(Math.abs(z)>d*1.1)continue;const x=w*Math.sqrt(Math.max(0,1-(z/Math.max(d,.001))**2)),r=side[i],g=side[i+1],b=side[i+2];if(b>r*1.18&&b>g*1.06&&Math.max(r,g,b)<215)continue;for(let k=0;k<3;k++)push(x,y,z,r,g,b,.012);if((ax+ay)%2===0)for(let k=0;k<2;k++)push(-x,y,z,r,g,b,.012)}
const geometry=new THREE.BufferGeometry();geometry.setAttribute('position',new THREE.Float32BufferAttribute(P,3));geometry.setAttribute('color',new THREE.Float32BufferAttribute(C,3));geometry.computeBoundingSphere();const material=new THREE.PointsMaterial({size:.026,sizeAttenuation:true,vertexColors:true,transparent:true,opacity:.98,depthWrite:true});portrait.add(new THREE.Points(geometry,material));
const resize=()=>{const r=root.getBoundingClientRect(),w=Math.max(1,Math.round(r.width)),h=Math.max(1,Math.round(r.height));renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix()};let ro=null;if('ResizeObserver'in window){ro=new ResizeObserver(resize);ro.observe(root)}else addEventListener('resize',resize);resize();let visible=true,io=null;if('IntersectionObserver'in window){io=new IntersectionObserver(e=>visible=e.some(x=>x.isIntersecting),{rootMargin:'160px'});io.observe(root)}let last=performance.now();const touch=()=>last=performance.now();canvas.addEventListener('pointerdown',touch,{passive:true});canvas.addEventListener('wheel',touch,{passive:true});controls.addEventListener('start',touch);let raf=0,prev=performance.now(),yaw=0;const loop=t=>{raf=requestAnimationFrame(loop);if(!visible||document.hidden)return;const dt=Math.min(50,t-prev);prev=t;const target=wantsAuto&&!reduced&&t-last>3600?Math.sin(t*.00023)*.12:0;yaw+=(target-yaw)*Math.min(1,dt*.003);portrait.rotation.y=yaw;controls.update();renderer.render(scene,camera)};raf=requestAnimationFrame(loop);addEventListener('pagehide',()=>{cancelAnimationFrame(raf);ro?.disconnect();io?.disconnect();if(!ro)removeEventListener('resize',resize);controls.dispose();geometry.dispose();material.dispose();renderer.dispose()},{once:true});
}catch(e){console.error('Point portrait failed to initialize',e)}})})();
</script>