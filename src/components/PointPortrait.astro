---
interface Props {
  class?: string;
  autoRotate?: boolean;
  enableZoom?: boolean;
  scale?: number;
  cameraDistance?: number;
}

const {
  class: className,
  autoRotate = true,
  enableZoom = true,
  scale = 1,
  cameraDistance = 7.2,
} = Astro.props;
---

<div
  class:list={['point-portrait', className]}
  data-point-portrait
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-scale={scale}
  data-camera-distance={cameraDistance}
  aria-hidden="true"
>
  <canvas class="point-portrait__canvas" data-point-portrait-canvas></canvas>
</div>

<style>
  .point-portrait {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 300px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .point-portrait:active {
    cursor: grabbing;
  }

  .point-portrait__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-point-portrait]')

    roots.forEach(async (root) => {
      if (root.dataset.pointPortraitInitialized === 'true') return
      root.dataset.pointPortraitInitialized = 'true'

      const canvas = root.querySelector('[data-point-portrait-canvas]')
      if (!canvas) return

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm')
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        )

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const wantsAutoRotate = root.dataset.autoRotate !== 'false'
        const wantsZoom = root.dataset.enableZoom !== 'false'
        const requestedScale = Number(root.dataset.scale ?? '1')
        const requestedCameraDistance = Number(root.dataset.cameraDistance ?? '7.2')
        const displayScale = Number.isFinite(requestedScale) ? requestedScale : 1
        const cameraDistance = Number.isFinite(requestedCameraDistance)
          ? requestedCameraDistance
          : 7.2

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        })
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6))
        renderer.setClearColor(0xffffff, 0)

        const scene = new THREE.Scene()
        const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 100)
        camera.position.set(0, 0.03, cameraDistance)

        const portrait = new THREE.Group()
        portrait.position.y = 0.04
        portrait.rotation.x = -0.025
        portrait.rotation.z = -0.012
        portrait.scale.setScalar(displayScale)
        scene.add(portrait)

        const controls = new OrbitControls(camera, renderer.domElement)
        controls.enablePan = false
        controls.enableZoom = wantsZoom
        controls.minDistance = 4.8
        controls.maxDistance = 10.8
        controls.zoomSpeed = 0.55
        controls.enableDamping = true
        controls.dampingFactor = 0.055
        controls.rotateSpeed = 0.52
        controls.target.set(0, 0.03, 0)
        controls.autoRotate = wantsAutoRotate && !reducedMotion
        controls.autoRotateSpeed = 0.24

        const skinPointMaterial = new THREE.PointsMaterial({
          color: 0x3f4741,
          size: 0.018,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.72,
        })
        const rearPointMaterial = new THREE.PointsMaterial({
          color: 0x6c756d,
          size: 0.015,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.34,
        })
        const featureMaterial = new THREE.LineBasicMaterial({
          color: 0x343a35,
          transparent: true,
          opacity: 0.82,
        })
        const softFeatureMaterial = new THREE.LineBasicMaterial({
          color: 0x687269,
          transparent: true,
          opacity: 0.48,
        })
        const scanMaterial = new THREE.LineBasicMaterial({
          color: 0x7b877d,
          transparent: true,
          opacity: 0.2,
        })
        const hairLineMaterial = new THREE.LineBasicMaterial({
          color: 0x4f5a51,
          transparent: true,
          opacity: 0.5,
        })
        const hairPointMaterial = new THREE.PointsMaterial({
          color: 0x4d574f,
          size: 0.018,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.48,
        })
        const darkPointMaterial = new THREE.PointsMaterial({
          color: 0x252a26,
          size: 0.026,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.86,
        })
        const stubbleMaterial = new THREE.PointsMaterial({
          color: 0x596159,
          size: 0.012,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.36,
        })

        const geometries = []
        const materials = [
          skinPointMaterial,
          rearPointMaterial,
          featureMaterial,
          softFeatureMaterial,
          scanMaterial,
          hairLineMaterial,
          hairPointMaterial,
          darkPointMaterial,
          stubbleMaterial,
        ]

        let seed = 19890417
        const random = () => {
          seed = (seed * 1664525 + 1013904223) >>> 0
          return seed / 4294967296
        }

        const clamp = (value, min, max) => Math.max(min, Math.min(max, value))
        const lerp = (a, b, t) => a + (b - a) * t
        const gaussian2 = (x, y, cx, cy, sx, sy) => {
          const dx = (x - cx) / sx
          const dy = (y - cy) / sy
          return Math.exp(-(dx * dx + dy * dy) * 0.5)
        }
        const sampleCurve = (keys, y) => {
          if (y <= keys[0][0]) return keys[0][1]
          for (let i = 0; i < keys.length - 1; i += 1) {
            const a = keys[i]
            const b = keys[i + 1]
            if (y <= b[0]) {
              const t = clamp((y - a[0]) / (b[0] - a[0]), 0, 1)
              const smooth = t * t * (3 - 2 * t)
              return lerp(a[1], b[1], smooth)
            }
          }
          return keys[keys.length - 1][1]
        }

        const widthKeys = [
          [-1.28, 0.42],
          [-1.08, 0.58],
          [-0.82, 0.69],
          [-0.45, 0.77],
          [-0.08, 0.82],
          [0.35, 0.84],
          [0.78, 0.88],
          [1.13, 0.83],
          [1.35, 0.56],
        ]
        const depthKeys = [
          [-1.28, 0.34],
          [-1.02, 0.49],
          [-0.56, 0.58],
          [-0.05, 0.64],
          [0.48, 0.69],
          [0.94, 0.71],
          [1.24, 0.61],
          [1.35, 0.4],
        ]

        const headWidthAtY = (y) => sampleCurve(widthKeys, y)
        const headDepthAtY = (y) => sampleCurve(depthKeys, y)

        const surfacePoint = (y, angle) => {
          const cos = Math.cos(angle)
          const sin = Math.sin(angle)
          const front = Math.max(0, sin)
          const frontMask = Math.pow(front, 2.2)
          const sideMask = Math.pow(Math.abs(cos), 2.4)

          let width = headWidthAtY(y)
          const jawAngle = gaussian2(Math.abs(cos), y, 0.94, -0.68, 0.18, 0.3)
          width += 0.025 * jawAngle

          let x = cos * width
          let z = sin * headDepthAtY(y)

          const temple =
            gaussian2(x, y, -0.65, 0.35, 0.22, 0.3) +
            gaussian2(x, y, 0.65, 0.35, 0.22, 0.3)
          z -= 0.018 * temple * frontMask

          const cheek =
            gaussian2(x, y, -0.4, -0.02, 0.2, 0.26) +
            gaussian2(x, y, 0.4, -0.02, 0.2, 0.26)
          z += 0.055 * cheek * frontMask

          const eyeSocket =
            gaussian2(x, y, -0.34, 0.25, 0.18, 0.13) +
            gaussian2(x, y, 0.34, 0.25, 0.18, 0.13)
          z -= 0.075 * eyeSocket * frontMask

          const brow =
            gaussian2(x, y, -0.34, 0.43, 0.22, 0.1) +
            gaussian2(x, y, 0.34, 0.43, 0.22, 0.1)
          z += 0.035 * brow * frontMask

          const bridge = gaussian2(x, y, 0, 0.2, 0.105, 0.38)
          const noseTip = gaussian2(x, y, 0, -0.08, 0.14, 0.13)
          const nostrilPlane = gaussian2(x, y, 0, -0.19, 0.2, 0.1)
          z += (0.18 * bridge + 0.2 * noseTip + 0.055 * nostrilPlane) * frontMask

          const philtrum = gaussian2(x, y, 0, -0.34, 0.1, 0.12)
          z -= 0.018 * philtrum * frontMask

          const upperLip = gaussian2(x, y, 0, -0.43, 0.24, 0.075)
          const lowerLip = gaussian2(x, y, 0, -0.53, 0.25, 0.085)
          z += (0.032 * upperLip + 0.047 * lowerLip) * frontMask

          const chin = gaussian2(x, y, 0, -0.84, 0.34, 0.2)
          z += 0.058 * chin * frontMask

          const jawTaper = clamp((-0.58 - y) / 0.58, 0, 1)
          x *= 1 - jawTaper * 0.035 * front

          const foreheadPlane = gaussian2(x, y, 0, 0.78, 0.52, 0.42)
          z += 0.018 * foreheadPlane * frontMask

          z -= 0.016 * sideMask * clamp((y + 0.25) / 1.4, 0, 1)

          x += 0.008 * clamp((y + 0.8) / 2, 0, 1)

          return new THREE.Vector3(x, y, z)
        }

        const facePositions = []
        const rearPositions = []
        const rows = 102
        const sides = 124

        for (let yi = 0; yi <= rows; yi += 1) {
          const y = lerp(-1.28, 1.35, yi / rows)
          for (let ai = 0; ai < sides; ai += 1) {
            const angle = (ai / sides) * Math.PI * 2
            const point = surfacePoint(y, angle)
            const sin = Math.sin(angle)
            const jitter = sin > 0 ? 0.0022 : 0.003
            point.x += (random() - 0.5) * jitter
            point.y += (random() - 0.5) * jitter
            point.z += (random() - 0.5) * jitter
            const target = sin > -0.08 ? facePositions : rearPositions
            target.push(point.x, point.y, point.z)
          }
        }

        const faceGeometry = new THREE.BufferGeometry()
        faceGeometry.setAttribute('position', new THREE.Float32BufferAttribute(facePositions, 3))
        geometries.push(faceGeometry)
        portrait.add(new THREE.Points(faceGeometry, skinPointMaterial))

        const rearGeometry = new THREE.BufferGeometry()
        rearGeometry.setAttribute('position', new THREE.Float32BufferAttribute(rearPositions, 3))
        geometries.push(rearGeometry)
        portrait.add(new THREE.Points(rearGeometry, rearPointMaterial))

        const makeLine = (points, material = featureMaterial, closed = false) => {
          const geometry = new THREE.BufferGeometry().setFromPoints(points)
          geometries.push(geometry)
          return closed ? new THREE.LineLoop(geometry, material) : new THREE.Line(geometry, material)
        }

        const contourLevels = [-1.0, -0.62, -0.18, 0.32, 0.76, 1.08]
        contourLevels.forEach((y) => {
          const points = []
          const samples = 150
          for (let i = 0; i < samples; i += 1) {
            points.push(surfacePoint(y, (i / samples) * Math.PI * 2))
          }
          portrait.add(makeLine(points, scanMaterial, true))
        })

        const profileAngles = [0.1, Math.PI * 0.5, Math.PI - 0.1, Math.PI * 1.5]
        profileAngles.forEach((angle) => {
          const points = []
          for (let i = 0; i <= 68; i += 1) {
            points.push(surfacePoint(lerp(-1.16, 1.28, i / 68), angle))
          }
          portrait.add(makeLine(points, scanMaterial))
        })

        const superellipseLoop = (cx, cy, width, height, z, rotation = 0) => {
          const points = []
          const samples = 96
          const exponent = 0.54
          for (let i = 0; i < samples; i += 1) {
            const a = (i / samples) * Math.PI * 2
            const c = Math.cos(a)
            const s = Math.sin(a)
            const lx = Math.sign(c) * Math.pow(Math.abs(c), exponent) * width * 0.5
            const ly = Math.sign(s) * Math.pow(Math.abs(s), exponent) * height * 0.5
            const rx = lx * Math.cos(rotation) - ly * Math.sin(rotation)
            const ry = lx * Math.sin(rotation) + ly * Math.cos(rotation)
            points.push(new THREE.Vector3(cx + rx, cy + ry, z))
          }
          return points
        }

        const glasses = new THREE.Group()
        const glassesY = 0.22
        const glassesZ = 0.755
        const frameWidth = 0.61
        const frameHeight = 0.41
        glasses.add(
          makeLine(superellipseLoop(-0.34, glassesY, frameWidth, frameHeight, glassesZ, -0.018), featureMaterial, true)
        )
        glasses.add(
          makeLine(superellipseLoop(0.34, glassesY, frameWidth, frameHeight, glassesZ, 0.018), featureMaterial, true)
        )
        glasses.add(
          makeLine([
            new THREE.Vector3(-0.045, 0.225, glassesZ + 0.012),
            new THREE.Vector3(0, 0.245, glassesZ + 0.018),
            new THREE.Vector3(0.045, 0.225, glassesZ + 0.012),
          ])
        )
        ;[-1, 1].forEach((side) => {
          const temple = new THREE.CatmullRomCurve3([
            new THREE.Vector3(side * 0.65, 0.24, 0.71),
            new THREE.Vector3(side * 0.78, 0.24, 0.58),
            new THREE.Vector3(side * 0.84, 0.2, 0.34),
            new THREE.Vector3(side * 0.84, 0.09, 0.08),
          ])
          glasses.add(makeLine(temple.getPoints(28)))
        })
        portrait.add(glasses)

        const eyePositions = []
        ;[-1, 1].forEach((side) => {
          for (let i = 0; i < 18; i += 1) {
            const a = (i / 18) * Math.PI * 2
            eyePositions.push(
              side * 0.335 + Math.cos(a) * 0.035,
              0.245 + Math.sin(a) * 0.017,
              0.77
            )
          }
        })
        const eyeGeometry = new THREE.BufferGeometry()
        eyeGeometry.setAttribute('position', new THREE.Float32BufferAttribute(eyePositions, 3))
        geometries.push(eyeGeometry)
        portrait.add(new THREE.Points(eyeGeometry, darkPointMaterial))

        ;[-1, 1].forEach((side) => {
          const brow = new THREE.CatmullRomCurve3([
            new THREE.Vector3(side * 0.55, 0.47, 0.69),
            new THREE.Vector3(side * 0.4, 0.505, 0.755),
            new THREE.Vector3(side * 0.2, 0.48, 0.78),
          ])
          portrait.add(makeLine(brow.getPoints(26), softFeatureMaterial))
        })

        const noseProfile = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-0.012, 0.43, 0.76),
          new THREE.Vector3(-0.012, 0.22, 0.88),
          new THREE.Vector3(-0.008, -0.02, 0.98),
          new THREE.Vector3(0.01, -0.14, 1.01),
          new THREE.Vector3(0.11, -0.2, 0.89),
        ])
        portrait.add(makeLine(noseProfile.getPoints(38), softFeatureMaterial))

        const noseBase = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-0.18, -0.2, 0.82),
          new THREE.Vector3(-0.08, -0.23, 0.9),
          new THREE.Vector3(0, -0.215, 0.93),
          new THREE.Vector3(0.08, -0.23, 0.9),
          new THREE.Vector3(0.18, -0.2, 0.82),
        ])
        portrait.add(makeLine(noseBase.getPoints(30), softFeatureMaterial))

        const upperLip = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-0.25, -0.43, 0.69),
          new THREE.Vector3(-0.12, -0.455, 0.76),
          new THREE.Vector3(0, -0.445, 0.79),
          new THREE.Vector3(0.12, -0.455, 0.76),
          new THREE.Vector3(0.25, -0.43, 0.69),
        ])
        const lowerLip = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-0.23, -0.5, 0.7),
          new THREE.Vector3(0, -0.54, 0.78),
          new THREE.Vector3(0.23, -0.5, 0.7),
        ])
        portrait.add(makeLine(upperLip.getPoints(34), softFeatureMaterial))
        portrait.add(makeLine(lowerLip.getPoints(28), scanMaterial))

        ;[-1, 1].forEach((side) => {
          const earPoints = []
          const samples = 76
          for (let i = 0; i < samples; i += 1) {
            const a = (i / samples) * Math.PI * 2
            const x = side * 0.855
            const y = 0.03 + Math.sin(a) * 0.29
            const z = 0.02 + Math.cos(a) * 0.14
            earPoints.push(new THREE.Vector3(x, y, z))
          }
          portrait.add(makeLine(earPoints, softFeatureMaterial, true))

          const inner = new THREE.CatmullRomCurve3([
            new THREE.Vector3(side * 0.858, 0.17, 0.08),
            new THREE.Vector3(side * 0.862, 0.03, 0.13),
            new THREE.Vector3(side * 0.86, -0.1, 0.08),
          ])
          portrait.add(makeLine(inner.getPoints(22), scanMaterial))
        })

        const stubblePositions = []
        for (let i = 0; i < 900; i += 1) {
          const y = lerp(-0.76, -0.24, random())
          const x = lerp(-0.44, 0.44, random())
          const beardMask = 1 - Math.pow(Math.abs(x) / 0.48, 2)
          if (random() > clamp(beardMask, 0, 1)) continue
          const frontPoint = surfacePoint(y, Math.PI * 0.5)
          stubblePositions.push(
            x,
            y,
            frontPoint.z + 0.014 + (random() - 0.5) * 0.008
          )
        }
        for (let i = 0; i < 360; i += 1) {
          const side = random() < 0.5 ? -1 : 1
          const u = random()
          stubblePositions.push(
            side * (0.02 + u * 0.25),
            -0.31 - 0.06 * u + (random() - 0.5) * 0.035,
            0.81 - 0.06 * u + (random() - 0.5) * 0.012
          )
        }
        const stubbleGeometry = new THREE.BufferGeometry()
        stubbleGeometry.setAttribute('position', new THREE.Float32BufferAttribute(stubblePositions, 3))
        geometries.push(stubbleGeometry)
        portrait.add(new THREE.Points(stubbleGeometry, stubbleMaterial))

        const hairGroup = new THREE.Group()
        const sideHairPositions = []
        for (const side of [-1, 1]) {
          for (let i = 0; i < 900; i += 1) {
            const y = lerp(0.42, 1.03, random())
            const angle = side < 0
              ? lerp(Math.PI * 0.83, Math.PI * 1.2, random())
              : lerp(-0.2, Math.PI * 0.17, random())
            const p = surfacePoint(y, angle)
            p.x *= 1.018
            p.z *= 1.02
            sideHairPositions.push(p.x, p.y, p.z)
          }
        }
        const sideHairGeometry = new THREE.BufferGeometry()
        sideHairGeometry.setAttribute('position', new THREE.Float32BufferAttribute(sideHairPositions, 3))
        geometries.push(sideHairGeometry)
        hairGroup.add(new THREE.Points(sideHairGeometry, hairPointMaterial))

        const topHairPositions = []
        for (let i = 0; i < 2200; i += 1) {
          const u = random()
          const v = random()
          const sweep = Math.pow(u, 0.72)
          const x = lerp(-0.42, 0.67, sweep) + (v - 0.5) * 0.16
          const crown = 1 - Math.pow(clamp((x + 0.05) / 0.85, -1, 1), 2)
          const y = 1.12 + 0.26 * Math.max(0, crown) + 0.15 * (1 - sweep) + (random() - 0.5) * 0.035
          const z = 0.26 + 0.44 * (1 - sweep) + (random() - 0.5) * 0.06
          topHairPositions.push(x, y, z)
        }
        const topHairGeometry = new THREE.BufferGeometry()
        topHairGeometry.setAttribute('position', new THREE.Float32BufferAttribute(topHairPositions, 3))
        geometries.push(topHairGeometry)
        hairGroup.add(new THREE.Points(topHairGeometry, hairPointMaterial))

        const strandCount = 46
        for (let i = 0; i < strandCount; i += 1) {
          const f = i / Math.max(1, strandCount - 1)
          const startX = lerp(-0.52, 0.18, f)
          const startY = lerp(0.77, 0.94, f)
          const startZ = 0.61 - f * 0.08
          const endX = lerp(0.3, 0.75, f)
          const curve = new THREE.CatmullRomCurve3([
            new THREE.Vector3(startX, startY, startZ),
            new THREE.Vector3(startX - 0.05, 1.18 + f * 0.06, 0.62),
            new THREE.Vector3(lerp(-0.12, 0.36, f), 1.43 - f * 0.05, 0.45),
            new THREE.Vector3(endX, 1.28 - f * 0.13, 0.12),
          ])
          hairGroup.add(makeLine(curve.getPoints(40), hairLineMaterial))
        }
        portrait.add(hairGroup)

        const neckLeft = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-0.39, -1.06, -0.02),
          new THREE.Vector3(-0.41, -1.3, -0.08),
          new THREE.Vector3(-0.64, -1.5, -0.11),
          new THREE.Vector3(-1.16, -1.58, -0.12),
        ])
        const neckRight = new THREE.CatmullRomCurve3([
          new THREE.Vector3(0.39, -1.06, -0.02),
          new THREE.Vector3(0.41, -1.3, -0.08),
          new THREE.Vector3(0.64, -1.5, -0.11),
          new THREE.Vector3(1.16, -1.58, -0.12),
        ])
        portrait.add(makeLine(neckLeft.getPoints(30), scanMaterial))
        portrait.add(makeLine(neckRight.getPoints(30), scanMaterial))

        const datum = makeLine([
          new THREE.Vector3(-1.28, -1.62, -0.14),
          new THREE.Vector3(1.28, -1.62, -0.14),
        ], scanMaterial)
        portrait.add(datum)

        const resize = () => {
          const rect = root.getBoundingClientRect()
          const width = Math.max(1, Math.round(rect.width))
          const height = Math.max(1, Math.round(rect.height))
          renderer.setSize(width, height, false)
          camera.aspect = width / height
          camera.updateProjectionMatrix()
        }

        const resizeObserver = new ResizeObserver(resize)
        resizeObserver.observe(root)
        resize()

        let isVisible = true
        let isDocumentVisible = !document.hidden
        let animationFrame = 0

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting)
          },
          { rootMargin: '160px' }
        )
        intersectionObserver.observe(root)

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden
        }
        document.addEventListener('visibilitychange', handleVisibility)

        const animate = (time) => {
          animationFrame = requestAnimationFrame(animate)
          if (!isVisible || !isDocumentVisible) return
          controls.update()

          if (!reducedMotion) {
            portrait.position.y = 0.04 + Math.sin(time * 0.0007) * 0.006
            hairGroup.rotation.z = Math.sin(time * 0.00045) * 0.002
          }

          renderer.render(scene, camera)
        }
        animationFrame = requestAnimationFrame(animate)

        window.addEventListener(
          'pagehide',
          () => {
            cancelAnimationFrame(animationFrame)
            resizeObserver.disconnect()
            intersectionObserver.disconnect()
            document.removeEventListener('visibilitychange', handleVisibility)
            controls.dispose()
            geometries.forEach((geometry) => geometry.dispose())
            materials.forEach((material) => material.dispose())
            renderer.dispose()
          },
          { once: true }
        )
      } catch (error) {
        console.error('Point portrait failed to initialize', error)
      }
    })
  })()
</script>
