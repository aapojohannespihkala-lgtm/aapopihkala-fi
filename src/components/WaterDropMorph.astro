---
interface Props {
  class?: string
  autoRotate?: boolean
  enableZoom?: boolean
  animate?: boolean
  scale?: number
  cameraDistance?: number
}

const {
  class: className,
  autoRotate = true,
  enableZoom = true,
  animate = true,
  scale = 1,
  cameraDistance = 6.8,
} = Astro.props
---

<div
  class:list={['water-drop-morph', className]}
  data-water-drop-morph
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-animate={animate ? 'true' : 'false'}
  data-scale={scale}
  data-camera-distance={cameraDistance}
  aria-hidden="true"
>
  <canvas class="water-drop-morph__canvas" data-water-drop-morph-canvas></canvas>
</div>

<style>
  .water-drop-morph {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 260px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .water-drop-morph:active {
    cursor: grabbing;
  }

  .water-drop-morph__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script>
  import { THREE, OrbitControls } from '../scripts/threeRuntime'

  (() => {
    const roots = document.querySelectorAll<HTMLElement>('[data-water-drop-morph]')

    roots.forEach(async (root) => {
      if (root.dataset.waterDropMorphInitialized === 'true') return
      root.dataset.waterDropMorphInitialized = 'true'

      const canvas = root.querySelector<HTMLCanvasElement>('[data-water-drop-morph-canvas]')
      if (!canvas) return

      try {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const wantsAutoRotate = root.dataset.autoRotate !== 'false'
        const wantsZoom = root.dataset.enableZoom !== 'false'
        const wantsAnimation = root.dataset.animate !== 'false' && !reducedMotion
        const requestedScale = Number(root.dataset.scale ?? '1')
        const requestedCameraDistance = Number(root.dataset.cameraDistance ?? '6.8')
        const displayScale = Number.isFinite(requestedScale) ? requestedScale : 1
        const cameraDistance = Number.isFinite(requestedCameraDistance)
          ? requestedCameraDistance
          : 6.8

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        })
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6))
        renderer.setClearColor(0xffffff, 0)

        const scene = new THREE.Scene()
        const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100)
        camera.position.set(3.15, 1.65, cameraDistance)

        const specimen = new THREE.Group()
        specimen.scale.setScalar(displayScale)
        specimen.rotation.x = -0.025
        specimen.rotation.y = -0.12
        specimen.rotation.z = 0.018
        scene.add(specimen)

        const controls = new OrbitControls(camera, renderer.domElement)
        controls.enablePan = false
        controls.enableZoom = wantsZoom
        controls.enableDamping = true
        controls.dampingFactor = 0.055
        controls.rotateSpeed = 0.5
        controls.target.set(0, 0.02, 0)
        controls.autoRotate = wantsAutoRotate && !reducedMotion
        controls.autoRotateSpeed = 0.13

        if (wantsZoom) {
          controls.minDistance = 5.6
          controls.maxDistance = 9.6
          controls.zoomSpeed = 0.5
        } else {
          const lockedDistance = camera.position.length()
          controls.minDistance = lockedDistance
          controls.maxDistance = lockedDistance
        }

        const shellMaterial = new THREE.PointsMaterial({
          color: 0x353832,
          size: 0.03,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.8,
        })

        const pointCount = 470
        const shellPositions = new Float32Array(pointCount * 3)
        const basePositions = new Float32Array(pointCount * 3)
        const surfaceDirections = new Float32Array(pointCount * 3)
        const goldenAngle = Math.PI * (3 - Math.sqrt(5))

        for (let i = 0; i < pointCount; i += 1) {
          const offset = i * 3
          const sy = 1 - 2 * ((i + 0.5) / pointCount)
          const horizontalRadius = Math.sqrt(Math.max(0, 1 - sy * sy))
          const theta = i * goldenAngle
          const sx = Math.cos(theta) * horizontalRadius
          const sz = Math.sin(theta) * horizontalRadius

          const pearBias = 1 - 0.025 * sy
          const x = sx * 0.76 * pearBias
          const y = sy * 0.84 - 0.012 * (1 - sy * sy)
          const z = sz * 0.72 * pearBias

          basePositions[offset] = x
          basePositions[offset + 1] = y
          basePositions[offset + 2] = z

          shellPositions[offset] = x
          shellPositions[offset + 1] = y
          shellPositions[offset + 2] = z

          surfaceDirections[offset] = sx
          surfaceDirections[offset + 1] = sy
          surfaceDirections[offset + 2] = sz
        }

        const shellGeometry = new THREE.BufferGeometry()
        const shellAttribute = new THREE.BufferAttribute(shellPositions, 3)
        shellAttribute.setUsage(THREE.DynamicDrawUsage)
        shellGeometry.setAttribute('position', shellAttribute)
        specimen.add(new THREE.Points(shellGeometry, shellMaterial))

        const updateShape = (timeSeconds: number) => {
          const primaryPulse = wantsAnimation ? Math.sin(timeSeconds * 0.34) : 0
          const secondaryPulse = wantsAnimation ? Math.sin(timeSeconds * 0.21 + 1.35) : 0
          const tertiaryPulse = wantsAnimation ? Math.cos(timeSeconds * 0.27 - 0.7) : 0

          const stretchY = 1 + 0.09 * primaryPulse + 0.018 * secondaryPulse
          const stretchX = 1 - 0.052 * primaryPulse + 0.016 * tertiaryPulse
          const stretchZ = 1 - 0.042 * primaryPulse - 0.014 * secondaryPulse

          for (let i = 0; i < pointCount; i += 1) {
            const offset = i * 3
            const baseX = basePositions[offset]
            const baseY = basePositions[offset + 1]
            const baseZ = basePositions[offset + 2]
            const sx = surfaceDirections[offset]
            const sy = surfaceDirections[offset + 1]
            const sz = surfaceDirections[offset + 2]

            const radius = Math.sqrt(
              baseX * baseX +
              baseY * baseY +
              baseZ * baseZ
            ) || 1

            const nx = baseX / radius
            const ny = baseY / radius
            const nz = baseZ / radius
            const azimuth = Math.atan2(sz, sx)
            const latitude = Math.asin(THREE.MathUtils.clamp(sy, -1, 1))
            const bodyMask = Math.pow(Math.max(0, 1 - Math.abs(sy)), 0.52)
            const broadMask = 0.18 + 0.82 * bodyMask

            const surfaceOffset = wantsAnimation
              ? broadMask * (
                  0.052 * Math.sin(
                    azimuth * 2.0 +
                    latitude * 1.35 +
                    timeSeconds * 1.02
                  ) +
                  0.031 * Math.cos(
                    azimuth * 3.2 -
                    latitude * 2.15 -
                    timeSeconds * 0.84
                  ) +
                  0.019 * Math.sin(
                    azimuth * 5.1 +
                    latitude * 2.0 +
                    timeSeconds * 1.54
                  ) +
                  0.014 * Math.cos(
                    azimuth * 7.0 -
                    latitude * 2.7 +
                    timeSeconds * 1.92
                  ) +
                  0.018 * Math.sin(
                    latitude * 7.4 +
                    azimuth * 1.15 -
                    timeSeconds * 1.38
                  )
                )
              : 0

            const radialScale = (radius + surfaceOffset) / radius
            const capDamping = 0.5 + 0.5 * bodyMask
            const localStretchY = 1 + (stretchY - 1) * capDamping
            const localStretchX = 1 + (stretchX - 1) * (0.64 + 0.36 * bodyMask)
            const localStretchZ = 1 + (stretchZ - 1) * (0.64 + 0.36 * bodyMask)
            const bodyBulge = wantsAnimation
              ? 1 + 0.065 * secondaryPulse * bodyMask
              : 1
            const softAsymmetry = wantsAnimation
              ? 1 + 0.016 * tertiaryPulse * sy * bodyMask
              : 1

            shellPositions[offset] =
              baseX * radialScale * localStretchX * bodyBulge
            shellPositions[offset + 1] =
              baseY * radialScale * localStretchY * softAsymmetry
            shellPositions[offset + 2] =
              baseZ * radialScale * localStretchZ * bodyBulge
          }

          shellAttribute.needsUpdate = true

          if (wantsAnimation) {
            specimen.position.y = 0.018 * Math.sin(timeSeconds * 0.3)
            specimen.rotation.z = 0.018 + 0.007 * Math.sin(timeSeconds * 0.23)
            specimen.rotation.x = -0.025 + 0.005 * Math.sin(timeSeconds * 0.2 + 0.8)
          }
        }

        const resize = () => {
          const rect = root.getBoundingClientRect()
          const width = Math.max(1, Math.round(rect.width))
          const height = Math.max(1, Math.round(rect.height))
          renderer.setSize(width, height, false)
          camera.aspect = width / height
          camera.updateProjectionMatrix()
        }

        const resizeObserver = new ResizeObserver(resize)
        resizeObserver.observe(root)
        resize()

        let isVisible = true
        let isDocumentVisible = !document.hidden
        let animationFrame = 0

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting)
          },
          { rootMargin: '160px' }
        )
        intersectionObserver.observe(root)

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden
        }
        document.addEventListener('visibilitychange', handleVisibility)

        const animateFrame = (time: number) => {
          animationFrame = requestAnimationFrame(animateFrame)
          if (!isVisible || !isDocumentVisible) return

          controls.update()
          updateShape(time * 0.001)
          renderer.render(scene, camera)
        }

        updateShape(0)
        animationFrame = requestAnimationFrame(animateFrame)

        const cleanup = () => {
          cancelAnimationFrame(animationFrame)
          document.removeEventListener('visibilitychange', handleVisibility)
          resizeObserver.disconnect()
          intersectionObserver.disconnect()
          controls.dispose()
          shellGeometry.dispose()
          shellMaterial.dispose()
          renderer.dispose()
        }

        window.addEventListener('pagehide', cleanup, { once: true })
      } catch (error) {
        console.error('WaterDropMorph failed to initialize:', error)
      }
    })
  })()
</script>
