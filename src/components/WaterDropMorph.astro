---
interface Props {
  class?: string
  autoRotate?: boolean
  enableZoom?: boolean
  animate?: boolean
  scale?: number
  cameraDistance?: number
}

const {
  class: className,
  autoRotate = true,
  enableZoom = true,
  animate = true,
  scale = 1,
  cameraDistance = 6.8,
} = Astro.props
---

<div
  class:list={['water-drop-morph', className]}
  data-water-drop-morph
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-animate={animate ? 'true' : 'false'}
  data-scale={scale}
  data-camera-distance={cameraDistance}
  aria-hidden="true"
>
  <canvas class="water-drop-morph__canvas" data-water-drop-morph-canvas></canvas>
</div>

<style>
  .water-drop-morph {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 260px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .water-drop-morph:active {
    cursor: grabbing;
  }

  .water-drop-morph__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-water-drop-morph]')

    roots.forEach(async (root) => {
      if (root.dataset.waterDropMorphInitialized === 'true') return
      root.dataset.waterDropMorphInitialized = 'true'

      const canvas = root.querySelector('[data-water-drop-morph-canvas]')
      if (!canvas) return

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm')
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        )

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const wantsAutoRotate = root.dataset.autoRotate !== 'false'
        const wantsZoom = root.dataset.enableZoom !== 'false'
        const wantsAnimation = root.dataset.animate !== 'false' && !reducedMotion
        const requestedScale = Number(root.dataset.scale ?? '1')
        const requestedCameraDistance = Number(root.dataset.cameraDistance ?? '6.8')
        const displayScale = Number.isFinite(requestedScale) ? requestedScale : 1
        const cameraDistance = Number.isFinite(requestedCameraDistance)
          ? requestedCameraDistance
          : 6.8

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        })
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6))
        renderer.setClearColor(0xffffff, 0)

        const scene = new THREE.Scene()
        const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100)
        camera.position.set(3.15, 1.65, cameraDistance)

        const specimen = new THREE.Group()
        specimen.scale.setScalar(displayScale)
        specimen.rotation.x = -0.025
        specimen.rotation.y = -0.12
        specimen.rotation.z = 0.018
        scene.add(specimen)

        const controls = new OrbitControls(camera, renderer.domElement)
        controls.enablePan = false
        controls.enableZoom = wantsZoom
        controls.enableDamping = true
        controls.dampingFactor = 0.055
        controls.rotateSpeed = 0.5
        controls.minPolarAngle = Math.PI * 0.25
        controls.maxPolarAngle = Math.PI * 0.72
        controls.target.set(0, 0.02, 0)
        controls.autoRotate = wantsAutoRotate && !reducedMotion
        controls.autoRotateSpeed = 0.13

        if (wantsZoom) {
          controls.minDistance = 5.6
          controls.maxDistance = 9.6
          controls.zoomSpeed = 0.5
        } else {
          const lockedDistance = camera.position.length()
          controls.minDistance = lockedDistance
          controls.maxDistance = lockedDistance
        }

        const shellMaterial = new THREE.PointsMaterial({
          color: 0x353832,
          size: 0.027,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.76,
        })

        const lineMaterials = [
          new THREE.LineBasicMaterial({
            color: 0x59695d,
            transparent: true,
            opacity: 0.32,
          }),
          new THREE.LineBasicMaterial({
            color: 0x69756b,
            transparent: true,
            opacity: 0.17,
          }),
        ]

        const latSteps = 64
        const lonSteps = 72
        const ringPointCount = (latSteps - 1) * lonSteps
        const topPoleIndex = ringPointCount
        const bottomPoleIndex = ringPointCount + 1
        const pointCount = ringPointCount + 2

        const shellPositions = new Float32Array(pointCount * 3)
        const basePositions = new Float32Array(pointCount * 3)

        const indexOf = (lat, lon) => (lat - 1) * lonSteps + lon

        const writePoint = (index, x, y, z) => {
          const offset = index * 3
          basePositions[offset] = x
          basePositions[offset + 1] = y
          basePositions[offset + 2] = z
          shellPositions[offset] = x
          shellPositions[offset + 1] = y
          shellPositions[offset + 2] = z
        }

        for (let lat = 1; lat < latSteps; lat += 1) {
          const phi = (lat / latSteps) * Math.PI
          const sinPhi = Math.sin(phi)
          const cosPhi = Math.cos(phi)

          const pearBias = 1 - 0.08 * cosPhi
          const radiusX = 0.74 * sinPhi * pearBias
          const radiusZ = 0.70 * sinPhi * pearBias
          const y = cosPhi * 0.92 - 0.035 * (1 - cosPhi * cosPhi)

          for (let lon = 0; lon < lonSteps; lon += 1) {
            const theta = (lon / lonSteps) * Math.PI * 2
            const index = indexOf(lat, lon)

            writePoint(
              index,
              Math.cos(theta) * radiusX,
              y,
              Math.sin(theta) * radiusZ
            )
          }
        }

        writePoint(topPoleIndex, 0, 0.92, 0)
        writePoint(bottomPoleIndex, 0, -0.92, 0)

        const shellGeometry = new THREE.BufferGeometry()
        const shellAttribute = new THREE.BufferAttribute(shellPositions, 3)
        shellAttribute.setUsage(THREE.DynamicDrawUsage)
        shellGeometry.setAttribute('position', shellAttribute)
        specimen.add(new THREE.Points(shellGeometry, shellMaterial))

        const guideGeometries = []
        const guides = []

        const makeGuide = (indices, materialIndex = 0, closed = false) => {
          const array = new Float32Array(indices.length * 3)
          const geometry = new THREE.BufferGeometry()
          const attribute = new THREE.BufferAttribute(array, 3)
          attribute.setUsage(THREE.DynamicDrawUsage)
          geometry.setAttribute('position', attribute)

          const line = closed
            ? new THREE.LineLoop(geometry, lineMaterials[materialIndex])
            : new THREE.Line(geometry, lineMaterials[materialIndex])

          specimen.add(line)
          guideGeometries.push(geometry)
          guides.push({ indices, array, attribute })
        }

        ;[14, 24, 34, 44, 54].forEach((lat, i) => {
          const indices = []
          for (let lon = 0; lon < lonSteps; lon += 1) {
            indices.push(indexOf(lat, lon))
          }
          makeGuide(indices, i % 2 === 0 ? 0 : 1, true)
        })

        ;[0, 12, 24, 36, 48, 60].forEach((lon, i) => {
          const indices = [topPoleIndex]
          for (let lat = 1; lat < latSteps; lat += 1) {
            indices.push(indexOf(lat, lon))
          }
          indices.push(bottomPoleIndex)
          makeGuide(indices, i % 2 === 0 ? 0 : 1, false)
        })

        const updateShape = (timeSeconds) => {
          for (let i = 0; i < pointCount; i += 1) {
            const offset = i * 3
            const baseX = basePositions[offset]
            const baseY = basePositions[offset + 1]
            const baseZ = basePositions[offset + 2]

            const radius = Math.sqrt(
              baseX * baseX +
              baseY * baseY +
              baseZ * baseZ
            ) || 1

            const nx = baseX / radius
            const ny = baseY / radius
            const nz = baseZ / radius
            const azimuth = Math.atan2(nz, nx)
            const latitude = Math.asin(THREE.MathUtils.clamp(ny, -1, 1))
            const equatorMask = Math.pow(Math.max(0, 1 - Math.abs(ny)), 0.5)
            const broadMask = 0.3 + 0.7 * equatorMask

            const surfaceOffset = wantsAnimation
              ? broadMask * (
                  0.018 * Math.sin(
                    azimuth * 2.0 +
                    latitude * 1.4 +
                    timeSeconds * 0.62
                  ) +
                  0.010 * Math.cos(
                    azimuth * 3.1 -
                    latitude * 2.1 -
                    timeSeconds * 0.47
                  ) +
                  0.006 * Math.sin(
                    azimuth * 5.0 +
                    latitude * 1.8 +
                    timeSeconds * 0.95
                  ) +
                  0.008 * Math.sin(
                    latitude * 5.2 +
                    azimuth * 0.8 -
                    timeSeconds * 0.82
                  )
                )
              : 0

            const radialScale = (radius + surfaceOffset) / radius

            shellPositions[offset] = baseX * radialScale
            shellPositions[offset + 1] = baseY * radialScale
            shellPositions[offset + 2] = baseZ * radialScale
          }

          shellAttribute.needsUpdate = true

          guides.forEach(({ indices, array, attribute }) => {
            indices.forEach((pointIndex, guideIndex) => {
              const source = pointIndex * 3
              const target = guideIndex * 3
              array[target] = shellPositions[source]
              array[target + 1] = shellPositions[source + 1]
              array[target + 2] = shellPositions[source + 2]
            })
            attribute.needsUpdate = true
          })

          if (wantsAnimation) {
            specimen.position.y = 0.018 * Math.sin(timeSeconds * 0.3)
            specimen.rotation.z = 0.018 + 0.007 * Math.sin(timeSeconds * 0.23)
            specimen.rotation.x = -0.025 + 0.005 * Math.sin(timeSeconds * 0.2 + 0.8)
          }
        }

        const resize = () => {
          const rect = root.getBoundingClientRect()
          const width = Math.max(1, Math.round(rect.width))
          const height = Math.max(1, Math.round(rect.height))
          renderer.setSize(width, height, false)
          camera.aspect = width / height
          camera.updateProjectionMatrix()
        }

        const resizeObserver = new ResizeObserver(resize)
        resizeObserver.observe(root)
        resize()

        let isVisible = true
        let isDocumentVisible = !document.hidden
        let animationFrame = 0

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting)
          },
          { rootMargin: '160px' }
        )
        intersectionObserver.observe(root)

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden
        }
        document.addEventListener('visibilitychange', handleVisibility)

        const animateFrame = (time) => {
          animationFrame = requestAnimationFrame(animateFrame)
          if (!isVisible || !isDocumentVisible) return

          controls.update()
          updateShape(time * 0.001)
          renderer.render(scene, camera)
        }

        updateShape(0)
        animationFrame = requestAnimationFrame(animateFrame)

        const cleanup = () => {
          cancelAnimationFrame(animationFrame)
          document.removeEventListener('visibilitychange', handleVisibility)
          resizeObserver.disconnect()
          intersectionObserver.disconnect()
          controls.dispose()
          shellGeometry.dispose()
          guideGeometries.forEach((geometry) => geometry.dispose())
          shellMaterial.dispose()
          lineMaterials.forEach((material) => material.dispose())
          renderer.dispose()
        }

        window.addEventListener('pagehide', cleanup, { once: true })
      } catch (error) {
        console.error('WaterDropMorph failed to initialize:', error)
      }
    })
  })()
</script>
