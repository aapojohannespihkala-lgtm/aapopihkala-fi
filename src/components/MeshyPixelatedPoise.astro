<div class="meshy-model" data-meshy-model aria-label="Pyöriteltävä Meshy 3D-malli">
  <canvas class="meshy-model__canvas" data-meshy-model-canvas></canvas>
  <p class="meshy-model__status" data-meshy-model-status>Ladataan 3D-mallia...</p>
</div>

<style>
  .meshy-model {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 420px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .meshy-model:active { cursor: grabbing; }

  .meshy-model__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }

  .meshy-model__status {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: 0;
    color: var(--stone-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .meshy-model__status[hidden] { display: none; }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-meshy-model]');

    roots.forEach(async (root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.meshyModelInitialized === 'true') return;
      root.dataset.meshyModelInitialized = 'true';

      const canvas = root.querySelector('[data-meshy-model-canvas]');
      const status = root.querySelector('[data-meshy-model-status]');
      if (!(canvas instanceof HTMLCanvasElement)) return;

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        );
        const { GLTFLoader } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/loaders/GLTFLoader.js/+esm'
        );

        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.setClearColor(0x000000, 0);
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.15;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(36, 1, 0.01, 1000);
        const controls = new OrbitControls(camera, canvas);
        controls.enableDamping = true;
        controls.dampingFactor = 0.06;
        controls.enablePan = true;
        controls.enableZoom = true;
        controls.target.set(0, 0, 0);

        scene.add(new THREE.HemisphereLight(0xffffff, 0x77756f, 2.6));
        const keyLight = new THREE.DirectionalLight(0xffffff, 2.5);
        keyLight.position.set(4, 6, 5);
        scene.add(keyLight);
        const fillLight = new THREE.DirectionalLight(0xffffff, 1.2);
        fillLight.position.set(-4, 2, -3);
        scene.add(fillLight);
        const rimLight = new THREE.DirectionalLight(0xffffff, 1.0);
        rimLight.position.set(0, 3, -5);
        scene.add(rimLight);

        const visibleMaterial = new THREE.MeshStandardMaterial({
          color: 0x66766b,
          roughness: 0.76,
          metalness: 0.02,
          side: THREE.DoubleSide,
        });

        const loader = new GLTFLoader();
        loader.load(
          '/lab/meshy-pixelated-poise.glb',
          (gltf) => {
            const model = gltf.scene;

            model.traverse((child) => {
              if (!(child instanceof THREE.Mesh)) return;
              if (child.geometry instanceof THREE.BufferGeometry && !child.geometry.getAttribute('normal')) {
                child.geometry.computeVertexNormals();
              }
              child.material = visibleMaterial;
            });

            scene.add(model);

            const box = new THREE.Box3().setFromObject(model);
            const center = box.getCenter(new THREE.Vector3());
            const size = box.getSize(new THREE.Vector3());
            model.position.sub(center);

            const radius = Math.max(size.x, size.y, size.z) * 0.5 || 1;
            camera.near = Math.max(radius / 1000, 0.001);
            camera.far = Math.max(radius * 100, 100);
            camera.position.set(radius * 1.7, radius * 0.85, radius * 2.0);
            camera.updateProjectionMatrix();

            controls.target.set(0, 0, 0);
            controls.minDistance = Math.max(radius * 0.18, 0.01);
            controls.maxDistance = radius * 12;
            controls.update();

            if (status instanceof HTMLElement) status.hidden = true;
          },
          undefined,
          (error) => {
            console.error('Pixelated Poise GLB load failed', error);
            if (status instanceof HTMLElement) status.textContent = '3D-mallia ei voitu ladata';
          }
        );

        const resize = () => {
          const width = Math.max(1, root.clientWidth);
          const height = Math.max(1, root.clientHeight);
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        const observer = new ResizeObserver(resize);
        observer.observe(root);
        resize();

        const animate = () => {
          controls.update();
          renderer.render(scene, camera);
          requestAnimationFrame(animate);
        };
        animate();
      } catch (error) {
        console.error('Pixelated Poise viewer failed', error);
        if (status instanceof HTMLElement) status.textContent = '3D-katselinta ei voitu ladata';
      }
    });
  })();
</script>
