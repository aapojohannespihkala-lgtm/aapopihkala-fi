<div
  class="hero-art"
  aria-hidden="true"
>
  <canvas
    class="topography-canvas"
    data-topography
  ></canvas>
</div>

<script>
  const canvases =
    document.querySelectorAll(
      '[data-topography]'
    );

  const reducedMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

  const cols = 108;
  const rows = 88;
  const contourCount = 54;

  const terrain = (
    x,
    y,
    phase
  ) => {
    const nx =
      x / (cols - 1);

    const ny =
      y / (rows - 1);

    const ridgeA =
      Math.sin(
        nx * 7.2 +
        Math.sin(
          ny * 4.6 +
          phase * 0.7
        ) *
          0.8 +
        phase
      ) * 0.26;

    const ridgeB =
      Math.cos(
        ny * 8.1 -
        Math.sin(
          nx * 5.1 -
          phase * 0.45
        ) *
          0.72 -
        phase * 0.68
      ) * 0.22;

    const ridgeC =
      Math.sin(
        (nx + ny) *
          9.6 +
        Math.sin(
          nx * 3.8 +
          ny * 2.4
        ) *
          1.15 +
        phase * 0.34
      ) * 0.13;

    const dx1 =
      nx - 0.34;

    const dy1 =
      ny - 0.42;

    const dx2 =
      nx - 0.72;

    const dy2 =
      ny - 0.63;

    const dx3 =
      nx - 0.57;

    const dy3 =
      ny - 0.22;

    const hill1 =
      Math.exp(
        -(
          dx1 *
            dx1 *
            9.5 +
          dy1 *
            dy1 *
            12
        )
      ) * 0.95;

    const hill2 =
      Math.exp(
        -(
          dx2 *
            dx2 *
            15 +
          dy2 *
            dy2 *
            10
        )
      ) * 0.68;

    const basin =
      Math.exp(
        -(
          dx3 *
            dx3 *
            19 +
          dy3 *
            dy3 *
            17
        )
      ) * -0.44;

    const warp =
      Math.sin(
        nx * 13.4 +
        ny * 5.2 +
        phase * 0.24
      ) * 0.055;

    return (
      ridgeA +
      ridgeB +
      ridgeC +
      hill1 +
      hill2 +
      basin +
      warp
    );
  };

  const interpolate = (
    a,
    b,
    level
  ) => {
    const delta =
      b - a;

    if (
      Math.abs(
        delta
      ) < 0.00001
    ) {
      return 0.5;
    }

    return (
      (level - a) /
      delta
    );
  };

  const drawContour = (
    ctx,
    values,
    level,
    width,
    height
  ) => {
    const cellWidth =
      width /
      (cols - 1);

    const cellHeight =
      height /
      (rows - 1);

    ctx.beginPath();

    const point = (
      edge,
      x,
      y,
      tl,
      tr,
      br,
      bl
    ) => {
      if (
        edge === 0
      ) {
        const t =
          interpolate(
            tl,
            tr,
            level
          );

        return [
          (x + t) *
            cellWidth,
          y *
            cellHeight,
        ];
      }

      if (
        edge === 1
      ) {
        const t =
          interpolate(
            tr,
            br,
            level
          );

        return [
          (x + 1) *
            cellWidth,
          (y + t) *
            cellHeight,
        ];
      }

      if (
        edge === 2
      ) {
        const t =
          interpolate(
            bl,
            br,
            level
          );

        return [
          (x + t) *
            cellWidth,
          (y + 1) *
            cellHeight,
        ];
      }

      const t =
        interpolate(
          tl,
          bl,
          level
        );

      return [
        x *
          cellWidth,
        (y + t) *
          cellHeight,
      ];
    };

    const connect = (
      edgeA,
      edgeB,
      x,
      y,
      tl,
      tr,
      br,
      bl
    ) => {
      const a =
        point(
          edgeA,
          x,
          y,
          tl,
          tr,
          br,
          bl
        );

      const b =
        point(
          edgeB,
          x,
          y,
          tl,
          tr,
          br,
          bl
        );

      ctx.moveTo(
        a[0],
        a[1]
      );

      ctx.lineTo(
        b[0],
        b[1]
      );
    };

    for (
      let y = 0;
      y < rows - 1;
      y += 1
    ) {
      for (
        let x = 0;
        x < cols - 1;
        x += 1
      ) {
        const tl =
          values[
            y *
              cols +
            x
          ];

        const tr =
          values[
            y *
              cols +
            x +
            1
          ];

        const br =
          values[
            (y + 1) *
              cols +
            x +
            1
          ];

        const bl =
          values[
            (y + 1) *
              cols +
            x
          ];

        const code =
          (tl >= level
            ? 8
            : 0) |
          (tr >= level
            ? 4
            : 0) |
          (br >= level
            ? 2
            : 0) |
          (bl >= level
            ? 1
            : 0);

        switch (
          code
        ) {
          case 1:
          case 14:
            connect(
              3,
              2,
              x,
              y,
              tl,
              tr,
              br,
              bl
            );
            break;

          case 2:
          case 13:
            connect(
              2,
              1,
              x,
              y,
              tl,
              tr,
              br,
              bl
            );
            break;

          case 3:
          case 12:
            connect(
              3,
              1,
              x,
              y,
              tl,
              tr,
              br,
              bl
            );
            break;

          case 4:
          case 11:
            connect(
              0,
              1,
              x,
              y,
              tl,
              tr,
              br,
              bl
            );
            break;

          case 5: {
            const center =
              (
                tl +
                tr +
                br +
                bl
              ) / 4;

            if (
              center >=
              level
            ) {
              connect(
                0,
                3,
                x,
                y,
                tl,
                tr,
                br,
                bl
              );

              connect(
                1,
                2,
                x,
                y,
                tl,
                tr,
                br,
                bl
              );
            } else {
              connect(
                0,
                1,
                x,
                y,
                tl,
                tr,
                br,
                bl
              );

              connect(
                3,
                2,
                x,
                y,
                tl,
                tr,
                br,
                bl
              );
            }

            break;
          }

          case 6:
          case 9:
            connect(
              0,
              2,
              x,
              y,
              tl,
              tr,
              br,
              bl
            );
            break;

          case 7:
          case 8:
            connect(
              0,
              3,
              x,
              y,
              tl,
              tr,
              br,
              bl
            );
            break;

          case 10: {
            const center =
              (
                tl +
                tr +
                br +
                bl
              ) / 4;

            if (
              center >=
              level
            ) {
              connect(
                0,
                1,
                x,
                y,
                tl,
                tr,
                br,
                bl
              );

              connect(
                3,
                2,
                x,
                y,
                tl,
                tr,
                br,
                bl
              );
            } else {
              connect(
                0,
                3,
                x,
                y,
                tl,
                tr,
                br,
                bl
              );

              connect(
                1,
                2,
                x,
                y,
                tl,
                tr,
                br,
                bl
              );
            }

            break;
          }
        }
      }
    }

    ctx.stroke();
  };

  const setupCanvas = (
    canvas
  ) => {
    const ctx =
      canvas.getContext(
        '2d'
      );

    if (!ctx) {
      return;
    }

    let frameId = 0;
    let lastFrame = 0;

    const draw = (
      time = 0
    ) => {
      const rect =
        canvas.getBoundingClientRect();

      const cssWidth =
        Math.max(
          1,
          rect.width
        );

      const cssHeight =
        Math.max(
          1,
          rect.height
        );

      const dpr =
        Math.min(
          window.devicePixelRatio ||
            1,
          2
        );

      const pixelWidth =
        Math.round(
          cssWidth *
            dpr
        );

      const pixelHeight =
        Math.round(
          cssHeight *
            dpr
        );

      if (
        canvas.width !==
          pixelWidth ||
        canvas.height !==
          pixelHeight
      ) {
        canvas.width =
          pixelWidth;

        canvas.height =
          pixelHeight;
      }

      ctx.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
      );

      ctx.clearRect(
        0,
        0,
        cssWidth,
        cssHeight
      );

      const phase =
        reducedMotion.matches
          ? 0.7
          : time *
            0.000225;

      const values =
        new Float32Array(
          cols *
            rows
        );

      let min =
        Infinity;

      let max =
        -Infinity;

      for (
        let y = 0;
        y < rows;
        y += 1
      ) {
        for (
          let x = 0;
          x < cols;
          x += 1
        ) {
          const value =
            terrain(
              x,
              y,
              phase
            );

          values[
            y *
              cols +
            x
          ] = value;

          if (
            value < min
          ) {
            min =
              value;
          }

          if (
            value > max
          ) {
            max =
              value;
          }
        }
      }

      ctx.lineCap =
        'round';

      ctx.lineJoin =
        'round';

      for (
        let i = 1;
        i <=
        contourCount;
        i += 1
      ) {
        const ratio =
          i /
          (
            contourCount +
            1
          );

        const level =
          min +
          (max - min) *
            ratio;

        const isTenth =
          i % 10 === 0;

        const isFifth =
          !isTenth &&
          i % 5 === 0;

        ctx.strokeStyle =
          isTenth
            ? 'rgba(73, 88, 77, 0.56)'
            : isFifth
              ? 'rgba(89, 105, 93, 0.40)'
              : 'rgba(89, 105, 93, 0.23)';

        ctx.lineWidth =
          isTenth
            ? 1.15
            : isFifth
              ? 0.82
              : 0.52;

        drawContour(
          ctx,
          values,
          level,
          cssWidth,
          cssHeight
        );
      }
    };

    const animate = (
      time
    ) => {
      if (
        reducedMotion.matches
      ) {
        draw(0);
        return;
      }

      if (
        time -
          lastFrame >=
        55
      ) {
        lastFrame =
          time;

        draw(
          time
        );
      }

      frameId =
        requestAnimationFrame(
          animate
        );
    };

    const restart =
      () => {
        cancelAnimationFrame(
          frameId
        );

        if (
          reducedMotion.matches
        ) {
          draw(0);
        } else {
          frameId =
            requestAnimationFrame(
              animate
            );
        }
      };

    const resizeObserver =
      new ResizeObserver(
        () => {
          draw(
            performance.now()
          );
        }
      );

    resizeObserver.observe(
      canvas
    );

    reducedMotion.addEventListener(
      'change',
      restart
    );

    restart();
  };

  canvases.forEach(
    setupCanvas
  );
</script>
