<style is:global>
  html body .hero-secondary.hero-concepts-ready {
    position: relative;
    overflow: visible;
  }

  html body .hero-wordfield {
    position: relative;
    display: inline-block;
    color: inherit;
    cursor: default;
    transition: color 120ms ease;
  }

  html body .hero-wordfield:hover,
  html body .hero-wordfield:focus-visible {
    color: var(--ink-soft);
    outline: none;
  }

  @media (max-width: 640px) {
    html body .hero-concept-line-break {
      display: none;
    }
  }

  @media (hover: none), (pointer: coarse) {
    html body .hero-wordfield {
      cursor: inherit;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html body .hero-wordfield {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const secondary = document.querySelector('.hero-secondary')
    if (!secondary) return
    if (secondary.dataset.heroConceptsInitialized === 'true') return

    const source = secondary.textContent ?? ''
    if (!source.trim()) return

    const language = document.documentElement.lang === 'fi' ? 'fi' : 'en'
    const keyWords = language === 'fi'
      ? new Set(['kaupunkien', 'ihmisten', 'luonnon'])
      : new Set(['cities', 'people', 'nature'])
    const breakAfterWord = language === 'fi' ? 'luonnon' : 'cities'

    const parts = source.split(/(\s+)/)
    const fragment = document.createDocumentFragment()

    parts.forEach((part) => {
      if (!part || /^\s+$/.test(part)) {
        fragment.append(document.createTextNode(part))
        return
      }

      const normalized = part
        .toLocaleLowerCase(language)
        .replace(/^[^\p{L}\p{N}]+|[^\p{L}\p{N}]+$/gu, '')

      if (!keyWords.has(normalized)) {
        fragment.append(document.createTextNode(part))
        return
      }

      const wrapper = document.createElement('span')
      wrapper.className = 'hero-wordfield'
      wrapper.tabIndex = 0
      wrapper.textContent = part
      fragment.append(wrapper)

      if (normalized === breakAfterWord) {
        const lineBreak = document.createElement('br')
        lineBreak.className = 'hero-concept-line-break'
        fragment.append(lineBreak)
      }
    })

    secondary.dataset.heroConceptsInitialized = 'true'
    secondary.classList.add('hero-concepts-ready')
    secondary.replaceChildren(fragment)
  })()
</script>
