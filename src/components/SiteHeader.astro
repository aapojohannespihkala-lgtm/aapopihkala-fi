---
interface Props {
  lang: 'fi' | 'en';
  languageHref: string;
}

const {
  lang,
  languageHref,
} = Astro.props;

const content = {
  fi: {
    navLabel: 'Päänavigaatio',
    homeHref: '/',
    homeLabel: 'Aapo Pihkalan etusivu',
    languageText: 'EN',
    languageLabel: 'English',
    languageCode: 'en',
    linkedinLabel: 'Aapo Pihkala LinkedInissä',
  },

  en: {
    navLabel: 'Main navigation',
    homeHref: '/en/',
    homeLabel: 'Aapo Pihkala homepage',
    languageText: 'FI',
    languageLabel: 'Suomeksi',
    languageCode: 'fi',
    linkedinLabel: 'Aapo Pihkala on LinkedIn',
  },
} as const;

const t = content[lang];
---

<header class="topbar">
  <nav
    class="topbar-inner"
    aria-label={t.navLabel}
  >
    <a
      class="topbar-name"
      href={t.homeHref}
      aria-label={t.homeLabel}
    >
      aapo
    </a>

    <div class="topbar-actions">
      <a
        class="language-switch"
        href={languageHref}
        hreflang={t.languageCode}
        lang={t.languageCode}
        aria-label={t.languageLabel}
      >
        {t.languageText}
      </a>

      <a
        class="linkedin-link"
        href="https://fi.linkedin.com/in/aapo-pihkala"
        target="_blank"
        rel="noopener"
        aria-label={t.linkedinLabel}
        title="LinkedIn"
      >
        <svg
          class="linkedin-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"
          />
        </svg>
      </a>
    </div>
  </nav>
</header>
