---
import {
  site,
  type SiteLanguage,
} from '../config/site';

interface Props {
  lang: SiteLanguage;
  languageHref: string;
}

const {
  lang,
  languageHref,
} = Astro.props;

const content = {
  fi: {
    navLabel:
      'Päänavigaatio',

    homeLabel:
      'Aapo Pihkalan etusivu',

    languageText:
      'EN',

    languageLabel:
      'English',

    linkedinLabel:
      'Aapo Pihkala LinkedInissä',
  },

  en: {
    navLabel:
      'Main navigation',

    homeLabel:
      'Aapo Pihkala homepage',

    languageText:
      'FI',

    languageLabel:
      'Suomeksi',

    linkedinLabel:
      'Aapo Pihkala on LinkedIn',
  },
} as const;

const t =
  content[lang];

const currentLanguage =
  site.languages[lang];

const alternateLanguage =
  lang === 'fi'
    ? site.languages.en
    : site.languages.fi;
---

<header class="topbar">
  <nav
    class="topbar-inner"
    aria-label={t.navLabel}
  >
    <a
      class="topbar-name"
      href={currentLanguage.homePath}
      aria-label={t.homeLabel}
    >
      aapo
    </a>

    <div class="topbar-actions">
      <a
        class="language-switch"
        href={languageHref}
        hreflang={alternateLanguage.code}
        lang={alternateLanguage.code}
        aria-label={t.languageLabel}
      >
        {t.languageText}
      </a>

      <a
        class="linkedin-link"
        href={site.linkedinUrl}
        target="_blank"
        rel="noopener"
        aria-label={t.linkedinLabel}
        title="LinkedIn"
      >
        <svg
          class="linkedin-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"
          />
        </svg>
      </a>
    </div>
  </nav>
</header>

<div
  class="site-grid-easter-egg"
  data-site-grid
  aria-hidden="true"
>
  <span class="site-grid-label">GRID / 32</span>
</div>

<style>
  .site-grid-easter-egg {
    position: fixed;
    inset: 64px 0 0;
    z-index: 45;
    pointer-events: none;
    opacity: 0;
    background-image:
      linear-gradient(rgba(89, 105, 93, 0.075) 1px, transparent 1px),
      linear-gradient(90deg, rgba(89, 105, 93, 0.075) 1px, transparent 1px);
    background-size: 32px 32px;
    transition: opacity 120ms ease;
  }

  .site-grid-easter-egg.is-visible {
    opacity: 1;
  }

  .site-grid-label {
    position: absolute;
    right: 22px;
    bottom: 18px;
    color: var(--moss);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.58rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-grid-easter-egg {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const grid = document.querySelector('[data-site-grid]')
    if (!grid) return
    if (grid.dataset.siteShortcutsInitialized === 'true') return

    grid.dataset.siteShortcutsInitialized = 'true'

    const isTypingTarget = (target) => {
      if (!(target instanceof Element)) return false

      return Boolean(
        target.closest(
          'input, textarea, select, [contenteditable="true"]'
        )
      )
    }

    const handleKeydown = (event) => {
      if (event.defaultPrevented) return
      if (event.metaKey || event.ctrlKey || event.altKey) return
      if (isTypingTarget(event.target)) return

      const key = event.key.toLowerCase()

      if (key === 'g') {
        event.preventDefault()
        grid.classList.toggle('is-visible')
        return
      }

      if (key === 'l') {
        event.preventDefault()
        window.location.assign('/lab/')
        return
      }

      if (key === 'escape') {
        grid.classList.remove('is-visible')
      }
    }

    window.addEventListener('keydown', handleKeydown)

    window.addEventListener(
      'pagehide',
      () => {
        window.removeEventListener('keydown', handleKeydown)
      },
      { once: true }
    )
  })()
</script>
