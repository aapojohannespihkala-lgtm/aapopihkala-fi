---
import {
  site,
  type SiteLanguage,
} from '../config/site';

interface Props {
  lang: SiteLanguage;
  languageHref: string;
}

const {
  lang,
  languageHref,
} = Astro.props;

const content = {
  fi: {
    navLabel: 'Päänavigaatio',
    homeLabel: 'Aapo Pihkalan etusivu',
    languageText: 'EN',
    languageLabel: 'English',
    languageMeta: 'FI → EN / LANG 02',
    linkedinLabel: 'Aapo Pihkala LinkedInissä',
  },
  en: {
    navLabel: 'Main navigation',
    homeLabel: 'Aapo Pihkala homepage',
    languageText: 'FI',
    languageLabel: 'Suomeksi',
    languageMeta: 'EN → FI / LANG 01',
    linkedinLabel: 'Aapo Pihkala on LinkedIn',
  },
} as const;

const t = content[lang];
const currentLanguage = site.languages[lang];
const alternateLanguage = lang === 'fi' ? site.languages.en : site.languages.fi;
---

<header class="topbar">
  <nav class="topbar-inner" aria-label={t.navLabel}>
    <a class="topbar-name" href={currentLanguage.homePath} aria-label={t.homeLabel}>
      aapo
    </a>

    <div class="topbar-actions">
      <a
        class="language-switch"
        href={languageHref}
        hreflang={alternateLanguage.code}
        lang={alternateLanguage.code}
        aria-label={t.languageLabel}
      >
        {t.languageText}
        <span class="language-switch__meta" aria-hidden="true">
          {t.languageMeta}
        </span>
      </a>

      <a
        class="linkedin-link"
        href={site.linkedinUrl}
        target="_blank"
        rel="noopener"
        aria-label={t.linkedinLabel}
        title="LinkedIn"
      >
        <svg
          class="linkedin-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z" />
        </svg>
      </a>
    </div>
  </nav>
</header>

<div class="site-grid-easter-egg" data-site-grid aria-hidden="true">
  <span class="site-grid-label">GRID / 32</span>
</div>

<div class="site-scroll-readout" data-scroll-readout aria-hidden="true">
  <span data-scroll-y>Y 0000</span>
  <span class="site-scroll-readout__separator">/</span>
  <span data-scroll-percent>0%</span>
</div>

<div class="site-measure-easter-egg" data-measure-overlay aria-hidden="true">
  <svg class="site-measure-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <line data-measure-line x1="0" y1="0" x2="0" y2="0" />
    <circle data-measure-start cx="0" cy="0" r="3.2" />
    <circle data-measure-end cx="0" cy="0" r="3.2" />
  </svg>
  <span class="site-measure-label" data-measure-label>MEASURE / SET POINT</span>
</div>

<style>
  .language-switch__meta {
    position: absolute;
    left: 50%;
    top: calc(100% + 9px);
    z-index: 52;
    pointer-events: none;
    color: var(--moss);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.56rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, -2px);
    transition: opacity 120ms ease, transform 120ms ease;
  }

  .language-switch:hover .language-switch__meta,
  .language-switch:focus-visible .language-switch__meta {
    opacity: 0.72;
    transform: translate(-50%, 0);
  }

  .site-grid-easter-egg {
    position: fixed;
    inset: 64px 0 0;
    z-index: 45;
    pointer-events: none;
    opacity: 0;
    background-image:
      linear-gradient(rgba(89, 105, 93, 0.075) 1px, transparent 1px),
      linear-gradient(90deg, rgba(89, 105, 93, 0.075) 1px, transparent 1px);
    background-size: 32px 32px;
    transition: opacity 120ms ease;
  }

  .site-grid-easter-egg.is-visible { opacity: 1; }

  .site-grid-label {
    position: absolute;
    right: 22px;
    bottom: 18px;
    color: var(--moss);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.58rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .site-scroll-readout {
    position: fixed;
    right: 22px;
    bottom: 42px;
    z-index: 46;
    display: flex;
    align-items: center;
    gap: 6px;
    pointer-events: none;
    opacity: 0;
    color: var(--moss-deep);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.47rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.05em;
    transform: translateY(3px);
    transition: opacity 140ms ease, transform 140ms ease;
  }

  .site-scroll-readout.is-visible {
    opacity: 0.72;
    transform: translateY(0);
  }

  .site-scroll-readout__separator { color: var(--stone-light); }

  .site-measure-easter-egg {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: none;
    pointer-events: none;
  }

  .site-measure-easter-egg.is-visible { display: block; }

  .site-measure-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .site-measure-svg line {
    stroke: var(--moss);
    stroke-width: 1;
    stroke-dasharray: 5 4;
    vector-effect: non-scaling-stroke;
    opacity: 0.72;
  }

  .site-measure-svg circle {
    fill: var(--page);
    stroke: var(--moss);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0.82;
  }

  .site-measure-label {
    position: absolute;
    left: 0;
    top: 0;
    padding: 4px 6px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--moss-deep);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.56rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.06em;
    white-space: nowrap;
    transform: translate(12px, 12px);
  }

  :global(body.site-measure-mode),
  :global(body.site-measure-mode *) {
    cursor: crosshair !important;
  }

  :global(.post-date[data-date-easter-egg]) {
    cursor: pointer;
    transition: color 120ms ease;
  }

  :global(.post-date[data-date-easter-egg]:hover),
  :global(.post-date[data-date-easter-egg]:focus-visible) {
    color: var(--moss-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .language-switch__meta,
    .site-grid-easter-egg,
    .site-scroll-readout,
    :global(.post-date[data-date-easter-egg]) {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const grid = document.querySelector('[data-site-grid]')
    const scrollReadout = document.querySelector('[data-scroll-readout]')
    const scrollYLabel = document.querySelector('[data-scroll-y]')
    const scrollPercentLabel = document.querySelector('[data-scroll-percent]')
    const measureOverlay = document.querySelector('[data-measure-overlay]')
    const measureLine = document.querySelector('[data-measure-line]')
    const measureStartMarker = document.querySelector('[data-measure-start]')
    const measureEndMarker = document.querySelector('[data-measure-end]')
    const measureLabel = document.querySelector('[data-measure-label]')

    if (!grid) return
    if (grid.dataset.siteShortcutsInitialized === 'true') return
    grid.dataset.siteShortcutsInitialized = 'true'

    const isTypingTarget = (target) => {
      if (!(target instanceof Element)) return false
      return Boolean(target.closest('input, textarea, select, [contenteditable="true"]'))
    }

    let measureMode = false
    let measureStart = null
    let easterCycleIndex = -1
    let lastMeasurePointer = {
      x: window.innerWidth * 0.5,
      y: window.innerHeight * 0.5,
    }

    const setMeasurePoint = (element, x, y) => {
      if (!element) return
      element.setAttribute('cx', String(x))
      element.setAttribute('cy', String(y))
    }

    const setMeasureLine = (x1, y1, x2, y2) => {
      if (!measureLine) return
      measureLine.setAttribute('x1', String(x1))
      measureLine.setAttribute('y1', String(y1))
      measureLine.setAttribute('x2', String(x2))
      measureLine.setAttribute('y2', String(y2))
    }

    const positionMeasureLabel = (x, y) => {
      if (!measureLabel) return
      measureLabel.style.left = `${x}px`
      measureLabel.style.top = `${y}px`
    }

    const updateMeasure = (x, y) => {
      lastMeasurePointer = { x, y }
      positionMeasureLabel(x, y)

      if (!measureStart) {
        setMeasureLine(x, y, x, y)
        setMeasurePoint(measureStartMarker, x, y)
        setMeasurePoint(measureEndMarker, x, y)
        if (measureLabel) measureLabel.textContent = 'MEASURE / SET POINT'
        return
      }

      const dx = x - measureStart.x
      const dy = y - measureStart.y
      const distance = Math.hypot(dx, dy)

      setMeasureLine(measureStart.x, measureStart.y, x, y)
      setMeasurePoint(measureStartMarker, measureStart.x, measureStart.y)
      setMeasurePoint(measureEndMarker, x, y)

      if (measureLabel) {
        measureLabel.textContent = `${Math.round(distance)} px / DX ${Math.round(dx)} / DY ${Math.round(dy)}`
      }
    }

    const setMeasureMode = (active) => {
      measureMode = active
      measureStart = null
      document.body.classList.toggle('site-measure-mode', active)
      measureOverlay?.classList.toggle('is-visible', active)
      if (active) updateMeasure(lastMeasurePointer.x, lastMeasurePointer.y)
    }

    const dispatchCycleKey = (key) => {
      const syntheticEvent = new KeyboardEvent('keydown', {
        key,
        bubbles: true,
        cancelable: true,
      })
      Object.defineProperty(syntheticEvent, 'siteEasterEggCycle', {
        value: true,
      })
      window.dispatchEvent(syntheticEvent)
    }

    const getEasterSequence = () => {
      const hasHomepageEggs = Boolean(
        document.querySelector('[data-homepage-contour-lens]')
      )

      return hasHomepageEggs
        ? ['g', 'm', 'c', 'n', 'p', 'e', 's', null]
        : ['g', 'm', null]
    }

    const blockedLegacyKeys = new Set(['g', 'm', 'c', 'n', 'p', 'e', 's'])

    const handleKeydown = (event) => {
      if (event.defaultPrevented) return
      if (event.metaKey || event.ctrlKey || event.altKey) return
      if (isTypingTarget(event.target)) return

      const key = event.key.toLowerCase()
      const isCycleSynthetic = event.siteEasterEggCycle === true

      if (!isCycleSynthetic && key === 'a') {
        event.preventDefault()
        event.stopImmediatePropagation()

        const sequence = getEasterSequence()
        dispatchCycleKey('Escape')
        easterCycleIndex = (easterCycleIndex + 1) % sequence.length

        const nextKey = sequence[easterCycleIndex]
        if (nextKey) dispatchCycleKey(nextKey)
        return
      }

      if (!isCycleSynthetic && blockedLegacyKeys.has(key)) {
        event.preventDefault()
        event.stopImmediatePropagation()
        return
      }

      if (!isCycleSynthetic && key === 'l') {
        event.preventDefault()
        event.stopImmediatePropagation()
        window.location.assign('/lab/')
        return
      }

      if (key === 'g') {
        event.preventDefault()
        grid.classList.toggle('is-visible')
        return
      }

      if (key === 'm') {
        event.preventDefault()
        setMeasureMode(!measureMode)
        return
      }

      if (key === 'escape') {
        grid.classList.remove('is-visible')
        setMeasureMode(false)
        if (!isCycleSynthetic) easterCycleIndex = -1
      }
    }

    const handleMeasurePointerMove = (event) => {
      lastMeasurePointer = { x: event.clientX, y: event.clientY }
      if (!measureMode) return
      updateMeasure(event.clientX, event.clientY)
    }

    const handleMeasurePointerDown = (event) => {
      if (!measureMode || event.button !== 0) return
      event.preventDefault()
      event.stopPropagation()
      measureStart = { x: event.clientX, y: event.clientY }
      updateMeasure(event.clientX, event.clientY)
    }

    let scrollHideTimer = 0
    let scrollFrame = 0

    const updateScrollReadout = () => {
      scrollFrame = 0
      if (!scrollReadout || !scrollYLabel || !scrollPercentLabel) return

      const y = Math.max(0, Math.round(window.scrollY))
      const maximum = Math.max(1, document.documentElement.scrollHeight - window.innerHeight)
      const percent = Math.max(0, Math.min(100, Math.round((window.scrollY / maximum) * 100)))

      scrollYLabel.textContent = `Y ${String(y).padStart(4, '0')}`
      scrollPercentLabel.textContent = `${percent}%`
      scrollReadout.classList.add('is-visible')

      window.clearTimeout(scrollHideTimer)
      scrollHideTimer = window.setTimeout(() => {
        scrollReadout.classList.remove('is-visible')
      }, 900)
    }

    const handleScroll = () => {
      if (scrollFrame) return
      scrollFrame = window.requestAnimationFrame(updateScrollReadout)
    }

    const initializeDateEasterEggs = () => {
      document.querySelectorAll('time.post-date').forEach((dateElement) => {
        if (!(dateElement instanceof HTMLElement)) return
        if (dateElement.dataset.dateEasterEgg === 'true') return

        const datetime = dateElement.getAttribute('datetime')
        if (!datetime) return

        dateElement.dataset.dateEasterEgg = 'true'
        dateElement.dataset.originalDate = dateElement.textContent ?? ''
        dateElement.dataset.isoDate = datetime.slice(0, 10)
        dateElement.dataset.isoVisible = 'false'
        dateElement.tabIndex = 0
        dateElement.setAttribute('role', 'button')
        dateElement.setAttribute('title', 'Toggle date format')

        const toggleDate = () => {
          const showIso = dateElement.dataset.isoVisible !== 'true'
          dateElement.dataset.isoVisible = showIso ? 'true' : 'false'
          dateElement.textContent = showIso
            ? dateElement.dataset.isoDate ?? ''
            : dateElement.dataset.originalDate ?? ''
        }

        dateElement.addEventListener('click', toggleDate)
        dateElement.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return
          event.preventDefault()
          toggleDate()
        })
      })
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeDateEasterEggs, { once: true })
    } else {
      initializeDateEasterEggs()
    }

    window.addEventListener('keydown', handleKeydown, true)
    window.addEventListener('pointermove', handleMeasurePointerMove, { passive: true })
    window.addEventListener('pointerdown', handleMeasurePointerDown, true)
    window.addEventListener('scroll', handleScroll, { passive: true })

    window.addEventListener(
      'pagehide',
      () => {
        window.clearTimeout(scrollHideTimer)
        if (scrollFrame) window.cancelAnimationFrame(scrollFrame)
        window.removeEventListener('keydown', handleKeydown, true)
        window.removeEventListener('pointermove', handleMeasurePointerMove)
        window.removeEventListener('pointerdown', handleMeasurePointerDown, true)
        window.removeEventListener('scroll', handleScroll)
        document.body.classList.remove('site-measure-mode')
      },
      { once: true }
    )
  })()
</script>
