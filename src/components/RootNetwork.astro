---
interface Props {
  class?: string
  autoRotate?: boolean
  enableZoom?: boolean
  pulse?: boolean
  showSoil?: boolean
  scale?: number
  cameraDistance?: number
}

const {
  class: className,
  autoRotate = true,
  enableZoom = true,
  pulse = true,
  showSoil = true,
  scale = 1,
  cameraDistance = 8.6,
} = Astro.props
---

<div
  class:list={['root-network', className]}
  data-root-network
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-pulse={pulse ? 'true' : 'false'}
  data-show-soil={showSoil ? 'true' : 'false'}
  data-scale={scale}
  data-camera-distance={cameraDistance}
  aria-hidden="true"
>
  <canvas class="root-network__canvas" data-root-network-canvas></canvas>
</div>

<style>
  .root-network {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 320px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .root-network:active {
    cursor: grabbing;
  }

  .root-network__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-root-network]')

    roots.forEach(async (root) => {
      if (root.dataset.rootNetworkInitialized === 'true') return
      root.dataset.rootNetworkInitialized = 'true'

      const canvas = root.querySelector('[data-root-network-canvas]')
      if (!canvas) return

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm')
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        )

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const wantsAutoRotate = root.dataset.autoRotate !== 'false'
        const wantsZoom = root.dataset.enableZoom !== 'false'
        const wantsPulse = root.dataset.pulse !== 'false'
        const wantsSoil = root.dataset.showSoil !== 'false'

        const requestedScale = Number(root.dataset.scale ?? '1')
        const requestedCameraDistance = Number(root.dataset.cameraDistance ?? '8.6')

        const displayScale = Number.isFinite(requestedScale) ? requestedScale : 1
        const camDistance = Number.isFinite(requestedCameraDistance)
          ? requestedCameraDistance
          : 8.6

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        })

        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6))
        renderer.setClearColor(0xffffff, 0)

        const scene = new THREE.Scene()
        const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100)
        camera.position.set(5.15, 2.7, camDistance)

        const specimen = new THREE.Group()
        specimen.scale.setScalar(displayScale)
        specimen.rotation.y = -0.18
        specimen.rotation.x = -0.02
        scene.add(specimen)

        const soilGroup = new THREE.Group()
        const plantGroup = new THREE.Group()
        const rootGroup = new THREE.Group()
        const fineRootGroup = new THREE.Group()
        const moistureGroup = new THREE.Group()

        specimen.add(soilGroup, plantGroup, rootGroup, fineRootGroup, moistureGroup)
        soilGroup.visible = wantsSoil

        const controls = new OrbitControls(camera, renderer.domElement)
        controls.enablePan = false
        controls.enableZoom = wantsZoom
        controls.enableDamping = true
        controls.dampingFactor = 0.055
        controls.rotateSpeed = 0.52
        controls.target.set(0, -0.42, 0)
        controls.autoRotate = wantsAutoRotate && !reducedMotion
        controls.autoRotateSpeed = 0.18

        if (wantsZoom) {
          controls.minDistance = 7.2
          controls.maxDistance = 11.8
          controls.zoomSpeed = 0.5
        } else {
          const lockedDistance = camera.position.length()
          controls.minDistance = lockedDistance
          controls.maxDistance = lockedDistance
        }

        const stemMaterial = new THREE.PointsMaterial({
          color: 0x30332f,
          size: 0.03,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.82,
        })

        const mainRootMaterial = new THREE.LineBasicMaterial({
          color: 0x59695d,
          transparent: true,
          opacity: 0.5,
        })

        const secondaryRootMaterial = new THREE.LineBasicMaterial({
          color: 0x687169,
          transparent: true,
          opacity: 0.3,
        })

        const fineRootMaterial = new THREE.PointsMaterial({
          color: 0x596158,
          size: 0.019,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.28,
        })

        const soilMaterial = new THREE.PointsMaterial({
          color: 0x8a9088,
          size: 0.016,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.12,
        })

        const groundMaterial = new THREE.LineBasicMaterial({
          color: 0x80877f,
          transparent: true,
          opacity: 0.28,
        })

        const moistureMaterialA = new THREE.PointsMaterial({
          color: 0x7d8d86,
          size: 0.022,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.18,
        })

        const moistureMaterialB = new THREE.PointsMaterial({
          color: 0x889890,
          size: 0.021,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.16,
        })

        const hash = (value, salt = 0) => {
          const x = Math.sin(value * 127.1 + salt * 311.7) * 43758.5453123
          return x - Math.floor(x)
        }

        const makeLine = (curve, steps, material) => {
          const points = curve.getPoints(steps)
          const geometry = new THREE.BufferGeometry().setFromPoints(points)
          const line = new THREE.Line(geometry, material)
          rootGroup.add(line)
          return { line, geometry, pointCount: points.length }
        }

        const makeStemCloud = (x, height, lean, seed) => {
          const positions = []
          const rows = 42
          const sides = 9

          for (let yi = 0; yi <= rows; yi += 1) {
            const t = yi / rows
            const y = t * height
            const centerX = x + lean * t + 0.018 * Math.sin(t * 4.2 + seed)
            const centerZ = 0.015 * Math.sin(t * 5.6 + seed * 0.7)
            const radius = THREE.MathUtils.lerp(0.055, 0.018, t)

            for (let ai = 0; ai < sides; ai += 1) {
              const angle = (ai / sides) * Math.PI * 2
              positions.push(
                centerX + Math.cos(angle) * radius,
                y + 0.02,
                centerZ + Math.sin(angle) * radius * 0.82
              )
            }
          }

          const leafCount = 120
          for (let i = 0; i < leafCount; i += 1) {
            const side = i % 2 === 0 ? -1 : 1
            const level = 0.36 + hash(i + seed * 11, 2) * 0.52
            const spread = 0.08 + hash(i + seed * 13, 3) * 0.22
            positions.push(
              x + lean * level + side * spread,
              height * level + (hash(i + seed * 17, 4) - 0.5) * 0.1,
              (hash(i + seed * 19, 5) - 0.5) * 0.16
            )
          }

          const geometry = new THREE.BufferGeometry()
          geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3))
          plantGroup.add(new THREE.Points(geometry, stemMaterial))
          return geometry
        }

        const stemGeometries = [
          makeStemCloud(-1.45, 1.18, 0.08, 1),
          makeStemCloud(-0.05, 1.48, -0.03, 2),
          makeStemCloud(1.32, 1.02, -0.06, 3),
        ]

        const groundGeometry = new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(-3.15, 0, 0),
          new THREE.Vector3(3.15, 0, 0),
        ])
        const groundLine = new THREE.Line(groundGeometry, groundMaterial)
        soilGroup.add(groundLine)

        const soilPositions = []
        const soilCount = 4200

        for (let i = 0; i < soilCount; i += 1) {
          const x = THREE.MathUtils.lerp(-3.05, 3.05, hash(i + 1, 11))
          const y = -0.08 - Math.pow(hash(i + 1, 12), 1.1) * 2.45
          const z = THREE.MathUtils.lerp(-1.65, 1.65, hash(i + 1, 13))

          const band = 0.7 + 0.3 * Math.sin((x + z) * 1.2)
          if (hash(i + 1, 14) < band) {
            soilPositions.push(x, y, z)
          }
        }

        const soilGeometry = new THREE.BufferGeometry()
        soilGeometry.setAttribute('position', new THREE.Float32BufferAttribute(soilPositions, 3))
        soilGroup.add(new THREE.Points(soilGeometry, soilMaterial))

        const rootSpecs = [
          {
            baseX: -1.45,
            curves: [
              [[-1.45, -0.04, 0], [-1.52, -0.42, 0.04], [-1.86, -0.98, 0.18], [-2.5, -1.52, 0.34], [-2.92, -1.92, 0.42]],
              [[-1.45, -0.04, 0], [-1.18, -0.44, -0.05], [-0.78, -0.9, -0.18], [-0.38, -1.32, -0.28], [0.18, -1.66, -0.18]],
              [[-1.45, -0.04, 0], [-1.32, -0.54, 0.16], [-1.2, -1.18, 0.36], [-1.08, -1.86, 0.42], [-0.94, -2.32, 0.46]],
            ],
          },
          {
            baseX: -0.05,
            curves: [
              [[-0.05, -0.04, 0], [-0.18, -0.46, 0.04], [-0.34, -1.02, 0.1], [-0.28, -1.72, 0.18], [-0.14, -2.42, 0.16]],
              [[-0.05, -0.04, 0], [0.18, -0.38, -0.03], [0.54, -0.82, -0.14], [1.02, -1.22, -0.26], [1.6, -1.54, -0.22]],
              [[-0.05, -0.04, 0], [-0.36, -0.34, -0.04], [-0.74, -0.7, -0.12], [-1.08, -1.18, -0.22], [-1.42, -1.72, -0.18]],
            ],
          },
          {
            baseX: 1.32,
            curves: [
              [[1.32, -0.04, 0], [1.28, -0.42, 0.06], [1.18, -0.94, 0.16], [1.08, -1.58, 0.28], [0.94, -2.1, 0.3]],
              [[1.32, -0.04, 0], [1.58, -0.36, -0.04], [1.92, -0.74, -0.12], [2.34, -1.14, -0.18], [2.82, -1.46, -0.12]],
              [[1.32, -0.04, 0], [1.02, -0.4, 0.02], [0.64, -0.88, 0.04], [0.26, -1.34, 0.08], [-0.14, -1.72, 0.12]],
            ],
          },
        ]

        const mainLines = []
        const secondaryLines = []
        const fineRootPositions = []

        const addFineRootCloud = (curve, seed, density = 150) => {
          for (let i = 0; i < density; i += 1) {
            const t = Math.pow(hash(i + seed * 1000, 21), 0.88)
            const center = curve.getPoint(t)
            const tangent = curve.getTangent(t).normalize()
            const side = new THREE.Vector3(-tangent.y, tangent.x, 0).normalize()
            const depthSide = new THREE.Vector3(0, -tangent.z, tangent.y).normalize()
            const spread = 0.05 + 0.18 * t
            const a = (hash(i + seed * 1000, 22) - 0.5) * spread
            const b = (hash(i + seed * 1000, 23) - 0.5) * spread

            fineRootPositions.push(
              center.x + side.x * a + depthSide.x * b,
              center.y + side.y * a + depthSide.y * b,
              center.z + side.z * a + depthSide.z * b
            )
          }
        }

        let rootSeed = 1

        rootSpecs.forEach((plant, plantIndex) => {
          plant.curves.forEach((points, curveIndex) => {
            const curve = new THREE.CatmullRomCurve3(
              points.map(([x, y, z]) => new THREE.Vector3(x, y, z))
            )

            const main = makeLine(curve, 46, mainRootMaterial)
            main.line.userData.phase = plantIndex * 0.17 + curveIndex * 0.08
            mainLines.push(main)
            addFineRootCloud(curve, rootSeed, 190)

            const sideCount = curveIndex === 0 ? 5 : 4
            for (let branchIndex = 0; branchIndex < sideCount; branchIndex += 1) {
              const t0 = 0.22 + branchIndex * (0.58 / Math.max(1, sideCount - 1))
              const anchor = curve.getPoint(t0)
              const tangent = curve.getTangent(t0).normalize()
              const direction = branchIndex % 2 === 0 ? 1 : -1
              const lateral = new THREE.Vector3(-tangent.y, tangent.x, direction * 0.28).normalize()
              const reach = 0.38 + hash(rootSeed * 31 + branchIndex, 25) * 0.46
              const drop = 0.24 + hash(rootSeed * 37 + branchIndex, 26) * 0.28

              const secondaryCurve = new THREE.CatmullRomCurve3([
                anchor,
                new THREE.Vector3(
                  anchor.x + lateral.x * reach * 0.42,
                  anchor.y - drop * 0.35,
                  anchor.z + lateral.z * reach * 0.42
                ),
                new THREE.Vector3(
                  anchor.x + lateral.x * reach,
                  anchor.y - drop,
                  anchor.z + lateral.z * reach
                ),
              ])

              const secondary = makeLine(secondaryCurve, 20, secondaryRootMaterial)
              secondary.line.userData.phase = 0.22 + rootSeed * 0.025
              secondaryLines.push(secondary)
              addFineRootCloud(secondaryCurve, rootSeed + 100, 75)
              rootSeed += 1
            }

            rootSeed += 1
          })
        })

        const fineRootGeometry = new THREE.BufferGeometry()
        fineRootGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(fineRootPositions, 3)
        )
        fineRootGroup.add(new THREE.Points(fineRootGeometry, fineRootMaterial))

        const createMoisturePatch = (cx, cy, cz, rx, ry, rz, count, seed, material) => {
          const positions = []

          for (let i = 0; i < count; i += 1) {
            const angle = hash(i + seed, 31) * Math.PI * 2
            const radius = Math.sqrt(hash(i + seed, 32))
            const vertical = (hash(i + seed, 33) - 0.5) * 2
            const squeeze = Math.sqrt(Math.max(0, 1 - vertical * vertical))

            positions.push(
              cx + Math.cos(angle) * rx * radius * squeeze,
              cy + vertical * ry,
              cz + Math.sin(angle) * rz * radius * squeeze
            )
          }

          const geometry = new THREE.BufferGeometry()
          geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3))
          const points = new THREE.Points(geometry, material)
          moistureGroup.add(points)
          return { geometry, points }
        }

        const moistureA = createMoisturePatch(
          -0.72,
          -1.48,
          0.16,
          0.78,
          0.38,
          0.64,
          520,
          101,
          moistureMaterialA
        )

        const moistureB = createMoisturePatch(
          1.38,
          -1.02,
          -0.22,
          0.68,
          0.3,
          0.58,
          420,
          202,
          moistureMaterialB
        )

        const resize = () => {
          const rect = root.getBoundingClientRect()
          const width = Math.max(1, Math.round(rect.width))
          const height = Math.max(1, Math.round(rect.height))

          renderer.setSize(width, height, false)
          camera.aspect = width / height
          camera.updateProjectionMatrix()
        }

        const resizeObserver = new ResizeObserver(resize)
        resizeObserver.observe(root)
        resize()

        let isVisible = true
        let isDocumentVisible = !document.hidden
        let animationFrame = 0

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting)
          },
          { rootMargin: '160px' }
        )
        intersectionObserver.observe(root)

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden
        }
        document.addEventListener('visibilitychange', handleVisibility)

        const updateGrowth = (timeSeconds) => {
          if (!wantsPulse || reducedMotion) {
            mainLines.forEach(({ geometry, pointCount }) => geometry.setDrawRange(0, pointCount))
            secondaryLines.forEach(({ geometry, pointCount }) => geometry.setDrawRange(0, pointCount))
            moistureMaterialA.opacity = 0.18
            moistureMaterialB.opacity = 0.16
            return
          }

          mainLines.forEach(({ line, geometry, pointCount }) => {
            const phase = line.userData.phase ?? 0
            const wave = 0.84 + 0.16 * Math.sin(timeSeconds * 0.28 + phase * Math.PI * 2)
            geometry.setDrawRange(0, Math.max(2, Math.floor(pointCount * wave)))
          })

          secondaryLines.forEach(({ line, geometry, pointCount }) => {
            const phase = line.userData.phase ?? 0
            const wave = 0.76 + 0.24 * Math.sin(timeSeconds * 0.23 + phase * Math.PI * 2)
            geometry.setDrawRange(0, Math.max(2, Math.floor(pointCount * wave)))
          })

          moistureMaterialA.opacity = 0.14 + 0.06 * (0.5 + 0.5 * Math.sin(timeSeconds * 0.4))
          moistureMaterialB.opacity = 0.12 + 0.055 * (0.5 + 0.5 * Math.sin(timeSeconds * 0.34 + 1.4))
          fineRootMaterial.opacity = 0.25 + 0.045 * (0.5 + 0.5 * Math.sin(timeSeconds * 0.24 + 0.7))
        }

        const animate = (time) => {
          animationFrame = requestAnimationFrame(animate)
          if (!isVisible || !isDocumentVisible) return

          controls.update()

          const t = time * 0.001
          updateGrowth(t)

          specimen.position.y = reducedMotion ? 0 : 0.008 * Math.sin(t * 0.24)
          specimen.rotation.z = reducedMotion ? 0 : 0.006 * Math.sin(t * 0.18)

          renderer.render(scene, camera)
        }

        animationFrame = requestAnimationFrame(animate)

        const cleanup = () => {
          cancelAnimationFrame(animationFrame)
          document.removeEventListener('visibilitychange', handleVisibility)
          resizeObserver.disconnect()
          intersectionObserver.disconnect()
          controls.dispose()

          stemGeometries.forEach((geometry) => geometry.dispose())
          groundGeometry.dispose()
          soilGeometry.dispose()
          fineRootGeometry.dispose()
          moistureA.geometry.dispose()
          moistureB.geometry.dispose()

          mainLines.forEach(({ geometry }) => geometry.dispose())
          secondaryLines.forEach(({ geometry }) => geometry.dispose())

          stemMaterial.dispose()
          mainRootMaterial.dispose()
          secondaryRootMaterial.dispose()
          fineRootMaterial.dispose()
          soilMaterial.dispose()
          groundMaterial.dispose()
          moistureMaterialA.dispose()
          moistureMaterialB.dispose()
          renderer.dispose()
        }

        window.addEventListener('pagehide', cleanup, { once: true })
      } catch (error) {
        console.error('RootNetwork failed to initialize:', error)
      }
    })
  })()
</script>
