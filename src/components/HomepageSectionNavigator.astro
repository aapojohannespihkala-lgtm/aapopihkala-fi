---
import type { SiteLanguage } from '../config/site';

interface Props {
  lang: SiteLanguage;
}

const { lang } = Astro.props;

const labels = lang === 'fi'
  ? {
      about: 'Siirry About-osioon',
      next: 'Siirry seuraavaan osioon tai artikkeliin',
      end: 'Siirry sivun loppuun',
      top: 'Takaisin sivun alkuun',
    }
  : {
      about: 'Scroll to About',
      next: 'Scroll to the next section or article',
      end: 'Scroll to the end of the page',
      top: 'Back to top',
    };
---

<button
  class="homepage-section-nav-button homepage-section-nav-button--fixed"
  type="button"
  data-homepage-section-nav
  data-label-about={labels.about}
  data-label-next={labels.next}
  data-label-end={labels.end}
  data-label-top={labels.top}
  aria-label={labels.about}
>
  <svg viewBox="0 0 14 10" aria-hidden="true">
    <path d="M2 2.5 L7 7.5 L12 2.5 Z"></path>
  </svg>
</button>

<style is:global>
  .homepage-section-nav-button {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--stone-light);
    opacity: 0.64;
    cursor: pointer;
    transition:
      color 150ms ease,
      opacity 150ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .homepage-section-nav-button--fixed {
    position: fixed;
    left: 50%;
    bottom: 16px;
    z-index: 120;
    transform: translateX(-50%);
  }

  .homepage-section-nav-button:hover,
  .homepage-section-nav-button:focus-visible {
    color: var(--moss-deep);
    opacity: 0.94;
  }

  .homepage-section-nav-button--fixed:hover {
    transform: translate(-50%, 1px);
  }

  .homepage-section-nav-button:focus-visible {
    outline: 1px solid var(--lichen);
    outline-offset: 3px;
  }

  .homepage-section-nav-button svg {
    width: 14px;
    height: 10px;
    overflow: visible;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .homepage-section-nav-button path {
    fill: currentColor;
    stroke: none;
  }

  .homepage-section-nav-button.is-up svg {
    transform: rotate(180deg);
  }

  .homepage-section-nav-button.is-up:hover {
    transform: translate(-50%, -1px);
  }

  /* Homepage transition into the feed is intentionally borderless.
     FeedPost keeps its normal first-item rule everywhere else. */
  .main-container > .feed > .feed-post:first-child {
    border-top: 0 !important;
  }

  @media (max-width: 800px) {
    .homepage-section-nav-button {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-section-nav-button,
    .homepage-section-nav-button svg {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-homepage-section-nav]')
    if (!(button instanceof HTMLButtonElement)) return
    if (button.dataset.initialized === 'true') return
    button.dataset.initialized = 'true'

    let hero = null
    let about = null
    let feed = null
    let heroHeading = null
    let aboutHeading = null
    let destinations = []
    let currentTarget = null
    let currentMode = 'next'

    const reducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const behavior = () => reducedMotion() ? 'auto' : 'smooth'

    const getHeaderHeight = () => {
      const header = document.querySelector('.topbar')
      return header instanceof HTMLElement ? header.getBoundingClientRect().height : 64
    }

    const getReferenceHeadingTop = () => {
      if (!(hero instanceof HTMLElement) || !(heroHeading instanceof HTMLElement)) {
        return Math.max(120, window.innerHeight * 0.34)
      }

      const heroRect = hero.getBoundingClientRect()
      const headingRect = heroHeading.getBoundingClientRect()
      const headingOffsetInsideHero = headingRect.top - heroRect.top

      return getHeaderHeight() + headingOffsetInsideHero
    }

    const getHeadingScrollTop = (heading) => {
      if (!(heading instanceof HTMLElement)) return 0
      const headingDocumentTop = heading.getBoundingClientRect().top + window.scrollY
      return Math.max(0, headingDocumentTop - getReferenceHeadingTop())
    }

    const getDestinationScrollTop = (destination) => {
      if (!destination) return 0

      if (destination.kind === 'divider' && destination.anchor instanceof HTMLElement) {
        const dividerDocumentTop = destination.anchor.getBoundingClientRect().top + window.scrollY
        return Math.max(0, dividerDocumentTop - getHeaderHeight())
      }

      if (destination.heading instanceof HTMLElement) {
        return getHeadingScrollTop(destination.heading)
      }

      return 0
    }

    const resolveSections = () => {
      hero = document.querySelector('.main-container > .hero')
      about = document.querySelector('[data-homepage-about-embed]')
      feed = document.querySelector('.main-container > .feed')
      heroHeading = hero?.querySelector('h1') ?? null
      aboutHeading = about?.querySelector('.about-portrait h1') ?? null

      const posts = feed instanceof HTMLElement
        ? Array.from(feed.querySelectorAll('.feed-post')).filter(
            (post) => post instanceof HTMLElement
          )
        : []

      if (
        !(hero instanceof HTMLElement) ||
        !(about instanceof HTMLElement) ||
        !(feed instanceof HTMLElement) ||
        !(heroHeading instanceof HTMLElement) ||
        !(aboutHeading instanceof HTMLElement) ||
        posts.length === 0
      ) {
        window.requestAnimationFrame(resolveSections)
        return
      }

      const articleDestinations = posts
        .map((post, index) => {
          const heading = post.querySelector('.post-title')
          if (!(heading instanceof HTMLElement)) return null

          if (index === 0) {
            return {
              kind: 'heading',
              heading,
              anchor: heading,
            }
          }

          const previousDivider = posts[index - 1]?.querySelector('.post-divider')

          return {
            kind: previousDivider instanceof HTMLElement ? 'divider' : 'heading',
            heading,
            anchor: previousDivider instanceof HTMLElement ? previousDivider : heading,
          }
        })
        .filter(Boolean)

      destinations = [
        {
          kind: 'about',
          heading: aboutHeading,
          anchor: aboutHeading,
        },
        ...articleDestinations,
      ]

      updateState()
    }

    const updateState = () => {
      if (!destinations.length) return

      const y = window.scrollY
      const viewportBottom = y + window.innerHeight
      const documentBottom = document.documentElement.scrollHeight
      const nearBottom = documentBottom - viewportBottom <= Math.max(24, window.innerHeight * 0.04)
      const advanceThreshold = 28

      button.classList.remove('is-up')

      const nextDestination = destinations.find((destination) =>
        getDestinationScrollTop(destination) > y + advanceThreshold
      )

      if (nextDestination) {
        currentMode = 'next'
        currentTarget = nextDestination
        button.setAttribute(
          'aria-label',
          nextDestination.kind === 'about'
            ? button.dataset.labelAbout || 'About'
            : button.dataset.labelNext || 'Next'
        )
        return
      }

      if (!nearBottom) {
        currentMode = 'end'
        currentTarget = null
        button.setAttribute('aria-label', button.dataset.labelEnd || 'End')
        return
      }

      currentMode = 'top'
      currentTarget = null
      button.classList.add('is-up')
      button.setAttribute('aria-label', button.dataset.labelTop || 'Back to top')
    }

    button.addEventListener('click', () => {
      if (currentMode === 'next' && currentTarget) {
        window.scrollTo({
          top: getDestinationScrollTop(currentTarget),
          behavior: behavior(),
        })
        return
      }

      if (currentMode === 'end') {
        const targetY = Math.max(
          0,
          document.documentElement.scrollHeight - window.innerHeight
        )
        window.scrollTo({ top: targetY, behavior: behavior() })
        return
      }

      if (currentMode === 'top') {
        window.scrollTo({ top: 0, behavior: behavior() })
      }
    })

    let ticking = false
    const scheduleUpdate = () => {
      if (ticking) return
      ticking = true
      window.requestAnimationFrame(() => {
        ticking = false
        updateState()
      })
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true })
    window.addEventListener('resize', scheduleUpdate, { passive: true })
    resolveSections()
  })()
</script>
