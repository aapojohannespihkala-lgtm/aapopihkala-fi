---
import type { SiteLanguage } from '../config/site';

interface Props {
  lang: SiteLanguage;
}

const { lang } = Astro.props;

const labels = lang === 'fi'
  ? {
      about: 'Siirry About-osioon',
      articles: 'Siirry artikkeleihin',
      top: 'Takaisin sivun alkuun',
    }
  : {
      about: 'Scroll to About',
      articles: 'Scroll to articles',
      top: 'Back to top',
    };
---

<button
  class="homepage-section-nav-button homepage-section-nav-button--fixed"
  type="button"
  data-homepage-section-nav
  data-label-about={labels.about}
  data-label-articles={labels.articles}
  data-label-top={labels.top}
  aria-label={labels.about}
>
  <svg viewBox="0 0 14 10" aria-hidden="true">
    <path d="M2 2.5 L7 7.5 L12 2.5 Z"></path>
  </svg>
</button>

<style is:global>
  .homepage-section-nav-button {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--stone-light);
    opacity: 0.64;
    cursor: pointer;
    transition:
      color 150ms ease,
      opacity 150ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .homepage-section-nav-button--fixed {
    position: fixed;
    left: 50%;
    bottom: 16px;
    z-index: 120;
    transform: translateX(-50%);
  }

  .homepage-section-nav-button:hover,
  .homepage-section-nav-button:focus-visible {
    color: var(--moss-deep);
    opacity: 0.94;
  }

  .homepage-section-nav-button--fixed:hover {
    transform: translate(-50%, 1px);
  }

  .homepage-section-nav-button:focus-visible {
    outline: 1px solid var(--lichen);
    outline-offset: 3px;
  }

  .homepage-section-nav-button svg {
    width: 14px;
    height: 10px;
    overflow: visible;
  }

  .homepage-section-nav-button path {
    fill: currentColor;
    stroke: none;
  }

  .homepage-section-nav-button.is-up svg {
    transform: rotate(180deg);
  }

  .homepage-section-nav-button.is-up:hover {
    transform: translate(-50%, -1px);
  }

  .homepage-section-nav-button.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Homepage transition into the feed is intentionally borderless.
     FeedPost keeps its normal first-item rule everywhere else. */
  .main-container > .feed > .feed-post:first-child {
    border-top: 0 !important;
  }

  @media (max-width: 800px) {
    .homepage-section-nav-button {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-section-nav-button {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-homepage-section-nav]')
    if (!(button instanceof HTMLButtonElement)) return
    if (button.dataset.initialized === 'true') return
    button.dataset.initialized = 'true'

    let hero = null
    let about = null
    let feed = null
    let heroHeading = null
    let aboutHeading = null
    let articleHeading = null
    let currentTarget = 'about'

    const reducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const behavior = () => reducedMotion() ? 'auto' : 'smooth'

    const resolveSections = () => {
      hero = document.querySelector('.main-container > .hero')
      about = document.querySelector('[data-homepage-about-embed]')
      feed = document.querySelector('.main-container > .feed')
      heroHeading = hero?.querySelector('h1') ?? null
      aboutHeading = about?.querySelector('.about-portrait h1') ?? null
      articleHeading = feed?.querySelector('.feed-post:first-child .post-title') ?? null

      if (
        !(hero instanceof HTMLElement) ||
        !(about instanceof HTMLElement) ||
        !(feed instanceof HTMLElement) ||
        !(heroHeading instanceof HTMLElement) ||
        !(aboutHeading instanceof HTMLElement) ||
        !(articleHeading instanceof HTMLElement)
      ) {
        window.requestAnimationFrame(resolveSections)
        return
      }

      updateState()
    }

    const getReferenceHeadingTop = () => {
      if (!(hero instanceof HTMLElement) || !(heroHeading instanceof HTMLElement)) {
        return Math.max(120, window.innerHeight * 0.34)
      }

      const heroRect = hero.getBoundingClientRect()
      const headingRect = heroHeading.getBoundingClientRect()
      const header = document.querySelector('.topbar')
      const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 64
      const headingOffsetInsideHero = headingRect.top - heroRect.top

      return headerHeight + headingOffsetInsideHero
    }

    const scrollHeadingToHeroLevel = (heading) => {
      if (!(heading instanceof HTMLElement)) return

      const headingDocumentTop = heading.getBoundingClientRect().top + window.scrollY
      const targetY = Math.max(0, headingDocumentTop - getReferenceHeadingTop())

      window.scrollTo({
        top: targetY,
        behavior: behavior(),
      })
    }

    const updateState = () => {
      if (!(hero instanceof HTMLElement) || !(about instanceof HTMLElement) || !(feed instanceof HTMLElement)) return

      const y = window.scrollY
      const viewportBottom = y + window.innerHeight
      const documentBottom = document.documentElement.scrollHeight
      const aboutTop = about.getBoundingClientRect().top + y
      const feedTop = feed.getBoundingClientRect().top + y
      const nearBottom = documentBottom - viewportBottom < Math.max(120, window.innerHeight * 0.18)

      button.classList.remove('is-up', 'is-hidden')

      if (nearBottom && y > feedTop) {
        currentTarget = 'top'
        button.classList.add('is-up')
        button.setAttribute('aria-label', button.dataset.labelTop || 'Back to top')
        return
      }

      if (y >= feedTop - window.innerHeight * 0.2) {
        currentTarget = 'none'
        button.classList.add('is-hidden')
        return
      }

      if (y >= aboutTop - window.innerHeight * 0.35) {
        currentTarget = 'articles'
        button.setAttribute('aria-label', button.dataset.labelArticles || 'Articles')
        return
      }

      currentTarget = 'about'
      button.setAttribute('aria-label', button.dataset.labelAbout || 'About')
    }

    button.addEventListener('click', () => {
      if (currentTarget === 'about') {
        scrollHeadingToHeroLevel(aboutHeading)
        return
      }

      if (currentTarget === 'articles') {
        scrollHeadingToHeroLevel(articleHeading)
        return
      }

      if (currentTarget === 'top') {
        window.scrollTo({ top: 0, behavior: behavior() })
      }
    })

    let ticking = false
    const scheduleUpdate = () => {
      if (ticking) return
      ticking = true
      window.requestAnimationFrame(() => {
        ticking = false
        updateState()
      })
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true })
    window.addEventListener('resize', scheduleUpdate, { passive: true })
    resolveSections()
  })()
</script>
