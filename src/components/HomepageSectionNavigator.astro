---
import type { SiteLanguage } from '../config/site';

interface Props {
  lang: SiteLanguage;
}

const { lang } = Astro.props;

const labels = lang === 'fi'
  ? {
      about: 'Siirry About-osioon',
      articles: 'Siirry artikkeleihin',
      top: 'Takaisin sivun alkuun',
    }
  : {
      about: 'Scroll to About',
      articles: 'Scroll to articles',
      top: 'Back to top',
    };
---

<button
  class="homepage-section-nav-button homepage-section-nav-button--fixed"
  type="button"
  data-homepage-section-nav
  data-label-about={labels.about}
  data-label-articles={labels.articles}
  data-label-top={labels.top}
  aria-label={labels.about}
>
  <svg viewBox="0 0 28 28" aria-hidden="true">
    <line class="homepage-section-nav-button__datum" x1="9" y1="4.5" x2="19" y2="4.5"></line>
    <line class="homepage-section-nav-button__shaft" x1="14" y1="4" x2="14" y2="21"></line>
    <polyline class="homepage-section-nav-button__head" points="8.5,15.5 14,21 19.5,15.5"></polyline>
  </svg>
</button>

<style is:global>
  .homepage-section-nav-button {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--stone);
    opacity: 0.78;
    cursor: pointer;
    transition:
      color 150ms ease,
      opacity 150ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .homepage-section-nav-button--fixed {
    position: fixed;
    left: 50%;
    bottom: 18px;
    z-index: 120;
    transform: translateX(-50%);
  }

  .homepage-section-nav-button:hover,
  .homepage-section-nav-button:focus-visible {
    color: var(--moss-deep);
    opacity: 1;
  }

  .homepage-section-nav-button--fixed:hover {
    transform: translate(-50%, 2px);
  }

  .homepage-section-nav-button:focus-visible {
    outline: 1px solid var(--lichen);
    outline-offset: 3px;
  }

  .homepage-section-nav-button svg {
    width: 28px;
    height: 28px;
    overflow: visible;
  }

  .homepage-section-nav-button line,
  .homepage-section-nav-button polyline {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: butt;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }

  .homepage-section-nav-button__datum {
    opacity: 0.5;
  }

  .homepage-section-nav-button.is-up svg {
    transform: rotate(180deg);
  }

  .homepage-section-nav-button.is-up:hover {
    transform: translate(-50%, -2px);
  }

  .homepage-section-nav-button.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .homepage-about-embed,
  .main-container > .feed {
    scroll-margin-top: 76px;
  }

  @media (max-width: 800px) {
    .homepage-section-nav-button {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-section-nav-button {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-homepage-section-nav]')
    if (!(button instanceof HTMLButtonElement)) return
    if (button.dataset.initialized === 'true') return
    button.dataset.initialized = 'true'

    let hero = null
    let about = null
    let feed = null
    let currentTarget = 'about'

    const reducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const behavior = () => reducedMotion() ? 'auto' : 'smooth'

    const resolveSections = () => {
      hero = document.querySelector('.main-container > .hero')
      about = document.querySelector('[data-homepage-about-embed]')
      feed = document.querySelector('.main-container > .feed')

      if (!(hero instanceof HTMLElement) || !(about instanceof HTMLElement) || !(feed instanceof HTMLElement)) {
        window.requestAnimationFrame(resolveSections)
        return
      }

      updateState()
    }

    const updateState = () => {
      if (!(hero instanceof HTMLElement) || !(about instanceof HTMLElement) || !(feed instanceof HTMLElement)) return

      const y = window.scrollY
      const viewportBottom = y + window.innerHeight
      const documentBottom = document.documentElement.scrollHeight
      const aboutTop = about.getBoundingClientRect().top + y
      const feedTop = feed.getBoundingClientRect().top + y
      const nearBottom = documentBottom - viewportBottom < Math.max(120, window.innerHeight * 0.18)

      button.classList.remove('is-up', 'is-hidden')

      if (nearBottom && y > feedTop) {
        currentTarget = 'top'
        button.classList.add('is-up')
        button.setAttribute('aria-label', button.dataset.labelTop || 'Back to top')
        return
      }

      if (y >= feedTop - window.innerHeight * 0.2) {
        currentTarget = 'none'
        button.classList.add('is-hidden')
        return
      }

      if (y >= aboutTop - window.innerHeight * 0.35) {
        currentTarget = 'articles'
        button.setAttribute('aria-label', button.dataset.labelArticles || 'Articles')
        return
      }

      currentTarget = 'about'
      button.setAttribute('aria-label', button.dataset.labelAbout || 'About')
    }

    button.addEventListener('click', () => {
      if (currentTarget === 'about' && about instanceof HTMLElement) {
        about.scrollIntoView({ behavior: behavior(), block: 'start' })
        return
      }

      if (currentTarget === 'articles' && feed instanceof HTMLElement) {
        feed.scrollIntoView({ behavior: behavior(), block: 'start' })
        return
      }

      if (currentTarget === 'top') {
        window.scrollTo({ top: 0, behavior: behavior() })
      }
    })

    let ticking = false
    const scheduleUpdate = () => {
      if (ticking) return
      ticking = true
      window.requestAnimationFrame(() => {
        ticking = false
        updateState()
      })
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true })
    window.addEventListener('resize', scheduleUpdate, { passive: true })
    resolveSections()
  })()
</script>
