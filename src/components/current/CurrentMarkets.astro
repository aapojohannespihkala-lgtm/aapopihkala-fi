<section class="current-markets" data-current-markets aria-labelledby="current-markets-title">
  <header class="markets-heading">
    <p class="markets-index">MARKETS / 00</p>
    <p class="markets-context">GLOBAL / PORTFOLIO CONTEXT</p>
  </header>

  <h2 id="current-markets-title" class="sr-only">Markets</h2>

  <div class="markets-layout">
    <section class="markets-market-view" aria-label="Relevant market benchmarks">
      <div class="markets-ticker-host" data-markets-ticker-host>
        <p class="markets-loading" data-markets-ticker-fallback aria-live="polite">
          Loading market data
        </p>
      </div>
    </section>

    <section class="markets-macro" aria-label="Currency and interest rates">
      <div class="markets-macro__row">
        <p class="markets-macro__label">EUR / USD</p>
        <p class="markets-macro__value" data-market-value="eur-usd">--.----</p>
      </div>

      <div class="markets-macro__row">
        <p class="markets-macro__label">EUR / SEK</p>
        <p class="markets-macro__value" data-market-value="eur-sek">--.----</p>
      </div>

      <div class="markets-macro__row">
        <p class="markets-macro__label">€STR</p>
        <p class="markets-macro__value"><span data-market-value="estr">-.---</span>%</p>
      </div>

      <p class="markets-macro__updated">
        ECB / <span data-markets-observation>WAITING</span>
      </p>
    </section>
  </div>

  <footer class="markets-footer">
    <p>
      DATA /
      <a href="https://www.tradingview.com/" target="_blank" rel="noopener nofollow">TRADINGVIEW</a>
      ·
      <a href="https://data.ecb.europa.eu/" target="_blank" rel="noopener">ECB</a>
    </p>

    <p class="markets-error" data-markets-error hidden>
      Macro data unavailable.
      <button type="button" data-markets-retry>Retry</button>
    </p>
  </footer>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-current-markets]')
    const host = root?.querySelector('[data-markets-ticker-host]')
    if (!(host instanceof HTMLElement)) return

    const fallback = host.querySelector('[data-markets-ticker-fallback]')
    const scriptUrl = 'https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js'
    const symbols = [
      { proName: 'AMEX:URTH', title: 'World' },
      { proName: 'SP:SPX', title: 'S&P 500' },
      { proName: 'TVC:SXXP', title: 'Europe' },
      { proName: 'OMXNORDIC:OMXN40', title: 'Nordics' },
      { proName: 'OMXHEX:OMXH25', title: 'Finland' },
      { proName: 'TVC:NI225', title: 'Japan' },
      { proName: 'COINBASE:BTCEUR', title: 'BTC / EUR' },
    ]

    let fallbackTimer = 0
    let embedObserver = null
    let currentNightMode = document.documentElement.classList.contains('site-night-mode')

    const mountTicker = () => {
      window.clearTimeout(fallbackTimer)
      embedObserver?.disconnect()
      host.querySelector('[data-markets-ticker-embed]')?.remove()

      if (fallback instanceof HTMLElement) {
        fallback.hidden = false
        fallback.textContent = 'Loading market data'
      }

      currentNightMode = document.documentElement.classList.contains('site-night-mode')
      const widgetTheme = currentNightMode ? 'dark' : 'light'
      host.dataset.marketsTickerTheme = widgetTheme
      host.style.colorScheme = widgetTheme

      const embed = document.createElement('div')
      embed.dataset.marketsTickerEmbed = ''
      embed.style.cssText = 'width:100%;min-width:0;'

      const container = document.createElement('div')
      container.className = 'tradingview-widget-container'
      container.style.cssText = 'width:100%;min-width:0;'

      const widget = document.createElement('div')
      widget.className = 'tradingview-widget-container__widget'
      widget.style.cssText = 'width:100%;min-width:0;'

      container.append(widget)
      embed.append(container)
      host.append(embed)

      embedObserver = new MutationObserver(() => {
        const iframe = embed.querySelector('iframe')
        if (!(iframe instanceof HTMLIFrameElement)) return

        iframe.dataset.marketsTickerFrame = ''
        iframe.style.display = 'block'
        iframe.style.width = '100%'
        iframe.style.maxWidth = '100%'
        iframe.style.minHeight = '68px'

        if (fallback instanceof HTMLElement) fallback.hidden = true
        window.clearTimeout(fallbackTimer)
        embedObserver?.disconnect()
      })
      embedObserver.observe(embed, { childList: true, subtree: true })

      const script = document.createElement('script')
      script.type = 'text/javascript'
      script.src = scriptUrl
      script.async = true
      script.textContent = JSON.stringify({
        symbols,
        colorTheme: widgetTheme,
        theme: widgetTheme,
        locale: 'en',
        largeChartUrl: '',
        isTransparent: false,
        showSymbolLogo: false,
        displayMode: 'adaptive',
      })

      script.addEventListener(
        'error',
        () => {
          if (fallback instanceof HTMLElement) fallback.textContent = 'Market feed unavailable'
        },
        { once: true }
      )

      container.append(script)

      fallbackTimer = window.setTimeout(() => {
        if (embed.querySelector('iframe')) return
        if (fallback instanceof HTMLElement) fallback.textContent = 'Market feed unavailable'
      }, 5000)
    }

    const themeObserver = new MutationObserver(() => {
      const nextNightMode = document.documentElement.classList.contains('site-night-mode')
      if (nextNightMode === currentNightMode) return
      mountTicker()
    })

    mountTicker()
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    })

    window.addEventListener(
      'pagehide',
      () => {
        window.clearTimeout(fallbackTimer)
        embedObserver?.disconnect()
        themeObserver.disconnect()
      },
      { once: true }
    )
  })()
</script>

<script>
  import { initCurrentMarkets } from '../../features/current/markets';
  initCurrentMarkets();
</script>

<style>
  .current-markets {
    padding: 30px 0 6px;
  }

  .markets-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 25px;
  }

  .markets-index,
  .markets-context,
  .markets-macro,
  .markets-footer,
  .markets-loading {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    text-transform: uppercase;
  }

  .markets-index,
  .markets-context {
    margin: 0;
    font-size: 0.56rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.09em;
  }

  .markets-index {
    color: var(--moss);
  }

  .markets-context {
    color: var(--stone-light);
  }

  .markets-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(220px, 0.65fr);
    gap: 42px;
    align-items: start;
  }

  .markets-market-view {
    min-width: 0;
  }

  .markets-ticker-host {
    position: relative;
    width: 100%;
    min-height: 68px;
    overflow: hidden;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    background: var(--page);
  }

  .markets-loading {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0 12px;
    pointer-events: none;
    color: var(--stone-light);
    background: var(--page);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
  }

  .markets-loading[hidden] {
    display: none;
  }

  .markets-macro {
    border-top: 1px solid var(--line-soft);
  }

  .markets-macro__row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 20px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .markets-macro__label,
  .markets-macro__value {
    margin: 0;
  }

  .markets-macro__label {
    color: var(--stone);
    font-size: 0.57rem;
    font-weight: 600;
    letter-spacing: 0.075em;
  }

  .markets-macro__value {
    color: var(--ink);
    font-family: "Times New Roman", Times, serif;
    font-size: 1.45rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    text-transform: none;
  }

  .markets-macro__updated {
    margin: 10px 0 0;
    color: var(--stone-light);
    font-size: 0.48rem;
    letter-spacing: 0.075em;
  }

  .markets-footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 25px;
    color: var(--stone-light);
    font-size: 0.49rem;
    letter-spacing: 0.07em;
  }

  .markets-footer p {
    margin: 0;
  }

  .markets-footer a,
  .markets-error button {
    color: inherit;
  }

  .markets-error button {
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 720px) {
    .markets-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .markets-heading {
      gap: 16px;
      margin-bottom: 21px;
    }

    .markets-context {
      text-align: right;
    }

    .markets-footer {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
