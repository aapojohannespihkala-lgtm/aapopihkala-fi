<section class="current-markets" data-current-markets aria-labelledby="current-markets-title">
  <header class="markets-heading">
    <p class="markets-index">MARKETS / 00</p>
  </header>

  <h2 id="current-markets-title" class="sr-only">Markets</h2>

  <div class="markets-layout">
    <section class="markets-market-view" aria-label="Market performance by period">
      <p class="markets-panel-label">GLOBAL / PERFORMANCE</p>

      <div class="markets-performance">
        <tv-market-data
          view="performance"
          symbol-sectors='[{"sectionName":"Markets","symbols":["AMEX:URTH","AMEX:SPY","AMEX:VGK","OMXNORDIC:OMXN40","OMXHEX:OMXH25","AMEX:EWJ","COINBASE:BTCEUR","OMXHEX:REMEDY"]}]'
          transparent=""
          locale="en"
          aria-label="World, USA, Europe, Nordic, Finland, Japan, Bitcoin and Remedy performance"
        >
          <div class="markets-performance__fallback" data-markets-performance-fallback>
            <p class="markets-performance__periods">TODAY / 1W / 1M / 6M / 1Y</p>
            <p class="markets-performance__message" data-markets-performance-message>
              Loading market performance
            </p>
          </div>
        </tv-market-data>
      </div>
    </section>

    <section class="markets-macro" aria-label="Interest rate and world equity trends">
      <p class="markets-panel-label">RATES / TRENDS</p>

      <div class="markets-macro__row markets-macro__row--chart">
        <p class="markets-macro__label">3M EURIBOR</p>
        <div class="markets-macro__reading">
          <p class="markets-macro__value"><span data-market-value="euribor-3m">-.---</span>%</p>
          <p class="markets-macro__change">
            <span data-market-series-change="euribor-3m">WAITING</span> / 1Y
          </p>
          <p class="markets-macro__observation">
            OBS / <span data-market-observation="euribor-3m">WAITING</span>
          </p>
        </div>

        <div class="markets-sparkline-wrap">
          <div class="markets-sparkline__meta">
            <span>1Y HISTORY</span>
            <span>3M EURIBOR</span>
          </div>
          <div class="markets-sparkline-frame">
            <div class="markets-sparkline-axis" aria-hidden="true">
              <span data-market-axis="euribor-3m" data-axis-level="max">-.---</span>
              <span data-market-axis="euribor-3m" data-axis-level="mid">-.---</span>
              <span data-market-axis="euribor-3m" data-axis-level="min">-.---</span>
            </div>
            <svg
              class="markets-sparkline markets-sparkline--pending"
              data-market-sparkline="euribor-3m"
              viewBox="0 0 240 56"
              preserveAspectRatio="none"
              role="img"
            >
              <g class="markets-sparkline-grid">
                <line x1="2" x2="238" y1="2" y2="2"></line>
                <line x1="2" x2="238" y1="28" y2="28"></line>
                <line x1="2" x2="238" y1="54" y2="54"></line>
              </g>
              <path></path>
            </svg>
          </div>
          <p class="markets-sparkline__fallback" data-market-sparkline-fallback="euribor-3m">
            LOADING 1Y
          </p>
        </div>
      </div>

      <div class="markets-world">
        <p class="markets-panel-label">WORLD / 1Y</p>

        <div class="markets-macro__row markets-macro__row--chart">
          <p class="markets-macro__label">WORLD / URTH</p>
          <div class="markets-macro__reading">
            <p class="markets-macro__value" data-market-value="world">----</p>
            <p class="markets-macro__change">
              <span data-market-series-change="world">WAITING</span> / 1Y
            </p>
            <p class="markets-macro__observation">
              OBS / <span data-market-observation="world">WAITING</span>
            </p>
          </div>

          <div class="markets-sparkline-wrap">
            <div class="markets-sparkline__meta">
              <span>MSCI WORLD ETF PROXY</span>
              <span>URTH</span>
            </div>
            <div class="markets-sparkline-frame">
              <div class="markets-sparkline-axis" aria-hidden="true">
                <span data-market-axis="world" data-axis-level="max">--.--</span>
                <span data-market-axis="world" data-axis-level="mid">--.--</span>
                <span data-market-axis="world" data-axis-level="min">--.--</span>
              </div>
              <svg
                class="markets-sparkline markets-sparkline--pending"
                data-market-sparkline="world"
                viewBox="0 0 240 56"
                preserveAspectRatio="none"
                role="img"
              >
                <g class="markets-sparkline-grid">
                  <line x1="2" x2="238" y1="2" y2="2"></line>
                  <line x1="2" x2="238" y1="28" y2="28"></line>
                  <line x1="2" x2="238" y1="54" y2="54"></line>
                </g>
                <path></path>
              </svg>
            </div>
            <p class="markets-sparkline__fallback" data-market-sparkline-fallback="world">
              LOADING 1Y
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <footer class="markets-footer">
    <p>
      DATA /
      <a href="https://www.tradingview.com/" target="_blank" rel="noopener nofollow">TRADINGVIEW</a>
      ·
      <a href="https://data.ecb.europa.eu/" target="_blank" rel="noopener">ECB</a>
      ·
      <a
        href="https://www.suomenpankki.fi/en/statistics/interest-rates-and-exchange-rates/euribor-rates/"
        target="_blank"
        rel="noopener"
      >BANK OF FINLAND</a>
      ·
      <a href="https://finance.yahoo.com/quote/URTH/" target="_blank" rel="noopener nofollow">YAHOO FINANCE</a>
    </p>

    <p class="markets-error" data-markets-error hidden>
      Market data unavailable.
      <button type="button" data-markets-retry>Retry</button>
    </p>
  </footer>
</section>

<script is:inline type="module">
  const root = document.querySelector('[data-current-markets]')
  const widget = root?.querySelector('tv-market-data')

  if (widget instanceof HTMLElement) {
    const syncTheme = () => {
      widget.setAttribute(
        'theme',
        document.documentElement.classList.contains('site-night-mode') ? 'dark' : 'light'
      )
    }

    syncTheme()

    const themeObserver = new MutationObserver(syncTheme)
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    })

    window.addEventListener('pagehide', () => themeObserver.disconnect(), { once: true })

    const moduleUrls = [
      'https://www.tradingview-widget.com/w/en/tv-market-data.js',
      'https://widgets.tradingview-widget.com/w/en/tv-market-data.js',
    ]

    let loaded = false

    for (const moduleUrl of moduleUrls) {
      try {
        await import(moduleUrl)
        loaded = true
        break
      } catch {
        // TradingView has used both widget hosts. Try the alternate host before falling back.
      }
    }

    if (!loaded) {
      const message = root?.querySelector('[data-markets-performance-message]')
      if (message) message.textContent = 'Market performance unavailable'
    }
  }
</script>

<script>
  import { initCurrentMarkets } from '../../features/current/markets';
  initCurrentMarkets();
</script>

