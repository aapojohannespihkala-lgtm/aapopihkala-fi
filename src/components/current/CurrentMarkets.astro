<section class="current-markets" data-current-markets aria-labelledby="current-markets-title">
  <header class="markets-heading">
    <p class="markets-index">MARKETS / 00</p>
    <p class="markets-context">GLOBAL / PORTFOLIO CONTEXT</p>
  </header>

  <h2 id="current-markets-title" class="sr-only">Markets</h2>

  <div class="markets-layout">
    <section class="markets-market-view" aria-label="Relevant market benchmarks">
      <div class="markets-reference-grid" data-markets-reference-grid>
        <article class="markets-reference" data-market-reference="world">
          <p class="markets-reference__label">WORLD / URTH</p>
          <tv-single-ticker symbol="AMEX:URTH" transparent locale="en"></tv-single-ticker>
          <span class="markets-reference__fallback" data-market-single-fallback>--</span>
        </article>

        <article class="markets-reference" data-market-reference="usa">
          <p class="markets-reference__label">USA / SPY</p>
          <tv-single-ticker symbol="AMEX:SPY" transparent locale="en"></tv-single-ticker>
          <span class="markets-reference__fallback" data-market-single-fallback>--</span>
        </article>

        <article class="markets-reference" data-market-reference="europe">
          <p class="markets-reference__label">EUROPE / VGK</p>
          <tv-single-ticker symbol="NASDAQ:VGK" transparent locale="en"></tv-single-ticker>
          <span class="markets-reference__fallback" data-market-single-fallback>--</span>
        </article>

        <article class="markets-reference" data-market-reference="nordics">
          <p class="markets-reference__label">NORDICS / OMXN40</p>
          <tv-single-ticker symbol="OMXNORDIC:OMXN40" transparent locale="en"></tv-single-ticker>
          <span class="markets-reference__fallback" data-market-single-fallback>--</span>
        </article>

        <article class="markets-reference" data-market-reference="finland">
          <p class="markets-reference__label">FINLAND / OMXH25</p>
          <tv-single-ticker symbol="OMXHEX:OMXH25" transparent locale="en"></tv-single-ticker>
          <span class="markets-reference__fallback" data-market-single-fallback>--</span>
        </article>

        <article class="markets-reference" data-market-reference="japan">
          <p class="markets-reference__label">JAPAN / EWJ</p>
          <tv-single-ticker symbol="AMEX:EWJ" transparent locale="en"></tv-single-ticker>
          <span class="markets-reference__fallback" data-market-single-fallback>--</span>
        </article>

        <article class="markets-reference" data-market-reference="btc-eur">
          <p class="markets-reference__label">BTC / EUR</p>
          <tv-single-ticker symbol="COINBASE:BTCEUR" transparent locale="en"></tv-single-ticker>
          <span class="markets-reference__fallback" data-market-single-fallback>--</span>
        </article>
      </div>
    </section>

    <section class="markets-macro" aria-label="Currency and interest rates">
      <div class="markets-macro__row">
        <p class="markets-macro__label">EUR / USD</p>
        <p class="markets-macro__value" data-market-value="eur-usd">--.----</p>
      </div>

      <div class="markets-macro__row">
        <p class="markets-macro__label">EUR / SEK</p>
        <p class="markets-macro__value" data-market-value="eur-sek">--.----</p>
      </div>

      <div class="markets-macro__row">
        <p class="markets-macro__label">€STR</p>
        <p class="markets-macro__value"><span data-market-value="estr">-.---</span>%</p>
      </div>

      <p class="markets-macro__updated">
        ECB / <span data-markets-observation>WAITING</span>
      </p>
    </section>
  </div>

  <footer class="markets-footer">
    <p>
      DATA /
      <a href="https://www.tradingview.com/" target="_blank" rel="noopener nofollow">TRADINGVIEW</a>
      ·
      <a href="https://data.ecb.europa.eu/" target="_blank" rel="noopener">ECB</a>
    </p>

    <p class="markets-error" data-markets-error hidden>
      Macro data unavailable.
      <button type="button" data-markets-retry>Retry</button>
    </p>
  </footer>
</section>

<script
  is:inline
  type="module"
  async
  src="https://widgets.tradingview-widget.com/w/en/tv-single-ticker.js"
></script>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-current-markets]')
    if (!(root instanceof HTMLElement)) return

    customElements.whenDefined('tv-single-ticker').then(() => {
      root.dataset.marketsSingleTickersReady = 'true'
    })
  })()
</script>

<script>
  import { initCurrentMarkets } from '../../features/current/markets';
  initCurrentMarkets();
</script>

<style>
  .current-markets {
    padding: 30px 0 6px;
  }

  .markets-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 25px;
  }

  .markets-index,
  .markets-context,
  .markets-reference__label,
  .markets-reference__fallback,
  .markets-macro,
  .markets-footer {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    text-transform: uppercase;
  }

  .markets-index,
  .markets-context {
    margin: 0;
    font-size: 0.56rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.09em;
  }

  .markets-index {
    color: var(--moss);
  }

  .markets-context {
    color: var(--stone-light);
  }

  .markets-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(220px, 0.65fr);
    gap: 42px;
    align-items: start;
  }

  .markets-market-view {
    min-width: 0;
  }

  .markets-reference-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-soft);
    border-left: 1px solid var(--line-soft);
  }

  .markets-reference {
    position: relative;
    min-width: 0;
    min-height: 92px;
    padding: 8px 7px 6px;
    overflow: hidden;
    border-right: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    background: transparent;
  }

  .markets-reference__label {
    position: relative;
    z-index: 2;
    margin: 0 0 3px;
    color: var(--stone-light);
    font-size: 0.46rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.07em;
  }

  tv-single-ticker {
    display: block;
    width: 100%;
    height: 66px;
    min-width: 0;
    color-scheme: inherit;
    --tv-widget-background-color: transparent;
    --tv-widget-text-color: var(--stone);
    --tv-widget-price-text-color: var(--ink);
    --tv-widget-font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .markets-reference__fallback {
    position: absolute;
    left: 8px;
    bottom: 13px;
    color: var(--stone-light);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  [data-markets-single-tickers-ready='true'] .markets-reference__fallback {
    display: none;
  }

  .markets-macro {
    border-top: 1px solid var(--line-soft);
  }

  .markets-macro__row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 20px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .markets-macro__label,
  .markets-macro__value {
    margin: 0;
  }

  .markets-macro__label {
    color: var(--stone);
    font-size: 0.57rem;
    font-weight: 600;
    letter-spacing: 0.075em;
  }

  .markets-macro__value {
    color: var(--ink);
    font-family: "Times New Roman", Times, serif;
    font-size: 1.45rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    text-transform: none;
  }

  .markets-macro__updated {
    margin: 10px 0 0;
    color: var(--stone-light);
    font-size: 0.48rem;
    letter-spacing: 0.075em;
  }

  .markets-footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 25px;
    color: var(--stone-light);
    font-size: 0.49rem;
    letter-spacing: 0.07em;
  }

  .markets-footer p {
    margin: 0;
  }

  .markets-footer a,
  .markets-error button {
    color: inherit;
  }

  .markets-error button {
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) and (min-width: 721px) {
    .markets-reference-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .markets-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .markets-heading {
      gap: 16px;
      margin-bottom: 21px;
    }

    .markets-context {
      text-align: right;
    }

    .markets-reference-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .markets-reference {
      min-height: 88px;
      padding: 7px 6px 5px;
    }

    tv-single-ticker {
      height: 63px;
    }

    .markets-footer {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
