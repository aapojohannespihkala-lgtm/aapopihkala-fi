---
import { LIIGA_TEAMS } from '../../config/liigaTeams';
import { getLiigaMarkPaths } from '../../config/liigaMarks';
---

<section class="current-liiga" data-current-liiga aria-labelledby="current-liiga-title" aria-busy="true">
  <header class="liiga-heading">
    <div>
      <p class="liiga-index">LIIGA / <span data-liiga-season>--</span></p>
      <h2 id="current-liiga-title">Finnish Liiga</h2>
    </div>
    <p class="liiga-source-state" data-liiga-status>LOADING / LIIGA</p>
  </header>

  <section class="liiga-last" aria-labelledby="liiga-last-title">
    <div class="liiga-panel-heading">
      <p id="liiga-last-title">ILVES / LAST GAME</p>
      <p data-liiga-last-date>--</p>
    </div>

    <p class="liiga-empty" data-liiga-last-empty hidden>No completed Ilves game found.</p>

    <div class="liiga-last-game" data-liiga-last-game>
      <div class="liiga-last-team">
        <span class="liiga-last-team__mark" data-liiga-last-home-mark aria-hidden="true"></span>
        <strong data-liiga-last-home-name>--</strong>
      </div>

      <div class="liiga-score" aria-live="polite">
        <span data-liiga-last-home-score>--</span>
        <span class="liiga-score__separator" aria-hidden="true">:</span>
        <span data-liiga-last-away-score>--</span>
      </div>

      <div class="liiga-last-team liiga-last-team--away">
        <span class="liiga-last-team__mark" data-liiga-last-away-mark aria-hidden="true"></span>
        <strong data-liiga-last-away-name>--</strong>
      </div>

      <p class="liiga-last-meta">
        <span data-liiga-last-result>WAITING</span>
        <span aria-hidden="true">/</span>
        <span data-liiga-last-finish>--</span>
      </p>
    </div>
  </section>

  <section class="liiga-standings-section" aria-labelledby="liiga-standings-title">
    <div class="liiga-panel-heading">
      <p id="liiga-standings-title">STANDINGS</p>
      <p>REGULAR SEASON</p>
    </div>

    <div class="liiga-table" role="table" aria-label="Liiga standings">
      <div class="liiga-row liiga-row--header" role="row">
        <span role="columnheader">#</span>
        <span role="columnheader">TEAM</span>
        <span role="columnheader">O</span>
        <span class="liiga-col-secondary" role="columnheader">V</span>
        <span class="liiga-col-secondary" role="columnheader">T</span>
        <span class="liiga-col-secondary" role="columnheader">H</span>
        <span class="liiga-col-secondary" role="columnheader">LP</span>
        <span role="columnheader">P</span>
        <span role="columnheader">ME</span>
      </div>

      <div data-liiga-standings>
        {
          LIIGA_TEAMS.map((team, index) => (
            <div class="liiga-row" role="row" data-liiga-row={team.id} data-liiga-rank={index + 1}>
              <span class="liiga-rank" role="cell" data-liiga-rank>{index + 1}</span>
              <span class="liiga-team" role="rowheader">
                <span class="liiga-team-mark" aria-hidden="true">
                  <svg viewBox="0 0 48 48" focusable="false" data-liiga-mark-id={team.id}>
                    {
                      getLiigaMarkPaths(team.id).map((path, pathIndex) => (
                        <path
                          d={path}
                          class={pathIndex === 0 ? 'liiga-team-mark__shape' : 'liiga-team-mark__shape liiga-team-mark__detail'}
                        ></path>
                      ))
                    }
                  </svg>
                </span>
                <span class="liiga-team__name">{team.name}</span>
              </span>
              <span role="cell" data-liiga-games>0</span>
              <span class="liiga-col-secondary" role="cell" data-liiga-wins>0</span>
              <span class="liiga-col-secondary" role="cell" data-liiga-ties>0</span>
              <span class="liiga-col-secondary" role="cell" data-liiga-losses>0</span>
              <span class="liiga-col-secondary" role="cell" data-liiga-bonus>0</span>
              <span class="liiga-points" role="cell" data-liiga-points>0</span>
              <span role="cell" data-liiga-difference>0</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="liiga-clubs" aria-labelledby="liiga-clubs-title">
    <div class="liiga-panel-heading">
      <p id="liiga-clubs-title">CLUBS / 17</p>
      <p>CUSTOM CURRENT GLYPHS</p>
    </div>

    <div class="liiga-club-grid">
      {
        LIIGA_TEAMS.map((team) => (
          <div class="liiga-club-mark" data-liiga-club-mark={team.id}>
            <svg
              viewBox="0 0 48 48"
              role="img"
              aria-label={`${team.name} custom team glyph`}
              data-liiga-mark-id={team.id}
            >
              {
                getLiigaMarkPaths(team.id).map((path, pathIndex) => (
                  <path
                    d={path}
                    class={pathIndex === 0 ? 'liiga-team-mark__shape' : 'liiga-team-mark__shape liiga-team-mark__detail'}
                  ></path>
                ))
              }
            </svg>
            <span>{team.name}</span>
          </div>
        ))
      }
    </div>
  </section>

  <footer class="liiga-footer">
    <p>
      DATA /
      <a href="https://liiga.fi/" target="_blank" rel="noopener nofollow">LIIGA</a>
      · AUTO REFRESH 5 MIN
    </p>
    <p>CUSTOM GLYPHS / NOT OFFICIAL CLUB LOGOS</p>
    <p class="liiga-error" data-liiga-error hidden>
      Liiga data unavailable.
      <button type="button" data-liiga-retry>Retry</button>
    </p>
  </footer>
</section>

<script>
  import { initCurrentLiiga } from '../../features/current/liiga';
  initCurrentLiiga();
</script>

<style>
  .current-liiga {
    --liiga-rule: color-mix(in srgb, var(--line-soft) 56%, transparent);
    padding: 30px 0 8px;
  }

  .liiga-heading,
  .liiga-panel-heading,
  .liiga-footer,
  .liiga-row,
  .liiga-last-meta,
  .liiga-club-mark {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    text-transform: uppercase;
  }

  .liiga-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .liiga-index,
  .liiga-source-state,
  .liiga-panel-heading p,
  .liiga-footer p {
    margin: 0;
  }

  .liiga-index {
    color: var(--moss);
    font-size: 0.56rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.09em;
  }

  .liiga-heading h2 {
    margin: 8px 0 0;
    color: var(--ink);
    font-family: "Times New Roman", Times, serif;
    font-size: clamp(2.8rem, 6vw, 5.4rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .liiga-source-state {
    color: var(--stone-light);
    font-size: 0.48rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .liiga-last,
  .liiga-standings-section,
  .liiga-clubs,
  .liiga-footer {
    border-top: 1px solid var(--liiga-rule);
  }

  .liiga-last,
  .liiga-standings-section,
  .liiga-clubs {
    padding: 18px 0 24px;
  }

  .liiga-panel-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 14px;
    color: var(--stone-light);
    font-size: 0.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.07em;
  }

  .liiga-panel-heading p:first-child {
    color: var(--stone);
  }

  .liiga-last-game {
    display: grid;
    grid-template-columns: minmax(150px, 1fr) auto minmax(150px, 1fr);
    align-items: center;
    gap: clamp(22px, 5vw, 58px);
    min-height: 126px;
    padding: 18px clamp(18px, 4vw, 42px);
    border: 1px solid var(--liiga-rule);
  }

  .liiga-last-team {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .liiga-last-team--away {
    flex-direction: row-reverse;
    text-align: right;
  }

  .liiga-last-team strong {
    overflow: hidden;
    color: var(--ink-soft);
    font-family: "Times New Roman", Times, serif;
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    font-weight: 400;
    line-height: 1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .liiga-last-team__mark {
    width: 48px;
    height: 48px;
    flex: 0 0 auto;
  }

  .liiga-last-team__mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .liiga-score {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 9px;
    color: var(--ink);
    font-family: "Times New Roman", Times, serif;
    font-size: clamp(3.8rem, 8vw, 6.8rem);
    line-height: 0.8;
    letter-spacing: -0.055em;
  }

  .liiga-score__separator {
    color: var(--stone-light);
    font-size: 0.48em;
  }

  .liiga-last-meta {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: -4px 0 0;
    color: var(--stone-light);
    font-size: 0.46rem;
    letter-spacing: 0.065em;
  }

  .liiga-empty {
    margin: 0;
    color: var(--stone-light);
    font-size: 0.8rem;
  }

  .liiga-table {
    border-top: 1px solid var(--liiga-rule);
    border-bottom: 1px solid var(--liiga-rule);
  }

  .liiga-row {
    display: grid;
    grid-template-columns: 30px minmax(170px, 1fr) repeat(7, minmax(42px, 0.34fr));
    align-items: center;
    min-height: 44px;
    border-bottom: 1px solid var(--liiga-rule);
    color: var(--stone);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .liiga-row:last-child {
    border-bottom: 0;
  }

  .liiga-row > span {
    min-width: 0;
    padding: 0 8px;
    text-align: right;
  }

  .liiga-row > span:first-child {
    padding-left: 2px;
    text-align: left;
  }

  .liiga-row--header {
    min-height: 31px;
    color: var(--stone-light);
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.055em;
  }

  .liiga-row--header > span:nth-child(2) {
    text-align: left;
  }

  .liiga-team {
    display: flex;
    align-items: center;
    gap: 9px;
    text-align: left !important;
  }

  .liiga-team-mark,
  .liiga-club-mark svg {
    width: 30px;
    height: 30px;
    flex: 0 0 auto;
    color: var(--stone);
  }

  .liiga-team-mark svg,
  .liiga-club-mark svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  :global(.liiga-team-mark__shape) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  :global(.liiga-team-mark__detail) {
    stroke-width: 1.15;
    opacity: 0.78;
  }

  .liiga-team__name {
    overflow: hidden;
    color: var(--ink-soft);
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .liiga-points {
    color: var(--ink);
    font-weight: 700;
  }

  .liiga-row.is-ilves {
    background: color-mix(in srgb, var(--moss) 6%, transparent);
  }

  .liiga-row.is-ilves .liiga-team-mark,
  .liiga-row.is-ilves .liiga-team__name,
  .liiga-row.is-ilves .liiga-points {
    color: var(--moss-deep);
  }

  .liiga-club-grid {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    border-top: 1px solid var(--liiga-rule);
    border-left: 1px solid var(--liiga-rule);
  }

  .liiga-club-mark {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 10px;
    min-width: 0;
    min-height: 112px;
    padding: 18px 8px 14px;
    border-right: 1px solid var(--liiga-rule);
    border-bottom: 1px solid var(--liiga-rule);
    color: var(--stone);
    text-align: center;
  }

  .liiga-club-mark svg {
    width: 48px;
    height: 48px;
  }

  .liiga-club-mark span {
    overflow: hidden;
    width: 100%;
    color: var(--stone-light);
    font-size: 0.4rem;
    letter-spacing: 0.045em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .liiga-club-mark[data-liiga-club-mark="ilves"] {
    color: var(--moss-deep);
  }

  .liiga-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 24px;
    padding-top: 15px;
    color: var(--stone-light);
    font-size: 0.42rem;
    line-height: 1.5;
    letter-spacing: 0.055em;
  }

  .liiga-footer a,
  .liiga-error button {
    color: var(--stone);
  }

  .liiga-footer a {
    text-decoration: none;
  }

  .liiga-footer a:hover,
  .liiga-footer a:focus-visible,
  .liiga-error button:hover,
  .liiga-error button:focus-visible {
    color: var(--moss-deep);
  }

  .liiga-error {
    flex-basis: 100%;
  }

  .liiga-error button {
    min-width: 24px;
    min-height: 24px;
    padding: 0 2px;
    border: 0;
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  @media (max-width: 760px) {
    .liiga-heading {
      align-items: start;
    }

    .liiga-last-game {
      grid-template-columns: 1fr auto 1fr;
      gap: 12px;
      min-height: 110px;
      padding: 16px 10px;
    }

    .liiga-last-team {
      display: grid;
      justify-items: start;
      gap: 7px;
    }

    .liiga-last-team--away {
      justify-items: end;
    }

    .liiga-last-team strong {
      max-width: 100%;
      font-size: 1.2rem;
    }

    .liiga-last-team__mark {
      width: 38px;
      height: 38px;
    }

    .liiga-score {
      gap: 5px;
      font-size: clamp(3rem, 17vw, 4.8rem);
    }

    .liiga-row {
      grid-template-columns: 26px minmax(110px, 1fr) 36px 38px 42px;
      min-height: 42px;
      font-size: 0.64rem;
    }

    .liiga-row > span {
      padding: 0 4px;
    }

    .liiga-row .liiga-col-secondary {
      display: none;
    }

    .liiga-row > span:nth-child(8) {
      grid-column: 4;
    }

    .liiga-row > span:nth-child(9) {
      grid-column: 5;
    }

    .liiga-team {
      grid-column: 2;
    }

    .liiga-team-mark {
      width: 27px;
      height: 27px;
    }

    .liiga-club-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .liiga-heading h2 {
      font-size: 2.65rem;
    }

    .liiga-source-state {
      font-size: 0.4rem;
    }

    .liiga-last-team strong {
      font-size: 1.04rem;
    }

    .liiga-club-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .liiga-club-mark {
      min-height: 104px;
    }

    .liiga-club-mark svg {
      width: 44px;
      height: 44px;
    }
  }
</style>
