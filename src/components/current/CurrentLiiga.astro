---
import { LIIGA_TEAMS } from '../../config/liigaTeams';
import { getLiigaMarkPaths, isLiigaMarkFilled } from '../../config/liigaMarks';
---

<section class="current-liiga" data-current-liiga aria-labelledby="current-liiga-title" aria-busy="true">
  <header class="liiga-heading">
    <div>
      <p class="liiga-index">LIIGA / <span data-liiga-season>--</span></p>
      <h2 id="current-liiga-title">Finnish Liiga</h2>
    </div>
    <p class="liiga-source-state" data-liiga-status>LOADING / LIIGA</p>
  </header>

  <section class="liiga-ilves" aria-labelledby="liiga-ilves-title">
    <div class="liiga-panel-heading">
      <p id="liiga-ilves-title">ILVES / STATUS</p>
      <p data-liiga-ilves-position>#-- / 17</p>
    </div>

    <article class="liiga-live-card" data-liiga-live-card hidden aria-live="polite">
      <div class="liiga-live-card__header">
        <span>LIVE / ILVES</span>
        <span data-liiga-live-clock>LIVE</span>
      </div>
      <p class="liiga-live-card__matchup" data-liiga-live-matchup>--</p>
      <p class="liiga-live-card__score" data-liiga-live-score>0 : 0</p>
    </article>

    <div class="liiga-status-grid">
      <article class="liiga-status-card">
        <div class="liiga-status-card__header">
          <span>LAST GAME</span>
          <span data-liiga-last-date>--</span>
        </div>
        <p class="liiga-status-card__matchup" data-liiga-last-matchup>--</p>
        <p class="liiga-status-card__score" data-liiga-last-score>-- : --</p>
        <p class="liiga-status-card__meta" data-liiga-last-result>WAITING</p>
      </article>

      <article class="liiga-status-card">
        <div class="liiga-status-card__header">
          <span>NEXT GAME</span>
          <span data-liiga-next-venue>--</span>
        </div>
        <p class="liiga-status-card__matchup" data-liiga-next-matchup>--</p>
        <p class="liiga-status-card__next" data-liiga-next-date>--</p>
        <p class="liiga-status-card__meta">HELSINKI TIME</p>
      </article>

      <article class="liiga-status-card liiga-status-card--position">
        <div class="liiga-status-card__header">
          <span>POSITION</span>
          <span>REGULAR SEASON</span>
        </div>
        <p class="liiga-status-card__position" data-liiga-position>-- / --</p>
        <p class="liiga-status-card__meta" data-liiga-position-meta>WAITING FOR STANDINGS</p>
      </article>
    </div>
  </section>

  <section class="liiga-standings-section" aria-labelledby="liiga-standings-title">
    <div class="liiga-panel-heading">
      <p id="liiga-standings-title">STANDINGS</p>
      <p>REGULAR SEASON</p>
    </div>

    <div class="liiga-table" role="table" aria-label="Liiga standings">
      <div class="liiga-row liiga-row--header" role="row">
        <span role="columnheader">#</span>
        <span role="columnheader">TEAM</span>
        <span role="columnheader">O</span>
        <span class="liiga-col-secondary" role="columnheader">V</span>
        <span class="liiga-col-secondary" role="columnheader">T</span>
        <span class="liiga-col-secondary" role="columnheader">H</span>
        <span class="liiga-col-secondary" role="columnheader">LP</span>
        <span role="columnheader">P</span>
        <span role="columnheader">ME</span>
      </div>

      <div data-liiga-standings>
        {
          LIIGA_TEAMS.map((team, index) => (
            <div class="liiga-row" role="row" data-liiga-row={team.id} data-liiga-rank={index + 1}>
              <span class="liiga-rank" role="cell" data-liiga-rank>{index + 1}</span>
              <span class="liiga-team" role="rowheader">
                <span class="liiga-team-mark" aria-hidden="true">
                  <svg viewBox="0 0 48 48" focusable="false" data-liiga-mark-id={team.id}>
                    {
                      getLiigaMarkPaths(team.id).map((path, pathIndex) => (
                        <path
                          d={path}
                          class={isLiigaMarkFilled(team.id) ? 'liiga-team-mark__fill' : pathIndex === 0 ? 'liiga-team-mark__shape' : 'liiga-team-mark__shape liiga-team-mark__detail'}
                        ></path>
                      ))
                    }
                  </svg>
                </span>
                <span class="liiga-team__name">{team.name}</span>
              </span>
              <span role="cell" data-liiga-games>0</span>
              <span class="liiga-col-secondary" role="cell" data-liiga-wins>0</span>
              <span class="liiga-col-secondary" role="cell" data-liiga-ties>0</span>
              <span class="liiga-col-secondary" role="cell" data-liiga-losses>0</span>
              <span class="liiga-col-secondary" role="cell" data-liiga-bonus>0</span>
              <span class="liiga-points" role="cell" data-liiga-points>0</span>
              <span role="cell" data-liiga-difference>0</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="liiga-clubs" aria-labelledby="liiga-clubs-title">
    <div class="liiga-panel-heading">
      <p id="liiga-clubs-title">CLUBS / 17</p>
      <p>CUSTOM CURRENT GLYPHS</p>
    </div>

    <div class="liiga-club-grid">
      {
        LIIGA_TEAMS.map((team) => (
          <div class="liiga-club-mark" data-liiga-club-mark={team.id}>
            <svg
              viewBox="0 0 48 48"
              role="img"
              aria-label={`${team.name} custom team glyph`}
              data-liiga-mark-id={team.id}
            >
              {
                getLiigaMarkPaths(team.id).map((path, pathIndex) => (
                  <path
                    d={path}
                    class={isLiigaMarkFilled(team.id) ? 'liiga-team-mark__fill' : pathIndex === 0 ? 'liiga-team-mark__shape' : 'liiga-team-mark__shape liiga-team-mark__detail'}
                  ></path>
                ))
              }
            </svg>
            <span>{team.name}</span>
          </div>
        ))
      }
    </div>
  </section>

  <footer class="liiga-footer">
    <p>
      DATA /
      <a href="https://liiga.fi/" target="_blank" rel="noopener nofollow">LIIGA</a>
      · AUTO REFRESH 5 MIN / 30 SEC LIVE
    </p>
    <p>CUSTOM GLYPHS / NOT OFFICIAL CLUB LOGOS</p>
    <p class="liiga-error" data-liiga-error hidden>
      Liiga data unavailable.
      <button type="button" data-liiga-retry>Retry</button>
    </p>
  </footer>
</section>

<script>
  import { initCurrentLiiga } from '../../features/current/liiga';
  initCurrentLiiga();
</script>

<style>
  .current-liiga {
    --liiga-rule: color-mix(in srgb, var(--line-soft) 56%, transparent);
    padding: 30px 0 8px;
  }

  .liiga-heading,
  .liiga-panel-heading,
  .liiga-footer,
  .liiga-row,
  .liiga-status-card,
  .liiga-live-card,
  .liiga-club-mark {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    text-transform: uppercase;
  }

  .liiga-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .liiga-index,
  .liiga-source-state,
  .liiga-panel-heading p,
  .liiga-footer p,
  .liiga-status-card p,
  .liiga-live-card p {
    margin: 0;
  }

  .liiga-index {
    color: var(--moss);
    font-size: 0.56rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.09em;
  }

  .liiga-heading h2 {
    margin: 8px 0 0;
    color: var(--ink);
    font-family: "Times New Roman", Times, serif;
    font-size: clamp(2.8rem, 6vw, 5.4rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .liiga-source-state {
    color: var(--stone-light);
    font-size: 0.48rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .current-liiga.is-live .liiga-source-state {
    color: var(--moss-deep);
  }

  .liiga-ilves,
  .liiga-standings-section,
  .liiga-clubs,
  .liiga-footer {
    border-top: 1px solid var(--liiga-rule);
  }

  .liiga-ilves,
  .liiga-standings-section,
  .liiga-clubs {
    padding: 18px 0 24px;
  }

  .liiga-panel-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 14px;
    color: var(--stone-light);
    font-size: 0.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.07em;
  }

  .liiga-panel-heading p:first-child {
    color: var(--stone);
  }

  .liiga-status-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--liiga-rule);
    border-left: 1px solid var(--liiga-rule);
  }

  .liiga-status-card {
    min-width: 0;
    min-height: 196px;
    padding: 17px 18px 18px;
    border-right: 1px solid var(--liiga-rule);
    border-bottom: 1px solid var(--liiga-rule);
  }

  .liiga-status-card__header,
  .liiga-live-card__header {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    color: var(--stone-light);
    font-size: 0.45rem;
    font-weight: 600;
    letter-spacing: 0.065em;
  }

  .liiga-status-card__header span:first-child,
  .liiga-live-card__header span:first-child {
    color: var(--stone);
  }

  .liiga-status-card__matchup,
  .liiga-live-card__matchup {
    overflow: hidden;
    margin-top: 28px !important;
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.035em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .liiga-status-card__score,
  .liiga-status-card__position,
  .liiga-live-card__score {
    color: var(--ink);
    font-family: "Times New Roman", Times, serif;
    font-weight: 400;
    line-height: 0.82;
    letter-spacing: -0.055em;
  }

  .liiga-status-card__score {
    margin-top: 11px !important;
    font-size: clamp(3.1rem, 5.5vw, 5.2rem);
  }

  .liiga-status-card__next {
    margin-top: 20px !important;
    color: var(--ink);
    font-family: "Times New Roman", Times, serif;
    font-size: clamp(1.65rem, 3vw, 2.6rem);
    line-height: 0.96;
    letter-spacing: -0.035em;
  }

  .liiga-status-card__position {
    margin-top: 35px !important;
    font-size: clamp(3.8rem, 7vw, 6.4rem);
  }

  .liiga-status-card__meta {
    margin-top: 16px !important;
    color: var(--stone-light);
    font-size: 0.46rem;
    letter-spacing: 0.065em;
  }

  .liiga-status-card--position {
    background: color-mix(in srgb, var(--moss) 5%, transparent);
  }

  .liiga-status-card--position .liiga-status-card__position {
    color: var(--moss-deep);
  }

  .liiga-live-card {
    margin-bottom: 14px;
    padding: 18px 20px 22px;
    border: 1px solid var(--moss-deep);
    background: color-mix(in srgb, var(--moss) 7%, transparent);
  }

  .liiga-live-card[hidden] {
    display: none;
  }

  .liiga-live-card__header,
  .liiga-live-card__header span:first-child {
    color: var(--moss-deep);
  }

  .liiga-live-card__matchup {
    margin-top: 18px !important;
  }

  .liiga-live-card__score {
    margin-top: 7px !important;
    color: var(--moss-deep);
    font-size: clamp(4.8rem, 10vw, 8.6rem);
  }

  .liiga-table {
    border-top: 1px solid var(--liiga-rule);
    border-bottom: 1px solid var(--liiga-rule);
  }

  .liiga-row {
    display: grid;
    grid-template-columns: 30px minmax(170px, 1fr) repeat(7, minmax(42px, 0.34fr));
    align-items: center;
    min-height: 44px;
    border-bottom: 1px solid var(--liiga-rule);
    color: var(--stone);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .liiga-row:last-child {
    border-bottom: 0;
  }

  .liiga-row > span {
    min-width: 0;
    padding: 0 8px;
    text-align: right;
  }

  .liiga-row > span:first-child {
    padding-left: 2px;
    text-align: left;
  }

  .liiga-row--header {
    min-height: 31px;
    color: var(--stone-light);
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.055em;
  }

  .liiga-row--header > span:nth-child(2) {
    text-align: left;
  }

  .liiga-team {
    display: flex;
    align-items: center;
    gap: 9px;
    text-align: left !important;
  }

  .liiga-team-mark,
  .liiga-club-mark svg {
    width: 30px;
    height: 30px;
    flex: 0 0 auto;
    color: var(--stone);
  }

  .liiga-team-mark svg,
  .liiga-club-mark svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  :global(.liiga-team-mark__shape) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  :global(.liiga-team-mark__fill) {
    fill: currentColor;
    fill-rule: evenodd;
    stroke: none;
  }

  :global(.liiga-team-mark__detail) {
    stroke-width: 1.15;
    opacity: 0.78;
  }

  .liiga-team__name {
    overflow: hidden;
    color: var(--ink-soft);
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .liiga-points {
    color: var(--ink);
    font-weight: 700;
  }

  .liiga-row.is-ilves {
    background: color-mix(in srgb, var(--moss) 6%, transparent);
  }

  .liiga-row.is-ilves .liiga-team-mark,
  .liiga-row.is-ilves .liiga-team__name,
  .liiga-row.is-ilves .liiga-points,
  .liiga-row.is-ilves .liiga-rank {
    color: var(--moss-deep);
  }

  .liiga-club-grid {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    border-top: 1px solid var(--liiga-rule);
    border-left: 1px solid var(--liiga-rule);
  }

  .liiga-club-mark {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 10px;
    min-width: 0;
    min-height: 112px;
    padding: 18px 8px 14px;
    border-right: 1px solid var(--liiga-rule);
    border-bottom: 1px solid var(--liiga-rule);
    color: var(--stone);
    text-align: center;
  }

  .liiga-club-mark svg {
    width: 48px;
    height: 48px;
  }

  .liiga-club-mark span {
    overflow: hidden;
    width: 100%;
    color: var(--stone-light);
    font-size: 0.4rem;
    letter-spacing: 0.045em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .liiga-club-mark[data-liiga-club-mark="ilves"] {
    color: var(--moss-deep);
  }

  .liiga-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 24px;
    padding-top: 15px;
    color: var(--stone-light);
    font-size: 0.42rem;
    line-height: 1.5;
    letter-spacing: 0.055em;
  }

  .liiga-footer a,
  .liiga-error button {
    color: var(--stone);
  }

  .liiga-footer a {
    text-decoration: none;
  }

  .liiga-footer a:hover,
  .liiga-footer a:focus-visible,
  .liiga-error button:hover,
  .liiga-error button:focus-visible {
    color: var(--moss-deep);
  }

  .liiga-error {
    flex-basis: 100%;
  }

  .liiga-error button {
    min-width: 24px;
    min-height: 24px;
    padding: 0 2px;
    border: 0;
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  @media (max-width: 760px) {
    .liiga-heading {
      align-items: start;
    }

    .liiga-status-grid {
      grid-template-columns: 1fr;
    }

    .liiga-status-card {
      min-height: 162px;
    }

    .liiga-status-card__matchup {
      margin-top: 20px !important;
    }

    .liiga-status-card__position {
      margin-top: 25px !important;
    }

    .liiga-row {
      grid-template-columns: 26px minmax(110px, 1fr) 36px 38px 42px;
      min-height: 42px;
      font-size: 0.64rem;
    }

    .liiga-row > span {
      padding: 0 4px;
    }

    .liiga-row .liiga-col-secondary {
      display: none;
    }

    .liiga-row > span:nth-child(8) {
      grid-column: 4;
    }

    .liiga-row > span:nth-child(9) {
      grid-column: 5;
    }

    .liiga-team {
      grid-column: 2;
    }

    .liiga-team-mark {
      width: 27px;
      height: 27px;
    }

    .liiga-club-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .liiga-heading h2 {
      font-size: 2.65rem;
    }

    .liiga-source-state {
      font-size: 0.4rem;
    }

    .liiga-status-card__header,
    .liiga-live-card__header {
      font-size: 0.4rem;
    }

    .liiga-status-card__score {
      font-size: 3.5rem;
    }

    .liiga-live-card__score {
      font-size: 5rem;
    }

    .liiga-club-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .liiga-club-mark {
      min-height: 104px;
    }

    .liiga-club-mark svg {
      width: 44px;
      height: 44px;
    }
  }
</style>