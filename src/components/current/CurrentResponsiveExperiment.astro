---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import '../../styles/current-electricity-polish.css';
import '../../styles/current-electricity-summary.css';
import '../../styles/current-weather-compact.css';
import '../../styles/current-layout.css';
import NightModeToggle from '../NightModeToggle.astro';
import CurrentWeather from './CurrentWeather.astro';
import CurrentElectricity from './CurrentElectricity.astro';

const canonicalUrl = `${site.url}/lab/current-responsive/`;
---

<BaseLayout
  lang="en"
  title="Current responsive experiment | Aapo Pihkala"
  description="Local responsive-layout experiment for Current."
  canonicalUrl={canonicalUrl}
  finnishUrl={canonicalUrl}
  englishUrl={canonicalUrl}
  languageHref="/"
  initialNightMode
  includeDefaultSocialMeta={false}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <main id="main-content" tabindex="-1" class="current-shell current-responsive-experiment">
    <header class="responsive-experiment-status" aria-label="Responsive experiment diagnostics">
      <span>RESPONSIVE EXPERIMENT</span>
      <span aria-hidden="true">/</span>
      <span data-responsive-viewport>VIEWPORT</span>
      <span aria-hidden="true">/</span>
      <span data-responsive-dpr>DPR</span>
      <span aria-hidden="true">/</span>
      <span data-responsive-rem>REM</span>
    </header>

    <p class="responsive-experiment-note">
      Same Current components, but no JavaScript viewport-height fitting. Section height follows content.
    </p>

    <div class="current-section-wrap current-section-wrap--experiment" data-responsive-section="weather">
      <CurrentWeather />
    </div>

    <div class="current-section-wrap current-section-wrap--experiment" data-responsive-section="electricity">
      <CurrentElectricity />
    </div>
  </main>

  <Fragment slot="afterAnalytics">
    <script>
      import { initCurrentElectricityPresentation } from '../../features/current/electricityPresentation';
      import { initCurrentElectricitySummary } from '../../features/current/electricitySummary';

      initCurrentElectricityPresentation();
      initCurrentElectricitySummary();
    </script>

    <script is:inline>
      (() => {
        const viewport = document.querySelector('[data-responsive-viewport]')
        const dpr = document.querySelector('[data-responsive-dpr]')
        const rem = document.querySelector('[data-responsive-rem]')

        const update = () => {
          if (viewport) viewport.textContent = `${window.innerWidth} × ${window.innerHeight} CSS PX`
          if (dpr) dpr.textContent = `DPR ${window.devicePixelRatio}`
          if (rem) {
            const rootSize = getComputedStyle(document.documentElement).fontSize
            rem.textContent = `1REM ${rootSize}`
          }
        }

        update()
        window.addEventListener('resize', update, { passive: true })
      })()
    </script>

    <NightModeToggle lang="en" />
  </Fragment>
</BaseLayout>

<style>
  /* Keep horizontal clipping without turning the document into a scroll container. */
  :global(html:has(.current-responsive-experiment)),
  :global(body:has(.current-responsive-experiment)) {
    overflow-x: clip !important;
  }

  .current-responsive-experiment {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(20px, 2.4vw, 32px) clamp(18px, 3vw, 32px) 96px;
  }

  .responsive-experiment-status {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-items: baseline;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line-soft);
    color: var(--stone-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.055em;
  }

  .responsive-experiment-note {
    max-width: 70ch;
    margin: 12px 0 0;
    color: var(--stone);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    line-height: 1.45;
  }

  .current-section-wrap--experiment {
    min-height: 0 !important;
    scroll-margin-top: 0;
  }

  .current-section-wrap--experiment + .current-section-wrap--experiment {
    margin-top: clamp(28px, 4vw, 52px);
    border-top: 1px solid var(--line);
  }

  /* The experiment uses width-driven fluid sizing rather than viewport-height fitting. */
  :global(.current-responsive-experiment .current-weather) {
    padding-top: clamp(18px, 2.2vw, 24px);
  }

  :global(.current-responsive-experiment .weather-temperature) {
    font-size: clamp(4.35rem, 7.2vw, 6.1rem) !important;
  }

  :global(.current-responsive-experiment .current-electricity) {
    padding-top: clamp(22px, 2.6vw, 30px);
  }

  :global(.current-responsive-experiment .electricity-price) {
    font-size: clamp(4.6rem, 7.4vw, 6.5rem);
  }

  :global(.current-responsive-experiment .weather-daily-chart-frame),
  :global(.current-responsive-experiment .weather-daily-chart) {
    min-height: clamp(132px, 14vw, 168px);
    height: clamp(132px, 14vw, 168px);
  }

  :global(.current-responsive-experiment .electricity-chart) {
    height: clamp(170px, 17vw, 205px);
  }

  @media (max-width: 640px) {
    .current-responsive-experiment {
      padding: 20px 20px 80px;
    }

    .responsive-experiment-status,
    .responsive-experiment-note {
      font-size: 9px;
    }

    .current-section-wrap--experiment + .current-section-wrap--experiment {
      margin-top: 28px;
    }

    :global(.current-responsive-experiment .weather-temperature) {
      font-size: clamp(3.55rem, 18vw, 4.65rem) !important;
    }

    :global(.current-responsive-experiment .electricity-price) {
      font-size: clamp(3.8rem, 18vw, 4.9rem);
    }
  }

  @media (max-height: 720px) and (min-width: 641px) {
    .current-responsive-experiment {
      padding-top: 18px;
    }

    .current-section-wrap--experiment + .current-section-wrap--experiment {
      margin-top: 28px;
    }
  }
</style>
