---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import NightModeToggle from '../NightModeToggle.astro';
import CurrentMarkets from './CurrentMarkets.astro';

const canonicalUrl = `${site.url}/current/markets/`;
---

<BaseLayout
  lang="en"
  title="Markets | Current | Aapo Pihkala"
  description="A compact view of relevant market benchmarks and euro-area macro context."
  canonicalUrl={canonicalUrl}
  finnishUrl={canonicalUrl}
  englishUrl={canonicalUrl}
  languageHref="/current/"
  initialNightMode
  includeDefaultSocialMeta={false}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <main id="main-content" tabindex="-1" class="current-markets-shell">
    <header class="current-markets-status" aria-label="Current markets status">
      <a href="/current/" class="current-markets-status__link">Current</a>
      <span class="current-markets-status__separator" aria-hidden="true">/</span>
      <h1 class="current-markets-status__label">Markets</h1>
      <span class="current-markets-status__separator" aria-hidden="true">/</span>

      <p class="current-markets-clock" aria-label="Current time in Helsinki">
        <span data-current-date></span>
        <span aria-hidden="true">/</span>
        <span data-current-time></span>
      </p>

      <span class="current-markets-status__separator" aria-hidden="true">/</span>

      <p class="current-markets-updated">
        Updated <span data-current-updated>Waiting</span>
      </p>
    </header>

    <CurrentMarkets />
  </main>

  <Fragment slot="afterAnalytics">
    <script>
      import { initCurrentClock } from '../../features/current/clock';
      initCurrentClock();
    </script>

    <NightModeToggle lang="en" />
  </Fragment>
</BaseLayout>

<style>
  .current-markets-shell {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: 28px 32px 128px;
  }

  .current-markets-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-soft);
    color: var(--stone);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.5rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .current-markets-status h1,
  .current-markets-status p {
    margin: 0;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  .current-markets-status__link {
    color: var(--stone-light);
    text-decoration: none;
  }

  .current-markets-status__link:hover,
  .current-markets-status__link:focus-visible {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .current-markets-status__label,
  .current-markets-status__separator {
    color: var(--stone-light) !important;
  }

  .current-markets-clock {
    display: inline-flex;
    gap: 8px;
  }

  .current-markets-updated span {
    color: var(--stone-light);
  }

  @media (max-width: 640px) {
    .current-markets-shell {
      padding: 22px 24px 96px;
    }

    .current-markets-status {
      gap: 7px;
      padding-bottom: 14px;
      font-size: 0.47rem;
    }

    .current-markets-clock {
      gap: 7px;
    }
  }
</style>
