<section class="current-rates" data-current-rates data-current-markets aria-labelledby="current-rates-title">
  <header class="rates-heading">
    <p class="rates-index">RATES / 00</p>
  </header>

  <h2 id="current-rates-title" class="sr-only">Rates</h2>

  <section class="markets-macro" aria-label="Interest rate and world equity trends">
    <div class="markets-panel-heading">
      <p class="markets-panel-label">RATES / TRENDS</p>
      <p class="markets-panel-observation">
        OBS / <span data-markets-observation>WAITING</span>
      </p>
    </div>

    <div class="markets-macro__row markets-macro__row--chart">
      <p class="markets-macro__label">3M EURIBOR</p>
      <div class="markets-macro__reading">
        <p class="markets-macro__value"><span data-market-value="euribor-3m">-.---</span>%</p>
        <p class="markets-macro__change">
          <span data-market-series-change="euribor-3m">WAITING</span> / 1Y
        </p>
      </div>

      <div class="markets-sparkline-wrap">
        <div class="markets-sparkline-frame">
          <div class="markets-sparkline-axis" data-market-axis="euribor-3m" aria-hidden="true"></div>
          <div class="markets-sparkline-stage" data-market-chart-stage="euribor-3m">
            <svg
              class="markets-sparkline markets-sparkline--pending"
              data-market-sparkline="euribor-3m"
              viewBox="0 0 240 64"
              preserveAspectRatio="none"
              role="img"
              tabindex="0"
              aria-label="3 month Euribor one year trend. Touch, hover or use the arrow keys to inspect values."
            >
              <g class="markets-sparkline-grid" data-market-grid></g>
              <path data-market-line></path>
              <line class="markets-sparkline__inspection-line" data-market-inspection-line x1="0" x2="0" y1="2" y2="62" opacity="0"></line>
              <circle class="markets-sparkline__inspection-point" data-market-inspection-point cx="0" cy="0" r="3" opacity="0"></circle>
            </svg>
            <div class="markets-sparkline-tooltip" data-market-tooltip="euribor-3m" role="status" aria-live="polite" hidden>
              <span data-market-tooltip-date="euribor-3m">-- --- ----</span>
              <span class="markets-sparkline-tooltip__value" data-market-tooltip-value="euribor-3m">-.---%</span>
            </div>
          </div>
        </div>
        <p class="markets-sparkline__fallback" data-market-sparkline-fallback="euribor-3m">LOADING</p>
      </div>
    </div>

    <div class="markets-macro__row markets-macro__row--chart">
      <p class="markets-macro__label">WORLD</p>
      <div class="markets-macro__reading">
        <p class="markets-macro__value" data-market-series-change="world">WAITING</p>
        <p class="markets-macro__change">1Y</p>
      </div>

      <div class="markets-sparkline-wrap">
        <p class="markets-sparkline-context">INDEXED / 100 = 1Y AGO</p>
        <div class="markets-sparkline-frame">
          <div class="markets-sparkline-axis" data-market-axis="world" aria-hidden="true"></div>
          <div class="markets-sparkline-stage" data-market-chart-stage="world">
            <svg
              class="markets-sparkline markets-sparkline--pending"
              data-market-sparkline="world"
              viewBox="0 0 240 64"
              preserveAspectRatio="none"
              role="img"
              tabindex="0"
              aria-label="World equity one year trend indexed to 100 at the start of the period. Touch, hover or use the arrow keys to inspect values."
            >
              <g class="markets-sparkline-grid" data-market-grid></g>
              <path data-market-line></path>
              <line class="markets-sparkline__inspection-line" data-market-inspection-line x1="0" x2="0" y1="2" y2="62" opacity="0"></line>
              <circle class="markets-sparkline__inspection-point" data-market-inspection-point cx="0" cy="0" r="3" opacity="0"></circle>
            </svg>
            <div class="markets-sparkline-tooltip" data-market-tooltip="world" role="status" aria-live="polite" hidden>
              <span data-market-tooltip-date="world">-- --- ----</span>
              <span class="markets-sparkline-tooltip__value" data-market-tooltip-value="world">---.-</span>
            </div>
          </div>
        </div>
        <p class="markets-sparkline__fallback" data-market-sparkline-fallback="world">LOADING</p>
      </div>
    </div>
  </section>

  <footer class="markets-footer">
    <p>
      DATA /
      <a href="https://data.ecb.europa.eu/" target="_blank" rel="noopener">ECB</a>
      ·
      <a href="https://www.suomenpankki.fi/en/statistics/interest-rates-and-exchange-rates/euribor-rates/" target="_blank" rel="noopener">BANK OF FINLAND</a>
      ·
      <a href="https://finance.yahoo.com/quote/URTH/" target="_blank" rel="noopener nofollow">YAHOO FINANCE</a>
    </p>

    <p class="markets-error" data-markets-error hidden>
      Rate trend data unavailable.
      <button type="button" data-markets-retry>Retry</button>
    </p>
  </footer>
</section>

<script>
  import { initCurrentMarkets } from '../../features/current/markets';
  initCurrentMarkets();
</script>

