---
interface Props {
  mode?: 'preview' | 'standalone';
}

const { mode = 'standalone' } = Astro.props;
const isPreview = mode === 'preview';
---

<main class={isPreview ? 'preview-shell' : 'widget-standalone-shell'} data-widget-root data-mode={mode}>
  {isPreview && (
    <header class="preview-tools">
      <div>
        <p class="eyebrow">ANDROID / SNAPSHOT</p>
        <h1>Snapshot Widget Preview</h1>
      </div>
      <nav aria-label="Widget preview controls">
        <button type="button" data-size="compact">COMPACT</button>
        <button type="button" data-size="medium">MEDIUM</button>
        <button type="button" data-size="large">LARGE</button>
        <button type="button" data-channel="prod">PROD</button>
        <button type="button" data-channel="dev">DEV</button>
      </nav>
    </header>
  )}

  <p class="preview-status" data-status aria-live="polite">Loading widget payload...</p>
  <section class="device-stage" data-stage data-size="large">
    <article class="widget-preview" data-widget aria-live="polite">
      <div class="widget-message">
        <strong>LOADING</strong>
        <span>SNAPSHOT / PROD</span>
      </div>
    </article>
  </section>
</main>

<script is:inline>
      const status = document.querySelector('[data-status]');
      const stage = document.querySelector('[data-stage]');
      const widget = document.querySelector('[data-widget]');
      const root = document.querySelector('[data-widget-root]');
      const isPreview = root?.dataset.mode === 'preview';
      const params = new URLSearchParams(window.location.search);
      let size = ['compact', 'medium', 'large'].includes(params.get('size') ?? '')
        ? params.get('size')
        : 'large';
      let channel = isPreview && params.get('channel') === 'dev' ? 'dev' : 'prod';
      let payload = null;

      const escapeHtml = (value) => value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

      const toneClass = (tone) => tone ? `tone-${tone}` : 'tone-neutral';

      const localTime = (value) => {
        const date = new Date(value);
        if (!Number.isFinite(date.getTime())) return value;
        return new Intl.DateTimeFormat('en-GB', {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZone: 'Europe/Helsinki',
        }).format(date);
      };

      const isoWeek = (year, month, day) => {
        const date = new Date(Date.UTC(year, month - 1, day));
        const weekday = date.getUTCDay() || 7;
        date.setUTCDate(date.getUTCDate() + 4 - weekday);
        const yearStart = new Date(Date.UTC(date.getUTCFullYear(), 0, 1));
        return Math.ceil((((date.getTime() - yearStart.getTime()) / 86_400_000) + 1) / 7);
      };

      const currentHeaderDateTime = () => {
        const now = new Date();
        const parts = new Intl.DateTimeFormat('en-GB', {
          weekday: 'short',
          day: '2-digit',
          month: 'short',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
          timeZone: 'Europe/Helsinki',
        }).formatToParts(now);
        const part = (type) =>
          parts.find((item) => item.type === type)?.value ?? '';
        const year = Number(part('year'));
        const monthName = part('month').slice(0, 3).toUpperCase();
        const monthNumber = Number(new Intl.DateTimeFormat('en-GB', {
          month: '2-digit',
          timeZone: 'Europe/Helsinki',
        }).format(now));
        const day = Number(part('day'));
        const week = isoWeek(year, monthNumber, day);
        return {
          time: `${part('hour')}:${part('minute')}`,
          timeSeconds: `${part('hour')}:${part('minute')}:${part('second')}`,
          date: `${part('weekday').toUpperCase()} ${String(day).padStart(2, '0')} ${monthName} ${year} / W${String(week).padStart(2, '0')}`,
          dateShort: `${part('weekday').toUpperCase()} ${String(day).padStart(2, '0')} ${monthName}`,
          week: `W${String(week).padStart(2, '0')}`,
        };
      };

      const primaryParts = (value) => {
        const text = String(value ?? '').trim();
        const spaced = text.match(/^(.+?)\s+(c\/kWh|MIN|min)$/i);
        if (spaced) {
          return {
            value: spaced[1],
            unit: spaced[2].toUpperCase() === 'MIN' ? 'min' : spaced[2],
            gap: true,
          };
        }
        const attached = text.match(/^(.+?)(°C|%)$/);
        return attached
          ? { value: attached[1], unit: attached[2], gap: attached[2] === '°C' }
          : { value: text, unit: '', gap: false };
      };

      const renderAndroidPrimary = (value, tone) => {
        const parts = primaryParts(value);
        return `
          <div class="android-primary ${toneClass(tone)}">
            <span>${escapeHtml(parts.value)}</span>
            ${parts.unit ? `<small class="${parts.gap ? 'has-gap' : ''}">${escapeHtml(parts.unit)}</small>` : ''}
          </div>
        `;
      };

      const detailLines = (detail) => String(detail ?? '')
        .split('\n')
        .map((line) => line.trim())
        .filter(Boolean);

      const visibleRows = (section) => {
        const rows = section.rows ?? [];
        if (section.id !== 'hsl' || section.countdownTargetMs === undefined) return rows;
        return rows
          .filter((row) => row.countdownTargetMs !== section.countdownTargetMs)
          .slice(0, 5);
      };

      const renderAndroidRows = (rows = []) => rows.map((row) => `
        <div class="android-row">
          <span>${escapeHtml(row.label)}</span>
          <strong class="${toneClass(row.tone)}">${escapeHtml(row.value)}</strong>
        </div>
      `).join('');

      const parseSolarDetail = (detail) => {
        const line = detailLines(detail).find((item) => item.includes('↑') && item.includes('↓'));
        const match = line?.match(/↑(\d{2}:\d{2})\s+↓(\d{2}:\d{2})\s+☀([^\s]+)/);
        return match ? { sunrise: match[1], sunset: match[2], daylight: match[3] } : null;
      };

      const clockMinutes = (value) => {
        const match = String(value ?? '').match(/^(\d{2}):(\d{2})$/);
        return match ? Number(match[1]) * 60 + Number(match[2]) : null;
      };

      const helsinkiMinutesNow = () => {
        const parts = new Intl.DateTimeFormat('en-GB', {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZone: 'Europe/Helsinki',
        }).formatToParts(new Date());
        const part = (type) => Number(parts.find((item) => item.type === type)?.value ?? 0);
        return part('hour') * 60 + part('minute');
      };

      const solarMarkerStyle = (solar) => {
        const sunrise = clockMinutes(solar?.sunrise);
        const sunset = clockMinutes(solar?.sunset);
        if (sunrise === null || sunset === null || sunset <= sunrise) return '';
        const now = helsinkiMinutesNow();
        let angle;
        let night = false;
        if (now >= sunrise && now <= sunset) {
          const progress = (now - sunrise) / (sunset - sunrise);
          angle = Math.PI - progress * Math.PI;
        } else {
          night = true;
          const nightLength = 1440 - sunset + sunrise;
          const elapsed = now > sunset ? now - sunset : 1440 - sunset + now;
          angle = -Math.min(1, elapsed / nightLength) * Math.PI;
        }
        const x = 50 + Math.cos(angle) * 43;
        const y = 50 - Math.sin(angle) * 43;
        return `--sun-x:${x.toFixed(1)}%;--sun-y:${y.toFixed(1)}%;--sun-fill:${night ? 'transparent' : 'var(--foreground)'};`;
      };

      const renderAndroidHeading = (section) => `
        <div class="android-heading">
          <span>${escapeHtml(section.index)}</span>
          <strong>${escapeHtml(section.label)}</strong>
        </div>
      `;

      const renderAndroidWeather = (section) => {
        const lines = detailLines(section.detail);
        const nowLine = lines[0] ?? '';
        const nowParts = nowLine.split(' / ').map((part) => part.trim()).filter(Boolean);
        const condition = nowParts.shift() ?? '';
        const range = nowParts.join(' / ');
        const solar = parseSolarDetail(section.detail);
        const forecast = (section.columns ?? []).slice(0, 6);
        return `
          <section class="android-section android-weather" data-section="${escapeHtml(section.id)}" data-span="${escapeHtml(section.span ?? 'full')}" data-layout="${escapeHtml(section.layout ?? 'stack')}">
            ${renderAndroidHeading(section)}
            <div class="android-weather-top">
              <div class="android-weather-now">
                ${section.secondary ? `<div class="android-secondary">${escapeHtml(section.secondary)}</div>` : ''}
                ${renderAndroidPrimary(section.primary, section.tone)}
                ${condition || range ? `<div class="android-weather-condition">${escapeHtml(condition)}${condition && range ? ' ' : ''}<small>${escapeHtml(range)}</small></div>` : ''}
              </div>
              ${solar ? `
                <div class="android-solar">
                  <strong>${escapeHtml(solar.daylight)}</strong>
                  <div>
                    <span>${escapeHtml(solar.sunrise)}</span>
                    <i class="android-solar-disk" style="${solarMarkerStyle(solar)}"><b></b></i>
                    <span>${escapeHtml(solar.sunset)}</span>
                  </div>
                </div>
              ` : ''}
            </div>
            ${forecast.length ? `
              <div class="android-forecast">
                ${forecast.map((point) => `
                  <div><span>${escapeHtml(point.label)}</span><strong>${escapeHtml(point.value)}</strong></div>
                `).join('')}
              </div>
            ` : ''}
          </section>
        `;
      };

      const renderAndroidElectricityChart = (section) => {
        const bars = section.bars ?? [];
        const nowRow = (section.rows ?? []).find((row) => row.label === 'NOW');
        const currentPrice = String(nowRow?.value ?? '').trim().split(' ')[0];
        const marker = Math.max(0, Math.min(100, helsinkiMinutesNow() / 1440 * 100));
        const align = marker > 88 ? 'end' : marker < 12 ? 'start' : 'center';
        return `
          <div class="android-electricity-chart" aria-label="Electricity price profile">
            ${currentPrice ? `<strong class="android-chart-price is-${align}" style="left:${marker}%">${escapeHtml(currentPrice)}</strong>` : ''}
            <div class="android-chart-bars">
              ${bars.map((bar) => `<i style="height:${Math.max(14, Math.min(100, 14 + bar * 86))}%"></i>`).join('')}
            </div>
            <b class="android-time-marker" style="left:${marker}%"></b>
            <div class="android-axis"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div>
          </div>
        `;
      };

      const renderAndroidElectricity = (section) => `
        <section class="android-section android-split-section android-electricity" data-section="${escapeHtml(section.id)}" data-span="${escapeHtml(section.span ?? 'full')}" data-layout="${escapeHtml(section.layout ?? 'split')}">
          <div class="android-split-main">
            ${renderAndroidHeading(section)}
            ${section.secondary ? `<div class="android-secondary">${escapeHtml(section.secondary)}</div>` : ''}
            ${renderAndroidPrimary(section.primary, section.tone)}
          </div>
          ${renderAndroidElectricityChart(section)}
          ${section.detail ? `<div class="android-electricity-detail">${detailLines(section.detail).slice(0, 3).map((line) => `<span>${escapeHtml(line)}</span>`).join('')}</div>` : ''}
        </section>
      `;

      const renderAndroidSplit = (section) => `
        <section class="android-section android-split-section" data-section="${escapeHtml(section.id)}" data-span="${escapeHtml(section.span ?? 'full')}" data-layout="${escapeHtml(section.layout ?? 'split')}">
          <div class="android-split-main">
            ${renderAndroidHeading(section)}
            ${section.secondary ? `<div class="android-secondary">${escapeHtml(section.secondary)}</div>` : ''}
            ${renderAndroidPrimary(section.primary, section.tone)}
            ${section.detail ? `<div class="android-detail">${escapeHtml(section.detail)}</div>` : ''}
          </div>
          <div class="android-support">${renderAndroidRows(visibleRows(section).slice(0, 5))}</div>
        </section>
      `;

      const renderAndroidHalf = (section) => `
        <section class="android-half-section" data-section="${escapeHtml(section.id)}" data-span="half" data-layout="${escapeHtml(section.layout ?? 'stack')}">
          ${renderAndroidHeading(section)}
          ${renderAndroidPrimary(section.primary, section.tone)}
          ${section.secondary ? `<div class="android-half-copy">${escapeHtml(section.secondary)}</div>` : ''}
          ${section.detail ? `<div class="android-half-copy">${escapeHtml(section.detail)}</div>` : ''}
        </section>
      `;

      const renderAndroidLarge = (sections) => {
        const byId = new Map(sections.map((section) => [section.id, section]));
        const weather = byId.get('weather');
        const electricity = byId.get('electricity');
        const markets = byId.get('markets');
        const hsl = byId.get('hsl');
        const rates = byId.get('rates');
        const liiga = byId.get('liiga');
        return [
          weather ? renderAndroidWeather(weather) : '',
          electricity ? renderAndroidElectricity(electricity) : '',
          markets ? renderAndroidSplit(markets) : '',
          hsl ? renderAndroidSplit(hsl) : '',
          rates || liiga ? `
            <div class="android-half-row">
              ${rates ? renderAndroidHalf(rates) : '<div></div>'}
              ${liiga ? renderAndroidHalf(liiga) : '<div></div>'}
            </div>
          ` : '',
        ].join('');
      };

      const renderRows = (rows = []) => rows.map((row) => `
        <div class="metric-row">
          <span>${escapeHtml(row.label)}</span>
          <strong class="${toneClass(row.tone)}">${escapeHtml(row.value)}</strong>
        </div>
      `).join('');

      const renderColumns = (columns = []) => columns.length === 0 ? '' : `
        <div class="metric-columns">
          ${columns.map((column) => `
            <div>
              <span>${escapeHtml(column.label)}</span>
              <strong class="${toneClass(column.tone)}">${escapeHtml(column.value)}</strong>
            </div>
          `).join('')}
        </div>
      `;

      const renderBars = (bars = []) => bars.length === 0 ? '' : `
        <div class="metric-bars" aria-hidden="true">
          ${bars.map((bar) => `<i style="height:${Math.max(8, Math.min(100, bar * 100))}%"></i>`).join('')}
        </div>
      `;

      const renderSupport = (section) => {
        const rows = section.id === 'hsl' && section.countdownTargetMs !== undefined
          ? (section.rows ?? [])
              .filter((row) => row.countdownTargetMs !== section.countdownTargetMs)
              .slice(0, 5)
          : section.rows;
        return [
          renderColumns(section.columns),
          renderBars(section.bars),
          renderRows(rows),
        ].filter(Boolean).join('');
      };

      const renderSection = (section) => {
        const span = section.span ?? 'full';
        const layout = section.layout ?? 'stack';
        const support = renderSupport(section);
        const fullWidthDetail = section.id === 'electricity' && section.detail
          ? `<div class="metric-detail metric-detail--full">${escapeHtml(section.detail)}</div>`
          : '';
        const inlineDetail = section.id !== 'electricity' && section.detail
          ? `<div class="metric-detail">${escapeHtml(section.detail)}</div>`
          : '';
        return `
          <section class="metric-section span-${span} layout-${layout}" data-section="${escapeHtml(section.id)}" data-span="${span}" data-layout="${layout}">
            <div class="metric-heading"><span>${escapeHtml(section.index)}</span><strong>${escapeHtml(section.label)}</strong></div>
            <div class="metric-body">
              <div class="metric-main">
                ${section.secondary ? `<div class="metric-secondary">${escapeHtml(section.secondary)}</div>` : ''}
                <div class="metric-primary ${toneClass(section.tone)}">${escapeHtml(section.primary)}</div>
                ${inlineDetail}
              </div>
              ${support ? `<div class="metric-support">${support}</div>` : ''}
              ${fullWidthDetail}
            </div>
          </section>
        `;
      };

      const applyTheme = (theme) => {
        if (!widget) return;
        for (const [key, value] of Object.entries(theme)) {
          widget.style.setProperty(`--${key}`, value);
        }
      };

      const updateStandaloneClock = () => {
        if (isPreview || !widget) return;
        const header = currentHeaderDateTime();
        const clock = widget.querySelector('[data-live-clock]');
        const date = widget.querySelector('[data-live-date]');
        const week = widget.querySelector('[data-live-week]');
        if (clock) {
          const [hours, minutes, seconds] = header.timeSeconds.split(':');
          clock.innerHTML = `${escapeHtml(hours)}:${escapeHtml(minutes)}<small>:${escapeHtml(seconds)}</small>`;
        }
        if (date) date.textContent = header.dateShort;
        if (week) week.textContent = header.week;
      };

      const bindStandaloneRefresh = () => {
        if (isPreview || !widget) return;
        const button = widget.querySelector('[data-widget-refresh]');
        button?.addEventListener('click', () => {
          const footerStatus = widget.querySelector('[data-footer-status]');
          if (footerStatus) footerStatus.textContent = 'UPDATING';
          button.setAttribute('aria-busy', 'true');
          void load();
        });
      };

      const render = () => {
        if (!payload || !widget || !stage) return;
        stage.dataset.size = size;
        applyTheme(payload.theme);
        const header = currentHeaderDateTime();
        const byId = new Map(payload.sections.map((section) => [section.id, section]));
        const ids = payload.layouts[size] ?? [];
        const sections = ids.map((id) => byId.get(id)).filter(Boolean);

        if (!isPreview && size === 'large') {
          widget.innerHTML = `
            <header class="android-header">
              <strong data-live-clock>${escapeHtml(header.timeSeconds)}</strong>
              <span data-live-date>${escapeHtml(header.dateShort)}</span>
              <b data-live-week>${escapeHtml(header.week)}</b>
            </header>
            <div class="android-sections">${renderAndroidLarge(sections)}</div>
            <footer class="android-footer">
              <span data-footer-status>UPDATED ${escapeHtml(localTime(payload.generatedAt))}</span>
              <button type="button" data-widget-refresh aria-label="Refresh widget"><span class="android-refresh-icon" aria-hidden="true"></span></button>
            </footer>
          `;
          updateStandaloneClock();
          bindStandaloneRefresh();
        } else {
          widget.innerHTML = `
            <header class="widget-header">
              <div>
                <strong>${escapeHtml(header.time)}</strong>
                <span>${escapeHtml(header.date)}</span>
                <span>UPDATED ${escapeHtml(localTime(payload.generatedAt))}</span>
              </div>
              <b>REFRESH</b>
            </header>
            <div class="widget-sections">${sections.map(renderSection).join('')}</div>
          `;
        }
        if (status) status.textContent = `SCHEMA ${payload.schemaVersion} / ${payload.channel.toUpperCase()} / ${size.toUpperCase()}`;
      };

      const updateUrl = () => {
        if (!isPreview) return;
        const next = new URL(window.location.href);
        next.searchParams.set('size', size);
        next.searchParams.set('channel', channel);
        window.history.replaceState({}, '', next);
      };

      const load = async () => {
        if (status) status.textContent = 'Loading widget payload...';
        if (root) root.dataset.loadState = 'loading';
        try {
          const response = await fetch(`/api/current/widget-v2?channel=${channel}`, {
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          payload = await response.json();
          render();
          if (root) root.dataset.loadState = 'ready';
        } catch (error) {
          const message = error instanceof Error ? error.message : 'unknown error';
          if (root) root.dataset.loadState = 'error';
          if (status) status.textContent = `Widget unavailable: ${message}`;
          if (widget) {
            widget.innerHTML = `
              <div class="widget-message">
                <strong>UNAVAILABLE</strong>
                <span>${escapeHtml(message)}</span>
              </div>
            `;
          }
        }
      };

      document.querySelectorAll('[data-size]').forEach((button) => {
        button.addEventListener('click', () => {
          size = button.dataset.size;
          updateUrl();
          render();
        });
      });
      document.querySelectorAll('[data-channel]').forEach((button) => {
        button.addEventListener('click', () => {
          channel = button.dataset.channel === 'dev' ? 'dev' : 'prod';
          updateUrl();
          void load();
        });
      });

      updateUrl();
      void load();
      if (!isPreview) window.setInterval(updateStandaloneClock, 1000);
</script>

<style is:global>
  :root {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    background: #0f151a;
    color: #e8edf0;
  }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; background: #0f151a; }
  button { font: inherit; }
  .preview-shell { width: min(980px, 100%); margin: 0 auto; padding: 24px 16px 64px; }
  .preview-tools { display: flex; gap: 24px; align-items: flex-end; justify-content: space-between; border-bottom: 1px solid #44515b; padding-bottom: 16px; }
  .preview-tools h1 { margin: 2px 0 0; font-size: clamp(20px, 4vw, 32px); font-weight: 500; }
  .eyebrow, .preview-status { margin: 0; color: #9ca8b0; font-size: 11px; letter-spacing: .08em; }
  nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; }
  nav button { border: 1px solid #65727b; background: transparent; color: #dfe6ea; padding: 7px 9px; cursor: pointer; }
  nav button:hover { background: #24323d; }
  .preview-status { margin: 12px 0; }
  .device-stage { margin: 0 auto; transition: width .2s ease; }
  .device-stage[data-size="compact"] { width: min(100%, 360px); }
  .device-stage[data-size="medium"] { width: min(100%, 520px); }
  .device-stage[data-size="large"] { width: min(100%, 620px); }
  .widget-preview {
    --background: #1d2a35;
    --panel: #22323e;
    --foreground: #eef2f4;
    --muted: #aab4bc;
    --line: #64717b;
    --accent: #dce4e8;
    --positive: #15967f;
    --negative: #c45f6c;
    min-height: 220px;
    border-radius: 28px;
    background: var(--background);
    color: var(--foreground);
    overflow: hidden;
    padding: 18px;
    box-shadow: 0 24px 80px rgb(0 0 0 / 24%);
  }
  [data-size="large"] .widget-preview { min-height: 700px; }
  [data-size="medium"] .widget-preview { min-height: 340px; }
  .widget-message {
    min-height: 180px;
    display: grid;
    place-content: center;
    gap: 6px;
    text-align: center;
    color: var(--muted);
  }
  .widget-message strong {
    color: var(--foreground);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: .08em;
  }
  .widget-message span {
    font-size: 9px;
    letter-spacing: .05em;
  }
  .widget-header { display: flex; align-items: center; justify-content: space-between; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .widget-header div { display: grid; gap: 2px; }
  .widget-header strong { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 19px; font-weight: 500; }
  .widget-header span { color: var(--muted); font-size: 8px; }
  .widget-header b { color: var(--accent); font-size: 9px; }
  .widget-sections { display: grid; }
  [data-size="compact"] .widget-sections,
  [data-size="medium"] .widget-sections,
  [data-size="large"] .widget-sections { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .metric-section { padding: 14px 10px; min-width: 0; border-bottom: 1px solid var(--line); }
  [data-size="large"] .metric-section.span-full { grid-column: 1 / -1; }
  [data-size="large"] .metric-section.span-half { grid-column: span 1; }
  [data-size="large"] .metric-section.span-half + .metric-section.span-half { border-left: 1px solid var(--line); }
  [data-size="compact"] .metric-section:nth-child(odd),
  [data-size="medium"] .metric-section:nth-child(odd) { border-right: 1px solid var(--line); }
