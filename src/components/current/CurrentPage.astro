---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import '../../styles/current-electricity-polish.css';
import '../../styles/current-electricity-summary.css';
import '../../styles/current-weather-compact.css';
import '../../styles/current-layout.css';
import NightModeToggle from '../NightModeToggle.astro';
import CurrentWeather from './CurrentWeather.astro';
import CurrentElectricity from './CurrentElectricity.astro';
import CurrentMarkets from './CurrentMarkets.astro';
import CurrentSectionNavigator from './CurrentSectionNavigator.astro';

const canonicalUrl = `${site.url}/current/`;
---

<BaseLayout
  lang="en"
  title="Current | Aapo Pihkala"
  description="A personal view of what matters right now."
  canonicalUrl={canonicalUrl}
  finnishUrl={canonicalUrl}
  englishUrl={canonicalUrl}
  languageHref="/"
  initialNightMode
  includeDefaultSocialMeta={false}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <main id="main-content" tabindex="-1" class="current-shell">
    <header class="current-status-strip" aria-label="Current status">
      <h1 class="current-status-strip__label">Current</h1>
      <span class="current-status-strip__separator" aria-hidden="true">/</span>

      <p class="current-clock" aria-label="Current time in Helsinki">
        <span data-current-date></span>
        <span aria-hidden="true">/</span>
        <span data-current-time></span>
      </p>

      <span class="current-status-strip__separator" aria-hidden="true">/</span>

      <p class="current-updated">
        Updated <span data-current-updated>Waiting</span>
      </p>
    </header>

    <div class="current-section-wrap current-section-wrap--weather" data-current-section="weather">
      <CurrentWeather />
    </div>

    <div class="current-section-wrap" data-current-section="electricity">
      <CurrentElectricity />
    </div>

    <div class="current-section-wrap" data-current-section="markets">
      <CurrentMarkets />
    </div>

    <script is:inline>
      const sectionLinks = [
        ['.weather-index', '/current/weather/', 'Open Weather'],
        ['.electricity-index', '/current/electricity/', 'Open Electricity'],
        ['.markets-index', '/current/markets/', 'Open Markets'],
      ]

      for (const [selector, href, label] of sectionLinks) {
        const heading = document.querySelector(selector)
        if (!(heading instanceof HTMLElement) || heading.querySelector('a')) continue

        const link = document.createElement('a')
        link.href = href
        link.className = 'current-section-heading-link'
        link.setAttribute('aria-label', label)

        while (heading.firstChild) link.append(heading.firstChild)
        heading.append(link)
      }
    </script>
  </main>

  <CurrentSectionNavigator />

  <Fragment slot="afterAnalytics">
    <script>
      import { initCurrentClock } from '../../features/current/clock';
      import { initCurrentElectricityPresentation } from '../../features/current/electricityPresentation';
      import { initCurrentElectricitySummary } from '../../features/current/electricitySummary';

      initCurrentClock();
      initCurrentElectricityPresentation();
      initCurrentElectricitySummary();
    </script>

    <NightModeToggle lang="en" />
  </Fragment>
</BaseLayout>

<style>
  .current-shell {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: 28px 32px 128px;
  }

  .current-status-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-soft);
    color: var(--stone);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.5rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .current-status-strip h1,
  .current-status-strip p {
    margin: 0;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  .current-status-strip__label {
    color: var(--stone-light) !important;
  }

  .current-status-strip__separator {
    color: var(--stone-light);
  }

  .current-clock {
    display: inline-flex;
    gap: 8px;
  }

  .current-updated span {
    color: var(--stone-light);
  }

  :global(.current-section-heading-link) {
    color: inherit;
    text-decoration: none;
  }

  :global(.current-section-heading-link:hover),
  :global(.current-section-heading-link:focus-visible) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .current-section-wrap {
    scroll-margin-top: 64px;
  }

  .current-section-wrap--weather {
    box-sizing: border-box;
    min-height: calc(100svh - 116px);
  }

  .current-section-wrap + .current-section-wrap {
    border-top: 1px solid var(--line);
  }

  @media (max-width: 640px) {
    .current-shell {
      padding: 22px 24px 96px;
    }

    .current-status-strip {
      gap: 7px;
      padding-bottom: 14px;
      font-size: 0.47rem;
    }

    .current-clock {
      gap: 7px;
    }

    .current-section-wrap--weather {
      min-height: calc(100svh - 108px);
    }
  }
</style>