<button
  class="current-section-nav-button"
  type="button"
  data-current-section-nav
  aria-label="Scroll to the next Current section"
>
  <svg viewBox="0 0 14 10" aria-hidden="true">
    <path d="M2 2.5 L7 7.5 L12 2.5 Z"></path>
  </svg>
</button>

<aside
  class="current-section-source-rail"
  data-current-mobile-source-rail
  data-current-source="weather"
  aria-label="Current data source"
>
  <p data-current-source-item="weather">
    DATA /
    <a href="https://open-meteo.com/" target="_blank" rel="noopener">OPEN-METEO</a>
    · CC BY 4.0 · 15 MIN
  </p>
  <p data-current-source-item="electricity">
    DATA /
    <a href="https://www.porssisahko.net/api-v1" target="_blank" rel="noopener">PÖRSSISÄHKÖ.NET</a>
    · 15 MIN · VAT INCLUDED
  </p>
  <p data-current-source-item="markets">
    DATA /
    <a href="https://finance.yahoo.com/" target="_blank" rel="noopener nofollow">YAHOO FINANCE</a>
  </p>
  <p data-current-source-item="rates">
    DATA /
    <a href="https://www.suomenpankki.fi/en/statistics/interest-rates-and-exchange-rates/euribor-rates/" target="_blank" rel="noopener">BANK OF FINLAND</a>
    ·
    <a href="https://data.ecb.europa.eu/" target="_blank" rel="noopener">ECB</a>
    ·
    <a href="https://stooq.com/" target="_blank" rel="noopener nofollow">STOOQ</a>
  </p>
</aside>

<style is:global>
  .current-section-nav-button {
    position: fixed;
    left: 50%;
    bottom: 28px;
    z-index: 120;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--stone-light);
    opacity: 0.64;
    cursor: pointer;
    transform: translateX(-50%);
    transition:
      color 150ms ease,
      opacity 150ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .current-section-nav-button:hover,
  .current-section-nav-button:focus-visible {
    color: var(--moss-deep);
    opacity: 0.94;
  }

  .current-section-nav-button:hover {
    transform: translate(-50%, 1px);
  }

  .current-section-nav-button:focus-visible {
    outline: 1px solid var(--lichen);
    outline-offset: 3px;
  }

  .current-section-nav-button svg {
    width: 14px;
    height: 10px;
    overflow: visible;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .current-section-nav-button path {
    fill: currentColor;
    stroke: none;
  }

  .current-section-nav-button.is-up svg {
    transform: rotate(180deg);
  }

  .current-section-nav-button.is-up:hover {
    transform: translate(-50%, -1px);
  }

  .current-section-source-rail {
    display: none;
  }

  @media (max-width: 640px) {
    .current-section-nav-button {
      bottom: 16px;
      width: 28px;
      height: 28px;
    }

    .current-section-nav-button svg {
      width: 14px;
      height: 10px;
    }

    .current-section-source-rail {
      position: fixed;
      left: 24px;
      right: 24px;
      bottom: 62px;
      z-index: 110;
      display: block;
      min-height: 24px;
      padding-top: 8px;
      border-top: 1px solid color-mix(in srgb, var(--line-soft) 58%, transparent);
      background: var(--page);
      color: var(--stone-light);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.39rem;
      font-weight: 500;
      line-height: 1.45;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .current-section-source-rail p {
      display: none;
      margin: 0;
    }

    .current-section-source-rail[data-current-source='weather'] [data-current-source-item='weather'],
    .current-section-source-rail[data-current-source='electricity'] [data-current-source-item='electricity'],
    .current-section-source-rail[data-current-source='markets'] [data-current-source-item='markets'],
    .current-section-source-rail[data-current-source='rates'] [data-current-source-item='rates'] {
      display: block;
    }

    .current-section-source-rail a {
      color: var(--stone);
      text-decoration: none;
    }

    .current-section-source-rail a:hover,
    .current-section-source-rail a:focus-visible {
      color: var(--moss-deep);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .current-section-nav-button,
    .current-section-nav-button svg {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-current-section-nav]')
    if (!(button instanceof HTMLButtonElement)) return
    if (button.dataset.initialized === 'true') return
    button.dataset.initialized = 'true'

    const sourceRail = document.querySelector('[data-current-mobile-source-rail]')
    const reducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const behavior = () => reducedMotion() ? 'auto' : 'smooth'
    const mobileSections = window.matchMedia('(max-width: 640px)')
    const SECTION_DIVIDER_MASK_INSET = 2

    const getDocumentTop = (section) =>
      section.getBoundingClientRect().top + window.scrollY

    const getTopbarHeight = () => {
      const topbar = document.querySelector('.topbar')
      if (!(topbar instanceof HTMLElement)) return 0
      return Math.max(0, topbar.getBoundingClientRect().height)
    }

    const getMaskedSectionTop = () =>
      Math.max(0, getTopbarHeight() - SECTION_DIVIDER_MASK_INSET)

    let sections = []
    let currentTarget = null

    const getSectionScrollTop = (section) =>
      Math.max(0, getDocumentTop(section) - getMaskedSectionTop())

    const updateSourceRail = (section) => {
      if (!(sourceRail instanceof HTMLElement) || !(section instanceof HTMLElement)) return
      const source = section.dataset.currentSection || section.dataset.currentMobileSection || ''
      sourceRail.dataset.currentSource = source
    }

    const updateState = () => {
      if (!sections.length) return

      const y = window.scrollY
      const threshold = y + getTopbarHeight()
      let currentIndex = 0

      sections.forEach((section, index) => {
        if (getDocumentTop(section) <= threshold) currentIndex = index
      })

      updateSourceRail(sections[currentIndex])

      if (currentIndex < sections.length - 1) {
        currentTarget = sections[currentIndex + 1]
        button.classList.remove('is-up')
        const label = currentTarget.dataset.currentSection || currentTarget.dataset.currentMobileSection || 'next section'
        button.setAttribute('aria-label', `Scroll to ${label}`)
        return
      }

      currentTarget = null
      button.classList.add('is-up')
      button.setAttribute('aria-label', 'Back to Current top')
    }

    const resolveSections = () => {
      const selector = mobileSections.matches
        ? '[data-current-section], [data-current-mobile-section]'
        : '[data-current-section]'

      sections = Array.from(document.querySelectorAll(selector)).filter(
        (section) => section instanceof HTMLElement
      )

      if (sections.length < 2) {
        window.requestAnimationFrame(resolveSections)
        return
      }

      button.hidden = false
      updateState()
    }

    button.addEventListener('click', () => {
      if (currentTarget instanceof HTMLElement) {
        window.scrollTo({
          top: getSectionScrollTop(currentTarget),
          behavior: behavior(),
        })
        return
      }

      window.scrollTo({ top: 0, behavior: behavior() })
    })

    let stateTicking = false
    const scheduleStateUpdate = () => {
      if (stateTicking) return
      stateTicking = true
      window.requestAnimationFrame(() => {
        stateTicking = false
        updateState()
      })
    }

    window.addEventListener('scroll', scheduleStateUpdate, { passive: true })
    window.addEventListener('resize', scheduleStateUpdate, { passive: true })
    mobileSections.addEventListener('change', resolveSections)

    resolveSections()
  })()
</script>
