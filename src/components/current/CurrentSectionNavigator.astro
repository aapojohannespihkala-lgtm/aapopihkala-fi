<button
  class="current-section-nav-button"
  type="button"
  data-current-section-nav
  aria-label="Scroll to the next Current section"
>
  <svg viewBox="0 0 14 10" aria-hidden="true">
    <path d="M2 2.5 L7 7.5 L12 2.5 Z"></path>
  </svg>
</button>

<style is:global>
  .current-section-nav-button {
    position: fixed;
    left: 50%;
    bottom: 28px;
    z-index: 120;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--stone-light);
    opacity: 0.64;
    cursor: pointer;
    transform: translateX(-50%);
    transition:
      color 150ms ease,
      opacity 150ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .current-section-nav-button:hover,
  .current-section-nav-button:focus-visible {
    color: var(--moss-deep);
    opacity: 0.94;
  }

  .current-section-nav-button:hover {
    transform: translate(-50%, 1px);
  }

  .current-section-nav-button:focus-visible {
    outline: 1px solid var(--lichen);
    outline-offset: 3px;
  }

  .current-section-nav-button svg {
    width: 14px;
    height: 10px;
    overflow: visible;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .current-section-nav-button path {
    fill: currentColor;
    stroke: none;
  }

  .current-section-nav-button.is-up svg {
    transform: rotate(180deg);
  }

  .current-section-nav-button.is-up:hover {
    transform: translate(-50%, -1px);
  }

  .current-mobile-source-footer {
    display: none;
  }

  @media (max-width: 640px) {
    .current-section-nav-button {
      bottom: 16px;
      width: 28px;
      height: 28px;
    }

    .current-section-nav-button svg {
      width: 14px;
      height: 10px;
    }

    /* Keep the divider itself at one shared screen position. The source slot
       below it is sized for two lines, then leaves a separate gap before the
       fixed navigation arrow. */
    .current-shell.current-shell {
      --current-mobile-source-divider-offset: 124px;
      --current-mobile-source-zone: 44px;
    }

    .current-shell .weather-footer,
    .current-shell .electricity-footer,
    .current-shell .current-mobile-source-footer {
      height: var(--current-mobile-source-zone);
      min-height: var(--current-mobile-source-zone);
      overflow: visible;
    }

    /* Weather starts below the Current status strip, unlike sections reached
       through the navigation arrow. Subtract the measured start offset so its
       divider lands on the same screen y-coordinate as the other sections. */
    .current-shell
      .current-section-wrap[data-current-section='weather']
      .weather-footer {
      top: calc(
        var(--current-mobile-section-viewport)
        - var(--current-mobile-source-divider-offset)
        - var(--current-mobile-weather-start-offset, 0px)
      );
    }

    /* Rates already has a footer divider. Do not let the last chart row draw a
       second line immediately above it. */
    .current-shell [data-current-section='rates'] .markets-macro__row:last-of-type {
      border-bottom: 0;
    }

    /* Weather has substantially less content than Electricity and Rates. Let
       its forecast area consume the available height instead of leaving one
       large dead block below the daily graph. The graph keeps its tested 124px
       geometry and is vertically centered inside the flexible daily area. */
    .current-shell
      .current-section-wrap[data-current-section='weather']
      .current-weather {
      display: grid;
      grid-template-rows: auto auto auto minmax(0, 1fr);
      box-sizing: border-box;
      min-height: calc(
        var(--current-mobile-section-viewport)
        - var(--current-mobile-weather-start-offset, 0px)
      );
      padding-bottom: var(--current-mobile-source-divider-offset);
    }

    .current-shell .current-weather .weather-days {
      display: grid;
      grid-template-rows: auto minmax(124px, 1fr);
      min-height: 0;
      align-content: stretch;
    }

    .current-shell .current-weather .weather-daily-chart-frame {
      align-self: center;
    }
  }

  @media (max-width: 640px) and (max-height: 720px) {
    .current-shell.current-shell {
      --current-mobile-source-divider-offset: 112px;
      --current-mobile-source-zone: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .current-section-nav-button,
    .current-section-nav-button svg {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-current-section-nav]')
    if (!(button instanceof HTMLButtonElement)) return
    if (button.dataset.initialized === 'true') return
    button.dataset.initialized = 'true'

    const reducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const behavior = () => reducedMotion() ? 'auto' : 'smooth'
    const mobileSections = window.matchMedia('(max-width: 640px)')
    const SECTION_DIVIDER_MASK_INSET = 2

    const getDocumentTop = (section) =>
      section.getBoundingClientRect().top + window.scrollY

    const getTopbarHeight = () => {
      const topbar = document.querySelector('.topbar')
      if (!(topbar instanceof HTMLElement)) return 0
      return Math.max(0, topbar.getBoundingClientRect().height)
    }

    const getMaskedSectionTop = () =>
      Math.max(0, getTopbarHeight() - SECTION_DIVIDER_MASK_INSET)

    const syncWeatherStartOffset = () => {
      const weather = document.querySelector('[data-current-section="weather"]')
      if (!(weather instanceof HTMLElement)) return

      if (!mobileSections.matches) {
        weather.style.removeProperty('--current-mobile-weather-start-offset')
        return
      }

      const startOffset = Math.max(0, getDocumentTop(weather) - getMaskedSectionTop())
      weather.style.setProperty('--current-mobile-weather-start-offset', `${startOffset}px`)
    }

    const appendSourceFooter = (section, className, html) => {
      if (!(section instanceof HTMLElement)) return
      if (section.querySelector(`.${className}`)) return

      const footer = document.createElement('footer')
      footer.className = `current-mobile-source-footer ${className}`
      footer.setAttribute('aria-label', 'Current data source')
      footer.innerHTML = `<p>${html}</p>`
      section.append(footer)
    }

    const ensureSectionSourceFooters = () => {
      const markets = document.querySelector('[data-current-section="markets"]')
      appendSourceFooter(
        markets,
        'current-mobile-source-footer--markets',
        'DATA / <a href="https://finance.yahoo.com/" target="_blank" rel="noopener nofollow">YAHOO FINANCE</a>'
      )

      const rates = document.querySelector('[data-current-rates-trends]')
      appendSourceFooter(
        rates,
        'current-mobile-source-footer--rates',
        'DATA / <a href="https://www.suomenpankki.fi/en/statistics/interest-rates-and-exchange-rates/euribor-rates/" target="_blank" rel="noopener">BANK OF FINLAND</a> · <a href="https://data.ecb.europa.eu/" target="_blank" rel="noopener">ECB</a> · <a href="https://stooq.com/" target="_blank" rel="noopener nofollow">STOOQ</a>'
      )
    }

    let sections = []
    let currentTarget = null

    const getSectionScrollTop = (section) =>
      Math.max(0, getDocumentTop(section) - getMaskedSectionTop())

    const updateState = () => {
      if (!sections.length) return

      const y = window.scrollY
      const threshold = y + getTopbarHeight()
      let currentIndex = 0

      sections.forEach((section, index) => {
        if (getDocumentTop(section) <= threshold) currentIndex = index
      })

      if (currentIndex < sections.length - 1) {
        currentTarget = sections[currentIndex + 1]
        button.classList.remove('is-up')
        const label = currentTarget.dataset.currentSection || currentTarget.dataset.currentMobileSection || 'next section'
        button.setAttribute('aria-label', `Scroll to ${label}`)
        return
      }

      currentTarget = null
      button.classList.add('is-up')
      button.setAttribute('aria-label', 'Back to Current top')
    }

    const resolveSections = () => {
      ensureSectionSourceFooters()
      syncWeatherStartOffset()

      const selector = mobileSections.matches
        ? '[data-current-section], [data-current-mobile-section]'
        : '[data-current-section]'

      sections = Array.from(document.querySelectorAll(selector)).filter(
        (section) => section instanceof HTMLElement
      )

      if (sections.length < 2) {
        window.requestAnimationFrame(resolveSections)
        return
      }

      button.hidden = false
      updateState()
    }

    button.addEventListener('click', () => {
      if (currentTarget instanceof HTMLElement) {
        window.scrollTo({
          top: getSectionScrollTop(currentTarget),
          behavior: behavior(),
        })
        return
      }

      window.scrollTo({ top: 0, behavior: behavior() })
    })

    let stateTicking = false
    const scheduleStateUpdate = () => {
      if (stateTicking) return
      stateTicking = true
      window.requestAnimationFrame(() => {
        stateTicking = false
        updateState()
      })
    }

    const handleResize = () => {
      syncWeatherStartOffset()
      scheduleStateUpdate()
    }

    window.addEventListener('scroll', scheduleStateUpdate, { passive: true })
    window.addEventListener('resize', handleResize, { passive: true })
    mobileSections.addEventListener('change', resolveSections)

    resolveSections()
  })()
</script>
