---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import NightModeToggle from '../NightModeToggle.astro';

const canonicalUrl = `${site.url}/current/snapshot/`;
---

<BaseLayout
  lang="en"
  title="Current Snapshot | Aapo Pihkala"
  description="A one-screen mobile summary of selected Current data."
  canonicalUrl={canonicalUrl}
  finnishUrl={canonicalUrl}
  englishUrl={canonicalUrl}
  languageHref="/"
  initialNightMode
  includeDefaultSocialMeta={false}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <main
    id="main-content"
    tabindex="-1"
    class="snapshot-shell"
    data-current-snapshot
    aria-labelledby="current-snapshot-title"
  >
    <article class="snapshot-frame">
      <header class="snapshot-status">
        <div class="snapshot-status__left">
          <span>GRID / 32</span>
          <span>60.1719 N / 24.7314 E</span>
        </div>
        <div class="snapshot-status__right">
          <span>OLARI / ESPOO</span>
          <span>UPDATED <b data-current-updated>WAITING</b></span>
        </div>
      </header>

      <div class="snapshot-titleblock">
        <h1 id="current-snapshot-title">Current</h1>
        <div class="snapshot-titleblock__meta" aria-label="Current time in Helsinki">
          <span>LIVE / LOCAL</span>
          <span data-current-date></span>
          <span><b data-current-time></b> HELSINKI</span>
        </div>
      </div>

      <div class="snapshot-grid">
        <section class="snapshot-panel snapshot-panel--weather" aria-labelledby="snapshot-weather-label">
          <header class="snapshot-panel__heading">
            <span class="snapshot-panel__index">01</span>
            <h2 id="snapshot-weather-label">WEATHER / 01</h2>
            <a class="snapshot-panel__open" href="/current/weather/" aria-label="Open Weather detail">+</a>
          </header>

          <div class="snapshot-panel__body snapshot-weather">
            <div class="snapshot-weather__copy">
              <p class="snapshot-hero snapshot-weather__temperature">
                <span data-snapshot-weather-temperature>--.-</span><small>°C</small>
              </p>
              <p class="snapshot-weather__condition" data-snapshot-weather-condition>FETCHING</p>
              <p class="snapshot-weather__range">
                <span data-snapshot-weather-low>--</span>° <span aria-hidden="true">/</span>
                <span data-snapshot-weather-high>--</span>°
              </p>
            </div>

            <svg
              class="snapshot-weather__icon"
              data-snapshot-weather-icon
              viewBox="0 0 96 64"
              role="img"
              aria-label="Current weather symbol"
            ></svg>

            <p class="snapshot-source">DATA / OPEN-METEO · AUTO REFRESH 15 MIN</p>
          </div>
        </section>

        <section class="snapshot-panel snapshot-panel--electricity" aria-labelledby="snapshot-electricity-label">
          <header class="snapshot-panel__heading">
            <span class="snapshot-panel__index">02</span>
            <h2 id="snapshot-electricity-label">ELECTRICITY / 02</h2>
            <a class="snapshot-panel__open" href="/current/electricity/" aria-label="Open Electricity detail">+</a>
          </header>

          <div class="snapshot-panel__body snapshot-electricity">
            <p class="snapshot-kicker">FI SPOT / VAT INCLUDED</p>

            <div class="snapshot-electricity__main">
              <div class="snapshot-electricity__value">
                <p class="snapshot-hero snapshot-electricity__price">
                  <span data-snapshot-electricity-now>--.--</span><small> c/kWh</small>
                </p>
                <p class="snapshot-micro">NOW / 15 MIN</p>
              </div>

              <div class="snapshot-electricity__chart" aria-label="Today's electricity price profile">
                <svg viewBox="0 0 240 58" preserveAspectRatio="none" data-snapshot-electricity-chart>
                  <path data-snapshot-electricity-chart-path></path>
                </svg>
                <div class="snapshot-chart-labels" aria-hidden="true">
                  <span>00</span><span>06</span><span>12</span><span>18</span><span>24</span>
                </div>
              </div>
            </div>

            <dl class="snapshot-electricity__stats">
              <div>
                <dt>DAY AVG</dt>
                <dd data-snapshot-electricity-average>--.--</dd>
              </div>
              <div>
                <dt>LOW</dt>
                <dd data-snapshot-electricity-low>--.--</dd>
              </div>
              <div>
                <dt>HIGH</dt>
                <dd data-snapshot-electricity-high>--.--</dd>
              </div>
            </dl>

            <p class="snapshot-source">DATA / PÖRSSISÄHKÖ.NET · 15 MIN</p>
          </div>
        </section>

        <section class="snapshot-panel snapshot-panel--markets" aria-labelledby="snapshot-markets-label">
          <header class="snapshot-panel__heading">
            <span class="snapshot-panel__index">03</span>
            <h2 id="snapshot-markets-label">MARKETS / 03</h2>
            <a class="snapshot-panel__open" href="/current/markets/" aria-label="Open Markets detail">+</a>
          </header>

          <div class="snapshot-panel__body snapshot-markets">
            <p class="snapshot-kicker">GLOBAL / PERFORMANCE (TODAY)</p>
            <div class="snapshot-markets__median" aria-label="Median selected-market performance today">
              <span>1D / MEDIAN</span>
              <strong data-snapshot-market-median>--</strong>
            </div>
            <div class="snapshot-market-list" role="table" aria-label="Selected holdings performance today">
              {
                [
                  ['ishares-world', 'WORLD'],
                  ['handelsbanken-usa', 'USA'],
                  ['nordnet-finland', 'FINLAND'],
                  ['btc', 'BTC / EUR'],
                  ['remedy', 'REMEDY'],
                ].map(([id, label]) => (
                  <div class="snapshot-market-row" role="row">
                    <span role="rowheader">{label}</span>
                    <strong role="cell" data-snapshot-market={id}>--</strong>
                  </div>
                ))
              }
            </div>
            <p class="snapshot-source">DATA / PORTFOLIO SOURCES</p>
          </div>
        </section>

        <section class="snapshot-panel snapshot-panel--rates" aria-labelledby="snapshot-rates-label">
          <header class="snapshot-panel__heading">
            <span class="snapshot-panel__index">04</span>
            <h2 id="snapshot-rates-label">RATES / 04</h2>
            <a class="snapshot-panel__open" href="/current/markets/" aria-label="Open Rates detail">+</a>
          </header>

          <div class="snapshot-panel__body snapshot-rates">
            <p class="snapshot-kicker">TRENDS</p>
            <div class="snapshot-rates__main">
              <div>
                <p class="snapshot-rates__label">3M EURIBOR</p>
                <p class="snapshot-rates__value">
                  <span data-snapshot-euribor>-.---</span><small>%</small>
                </p>
                <p class="snapshot-micro snapshot-rates__change">
                  1Y <b data-snapshot-euribor-change>--</b>
                </p>
              </div>

              <div class="snapshot-rates__chart" aria-label="One-year 3M Euribor trend">
                <svg viewBox="0 0 220 64" preserveAspectRatio="none" data-snapshot-euribor-chart>
                  <path data-snapshot-euribor-chart-path></path>
                </svg>
                <div class="snapshot-rates__axis" aria-hidden="true">
                  <span data-snapshot-euribor-chart-high>--</span>
                  <span data-snapshot-euribor-chart-low>--</span>
                </div>
              </div>
            </div>
            <p class="snapshot-source">DATA / ECB · BANK OF FINLAND</p>
          </div>
        </section>
      </div>

      <footer class="snapshot-footer">
        <span>SMALL DATA / LIVE SUMMARY</span>
        <button type="button" class="snapshot-refresh" data-snapshot-refresh>REFRESH</button>
        <span data-snapshot-status aria-live="polite">LOADING LIVE DATA</span>
      </footer>
    </article>
  </main>

  <Fragment slot="afterAnalytics">
    <script>
      import { initCurrentClock } from '../../features/current/clock';
      import { initCurrentSnapshot } from '../../features/current/snapshot';

      initCurrentClock();
      initCurrentSnapshot();
    </script>

    <NightModeToggle lang="en" />
  </Fragment>
</BaseLayout>

<style>
  :global(html:has(.snapshot-shell)),
  :global(body:has(.snapshot-shell)) {
    overflow-x: clip !important;
  }

  .snapshot-shell {
    width: min(100%, 760px);
    min-height: calc(100dvh - 64px);
    margin: 0 auto;
    padding: 14px 18px;
  }

  .snapshot-frame {
    min-height: calc(100dvh - 92px);
    overflow: hidden;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    border: 1px solid var(--ink-soft);
    border-radius: 30px;
    background: var(--page);
  }

  .snapshot-status,
  .snapshot-titleblock__meta,
  .snapshot-panel__heading,
  .snapshot-kicker,
  .snapshot-micro,
  .snapshot-weather__range,
  .snapshot-electricity__stats,
  .snapshot-market-list,
  .snapshot-source,
  .snapshot-footer,
  .snapshot-refresh {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .snapshot-status {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    padding: 16px 20px 13px;
    border-bottom: 1px solid var(--ink-soft);
    color: var(--ink-soft);
    font-size: 0.55rem;
    line-height: 1.55;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .snapshot-status__left,
  .snapshot-status__right {
    display: grid;
  }

  .snapshot-status__right {
    justify-items: end;
    text-align: right;
  }

  .snapshot-status b {
    font: inherit;
  }

  .snapshot-titleblock {
    min-height: 102px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    padding: 9px 20px 11px;
    border-bottom: 1px solid var(--ink-soft);
  }

  .snapshot-titleblock h1 {
    margin: 0;
    color: var(--ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(4rem, 13vw, 5.7rem);
    font-weight: 400;
    line-height: 0.88;
    letter-spacing: -0.075em;
  }

  .snapshot-titleblock__meta {
    display: grid;
    gap: 2px;
    color: var(--stone);
    font-size: 0.44rem;
    line-height: 1.4;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .snapshot-titleblock__meta b {
    color: var(--ink-soft);
    font: inherit;
  }

  .snapshot-grid {
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1.12fr) minmax(0, 1.58fr) minmax(0, 1.28fr) minmax(0, 0.92fr);
  }

  .snapshot-panel {
    min-height: 0;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    border-bottom: 1px solid var(--ink-soft);
  }

  .snapshot-panel:last-child {
    border-bottom: 0;
  }

  .snapshot-panel__heading {
    min-height: 31px;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 34px;
    align-items: stretch;
    border-bottom: 1px solid color-mix(in srgb, var(--ink-soft) 76%, transparent);
    color: var(--ink-soft);
    font-size: 0.62rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .snapshot-panel__index,
  .snapshot-panel__heading h2,
  .snapshot-panel__open {
    display: flex;
    align-items: center;
  }

  .snapshot-panel__index {
    justify-content: center;
  }

  .snapshot-panel__heading h2 {
    min-width: 0;
    margin: 0;
    padding: 0 13px;
    border-left: 1px solid color-mix(in srgb, var(--ink-soft) 76%, transparent);
    font: inherit;
  }

  .snapshot-panel__open {
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    color: var(--ink-soft);
    font-size: 1rem;
    text-decoration: none;
  }

  .snapshot-panel__open:hover,
  .snapshot-panel__open:focus-visible {
    color: var(--moss-deep);
    background: color-mix(in srgb, var(--moss) 8%, transparent);
  }

  .snapshot-panel__body {
    min-height: 0;
    overflow: hidden;
    padding: 9px 15px 8px;
  }

  .snapshot-kicker,
  .snapshot-source,
  .snapshot-micro {
    margin: 0;
    text-transform: uppercase;
  }

  .snapshot-kicker {
    color: var(--ink-soft);
    font-size: 0.5rem;
    line-height: 1.1;
    letter-spacing: 0.055em;
  }

  .snapshot-source {
    color: var(--stone);
    font-size: 0.34rem;
    line-height: 1.15;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .snapshot-hero,
  .snapshot-rates__value {
    margin: 0;
    color: var(--ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.075em;
  }

  .snapshot-hero {
    font-size: clamp(3.55rem, 13.5vw, 4.8rem);
    line-height: 0.82;
  }

  .snapshot-hero small,
  .snapshot-rates__value small {
    margin-left: 0.08em;
    color: var(--ink-soft);
    font-size: 0.27em;
    letter-spacing: 0;
    vertical-align: 0.22em;
  }

  .snapshot-weather {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 92px;
    grid-template-rows: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 10px;
    row-gap: 4px;
  }

  .snapshot-weather__copy {
    min-width: 0;
  }

  .snapshot-weather__condition {
    margin: 6px 0 0;
    color: var(--ink-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.86rem;
    line-height: 1;
  }

  .snapshot-weather__range {
    margin: 5px 0 0;
    color: var(--ink-soft);
    font-size: 0.7rem;
    line-height: 1;
  }

  .snapshot-weather__icon {
    width: 88px;
    height: 58px;
    overflow: visible;
    color: var(--ink-soft);
  }

  .snapshot-weather__icon :global(path),
  .snapshot-weather__icon :global(circle),
  .snapshot-weather__icon :global(line) {
    vector-effect: non-scaling-stroke;
  }

  .snapshot-weather .snapshot-source {
    grid-column: 1 / -1;
    align-self: end;
  }

  .snapshot-electricity {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    gap: 5px;
  }

  .snapshot-electricity__main {
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(190px, 1.22fr) minmax(110px, 0.78fr);
    align-items: center;
    gap: 14px;
  }

  .snapshot-electricity__value {
    min-width: 0;
  }

  .snapshot-electricity__price {
    white-space: nowrap;
  }

  .snapshot-micro {
    color: var(--stone);
    font-size: 0.38rem;
    line-height: 1.2;
    letter-spacing: 0.055em;
  }

  .snapshot-micro b {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .snapshot-electricity__chart,
  .snapshot-rates__chart {
    min-width: 0;
    color: var(--ink-soft);
  }

  .snapshot-electricity__chart svg,
  .snapshot-rates__chart svg {
    display: block;
    width: 100%;
    overflow: visible;
  }

  .snapshot-electricity__chart svg {
    height: 46px;
  }

  .snapshot-electricity__chart path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.1;
    vector-effect: non-scaling-stroke;
  }

  .snapshot-chart-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 2px;
    color: var(--stone);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.31rem;
    line-height: 1;
  }

  .snapshot-electricity__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding-top: 6px;
    border-top: 1px solid var(--line-soft);
    color: var(--ink-soft);
    font-size: 0.42rem;
    line-height: 1.05;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .snapshot-electricity__stats div {
    min-width: 0;
    padding-right: 10px;
  }

  .snapshot-electricity__stats div + div {
    padding-left: 14px;
    border-left: 1px solid var(--line);
  }

  .snapshot-electricity__stats dt {
    color: var(--stone);
  }

  .snapshot-electricity__stats dd {
    margin: 4px 0 0;
    color: var(--ink);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
  }

  .snapshot-markets {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    gap: 5px;
  }

  .snapshot-markets__median {
    display: flex;
    align-items: baseline;
    gap: 7px;
    min-height: 0;
    color: var(--stone);
    font-size: 0.46rem;
    font-weight: 500;
    letter-spacing: 0.045em;
    line-height: 1;
  }

  .snapshot-markets__median strong {
    color: var(--ink-soft);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
    font-weight: 650;
    letter-spacing: 0;
  }

  .snapshot-markets__median strong.is-positive {
    color: #168a73;
  }

  .snapshot-markets__median strong.is-negative {
    color: #b85a61;
  }

  .snapshot-market-list {
    min-height: 0;
    display: grid;
    grid-template-rows: repeat(5, 1fr);
    color: var(--ink-soft);
    font-size: 0.58rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .snapshot-market-row {
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    border-bottom: 1px solid var(--line-soft);
  }

  .snapshot-market-row strong {
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  .snapshot-market-row strong.is-positive {
    color: #168a73;
  }

  .snapshot-market-row strong.is-negative {
    color: #b85a61;
  }

  .snapshot-rates {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 4px;
  }

  .snapshot-rates__main {
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(130px, 1.22fr);
    align-items: center;
    gap: 16px;
  }

  .snapshot-rates__label {
    margin: 0 0 2px;
    color: var(--ink-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.56rem;
    line-height: 1;
  }

  .snapshot-rates__value {
    font-size: clamp(2.35rem, 9.5vw, 3.25rem);
    line-height: 0.86;
  }

  .snapshot-rates__change {
    margin-top: 4px;
  }

  .snapshot-rates__chart {
    position: relative;
    padding-right: 22px;
    border-left: 1px solid var(--line);
  }

  .snapshot-rates__chart svg {
    height: 44px;
    padding-left: 10px;
  }

  .snapshot-rates__chart path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.1;
    vector-effect: non-scaling-stroke;
  }

  .snapshot-rates__axis {
    position: absolute;
    inset: 1px 0 1px auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--stone);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.3rem;
    line-height: 1;
  }

  .snapshot-footer {
    min-height: 30px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 10px;
    padding: 5px 15px 6px;
    border-top: 1px solid var(--ink-soft);
    color: var(--stone);
    font-size: 0.33rem;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .snapshot-refresh {
    min-width: 24px;
    min-height: 22px;
    padding: 3px 5px;
    border: 0;
    background: transparent;
    color: var(--stone);
    font-size: 0.33rem;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .snapshot-refresh:hover,
  .snapshot-refresh:focus-visible {
    color: var(--moss-deep);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 640px) {
    .snapshot-shell {
      width: 100%;
      height: calc(100dvh - 64px);
      min-height: 0;
      padding: 7px 9px;
    }

    .snapshot-frame {
      height: 100%;
      min-height: 0;
      border-radius: 24px;
    }

    .snapshot-status {
      padding: 7px 12px 6px;
      font-size: 0.4rem;
      line-height: 1.45;
    }

    .snapshot-titleblock {
      min-height: 67px;
      padding: 5px 12px 7px;
    }

    .snapshot-titleblock h1 {
      font-size: clamp(3rem, 15vw, 3.9rem);
    }

    .snapshot-titleblock__meta {
      font-size: 0.34rem;
      line-height: 1.35;
    }

    .snapshot-grid {
      grid-template-rows: minmax(0, 1.15fr) minmax(0, 1.65fr) minmax(0, 1.2fr) minmax(0, 0.9fr);
    }

    .snapshot-panel__heading {
      min-height: 26px;
      grid-template-columns: 38px minmax(0, 1fr) 30px;
      font-size: 0.5rem;
    }

    .snapshot-panel__heading h2 {
      padding-inline: 9px;
    }

    .snapshot-panel__body {
      padding: 6px 11px 5px;
    }

    .snapshot-source {
      font-size: 0.32rem;
      line-height: 1.1;
    }

    .snapshot-kicker {
      font-size: 0.4rem;
    }

    .snapshot-hero {
      font-size: clamp(2.95rem, 15vw, 3.8rem);
    }

    .snapshot-weather {
      grid-template-columns: minmax(0, 1fr) 72px;
      row-gap: 3px;
    }

    .snapshot-weather__condition {
      margin-top: 4px;
      font-size: 0.7rem;
    }

    .snapshot-weather__range {
      margin-top: 4px;
      font-size: 0.58rem;
    }

    .snapshot-weather__icon {
      width: 68px;
      height: 46px;
    }

    .snapshot-electricity {
      gap: 4px;
    }

    .snapshot-electricity__main {
