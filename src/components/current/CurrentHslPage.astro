---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import NightModeToggle from '../NightModeToggle.astro';
import CurrentHsl from './CurrentHsl.astro';

const canonicalUrl = `${site.url}/current/hsl/`;
---

<BaseLayout
  lang="en"
  title="HSL | Current | Aapo Pihkala"
  description="Direct 121 and 125 departures from Ylisrinne using live HSL data when available."
  canonicalUrl={canonicalUrl}
  finnishUrl={canonicalUrl}
  englishUrl={canonicalUrl}
  languageHref="/current/"
  initialNightMode
  includeDefaultSocialMeta={false}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <main id="main-content" tabindex="-1" class="current-detail-shell">
    <header class="current-detail-status" aria-label="Current HSL status">
      <a href="/current/" class="current-detail-status__link">Current</a>
      <span class="current-detail-status__separator" aria-hidden="true">/</span>
      <h1 class="current-detail-status__label">HSL</h1>
      <span class="current-detail-status__separator" aria-hidden="true">/</span>

      <p class="current-detail-clock" aria-label="Current time in Helsinki">
        <span data-current-date></span>
        <span aria-hidden="true">/</span>
        <span data-current-time></span>
      </p>

      <span class="current-detail-status__separator" aria-hidden="true">/</span>

      <p class="current-detail-updated">
        Updated <span data-current-updated>Waiting</span>
      </p>
    </header>

    <CurrentHsl />
  </main>

  <Fragment slot="afterAnalytics">
    <script>
      import { initCurrentClock } from '../../features/current/clock';
      initCurrentClock();
    </script>

    <script>
      const routeIds: Record<string, string> = {
        '121': 'HSL:2121',
        '125': 'HSL:2125',
      };

      const departures = document.querySelector<HTMLElement>('[data-hsl-departures]');
      if (departures) {
        const linkLiveRoutes = () => {
          for (const row of departures.querySelectorAll<HTMLElement>('[data-hsl-departure]')) {
            if (!row.querySelector('.hsl-departure__vehicle')) continue;

            const line = row.querySelector<HTMLElement>('.hsl-departure__line');
            if (!line || line instanceof HTMLAnchorElement) continue;

            const route = line.textContent?.trim() ?? '';
            const routeId = routeIds[route];
            if (!routeId) continue;

            const link = document.createElement('a');
            link.className = `${line.className} hsl-departure__line-link`;
            link.href = `https://reittiopas.hsl.fi/linjat/${routeId}`;
            link.target = '_blank';
            link.rel = 'noopener';
            link.textContent = route;
            link.setAttribute('aria-label', `Open HSL live map for line ${route}`);
            line.replaceWith(link);
          }
        };

        linkLiveRoutes();
        new MutationObserver(linkLiveRoutes).observe(departures, { childList: true });
      }
    </script>

    <NightModeToggle lang="en" />
  </Fragment>
</BaseLayout>

<style>
  .current-detail-shell {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: 28px 32px 128px;
  }

  .current-detail-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-soft);
    color: var(--stone);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.5rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .current-detail-status h1,
  .current-detail-status p {
    margin: 0;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  .current-detail-status__link {
    color: var(--stone-light);
    text-decoration: none;
  }

  .current-detail-status__link:hover,
  .current-detail-status__link:focus-visible {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .current-detail-status__label,
  .current-detail-status__separator {
    color: var(--stone-light) !important;
  }

  .current-detail-clock {
    display: inline-flex;
    gap: 8px;
  }

  .current-detail-updated span {
    color: var(--stone-light);
  }

  @media (max-width: 640px) {
    .current-detail-shell {
      padding: 22px 24px 96px;
    }

    .current-detail-status {
      gap: 7px;
      padding-bottom: 14px;
      font-size: 0.47rem;
    }

    .current-detail-clock {
      gap: 7px;
    }
  }
</style>

<style is:global>
  .hsl-departure__line-link {
    text-decoration: none;
  }

  .hsl-departure__line-link:hover,
  .hsl-departure__line-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }
</style>
