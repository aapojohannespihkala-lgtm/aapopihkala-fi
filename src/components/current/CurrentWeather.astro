<section class="current-weather" data-current-weather aria-labelledby="current-weather-title">
  <header class="weather-heading">
    <p class="weather-index">WEATHER / 01</p>
    <p class="weather-location">OLARI / ESPOO</p>
  </header>

  <div class="weather-current">
    <div class="weather-current__primary">
      <div class="weather-current__temperature-row">
        <p class="weather-temperature" aria-live="polite">
          <span data-weather-temperature>--.-</span><span class="weather-temperature__unit">°C</span>
        </p>

        <div class="weather-current__icon" data-weather-current-icon aria-hidden="true"></div>
      </div>

      <div class="weather-current__caption">
        <h2 id="current-weather-title" class="weather-condition" data-weather-condition>
          Fetching forecast
        </h2>

        <p class="weather-current__range" aria-label="Today's low and high temperature">
          <span data-weather-current-min>--</span>° / <span data-weather-current-max>--</span>°
        </p>
      </div>
    </div>

    <dl class="weather-metrics" aria-label="Current weather details">
      <div>
        <dt>FEELS</dt>
        <dd data-weather-feels>--.-°</dd>
      </div>
      <div>
        <dt>WIND</dt>
        <dd data-weather-wind>--.- m/s</dd>
      </div>
      <div>
        <dt>RAIN NOW</dt>
        <dd data-weather-rain-now>--.- mm</dd>
      </div>
    </dl>
  </div>

  <section class="weather-hours" aria-labelledby="weather-hours-title">
    <header class="weather-subheading">
      <p id="weather-hours-title">HOURS / 06</p>
      <p>NEXT 6 H</p>
    </header>

    <div class="weather-hour-grid" data-weather-hours aria-live="polite"></div>
  </section>

  <section class="weather-days" aria-labelledby="weather-days-title">
    <header class="weather-subheading">
      <p id="weather-days-title">FORECAST / 05</p>
      <p>NEXT 5 DAYS</p>
    </header>

    <div class="weather-day-grid" data-weather-days aria-live="polite"></div>

    <div class="weather-daily-chart-frame">
      <svg
        class="weather-daily-chart"
        data-weather-daily-chart
        role="img"
        aria-label="High and low temperature development for the next five days"
      ></svg>
    </div>
  </section>

  <section class="weather-trace" aria-labelledby="weather-trace-title">
    <header class="weather-subheading weather-subheading--trace">
      <p id="weather-trace-title">TRACE / 24H</p>
      <p>TEMPERATURE + RAIN</p>
    </header>

    <div class="weather-chart-frame">
      <svg
        class="weather-chart"
        data-weather-chart
        role="img"
        aria-label="Temperature and rain probability for the next 24 hours"
      ></svg>
    </div>
  </section>

  <div class="weather-notes" aria-label="Weather highlights">
    <div class="weather-note">
      <p class="weather-note__label">RAIN</p>
      <p class="weather-note__value" data-weather-rain-note>Checking next hours</p>
    </div>

    <div class="weather-note">
      <p class="weather-note__label">SUN</p>
      <p class="weather-note__value" data-weather-sun>--:-- - --:--</p>
    </div>

    <div class="weather-note">
      <p class="weather-note__label">TODAY</p>
      <p class="weather-note__value" data-weather-today>--° / --°</p>
    </div>
  </div>

  <footer class="weather-footer">
    <p>
      DATA /
      <a href="https://open-meteo.com/" target="_blank" rel="noopener">OPEN-METEO</a>
      · CC BY 4.0 · AUTO REFRESH 15 MIN
    </p>

    <p class="weather-error" data-weather-error hidden>
      Forecast unavailable.
      <button type="button" data-weather-retry>Retry</button>
    </p>
  </footer>
</section>

<script>
  import { initCurrentWeather } from '../../features/current/weather';
  initCurrentWeather();
</script>

