        <dd data-weather-rain-now>--.- mm</dd>
      </div>
    </dl>
  </div>

  <div class="weather-chart-frame">
    <svg
      class="weather-chart"
      data-weather-chart
      role="img"
      aria-label="Temperature and rain probability for the next 24 hours"
    ></svg>
  </div>

  <div class="weather-notes" aria-label="Weather highlights">
