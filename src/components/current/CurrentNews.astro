<section class="current-news" data-current-news aria-labelledby="current-news-title">
  <header class="news-heading">
    <p class="news-index">NEWS / 03</p>
    <p class="news-mode">LIVE RSS / LOADING</p>
  </header>

  <div class="news-intro">
    <h2 id="current-news-title">Three for today</h2>
    <p>Rate each item. Both choices replace it, but teach the local profile in opposite directions.</p>
  </div>

  <div class="news-list" data-news-list>
    {[0, 1, 2].map((index) => (
      <article class="news-item" data-news-slot data-slot-index={index}>
        <p class="news-item__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>

        <div class="news-item__body">
          <p class="news-item__meta" data-news-meta>LOADING</p>
          <h3 class="news-item__title" data-news-title>Loading live culture item</h3>
          <p class="news-item__context" data-news-context>Loading context</p>
          <p class="news-item__detail" data-news-detail>RSS / CURRENT</p>
        </div>

        <div class="news-item__feedback" aria-label={`Feedback for news slot ${index + 1}`}>
          <button
            type="button"
            class="news-feedback"
            data-news-feedback="up"
            aria-label="Thumbs up, show another item"
            title="Thumbs up - show another item"
          >↑</button>
          <button
            type="button"
            class="news-feedback"
            data-news-feedback="down"
            aria-label="Thumbs down, show another item"
            title="Thumbs down - show another item"
          >↓</button>
        </div>
      </article>
    ))}
  </div>

  <p class="sr-only" aria-live="polite" data-news-feedback-status></p>

  <details class="news-debug">
    <summary>LOCAL LEARNING / DEBUG</summary>

    <div class="news-debug__body">
      <dl class="news-debug__stats">
        <div><dt>POOL</dt><dd data-news-debug-pool>--</dd></div>
        <div><dt>REMAINING</dt><dd data-news-debug-remaining>--</dd></div>
        <div><dt>SEEN</dt><dd data-news-debug-seen>--</dd></div>
        <div><dt>UP</dt><dd data-news-debug-up>--</dd></div>
        <div><dt>DOWN</dt><dd data-news-debug-down>--</dd></div>
      </dl>

      <div class="news-debug__signals" data-news-debug-signals></div>

      <button type="button" class="news-debug__reset" data-news-reset>
        RESET LOCAL LEARNING
      </button>
    </div>
  </details>

  <footer class="news-footer">
    <p>PROFILE / LOCAL STORAGE</p>
    <p>FEEDS / LOADING</p>
  </footer>
</section>

<style>
  .current-news {
    padding: 20px 0 6px;
  }

  .news-heading,
  .news-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }

  .news-heading {
    margin-bottom: 10px;
  }

  .news-index,
  .news-mode,
  .news-item__number,
  .news-item__meta,
  .news-item__detail,
  .news-feedback,
  .news-debug,
  .news-footer {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    text-transform: uppercase;
  }

  .news-index,
  .news-mode {
    margin: 0;
    font-size: 0.54rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.09em;
  }

  .news-index {
    color: var(--moss);
  }

  .news-mode {
    color: var(--stone-light);
  }

  .news-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.7fr);
    gap: 36px;
    align-items: end;
    padding: 2px 0 12px;
  }

  .news-intro h2,
  .news-intro p {
    margin: 0;
  }

  .news-intro h2 {
    color: var(--ink);
    font-family: "Times New Roman", Times, serif;
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-transform: none;
  }

  .news-intro p {
    max-width: 42ch;
    color: var(--stone);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.48rem;
    line-height: 1.4;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .news-list {
    border-top: 1px solid var(--line);
  }

  .news-item {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    min-height: 102px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .news-item__body {
    min-width: 0;
  }

  .news-item__number,
  .news-item__meta,
  .news-item__detail {
    margin: 0;
    font-size: 0.46rem;
    letter-spacing: 0.07em;
  }

  .news-item__number,
  .news-item__detail {
    color: var(--stone-light);
  }

  .news-item__meta {
    margin-bottom: 5px;
    color: var(--stone);
    font-weight: 600;
  }

  .news-item__title {
    margin: 0;
    max-width: 36ch;
    color: var(--ink);
    font-family: "Times New Roman", Times, serif;
    font-size: clamp(1.15rem, 2.2vw, 1.75rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .news-item__context {
    margin: 5px 0 0;
    max-width: 68ch;
    color: var(--stone);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.66rem;
    line-height: 1.25;
  }

  .news-item__detail {
    margin-top: 5px;
  }

  .news-item__feedback {
    display: flex;
    gap: 6px;
  }

  .news-feedback {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--stone);
    font-size: 0.92rem;
    line-height: 1;
    cursor: pointer;
  }

  .news-feedback:hover,
  .news-feedback:focus-visible {
    border-color: var(--stone);
    color: var(--ink);
  }

  .news-feedback:disabled {
    cursor: default;
    opacity: 0.3;
  }

  .news-debug {
    margin-top: 20px;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
