  }

  :global(.news-debug__signal) {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin: 0;
  }

  :global(.news-debug__empty) {
    margin: 0;
  }

  .news-debug__reset {
    margin-top: 18px;
    border: 0;
    padding: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }

  .news-footer {
    margin-top: 18px;
    color: var(--stone-light);
    font-size: 0.49rem;
    letter-spacing: 0.07em;
  }

  .news-footer p {
    margin: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 720px) {
    .current-news {
      padding-top: 24px;
    }

    .news-heading,
    .news-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 7px;
    }

    .news-intro {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-bottom: 16px;
    }

    .news-intro h2 {
      font-size: clamp(2.2rem, 12vw, 3.2rem);
    }

    .news-item {
      grid-template-columns: 30px minmax(0, 1fr);
      gap: 14px;
      min-height: 0;
      padding: 16px 0;
    }

    .news-item__title {
      font-size: clamp(1.25rem, 7vw, 1.75rem);
    }

    .news-item__context {
      font-size: 0.68rem;
    }

    .news-item__feedback {
      grid-column: 2;
      justify-content: flex-start;
    }

    .news-debug__stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
