  }

  .news-debug__stats div {
    display: grid;
    gap: 5px;
    padding-top: 10px;
    border-top: 1px solid var(--line-soft);
  }

  .news-debug__stats dt,
  .news-debug__stats dd {
    margin: 0;
  }

  .news-debug__stats dd {
    color: var(--ink);
    font-family: "Times New Roman", Times, serif;
    font-size: 1.2rem;
    line-height: 1;
  }

  .news-debug__signals {
    display: grid;
