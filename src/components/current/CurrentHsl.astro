<section class="current-hsl" data-current-hsl aria-labelledby="current-hsl-title">
  <header class="hsl-heading">
    <p id="current-hsl-title" class="hsl-index">HSL / LIVE</p>
    <p class="hsl-mode">DEPARTURES / REALTIME</p>
  </header>

  <form class="hsl-query" data-hsl-form autocomplete="off">
    <label class="hsl-field">
      <span>STOP CODE</span>
      <input
        type="text"
        name="stop"
        data-hsl-stop
        placeholder="E1234"
        maxlength="7"
        autocapitalize="characters"
        autocomplete="off"
        spellcheck="false"
        required
      />
    </label>

    <label class="hsl-field hsl-field--routes">
      <span>ROUTES / OPTIONAL</span>
      <input
        type="text"
        name="routes"
        data-hsl-routes
        placeholder="100, 200A"
        maxlength="60"
        autocapitalize="characters"
        autocomplete="off"
        spellcheck="false"
      />
    </label>

    <button type="submit" class="hsl-submit" data-hsl-submit>LOAD</button>
  </form>

  <div class="hsl-meta">
    <p data-hsl-status>ENTER STOP CODE</p>
    <p>REFRESH / 30 S</p>
  </div>

  <div class="hsl-results" data-hsl-results hidden>
    <div class="hsl-results__header" aria-hidden="true">
      <span>LINE</span>
      <span>DESTINATION</span>
      <span>DEPARTURE</span>
      <span>DATA</span>
    </div>
    <div class="hsl-departures" data-hsl-departures aria-live="polite"></div>
  </div>

  <p class="hsl-message" data-hsl-empty hidden>NO MATCHING DEPARTURES.</p>
  <p class="hsl-message hsl-message--error" data-hsl-error role="status" hidden></p>

  <footer class="hsl-footer">
    <p>
      DATA /
      <a href="https://digitransit.fi/" target="_blank" rel="noopener">HSL DIGITRANSIT</a>
      · LIVE WHEN AVAILABLE · NO LOCAL STORAGE
    </p>
  </footer>
</section>

<script>
  import { initCurrentHsl } from '../../features/current/hsl';
  initCurrentHsl();
</script>

