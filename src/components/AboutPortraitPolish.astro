<style is:global>
  @media (hover: hover) and (pointer: fine) {
    html body .about-portrait .meshy-point-surface--probe,
    html body .about-portrait .meshy-point-surface--probe .meshy-point-surface__canvas,
    html body .about-portrait .meshy-point-surface--probe:active,
    html body .about-portrait .meshy-point-surface--probe:active .meshy-point-surface__canvas {
      cursor: none !important;
    }
  }

  html body .about-portrait .about-portrait__frame {
    overflow: visible;
  }

  html body .about-portrait .meshy-point-surface__probe {
    display: none !important;
  }

  html body .about-portrait .about-cursor-probe {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 8;
    width: 18px;
    height: 18px;
    pointer-events: none;
    color: var(--moss-deep);
    opacity: 0;
    transform: translate(-9px, -9px);
    transition: opacity 90ms ease;
  }

  html body .about-portrait .about-cursor-probe.is-visible {
    opacity: 0.84;
  }

  html body .about-portrait .about-cursor-probe__cross::before,
  html body .about-portrait .about-cursor-probe__cross::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  html body .about-portrait .about-cursor-probe__cross::before {
    width: 18px;
    height: 1px;
  }

  html body .about-portrait .about-cursor-probe__cross::after {
    width: 1px;
    height: 18px;
  }

  html body .about-portrait .about-cursor-probe__label {
    position: absolute;
    left: 15px;
    top: 12px;
    display: grid;
    gap: 3px;
    min-width: max-content;
    padding: 3px 5px;
    border: 1px solid var(--line-soft);
    background: rgba(255, 255, 255, 0.9);
    color: var(--moss-deep);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.47rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.05em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  html body .about-portrait .about-cursor-probe__secondary {
    color: var(--stone);
  }

  html.site-night-mode body .about-portrait .about-cursor-probe__label {
    background: rgba(25, 34, 43, 0.96);
    border-color: rgba(167, 184, 193, 0.34);
    color: #eaf0f2;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.16);
  }

  html.site-night-mode body .about-portrait .about-cursor-probe__secondary {
    color: #bdc9cf;
  }

  html body .about-portrait .about-center-cross {
    --center-cross-x: 0px;
    --center-cross-y: 0px;
    --center-cross-neg-x: 0px;
    --center-cross-neg-y: 0px;
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: 16px;
    height: 16px;
    pointer-events: none;
    color: var(--moss);
    opacity: 0.56;
    transform: translate(-50%, -50%);
  }

  html body .about-portrait .about-center-cross::before,
  html body .about-portrait .about-center-cross::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  html body .about-portrait .about-center-cross::before {
    width: 16px;
    height: 1px;
  }

  html body .about-portrait .about-center-cross::after {
    width: 1px;
    height: 16px;
  }

  html body .about-portrait .about-center-cross.is-travelling {
    animation: about-center-cross-travel 1000ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  html body .about-portrait .about-portrait__voice {
    top: 9px !important;
    right: 36px !important;
    max-width: calc(100% - 72px) !important;
    justify-items: end !important;
    text-align: right !important;
    overflow: hidden;
  }

  html body .about-portrait .about-portrait__voice-status {
    display: inline-flex;
    align-items: baseline;
    gap: 0.42em;
    font-size: 0.38rem !important;
    letter-spacing: 0.09em !important;
  }

  html body .about-portrait .about-portrait__voice-state.is-blinking {
    animation: about-subject-state-blink 170ms steps(1, end) 3;
  }

  html body .about-portrait .about-portrait__voice-line {
    display: block;
    max-width: 260px !important;
    font-size: 0.46rem !important;
    line-height: 1.25 !important;
    transform-origin: 100% 0;
  }

  html body .about-portrait .about-portrait__voice-line.is-rolling {
    animation: about-voice-roll 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  html body .about-portrait__frame.is-model-active .about-portrait__voice.is-visible {
    transform: translate(-2px, 2px) !important;
  }

  @keyframes about-subject-state-blink {
    0%, 42% { opacity: 0.94; }
    43%, 100% { opacity: 0.12; }
  }

  @keyframes about-voice-roll {
    0% {
      opacity: 0;
      transform: translateY(-0.9em);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes about-center-cross-travel {
    0% {
      opacity: 0.56;
      transform: translate(-50%, -50%) translate(0, 0);
    }
    40% {
      opacity: 0.56;
      transform: translate(-50%, -50%) translate(var(--center-cross-x), var(--center-cross-y));
    }
    47% {
      opacity: 0;
      transform: translate(-50%, -50%) translate(var(--center-cross-x), var(--center-cross-y));
    }
    53% {
      opacity: 0;
      transform: translate(-50%, -50%) translate(var(--center-cross-neg-x), var(--center-cross-neg-y));
    }
    60% {
      opacity: 0.56;
      transform: translate(-50%, -50%) translate(var(--center-cross-neg-x), var(--center-cross-neg-y));
    }
    100% {
      opacity: 0.56;
      transform: translate(-50%, -50%) translate(0, 0);
    }
  }

  @media (max-width: 640px) {
    html body .about-portrait .about-portrait__voice {
      top: 9px !important;
      right: 34px !important;
      max-width: calc(100% - 68px) !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html body .about-portrait .about-cursor-probe {
      transition: none;
    }

    html body .about-portrait .about-center-cross.is-travelling,
    html body .about-portrait .about-portrait__voice-state.is-blinking,
    html body .about-portrait .about-portrait__voice-line.is-rolling {
      animation: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const initializeAboutProbe = () => {
      const models = document.querySelectorAll('.about-portrait [data-meshy-point-surface]');
      const finePointer = window.matchMedia('(pointer: fine) and (hover: hover)');
      if (!finePointer.matches) return;

      models.forEach((model) => {
        if (!(model instanceof HTMLElement)) return;
        if (model.dataset.aboutCursorProbeInitialized === 'true') return;
        model.dataset.aboutCursorProbeInitialized = 'true';

        const sourceProbe = model.querySelector('[data-meshy-surface-probe]');
        const sourcePrimary = model.querySelector('[data-meshy-surface-probe-primary]');
        const sourceSecondary = model.querySelector('[data-meshy-surface-probe-secondary]');

        const probe = document.createElement('span');
        probe.className = 'about-cursor-probe';
        probe.setAttribute('aria-hidden', 'true');
        probe.innerHTML = `
          <span class="about-cursor-probe__cross"></span>
          <span class="about-cursor-probe__label">
            <span data-about-cursor-primary>SURFACE / -----</span>
            <span class="about-cursor-probe__secondary" data-about-cursor-secondary>XYZ -- / -- / --</span>
          </span>
        `;
        model.append(probe);

        const primary = probe.querySelector('[data-about-cursor-primary]');
        const secondary = probe.querySelector('[data-about-cursor-secondary]');
        if (!(primary instanceof HTMLElement) || !(secondary instanceof HTMLElement)) return;

        const syncSourceText = () => {
          if (
            sourceProbe instanceof HTMLElement &&
            sourceProbe.classList.contains('is-visible') &&
            sourcePrimary instanceof HTMLElement &&
            sourceSecondary instanceof HTMLElement
          ) {
            primary.textContent = sourcePrimary.textContent?.trim() || 'SURFACE / -----';
            secondary.textContent = sourceSecondary.textContent?.trim() || 'XYZ -- / -- / --';
            return;
          }

          primary.textContent = 'SURFACE / -----';
          secondary.textContent = 'XYZ -- / -- / --';
        };

        const positionProbe = (event) => {
          const rect = model.getBoundingClientRect();
          const x = Math.max(0, Math.min(rect.width, event.clientX - rect.left));
          const y = Math.max(0, Math.min(rect.height, event.clientY - rect.top));
          probe.style.left = `${Math.round(x)}px`;
          probe.style.top = `${Math.round(y)}px`;
        };

        const updateProbe = (event) => {
          positionProbe(event);
          window.requestAnimationFrame(syncSourceText);
        };

        model.addEventListener('pointerenter', (event) => {
          updateProbe(event);
          probe.classList.add('is-visible');
        });

        model.addEventListener(
          'pointermove',
          (event) => {
            updateProbe(event);
            probe.classList.add('is-visible');
          },
          { passive: true }
        );

        model.addEventListener('pointerleave', () => {
          probe.classList.remove('is-visible');
        });

        model.addEventListener('pointerdown', (event) => {
          updateProbe(event);
          probe.classList.add('is-visible');
        });

        model.addEventListener('pointerup', (event) => {
          updateProbe(event);
        });
      });
    };

    const initializeCenterCross = () => {
      const frames = document.querySelectorAll('[data-about-portrait-frame]');
      const finePointer = window.matchMedia('(pointer: fine) and (hover: hover)');
      if (!finePointer.matches) return;

      frames.forEach((frame) => {
        if (!(frame instanceof HTMLElement)) return;
        if (frame.dataset.centerCrossInitialized === 'true') return;
        frame.dataset.centerCrossInitialized = 'true';

        const cross = document.createElement('span');
        cross.className = 'about-center-cross';
        cross.setAttribute('aria-hidden', 'true');
        frame.append(cross);

        let travelling = false;

        const updateTravelDistance = () => {
          const rect = frame.getBoundingClientRect();
          const x = Math.max(0, rect.width * 0.5 - 24);
          const y = Math.max(0, rect.height * 0.5 - 24);
          cross.style.setProperty('--center-cross-x', `${Math.round(x)}px`);
          cross.style.setProperty('--center-cross-y', `${Math.round(y)}px`);
          cross.style.setProperty('--center-cross-neg-x', `${Math.round(-x)}px`);
          cross.style.setProperty('--center-cross-neg-y', `${Math.round(-y)}px`);
        };

        const startTravel = () => {
          if (travelling) return;
          travelling = true;
          updateTravelDistance();
          cross.classList.remove('is-travelling');
          void cross.offsetWidth;
          cross.classList.add('is-travelling');
        };

        cross.addEventListener('animationend', () => {
          cross.classList.remove('is-travelling');
          travelling = false;
        });

        updateTravelDistance();
        frame.addEventListener('pointerenter', startTravel);
        window.addEventListener('resize', updateTravelDistance, { passive: true });
      });
    };

    const initializeVoicePolish = () => {
      const frames = document.querySelectorAll('[data-about-portrait-frame]');

      const voicePairs = [
        { state: 'TUGGED', comment: 'why are you pulling my hair' },
        { state: 'FRAGILE', comment: 'careful with the face' },
        { state: 'VERIFIED', comment: "okay, i get it. i'm 3d." },
        { state: 'HELD', comment: 'you can let go now' },
        { state: 'COMPRESSED', comment: "i'm not a stress ball" },
        { state: 'ORBITING', comment: 'orbit responsibly' },
        { state: 'TOPOLOGICAL', comment: 'please respect the topology' },
        { state: 'STRAINED', comment: 'my neck was not designed for this' },
        { state: 'EVALUATED', comment: 'are you testing the model or me' },
        { state: 'OVERSAMPLED', comment: 'i have approximately 42,000 reasons to be nervous' },
        { state: 'UNLICENSED', comment: 'did the cursor come with a permit' },
        { state: 'SURVEYED', comment: 'this feels less like interaction and more like fieldwork' },
        { state: 'OFFENDED', comment: 'this is becoming personal' },
        { state: 'VALIDATED', comment: 'you have thoroughly established the third dimension' },
        { state: 'DIZZY', comment: 'still here. still being rotated.' },
        { state: 'DISPLACED', comment: 'please return my face to its original coordinate system' },
        { state: 'OVERROTATED', comment: "i'm filing this under excessive orbit" },
        { state: 'FATIGUED', comment: 'that is enough user testing for one neck' },
      ];

      frames.forEach((frame) => {
        if (!(frame instanceof HTMLElement)) return;
        if (frame.dataset.voicePolishInitialized === 'true') return;
        frame.dataset.voicePolishInitialized = 'true';

        const model = frame.querySelector('[data-meshy-point-surface]');
        const originalVoice = frame.querySelector('[data-about-portrait-voice]');
        if (!(model instanceof HTMLElement) || !(originalVoice instanceof HTMLElement)) return;

        const voice = originalVoice.cloneNode(true);
        if (!(voice instanceof HTMLElement)) return;
        originalVoice.replaceWith(voice);

        const voiceStatus = voice.querySelector('[data-about-portrait-voice-status]');
        const voiceLine = voice.querySelector('[data-about-portrait-voice-line]');
        if (!(voiceStatus instanceof HTMLElement) || !(voiceLine instanceof HTMLElement)) return;

        voiceStatus.innerHTML = `
          <span class="about-portrait__voice-subject">SUBJECT /</span>
          <span class="about-portrait__voice-state" data-about-portrait-voice-state>READY</span>
        `;
        const voiceState = voiceStatus.querySelector('[data-about-portrait-voice-state]');
        if (!(voiceState instanceof HTMLElement)) return;

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let pointerDown = false;
        let dragDistance = 0;
        let lastPointerX = 0;
        let lastPointerY = 0;
        let cycleStarted = false;
        let firstTimer = 0;
        let repeatTimer = 0;
        let lastComment = '';

        const clearTimers = () => {
          window.clearTimeout(firstTimer);
          window.clearInterval(repeatTimer);
          firstTimer = 0;
          repeatTimer = 0;
        };

        const hideVoice = () => {
          clearTimers();
          cycleStarted = false;
          voice.classList.remove('is-visible');
          voiceState.classList.remove('is-blinking');
          voiceLine.classList.remove('is-rolling');
          voice.setAttribute('aria-hidden', 'true');
        };

        const choosePair = () => {
          const candidates = voicePairs.filter((pair) => pair.comment !== lastComment);
          const source = candidates.length ? candidates : voicePairs;
          const next = source[Math.floor(Math.random() * source.length)];
          lastComment = next.comment;
          return next;
        };

        const restartAnimation = (element, className) => {
          if (reducedMotion) return;
          element.classList.remove(className);
          void element.offsetWidth;
          element.classList.add(className);
        };

        const showNextComment = () => {
          if (!pointerDown || !cycleStarted) return;

          const pair = choosePair();
          voiceState.textContent = pair.state;
          voiceLine.textContent = `> ${pair.comment}`;
          voice.classList.add('is-visible');
          voice.setAttribute('aria-hidden', 'false');

          restartAnimation(voiceState, 'is-blinking');
          restartAnimation(voiceLine, 'is-rolling');
        };

        const startVoiceCycle = () => {
          if (cycleStarted) return;
          cycleStarted = true;

          firstTimer = window.setTimeout(() => {
            if (!pointerDown) return;
            showNextComment();
            repeatTimer = window.setInterval(showNextComment, 5000);
          }, 3000);
        };

        const finishDrag = () => {
          if (!pointerDown && !cycleStarted) return;
          pointerDown = false;
          hideVoice();
        };

        model.addEventListener('pointerdown', (event) => {
          pointerDown = true;
          dragDistance = 0;
          lastPointerX = event.clientX;
          lastPointerY = event.clientY;
          hideVoice();
          pointerDown = true;
        });

        model.addEventListener(
          'pointermove',
          (event) => {
            if (!pointerDown) return;

            const dx = event.clientX - lastPointerX;
            const dy = event.clientY - lastPointerY;
            dragDistance += Math.hypot(dx, dy);
            lastPointerX = event.clientX;
            lastPointerY = event.clientY;

            if (dragDistance >= 8) startVoiceCycle();
          },
          { passive: true }
        );

        model.addEventListener('pointerup', finishDrag);
        model.addEventListener('pointercancel', finishDrag);
        window.addEventListener('pointerup', finishDrag, true);
        window.addEventListener('pointercancel', finishDrag, true);
      });
    };

    const initialize = () => {
      initializeAboutProbe();
      initializeCenterCross();
      initializeVoicePolish();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize, { once: true });
    } else {
      initialize();
    }
  })();
</script>
