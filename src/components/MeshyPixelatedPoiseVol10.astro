<div class="meshy-point-surface-v10" data-meshy-point-surface-v10 aria-label="Pyöriteltävä Meshy-pistepinta vol 10">
  <canvas class="meshy-point-surface-v10__canvas" data-meshy-point-surface-v10-canvas></canvas>
  <p class="meshy-point-surface-v10__status" data-meshy-point-surface-v10-status>Ladataan pistepintaa...</p>
</div>

<style>
  .meshy-point-surface-v10 {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 420px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .meshy-point-surface-v10:active {
    cursor: grabbing;
  }

  .meshy-point-surface-v10__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }

  .meshy-point-surface-v10__status {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: 0;
    color: var(--stone-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .meshy-point-surface-v10__status[hidden] {
    display: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-meshy-point-surface-v10]');

    const FRONT_RES_X = 96;
    const FRONT_RES_Y = 72;
    const SIDE_RES_Y = 72;
    const SIDE_RES_Z = 96;

    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
    const smoothstep = (edge0, edge1, x) => {
      const t = clamp((x - edge0) / (edge1 - edge0), 0, 1);
      return t * t * (3 - 2 * t);
    };

    const estimateGeometryArea = (geometry, THREE) => {
      const position = geometry.getAttribute('position');
      if (!position || position.count < 3) return 0;

      const a = new THREE.Vector3();
      const b = new THREE.Vector3();
      const c = new THREE.Vector3();
      const ab = new THREE.Vector3();
      const ac = new THREE.Vector3();
      const index = geometry.getIndex();
      let area = 0;

      if (index) {
        for (let i = 0; i + 2 < index.count; i += 3) {
          a.fromBufferAttribute(position, index.getX(i));
          b.fromBufferAttribute(position, index.getX(i + 1));
          c.fromBufferAttribute(position, index.getX(i + 2));
          ab.subVectors(b, a);
          ac.subVectors(c, a);
          area += ab.cross(ac).length() * 0.5;
        }
      } else {
        for (let i = 0; i + 2 < position.count; i += 3) {
          a.fromBufferAttribute(position, i);
          b.fromBufferAttribute(position, i + 1);
          c.fromBufferAttribute(position, i + 2);
          ab.subVectors(b, a);
          ac.subVectors(c, a);
          area += ab.cross(ac).length() * 0.5;
        }
      }

      return area;
    };

    roots.forEach(async (root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.meshyPointSurfaceV10Initialized === 'true') return;
      root.dataset.meshyPointSurfaceV10Initialized = 'true';

      const canvas = root.querySelector('[data-meshy-point-surface-v10-canvas]');
      const status = root.querySelector('[data-meshy-point-surface-v10-status]');
      if (!(canvas instanceof HTMLCanvasElement)) return;

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        );
        const { GLTFLoader } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/loaders/GLTFLoader.js/+esm'
        );
        const { MeshSurfaceSampler } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/math/MeshSurfaceSampler.js/+esm'
        );

        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.setClearColor(0x000000, 0);
        renderer.outputColorSpace = THREE.SRGBColorSpace;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(36, 1, 0.01, 1000);
        const controls = new OrbitControls(camera, canvas);
        controls.enableDamping = true;
        controls.dampingFactor = 0.06;
        controls.enablePan = true;
        controls.enableZoom = true;
        controls.target.set(0, 0, 0);

        const loader = new GLTFLoader();
        loader.load(
          '/lab/meshy-pixelated-poise.glb',
          (gltf) => {
            const model = gltf.scene;
            model.updateMatrixWorld(true);

            const box = new THREE.Box3().setFromObject(model);
            const center = box.getCenter(new THREE.Vector3());
            const size = box.getSize(new THREE.Vector3());
            const radius = Math.max(size.x, size.y, size.z) * 0.5 || 1;
            const scale = {
              x: Math.max(size.x * 0.5, 0.0001),
              y: Math.max(size.y * 0.5, 0.0001),
              z: Math.max(size.z * 0.5, 0.0001),
            };

            const toNorm = (p) => ({
              nx: p.x / scale.x,
              ny: p.y / scale.y,
              nz: p.z / scale.z,
            });

            const isNeckCut = (worldPosition, worldNormal) => {
              const lowerBandTop = -size.y * 0.31;
              const lowerBandBottom = -size.y * 0.44;
              const inNeckCutBand = worldPosition.y < lowerBandTop && worldPosition.y > lowerBandBottom;
              const nearlyHorizontalSurface = Math.abs(worldNormal.y) > 0.72;
              return inNeckCutBand && nearlyHorizontalSurface;
            };

            const meshEntries = [];
            let totalArea = 0;

            model.traverse((child) => {
              if (!(child instanceof THREE.Mesh)) return;
              if (!(child.geometry instanceof THREE.BufferGeometry)) return;
              const area = estimateGeometryArea(child.geometry, THREE);
              if (area <= 0) return;
              child.updateWorldMatrix(true, false);
              meshEntries.push({ mesh: child, area });
              totalArea += area;
            });

            if (!meshEntries.length || totalArea <= 0) {
              if (status instanceof HTMLElement) status.textContent = 'Pistepintaa ei voitu muodostaa';
              return;
            }

            const acceptedPositions = [];
            const acceptedBaseColors = [];
            const totalPointBudget = 42000;
            const backgroundColor = new THREE.Color(0xe9e9e4);
            const tempColor = new THREE.Color();

            const frontDepth = new Float32Array(FRONT_RES_X * FRONT_RES_Y).fill(-Infinity);
            const sideExtentRight = new Float32Array(SIDE_RES_Y * SIDE_RES_Z).fill(-Infinity);
            const sideExtentLeft = new Float32Array(SIDE_RES_Y * SIDE_RES_Z).fill(-Infinity);
            const triData = [];
            const triangleIndexByEdge = new Map();
            const tempA = new THREE.Vector3();
            const tempB = new THREE.Vector3();
            const tempC = new THREE.Vector3();
            const tempAB = new THREE.Vector3();
            const tempAC = new THREE.Vector3();
            const tempNormal = new THREE.Vector3();

            const frontKey = (nx, ny) => {
              const ix = clamp(Math.floor(((nx + 1) * 0.5) * (FRONT_RES_X - 1)), 0, FRONT_RES_X - 1);
              const iy = clamp(Math.floor(((ny + 1) * 0.5) * (FRONT_RES_Y - 1)), 0, FRONT_RES_Y - 1);
              return iy * FRONT_RES_X + ix;
            };

            const sideKey = (ny, nz) => {
              const iy = clamp(Math.floor(((ny + 1) * 0.5) * (SIDE_RES_Y - 1)), 0, SIDE_RES_Y - 1);
              const iz = clamp(Math.floor(((nz + 1) * 0.5) * (SIDE_RES_Z - 1)), 0, SIDE_RES_Z - 1);
              return iz * SIDE_RES_Y + iy;
            };

            const registerFrontDepth = (point) => {
              const { nx, ny, nz } = toNorm(point);
              const key = frontKey(nx, ny);
              if (nz > frontDepth[key]) frontDepth[key] = nz;
            };

            const registerSideExtent = (point) => {
              const { nx, ny, nz } = toNorm(point);
              const key = sideKey(ny, nz);
              if (nx >= 0) {
                if (nx > sideExtentRight[key]) sideExtentRight[key] = nx;
              } else {
                const absX = Math.abs(nx);
                if (absX > sideExtentLeft[key]) sideExtentLeft[key] = absX;
              }
            };

            const readFrontDepth = (nx, ny) => {
              let best = -Infinity;
              for (let oy = -1; oy <= 1; oy += 1) {
                for (let ox = -1; ox <= 1; ox += 1) {
                  const ix = clamp(Math.floor(((nx + 1) * 0.5) * (FRONT_RES_X - 1)) + ox, 0, FRONT_RES_X - 1);
                  const iy = clamp(Math.floor(((ny + 1) * 0.5) * (FRONT_RES_Y - 1)) + oy, 0, FRONT_RES_Y - 1);
                  const value = frontDepth[iy * FRONT_RES_X + ix];
                  if (value > best) best = value;
                }
              }
              return Number.isFinite(best) ? best : -Infinity;
            };

            const readSideExtent = (nx, ny, nz) => {
              const source = nx >= 0 ? sideExtentRight : sideExtentLeft;
              let best = -Infinity;
              for (let oz = -1; oz <= 1; oz += 1) {
                for (let oy = -1; oy <= 1; oy += 1) {
                  const iy = clamp(Math.floor(((ny + 1) * 0.5) * (SIDE_RES_Y - 1)) + oy, 0, SIDE_RES_Y - 1);
                  const iz = clamp(Math.floor(((nz + 1) * 0.5) * (SIDE_RES_Z - 1)) + oz, 0, SIDE_RES_Z - 1);
                  const value = source[iz * SIDE_RES_Y + iy];
                  if (value > best) best = value;
                }
              }
              return Number.isFinite(best) ? best : -Infinity;
            };

            const leftRingMetric = ({ nx, ny }) => Math.pow((nx + 0.34) / 0.33, 2) + Math.pow((ny - 0.145) / 0.17, 2);
            const rightRingMetric = ({ nx, ny }) => Math.pow((nx - 0.34) / 0.33, 2) + Math.pow((ny - 0.145) / 0.17, 2);

            const isFrameBand = (norm) => {
              const leftMetric = leftRingMetric(norm);
              const rightMetric = rightRingMetric(norm);
              const aroundLeft = leftMetric > 0.72 && leftMetric < 1.38;
              const aroundRight = rightMetric > 0.72 && rightMetric < 1.38;
              return (aroundLeft || aroundRight) && norm.nz > 0.42;
            };

            const isFrameSeed = (norm) => {
              const leftMetric = leftRingMetric(norm);
              const rightMetric = rightRingMetric(norm);
              const topBand = norm.ny > 0.11 && norm.ny < 0.28;
              const goodDepth = norm.nz > 0.68;
              return goodDepth && topBand && (
                (leftMetric > 0.86 && leftMetric < 1.15) ||
                (rightMetric > 0.86 && rightMetric < 1.15)
              );
            };

            const isBridgeBand = (norm) => (
              Math.abs(norm.nx) < 0.12 &&
              norm.ny > 0.05 && norm.ny < 0.23 &&
              norm.nz > 0.66
            );

            const isBridgeSeed = (norm) => (
              Math.abs(norm.nx) < 0.08 &&
              norm.ny > 0.08 && norm.ny < 0.2 &&
              norm.nz > 0.78
            );

            const isTempleBand = (norm) => (
              Math.abs(norm.nx) > 0.72 && Math.abs(norm.nx) < 0.95 &&
              norm.ny > 0.08 && norm.ny < 0.24 &&
              norm.nz > -0.06 && norm.nz < 0.62
            );

            const isTempleSeed = (norm) => (
              Math.abs(norm.nx) > 0.78 && Math.abs(norm.nx) < 0.94 &&
              norm.ny > 0.12 && norm.ny < 0.22 &&
              norm.nz > 0.28 && norm.nz < 0.6
            );

            const isTempleTailReject = (norm) => (
              Math.abs(norm.nx) < 0.73 ||
              norm.ny < 0.06 || norm.ny > 0.25 ||
              norm.nz < -0.02 || norm.nz > 0.5
            );

            meshEntries.forEach(({ mesh, area }) => {
              const baseTarget = Math.max(1400, Math.round(totalPointBudget * (area / totalArea)));
              const sampler = new MeshSurfaceSampler(mesh).build();
              const sampledPosition = new THREE.Vector3();
              const sampledNormal = new THREE.Vector3();
              const worldPosition = new THREE.Vector3();
              const worldNormal = new THREE.Vector3();
              const normalMatrix = new THREE.Matrix3().getNormalMatrix(mesh.matrixWorld);
              const sourceMaterial = Array.isArray(mesh.material) ? mesh.material[0] : mesh.material;
              const pointColor = sourceMaterial?.color instanceof THREE.Color
                ? sourceMaterial.color.clone()
                : new THREE.Color(0x6c786f);

              if (pointColor.r > 0.94 && pointColor.g > 0.94 && pointColor.b > 0.94) {
                pointColor.set(0x6c786f);
              }

              const maxAttempts = baseTarget * 20;
              let acceptedForMesh = 0;
              let attempts = 0;

              while (acceptedForMesh < baseTarget && attempts < maxAttempts) {
                attempts += 1;
                sampler.sample(sampledPosition, sampledNormal);
                worldPosition.copy(sampledPosition).applyMatrix4(mesh.matrixWorld).sub(center);
                worldNormal.copy(sampledNormal).applyMatrix3(normalMatrix).normalize();

                const sampleNorm = toNorm(worldPosition);
                const sampleLeftRing = leftRingMetric(sampleNorm);
                const sampleRightRing = rightRingMetric(sampleNorm);
                const broadFrontGlasses = (
                  ((sampleLeftRing > 0.48 && sampleLeftRing < 1.62) ||
                   (sampleRightRing > 0.48 && sampleRightRing < 1.62) ||
                   (Math.abs(sampleNorm.nx) < 0.18 && sampleNorm.ny > 0.02 && sampleNorm.ny < 0.27)) &&
                  sampleNorm.nz > 0.62
                );
                const broadTempleGlasses = (
                  Math.abs(sampleNorm.nx) > 0.64 &&
                  sampleNorm.ny > 0.04 && sampleNorm.ny < 0.29 &&
                  sampleNorm.nz > -0.10 && sampleNorm.nz < 0.90
                );

                if (!broadFrontGlasses) registerFrontDepth(worldPosition);
                if (!broadTempleGlasses) registerSideExtent(worldPosition);

                if (isNeckCut(worldPosition, worldNormal) && Math.random() > 0.12) continue;

                const { nx, ny, nz } = sampleNorm;
                const eyeBand = ny > -0.02 && ny < 0.34;
                const centralFaceBand = Math.abs(nx) < 0.62;
                const frontBias = nz > -0.18;
                const glassesZone = eyeBand && centralFaceBand && frontBias;

                const repetitions = glassesZone ? 2 : 1;
                for (let repeat = 0; repeat < repetitions && acceptedForMesh < baseTarget; repeat += 1) {
                  acceptedPositions.push(worldPosition.x, worldPosition.y, worldPosition.z);
                  acceptedBaseColors.push(pointColor.r, pointColor.g, pointColor.b);
                  acceptedForMesh += 1;
                }
              }
            });

            meshEntries.forEach(({ mesh }) => {
              const sourceGeometry = mesh.geometry;
              const pos = sourceGeometry.getAttribute('position');
              const index = sourceGeometry.getIndex();
              if (!pos) return;

              const getWorld = (i, target) => target.fromBufferAttribute(pos, i).applyMatrix4(mesh.matrixWorld).sub(center);
              const registerTriangle = (ia, ib, ic) => {
                const a = getWorld(ia, new THREE.Vector3());
                const b = getWorld(ib, new THREE.Vector3());
                const c = getWorld(ic, new THREE.Vector3());
                const centroid = new THREE.Vector3().add(a).add(b).add(c).multiplyScalar(1 / 3);

                tempAB.subVectors(b, a);
                tempAC.subVectors(c, a);
                tempNormal.crossVectors(tempAB, tempAC).normalize();
                const normalLen = tempNormal.length();
                if (!normalLen) return;

                const normA = toNorm(a);
                const normB = toNorm(b);
                const normC = toNorm(c);
                const normCentroid = toNorm(centroid);

                const faceDepthCentroid = readFrontDepth(normCentroid.nx, normCentroid.ny);
                const faceDepthA = readFrontDepth(normA.nx, normA.ny);
                const faceDepthB = readFrontDepth(normB.nx, normB.ny);
                const faceDepthC = readFrontDepth(normC.nx, normC.ny);
                const deltaZCentroid = normCentroid.nz - faceDepthCentroid;
                const deltaZA = normA.nz - faceDepthA;
                const deltaZB = normB.nz - faceDepthB;
                const deltaZC = normC.nz - faceDepthC;

                const sideExtentCentroid = readSideExtent(normCentroid.nx, normCentroid.ny, normCentroid.nz);
                const deltaXCentroid = Math.abs(normCentroid.nx) - sideExtentCentroid;

                const frameVotes = [normA, normB, normC, normCentroid].filter(isFrameBand).length;
                const bridgeVotes = [normA, normB, normC, normCentroid].filter(isBridgeBand).length;
                const templeVotes = [normA, normB, normC, normCentroid].filter(isTempleBand).length;

                const frontFacingEnough = tempNormal.z > -0.28;
                const frameDepthPasses = [deltaZA, deltaZB, deltaZC, deltaZCentroid].filter((value) => value > 0.028).length;
                const frameSoftDepthPasses = [deltaZA, deltaZB, deltaZC, deltaZCentroid].filter((value) => value > 0.014).length;
                const templeDepthPass = deltaXCentroid > 0.018;

                const isFrameCandidate = frontFacingEnough && frameVotes >= 3 && frameDepthPasses >= 2;
                const isBridgeCandidate = frontFacingEnough && bridgeVotes >= 3 && frameSoftDepthPasses >= 2;
                const isTempleCandidate = templeVotes >= 3 && templeDepthPass && !isTempleTailReject(normCentroid);

                const seedFrame = [normA, normB, normC, normCentroid].some(isFrameSeed);
                const seedBridge = [normA, normB, normC, normCentroid].some(isBridgeSeed);
                const seedTemple = [normA, normB, normC, normCentroid].some(isTempleSeed);

                triData.push({
                  points: [a, b, c],
                  normCentroid,
                  frameDepthPasses,
                  frameSoftDepthPasses,
                  isFrameCandidate,
                  isBridgeCandidate,
                  isTempleCandidate,
                  seedFrame,
                  seedBridge,
                  seedTemple,
                  accepted: false,
                  keep: false,
                  neighbors: new Set(),
                });
              };

              if (index) {
                for (let i = 0; i + 2 < index.count; i += 3) {
                  registerTriangle(index.getX(i), index.getX(i + 1), index.getX(i + 2));
                }
              } else {
                for (let i = 0; i + 2 < pos.count; i += 3) {
                  registerTriangle(i, i + 1, i + 2);
                }
              }
            });

            triData.forEach((tri, triIndex) => {
              tri.accepted = tri.isFrameCandidate || tri.isBridgeCandidate || tri.isTempleCandidate;
              const keys = tri.points.map((point) => `${point.x.toFixed(4)}|${point.y.toFixed(4)}|${point.z.toFixed(4)}`);
              [[0,1],[1,2],[2,0]].forEach(([i1,i2]) => {
                const edgeKey = keys[i1] < keys[i2] ? `${keys[i1]}__${keys[i2]}` : `${keys[i2]}__${keys[i1]}`;
                const list = triangleIndexByEdge.get(edgeKey) || [];
                list.push(triIndex);
                triangleIndexByEdge.set(edgeKey, list);
              });
            });

            triangleIndexByEdge.forEach((list) => {
              if (list.length < 2) return;
              for (let i = 0; i < list.length; i += 1) {
                for (let j = i + 1; j < list.length; j += 1) {
                  triData[list[i]].neighbors.add(list[j]);
                  triData[list[j]].neighbors.add(list[i]);
                }
              }
            });

            for (let pass = 0; pass < 2; pass += 1) {
              triData.forEach((tri) => {
                if (tri.accepted) return;
                const supportCount = Array.from(tri.neighbors).filter((index) => triData[index].accepted).length;
                const couldBridgeGap = tri.frameSoftDepthPasses >= 2 && supportCount >= 2 && (isFrameBand(tri.normCentroid) || isBridgeBand(tri.normCentroid));
                if (couldBridgeGap) tri.accepted = true;
              });
            }

            const seedIndices = triData
              .map((tri, index) => ({ tri, index }))
              .filter(({ tri }) => tri.accepted && (tri.seedFrame || tri.seedBridge || tri.seedTemple))
              .map(({ index }) => index);

            const queue = [...seedIndices];
            const visited = new Set(queue);
            while (queue.length) {
              const index = queue.shift();
              const tri = triData[index];
              tri.keep = true;
              tri.neighbors.forEach((neighborIndex) => {
                const neighbor = triData[neighborIndex];
                if (!neighbor.accepted || visited.has(neighborIndex)) return;
                const sameClass = (
                  (tri.isTempleCandidate && neighbor.isTempleCandidate) ||
                  ((tri.isFrameCandidate || tri.isBridgeCandidate) && (neighbor.isFrameCandidate || neighbor.isBridgeCandidate)) ||
                  tri.seedBridge || neighbor.seedBridge
                );
                if (!sameClass) return;
                visited.add(neighborIndex);
                queue.push(neighborIndex);
              });
            }

            const glassesTriangles = [];
            triData.forEach((tri) => {
              if (!tri.keep) return;
              tri.points.forEach((point) => {
                glassesTriangles.push(point.x, point.y, point.z);
              });
            });

            const pointCount = Math.floor(acceptedPositions.length / 3);
            if (!pointCount) {
              if (status instanceof HTMLElement) status.textContent = 'Pistepintaa ei voitu muodostaa';
              return;
            }

            const geometry = new THREE.BufferGeometry();
            geometry.setAttribute('position', new THREE.Float32BufferAttribute(acceptedPositions, 3));
            geometry.setAttribute('color', new THREE.Float32BufferAttribute(acceptedBaseColors, 3));

            const material = new THREE.PointsMaterial({
              size: Math.max(radius * 0.0085, 0.0035),
              sizeAttenuation: true,
              transparent: true,
              opacity: 0.98,
              depthWrite: false,
              vertexColors: true,
            });
            scene.add(new THREE.Points(geometry, material));

            if (glassesTriangles.length) {
              const glassesGeometry = new THREE.BufferGeometry();
              glassesGeometry.setAttribute('position', new THREE.Float32BufferAttribute(glassesTriangles, 3));
              glassesGeometry.computeVertexNormals();

              const glassesMaterial = new THREE.MeshStandardMaterial({
                color: 0xe14545,
                roughness: 0.72,
                metalness: 0.02,
                side: THREE.DoubleSide,
              });

              scene.add(new THREE.Mesh(glassesGeometry, glassesMaterial));
            }

            scene.add(new THREE.AmbientLight(0xffffff, 1.1));
            const keyLight = new THREE.DirectionalLight(0xffffff, 0.82);
            keyLight.position.set(radius * 2.0, radius * 1.4, radius * 2.2);
            scene.add(keyLight);
            const fillLight = new THREE.DirectionalLight(0xffffff, 0.28);
            fillLight.position.set(-radius * 1.8, radius * 0.8, -radius * 0.8);
            scene.add(fillLight);

            const positionAttribute = geometry.getAttribute('position');
            const colorAttribute = geometry.getAttribute('color');
            const baseColors = Float32Array.from(colorAttribute.array);
            const cameraSpacePoint = new THREE.Vector3();
            const depthSamples = new Float32Array(pointCount);
            const lastCameraPosition = new THREE.Vector3(Number.POSITIVE_INFINITY, Number.POSITIVE_INFINITY, Number.POSITIVE_INFINITY);
            const lastCameraQuaternion = new THREE.Quaternion();

            const updateDepthShading = () => {
              let minDepth = Number.POSITIVE_INFINITY;
              let maxDepth = Number.NEGATIVE_INFINITY;

              for (let i = 0; i < pointCount; i += 1) {
                cameraSpacePoint.fromBufferAttribute(positionAttribute, i).applyMatrix4(camera.matrixWorldInverse);
                const depth = -cameraSpacePoint.z;
                depthSamples[i] = depth;
                if (depth < minDepth) minDepth = depth;
                if (depth > maxDepth) maxDepth = depth;
              }

              const depthRange = Math.max(maxDepth - minDepth, 0.0001);
              for (let i = 0; i < pointCount; i += 1) {
                const depth01 = (depthSamples[i] - minDepth) / depthRange;
                const fade = Math.min(0.78, Math.max(0, depth01 * 0.88));
                tempColor.setRGB(
                  baseColors[i * 3],
                  baseColors[i * 3 + 1],
                  baseColors[i * 3 + 2]
                ).lerp(backgroundColor, fade);
                colorAttribute.setXYZ(i, tempColor.r, tempColor.g, tempColor.b);
              }
              colorAttribute.needsUpdate = true;
            };

            camera.near = Math.max(radius / 1000, 0.001);
            camera.far = Math.max(radius * 100, 100);
            camera.position.set(radius * 1.65, radius * 0.85, radius * 2.05);
            camera.updateProjectionMatrix();

            controls.target.set(0, 0, 0);
            controls.minDistance = Math.max(radius * 0.18, 0.01);
            controls.maxDistance = radius * 12;
            controls.update();
            updateDepthShading();
            lastCameraPosition.copy(camera.position);
            lastCameraQuaternion.copy(camera.quaternion);

            root.__meshyPointSurfaceV10Tick = () => {
              const moved = lastCameraPosition.distanceToSquared(camera.position) > 0.000001;
              const turned = 1 - Math.abs(lastCameraQuaternion.dot(camera.quaternion)) > 0.000001;
              if (moved || turned) {
                updateDepthShading();
                lastCameraPosition.copy(camera.position);
                lastCameraQuaternion.copy(camera.quaternion);
              }
            };

            if (status instanceof HTMLElement) status.hidden = true;
          },
          undefined,
          () => {
            if (status instanceof HTMLElement) status.textContent = '3D-mallia ei voitu ladata';
          }
        );

        const resize = () => {
          const width = Math.max(1, root.clientWidth);
          const height = Math.max(1, root.clientHeight);
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        const observer = new ResizeObserver(resize);
        observer.observe(root);
        resize();

        const animate = () => {
          controls.update();
          if (typeof root.__meshyPointSurfaceV10Tick === 'function') root.__meshyPointSurfaceV10Tick();
          renderer.render(scene, camera);
          requestAnimationFrame(animate);
        };
        animate();
      } catch {
        if (status instanceof HTMLElement) status.textContent = 'Pistepintakatselinta ei voitu ladata';
      }
    });
  })();
</script>
