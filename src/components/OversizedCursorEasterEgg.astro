<div class="site-oversized-cursor" data-oversized-cursor aria-hidden="true">
  <span class="site-oversized-cursor__label">JUST A QUICK REMINDER</span>

  <svg
    class="site-oversized-cursor__pointer"
    data-oversized-pointer
    viewBox="0 0 170 224"
    aria-hidden="true"
  >
    <path
      d="M16 10 L16 181 L58 139 L91 214 L126 198 L94 128 L154 128 Z"
    />
  </svg>

  <span class="site-oversized-cursor__guide site-oversized-cursor__guide--a"></span>
  <span class="site-oversized-cursor__guide site-oversized-cursor__guide--b"></span>
</div>

<style is:global>
  .site-oversized-cursor {
    --oversized-cursor-x: 50vw;
    --oversized-cursor-y: 50vh;
    --oversized-guide-a-x: 50vw;
    --oversized-guide-a-y: 50vh;
    --oversized-guide-b-x: 50vw;
    --oversized-guide-b-y: 50vh;
    position: fixed;
    inset: 0;
    z-index: 78;
    display: none;
    pointer-events: none;
    overflow: hidden;
  }

  .site-oversized-cursor.is-visible {
    display: block;
  }

  html body.site-oversized-cursor-mode,
  html body.site-oversized-cursor-mode * {
    cursor: none !important;
  }

  .site-oversized-cursor__pointer {
    position: absolute;
    left: var(--oversized-cursor-x);
    top: var(--oversized-cursor-y);
    z-index: 1;
    width: clamp(60px, 7.25vw, 88px);
    height: auto;
    overflow: visible;
    transform: translate(-9.4118%, -4.4643%) rotate(-4deg);
    transform-origin: 9.4118% 4.4643%;
  }

  .site-oversized-cursor__pointer path {
    fill: rgba(255, 255, 255, 0.98);
    stroke: #11120f;
    stroke-width: 2.5;
    stroke-linecap: square;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }

  .site-oversized-cursor__guide {
    position: absolute;
    z-index: 2;
    width: 230vmax;
    height: 2px;
    background: rgba(202, 42, 39, 0.9);
    box-shadow: 0 0 0 0.5px rgba(202, 42, 39, 0.18);
    transform-origin: 50% 50%;
  }

  .site-oversized-cursor__guide--a {
    left: var(--oversized-guide-a-x);
    top: var(--oversized-guide-a-y);
    transform: translate(-50%, -50%) rotate(62.2505deg);
  }

  .site-oversized-cursor__guide--b {
    left: var(--oversized-guide-b-x);
    top: var(--oversized-guide-b-y);
    transform: translate(-50%, -50%) rotate(61.4328deg);
  }

  .site-oversized-cursor__label {
    position: fixed;
    left: 22px;
    top: 82px;
    z-index: 3;
    padding: 4px 6px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--line-soft);
    color: var(--moss-deep);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.47rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.05em;
    white-space: nowrap;
    opacity: 0.82;
  }

  @media (max-width: 640px) {
    .site-oversized-cursor__pointer {
      width: clamp(51px, 14.5vw, 68px);
    }

    .site-oversized-cursor__label {
      left: 16px;
      top: 76px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-oversized-cursor__pointer,
    .site-oversized-cursor__guide {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const overlay = document.querySelector('[data-oversized-cursor]')
    const pointerGraphic = document.querySelector('[data-oversized-pointer]')
    const aReadout = document.querySelector('[data-a-readout]')

    if (!overlay || !pointerGraphic || !aReadout) return
    if (overlay.dataset.oversizedCursorInitialized === 'true') return
    overlay.dataset.oversizedCursorInitialized = 'true'

    let visible = false
    let previousBaseMode = aReadout.dataset.mode ?? ''
    let pointerX = window.innerWidth * 0.5
    let pointerY = window.innerHeight * 0.5

    const pointerRotation = (-4 * Math.PI) / 180
    const cosPointerRotation = Math.cos(pointerRotation)
    const sinPointerRotation = Math.sin(pointerRotation)

    const rotateLocalOffset = (x, y) => ({
      x: x * cosPointerRotation - y * sinPointerRotation,
      y: x * sinPointerRotation + y * cosPointerRotation,
    })

    const positionGuides = () => {
      const pointerWidth = Number.parseFloat(getComputedStyle(pointerGraphic).width)
      if (!Number.isFinite(pointerWidth) || pointerWidth <= 0) return

      const scale = pointerWidth / 170

      // The red guides follow the two long parallel edges of the cursor shaft.
      // Coordinates are measured from the SVG hotspot at 16,10.
      const guideAOffset = rotateLocalOffset(58 - 16, 139 - 10)
      const guideBOffset = rotateLocalOffset(94 - 16, 128 - 10)

      overlay.style.setProperty(
        '--oversized-guide-a-x',
        `${pointerX + guideAOffset.x * scale}px`
      )
      overlay.style.setProperty(
        '--oversized-guide-a-y',
        `${pointerY + guideAOffset.y * scale}px`
      )
      overlay.style.setProperty(
        '--oversized-guide-b-x',
        `${pointerX + guideBOffset.x * scale}px`
      )
      overlay.style.setProperty(
        '--oversized-guide-b-y',
        `${pointerY + guideBOffset.y * scale}px`
      )
    }

    const positionOverlay = () => {
      overlay.style.setProperty('--oversized-cursor-x', `${pointerX}px`)
      overlay.style.setProperty('--oversized-cursor-y', `${pointerY}px`)
      positionGuides()
    }

    const show = () => {
      visible = true
      overlay.classList.add('is-visible')
      document.body.classList.add('site-oversized-cursor-mode')
      positionOverlay()
    }

    const hide = () => {
      visible = false
      overlay.classList.remove('is-visible')
      document.body.classList.remove('site-oversized-cursor-mode')
    }

    const resetBaseCycle = () => {
      window.dispatchEvent(
        new KeyboardEvent('keydown', {
          key: 'Escape',
          code: 'Escape',
          bubbles: true,
        })
      )
    }

    const handlePointerMove = (event) => {
      pointerX = event.clientX
      pointerY = event.clientY
      if (visible) positionOverlay()
    }

    const handleResize = () => {
      if (visible) positionOverlay()
    }

    const handleKeyup = (event) => {
      if (event.key === 'Escape') {
        hide()
        previousBaseMode = aReadout.dataset.mode ?? ''
        return
      }

      if (event.key.toLowerCase() !== 'a') return
      if (event.metaKey || event.ctrlKey || event.altKey) return

      const currentBaseMode = aReadout.dataset.mode ?? ''

      if (visible) {
        if (currentBaseMode !== '') {
          hide()
          resetBaseCycle()
          previousBaseMode = aReadout.dataset.mode ?? ''
          return
        }
      } else if (previousBaseMode === 'area' && currentBaseMode === '') {
        show()
      }

      previousBaseMode = currentBaseMode
    }

    const handlePageHide = () => {
      hide()
      window.removeEventListener('pointermove', handlePointerMove)
      window.removeEventListener('resize', handleResize)
      window.removeEventListener('keyup', handleKeyup)
    }

    positionOverlay()
    window.addEventListener('pointermove', handlePointerMove, { passive: true })
    window.addEventListener('resize', handleResize, { passive: true })
    window.addEventListener('keyup', handleKeyup)
    window.addEventListener('pagehide', handlePageHide, { once: true })
  })()
</script>
