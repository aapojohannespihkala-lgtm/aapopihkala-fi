---
import BaseLayout from '../layouts/BaseLayout.astro';
import NightModeToggle from './NightModeToggle.astro';
import AboutPortraitSection from './AboutPortraitSection.astro';
import AboutPortraitPolish from './AboutPortraitPolish.astro';
import AboutAxisMotion from './AboutAxisMotion.astro';
import { site, type SiteLanguage } from '../config/site';

interface Props {
  lang: SiteLanguage;
}

const { lang } = Astro.props;

const content = {
  fi: {
    title: 'Tietoa minusta - Aapo Pihkala',
    description: 'Tietoa maisema-arkkitehti Aapo Pihkalasta, työskentelystä ja suunnittelun näkökulmista.',
    back: '← ETUSIVU',
    homeHref: '/',
    languageHref: '/en/about/',
  },
  en: {
    title: 'About - Aapo Pihkala',
    description: 'About landscape architect Aapo Pihkala, his work and approach to landscape architecture.',
    back: '← HOME',
    homeHref: '/en/',
    languageHref: '/about/',
  },
} as const;

const t = content[lang];
const canonicalPath = lang === 'fi' ? '/about/' : '/en/about/';
const canonicalUrl = `${site.url}${canonicalPath}`;
const finnishUrl = `${site.url}/about/`;
const englishUrl = `${site.url}/en/about/`;
---

<BaseLayout
  lang={lang}
  title={t.title}
  description={t.description}
  canonicalUrl={canonicalUrl}
  finnishUrl={finnishUrl}
  englishUrl={englishUrl}
  languageHref={t.languageHref}
  initialNightMode
>
  <style slot="head">
    .about-page-shell {
      position: relative;
      min-height: calc(100svh - 64px);
      padding-top: 0;
      padding-bottom: 0;
    }

    .about-page-back {
      position: absolute;
      top: clamp(22px, 3vw, 34px);
      left: 32px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      min-height: 28px;
      color: var(--stone);
      font-family:
        ui-monospace,
        SFMono-Regular,
        Menlo,
        Monaco,
        Consolas,
        monospace;
      font-size: 0.5rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-decoration: none;
      transition: color 140ms ease, transform 140ms ease;
    }

    .about-page-back:hover,
    .about-page-back:focus-visible {
      color: var(--moss-deep);
      transform: translateX(-2px);
    }

    .about-page-back:focus-visible {
      outline: 1px solid var(--lichen);
      outline-offset: 5px;
    }

    @media (max-width: 640px) {
      .about-page-back {
        top: 20px;
        left: 24px;
      }
    }
  </style>

  <AboutPortraitPolish />
  <AboutAxisMotion />

  <main id="main-content" tabindex="-1" class="main-container about-page-shell">
    <a class="about-page-back" href={t.homeHref}>{t.back}</a>
    <AboutPortraitSection lang={lang} />
  </main>

  <NightModeToggle lang={lang} />
</BaseLayout>
