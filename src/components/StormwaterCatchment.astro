---
interface Props {
  class?: string;
  autoRotate?: boolean;
  rain?: boolean;
  enableZoom?: boolean;
}

const {
  class: className,
  autoRotate = true,
  rain = true,
  enableZoom = true,
} = Astro.props;
---

<div
  class:list={['stormwater-catchment', className]}
  data-stormwater-catchment
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-rain={rain ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  aria-hidden="true"
>
  <canvas
    class="stormwater-catchment__canvas"
    data-stormwater-catchment-canvas
  ></canvas>
</div>

<style>
  .stormwater-catchment {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 280px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .stormwater-catchment:active {
    cursor: grabbing;
  }

  .stormwater-catchment__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-stormwater-catchment]');

    roots.forEach(async (root) => {
      if (root.dataset.stormwaterCatchmentInitialized === 'true') return;
      root.dataset.stormwaterCatchmentInitialized = 'true';

      const canvas = root.querySelector('[data-stormwater-catchment-canvas]');
      if (!canvas) return;

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        );

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const wantsAutoRotate = root.dataset.autoRotate !== 'false';
        const wantsRain = root.dataset.rain !== 'false';
        const wantsZoom = root.dataset.enableZoom !== 'false';

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        });

        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
        renderer.setClearColor(0xffffff, 0);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
        camera.position.set(4.8, 3.5, 6.2);

        const system = new THREE.Group();
        system.rotation.z = -0.035;
        scene.add(system);

        const controls = new OrbitControls(camera, renderer.domElement);
        controls.enablePan = false;
        controls.enableZoom = wantsZoom;
        controls.minDistance = 5.7;
        controls.maxDistance = 9.6;
        controls.zoomSpeed = 0.55;
        controls.enableDamping = true;
        controls.dampingFactor = 0.055;
        controls.rotateSpeed = 0.52;
        controls.minPolarAngle = Math.PI * 0.22;
        controls.maxPolarAngle = Math.PI * 0.7;
        controls.target.set(0, 0.08, 0);
        controls.autoRotate = wantsAutoRotate && !reducedMotion;
        controls.autoRotateSpeed = 0.28;

        const terrainMaterial = new THREE.PointsMaterial({
          color: 0x353832,
          size: 0.024,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.68,
        });

        const contourMaterial = new THREE.LineBasicMaterial({
          color: 0x697168,
          transparent: true,
          opacity: 0.3,
        });

        const contextMaterial = new THREE.LineBasicMaterial({
          color: 0x7c8279,
          transparent: true,
          opacity: 0.22,
        });

        const rainMaterial = new THREE.PointsMaterial({
          color: 0x899b99,
          size: 0.028,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.48,
        });

        const flowMaterial = new THREE.PointsMaterial({
          color: 0x819491,
          size: 0.041,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.8,
        });

        const basinMaterial = new THREE.PointsMaterial({
          color: 0x91a19e,
          size: 0.033,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.64,
        });

        const overflowMaterial = new THREE.PointsMaterial({
          color: 0xa0aeaa,
          size: 0.044,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.8,
        });

        const terrainGroup = new THREE.Group();
        const contextGroup = new THREE.Group();
        const rainGroup = new THREE.Group();
        const flowGroup = new THREE.Group();
        const basinGroup = new THREE.Group();

        system.add(
          terrainGroup,
          contextGroup,
          rainGroup,
          flowGroup,
          basinGroup
        );

        const hash = (value, salt = 0) => {
          const x = Math.sin(value * 127.1 + salt * 311.7) * 43758.5453123;
          return x - Math.floor(x);
        };

        const terrainWidth = 4.5;
        const terrainDepth = 3.4;
        const columns = 88;
        const rows = 64;

        const terrainHeight = (x, z) => {
          const basin =
            -0.28 *
            Math.exp(-((x - 0.1) ** 2 * 4.4 + (z + 0.08) ** 2 * 6.2));

          const upperWest =
            0.34 *
            Math.exp(-((x + 1.4) ** 2 * 1.8 + (z - 0.9) ** 2 * 3));

          const upperEast =
            0.22 *
            Math.exp(-((x - 1.2) ** 2 * 2.4 + (z - 1.0) ** 2 * 2.8));

          const shoulder =
            0.16 *
            Math.exp(-((x + 0.4) ** 2 * 3.2 + (z - 0.2) ** 2 * 4.1));

          const outlet =
            -0.18 *
            Math.exp(-((x - 1.65) ** 2 * 4.7 + (z + 0.95) ** 2 * 3.4));

          const softForm =
            0.022 * Math.sin(x * 2.3 + z * 1.5) +
            0.018 * Math.cos(z * 2.1 - x * 0.7);

          return basin + upperWest + upperEast + shoulder + outlet + softForm;
        };

        const terrainPositions = [];

        for (let zi = 0; zi <= rows; zi += 1) {
          for (let xi = 0; xi <= columns; xi += 1) {
            const x = THREE.MathUtils.lerp(
              -terrainWidth / 2,
              terrainWidth / 2,
              xi / columns
            );
            const z = THREE.MathUtils.lerp(
              -terrainDepth / 2,
              terrainDepth / 2,
              zi / rows
            );
            const y = terrainHeight(x, z);
            terrainPositions.push(x, y, z);
          }
        }

        const terrainGeometry = new THREE.BufferGeometry();
        terrainGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(terrainPositions, 3)
        );
        terrainGroup.add(new THREE.Points(terrainGeometry, terrainMaterial));

        const makeLine = (points, material) => {
          const geometry = new THREE.BufferGeometry().setFromPoints(points);
          return new THREE.Line(geometry, material);
        };

        const contourLines = [];
        const contourOffsets = [-0.52, -0.14, 0.18, 0.48];

        contourOffsets.forEach((offset, lineIndex) => {
          const points = [];

          for (let i = 0; i <= 120; i += 1) {
            const t = i / 120;
            const x = THREE.MathUtils.lerp(-2, 2, t);
            const z =
              offset +
              0.12 * Math.sin(t * Math.PI * 1.7 + lineIndex * 0.8) +
              0.04 * Math.cos(t * Math.PI * 4.6 + lineIndex);
            const y = terrainHeight(x, z) + 0.018;
            points.push(new THREE.Vector3(x, y, z));
          }

          const line = makeLine(points, contourMaterial);
          contourLines.push(line);
          terrainGroup.add(line);
        });

        const catchmentEdge = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-2.05, terrainHeight(-2.05, 1.3) + 0.02, 1.3),
          new THREE.Vector3(-1.5, terrainHeight(-1.5, 1.55) + 0.02, 1.55),
          new THREE.Vector3(-0.45, terrainHeight(-0.45, 1.62) + 0.02, 1.62),
          new THREE.Vector3(0.85, terrainHeight(0.85, 1.55) + 0.02, 1.55),
          new THREE.Vector3(2.03, terrainHeight(2.03, 1.2) + 0.02, 1.2),
          new THREE.Vector3(2.1, terrainHeight(2.1, -0.8) + 0.02, -0.8),
          new THREE.Vector3(1.35, terrainHeight(1.35, -1.42) + 0.02, -1.42),
          new THREE.Vector3(-0.25, terrainHeight(-0.25, -1.52) + 0.02, -1.52),
          new THREE.Vector3(-1.75, terrainHeight(-1.75, -1.15) + 0.02, -1.15),
          new THREE.Vector3(-2.05, terrainHeight(-2.05, 1.3) + 0.02, 1.3),
        ], true);

        const catchmentEdgeLine = makeLine(
          catchmentEdge.getPoints(110),
          contextMaterial
        );
        contextGroup.add(catchmentEdgeLine);

        const flowCurves = [
          new THREE.CatmullRomCurve3([
            new THREE.Vector3(-1.7, terrainHeight(-1.7, 1.2) + 0.07, 1.2),
            new THREE.Vector3(-1.15, terrainHeight(-1.15, 0.72) + 0.055, 0.72),
            new THREE.Vector3(-0.55, terrainHeight(-0.55, 0.3) + 0.045, 0.3),
            new THREE.Vector3(0.05, terrainHeight(0.05, 0.02) + 0.04, 0.02),
          ]),
          new THREE.CatmullRomCurve3([
            new THREE.Vector3(1.35, terrainHeight(1.35, 1.06) + 0.07, 1.06),
            new THREE.Vector3(0.88, terrainHeight(0.88, 0.64) + 0.055, 0.64),
            new THREE.Vector3(0.48, terrainHeight(0.48, 0.26) + 0.045, 0.26),
            new THREE.Vector3(0.08, terrainHeight(0.08, 0.04) + 0.04, 0.04),
          ]),
          new THREE.CatmullRomCurve3([
            new THREE.Vector3(-0.9, terrainHeight(-0.9, 1.46) + 0.07, 1.46),
            new THREE.Vector3(-0.52, terrainHeight(-0.52, 0.88) + 0.055, 0.88),
            new THREE.Vector3(-0.2, terrainHeight(-0.2, 0.42) + 0.045, 0.42),
            new THREE.Vector3(0.03, terrainHeight(0.03, 0.08) + 0.04, 0.08),
          ]),
        ];

        const overflowCurve = new THREE.CatmullRomCurve3([
          new THREE.Vector3(0.08, terrainHeight(0.08, 0.04) + 0.05, 0.04),
          new THREE.Vector3(0.58, terrainHeight(0.58, -0.18) + 0.055, -0.18),
          new THREE.Vector3(1.18, terrainHeight(1.18, -0.46) + 0.065, -0.46),
          new THREE.Vector3(1.95, terrainHeight(1.95, -0.86) + 0.075, -0.86),
        ]);

        const flowSets = [];
        const flowGeometries = [];

        flowCurves.forEach((curve, curveIndex) => {
          const count = 22;
          const positions = new Float32Array(count * 3);
          const geometry = new THREE.BufferGeometry();
          geometry.setAttribute(
            'position',
            new THREE.BufferAttribute(positions, 3)
          );
          flowGeometries.push(geometry);

          const offsets = Array.from(
            { length: count },
            (_, i) => i / count + curveIndex * 0.11
          );

          flowGroup.add(new THREE.Points(geometry, flowMaterial));
          flowSets.push({
            curve,
            offsets,
            positions,
            geometry,
            speed: 0.085 + curveIndex * 0.012,
          });
        });

        const overflowCount = 18;
        const overflowPositions = new Float32Array(overflowCount * 3);
        const overflowGeometry = new THREE.BufferGeometry();
        overflowGeometry.setAttribute(
          'position',
          new THREE.BufferAttribute(overflowPositions, 3)
        );
        const overflowOffsets = Array.from(
          { length: overflowCount },
          (_, i) => i / overflowCount
        );
        const overflowPoints = new THREE.Points(
          overflowGeometry,
          overflowMaterial
        );
        flowGroup.add(overflowPoints);

        const basinBasePoints = [];
        const basinRows = 15;
        const basinSteps = 42;

        for (let ri = 0; ri <= basinRows; ri += 1) {
          const radiusFactor = ri / basinRows;

          for (let ai = 0; ai < basinSteps; ai += 1) {
            const angle = (ai / basinSteps) * Math.PI * 2;
            basinBasePoints.push([
              Math.cos(angle) * 0.55 * radiusFactor,
              Math.sin(angle) * 0.42 * radiusFactor,
            ]);
          }
        }

        const basinPositions = new Float32Array(basinBasePoints.length * 3);
        const basinGeometry = new THREE.BufferGeometry();
        basinGeometry.setAttribute(
          'position',
          new THREE.BufferAttribute(basinPositions, 3)
        );
        basinGroup.add(new THREE.Points(basinGeometry, basinMaterial));

        const updateBasin = (level) => {
          const yBase = terrainHeight(0.08, 0.04) + 0.015;

          basinBasePoints.forEach(([x, z], index) => {
            basinPositions[index * 3] = 0.08 + x;
            basinPositions[index * 3 + 1] = yBase + level;
            basinPositions[index * 3 + 2] = 0.02 + z;
          });

          basinGeometry.attributes.position.needsUpdate = true;
        };

        const rainCount = 230;
        const rainState = [];
        const rainPositions = new Float32Array(rainCount * 3);
        const rainGeometry = new THREE.BufferGeometry();
        rainGeometry.setAttribute(
          'position',
          new THREE.BufferAttribute(rainPositions, 3)
        );
        const rainPoints = new THREE.Points(rainGeometry, rainMaterial);
        rainGroup.add(rainPoints);
        rainGroup.visible = wantsRain;

        for (let i = 0; i < rainCount; i += 1) {
          rainState.push({
            x: THREE.MathUtils.lerp(-2.1, 2.1, hash(i + 1, 11)),
            y: 1.55 + hash(i + 1, 13) * 1.35,
            z: THREE.MathUtils.lerp(-1.55, 1.55, hash(i + 1, 12)),
            speed: 0.018 + hash(i + 1, 14) * 0.02,
          });
        }

        const updateRain = (time) => {
          for (let i = 0; i < rainCount; i += 1) {
            const drop = rainState[i];
            drop.y -= drop.speed;

            const ground = terrainHeight(drop.x, drop.z) + 0.05;

            if (drop.y < ground) {
              const seed = i + time * 0.0001;
              drop.x = THREE.MathUtils.lerp(-2.1, 2.1, hash(seed, 15));
              drop.z = THREE.MathUtils.lerp(-1.55, 1.55, hash(seed, 16));
              drop.y = 1.55 + hash(seed, 17) * 1.35;
            }

            rainPositions[i * 3] = drop.x;
            rainPositions[i * 3 + 1] = drop.y;
            rainPositions[i * 3 + 2] = drop.z;
          }

          rainGeometry.attributes.position.needsUpdate = true;
        };

        const updateFlows = (timeSeconds, overflowPhase) => {
          flowSets.forEach((set) => {
            set.offsets.forEach((offset, index) => {
              const t = (timeSeconds * set.speed + offset) % 1;
              const point = set.curve.getPointAt(t);

              set.positions[index * 3] = point.x;
              set.positions[index * 3 + 1] = point.y;
              set.positions[index * 3 + 2] = point.z;
            });

            set.geometry.attributes.position.needsUpdate = true;
          });

          overflowOffsets.forEach((offset, index) => {
            const t = (timeSeconds * 0.13 + offset) % 1;
            const point = overflowCurve.getPointAt(t);

            overflowPositions[index * 3] = point.x;
            overflowPositions[index * 3 + 1] = point.y;
            overflowPositions[index * 3 + 2] = point.z;
          });

          overflowGeometry.attributes.position.needsUpdate = true;
          overflowPoints.visible = overflowPhase > 0.1;
          overflowMaterial.opacity = 0.18 + overflowPhase * 0.62;
        };

        const resize = () => {
          const rect = root.getBoundingClientRect();
          const width = Math.max(1, Math.round(rect.width));
          const height = Math.max(1, Math.round(rect.height));

          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(root);
        resize();

        let isVisible = true;
        let isDocumentVisible = !document.hidden;
        let animationFrame = 0;

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting);
          },
          { rootMargin: '160px' }
        );
        intersectionObserver.observe(root);

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden;
        };
        document.addEventListener('visibilitychange', handleVisibility);

        const animate = (time) => {
          animationFrame = requestAnimationFrame(animate);
          if (!isVisible || !isDocumentVisible) return;

          controls.update();

          const seconds = time * 0.001;
          const storageCycle = reducedMotion
            ? 0.42
            : 0.5 + 0.5 * Math.sin(seconds * 0.42);
          const stormCycle = reducedMotion
            ? 0.35
            : 0.5 + 0.5 * Math.sin(seconds * 0.21 - 0.8);
          const basinLevel = THREE.MathUtils.lerp(0.02, 0.16, storageCycle);
          const overflowPhase = Math.max(0, (stormCycle - 0.58) / 0.42);

          if (wantsRain && !reducedMotion) {
            updateRain(time);
          }

          updateFlows(seconds, overflowPhase);
          updateBasin(basinLevel);

          system.position.y = reducedMotion
            ? 0
            : 0.012 * Math.sin(seconds * 0.32);

          renderer.render(scene, camera);
        };

        updateRain(0);
        updateBasin(0.06);
        updateFlows(0, 0);
        animationFrame = requestAnimationFrame(animate);

        const cleanup = () => {
          cancelAnimationFrame(animationFrame);
          document.removeEventListener('visibilitychange', handleVisibility);
          resizeObserver.disconnect();
          intersectionObserver.disconnect();
          controls.dispose();

          terrainGeometry.dispose();
          contourLines.forEach((line) => line.geometry.dispose());
          catchmentEdgeLine.geometry.dispose();
          flowGeometries.forEach((geometry) => geometry.dispose());
          overflowGeometry.dispose();
          basinGeometry.dispose();
          rainGeometry.dispose();

          terrainMaterial.dispose();
          contourMaterial.dispose();
          contextMaterial.dispose();
          rainMaterial.dispose();
          flowMaterial.dispose();
          basinMaterial.dispose();
          overflowMaterial.dispose();
          renderer.dispose();
        };

        window.addEventListener('pagehide', cleanup, { once: true });
      } catch (error) {
        console.error('StormwaterCatchment failed to initialize:', error);
      }
    });
  })();
</script>
