<div
  class="homepage-title-ruler"
  data-homepage-title-ruler
  aria-hidden="true"
>
  <span class="homepage-title-ruler__line"></span>
  <span class="homepage-title-ruler__label" data-title-ruler-label>X / 000 px</span>
</div>

<div
  class="homepage-topography-readout"
  data-homepage-topography-readout
  aria-hidden="true"
>
  <span class="homepage-topography-readout__cross"></span>
  <span class="homepage-topography-readout__label" data-topography-readout-label>
    X +0.00 / Y +0.00 / Z +0.00
  </span>
</div>

<div
  class="homepage-selection-note"
  data-homepage-selection-note
  aria-hidden="true"
>
  FIELD NOTE / <span data-selection-count>0</span> CHARS
</div>

<style>
  .homepage-title-ruler {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 42;
    width: 1px;
    height: 20px;
    pointer-events: none;
    opacity: 0;
    color: var(--moss);
    transform: translateY(-2px);
    transition:
      opacity 120ms ease,
      transform 120ms ease;
  }

  .homepage-title-ruler.is-visible {
    opacity: 0.72;
    transform: translateY(0);
  }

  .homepage-title-ruler__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 7px;
    height: 8px;
    border-top: 1px solid currentColor;
    background-image: repeating-linear-gradient(
      90deg,
      currentColor 0,
      currentColor 1px,
      transparent 1px,
      transparent 50px
    );
    background-repeat: repeat-x;
    background-position: left top;
    opacity: 0.28;
  }

  .homepage-title-ruler__line::before,
  .homepage-title-ruler__line::after {
    content: '';
    position: absolute;
    top: -3px;
    width: 1px;
    height: 8px;
    background: currentColor;
  }

  .homepage-title-ruler__line::before {
    left: 0;
  }

  .homepage-title-ruler__line::after {
    right: 0;
  }

  .homepage-title-ruler__label {
    position: absolute;
    right: 0;
    top: 14px;
    color: var(--moss-deep);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.47rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.05em;
    white-space: nowrap;
    transform: translateX(50%);
  }

  .homepage-topography-readout {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 63;
    width: 18px;
    height: 18px;
    pointer-events: none;
    opacity: 0;
    color: var(--moss-deep);
    transform: translate(-9px, -9px);
    transition: opacity 90ms ease;
  }

  .homepage-topography-readout.is-visible {
    opacity: 0.84;
  }

  .homepage-topography-readout__cross::before,
  .homepage-topography-readout__cross::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .homepage-topography-readout__cross::before {
    width: 18px;
    height: 1px;
  }

  .homepage-topography-readout__cross::after {
    width: 1px;
    height: 18px;
  }

  .homepage-topography-readout__label {
    position: absolute;
    left: 15px;
    top: 12px;
    padding: 3px 5px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--line-soft);
    color: var(--moss-deep);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.47rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .homepage-selection-note {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 64;
    padding: 4px 6px;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid var(--line-soft);
    color: var(--moss-deep);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.5rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.06em;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(3px);
    transition:
      opacity 120ms ease,
      transform 120ms ease;
  }

  .homepage-selection-note.is-visible {
    opacity: 0.82;
    transform: translateY(0);
  }

  @media (max-width: 640px), (hover: none), (pointer: coarse) {
    .homepage-title-ruler,
    .homepage-topography-readout {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-title-ruler,
    .homepage-topography-readout,
    .homepage-selection-note {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const title = document.querySelector('.hero h1')
    const heroArt = document.querySelector('.hero-art--interactive')
    const topographyRoot = heroArt?.querySelector('[data-morphing-topography]')
    const topographyCanvas = topographyRoot?.querySelector('canvas')
    const ruler = document.querySelector('[data-homepage-title-ruler]')
    const rulerLabel = document.querySelector('[data-title-ruler-label]')
    const topographyReadout = document.querySelector('[data-homepage-topography-readout]')
    const topographyReadoutLabel = document.querySelector('[data-topography-readout-label]')
    const selectionNote = document.querySelector('[data-homepage-selection-note]')
    const selectionCount = document.querySelector('[data-selection-count]')

    if (
      !title ||
      !heroArt ||
      !topographyRoot ||
      !topographyCanvas ||
      !ruler ||
      !topographyReadout ||
      !selectionNote
    ) return

    if (ruler.dataset.passiveEasterEggsInitialized === 'true') return
    ruler.dataset.passiveEasterEggsInitialized = 'true'

    let selectionTimer = 0
    let titlePointerX = null
    let topographyPointerInside = false

    const getTitleInkRect = () => {
      const range = document.createRange()
      range.selectNodeContents(title)
      const rect = range.getBoundingClientRect()
      range.detach?.()
      return rect
    }

    const updateRuler = (clientX) => {
      const inkRect = getTitleInkRect()
      const x = Math.max(inkRect.left, Math.min(inkRect.right, clientX))
      const distance = Math.max(0, x - inkRect.left)

      ruler.style.left = `${Math.round(inkRect.left)}px`
      ruler.style.top = `${Math.round(inkRect.bottom + 6)}px`
      ruler.style.width = `${Math.max(1, Math.round(distance))}px`

      if (rulerLabel) {
        rulerLabel.textContent = `X / ${Math.round(distance)} px`
      }
    }

    const showRuler = (event) => {
      titlePointerX = event.clientX
      updateRuler(titlePointerX)
      ruler.classList.add('is-visible')
    }

    const moveRuler = (event) => {
      titlePointerX = event.clientX
      updateRuler(titlePointerX)
    }

    const hideRuler = () => {
      titlePointerX = null
      ruler.classList.remove('is-visible')
    }

    const isNearVisibleTopography = (event) => {
      const rect = topographyRoot.getBoundingClientRect()
      const centerX = rect.left + rect.width * 0.5
      const centerY = rect.top + rect.height * 0.5
      const radiusX = rect.width * 0.34
      const radiusY = rect.height * 0.31
      const nx = (event.clientX - centerX) / Math.max(1, radiusX)
      const ny = (event.clientY - centerY) / Math.max(1, radiusY)

      return nx * nx + ny * ny <= 1
    }

    const estimateTopographyHeight = (normalizedX, normalizedY) => {
      const phase = performance.now() * 0.001
      const x = normalizedX * 1.85
      const z = normalizedY * 1.45

      const ridgeAmplitude = 0.66 + 0.12 * Math.sin(phase * 0.55)
      const ridgeX = -0.48 + 0.16 * Math.sin(phase * 0.34)
      const ridgeZ = 0.03 + 0.09 * Math.cos(phase * 0.28)
      const ridge = ridgeAmplitude * Math.exp(
        -((x - ridgeX) ** 2 * 1.25 + (z - ridgeZ) ** 2 * 2.5)
      )

      const shoulder =
        (0.24 + 0.06 * Math.cos(phase * 0.4)) *
        Math.exp(-((x - 0.77) ** 2 * 2.7 + (z - 0.42) ** 2 * 3.8))

      const basinX = 0.34 + 0.12 * Math.sin(phase * 0.31 + 1.2)
      const basinZ = -0.34 + 0.08 * Math.cos(phase * 0.36 + 0.7)
      const basinAmplitude =
        -0.17 - 0.06 * (0.5 + 0.5 * Math.sin(phase * 0.52 + 0.5))
      const basin = basinAmplitude * Math.exp(
        -((x - basinX) ** 2 * 6 + (z - basinZ) ** 2 * 7)
      )

      const channelCenter =
        -0.2 +
        0.12 * Math.sin(x * 1.6 + phase * 0.32) +
        0.025 * Math.sin(x * 3.1 - phase * 0.18)
      const channel = -0.05 * Math.exp(-((z - channelCenter) ** 2) * 82)

      const broadForm =
        0.03 * Math.sin(x * 1.15 + z * 0.6 + phase * 0.15) +
        0.022 * Math.cos(z * 1.8 - x * 0.32 - phase * 0.13)

      return ridge + shoulder + basin + channel + broadForm
    }

    const updateTopographyReadout = (event) => {
      const rect = topographyRoot.getBoundingClientRect()
      const normalizedX = ((event.clientX - rect.left) / Math.max(1, rect.width)) * 2 - 1
      const normalizedY = 1 - ((event.clientY - rect.top) / Math.max(1, rect.height)) * 2
      const height = estimateTopographyHeight(normalizedX, normalizedY)

      topographyReadout.style.left = `${event.clientX}px`
      topographyReadout.style.top = `${event.clientY}px`

      if (topographyReadoutLabel) {
        const x = `${normalizedX >= 0 ? '+' : ''}${normalizedX.toFixed(2)}`
        const y = `${normalizedY >= 0 ? '+' : ''}${normalizedY.toFixed(2)}`
        const z = `${height >= 0 ? '+' : ''}${height.toFixed(2)}`
        topographyReadoutLabel.textContent = `X ${x} / Y ${y} / Z ${z}`
      }
    }

    const setTopographyPointerState = (inside, event) => {
      topographyPointerInside = inside

      if (!inside) {
        topographyReadout.classList.remove('is-visible')
        topographyRoot.style.cursor = 'default'
        topographyCanvas.style.cursor = 'default'
        return
      }

      if (event) updateTopographyReadout(event)
      topographyReadout.classList.add('is-visible')

      topographyRoot.style.cursor = 'none'
      topographyCanvas.style.cursor = 'none'
    }

    const handleTopographyPointerMove = (event) => {
      const inside = isNearVisibleTopography(event)
      setTopographyPointerState(inside, event)
    }

    const handleTopographyPointerDown = (event) => {
      if (!isNearVisibleTopography(event)) return
      setTopographyPointerState(true, event)
    }

    const handleTopographyPointerUp = (event) => {
      setTopographyPointerState(isNearVisibleTopography(event), event)
    }

    const hideTopographyReadout = () => {
      setTopographyPointerState(false)
    }

    const hideSelectionNote = () => {
      window.clearTimeout(selectionTimer)
      selectionNote.classList.remove('is-visible')
    }

    const showSelectionNote = () => {
      const selection = window.getSelection()
      if (!selection || selection.isCollapsed) {
        hideSelectionNote()
        return
      }

      const text = selection.toString().trim()
      if (text.length < 4) {
        hideSelectionNote()
        return
      }

      const anchorNode = selection.anchorNode
      const focusNode = selection.focusNode
      const anchorElement = anchorNode instanceof Element
        ? anchorNode
        : anchorNode?.parentElement
      const focusElement = focusNode instanceof Element
        ? focusNode
        : focusNode?.parentElement

      const insideArticle = Boolean(
        anchorElement?.closest('.feed-post') &&
        focusElement?.closest('.feed-post')
      )

      if (!insideArticle || selection.rangeCount === 0) {
        hideSelectionNote()
        return
      }

      const range = selection.getRangeAt(0)
      const rect = range.getBoundingClientRect()
      if (!rect.width && !rect.height) {
        hideSelectionNote()
        return
      }

      if (selectionCount) selectionCount.textContent = String(text.length)

      const noteWidth = 154
      const left = Math.max(
        10,
        Math.min(window.innerWidth - noteWidth - 10, rect.right + 9)
      )
      const top = Math.max(72, rect.top - 2)

      selectionNote.style.left = `${Math.round(left)}px`
      selectionNote.style.top = `${Math.round(top)}px`
      selectionNote.classList.add('is-visible')

      window.clearTimeout(selectionTimer)
      selectionTimer = window.setTimeout(hideSelectionNote, 2600)
    }

    const handleSelectionChange = () => {
      window.clearTimeout(selectionTimer)
      selectionTimer = window.setTimeout(showSelectionNote, 80)
    }

    topographyRoot.style.cursor = 'default'
    topographyCanvas.style.cursor = 'default'

    title.addEventListener('pointerenter', showRuler)
    title.addEventListener('pointermove', moveRuler, { passive: true })
    title.addEventListener('pointerleave', hideRuler)

    topographyRoot.addEventListener('pointermove', handleTopographyPointerMove, { passive: true })
    topographyRoot.addEventListener('pointerdown', handleTopographyPointerDown)
    topographyRoot.addEventListener('pointerup', handleTopographyPointerUp)
    topographyRoot.addEventListener('pointercancel', hideTopographyReadout)
    topographyRoot.addEventListener('pointerleave', hideTopographyReadout)

    document.addEventListener('selectionchange', handleSelectionChange)
    window.addEventListener(
      'resize',
      () => {
        if (titlePointerX !== null) updateRuler(titlePointerX)
        if (!topographyPointerInside) {
          topographyRoot.style.cursor = 'default'
          topographyCanvas.style.cursor = 'default'
        }
      },
      { passive: true }
    )
    window.addEventListener('scroll', hideSelectionNote, { passive: true })

    window.addEventListener(
      'pagehide',
      () => {
        window.clearTimeout(selectionTimer)
        title.removeEventListener('pointerenter', showRuler)
        title.removeEventListener('pointermove', moveRuler)
        title.removeEventListener('pointerleave', hideRuler)
        topographyRoot.removeEventListener('pointermove', handleTopographyPointerMove)
        topographyRoot.removeEventListener('pointerdown', handleTopographyPointerDown)
        topographyRoot.removeEventListener('pointerup', handleTopographyPointerUp)
        topographyRoot.removeEventListener('pointercancel', hideTopographyReadout)
        topographyRoot.removeEventListener('pointerleave', hideTopographyReadout)
        document.removeEventListener('selectionchange', handleSelectionChange)
        window.removeEventListener('scroll', hideSelectionNote)
      },
      { once: true }
    )
  })()
</script>
