---
import '../styles/global.css';

import Analytics from './Analytics.astro';
import FeedPost from './FeedPost.astro';
import SiteHeader from './SiteHeader.astro';
import MorphingTopography from './MorphingTopography.astro';

import {
  site,
  type SiteLanguage,
} from '../config/site';

import {
  getPostSlug,
  getPublishedPosts,
} from '../utils/posts';

interface Props {
  lang: SiteLanguage;
}

const { lang } = Astro.props;

const content = {
  fi: {
    pageTitle:
      'Aapo Pihkala - Maisema-arkkitehti Espoo',

    pageDescription:
      'Aapo Pihkala on Espoossa toimiva maisema-arkkitehti. Maisema-arkkitehtuuria kaupunkien, ihmisten ja luonnon rajapinnassa.',

    heroPrimary:
      'Maisema-arkkitehti.',

    heroSecondary:
      'Maisema-arkkitehtuuria kaupunkien, ihmisten ja luonnon rajapinnassa.',

    location:
      'Espoo, Suomi',

    perspectiveLabel:
      'Näkökulma',

    sourceLabel:
      'Lähde',
  },

  en: {
    pageTitle:
      'Aapo Pihkala - Landscape Architect, Espoo',

    pageDescription:
      'Aapo Pihkala is a landscape architect based in Espoo, Finland. Landscape architecture at the intersection of cities, people and nature.',

    heroPrimary:
      'Landscape architect.',

    heroSecondary:
      'Landscape architecture at the intersection of cities, people and nature.',

    location:
      'Espoo, Finland',

    perspectiveLabel:
      'Perspective',

    sourceLabel:
      'Source',
  },
} as const;

const t =
  content[lang];

const currentLanguage =
  site.languages[lang];

const alternateLanguage =
  lang === 'fi'
    ? site.languages.en
    : site.languages.fi;

const posts =
  await getPublishedPosts();

const dateFormatter =
  new Intl.DateTimeFormat(
    currentLanguage.locale,
    lang === 'fi'
      ? {
          day: 'numeric',
          month: 'numeric',
          year: 'numeric',
        }
      : {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        }
  );

const getDisplayDate = (
  publishedAt: string
) => {
  const datePart =
    publishedAt.slice(
      0,
      10
    );

  return dateFormatter.format(
    new Date(
      `${datePart}T12:00:00`
    )
  );
};

const canonicalUrl =
  `${site.url}${currentLanguage.homePath}`;

const finnishUrl =
  `${site.url}${site.languages.fi.homePath}`;

const englishUrl =
  `${site.url}${site.languages.en.homePath}`;

const personSchema = {
  '@context':
    'https://schema.org',

  '@type':
    'Person',

  name:
    site.name,

  url:
    canonicalUrl,

  jobTitle:
    lang === 'fi'
      ? 'Maisema-arkkitehti'
      : 'Landscape Architect',

  homeLocation: {
    '@type':
      'Place',

    name:
      lang === 'fi'
        ? 'Espoo, Suomi'
        : 'Espoo, Finland',
  },

  sameAs: [
    site.linkedinUrl,
  ],

  knowsAbout: [
    'Landscape architecture',
    'Urban planning',
    'Urban nature',
    'Stormwater management',
    'Biodiversity',
  ],
};
---

<!doctype html>

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.pageTitle}</title>
    <meta name="description" content={t.pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="fi" href={finnishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={finnishUrl} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <style>
      .hero {
        min-height: calc(100svh - 64px);
        padding: 0;
        display: flex;
        align-items: center;
      }

      .hero-row {
        width: 100%;
        transform: translateY(clamp(14px, 3vh, 28px));
      }

      .location-icon {
        opacity: 1;
        animation: location-cursor-pulse 7.5s linear infinite;
      }

      @keyframes location-cursor-pulse {
        0%,
        33.333% {
          opacity: 1;
        }

        66.667% {
          opacity: 0.08;
        }

        100% {
          opacity: 1;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .location-icon {
          animation: none;
          opacity: 0.58;
        }
      }

      @media (max-width: 800px) {
        .hero {
          min-height: calc(100svh - 64px);
          padding: 0;
        }

        .hero-row {
          transform: translateY(clamp(12px, 2.4vh, 22px));
        }
      }

      @media (max-width: 640px) {
        .hero {
          min-height: calc(100svh - 64px);
          padding: 0;
        }

        .hero-row {
          transform: translateY(12px);
        }
      }
    </style>
  </head>

  <body>
    <SiteHeader
      lang={lang}
      languageHref={alternateLanguage.homePath}
    />

    <main class="main-container">
      <section class="hero">
        <div class="hero-row">
          <div class="hero-content">
            <h1>{site.name}</h1>

            <div class="hero-description">
              <p class="hero-primary">{t.heroPrimary}</p>
              <p class="hero-secondary">{t.heroSecondary}</p>
            </div>

            <p class="hero-location">
              <svg
                class="location-icon"
                viewBox="0 0 16 19"
                aria-hidden="true"
              >
                <line x1="8" y1="1.8" x2="8" y2="5.2" />
                <line x1="8" y1="13.8" x2="8" y2="17.2" />
                <line x1="1.7" y1="9.5" x2="5" y2="9.5" />
                <line x1="11" y1="9.5" x2="14.3" y2="9.5" />
                <circle
                  cx="8"
                  cy="9.5"
                  r="0.82"
                  fill="var(--moss)"
                  stroke="none"
                />
              </svg>

              <span>{t.location}</span>
            </p>

            <a
              class="hero-linkedin"
              href={site.linkedinUrl}
              target="_blank"
              rel="noopener"
            >
              <span>LinkedIn</span>
              <span class="hero-linkedin-arrow" aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="hero-art hero-art--interactive">
            <MorphingTopography enableZoom={false} />
          </div>
        </div>
      </section>

      <section class="feed">
        {
          posts.map((post, index) => {
            const publishedAt = post.data.publishedAt;
            const postNumber = String(posts.length - index).padStart(2, '0');
            const slug = getPostSlug(post.id);
            const titleHref =
              lang === 'fi'
                ? `/artikkelit/${slug}/`
                : `/en/articles/${slug}/`;

            return (
              <FeedPost
                post={post}
                lang={lang}
                postNumber={postNumber}
                displayDate={getDisplayDate(publishedAt)}
                perspectiveLabel={t.perspectiveLabel}
                sourceLabel={t.sourceLabel}
                titleHref={titleHref}
              />
            );
          })
        }
      </section>
    </main>

    <Analytics lang={lang} />
  </body>
</html>
