    languageButton: 'EN',
    languageLabel: 'English',
    languageHref: '/en/',
    languageHreflang: 'en',

    heroPrimary: 'Maisema-arkkitehti, Espoo.',
    heroSecondary:
      'Maisema-arkkitehtuuria kaupunkien, ihmisten ja luonnon rajapinnassa.',

    linkedinLabel: 'LinkedIn',

    posts: [
      {
