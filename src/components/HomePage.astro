  en: {
    pageTitle: 'Aapo Pihkala - Landscape Architect, Espoo',
    pageDescription:
      'Aapo Pihkala is a landscape architect based in Espoo, Finland. Landscape architecture at the intersection of cities, people and nature.',

    navLabel: 'Main navigation',
    homeLabel: 'Aapo Pihkala homepage',

    languageButton: 'FI',
    languageLabel: 'Suomeksi',
    languageHref: '/',
    languageHreflang: 'fi',

    heroPrimary: 'Landscape architect, Espoo.',
    heroSecondary:
      'Landscape architecture at the intersection of cities, people and nature.',

    linkedinLabel: 'LinkedIn',

    posts: [
      {
        index: '01',
        date: '30 Aug 2026',
        tags: ['URBAN NATURE', 'PLANNING'],
        title: 'Lorem ipsum dolor sit amet',
        paragraphs: [
          'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
          'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.',
        ],
        sourceLabel: 'Source',
        source: 'Lorem ipsum',
      },
      {
        index: '02',
        date: '24 Aug 2026',
        tags: ['STORMWATER', 'URBAN PLANNING'],
        title: 'Consectetur adipiscing elit',
        paragraphs: [
          'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.',
          'Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.',
        ],
