---
import '../styles/global.css';

import Analytics from './Analytics.astro';
import FeedPost from './FeedPost.astro';
import SiteHeader from './SiteHeader.astro';
import MorphingTopography from './MorphingTopography.astro';

import {
  site,
  type SiteLanguage,
} from '../config/site';

import {
  getPostSlug,
  getPublishedPosts,
} from '../utils/posts';

interface Props {
  lang: SiteLanguage;
}

const { lang } = Astro.props;

const content = {
  fi: {
    pageTitle:
      'Aapo Pihkala - Maisema-arkkitehti Espoo',

    pageDescription:
      'Aapo Pihkala on Espoossa toimiva maisema-arkkitehti. Maisema-arkkitehtuuria kaupunkien, ihmisten ja luonnon rajapinnassa.',

    heroPrimary:
      'Maisema-arkkitehti.',

    heroSecondary:
      'Maisema-arkkitehtuuria kaupunkien, ihmisten ja luonnon rajapinnassa.',

    location:
      'Espoo, Suomi',

    perspectiveLabel:
      'Näkökulma',

    sourceLabel:
      'Lähde',
  },

  en: {
    pageTitle:
      'Aapo Pihkala - Landscape Architect, Espoo',

    pageDescription:
      'Aapo Pihkala is a landscape architect based in Espoo, Finland. Landscape architecture at the intersection of cities, people and nature.',

    heroPrimary:
      'Landscape architect.',

    heroSecondary:
      'Landscape architecture at the intersection of cities, people and nature.',

    location:
      'Espoo, Finland',

    perspectiveLabel:
      'Perspective',

    sourceLabel:
      'Source',
  },
} as const;

const t =
  content[lang];

const currentLanguage =
  site.languages[lang];

const alternateLanguage =
  lang === 'fi'
    ? site.languages.en
    : site.languages.fi;

const posts =
  await getPublishedPosts();

const dateFormatter =
  new Intl.DateTimeFormat(
    currentLanguage.locale,
    lang === 'fi'
      ? {
          day: 'numeric',
          month: 'numeric',
          year: 'numeric',
        }
      : {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        }
  );

const getDisplayDate = (
  publishedAt: string
) => {
  const datePart =
    publishedAt.slice(
      0,
      10
    );

  return dateFormatter.format(
    new Date(
      `${datePart}T12:00:00`
    )
  );
};

const canonicalUrl =
  `${site.url}${currentLanguage.homePath}`;

const finnishUrl =
  `${site.url}${site.languages.fi.homePath}`;

const englishUrl =
  `${site.url}${site.languages.en.homePath}`;

const personSchema = {
  '@context':
    'https://schema.org',

  '@type':
    'Person',

  name:
    site.name,

  url:
    canonicalUrl,

  jobTitle:
    lang === 'fi'
      ? 'Maisema-arkkitehti'
      : 'Landscape Architect',

  homeLocation: {
    '@type':
      'Place',

    name:
      lang === 'fi'
        ? 'Espoo, Suomi'
        : 'Espoo, Finland',
  },

  sameAs: [
    site.linkedinUrl,
  ],

  knowsAbout: [
    'Landscape architecture',
    'Urban planning',
    'Urban nature',
    'Stormwater management',
    'Biodiversity',
  ],
};
---

<!doctype html>

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.pageTitle}</title>
    <meta name="description" content={t.pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="fi" href={finnishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={finnishUrl} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <style>
      .hero {
        min-height: calc(100svh - 64px);
        padding: 0;
        display: flex;
        align-items: center;
      }

      .hero-row {
        width: 100%;
        transform: translateY(clamp(14px, 3vh, 28px));
      }

      .location-icon {
        width: 18px;
        height: 18px;
        opacity: 1;
        visibility: visible;
        stroke: var(--moss-deep);
        stroke-width: 1;
        stroke-linecap: butt;
        stroke-linejoin: miter;
        transition: none !important;
        animation: none !important;
      }

      .hero-location-trigger {
        appearance: none;
        border: 0;
        padding: 0;
        background: transparent;
        font-family: inherit;
        text-align: left;
        cursor: pointer;
      }

      .hero-location-trigger:focus-visible {
        outline: 1px solid var(--lichen);
        outline-offset: 5px;
      }

      .hero-location-coordinate {
        display: inline-block;
        max-width: 0;
        overflow: hidden;
        white-space: nowrap;
        opacity: 0;
        color: var(--moss);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 0.56rem;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.07em;
        transform: translateX(-4px);
        transition:
          max-width 220ms ease,
          opacity 160ms ease,
          transform 220ms ease;
      }

      .hero-location-trigger.is-revealed .hero-location-coordinate {
        max-width: 190px;
        opacity: 0.72;
        transform: translateX(0);
      }

      .hero-linkedin-terminal {
        display: inline-flex;
        max-width: 0;
        min-width: 0;
        align-items: baseline;
        gap: 3px;
        overflow: hidden;
        white-space: nowrap;
        color: var(--moss);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 0.47rem;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        opacity: 0;
        transform: translateX(-5px);
        transition:
          max-width 320ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 90ms linear,
          transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .hero-linkedin-terminal.is-active {
        max-width: 190px;
        opacity: 0.76;
        transform: translateX(0);
      }

      .hero-linkedin-terminal__prompt {
        color: var(--stone-light);
      }

      .hero-linkedin-terminal__text {
        display: inline-block;
        min-width: 0;
      }

      .hero-linkedin-terminal__text.is-glitching {
        transform: translateX(1px);
        opacity: 0.58;
      }

      .hero-linkedin-terminal__cursor {
        display: inline-block;
        width: 0.62em;
        color: var(--moss-deep);
        opacity: 0;
      }

      .hero-linkedin-terminal__cursor.is-visible {
        animation: linkedin-terminal-cursor 1.13s steps(1, end) infinite;
      }

      @keyframes linkedin-terminal-cursor {
        0%, 34% { opacity: 0.86; }
        35%, 49% { opacity: 0; }
        50%, 83% { opacity: 0.86; }
        84%, 100% { opacity: 0; }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-location-coordinate,
        .hero-linkedin-terminal {
          transition: none;
        }

        .hero-linkedin-terminal__cursor.is-visible {
          animation: none;
          opacity: 0.72;
        }
      }

      @media (max-width: 800px) {
        .hero {
          min-height: calc(100svh - 64px);
          padding: 0;
        }

        .hero-row {
          transform: translateY(clamp(12px, 2.4vh, 22px));
        }
      }

      @media (max-width: 640px) {
        .hero {
          min-height: calc(100svh - 64px);
          padding: 0;
        }

        .hero-row {
          transform: translateY(12px);
        }
      }
    </style>
  </head>

  <body>
    <SiteHeader
      lang={lang}
      languageHref={alternateLanguage.homePath}
    />

    <main class="main-container">
      <section class="hero">
        <div class="hero-row">
          <div class="hero-content">
            <h1>{site.name}</h1>

            <div class="hero-description">
              <p class="hero-primary">{t.heroPrimary}</p>
              <p class="hero-secondary">{t.heroSecondary}</p>
            </div>

            <button
              class="hero-location hero-location-trigger"
              type="button"
              data-location-reveal
              aria-expanded="false"
              aria-label={
                lang === 'fi'
                  ? 'Näytä Espoon koordinaatit'
                  : 'Show Espoo coordinates'
              }
            >
              <svg
                class="location-icon"
                viewBox="0 0 18 18"
                aria-hidden="true"
              >
                <line x1="0" y1="9" x2="18" y2="9" />
                <line x1="9" y1="0" x2="9" y2="18" />
              </svg>

              <span>{t.location}</span>
              <span
                class="hero-location-coordinate"
                aria-hidden="true"
              >
                · 60.21° N / 24.66° E
              </span>
            </button>

            <a
              class="hero-linkedin"
              href={site.linkedinUrl}
              target="_blank"
              rel="noopener"
              data-linkedin-terminal-link
            >
              <span>LinkedIn</span>
              <span class="hero-linkedin-arrow" aria-hidden="true">↗</span>
              <span
                class="hero-linkedin-terminal"
                data-linkedin-terminal
                aria-hidden="true"
              >
                <span class="hero-linkedin-terminal__prompt">&gt;</span>
                <span
                  class="hero-linkedin-terminal__text"
                  data-linkedin-terminal-text
                ></span>
                <span
                  class="hero-linkedin-terminal__cursor"
                  data-linkedin-terminal-cursor
                >_</span>
              </span>
            </a>
          </div>

          <div class="hero-art hero-art--interactive">
            <MorphingTopography enableZoom={false} />
          </div>
        </div>
      </section>

      <section class="feed">
        {
          posts.map((post, index) => {
            const publishedAt = post.data.publishedAt;
            const postNumber = String(posts.length - index).padStart(2, '0');
            const slug = getPostSlug(post.id);
            const titleHref =
              lang === 'fi'
                ? `/artikkelit/${slug}/`
                : `/en/articles/${slug}/`;

            return (
              <FeedPost
                post={post}
                lang={lang}
                postNumber={postNumber}
                displayDate={getDisplayDate(publishedAt)}
                perspectiveLabel={t.perspectiveLabel}
                sourceLabel={t.sourceLabel}
                titleHref={titleHref}
              />
            );
          })
        }
      </section>
    </main>

    <Analytics lang={lang} />

    <script is:inline>
      (() => {
        const icon = document.querySelector('.location-icon')
        if (!icon) return
        if (icon.dataset.redrawFlickerInitialized === 'true') return

        icon.dataset.redrawFlickerInitialized = 'true'

        const finePointer = window.matchMedia('(pointer: fine) and (hover: hover)')
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        if (!finePointer.matches || reducedMotion) return

        let lastX = null
        let lastY = null
        let lastTime = null
        let lastFlickerAt = -Infinity
        let isFlickering = false
        const flickerTimers = []

        const clearFlickerTimers = () => {
          while (flickerTimers.length) {
            window.clearTimeout(flickerTimers.pop())
          }
        }

        const after = (delay, callback) => {
          const timer = window.setTimeout(callback, delay)
          flickerTimers.push(timer)
        }

        const finishFlicker = () => {
          icon.style.visibility = 'visible'
          isFlickering = false
        }

        const triggerFlicker = (now, speed, elapsed) => {
          if (isFlickering) return
          if (now - lastFlickerAt < 300) return

          const speedFactor = Math.min(speed / 2.2, 1)
          const eventsPerSecond = 0.42 + speedFactor * 0.88
          const chance = 1 - Math.exp(-eventsPerSecond * (elapsed / 1000))

          if (Math.random() >= chance) return

          isFlickering = true
          lastFlickerAt = now
          clearFlickerTimers()

          const doubleFlicker = Math.random() < 0.68

          icon.style.visibility = 'hidden'

          if (!doubleFlicker) {
            after(38 + Math.random() * 34, finishFlicker)
            return
          }

          after(30 + Math.random() * 24, () => {
            icon.style.visibility = 'visible'

            after(18 + Math.random() * 22, () => {
              icon.style.visibility = 'hidden'

              after(28 + Math.random() * 28, finishFlicker)
            })
          })
        }

        const handlePointerMove = (event) => {
          const now = performance.now()

          if (
            lastX === null ||
            lastY === null ||
            lastTime === null
          ) {
            lastX = event.clientX
            lastY = event.clientY
            lastTime = now
            return
          }

          const dx = event.clientX - lastX
          const dy = event.clientY - lastY
          const distance = Math.hypot(dx, dy)
          const elapsed = Math.max(8, now - lastTime)
          const speed = distance / elapsed

          lastX = event.clientX
          lastY = event.clientY
          lastTime = now

          if (distance > 0) {
            triggerFlicker(now, speed, elapsed)
          }
        }

        window.addEventListener('pointermove', handlePointerMove, { passive: true })

        window.addEventListener(
          'pagehide',
          () => {
            clearFlickerTimers()
            finishFlicker()
          },
          { once: true }
        )
      })()

      ;(() => {
        const trigger = document.querySelector('[data-location-reveal]')
        if (!trigger) return
        if (trigger.dataset.locationRevealInitialized === 'true') return

        trigger.dataset.locationRevealInitialized = 'true'
        let hideTimer = 0

        const hide = () => {
          trigger.classList.remove('is-revealed')
          trigger.setAttribute('aria-expanded', 'false')
        }

        const reveal = () => {
          window.clearTimeout(hideTimer)
          trigger.classList.add('is-revealed')
          trigger.setAttribute('aria-expanded', 'true')
          hideTimer = window.setTimeout(hide, 4200)
        }

        trigger.addEventListener('click', () => {
          if (trigger.classList.contains('is-revealed')) {
            window.clearTimeout(hideTimer)
            hide()
            return
          }

          reveal()
        })

        window.addEventListener(
          'pagehide',
          () => {
            window.clearTimeout(hideTimer)
          },
          { once: true }
        )
      })()

      ;(() => {
        const link = document.querySelector('[data-linkedin-terminal-link]')
        const terminal = document.querySelector('[data-linkedin-terminal]')
        const text = document.querySelector('[data-linkedin-terminal-text]')
        const cursor = document.querySelector('[data-linkedin-terminal-cursor]')

        if (!link || !terminal || !text || !cursor) return
        if (link.dataset.linkedinTerminalInitialized === 'true') return
        link.dataset.linkedinTerminalInitialized = 'true'

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const timers = []
        let active = false

        const clearTimers = () => {
          while (timers.length) {
            window.clearTimeout(timers.pop())
          }
        }

        const after = (delay, callback) => {
          const timer = window.setTimeout(callback, delay)
          timers.push(timer)
        }

        const setText = (value) => {
          text.textContent = value
        }

        const stop = () => {
          active = false
          clearTimers()
          terminal.classList.remove('is-active')
          text.classList.remove('is-glitching')
          cursor.classList.remove('is-visible')
          setText('')
        }

        const start = () => {
          if (active) return
          active = true
          clearTimers()

          if (reducedMotion) {
            terminal.classList.add('is-active')
            setText('SAY HELLO →')
            cursor.classList.add('is-visible')
            return
          }

          after(250, () => {
            if (!active) return
            terminal.classList.add('is-active')
            cursor.classList.add('is-visible')
          })

          after(330, () => active && setText('HE'))
          after(385, () => active && setText('HELL'))
          after(445, () => active && setText('HELLO?'))

          after(885, () => {
            if (!active) return
            setText('Y3S, YOU.')
            text.classList.add('is-glitching')
          })

          after(930, () => {
            if (!active) return
            text.classList.remove('is-glitching')
            setText('YES, YOU.')
          })

          after(1480, () => active && setText('OPEN CHANNEL?'))
          after(2110, () => active && setText('SAY HELLO →'))
        }

        const handlePointerEnter = () => start()
        const handlePointerLeave = () => stop()
        const handleFocus = () => start()
        const handleBlur = () => stop()

        link.addEventListener('pointerenter', handlePointerEnter)
        link.addEventListener('pointerleave', handlePointerLeave)
        link.addEventListener('focus', handleFocus)
        link.addEventListener('blur', handleBlur)

        window.addEventListener(
          'pagehide',
          () => {
            stop()
            link.removeEventListener('pointerenter', handlePointerEnter)
            link.removeEventListener('pointerleave', handlePointerLeave)
            link.removeEventListener('focus', handleFocus)
            link.removeEventListener('blur', handleBlur)
          },
          { once: true }
        )
      })()
    </script>
  </body>
</html>
