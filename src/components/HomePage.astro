---
import '../styles/global.css';

interface Props {
  lang: 'fi' | 'en';
}

type LanguagePost = {
  title: string;
  tags: string[];
  intro: string;
  sourceName: string;
  sourceLinkText: string;
  sourceTitle: string;
  perspective: string[];
};

type PostFrontmatter = {
  status: 'draft' | 'published';
  publishedAt: string | null;
  sourceUrl: string;
  fi: LanguagePost;
  en: LanguagePost;
};

type MarkdownPost = {
  frontmatter: PostFrontmatter;
};

const { lang } = Astro.props;

const content = {
  fi: {
    pageTitle: 'Aapo Pihkala - Maisema-arkkitehti Espoo',
    pageDescription:
      'Aapo Pihkala on Espoossa toimiva maisema-arkkitehti. Maisema-arkkitehtuuria kaupunkien, ihmisten ja luonnon rajapinnassa.',

    navLabel: 'Päänavigaatio',
    homeLabel: 'Aapo Pihkalan etusivu',

    languageButton: 'EN',
    languageLabel: 'English',
    languageHref: '/en/',
    languageHreflang: 'en',

    linkedinLabel: 'Aapo Pihkala LinkedInissä',
    linkedinText: 'LinkedIn',

    heroPrimary: 'Maisema-arkkitehti.',
    heroSecondary:
      'Maisema-arkkitehtuuria kaupunkien, ihmisten ja luonnon rajapinnassa.',

    location: 'Espoo, Suomi',

    perspectiveLabel: 'Näkökulma',
    sourceLabel: 'Lähde',
  },

  en: {
    pageTitle: 'Aapo Pihkala - Landscape Architect, Espoo',
    pageDescription:
      'Aapo Pihkala is a landscape architect based in Espoo, Finland. Landscape architecture at the intersection of cities, people and nature.',

    navLabel: 'Main navigation',
    homeLabel: 'Aapo Pihkala homepage',

    languageButton: 'FI',
    languageLabel: 'Suomeksi',
    languageHref: '/',
    languageHreflang: 'fi',

    linkedinLabel: 'Aapo Pihkala on LinkedIn',
    linkedinText: 'LinkedIn',

    heroPrimary: 'Landscape architect.',
    heroSecondary:
      'Landscape architecture at the intersection of cities, people and nature.',

    location: 'Espoo, Finland',

    perspectiveLabel: 'Perspective',
    sourceLabel: 'Source',
  },
} as const;

const t = content[lang];

/* =========================================================
   POSTS
   ========================================================= */

const postModules = import.meta.glob(
  '../content/posts/*.md',
  {
    eager: true,
  }
) as Record<string, MarkdownPost>;

const posts = Object.values(postModules)
  .filter(
    (post) =>
      post.frontmatter.status === 'published' &&
      Boolean(post.frontmatter.publishedAt)
  )
  .sort((a, b) => {
    const aTime = new Date(
      a.frontmatter.publishedAt as string
    ).getTime();

    const bTime = new Date(
      b.frontmatter.publishedAt as string
    ).getTime();

    return bTime - aTime;
  });

const dateFormatter =
  lang === 'fi'
    ? new Intl.DateTimeFormat('fi-FI', {
        day: 'numeric',
        month: 'numeric',
        year: 'numeric',
      })
    : new Intl.DateTimeFormat('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });

const getDisplayDate = (
  publishedAt: string
) => {
  const datePart =
    publishedAt.slice(0, 10);

  return dateFormatter.format(
    new Date(
      `${datePart}T12:00:00`
    )
  );
};

/* =========================================================
   PAGE META
   ========================================================= */

const homeHref =
  lang === 'fi'
    ? '/'
    : '/en/';

const canonicalPath =
  lang === 'fi'
    ? '/'
    : '/en/';

const canonicalUrl =
  `https://aapopihkala.fi${canonicalPath}`;

const personSchema = {
  '@context':
    'https://schema.org',

  '@type':
    'Person',

  name:
    'Aapo Pihkala',

  url:
    canonicalUrl,

  jobTitle:
    lang === 'fi'
      ? 'Maisema-arkkitehti'
      : 'Landscape Architect',

  homeLocation: {
    '@type':
      'Place',

    name:
      lang === 'fi'
        ? 'Espoo, Suomi'
        : 'Espoo, Finland',
  },

  sameAs: [
    'https://fi.linkedin.com/in/aapo-pihkala',
  ],

  knowsAbout: [
    'Landscape architecture',
    'Urban planning',
    'Urban nature',
    'Stormwater management',
    'Biodiversity',
  ],
};
---

<!doctype html>

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>
      {t.pageTitle}
    </title>

    <meta
      name="description"
      content={t.pageDescription}
    />

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <link
      rel="alternate"
      hreflang="fi"
      href="https://aapopihkala.fi/"
    />

    <link
      rel="alternate"
      hreflang="en"
      href="https://aapopihkala.fi/en/"
    />

    <link
      rel="alternate"
      hreflang="x-default"
      href="https://aapopihkala.fi/"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        personSchema
      )}
    />
  </head>

  <body>
    <header class="topbar">
      <nav
        class="topbar-inner"
        aria-label={t.navLabel}
      >
        <a
          class="topbar-name"
          href={homeHref}
          aria-label={t.homeLabel}
        >
          aapo
        </a>

        <div class="topbar-actions">
          <a
            class="language-switch"
            href={t.languageHref}
            hreflang={t.languageHreflang}
            lang={t.languageHreflang}
            aria-label={t.languageLabel}
          >
            {t.languageButton}
          </a>

          <a
            class="linkedin-link"
            href="https://fi.linkedin.com/in/aapo-pihkala"
            target="_blank"
            rel="noopener"
            aria-label={t.linkedinLabel}
            title="LinkedIn"
          >
            <svg
              class="linkedin-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"
              />
            </svg>
          </a>
        </div>
      </nav>
    </header>

    <main class="main-container">
      <section class="hero">
        <div class="hero-row">
          <div class="hero-content">
            <h1>
              Aapo Pihkala
            </h1>

            <div class="hero-description">
              <p class="hero-primary">
                {t.heroPrimary}
              </p>

              <p class="hero-secondary">
                {t.heroSecondary}
              </p>
            </div>

            <p class="hero-location">
              <svg
                class="location-icon"
                viewBox="0 0 16 19"
                aria-hidden="true"
              >
                <path
                  d="M8 17.5C8 17.5 13.5 11.4 13.5 6.8C13.5 3.6 11.05 1.5 8 1.5C4.95 1.5 2.5 3.6 2.5 6.8C2.5 11.4 8 17.5 8 17.5Z"
                />

                <circle
                  cx="8"
                  cy="6.8"
                  r="1.9"
                />
              </svg>

              <span>
                {t.location}
              </span>
            </p>

            <a
              class="hero-linkedin"
              href="https://fi.linkedin.com/in/aapo-pihkala"
              target="_blank"
              rel="noopener"
            >
              <span>
                {t.linkedinText}
              </span>

              <span
                class="hero-linkedin-arrow"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          </div>

          <div
            class="hero-art"
            aria-hidden="true"
          >
            <canvas
              class="topography-canvas"
              data-topography
            ></canvas>
          </div>
        </div>
      </section>

      <section class="feed">
        {
          posts.map(
            (
              post,
              index
            ) => {
              const localizedPost =
                post.frontmatter[lang];

              const publishedAt =
                post.frontmatter.publishedAt as string;

              const postNumber =
                String(
                  posts.length -
                    index
                ).padStart(
                  2,
                  '0'
                );

              return (
                <article class="feed-post">
                  <div class="post-index-row">
                    <span class="post-index">
                      {postNumber}
                    </span>

                    <span class="post-index-line"></span>
                  </div>

                  <p class="post-meta">
                    <time
                      class="post-date"
                      datetime={publishedAt}
                    >
                      {
                        getDisplayDate(
                          publishedAt
                        )
                      }
                    </time>

                    {
                      localizedPost.tags.map(
                        (tag) => (
                          <>
                            <span
                              class="post-meta-separator"
                              aria-hidden="true"
                            >
                              /
                            </span>

                            <span>
                              {tag}
                            </span>
                          </>
                        )
                      )
                    }
                  </p>

                  <h2 class="post-title">
                    {
                      localizedPost.title
                    }
                  </h2>

                  <div class="post-news">
                    <p>
                      {
                        localizedPost.intro
                      }
                    </p>

                    <a
                      class="post-news-link"
                      href={
                        post.frontmatter.sourceUrl
                      }
                      target="_blank"
                      rel="noopener"
                      title={
                        localizedPost.sourceTitle
                      }
                    >
                      <span>
                        {
                          localizedPost.sourceLinkText
                        }
                      </span>

                      <span
                        class="post-news-link-arrow"
                        aria-hidden="true"
                      >
                        ↗
                      </span>
                    </a>
                  </div>

                  <p class="post-perspective-label">
                    {
                      t.perspectiveLabel
                    }
                  </p>

                  <div class="post-body">
                    {
                      localizedPost.perspective.map(
                        (paragraph) => (
                          <p>
                            {paragraph}
                          </p>
                        )
                      )
                    }
                  </div>

                  <div class="source">
                    <span class="source-label">
                      {
                        t.sourceLabel
                      }
                    </span>

                    <a
                      class="source-link"
                      href={
                        post.frontmatter.sourceUrl
                      }
                      target="_blank"
                      rel="noopener"
                      title={
                        localizedPost.sourceTitle
                      }
                    >
                      <span>
                        {
                          localizedPost.sourceName
                        }
                      </span>

                      <span
                        class="source-arrow"
                        aria-hidden="true"
                      >
                        ↗
                      </span>
                    </a>
                  </div>
                </article>
              );
            }
          )
        }
      </section>
    </main>

    <script>
      const canvases =
        document.querySelectorAll(
          '[data-topography]'
        );

      const reducedMotion =
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        );

      const cols = 108;
      const rows = 88;
      const contourCount = 54;

      const terrain = (
        x,
        y,
        phase
      ) => {
        const nx =
          x / (cols - 1);

        const ny =
          y / (rows - 1);

        const ridgeA =
          Math.sin(
            nx * 7.2 +
            Math.sin(
              ny * 4.6 +
              phase * 0.7
            ) *
              0.8 +
            phase
          ) * 0.26;

        const ridgeB =
          Math.cos(
            ny * 8.1 -
            Math.sin(
              nx * 5.1 -
              phase * 0.45
            ) *
              0.72 -
            phase * 0.68
          ) * 0.22;

        const ridgeC =
          Math.sin(
            (nx + ny) *
              9.6 +
            Math.sin(
              nx * 3.8 +
              ny * 2.4
            ) *
              1.15 +
            phase * 0.34
          ) * 0.13;

        const dx1 =
          nx - 0.34;

        const dy1 =
          ny - 0.42;

        const dx2 =
          nx - 0.72;

        const dy2 =
          ny - 0.63;

        const dx3 =
          nx - 0.57;

        const dy3 =
          ny - 0.22;

        const hill1 =
          Math.exp(
            -(
              dx1 *
                dx1 *
                9.5 +
              dy1 *
                dy1 *
                12
            )
          ) * 0.95;

        const hill2 =
          Math.exp(
            -(
              dx2 *
                dx2 *
                15 +
              dy2 *
                dy2 *
                10
            )
          ) * 0.68;

        const basin =
          Math.exp(
            -(
              dx3 *
                dx3 *
                19 +
              dy3 *
                dy3 *
                17
            )
          ) * -0.44;

        const warp =
          Math.sin(
            nx * 13.4 +
            ny * 5.2 +
            phase * 0.24
          ) * 0.055;

        return (
          ridgeA +
          ridgeB +
          ridgeC +
          hill1 +
          hill2 +
          basin +
          warp
        );
      };

      const interpolate = (
        a,
        b,
        level
      ) => {
        const delta =
          b - a;

        if (
          Math.abs(
            delta
          ) < 0.00001
        ) {
          return 0.5;
        }

        return (
          (level - a) /
          delta
        );
      };

      const drawContour = (
        ctx,
        values,
        level,
        width,
        height
      ) => {
        const cellWidth =
          width /
          (cols - 1);

        const cellHeight =
          height /
          (rows - 1);

        ctx.beginPath();

        const point = (
          edge,
          x,
          y,
          tl,
          tr,
          br,
          bl
        ) => {
          if (
            edge === 0
          ) {
            const t =
              interpolate(
                tl,
                tr,
                level
              );

            return [
              (x + t) *
                cellWidth,
              y *
                cellHeight,
            ];
          }

          if (
            edge === 1
          ) {
            const t =
              interpolate(
                tr,
                br,
                level
              );

            return [
              (x + 1) *
                cellWidth,
              (y + t) *
                cellHeight,
            ];
          }

          if (
            edge === 2
          ) {
            const t =
              interpolate(
                bl,
                br,
                level
              );

            return [
              (x + t) *
                cellWidth,
              (y + 1) *
                cellHeight,
            ];
          }

          const t =
            interpolate(
              tl,
              bl,
              level
            );

          return [
            x *
              cellWidth,
            (y + t) *
              cellHeight,
          ];
        };

        const connect = (
          edgeA,
          edgeB,
          x,
          y,
          tl,
          tr,
          br,
          bl
        ) => {
          const a =
            point(
              edgeA,
              x,
              y,
              tl,
              tr,
              br,
              bl
            );

          const b =
            point(
              edgeB,
              x,
              y,
              tl,
              tr,
              br,
              bl
            );

          ctx.moveTo(
            a[0],
            a[1]
          );

          ctx.lineTo(
            b[0],
            b[1]
          );
        };

        for (
          let y = 0;
          y < rows - 1;
          y += 1
        ) {
          for (
            let x = 0;
            x < cols - 1;
            x += 1
          ) {
            const tl =
              values[
                y *
                  cols +
                x
              ];

            const tr =
              values[
                y *
                  cols +
                x +
                1
              ];

            const br =
              values[
                (y + 1) *
                  cols +
                x +
                1
              ];

            const bl =
              values[
                (y + 1) *
                  cols +
                x
              ];

            const code =
              (tl >= level
                ? 8
                : 0) |
              (tr >= level
                ? 4
                : 0) |
              (br >= level
                ? 2
                : 0) |
              (bl >= level
                ? 1
                : 0);

            switch (
              code
            ) {
              case 1:
              case 14:
                connect(
                  3,
                  2,
                  x,
                  y,
                  tl,
                  tr,
                  br,
                  bl
                );
                break;

              case 2:
              case 13:
                connect(
                  2,
                  1,
                  x,
                  y,
                  tl,
                  tr,
                  br,
                  bl
                );
                break;

              case 3:
              case 12:
                connect(
                  3,
                  1,
                  x,
                  y,
                  tl,
                  tr,
                  br,
                  bl
                );
                break;

              case 4:
              case 11:
                connect(
                  0,
                  1,
                  x,
                  y,
                  tl,
                  tr,
                  br,
                  bl
                );
                break;

              case 5: {
                const center =
                  (
                    tl +
                    tr +
                    br +
                    bl
                  ) / 4;

                if (
                  center >=
                  level
                ) {
                  connect(
                    0,
                    3,
                    x,
                    y,
                    tl,
                    tr,
                    br,
                    bl
                  );

                  connect(
                    1,
                    2,
                    x,
                    y,
                    tl,
                    tr,
                    br,
                    bl
                  );
                } else {
                  connect(
                    0,
                    1,
                    x,
                    y,
                    tl,
                    tr,
                    br,
                    bl
                  );

                  connect(
                    3,
                    2,
                    x,
                    y,
                    tl,
                    tr,
                    br,
                    bl
                  );
                }

                break;
              }

              case 6:
              case 9:
                connect(
                  0,
                  2,
                  x,
                  y,
                  tl,
                  tr,
                  br,
                  bl
                );
                break;

              case 7:
              case 8:
                connect(
                  0,
                  3,
                  x,
                  y,
                  tl,
                  tr,
                  br,
                  bl
                );
                break;

              case 10: {
                const center =
                  (
                    tl +
                    tr +
                    br +
                    bl
                  ) / 4;

                if (
                  center >=
                  level
                ) {
                  connect(
                    0,
                    1,
                    x,
                    y,
                    tl,
                    tr,
                    br,
                    bl
                  );

                  connect(
                    3,
                    2,
                    x,
                    y,
                    tl,
                    tr,
                    br,
                    bl
                  );
                } else {
                  connect(
                    0,
                    3,
                    x,
                    y,
                    tl,
                    tr,
                    br,
                    bl
                  );

                  connect(
                    1,
                    2,
                    x,
                    y,
                    tl,
                    tr,
                    br,
                    bl
                  );
                }

                break;
              }
            }
          }
        }

        ctx.stroke();
      };

      const setupCanvas = (
        canvas
      ) => {
        const ctx =
          canvas.getContext(
            '2d'
          );

        if (!ctx) {
          return;
        }

        let frameId = 0;
        let lastFrame = 0;

        const draw = (
          time = 0
        ) => {
          const rect =
            canvas.getBoundingClientRect();

          const cssWidth =
            Math.max(
              1,
              rect.width
            );

          const cssHeight =
            Math.max(
              1,
              rect.height
            );

          const dpr =
            Math.min(
              window.devicePixelRatio ||
                1,
              2
            );

          const pixelWidth =
            Math.round(
              cssWidth *
                dpr
            );

          const pixelHeight =
            Math.round(
              cssHeight *
                dpr
            );

          if (
            canvas.width !==
              pixelWidth ||
            canvas.height !==
              pixelHeight
          ) {
            canvas.width =
              pixelWidth;

            canvas.height =
              pixelHeight;
          }

          ctx.setTransform(
            dpr,
            0,
            0,
            dpr,
            0,
            0
          );

          ctx.clearRect(
            0,
            0,
            cssWidth,
            cssHeight
          );

          const phase =
            reducedMotion.matches
              ? 0.7
              : time *
                0.000225;

          const values =
            new Float32Array(
              cols *
                rows
            );

          let min =
            Infinity;

          let max =
            -Infinity;

          for (
            let y = 0;
            y < rows;
            y += 1
          ) {
            for (
              let x = 0;
              x < cols;
              x += 1
            ) {
              const value =
                terrain(
                  x,
                  y,
                  phase
                );

              values[
                y *
                  cols +
                x
              ] = value;

              if (
                value < min
              ) {
                min =
                  value;
              }

              if (
                value > max
              ) {
                max =
                  value;
              }
            }
          }

          ctx.lineCap =
            'round';

          ctx.lineJoin =
            'round';

          for (
            let i = 1;
            i <=
            contourCount;
            i += 1
          ) {
            const ratio =
              i /
              (
                contourCount +
                1
              );

            const level =
              min +
              (max - min) *
                ratio;

            const isTenth =
              i % 10 === 0;

            const isFifth =
              !isTenth &&
              i % 5 === 0;

            ctx.strokeStyle =
              isTenth
                ? 'rgba(73, 88, 77, 0.56)'
                : isFifth
                  ? 'rgba(89, 105, 93, 0.40)'
                  : 'rgba(89, 105, 93, 0.23)';

            ctx.lineWidth =
              isTenth
                ? 1.15
                : isFifth
                  ? 0.82
                  : 0.52;

            drawContour(
              ctx,
              values,
              level,
              cssWidth,
              cssHeight
            );
          }
        };

        const animate = (
          time
        ) => {
          if (
            reducedMotion.matches
          ) {
            draw(0);
            return;
          }

          if (
            time -
              lastFrame >=
            55
          ) {
            lastFrame =
              time;

            draw(
              time
            );
          }

          frameId =
            requestAnimationFrame(
              animate
            );
        };

        const restart =
          () => {
            cancelAnimationFrame(
              frameId
            );

            if (
              reducedMotion.matches
            ) {
              draw(0);
            } else {
              frameId =
                requestAnimationFrame(
                  animate
                );
            }
          };

        const resizeObserver =
          new ResizeObserver(
            () => {
              draw(
                performance.now()
              );
            }
          );

        resizeObserver.observe(
          canvas
        );

        reducedMotion.addEventListener(
          'change',
          restart
        );

        restart();
      };

      canvases.forEach(
        setupCanvas
      );
    </script>
  </body>
</html>
