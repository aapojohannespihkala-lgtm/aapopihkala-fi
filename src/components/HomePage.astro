---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeedPost from './FeedPost.astro';
import MorphingTopography from './MorphingTopography.astro';
import NightModeToggle from './NightModeToggle.astro';
import HomepageEasterEggs from './HomepageEasterEggs.astro';
import HomepagePassiveEasterEggs from './HomepagePassiveEasterEggs.astro';
import HomepageHoverMeta from './HomepageHoverMeta.astro';
import RectangularAreaEasterEgg from './RectangularAreaEasterEgg.astro';
import HeroSectionEasterEgg from './HeroSectionEasterEgg.astro';
import HeroConceptLayers from './HeroConceptLayers.astro';
import HomepageTitleDimension from './HomepageTitleDimension.astro';
import HomepageAboutEmbed from './HomepageAboutEmbed.astro';
import HomepageSectionNavigator from './HomepageSectionNavigator.astro';

import {
  site,
  type SiteLanguage,
} from '../config/site';

import {
  getPostSlug,
  getPublishedPosts,
} from '../utils/posts';

interface Props {
  lang: SiteLanguage;
}

const { lang } = Astro.props;

const content = {
  fi: {
    pageTitle: 'Aapo Pihkala - Maisema-arkkitehti Espoo',
    pageDescription: 'Aapo Pihkala on Espoossa toimiva maisema-arkkitehti. Maisema-arkkitehtuuria kaupunkien, ihmisten ja luonnon rajapinnassa.',
    heroPrimary: 'Maisema-arkkitehti.',
    heroSecondary: 'Maisema-arkkitehtuuria kaupunkien, ihmisten ja luonnon rajapinnassa.',
    location: 'Espoo, Suomi',
    perspectiveLabel: 'Näkökulma',
    sourceLabel: 'Lähde',
    aboutIndex: 'ABOUT / 01',
    aboutOpen: 'PROFIILI / AVAA ↗',
    aboutLabel: 'Avaa tietoa minusta',
  },
  en: {
    pageTitle: 'Aapo Pihkala - Landscape Architect, Espoo',
    pageDescription: 'Aapo Pihkala is a landscape architect based in Espoo, Finland. Landscape architecture at the intersection of cities, people and nature.',
    heroPrimary: 'Landscape architect.',
    heroSecondary: 'Landscape architecture at the intersection of cities, people and nature.',
    location: 'Espoo, Finland',
    perspectiveLabel: 'Perspective',
    sourceLabel: 'Source',
    aboutIndex: 'ABOUT / 01',
    aboutOpen: 'PROFILE / OPEN ↗',
    aboutLabel: 'Open about page',
  },
} as const;

const t = content[lang];
const currentLanguage = site.languages[lang];
const alternateLanguage = lang === 'fi' ? site.languages.en : site.languages.fi;
const aboutHref = lang === 'fi' ? '/about/' : '/en/about/';
const posts = await getPublishedPosts();

const dateFormatter = new Intl.DateTimeFormat(
  currentLanguage.locale,
  lang === 'fi'
    ? { day: 'numeric', month: 'numeric', year: 'numeric' }
    : { day: 'numeric', month: 'short', year: 'numeric' }
);

const getDisplayDate = (publishedAt: string) => {
  const datePart = publishedAt.slice(0, 10);
  return dateFormatter.format(new Date(`${datePart}T12:00:00`));
};

const canonicalUrl = `${site.url}${currentLanguage.homePath}`;
const finnishUrl = `${site.url}${site.languages.fi.homePath}`;
const englishUrl = `${site.url}${site.languages.en.homePath}`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: canonicalUrl,
  jobTitle: lang === 'fi' ? 'Maisema-arkkitehti' : 'Landscape Architect',
  homeLocation: {
    '@type': 'Place',
    name: lang === 'fi' ? 'Espoo, Suomi' : 'Espoo, Finland',
  },
  sameAs: [site.linkedinUrl],
  knowsAbout: [
    'Landscape architecture',
    'Urban planning',
    'Urban nature',
    'Stormwater management',
    'Biodiversity',
  ],
};
---

<BaseLayout
  lang={lang}
  title={t.pageTitle}
  description={t.pageDescription}
  canonicalUrl={canonicalUrl}
  finnishUrl={finnishUrl}
  englishUrl={englishUrl}
  languageHref={alternateLanguage.homePath}
  initialNightMode
  areaPolish
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <style>
      .hero {
        position: relative;
        min-height: calc(100svh - 64px);
        padding: 0;
        display: flex;
        align-items: center;
      }

      .hero-row {
        width: 100%;
        transform: translateY(clamp(14px, 3vh, 28px));
      }

      .hero-about-link {
        position: absolute;
        left: 0;
        right: 0;
        bottom: clamp(18px, 2.6vh, 28px);
        min-height: 44px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-top: 1px solid var(--line-soft);
        border-bottom: 1px solid var(--line-soft);
        color: var(--stone-light);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.47rem;
        font-weight: 600;
        line-height: 1;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        text-decoration: none;
        transition: color 150ms ease, border-color 150ms ease;
      }

      .hero-about-link__open {
        color: var(--stone);
        transition: color 150ms ease, transform 150ms ease;
      }

      .hero-about-link:hover,
      .hero-about-link:focus-visible {
        color: var(--moss-deep);
        border-color: var(--line);
      }

      .hero-about-link:hover .hero-about-link__open,
      .hero-about-link:focus-visible .hero-about-link__open {
        color: var(--moss-deep);
        transform: translate(1px, -1px);
      }

      .hero-about-link:focus-visible {
        outline: 1px solid var(--lichen);
        outline-offset: 5px;
      }

      .location-icon {
        width: 18px;
        height: 18px;
        opacity: 1;
        visibility: visible;
        stroke: var(--moss-deep);
        stroke-width: 1;
        stroke-linecap: butt;
        stroke-linejoin: miter;
        transition: none !important;
        animation: none !important;
      }

      .location-icon__target-box {
        opacity: 0;
        transition: none;
      }

      .hero-location-trigger:has(.hero-location-label:hover) .location-icon__target-box,
      .hero-location-trigger:has(.location-icon:hover) .location-icon__target-box,
      .hero-location-trigger:focus-visible .location-icon__target-box {
        opacity: 1;
      }

      .hero-location-trigger {
        appearance: none;
        border: 0;
        padding: 0;
        background: transparent;
        font-family: inherit;
        text-align: left;
        cursor: pointer;
      }

      .hero-location-trigger:focus-visible {
        outline: 1px solid var(--lichen);
        outline-offset: 5px;
      }

      .hero-location-coordinate {
        display: inline-block;
        max-width: 0;
        overflow: hidden;
        white-space: nowrap;
        opacity: 0;
        color: var(--moss);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.56rem;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.07em;
        transform: translateX(-4px);
        transition: max-width 220ms ease, opacity 160ms ease, transform 220ms ease;
      }

      .hero-location-trigger.is-revealed .hero-location-coordinate {
        max-width: 190px;
        opacity: 0.72;
        transform: translateX(0);
      }

      .hero-linkedin-terminal {
        display: inline-flex;
        max-width: 0;
        min-width: 0;
        align-items: baseline;
        gap: 3px;
        overflow: hidden;
        white-space: nowrap;
        color: var(--moss);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.47rem;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        opacity: 0;
        transform: translateX(-5px);
        transition: max-width 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 90ms linear, transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .hero-linkedin-terminal.is-active {
        max-width: 190px;
        opacity: 0.76;
        transform: translateX(0);
      }

      .hero-linkedin-terminal__prompt {
        color: var(--stone-light);
      }

      .hero-linkedin-terminal__text {
        display: inline-block;
        min-width: 0;
      }

      .hero-linkedin-terminal__text.is-glitching {
        transform: translateX(1px);
        opacity: 0.58;
      }

      .hero-linkedin-terminal__cursor {
        display: inline-block;
        width: 0.62em;
        color: var(--moss-deep);
        opacity: 0;
      }

      .hero-linkedin-terminal__cursor.is-visible {
        animation: linkedin-terminal-cursor 1.13s steps(1, end) infinite;
      }

      @keyframes linkedin-terminal-cursor {
        0%, 34% { opacity: 0.86; }
        35%, 49% { opacity: 0; }
        50%, 83% { opacity: 0.86; }
        84%, 100% { opacity: 0; }
      }

      @media (max-height: 720px) and (min-width: 641px) {
        .hero-row {
          transform: translateY(0);
        }

        .hero-about-link {
          bottom: 12px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-about-link,
        .hero-about-link__open,
        .hero-location-coordinate,
        .hero-linkedin-terminal {
          transition: none;
        }

        .hero-linkedin-terminal__cursor.is-visible {
          animation: none;
          opacity: 0.72;
        }
      }

      @media (max-width: 800px) {
        .hero {
          min-height: calc(100svh - 64px);
          padding: 0;
        }

        .hero-row {
          transform: translateY(clamp(12px, 2.4vh, 22px));
        }
      }

      @media (max-width: 640px) {
        .hero {
          min-height: calc(100svh - 64px);
          padding: 0 0 58px;
        }

        .hero-row {
          transform: translateY(12px);
        }

        .hero-about-link {
          bottom: 8px;
          min-height: 40px;
          font-size: 0.43rem;
        }
      }
    </style>
  </Fragment>

  <main id="main-content" tabindex="-1" class="main-container">
    <section class="hero">
      <div class="hero-row">
        <div class="hero-content">
          <h1>{site.name}</h1>

          <div class="hero-description">
            <p class="hero-primary">{t.heroPrimary}</p>
            <p class="hero-secondary">{t.heroSecondary}</p>
          </div>

          <button
            class="hero-location hero-location-trigger"
            type="button"
            data-location-reveal
            aria-expanded="false"
            aria-label={lang === 'fi' ? 'Näytä Espoon koordinaatit' : 'Show Espoo coordinates'}
          >
            <svg class="location-icon" viewBox="0 0 18 18" aria-hidden="true">
              <line x1="0" y1="9" x2="18" y2="9" />
              <line x1="9" y1="0" x2="9" y2="18" />
              <rect class="location-icon__target-box" x="6" y="6" width="6" height="6" fill="none" />
            </svg>

            <span class="hero-location-label">{t.location}</span>
            <span class="hero-location-coordinate" aria-hidden="true">· 60.21° N / 24.66° E</span>
          </button>

          <a
            class="hero-linkedin"
            href={site.linkedinUrl}
            target="_blank"
            rel="noopener"
            data-linkedin-terminal-link
          >
            <span>LinkedIn</span>
            <span class="hero-linkedin-arrow" aria-hidden="true">↗</span>
            <span class="hero-linkedin-terminal" data-linkedin-terminal aria-hidden="true">
              <span class="hero-linkedin-terminal__prompt">&gt;</span>
              <span class="hero-linkedin-terminal__text" data-linkedin-terminal-text></span>
              <span class="hero-linkedin-terminal__cursor" data-linkedin-terminal-cursor>_</span>
            </span>
          </a>
        </div>

        <div class="hero-art hero-art--interactive">
          <MorphingTopography enableZoom={false} />
        </div>
      </div>

      <a class="hero-about-link" href={aboutHref} aria-label={t.aboutLabel}>
        <span>{t.aboutIndex}</span>
        <span class="hero-about-link__open">{t.aboutOpen}</span>
      </a>
    </section>

    <section class="feed">
      {
        posts.map((post) => {
          const publishedAt = post.data.publishedAt;
          const slug = getPostSlug(post.id);
          const titleHref = lang === 'fi' ? `/artikkelit/${slug}/` : `/en/articles/${slug}/`;

          return (
            <FeedPost
              post={post}
              lang={lang}
              displayDate={getDisplayDate(publishedAt)}
              perspectiveLabel={t.perspectiveLabel}
              sourceLabel={t.sourceLabel}
              titleHref={titleHref}
            />
          );
        })
      }
    </section>
  </main>

  <Fragment slot="afterAnalytics">
    <script is:inline>
      (() => {
        const trigger = document.querySelector('[data-location-reveal]')
        if (!trigger) return
        if (trigger.dataset.locationRevealInitialized === 'true') return

        trigger.dataset.locationRevealInitialized = 'true'
        let hideTimer = 0

        const hide = () => {
          trigger.classList.remove('is-revealed')
          trigger.setAttribute('aria-expanded', 'false')
        }

        const reveal = () => {
          window.clearTimeout(hideTimer)
          trigger.classList.add('is-revealed')
          trigger.setAttribute('aria-expanded', 'true')
          hideTimer = window.setTimeout(hide, 4200)
        }

        trigger.addEventListener('click', () => {
          if (trigger.classList.contains('is-revealed')) {
            window.clearTimeout(hideTimer)
            hide()
            return
          }
          reveal()
        })

        window.addEventListener(
          'pagehide',
          () => window.clearTimeout(hideTimer),
          { once: true }
        )
      })()

      ;(() => {
        const link = document.querySelector('[data-linkedin-terminal-link]')
        const terminal = document.querySelector('[data-linkedin-terminal]')
        const text = document.querySelector('[data-linkedin-terminal-text]')
        const cursor = document.querySelector('[data-linkedin-terminal-cursor]')

        if (!link || !terminal || !text || !cursor) return
        if (link.dataset.linkedinTerminalInitialized === 'true') return
        link.dataset.linkedinTerminalInitialized = 'true'

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const timers = []
        let active = false

        const clearTimers = () => {
          while (timers.length) window.clearTimeout(timers.pop())
        }

        const after = (delay, callback) => {
          const timer = window.setTimeout(callback, delay)
          timers.push(timer)
        }

        const setText = (value) => {
          text.textContent = value
        }

        const stop = () => {
          active = false
          clearTimers()
          terminal.classList.remove('is-active')
          text.classList.remove('is-glitching')
          cursor.classList.remove('is-visible')
          setText('')
        }

        const start = () => {
          if (active) return
          active = true
          clearTimers()

          if (reducedMotion) {
            terminal.classList.add('is-active')
            setText('SAY HELLO →')
            cursor.classList.add('is-visible')
            return
          }

          after(250, () => {
            if (!active) return
            terminal.classList.add('is-active')
            cursor.classList.add('is-visible')
          })

          after(330, () => active && setText('HE'))
          after(385, () => active && setText('HELL'))
          after(445, () => active && setText('HELLO?'))

          after(885, () => {
            if (!active) return
            setText('Y3S, YOU.')
            text.classList.add('is-glitching')
          })

          after(930, () => {
            if (!active) return
            text.classList.remove('is-glitching')
            setText('YES, YOU.')
          })

          after(1480, () => active && setText('OPEN CHANNEL?'))
          after(2110, () => active && setText('SAY HELLO →'))
        }

        const handlePointerEnter = () => start()
        const handlePointerLeave = () => stop()
        const handleFocus = () => start()
        const handleBlur = () => stop()

        link.addEventListener('pointerenter', handlePointerEnter)
        link.addEventListener('pointerleave', handlePointerLeave)
        link.addEventListener('focus', handleFocus)
        link.addEventListener('blur', handleBlur)

        window.addEventListener(
          'pagehide',
          () => {
            stop()
            link.removeEventListener('pointerenter', handlePointerEnter)
            link.removeEventListener('pointerleave', handlePointerLeave)
            link.removeEventListener('focus', handleFocus)
            link.removeEventListener('blur', handleBlur)
          },
          { once: true }
        )
      })()
    </script>

    <NightModeToggle lang={lang} />
    <HomepageEasterEggs />
    <HomepagePassiveEasterEggs />
    <HomepageHoverMeta />
    <RectangularAreaEasterEgg />
    <HeroSectionEasterEgg />
    <HeroConceptLayers />
    <HomepageTitleDimension />
    <HomepageAboutEmbed lang={lang} />
    <HomepageSectionNavigator lang={lang} />
  </Fragment>
</BaseLayout>
