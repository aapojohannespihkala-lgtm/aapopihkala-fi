---
interface Props {
  class?: string
  autoRotate?: boolean
  animate?: boolean
  enableZoom?: boolean
  scale?: number
  cameraDistance?: number
}

const {
  class: className,
  autoRotate = true,
  animate = true,
  enableZoom = true,
  scale = 1,
  cameraDistance = 7.4,
} = Astro.props
---

<div
  class:list={['accessibility-step', className]}
  data-accessibility-step
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-animate={animate ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-scale={scale}
  data-camera-distance={cameraDistance}
  aria-hidden="true"
>
  <canvas
    class="accessibility-step__canvas"
    data-accessibility-step-canvas
  ></canvas>
</div>

<style>
  .accessibility-step {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 280px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .accessibility-step:active {
    cursor: grabbing;
  }

  .accessibility-step__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script>
  import { THREE, OrbitControls } from '../scripts/threeRuntime'

  (() => {
    const roots = document.querySelectorAll<HTMLElement>('[data-accessibility-step]')

    const clamp01 = (value: number) => Math.max(0, Math.min(1, value))

    const smoothstep = (value: number) => {
      const t = clamp01(value)
      return t * t * (3 - 2 * t)
    }

    roots.forEach(async (root) => {
      if (root.dataset.accessibilityStepInitialized === 'true') return
      root.dataset.accessibilityStepInitialized = 'true'

      const canvas = root.querySelector<HTMLCanvasElement>('[data-accessibility-step-canvas]')
      if (!canvas) return

      try {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const wantsAutoRotate = root.dataset.autoRotate !== 'false'
        const wantsAnimation = root.dataset.animate !== 'false' && !reducedMotion
        const wantsZoom = root.dataset.enableZoom !== 'false'
        const requestedScale = Number(root.dataset.scale ?? '1')
        const requestedCameraDistance = Number(root.dataset.cameraDistance ?? '7.4')
        const displayScale = Number.isFinite(requestedScale) ? requestedScale : 1
        const cameraDistance = Number.isFinite(requestedCameraDistance)
          ? requestedCameraDistance
          : 7.4

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        })
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6))
        renderer.setClearColor(0xffffff, 0)

        const scene = new THREE.Scene()
        const camera = new THREE.PerspectiveCamera(36, 1, 0.1, 100)
        camera.position.set(4.35, 2.65, cameraDistance)

        const specimen = new THREE.Group()
        specimen.scale.setScalar(displayScale)
        specimen.rotation.y = -0.12
        specimen.rotation.z = -0.025
        scene.add(specimen)

        const controls = new OrbitControls(camera, renderer.domElement)
        controls.enablePan = false
        controls.enableZoom = wantsZoom
        controls.enableDamping = true
        controls.dampingFactor = 0.055
        controls.rotateSpeed = 0.55
        controls.target.set(0, 0.32, 0)
        controls.autoRotate = wantsAutoRotate && !reducedMotion
        controls.autoRotateSpeed = 0.22

        if (wantsZoom) {
          controls.minDistance = 5.9
          controls.maxDistance = 9.7
          controls.zoomSpeed = 0.5
        } else {
          const direction = camera.position.clone().sub(controls.target).normalize()
          camera.position.copy(controls.target).add(direction.multiplyScalar(cameraDistance))
          controls.minDistance = cameraDistance
          controls.maxDistance = cameraDistance
        }

        const halfWidth = 2.35
        const halfDepth = 1.22
        const stepHeight = 0.72
        const rampStart = -1.15
        const rampEnd = 1.15

        const stepHeightAt = (x: number) => (x < 0 ? 0 : stepHeight)

        const rampHeightAt = (x: number) => {
          if (x <= rampStart) return 0
          if (x >= rampEnd) return stepHeight

          const t = (x - rampStart) / (rampEnd - rampStart)
          return stepHeight * smoothstep(t)
        }

        const heightAt = (x: number, morph: number) =>
          THREE.MathUtils.lerp(stepHeightAt(x), rampHeightAt(x), morph)

        const cycleDuration = 12
        const leftX = -1.82
        const rightX = 1.82
        const blockedX = -0.28

        const stateAtTime = (seconds: number) => {
          if (!wantsAnimation) {
            return {
              morph: 1,
              x: 0.95,
              direction: 1,
              blocked: false,
            }
          }

          const phase = (seconds % cycleDuration) / cycleDuration

          let morph = 0
          if (phase >= 0.18 && phase < 0.34) {
            morph = smoothstep((phase - 0.18) / 0.16)
          } else if (phase >= 0.34 && phase < 0.74) {
            morph = 1
          } else if (phase >= 0.74 && phase < 0.9) {
            morph = 1 - smoothstep((phase - 0.74) / 0.16)
          }

          const movingRight = phase < 0.5
          const direction = movingRight ? 1 : -1
          const travelPhase = movingRight
            ? phase * 2
            : (phase - 0.5) * 2

          const desiredX = movingRight
            ? THREE.MathUtils.lerp(leftX, rightX, travelPhase)
            : THREE.MathUtils.lerp(rightX, leftX, travelPhase)

          let x = desiredX
          let blocked = false

          if (movingRight && desiredX > blockedX) {
            if (morph < 0.42) {
              blocked = true
              const pressure = Math.min(1, Math.max(0, (desiredX - blockedX) / 0.45))
              x = blockedX - 0.016 + Math.sin(seconds * 17) * 0.012 * pressure
            } else if (morph < 0.76) {
              const release = smoothstep((morph - 0.42) / 0.34)
              x = THREE.MathUtils.lerp(blockedX, desiredX, release)
            }
          }

          return {
            morph,
            x,
            direction,
            blocked,
          }
        }

        const pointColumns = 78
        const pointRows = 31
        const pointCount = (pointColumns + 1) * (pointRows + 1)
        const pointPositions = new Float32Array(pointCount * 3)
        const pointBaseX = new Float32Array(pointCount)
        const pointBaseZ = new Float32Array(pointCount)

        let pointIndex = 0
        for (let row = 0; row <= pointRows; row += 1) {
          const z = THREE.MathUtils.lerp(-halfDepth, halfDepth, row / pointRows)

          for (let column = 0; column <= pointColumns; column += 1) {
            const x = THREE.MathUtils.lerp(-halfWidth, halfWidth, column / pointColumns)
            pointBaseX[pointIndex] = x
            pointBaseZ[pointIndex] = z
            pointIndex += 1
          }
        }

        const pointGeometry = new THREE.BufferGeometry()
        const pointAttribute = new THREE.BufferAttribute(pointPositions, 3)
        pointAttribute.setUsage(THREE.DynamicDrawUsage)
        pointGeometry.setAttribute('position', pointAttribute)

        const pointMaterial = new THREE.PointsMaterial({
          color: 0x59635d,
          size: 0.024,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.58,
        })
        specimen.add(new THREE.Points(pointGeometry, pointMaterial))

        const travelerRadius = 0.18
        const travelerPositions: number[] = []
        const shellCount = 210
        const goldenAngle = Math.PI * (3 - Math.sqrt(5))

        for (let index = 0; index < shellCount; index += 1) {
          const y = 1 - (index / (shellCount - 1)) * 2
          const radiusAtY = Math.sqrt(Math.max(0, 1 - y * y))
          const theta = goldenAngle * index

          travelerPositions.push(
            Math.cos(theta) * radiusAtY * travelerRadius,
            y * travelerRadius,
            Math.sin(theta) * radiusAtY * travelerRadius
          )
        }

        for (let index = 0; index < 48; index += 1) {
          const angle = goldenAngle * index
          const radial = travelerRadius * (0.22 + 0.5 * ((index % 7) / 6))
          const y = travelerRadius * (((index * 3) % 11) / 10 - 0.5)

          travelerPositions.push(
            Math.cos(angle) * radial,
            y,
            Math.sin(angle) * radial
          )
        }

        const travelerGeometry = new THREE.BufferGeometry()
        travelerGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(travelerPositions, 3)
        )

        const travelerMaterial = new THREE.PointsMaterial({
          color: 0x3f4943,
          size: 0.032,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.88,
        })

        const traveler = new THREE.Points(travelerGeometry, travelerMaterial)
        specimen.add(traveler)

        const updateGeometry = (morph: number) => {
          for (let index = 0; index < pointCount; index += 1) {
            const offset = index * 3
            const x = pointBaseX[index]
            const z = pointBaseZ[index]

            pointPositions[offset] = x
            pointPositions[offset + 1] = heightAt(x, morph)
            pointPositions[offset + 2] = z
          }

          pointAttribute.needsUpdate = true
        }

        const resize = () => {
          const rect = root.getBoundingClientRect()
          const width = Math.max(1, Math.round(rect.width))
          const height = Math.max(1, Math.round(rect.height))

          renderer.setSize(width, height, false)
          camera.aspect = width / height
          camera.updateProjectionMatrix()
        }

        const resizeObserver = new ResizeObserver(resize)
        resizeObserver.observe(root)
        resize()

        let isVisible = true
        let isDocumentVisible = !document.hidden
        let animationFrame = 0
        let previousX = leftX
        let travelerRotation = 0

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting)
          },
          { rootMargin: '160px' }
        )
        intersectionObserver.observe(root)

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden
        }
        document.addEventListener('visibilitychange', handleVisibility)

        const animateFrame = (time: number) => {
          animationFrame = requestAnimationFrame(animateFrame)
          if (!isVisible || !isDocumentVisible) return

          const seconds = time * 0.001
          const state = reducedMotion
            ? { morph: 1, x: 0.95, direction: 1, blocked: false }
            : stateAtTime(seconds)

          updateGeometry(state.morph)

          const surfaceY = heightAt(state.x, state.morph)
          traveler.position.set(
            state.x,
            surfaceY + travelerRadius + 0.025,
            0
          )

          const deltaX = state.x - previousX
          if (!state.blocked) {
            travelerRotation -= deltaX / travelerRadius
          }
          traveler.rotation.z = travelerRotation
          traveler.rotation.x = 0.08 * Math.sin(seconds * 0.9)
          previousX = state.x

          controls.update()
          renderer.render(scene, camera)
        }

        const initialState = reducedMotion
          ? { morph: 1, x: 0.95 }
          : stateAtTime(0)

        updateGeometry(initialState.morph)
        traveler.position.set(
          initialState.x,
          heightAt(initialState.x, initialState.morph) + travelerRadius + 0.025,
          0
        )
        previousX = initialState.x
        animationFrame = requestAnimationFrame(animateFrame)

        const cleanup = () => {
          cancelAnimationFrame(animationFrame)
          document.removeEventListener('visibilitychange', handleVisibility)
          resizeObserver.disconnect()
          intersectionObserver.disconnect()
          controls.dispose()
          pointGeometry.dispose()
          pointMaterial.dispose()
          travelerGeometry.dispose()
          travelerMaterial.dispose()
          renderer.dispose()
        }

        window.addEventListener('pagehide', cleanup, { once: true })
      } catch (error) {
        console.error('AccessibilityStep failed to initialize:', error)
      }
    })
  })()
</script>
