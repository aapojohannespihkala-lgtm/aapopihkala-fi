---
interface Props {
  lang?: 'fi' | 'en';
}

const { lang = 'fi' } = Astro.props;

const label = lang === 'fi' ? 'Yötila' : 'Night mode';
---

<button
  class="night-mode-toggle"
  type="button"
  data-night-mode-toggle
  aria-label={label}
  aria-pressed="false"
>
  <span class="night-mode-toggle__icon" aria-hidden="true">
    <span class="night-mode-toggle__dot"></span>
  </span>
  <span class="night-mode-toggle__meta" data-night-mode-meta aria-hidden="true">
    <span data-night-mode-meta-text>SITE / DAYLIGHT SURVEY</span>
  </span>
</button>

<style is:global>
  html.site-night-mode {
    --page: #202a34;
    --bar: #1b242d;
    --bar-transparent: rgba(27, 36, 45, 0.94);
    --ink: #f1f4f5;
    --ink-soft: #e1e7ea;
    --stone: #c4cdd2;
    --stone-light: #9eabb2;
    --header-name: #d7dfe3;
    --header-control: #d2dbe0;
    --moss: #c4d0d5;
    --moss-deep: #edf2f4;
    --lichen: #a9b5bb;
    --line: #64727c;
    --line-soft: #46535d;
    background: var(--page) !important;
    color-scheme: dark;
  }

  html.site-night-mode body,
  html.site-night-mode main,
  html.site-night-mode .main-container,
  html.site-night-mode .hero {
    background: var(--page) !important;
  }

  html.site-night-mode body {
    color: var(--ink);
  }

  html.site-night-mode .topbar {
    background: var(--bar-transparent) !important;
    border-bottom-color: rgba(154, 171, 181, 0.18) !important;
    -webkit-backdrop-filter: blur(5px) saturate(90%);
    backdrop-filter: blur(5px) saturate(90%);
  }

  html.site-night-mode .topbar-name,
  html.site-night-mode .language-switch,
  html.site-night-mode .linkedin-link,
  html.site-night-mode .hero h1,
  html.site-night-mode .hero-primary,
  html.site-night-mode .hero-secondary,
  html.site-night-mode .hero-location,
  html.site-night-mode .hero-location-trigger,
  html.site-night-mode .hero-linkedin,
  html.site-night-mode .hero-linkedin-arrow {
    color: var(--ink) !important;
  }

  html.site-night-mode .feed-post,
  html.site-night-mode .feed-post h1,
  html.site-night-mode .feed-post h2,
  html.site-night-mode .feed-post h3,
  html.site-night-mode .feed-post p,
  html.site-night-mode .feed-post a,
  html.site-night-mode .feed-post span,
  html.site-night-mode .feed-post time,
  html.site-night-mode .feed-post strong,
  html.site-night-mode .feed-post em,
  html.site-night-mode .post-title,
  html.site-night-mode .post-title-link,
  html.site-night-mode .post-news,
  html.site-night-mode .post-news-link,
  html.site-night-mode .post-body,
  html.site-night-mode .post-body p,
  html.site-night-mode .post-meta,
  html.site-night-mode .post-date,
  html.site-night-mode .post-perspective-label,
  html.site-night-mode .source,
  html.site-night-mode .source-label,
  html.site-night-mode .source-link,
  html.site-night-mode .source-arrow {
    color: #e8eef1 !important;
    text-shadow: 0 0 0.01px rgba(255, 255, 255, 0.9);
  }

  html.site-night-mode .post-meta,
  html.site-night-mode .post-perspective-label,
  html.site-night-mode .source-label {
    color: #bdc9cf !important;
  }

  html.site-night-mode .post-meta-separator,
  html.site-night-mode .post-news-link-arrow,
  html.site-night-mode .source-arrow {
    color: #9fadb5 !important;
  }

  html.site-night-mode .post-divider,
  html.site-night-mode .feed-post:first-child {
    border-color: rgba(176, 193, 202, 0.42) !important;
  }

  html.site-night-mode .location-icon {
    stroke: var(--ink) !important;
  }

  html.site-night-mode .morphing-topography__canvas,
  html.site-night-mode .topography-canvas,
  html.site-night-mode .post-interactive-graphic canvas,
  html.site-night-mode .post-graphic canvas,
  html.site-night-mode .post-graphic-image {
    filter: invert(1) grayscale(1) brightness(1.72) contrast(1.12) !important;
    opacity: 0.94 !important;
  }

  html.site-night-mode .post-interactive-graphic svg,
  html.site-night-mode .post-graphic svg {
    color: #edf3f5 !important;
    filter: brightness(1.65) grayscale(1) !important;
  }

  html.site-night-mode .post-interactive-graphic svg path,
  html.site-night-mode .post-interactive-graphic svg line,
  html.site-night-mode .post-interactive-graphic svg polyline,
  html.site-night-mode .post-interactive-graphic svg polygon,
  html.site-night-mode .post-interactive-graphic svg circle,
  html.site-night-mode .post-graphic svg path,
  html.site-night-mode .post-graphic svg line,
  html.site-night-mode .post-graphic svg polyline,
  html.site-night-mode .post-graphic svg polygon,
  html.site-night-mode .post-graphic svg circle {
    stroke: currentColor !important;
  }

  html.site-night-mode .site-grid-easter-egg,
  html.site-night-mode .site-area-mode-grid {
    background-image:
      linear-gradient(rgba(157, 180, 191, 0.15) 1px, transparent 1px),
      linear-gradient(90deg, rgba(157, 180, 191, 0.15) 1px, transparent 1px) !important;
  }

  html.site-night-mode .site-grid-label,
  html.site-night-mode .site-area-mode-grid__label,
  html.site-night-mode .site-scroll-readout,
  html.site-night-mode [data-analytics-settings] {
    color: rgba(218, 229, 234, 0.72) !important;
  }

  html.site-night-mode .site-a-readout {
    color: #eef3f5 !important;
  }

  html.site-night-mode .site-a-readout__label,
  html.site-night-mode .site-area-label,
  html.site-night-mode .site-area-hint,
  html.site-night-mode .site-rect-area__hint,
  html.site-night-mode .homepage-sheet-stamp,
  html.site-night-mode .homepage-language-meta-box,
  html.site-night-mode .homepage-linkedin-meta-box,
  html.site-night-mode .homepage-survey-points__mode,
  html.site-night-mode .homepage-elevation-scan__label,
  html.site-night-mode .homepage-topography-readout__label,
  html.site-night-mode .homepage-selection-note,
  html.site-night-mode .night-mode-toggle__meta {
    background: rgba(25, 34, 43, 0.96) !important;
    border-color: rgba(167, 184, 193, 0.34) !important;
    color: #eaf0f2 !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.16);
  }

  html.site-night-mode .homepage-sheet-stamp__separator {
    color: #9fadb5 !important;
  }

  html.site-night-mode .homepage-title-dimension__label {
    background: var(--page) !important;
    color: #eaf0f2 !important;
  }

  .night-mode-toggle {
    position: relative;
    width: 14.4px;
    height: 14.4px;
    flex: 0 0 14.4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--header-control);
    cursor: pointer;
    opacity: 0.86;
    transition: color 180ms ease, transform 180ms ease, opacity 180ms ease;
  }

  .night-mode-toggle:hover,
  .night-mode-toggle:focus-visible,
  .night-mode-toggle[aria-pressed='true'] {
    color: var(--moss-deep);
    transform: translateY(-1px);
    opacity: 1;
  }

  .night-mode-toggle:focus-visible {
    outline: 1px solid var(--lichen);
    outline-offset: 3px;
  }

  .night-mode-toggle__icon {
    position: relative;
    top: 3px;
    display: block;
    width: 8px;
    height: 8px;
    border: 1px solid currentColor;
    border-radius: 50%;
    box-sizing: border-box;
  }

  .night-mode-toggle__dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2.4px;
    height: 2.4px;
    border-radius: 50%;
    background: #ffffff;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.35);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .night-mode-toggle[aria-pressed='true'] .night-mode-toggle__dot {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .night-mode-toggle__meta {
    position: fixed;
    left: var(--night-mode-meta-left, 0px);
    top: var(--night-mode-meta-top, 72px);
    z-index: 61;
    display: flex;
    align-items: center;
    gap: 6px;
    box-sizing: border-box;
    padding: 5px 7px;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--line-soft);
    color: var(--moss-deep);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.47rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-2px);
    transition: none;
  }

  .night-mode-toggle__meta.is-visible {
    opacity: 0.82;
    transform: translateY(0);
    transition:
      opacity 100ms ease,
      transform 100ms ease;
  }

  html.site-night-mode,
  html.site-night-mode body,
  html.site-night-mode main,
  html.site-night-mode .main-container,
  html.site-night-mode .hero,
  html.site-night-mode .topbar,
  html.site-night-mode .morphing-topography__canvas,
  html.site-night-mode .post-interactive-graphic canvas,
  html.site-night-mode .post-graphic-image {
    transition:
      background-color 180ms ease,
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      filter 180ms ease,
      opacity 180ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    html.site-night-mode,
    html.site-night-mode body,
    html.site-night-mode main,
    html.site-night-mode .main-container,
    html.site-night-mode .hero,
    html.site-night-mode .topbar,
    .night-mode-toggle,
    .night-mode-toggle__dot,
    .night-mode-toggle__meta {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const storageKey = 'aapopihkala-night-mode'
    const root = document.documentElement
    const toggle = document.querySelector('[data-night-mode-toggle]')
    if (!(toggle instanceof HTMLButtonElement)) return

    const meta = toggle.querySelector('[data-night-mode-meta]')
    const metaText = toggle.querySelector('[data-night-mode-meta-text]')
    const topbar = document.querySelector('.topbar')

    const readStoredMode = () => {
      try {
        const stored = window.localStorage.getItem(storageKey)
        if (stored === 'night') return true
        if (stored === 'day') return false
        return null
      } catch {
        return null
      }
    }

    const storeMode = (night) => {
      try {
        window.localStorage.setItem(storageKey, night ? 'night' : 'day')
      } catch {
        // Storage can be unavailable in private browsing contexts.
      }
    }

    const applyMode = (night) => {
      root.classList.toggle('site-night-mode', night)
      toggle.setAttribute('aria-pressed', night ? 'true' : 'false')

      if (metaText) {
        metaText.textContent = night
          ? 'SITE / AFTER-HOURS DRAFTING'
          : 'SITE / DAYLIGHT SURVEY'
      }
    }

    const initialStoredMode = readStoredMode()
    applyMode(initialStoredMode ?? true)

    const handleStorage = (event) => {
      if (event.key !== storageKey) return
      const storedMode = readStoredMode()
      applyMode(storedMode ?? true)
    }

    window.addEventListener('storage', handleStorage)

    const mountToggle = () => {
      const actions = document.querySelector('.topbar-actions')
      if (actions instanceof HTMLElement && toggle.parentElement !== actions) {
        const languageSwitch = actions.querySelector('.language-switch')
        if (languageSwitch) actions.insertBefore(toggle, languageSwitch)
        else actions.prepend(toggle)
      }

      if (meta instanceof HTMLElement && meta.parentElement !== document.body) {
        document.body.append(meta)
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mountToggle, { once: true })
    } else {
      mountToggle()
    }

    toggle.addEventListener('click', () => {
      const next = !root.classList.contains('site-night-mode')
      applyMode(next)
      storeMode(next)
    })

    window.addEventListener(
      'pagehide',
      () => {
        window.removeEventListener('storage', handleStorage)
      },
      { once: true }
    )

    if (!(meta instanceof HTMLElement)) return

    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)')
    if (!finePointer.matches) return

    let hoverTimer = 0

    const getMetaTop = () => {
      const bannerBottom = topbar?.getBoundingClientRect().bottom
      if (typeof bannerBottom === 'number') return bannerBottom + 8
      return toggle.getBoundingClientRect().bottom + 8
    }

    const positionMeta = () => {
      const rect = toggle.getBoundingClientRect()
      meta.style.setProperty('--night-mode-meta-left', `${Math.round(rect.left)}px`)
      meta.style.setProperty('--night-mode-meta-top', `${Math.round(getMetaTop())}px`)
    }

    const showMeta = () => {
      window.clearTimeout(hoverTimer)
      positionMeta()
      hoverTimer = window.setTimeout(() => {
        positionMeta()
        meta.classList.add('is-visible')
      }, 250)
    }

    const hideMeta = () => {
      window.clearTimeout(hoverTimer)
      meta.classList.remove('is-visible')
    }

    const handleResize = () => {
      positionMeta()
    }

    positionMeta()
    toggle.addEventListener('pointerenter', showMeta)
    toggle.addEventListener('pointerleave', hideMeta)
    toggle.addEventListener('focus', showMeta)
    toggle.addEventListener('blur', hideMeta)
    window.addEventListener('resize', handleResize, { passive: true })

    window.addEventListener(
      'pagehide',
      () => {
        hideMeta()
        toggle.removeEventListener('pointerenter', showMeta)
        toggle.removeEventListener('pointerleave', hideMeta)
        toggle.removeEventListener('focus', showMeta)
        toggle.removeEventListener('blur', hideMeta)
        window.removeEventListener('resize', handleResize)
        meta.remove()
      },
      { once: true }
    )
  })()
</script>