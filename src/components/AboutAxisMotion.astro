<style is:global>
  html body .about-portrait .about-center-cross {
    display: none !important;
  }

  html body .about-portrait__frame.is-axis-scanning .about-portrait__axis--x {
    animation: about-axis-scan-y 1000ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  html body .about-portrait__frame.is-axis-scanning .about-portrait__axis--y {
    animation: about-axis-scan-x 1000ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes about-axis-scan-y {
    0% {
      top: 50%;
      opacity: 0.48;
    }
    42% {
      top: 100%;
      opacity: 0.48;
    }
    48% {
      top: 100%;
      opacity: 0;
    }
    52% {
      top: 0%;
      opacity: 0;
    }
    58% {
      top: 0%;
      opacity: 0.48;
    }
    100% {
      top: 50%;
      opacity: 0.48;
    }
  }

  @keyframes about-axis-scan-x {
    0% {
      left: 50%;
      opacity: 0.48;
    }
    42% {
      left: 100%;
      opacity: 0.48;
    }
    48% {
      left: 100%;
      opacity: 0;
    }
    52% {
      left: 0%;
      opacity: 0;
    }
    58% {
      left: 0%;
      opacity: 0.48;
    }
    100% {
      left: 50%;
      opacity: 0.48;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html body .about-portrait__frame.is-axis-scanning .about-portrait__axis--x,
    html body .about-portrait__frame.is-axis-scanning .about-portrait__axis--y {
      animation: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const initializeAxisMotion = () => {
      const finePointer = window.matchMedia('(pointer: fine) and (hover: hover)');
      if (!finePointer.matches) return;

      document.querySelectorAll('[data-about-portrait-frame]').forEach((frame) => {
        if (!(frame instanceof HTMLElement)) return;
        if (frame.dataset.axisMotionInitialized === 'true') return;
        frame.dataset.axisMotionInitialized = 'true';

        const horizontal = frame.querySelector('.about-portrait__axis--x');
        const vertical = frame.querySelector('.about-portrait__axis--y');
        if (!(horizontal instanceof HTMLElement) || !(vertical instanceof HTMLElement)) return;

        let travelling = false;

        const finish = () => {
          if (!travelling) return;
          travelling = false;
          frame.classList.remove('is-axis-scanning');
        };

        const start = () => {
          if (travelling) return;
          travelling = true;
          frame.classList.remove('is-axis-scanning');
          void frame.offsetWidth;
          frame.classList.add('is-axis-scanning');
        };

        horizontal.addEventListener('animationend', finish);
        frame.addEventListener('pointerenter', start);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeAxisMotion, { once: true });
    } else {
      initializeAxisMotion();
    }
  })();
</script>
