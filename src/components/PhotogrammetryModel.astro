<div class="photogrammetry-model" data-photogrammetry-model aria-label="Pyöriteltävä fotogrammetriamalli">
  <canvas class="photogrammetry-model__canvas" data-photogrammetry-model-canvas></canvas>
  <p class="photogrammetry-model__status" data-photogrammetry-model-status>Ladataan 3D-mallia...</p>
</div>

<style>
  .photogrammetry-model {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 420px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .photogrammetry-model:active {
    cursor: grabbing;
  }

  .photogrammetry-model__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }

  .photogrammetry-model__status {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: 0;
    color: var(--stone-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .photogrammetry-model__status[hidden] {
    display: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-photogrammetry-model]');

    roots.forEach(async (root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.photogrammetryInitialized === 'true') return;
      root.dataset.photogrammetryInitialized = 'true';

      const canvas = root.querySelector('[data-photogrammetry-model-canvas]');
      const status = root.querySelector('[data-photogrammetry-model-status]');
      if (!(canvas instanceof HTMLCanvasElement)) return;

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        );
        const { GLTFLoader } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/loaders/GLTFLoader.js/+esm'
        );

        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.setClearColor(0x000000, 0);
        renderer.outputColorSpace = THREE.SRGBColorSpace;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(36, 1, 0.01, 1000);
        const controls = new OrbitControls(camera, canvas);
        controls.enableDamping = true;
        controls.dampingFactor = 0.06;
        controls.enablePan = true;
        controls.enableZoom = true;
        controls.target.set(0, 0, 0);

        scene.add(new THREE.HemisphereLight(0xffffff, 0x8d8d86, 2.0));
        const keyLight = new THREE.DirectionalLight(0xffffff, 2.0);
        keyLight.position.set(4, 6, 5);
        scene.add(keyLight);
        const fillLight = new THREE.DirectionalLight(0xffffff, 0.8);
        fillLight.position.set(-4, 2, -3);
        scene.add(fillLight);

        const loader = new GLTFLoader();
        loader.load(
          '/lab/photogrammetry-2026-09-04.glb',
          (gltf) => {
            const model = gltf.scene;
            scene.add(model);

            const box = new THREE.Box3().setFromObject(model);
            const center = box.getCenter(new THREE.Vector3());
            const size = box.getSize(new THREE.Vector3());
            model.position.sub(center);

            const radius = Math.max(size.x, size.y, size.z) * 0.5 || 1;
            camera.near = Math.max(radius / 1000, 0.001);
            camera.far = Math.max(radius * 100, 100);
            camera.position.set(radius * 1.7, radius * 0.85, radius * 2.0);
            camera.updateProjectionMatrix();

            controls.target.set(0, 0, 0);
            controls.minDistance = Math.max(radius * 0.18, 0.01);
            controls.maxDistance = radius * 12;
            controls.update();

            if (status instanceof HTMLElement) status.hidden = true;
          },
          undefined,
          () => {
            if (status instanceof HTMLElement) status.textContent = '3D-mallia ei voitu ladata';
          }
        );

        const resize = () => {
          const width = Math.max(1, root.clientWidth);
          const height = Math.max(1, root.clientHeight);
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        const observer = new ResizeObserver(resize);
        observer.observe(root);
        resize();

        const animate = () => {
          controls.update();
          renderer.render(scene, camera);
          requestAnimationFrame(animate);
        };
        animate();
      } catch {
        if (status instanceof HTMLElement) status.textContent = '3D-katselinta ei voitu ladata';
      }
    });
  })();
</script>
