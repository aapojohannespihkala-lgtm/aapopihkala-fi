---
interface Props {
  class?: string;
  autoRotate?: boolean;
  animate?: boolean;
  showContours?: boolean;
  enableZoom?: boolean;
  scale?: number;
}

const {
  class: className,
  autoRotate = true,
  animate = true,
  showContours = true,
  enableZoom = true,
  scale = 1,
} = Astro.props;
---

<div
  class:list={['river-flow', className]}
  data-river-flow
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-animate={animate ? 'true' : 'false'}
  data-show-contours={showContours ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-scale={scale}
  aria-hidden="true"
>
  <canvas class="river-flow__canvas" data-river-flow-canvas></canvas>
</div>

<style>
  .river-flow {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 300px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .river-flow:active {
    cursor: grabbing;
  }

  .river-flow__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-river-flow]');

    roots.forEach(async (root) => {
      if (root.dataset.riverFlowInitialized === 'true') return;
      root.dataset.riverFlowInitialized = 'true';

      const canvas = root.querySelector('[data-river-flow-canvas]');
      if (!canvas) return;

      try {
        const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/+esm');
        const { OrbitControls } = await import(
          'https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js/+esm'
        );

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const wantsAutoRotate = root.dataset.autoRotate !== 'false';
        const wantsAnimation = root.dataset.animate !== 'false' && !reducedMotion;
        const wantsContours = root.dataset.showContours !== 'false';
        const wantsZoom = root.dataset.enableZoom !== 'false';
        const requestedScale = Number(root.dataset.scale ?? '1');
        const displayScale = Number.isFinite(requestedScale) ? requestedScale : 1;

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
        renderer.setClearColor(0xffffff, 0);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
        camera.position.set(4.35, 3.35, 5.55);

        const landscape = new THREE.Group();
        landscape.scale.setScalar(displayScale);
        landscape.rotation.z = -0.055;
        landscape.rotation.y = -0.04;
        scene.add(landscape);

        const controls = new OrbitControls(camera, renderer.domElement);
        controls.enablePan = false;
        controls.enableZoom = wantsZoom;
        controls.enableDamping = true;
        controls.dampingFactor = 0.055;
        controls.rotateSpeed = 0.56;
        controls.target.set(0, 0.03, 0);
        controls.autoRotate = wantsAutoRotate && !reducedMotion;
        controls.autoRotateSpeed = 0.34;

        if (wantsZoom) {
          controls.minDistance = 6.1;
          controls.maxDistance = 9.4;
          controls.zoomSpeed = 0.52;
        } else {
          const direction = camera.position.clone().sub(controls.target).normalize();
          camera.position.copy(controls.target).add(direction.multiplyScalar(7.25));
          controls.minDistance = 7.25;
          controls.maxDistance = 7.25;
        }

        const terrainWidth = 4.15;
        const terrainDepth = 3.05;
        const columns = 94;
        const rows = 70;
        const cellWidth = terrainWidth / columns;
        const cellDepth = terrainDepth / rows;

        const heights = Array.from({ length: rows + 1 }, () => Array(columns + 1).fill(0));
        const insideMask = Array.from({ length: rows + 1 }, () => Array(columns + 1).fill(false));

        const boundaryRadius = (angle, phase) =>
          0.9 +
          0.055 * Math.sin(angle * 2.2 + 0.45 + phase * 0.035) +
          0.032 * Math.cos(angle * 4.1 - 0.75 - phase * 0.025) +
          0.018 * Math.sin(angle * 6.8 + 0.9 + phase * 0.04);

        const radialData = (x, z, phase) => {
          const sx = x / (terrainWidth * 0.5);
          const sz = z / (terrainDepth * 0.5);
          const angle = Math.atan2(sz, sx);
          return {
            radius: Math.sqrt(sx * sx + sz * sz),
            edge: boundaryRadius(angle, phase),
          };
        };

        const isInside = (x, z, phase) => {
          const { radius, edge } = radialData(x, z, phase);
          return radius < edge;
        };

        const edgeFade = (x, z, phase) => {
          const { radius, edge } = radialData(x, z, phase);
          if (radius >= edge) return 0;
          return 1 - THREE.MathUtils.smoothstep(radius, edge - 0.13, edge);
        };

        const riverCenter = (x, phase) =>
          0.1 +
          0.19 * Math.sin(x * 1.4 + 0.45 + phase * 0.055) +
          0.085 * Math.sin(x * 2.75 - 0.7 - phase * 0.035);

        const riverWidth = (x, phase) =>
          0.145 +
          0.042 * Math.sin(x * 1.65 - 0.4 + phase * 0.06) +
          0.018 * Math.cos(x * 3.1 + 0.55 - phase * 0.04);

        const terrainHeight = (x, z, phase) => {
          const hillA =
            (0.38 + 0.055 * Math.sin(phase * 0.17)) *
            Math.exp(-((x + 0.85) ** 2 * 1.45 + (z - 0.55) ** 2 * 2.4));

          const hillB =
            (0.3 + 0.04 * Math.cos(phase * 0.13 + 0.6)) *
            Math.exp(-((x - 0.88) ** 2 * 1.7 + (z + 0.52) ** 2 * 2.8));

          const shoulder =
            0.12 *
            Math.exp(-((x - 0.05) ** 2 * 0.85 + (z - 0.78) ** 2 * 3.1));

          const broadForm =
            0.045 * Math.sin(x * 1.1 + z * 0.72 + phase * 0.08) +
            0.032 * Math.cos(z * 1.55 - x * 0.34 - phase * 0.065);

          const center = riverCenter(x, phase);
          const width = Math.max(0.08, riverWidth(x, phase));
          const channelDistance = (z - center) / width;
          const channel = -0.115 * Math.exp(-(channelDistance * channelDistance) * 1.65);
          const valley = -0.055 * Math.exp(-(channelDistance * channelDistance) * 0.34);

          const fade = edgeFade(x, z, phase);
          return (hillA + hillB + shoulder + broadForm + channel + valley) * (0.5 + 0.5 * fade);
        };

        const terrainGeometry = new THREE.BufferGeometry();
        const terrainMaterial = new THREE.PointsMaterial({
          color: 0x353832,
          size: 0.023,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.58,
        });
        const terrainPoints = new THREE.Points(terrainGeometry, terrainMaterial);
        landscape.add(terrainPoints);

        const contourGroup = new THREE.Group();
        contourGroup.visible = wantsContours;
        landscape.add(contourGroup);

        const clearContours = () => {
          for (const child of [...contourGroup.children]) {
            child.geometry.dispose();
            child.material.dispose();
            contourGroup.remove(child);
          }
        };

        const interpolate = (level, a, b, ha, hb) => {
          const delta = hb - ha;
          const amount = Math.abs(delta) < 1e-8 ? 0.5 : (level - ha) / delta;
          return {
            x: THREE.MathUtils.lerp(a.x, b.x, amount),
            z: THREE.MathUtils.lerp(a.z, b.z, amount),
          };
        };

        let contourLevels = null;

        const createContourLevels = (minHeight, maxHeight) => {
          const count = 8;
          const low = minHeight + (maxHeight - minHeight) * 0.13;
          const high = maxHeight - (maxHeight - minHeight) * 0.1;
          return Array.from({ length: count }, (_, index) =>
            THREE.MathUtils.lerp(low, high, index / (count - 1))
          );
        };

        const rebuildContours = () => {
          clearContours();
          if (!wantsContours || !contourLevels) return;

          contourLevels.forEach((level, contourIndex) => {
            const positions = [];
            const addSegment = (a, b) => {
              positions.push(a.x, level + 0.009, a.z, b.x, level + 0.009, b.z);
            };

            for (let row = 0; row < rows; row += 1) {
              const z0 = -terrainDepth / 2 + cellDepth * row;
              const z1 = z0 + cellDepth;

              for (let column = 0; column < columns; column += 1) {
                if (
                  !insideMask[row][column] ||
                  !insideMask[row][column + 1] ||
                  !insideMask[row + 1][column + 1] ||
                  !insideMask[row + 1][column]
                ) continue;

                const x0 = -terrainWidth / 2 + cellWidth * column;
                const x1 = x0 + cellWidth;
                const h0 = heights[row][column];
                const h1 = heights[row][column + 1];
                const h2 = heights[row + 1][column + 1];
                const h3 = heights[row + 1][column];
                const p0 = { x: x0, z: z0 };
                const p1 = { x: x1, z: z0 };
                const p2 = { x: x1, z: z1 };
                const p3 = { x: x0, z: z1 };
                const hits = [];

                if ((h0 < level) !== (h1 < level)) hits.push(interpolate(level, p0, p1, h0, h1));
                if ((h1 < level) !== (h2 < level)) hits.push(interpolate(level, p1, p2, h1, h2));
                if ((h2 < level) !== (h3 < level)) hits.push(interpolate(level, p2, p3, h2, h3));
                if ((h3 < level) !== (h0 < level)) hits.push(interpolate(level, p3, p0, h3, h0));

                if (hits.length === 2) {
                  addSegment(hits[0], hits[1]);
                } else if (hits.length === 4) {
                  const center = (h0 + h1 + h2 + h3) / 4;
                  if (center >= level) {
                    addSegment(hits[0], hits[3]);
                    addSegment(hits[1], hits[2]);
                  } else {
                    addSegment(hits[0], hits[1]);
                    addSegment(hits[2], hits[3]);
                  }
                }
              }
            }

            if (!positions.length) return;

            const geometry = new THREE.BufferGeometry();
            geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
            const material = new THREE.LineBasicMaterial({
              color: 0x657168,
              transparent: true,
              opacity: contourIndex % 3 === 0 ? 0.42 : 0.22,
            });
            contourGroup.add(new THREE.LineSegments(geometry, material));
          });
        };

        const rebuildTerrain = (phase, establishLevels = false) => {
          const positions = [];
          let minHeight = Infinity;
          let maxHeight = -Infinity;

          for (let row = 0; row <= rows; row += 1) {
            const z = -terrainDepth / 2 + cellDepth * row;
            for (let column = 0; column <= columns; column += 1) {
              const x = -terrainWidth / 2 + cellWidth * column;
              const inside = isInside(x, z, phase);
              insideMask[row][column] = inside;

              const height = terrainHeight(x, z, phase);
              heights[row][column] = height;
              if (!inside) continue;

              positions.push(x, height, z);
              minHeight = Math.min(minHeight, height);
              maxHeight = Math.max(maxHeight, height);
            }
          }

          terrainGeometry.setAttribute(
            'position',
            new THREE.Float32BufferAttribute(positions, 3)
          );

          if (establishLevels || !contourLevels) {
            contourLevels = createContourLevels(minHeight, maxHeight);
          }

          rebuildContours();
        };

        const waterCount = 238;
        const waterPositions = new Float32Array(waterCount * 3);
        const waterProgress = new Float32Array(waterCount);
        const waterLateral = new Float32Array(waterCount);
        const waterSpeed = new Float32Array(waterCount);
        const waterPhase = new Float32Array(waterCount);

        const fract = (value) => value - Math.floor(value);
        const hash = (value) => fract(Math.sin(value * 12.9898 + 78.233) * 43758.5453);

        for (let i = 0; i < waterCount; i += 1) {
          const lateral = hash(i + 8.2) * 2 - 1;
          waterProgress[i] = fract(i / waterCount + hash(i + 2.7) * 0.045);
          waterLateral[i] = lateral;
          waterSpeed[i] =
            0.032 +
            0.025 * (1 - Math.abs(lateral)) +
            0.005 * hash(i + 19.4);
          waterPhase[i] = hash(i + 31.8) * Math.PI * 2;
        }

        const waterGeometry = new THREE.BufferGeometry();
        const waterAttribute = new THREE.BufferAttribute(waterPositions, 3);
        waterAttribute.setUsage(THREE.DynamicDrawUsage);
        waterGeometry.setAttribute('position', waterAttribute);

        const waterMaterial = new THREE.PointsMaterial({
          color: 0x718278,
          size: 0.035,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.9,
        });
        landscape.add(new THREE.Points(waterGeometry, waterMaterial));

        const flowStartX = -1.78;
        const flowEndX = 1.78;

        const updateWater = (timeSeconds, deltaSeconds, phase) => {
          for (let i = 0; i < waterCount; i += 1) {
            if (wantsAnimation) {
              waterProgress[i] = fract(
                waterProgress[i] + waterSpeed[i] * Math.min(deltaSeconds, 0.05)
              );
            }

            const progress = waterProgress[i];
            const xCenter = THREE.MathUtils.lerp(flowStartX, flowEndX, progress);
            const zCenter = riverCenter(xCenter, phase);
            const sampleDistance = 0.012;
            const zBefore = riverCenter(xCenter - sampleDistance, phase);
            const zAfter = riverCenter(xCenter + sampleDistance, phase);
            const dzdx = (zAfter - zBefore) / (sampleDistance * 2);
            const normalLength = Math.sqrt(1 + dzdx * dzdx) || 1;
            const normalX = -dzdx / normalLength;
            const normalZ = 1 / normalLength;

            const baseLateral = waterLateral[i];
            const lateralDrift = wantsAnimation
              ? 0.075 *
                Math.sin(timeSeconds * 0.75 + waterPhase[i] + progress * Math.PI * 3) *
                (1 - Math.abs(baseLateral))
              : 0;
            const lateral = THREE.MathUtils.clamp(baseLateral + lateralDrift, -1, 1);
            const width = Math.max(0.08, riverWidth(xCenter, phase));
            const lateralDistance = lateral * width * 0.82;

            const x = xCenter + normalX * lateralDistance;
            const z = zCenter + normalZ * lateralDistance;
            const waterSurface = terrainHeight(xCenter, zCenter, phase) + 0.055;
            const microWave = wantsAnimation
              ? 0.006 * Math.sin(timeSeconds * 2.0 + waterPhase[i] + progress * 11)
              : 0;

            const offset = i * 3;
            waterPositions[offset] = x;
            waterPositions[offset + 1] = waterSurface + microWave;
            waterPositions[offset + 2] = z;
          }

          waterAttribute.needsUpdate = true;
        };

        const resize = () => {
          const rect = root.getBoundingClientRect();
          const width = Math.max(1, Math.round(rect.width));
          const height = Math.max(1, Math.round(rect.height));
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(root);
        resize();

        let isVisible = true;
        let isDocumentVisible = !document.hidden;
        let animationFrame = 0;
        let lastFrameTime = 0;
        let lastTerrainUpdate = -Infinity;
        let terrainPhase = 0;

        rebuildTerrain(0, true);
        updateWater(0, 0, 0);

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting);
          },
          { rootMargin: '160px' }
        );
        intersectionObserver.observe(root);

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden;
          if (isDocumentVisible) lastFrameTime = 0;
        };
        document.addEventListener('visibilitychange', handleVisibility);

        const animateFrame = (time) => {
          animationFrame = requestAnimationFrame(animateFrame);
          if (!isVisible || !isDocumentVisible) {
            lastFrameTime = time;
            return;
          }

          const timeSeconds = time * 0.001;
          const deltaSeconds = lastFrameTime ? (time - lastFrameTime) * 0.001 : 0;
          lastFrameTime = time;

          controls.update();

          if (wantsAnimation) {
            terrainPhase = timeSeconds * 0.48;
          }

          if (wantsAnimation && time - lastTerrainUpdate >= 115) {
            rebuildTerrain(terrainPhase);
            lastTerrainUpdate = time;
          }

          updateWater(timeSeconds, deltaSeconds, terrainPhase);
          renderer.render(scene, camera);
        };

        animationFrame = requestAnimationFrame(animateFrame);

        const cleanup = () => {
          cancelAnimationFrame(animationFrame);
          document.removeEventListener('visibilitychange', handleVisibility);
          resizeObserver.disconnect();
          intersectionObserver.disconnect();
          controls.dispose();
          clearContours();
          terrainGeometry.dispose();
          terrainMaterial.dispose();
          waterGeometry.dispose();
          waterMaterial.dispose();
          renderer.dispose();
        };

        window.addEventListener('pagehide', cleanup, { once: true });
      } catch (error) {
        console.error('RiverFlow failed to initialize:', error);
      }
    });
  })();
</script>
