---
interface Props {
  class?: string;
  autoRotate?: boolean;
  animate?: boolean;
  showContours?: boolean;
  enableZoom?: boolean;
  scale?: number;
}

const {
  class: className,
  autoRotate = true,
  animate = true,
  showContours = true,
  enableZoom = true,
  scale = 1,
} = Astro.props;
---

<div
  class:list={['river-flow', className]}
  data-river-flow
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-animate={animate ? 'true' : 'false'}
  data-show-contours={showContours ? 'true' : 'false'}
  data-enable-zoom={enableZoom ? 'true' : 'false'}
  data-scale={scale}
  aria-hidden="true"
>
  <canvas class="river-flow__canvas" data-river-flow-canvas></canvas>
</div>

<style>
  .river-flow {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 300px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .river-flow:active {
    cursor: grabbing;
  }

  .river-flow__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    touch-action: none;
  }
</style>

<script>
  import { THREE, OrbitControls } from '../scripts/threeRuntime';

  type ContourPoint = {
    x: number;
    z: number;
  };

  (() => {
    const roots = document.querySelectorAll<HTMLElement>('[data-river-flow]');

    roots.forEach(async (root) => {
      if (root.dataset.riverFlowInitialized === 'true') return;
      root.dataset.riverFlowInitialized = 'true';

      const canvas = root.querySelector<HTMLCanvasElement>('[data-river-flow-canvas]');
      if (!canvas) return;

      try {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const wantsAutoRotate = root.dataset.autoRotate !== 'false';
        const wantsAnimation = root.dataset.animate !== 'false' && !reducedMotion;
        const wantsContours = root.dataset.showContours !== 'false';
        const wantsZoom = root.dataset.enableZoom !== 'false';
        const requestedScale = Number(root.dataset.scale ?? '1');
        const displayScale = Number.isFinite(requestedScale) ? requestedScale : 1;

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
        renderer.setClearColor(0xffffff, 0);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
        camera.position.set(4.45, 3.15, 5.7);

        const waterGroup = new THREE.Group();
        waterGroup.scale.setScalar(displayScale);
        waterGroup.rotation.z = -0.045;
        waterGroup.rotation.y = -0.035;
        scene.add(waterGroup);

        const controls = new OrbitControls(camera, renderer.domElement);
        controls.enablePan = false;
        controls.enableZoom = wantsZoom;
        controls.enableDamping = true;
        controls.dampingFactor = 0.055;
        controls.rotateSpeed = 0.56;
        controls.target.set(0, 0.01, 0);
        controls.autoRotate = wantsAutoRotate && !reducedMotion;
        controls.autoRotateSpeed = 0.28;

        if (wantsZoom) {
          controls.minDistance = 6.0;
          controls.maxDistance = 9.5;
          controls.zoomSpeed = 0.52;
        } else {
          const direction = camera.position.clone().sub(controls.target).normalize();
          camera.position.copy(controls.target).add(direction.multiplyScalar(7.3));
          controls.minDistance = 7.3;
          controls.maxDistance = 7.3;
        }

        const fieldHalfWidth = 2.24;
        const fieldHalfDepth = 1.78;
        const columns = 106;
        const rows = 84;
        const cellWidth = (fieldHalfWidth * 2) / columns;
        const cellDepth = (fieldHalfDepth * 2) / rows;

        const heights = Array.from(
          { length: rows + 1 },
          () => new Float32Array(columns + 1)
        );
        const riverMask: boolean[][] = Array.from(
          { length: rows + 1 },
          () => Array<boolean>(columns + 1).fill(false)
        );
        const outerMask: boolean[][] = Array.from(
          { length: rows + 1 },
          () => Array<boolean>(columns + 1).fill(false)
        );
        const worldX = Array.from(
          { length: rows + 1 },
          () => new Float32Array(columns + 1)
        );
        const worldZ = Array.from(
          { length: rows + 1 },
          () => new Float32Array(columns + 1)
        );
        const lateralField = Array.from(
          { length: rows + 1 },
          () => new Float32Array(columns + 1)
        );
        const progressField = Array.from(
          { length: rows + 1 },
          () => new Float32Array(columns + 1)
        );

        const fieldBoundary = (angle: number) =>
          0.955 +
          0.032 * Math.sin(angle * 2.15 + 0.4) +
          0.02 * Math.sin(angle * 4.6 - 0.9) +
          0.013 * Math.cos(angle * 7.7 + 0.65) +
          0.008 * Math.sin(angle * 12.2 - 0.25) +
          0.005 * Math.cos(angle * 18.4 + 0.8);

        const centerline = (x: number) =>
          0.06 +
          0.3 * Math.sin(x * 1.08 + 0.42) +
          0.115 * Math.sin(x * 2.4 - 0.78);

        const riverWidth = (x: number) =>
          0.48 +
          0.105 * Math.sin(x * 1.42 - 0.52) +
          0.052 * Math.cos(x * 2.65 + 0.38);

        const bankRaggedness = (u: number, side: number) =>
          1 +
          0.095 * Math.sin(u * Math.PI * 5.4 + side * 1.2 + 0.45) +
          0.058 * Math.sin(u * Math.PI * 11.2 - side * 0.8 + 1.1) +
          0.034 * Math.cos(u * Math.PI * 22.8 + side * 1.9 - 0.4) +
          0.022 * Math.sin(u * Math.PI * 35.6 - side * 2.1 + 0.7) +
          0.012 * Math.cos(u * Math.PI * 51.4 + side * 0.35 - 0.2);

        const waterHeight = (u: number, lateral: number, phase: number) => {
          const flow = u * Math.PI * 2;
          const edgeDistance = Math.min(1, Math.abs(lateral));
          const motionMask = Math.pow(Math.max(0, 1 - edgeDistance), 0.58);
          const centerBias =
            0.62 +
            0.38 * Math.pow(Math.max(0, 1 - edgeDistance), 0.55);

          const broadWave =
            0.105 * Math.sin(flow * 1.55 - phase * 1.38 + lateral * 0.52);
          const midWave =
            0.057 * Math.sin(flow * 3.05 - phase * 2.2 - lateral * 1.35);
          const fineWave =
            0.028 * Math.cos(flow * 5.15 - phase * 3.05 + lateral * 2.4);
          const crossCurrent =
            0.036 * Math.sin(
              flow * 1.15 + lateral * Math.PI * 1.7 - phase * 1.05
            );
          const slowBody =
            0.044 * Math.cos(flow * 0.72 - phase * 0.58 + lateral * 0.75);

          return (
            (broadWave + midWave + fineWave + crossCurrent) * centerBias +
            slowBody
          ) * motionMask;
        };

        const classifyPoint = (x: number, z: number) => {
          const sx = x / fieldHalfWidth;
          const sz = z / fieldHalfDepth;
          const angle = Math.atan2(sz, sx);
          const radius = Math.sqrt(sx * sx + sz * sz);
          const insideOuter = radius < fieldBoundary(angle);

          const u = THREE.MathUtils.clamp(
            (x + fieldHalfWidth) / (fieldHalfWidth * 2),
            0,
            1
          );
          const side = z >= centerline(x) ? 1 : -1;
          const width = Math.max(0.3, riverWidth(x));
          const localWidth = width * bankRaggedness(u, side);
          const signedLateral = (z - centerline(x)) / Math.max(0.001, localWidth);
          const insideRiver = insideOuter && Math.abs(signedLateral) <= 1;

          return {
            insideOuter,
            insideRiver,
            u,
            lateral: signedLateral,
          };
        };

        const pointIndex = Array.from(
          { length: rows + 1 },
          () => new Int32Array(columns + 1).fill(-1)
        );
        const basePositions: number[] = [];
        let visiblePointCount = 0;

        for (let row = 0; row <= rows; row += 1) {
          const z = -fieldHalfDepth + cellDepth * row;

          for (let column = 0; column <= columns; column += 1) {
            const x = -fieldHalfWidth + cellWidth * column;
            const classification = classifyPoint(x, z);

            worldX[row][column] = x;
            worldZ[row][column] = z;
            outerMask[row][column] = classification.insideOuter;
            riverMask[row][column] = classification.insideRiver;
            lateralField[row][column] = classification.lateral;
            progressField[row][column] = classification.u;

            if (!classification.insideOuter) continue;

            pointIndex[row][column] = visiblePointCount;
            basePositions.push(x, 0, z);
            visiblePointCount += 1;
          }
        }

        const positions = new Float32Array(basePositions);
        const fieldGeometry = new THREE.BufferGeometry();
        const fieldAttribute = new THREE.BufferAttribute(positions, 3);
        fieldAttribute.setUsage(THREE.DynamicDrawUsage);
        fieldGeometry.setAttribute('position', fieldAttribute);

        const fieldMaterial = new THREE.PointsMaterial({
          color: 0x56635b,
          size: 0.021,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.56,
        });
        waterGroup.add(new THREE.Points(fieldGeometry, fieldMaterial));

        const contourGroup = new THREE.Group();
        contourGroup.visible = wantsContours;
        waterGroup.add(contourGroup);

        const clearContours = () => {
          for (const child of [...contourGroup.children]) {
            if (child instanceof THREE.LineSegments) {
              child.geometry.dispose();
              const materials = Array.isArray(child.material)
                ? child.material
                : [child.material];
              materials.forEach((material) => material.dispose());
            }
            contourGroup.remove(child);
          }
        };

        const interpolate = (
          level: number,
          a: ContourPoint,
          b: ContourPoint,
          ha: number,
          hb: number
        ): ContourPoint => {
          const delta = hb - ha;
          const amount = Math.abs(delta) < 1e-8 ? 0.5 : (level - ha) / delta;
          return {
            x: THREE.MathUtils.lerp(a.x, b.x, amount),
            z: THREE.MathUtils.lerp(a.z, b.z, amount),
          };
        };

        const createContourLevels = (minHeight: number, maxHeight: number) => {
          const count = 10;
          const low = minHeight + (maxHeight - minHeight) * 0.09;
          const high = maxHeight - (maxHeight - minHeight) * 0.09;
          return Array.from({ length: count }, (_, index) =>
            THREE.MathUtils.lerp(low, high, index / (count - 1))
          );
        };

        const rebuildSurface = (phase: number) => {
          let minHeight = Infinity;
          let maxHeight = -Infinity;

          for (let row = 0; row <= rows; row += 1) {
            for (let column = 0; column <= columns; column += 1) {
              if (!outerMask[row][column]) continue;

              const index = pointIndex[row][column];
              const offset = index * 3;
              let height = 0;

              if (riverMask[row][column]) {
                height = waterHeight(
                  progressField[row][column],
                  lateralField[row][column],
                  phase
                );
                minHeight = Math.min(minHeight, height);
                maxHeight = Math.max(maxHeight, height);
              }

              heights[row][column] = height;
              positions[offset + 1] = height;
            }
          }

          fieldAttribute.needsUpdate = true;

          if (!Number.isFinite(minHeight) || !Number.isFinite(maxHeight)) {
            return { minHeight: -0.1, maxHeight: 0.1 };
          }

          return { minHeight, maxHeight };
        };

        const rebuildContours = (minHeight: number, maxHeight: number) => {
          clearContours();
          if (!wantsContours) return;

          const contourLevels = createContourLevels(minHeight, maxHeight);

          contourLevels.forEach((level, contourIndex) => {
            const linePositions: number[] = [];

            const addSegment = (a: ContourPoint, b: ContourPoint) => {
              linePositions.push(
                a.x,
                level + 0.006,
                a.z,
                b.x,
                level + 0.006,
                b.z
              );
            };

            for (let row = 0; row < rows; row += 1) {
              for (let column = 0; column < columns; column += 1) {
                if (
                  !riverMask[row][column] ||
                  !riverMask[row][column + 1] ||
                  !riverMask[row + 1][column + 1] ||
                  !riverMask[row + 1][column]
                ) continue;

                const h0 = heights[row][column];
                const h1 = heights[row][column + 1];
                const h2 = heights[row + 1][column + 1];
                const h3 = heights[row + 1][column];

                const p0 = { x: worldX[row][column], z: worldZ[row][column] };
                const p1 = { x: worldX[row][column + 1], z: worldZ[row][column + 1] };
                const p2 = {
                  x: worldX[row + 1][column + 1],
                  z: worldZ[row + 1][column + 1],
                };
                const p3 = { x: worldX[row + 1][column], z: worldZ[row + 1][column] };
                const hits: ContourPoint[] = [];

                if ((h0 < level) !== (h1 < level)) {
                  hits.push(interpolate(level, p0, p1, h0, h1));
                }
                if ((h1 < level) !== (h2 < level)) {
                  hits.push(interpolate(level, p1, p2, h1, h2));
                }
                if ((h2 < level) !== (h3 < level)) {
                  hits.push(interpolate(level, p2, p3, h2, h3));
                }
                if ((h3 < level) !== (h0 < level)) {
                  hits.push(interpolate(level, p3, p0, h3, h0));
                }

                if (hits.length === 2) {
                  addSegment(hits[0], hits[1]);
                } else if (hits.length === 4) {
                  const center = (h0 + h1 + h2 + h3) / 4;
                  if (center >= level) {
                    addSegment(hits[0], hits[3]);
                    addSegment(hits[1], hits[2]);
                  } else {
                    addSegment(hits[0], hits[1]);
                    addSegment(hits[2], hits[3]);
                  }
                }
              }
            }

            if (!linePositions.length) return;

            const geometry = new THREE.BufferGeometry();
            geometry.setAttribute(
              'position',
              new THREE.Float32BufferAttribute(linePositions, 3)
            );
            const material = new THREE.LineBasicMaterial({
              color: 0x657168,
              transparent: true,
              opacity: contourIndex % 3 === 0 ? 0.58 : 0.32,
            });
            contourGroup.add(new THREE.LineSegments(geometry, material));
          });
        };

        const resize = () => {
          const rect = root.getBoundingClientRect();
          const width = Math.max(1, Math.round(rect.width));
          const height = Math.max(1, Math.round(rect.height));
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(root);
        resize();

        let isVisible = true;
        let isDocumentVisible = !document.hidden;
        let animationFrame = 0;
        let lastSurfaceUpdate = -Infinity;
        let lastContourUpdate = -Infinity;
        let currentRange = rebuildSurface(0);
        rebuildContours(currentRange.minHeight, currentRange.maxHeight);

        const intersectionObserver = new IntersectionObserver(
          (entries) => {
            isVisible = entries.some((entry) => entry.isIntersecting);
          },
          { rootMargin: '160px' }
        );
        intersectionObserver.observe(root);

        const handleVisibility = () => {
          isDocumentVisible = !document.hidden;
        };
        document.addEventListener('visibilitychange', handleVisibility);

        const animateFrame = (time: number) => {
          animationFrame = requestAnimationFrame(animateFrame);
          if (!isVisible || !isDocumentVisible) return;

          controls.update();

          const phase = wantsAnimation ? time * 0.001 : 0;

          if (wantsAnimation && time - lastSurfaceUpdate >= 48) {
            currentRange = rebuildSurface(phase);
            lastSurfaceUpdate = time;
          }

          if (wantsAnimation && wantsContours && time - lastContourUpdate >= 105) {
            rebuildContours(currentRange.minHeight, currentRange.maxHeight);
            lastContourUpdate = time;
          }

          renderer.render(scene, camera);
        };

        animationFrame = requestAnimationFrame(animateFrame);

        const cleanup = () => {
          cancelAnimationFrame(animationFrame);
          document.removeEventListener('visibilitychange', handleVisibility);
          resizeObserver.disconnect();
          intersectionObserver.disconnect();
          controls.dispose();
          clearContours();
          fieldGeometry.dispose();
          fieldMaterial.dispose();
          renderer.dispose();
        };

        window.addEventListener('pagehide', cleanup, { once: true });
      } catch (error) {
        console.error('RiverFlow failed to initialize:', error);
      }
    });
  })();
</script>