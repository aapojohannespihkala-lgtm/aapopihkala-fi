<style is:global>
  html body .hero-primary.hero-section-ready {
    position: relative;
    overflow: visible;
  }

  html body .hero-section-easter {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }

  html body .hero-section-easter__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  html body .hero-section-easter__text {
    position: relative;
    z-index: 2;
    display: inline-block;
  }

  html body .hero-section-easter__char {
    display: inline-block;
    transform: translateY(0);
    transition: transform 250ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0ms;
    will-change: transform;
  }

  html body .hero-section-easter__meta {
    position: absolute;
    left: 0;
    top: -1.05rem;
    z-index: 1;
    color: var(--moss);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.43rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.065em;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(2px);
    transition:
      opacity 130ms linear,
      transform 210ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  html body .hero-section-easter__profile {
    position: absolute;
    left: -3px;
    bottom: -0.58rem;
    z-index: 1;
    width: calc(100% + 6px);
    height: 1.2rem;
    overflow: visible;
    opacity: 0;
    transform: translateY(2px);
    transition:
      opacity 120ms linear,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  html body .hero-section-easter__datum,
  html body .hero-section-easter__ground,
  html body .hero-section-easter__cut {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  html body .hero-section-easter__datum {
    stroke: rgba(89, 105, 93, 0.28);
    stroke-width: 0.62px;
    stroke-dasharray: 2.2 3.2;
  }

  html body .hero-section-easter__ground {
    stroke: rgba(73, 88, 77, 0.72);
    stroke-width: 0.78px;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 430ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  html body .hero-section-easter__cut {
    stroke: rgba(89, 105, 93, 0.52);
    stroke-width: 0.68px;
  }

  html body .hero-section-easter__mark,
  html body .hero-section-easter__note {
    position: absolute;
    z-index: 1;
    color: var(--moss);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 130ms linear;
  }

  html body .hero-section-easter__mark {
    top: 50%;
    font-size: 0.43rem;
    letter-spacing: 0.04em;
    transform: translateY(-50%);
  }

  html body .hero-section-easter__mark--left {
    left: -0.78rem;
  }

  html body .hero-section-easter__mark--right {
    right: -0.78rem;
  }

  html body .hero-section-easter__note {
    bottom: -1.22rem;
    font-size: 0.39rem;
    letter-spacing: 0.055em;
  }

  html body .hero-section-easter__note--ground {
    left: 0;
  }

  html body .hero-section-easter__note--water {
    right: 0;
    transform: translateX(72%);
  }

  html body .hero-section-easter:hover .hero-section-easter__char {
    transform: translateY(var(--section-y, 0px));
    transition-delay: var(--section-delay, 0ms);
  }

  html body .hero-section-easter:hover .hero-section-easter__meta,
  html body .hero-section-easter:hover .hero-section-easter__profile,
  html body .hero-section-easter:hover .hero-section-easter__mark,
  html body .hero-section-easter:hover .hero-section-easter__note {
    opacity: 1;
  }

  html body .hero-section-easter:hover .hero-section-easter__meta,
  html body .hero-section-easter:hover .hero-section-easter__profile {
    transform: translateY(0);
  }

  html body .hero-section-easter:hover .hero-section-easter__ground {
    stroke-dashoffset: 0;
  }

  @media (max-width: 640px) {
    html body .hero-section-easter__note--water {
      display: none;
    }

    html body .hero-section-easter__meta {
      font-size: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html body .hero-section-easter__char,
    html body .hero-section-easter__meta,
    html body .hero-section-easter__profile,
    html body .hero-section-easter__ground,
    html body .hero-section-easter__mark,
    html body .hero-section-easter__note {
      transition: none !important;
    }

    html body .hero-section-easter:hover .hero-section-easter__char {
      transform: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const role = document.querySelector('.hero-primary')
    if (!role) return
    if (role.dataset.heroSectionInitialized === 'true') return

    const label = role.textContent?.trim() ?? ''
    if (!label) return

    role.dataset.heroSectionInitialized = 'true'
    role.classList.add('hero-section-ready')

    const trigger = document.createElement('span')
    trigger.className = 'hero-section-easter'

    const accessibleText = document.createElement('span')
    accessibleText.className = 'hero-section-easter__sr'
    accessibleText.textContent = label
    trigger.append(accessibleText)

    const textLayer = document.createElement('span')
    textLayer.className = 'hero-section-easter__text'
    textLayer.setAttribute('aria-hidden', 'true')

    const characters = Array.from(label)
    const divisor = Math.max(1, characters.length - 1)

    characters.forEach((character, index) => {
      const span = document.createElement('span')
      span.className = 'hero-section-easter__char'
      span.textContent = character === ' ' ? '\u00a0' : character

      const progress = index / divisor
      const sectionY =
        Math.sin(progress * Math.PI * 2.25 + 0.35) * 1.55 +
        Math.sin(progress * Math.PI * 5.1 + 0.8) * 0.62

      span.style.setProperty('--section-y', `${sectionY.toFixed(2)}px`)
      span.style.setProperty('--section-delay', `${Math.min(index * 8, 120)}ms`)
      textLayer.append(span)
    })

    trigger.append(textLayer)

    const meta = document.createElement('span')
    meta.className = 'hero-section-easter__meta'
    meta.setAttribute('aria-hidden', 'true')
    meta.textContent = 'SECTION A-A / NTS · CANOPY +4.80'
    trigger.append(meta)

    const svgNamespace = 'http://www.w3.org/2000/svg'
    const profile = document.createElementNS(svgNamespace, 'svg')
    profile.classList.add('hero-section-easter__profile')
    profile.setAttribute('viewBox', '0 0 220 28')
    profile.setAttribute('preserveAspectRatio', 'none')
    profile.setAttribute('aria-hidden', 'true')

    const datum = document.createElementNS(svgNamespace, 'path')
    datum.classList.add('hero-section-easter__datum')
    datum.setAttribute('d', 'M2 20 H218')

    const ground = document.createElementNS(svgNamespace, 'path')
    ground.classList.add('hero-section-easter__ground')
    ground.setAttribute('pathLength', '1')
    ground.setAttribute(
      'd',
      'M2 18 C18 18 27 14 39 15 S62 21 78 16 S101 8 119 11 S145 22 165 16 S198 10 218 13'
    )

    const leftCut = document.createElementNS(svgNamespace, 'path')
    leftCut.classList.add('hero-section-easter__cut')
    leftCut.setAttribute('d', 'M2 8 V24')

    const rightCut = document.createElementNS(svgNamespace, 'path')
    rightCut.classList.add('hero-section-easter__cut')
    rightCut.setAttribute('d', 'M218 7 V24')

    profile.append(datum, ground, leftCut, rightCut)
    trigger.append(profile)

    const leftMark = document.createElement('span')
    leftMark.className = 'hero-section-easter__mark hero-section-easter__mark--left'
    leftMark.setAttribute('aria-hidden', 'true')
    leftMark.textContent = 'A'

    const rightMark = document.createElement('span')
    rightMark.className = 'hero-section-easter__mark hero-section-easter__mark--right'
    rightMark.setAttribute('aria-hidden', 'true')
    rightMark.textContent = 'A'

    const groundNote = document.createElement('span')
    groundNote.className = 'hero-section-easter__note hero-section-easter__note--ground'
    groundNote.setAttribute('aria-hidden', 'true')
    groundNote.textContent = 'GROUND +0.00'

    const waterNote = document.createElement('span')
    waterNote.className = 'hero-section-easter__note hero-section-easter__note--water'
    waterNote.setAttribute('aria-hidden', 'true')
    waterNote.textContent = 'WATER -0.62'

    trigger.append(leftMark, rightMark, groundNote, waterNote)
    role.replaceChildren(trigger)
  })()
</script>
