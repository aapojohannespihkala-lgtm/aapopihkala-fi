<style is:global>
  html body .hero-primary.hero-cad-ready {
    position: relative;
    overflow: visible;
  }

  html body .hero-cad-easter {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }

  html body .hero-cad-easter__text {
    position: relative;
    z-index: 2;
    display: inline-block;
    color: inherit;
    transition: color 110ms linear;
  }

  html body .hero-cad-easter__text::after {
    content: attr(data-selected-label);
    position: absolute;
    inset: 0 auto auto 0;
    z-index: 1;
    display: block;
    color: var(--moss-deep);
    font-weight: 650;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    clip-path: inset(0 100% 0 0);
  }

  html body .hero-cad-easter__selection {
    position: absolute;
    left: -0.34rem;
    right: -0.34rem;
    top: -0.23rem;
    bottom: -0.24rem;
    z-index: 1;
    overflow: visible;
    border: 1px solid rgba(89, 105, 93, 0.2);
    background: transparent;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.992);
    transform-origin: 50% 50%;
    transition:
      opacity 90ms linear,
      transform 150ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  html body .hero-cad-easter__grip {
    position: absolute;
    box-sizing: border-box;
    width: 6px;
    height: 6px;
    border: 1px solid rgba(73, 88, 77, 0.54);
    background: var(--page);
    opacity: 0;
    transform: scale(0.72);
    transition:
      opacity 90ms linear,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  html body .hero-cad-easter__grip--tl {
    left: -3px;
    top: -3px;
    transition-delay: 0ms;
  }

  html body .hero-cad-easter__grip--tr {
    right: -3px;
    top: -3px;
    transition-delay: 36ms;
  }

  html body .hero-cad-easter__grip--br {
    right: -3px;
    bottom: -3px;
    transition-delay: 72ms;
  }

  html body .hero-cad-easter__grip--bl {
    left: -3px;
    bottom: -3px;
    transition-delay: 108ms;
  }

  html body .hero-cad-easter__meta {
    position: absolute;
    left: calc(100% + 0.72rem);
    top: 50%;
    z-index: 3;
    color: var(--moss);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.42rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.065em;
    white-space: nowrap;
    opacity: 0;
    transform: translate(3px, -50%);
    transition:
      opacity 90ms linear,
      transform 160ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  html body .hero-cad-easter__meta::before {
    content: '□';
    margin-right: 0.34rem;
    color: var(--stone-light);
  }

  html body .hero-cad-easter.is-active .hero-cad-easter__selection,
  html body .hero-cad-easter.is-active .hero-cad-easter__meta {
    opacity: 1;
  }

  html body .hero-cad-easter.is-active .hero-cad-easter__selection {
    transform: scale(1);
  }

  html body .hero-cad-easter.is-active .hero-cad-easter__grip {
    opacity: 1;
    transform: scale(1);
  }

  html body .hero-cad-easter.is-active .hero-cad-easter__text {
    color: var(--stone-light);
  }

  html body .hero-cad-easter.is-active .hero-cad-easter__text::after {
    opacity: 1;
    animation: hero-cad-text-selection 480ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  html body .hero-cad-easter.is-active .hero-cad-easter__meta {
    transform: translate(0, -50%);
  }

  @keyframes hero-cad-text-selection {
    0% {
      clip-path: inset(0 100% 0 0);
    }

    72% {
      clip-path: inset(0 0 0 0);
    }

    100% {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (max-width: 640px) {
    html body .hero-cad-easter__meta {
      left: 0;
      top: auto;
      bottom: -1.12rem;
      transform: translate(0, 2px);
      font-size: 0.39rem;
    }

    html body .hero-cad-easter.is-active .hero-cad-easter__meta {
      transform: translate(0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html body .hero-cad-easter__selection,
    html body .hero-cad-easter__grip,
    html body .hero-cad-easter__text,
    html body .hero-cad-easter__meta {
      transition: none !important;
    }

    html body .hero-cad-easter.is-active .hero-cad-easter__text::after {
      animation: none !important;
      clip-path: inset(0 0 0 0);
    }
  }
</style>

<script is:inline>
  (() => {
    const role = document.querySelector('.hero-primary')
    if (!role) return
    if (role.dataset.heroCadInitialized === 'true') return

    const label = role.textContent?.trim() ?? ''
    if (!label) return

    role.dataset.heroCadInitialized = 'true'
    role.classList.add('hero-cad-ready')

    const trigger = document.createElement('span')
    trigger.className = 'hero-cad-easter'

    const text = document.createElement('span')
    text.className = 'hero-cad-easter__text'
    text.textContent = label
    text.dataset.selectedLabel = label

    const selection = document.createElement('span')
    selection.className = 'hero-cad-easter__selection'
    selection.setAttribute('aria-hidden', 'true')

    ;['tl', 'tr', 'bl', 'br'].forEach((corner) => {
      const grip = document.createElement('span')
      grip.className = `hero-cad-easter__grip hero-cad-easter__grip--${corner}`
      selection.append(grip)
    })

    const meta = document.createElement('span')
    meta.className = 'hero-cad-easter__meta'
    meta.setAttribute('aria-hidden', 'true')
    meta.textContent = 'OBJECT 01 / SELECTED'

    trigger.append(text, selection, meta)
    role.replaceChildren(trigger)

    const start = () => {
      trigger.classList.add('is-active')
    }

    const stop = () => {
      trigger.classList.remove('is-active')
    }

    trigger.addEventListener('pointerenter', start)
    trigger.addEventListener('pointerleave', stop)

    window.addEventListener(
      'pagehide',
      () => {
        stop()
        trigger.removeEventListener('pointerenter', start)
        trigger.removeEventListener('pointerleave', stop)
      },
      { once: true }
    )
  })()
</script>
