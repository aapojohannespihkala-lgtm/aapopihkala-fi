---
import '../styles/global.css';

import type {
  CollectionEntry,
} from 'astro:content';

import FeedPost from './FeedPost.astro';
import SiteHeader from './SiteHeader.astro';
import { getPostSlug } from '../utils/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  postNumber: string;
  lang: 'fi' | 'en';
}

const {
  post,
  postNumber,
  lang,
} = Astro.props;

if (
  post.data.status !== 'published' ||
  !post.data.publishedAt
) {
  throw new Error(
    `Published article expected: ${post.id}`
  );
}

const publishedAt =
  post.data.publishedAt;

const localizedPost =
  post.data[lang];

const slug =
  getPostSlug(
    post.id
  );

const isFinnish =
  lang === 'fi';

const dateFormatter =
  isFinnish
    ? new Intl.DateTimeFormat(
        'fi-FI',
        {
          day: 'numeric',
          month: 'numeric',
          year: 'numeric',
        }
      )
    : new Intl.DateTimeFormat(
        'en-GB',
        {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        }
      );

const datePart =
  publishedAt.slice(
    0,
    10
  );

const displayDate =
  dateFormatter.format(
    new Date(
      `${datePart}T12:00:00`
    )
  );

const finnishUrl =
  `https://aapopihkala.fi/artikkelit/${slug}/`;

const englishUrl =
  `https://aapopihkala.fi/en/articles/${slug}/`;

const canonicalUrl =
  isFinnish
    ? finnishUrl
    : englishUrl;

const alternateUrl =
  isFinnish
    ? englishUrl
    : finnishUrl;

const languageHref =
  isFinnish
    ? `/en/articles/${slug}/`
    : `/artikkelit/${slug}/`;

const imageUrl =
  post.data.graphic
    ? `https://aapopihkala.fi${post.data.graphic}`
    : undefined;

const perspectiveLabel =
  isFinnish
    ? 'Näkökulma'
    : 'Perspective';

const sourceLabel =
  isFinnish
    ? 'Lähde'
    : 'Source';

const languageLocale =
  isFinnish
    ? 'fi-FI'
    : 'en-GB';

const openGraphLocale =
  isFinnish
    ? 'fi_FI'
    : 'en_GB';

const alternateOpenGraphLocale =
  isFinnish
    ? 'en_GB'
    : 'fi_FI';

const authorUrl =
  isFinnish
    ? 'https://aapopihkala.fi/'
    : 'https://aapopihkala.fi/en/';

const blogPostingSchema = {
  '@context':
    'https://schema.org',

  '@type':
    'BlogPosting',

  headline:
    localizedPost.title,

  description:
    localizedPost.intro,

  url:
    canonicalUrl,

  mainEntityOfPage: {
    '@type':
      'WebPage',

    '@id':
      canonicalUrl,
  },

  datePublished:
    publishedAt,

  inLanguage:
    languageLocale,

  author: {
    '@type':
      'Person',

    name:
      'Aapo Pihkala',

    url:
      authorUrl,
  },

  keywords:
    localizedPost.tags,

  ...(imageUrl
    ? {
        image:
          imageUrl,
      }
    : {}),
};
---

<!doctype html>

<html lang={lang}>
  <head>
    <meta
      charset="UTF-8"
    />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>
      {localizedPost.title} - Aapo Pihkala
    </title>

    <meta
      name="description"
      content={localizedPost.intro}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <link
      rel="alternate"
      hreflang="fi"
      href={finnishUrl}
    />

    <link
      rel="alternate"
      hreflang="en"
      href={englishUrl}
    />

    <link
      rel="alternate"
      hreflang="x-default"
      href={finnishUrl}
    />

    <meta
      property="og:type"
      content="article"
    />

    <meta
      property="og:site_name"
      content="Aapo Pihkala"
    />

    <meta
      property="og:locale"
      content={openGraphLocale}
    />

    <meta
      property="og:locale:alternate"
      content={alternateOpenGraphLocale}
    />

    <meta
      property="og:title"
      content={localizedPost.title}
    />

    <meta
      property="og:description"
      content={localizedPost.intro}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="article:published_time"
      content={publishedAt}
    />

    {
      localizedPost.tags.map(
        (tag) => (
          <meta
            property="article:tag"
            content={tag}
          />
        )
      )
    }

    {
      imageUrl && (
        <>
          <meta
            property="og:image"
            content={imageUrl}
          />

          {
            localizedPost.graphicAlt && (
              <meta
                property="og:image:alt"
                content={localizedPost.graphicAlt}
              />
            )
          }
        </>
      )
    }

    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        blogPostingSchema
      )}
    />
  </head>

  <body>
    <SiteHeader
      lang={lang}
      languageHref={languageHref}
    />

    <main class="main-container">
      <section class="feed">
        <FeedPost
          post={post}
          lang={lang}
          postNumber={postNumber}
          displayDate={displayDate}
          perspectiveLabel={perspectiveLabel}
          sourceLabel={sourceLabel}
          headingLevel="h1"
        />
      </section>
    </main>
  </body>
</html>
