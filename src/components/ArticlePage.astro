---
import type {
  CollectionEntry,
} from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import FeedPost from './FeedPost.astro';
import NightModeToggle from './NightModeToggle.astro';

import {
  site,
  type SiteLanguage,
} from '../config/site';

import {
  getPostSlug,
} from '../utils/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  postNumber: string;
  lang: SiteLanguage;
}

const {
  post,
  postNumber,
  lang,
} = Astro.props;

if (
  post.data.status !== 'published' ||
  !post.data.publishedAt
) {
  throw new Error(
    `Published article expected: ${post.id}`
  );
}

const publishedAt =
  post.data.publishedAt;

const localizedPost =
  post.data[lang];

const slug =
  getPostSlug(
    post.id
  );

const isFinnish =
  lang === 'fi';

const currentLanguage =
  site.languages[lang];

const alternateLanguage =
  isFinnish
    ? site.languages.en
    : site.languages.fi;

/* =========================================================
   DATE
   ========================================================= */

const dateFormatter =
  new Intl.DateTimeFormat(
    currentLanguage.locale,
    isFinnish
      ? {
          day: 'numeric',
          month: 'numeric',
          year: 'numeric',
        }
      : {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        }
  );

const datePart =
  publishedAt.slice(
    0,
    10
  );

const displayDate =
  dateFormatter.format(
    new Date(
      `${datePart}T12:00:00`
    )
  );

/* =========================================================
   URLS
   ========================================================= */

const finnishPath =
  `/artikkelit/${slug}/`;

const englishPath =
  `/en/articles/${slug}/`;

const finnishUrl =
  `${site.url}${finnishPath}`;

const englishUrl =
  `${site.url}${englishPath}`;

const canonicalUrl =
  isFinnish
    ? finnishUrl
    : englishUrl;

const languageHref =
  isFinnish
    ? englishPath
    : finnishPath;

/* =========================================================
   META
   ========================================================= */

const metaDescription =
  localizedPost.metaDescription ??
  localizedPost.intro;

const metaImageUrl =
  `${site.url}${site.metaImage}`;

const metaImageAlt =
  isFinnish
    ? 'Aapo Pihkala - topografinen viivagrafiikka'
    : 'Aapo Pihkala - topographic line graphic';

/* =========================================================
   CONTENT LABELS
   ========================================================= */

const perspectiveLabel =
  isFinnish
    ? 'Näkökulma'
    : 'Perspective';

const sourceLabel =
  isFinnish
    ? 'Lähde'
    : 'Source';

/* =========================================================
   STRUCTURED DATA
   ========================================================= */

const authorUrl =
  `${site.url}${currentLanguage.homePath}`;

const blogPostingSchema = {
  '@context':
    'https://schema.org',

  '@type':
    'BlogPosting',

  headline:
    localizedPost.title,

  description:
    metaDescription,

  url:
    canonicalUrl,

  mainEntityOfPage: {
    '@type':
      'WebPage',

    '@id':
      canonicalUrl,
  },

  datePublished:
    publishedAt,

  inLanguage:
    currentLanguage.locale,

  author: {
    '@type':
      'Person',

    name:
      site.name,

    url:
      authorUrl,

    sameAs: [
      site.linkedinUrl,
    ],
  },

  keywords:
    localizedPost.tags,

  image:
    metaImageUrl,
};
---

<BaseLayout
  lang={lang}
  title={`${localizedPost.title} - ${site.name}`}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  finnishUrl={finnishUrl}
  englishUrl={englishUrl}
  languageHref={languageHref}
  areaPolish
  includeDefaultSocialMeta={false}
>
  <Fragment slot="head">
    <!-- Open Graph -->

    <meta
      property="og:type"
      content="article"
    />

    <meta
      property="og:site_name"
      content={site.name}
    />

    <meta
      property="og:locale"
      content={currentLanguage.openGraphLocale}
    />

    <meta
      property="og:locale:alternate"
      content={alternateLanguage.openGraphLocale}
    />

    <meta
      property="og:title"
      content={localizedPost.title}
    />

    <meta
      property="og:description"
      content={metaDescription}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="article:published_time"
      content={publishedAt}
    />

    {
      localizedPost.tags.map(
        (tag) => (
          <meta
            property="article:tag"
            content={tag}
          />
        )
      )
    }

    <meta
      property="og:image"
      content={metaImageUrl}
    />

    <meta
      property="og:image:secure_url"
      content={metaImageUrl}
    />

    <meta
      property="og:image:type"
      content="image/png"
    />

    <meta
      property="og:image:width"
      content="1200"
    />

    <meta
      property="og:image:height"
      content="630"
    />

    <meta
      property="og:image:alt"
      content={metaImageAlt}
    />

    <!-- Twitter / X -->

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={localizedPost.title}
    />

    <meta
      name="twitter:description"
      content={metaDescription}
    />

    <meta
      name="twitter:image"
      content={metaImageUrl}
    />

    <meta
      name="twitter:image:alt"
      content={metaImageAlt}
    />

    <!-- Structured data -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        blogPostingSchema
      )}
    />

    <style is:global>
      .article-page-shell > .feed > .feed-post:first-child {
        border-top: 0 !important;
      }
    </style>
  </Fragment>

  <main id="main-content" tabindex="-1" class="main-container article-page-shell">
    <section class="feed">
      <FeedPost
        post={post}
        lang={lang}
        postNumber={postNumber}
        displayDate={displayDate}
        perspectiveLabel={
          perspectiveLabel
        }
        sourceLabel={
          sourceLabel
        }
        headingLevel="h1"
      />
    </section>
  </main>

  <Fragment slot="afterAnalytics">
    <NightModeToggle lang={lang} />
  </Fragment>
</BaseLayout>
