---
import '../styles/global.css';

const modules = import.meta.glob('../data/ajankohtaista/*.md', {
  eager: true,
});

const posts = Object.entries(modules)
  .map(([path, post]: any) => ({
    slug: path.split('/').pop()?.replace('.md', ''),
    ...post.frontmatter,
    Content: post.Content,
  }))
  .sort((a, b) => b.date.localeCompare(a.date));

const formatDate = (date: string) => {
  const [year, month, day] = date.split('-');
  return `${Number(day)}.${Number(month)}.${year}`;
};

const topicLinks: Record<string, string> = {
  Kaupunkiluonto: '/kaupunkiluonto',
  Biodiversiteetti: '/biodiversiteetti',
  Hulevedet: '/hulevedet',
  'Maisema-arkkitehtuuri': '/maisema-arkkitehti-espoo',
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Aapo Pihkala',
  jobTitle: 'Maisema-arkkitehti',
  url: 'https://aapopihkala.fi/',
  sameAs: [
    'https://fi.linkedin.com/in/aapo-pihkala',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Espoo',
    addressCountry: 'FI',
  },
  knowsAbout: [
    'Maisema-arkkitehtuuri',
    'Kaupunkiluonto',
    'Hulevedet',
    'Biodiversiteetti',
  ],
};
---

<html lang="fi">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>
      Aapo Pihkala - Maisema-arkkitehti Espoo
    </title>

    <meta
      name="description"
      content="Aapo Pihkala on espoolainen maisema-arkkitehti. Kaupunki, maisema ja luonto."
    />

    <meta
      name="author"
      content="Aapo Pihkala"
    />

    <meta
      name="theme-color"
      content="#f8f7f2"
    />

    <link
      rel="canonical"
      href="https://aapopihkala.fi/"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>

  <body>

    <header class="topbar">

      <nav
        class="topbar-inner"
        aria-label="Päänavigaatio"
      >

        <a
          class="topbar-name"
          href="/"
          aria-label="Etusivu"
        >
          aapo
        </a>


        <a
          class="linkedin-link"
          href="https://fi.linkedin.com/in/aapo-pihkala"
          target="_blank"
          rel="noopener"
          aria-label="Aapo Pihkala LinkedInissä"
          title="LinkedIn"
        >

          <svg
            class="linkedin-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <rect
              x="2.75"
              y="2.75"
              width="18.5"
              height="18.5"
              rx="2.2"
            />

            <circle
              cx="7.55"
              cy="8"
              r="1.2"
            />

            <path
              d="M6.35 10.25v7.15"
            />

            <path
              d="M10.6 17.4v-7.15"
            />

            <path
              d="M10.6 13.35c0-1.75 1.05-3.15 2.85-3.15 2 0 3.05 1.35 3.05 3.65v3.55"
            />
          </svg>

        </a>

      </nav>

    </header>


    <main class="main-container">

      <section class="hero">

        <div class="hero-row">

          <div class="hero-content">

            <h1>
              Aapo Pihkala
            </h1>


            <div class="hero-description">

              <p class="hero-primary">
                Maisema-arkkitehti, Espoo.
              </p>

              <p class="hero-secondary">
                Kaupunki, maisema ja luonto.
              </p>

            </div>


            <p class="hero-location">

              <svg
                class="location-icon"
                viewBox="0 0 24 28"
                aria-hidden="true"
              >
                <path
                  d="M12 26C8.8 22.3 4.5 18.1 4.5 11.5A7.5 7.5 0 0 1 12 4a7.5 7.5 0 0 1 7.5 7.5C19.5 18.1 15.2 22.3 12 26Z"
                />

                <circle
                  cx="12"
                  cy="11.5"
                  r="2.4"
                />
              </svg>

              <span>
                Espoo, Suomi
              </span>

            </p>

          </div>


          <div
            class="hero-art"
            aria-hidden="true"
          >

            <canvas
              id="topography-canvas"
              class="topography-canvas"
            ></canvas>

            <div class="topography-label topography-label-a">
              +12.5
            </div>

            <div class="topography-label topography-label-b">
              +18.0
            </div>

          </div>

        </div>

      </section>


      <section
        class="feed"
        aria-label="Kirjoitukset"
      >

        {
          posts.map((post, index) => {
            const Content = post.Content;
            const number = String(index + 1).padStart(2, '0');

            return (
              <article class="feed-post">

                <header class="post-header">

                  <div class="post-index-row">

                    <span class="post-index">
                      {number}
                    </span>

                    <span
                      class="post-index-line"
                      aria-hidden="true"
                    ></span>

                  </div>


                  <p class="post-meta">

                    <span class="post-date">
                      {formatDate(post.date)}
                    </span>

                    <span
                      class="post-meta-separator"
                      aria-hidden="true"
                    >
                      /
                    </span>

                    {post.topics.map(
                      (topic: string, topicIndex: number) => (
                        <>
                          {topicIndex > 0 && (
                            <span
                              class="post-meta-separator"
                              aria-hidden="true"
                            >
                              /
                            </span>
                          )}

                          {
                            topicLinks[topic]
                              ? (
                                <a href={topicLinks[topic]}>
                                  {topic}
                                </a>
                              )
                              : (
                                <span>
                                  {topic}
                                </span>
                              )
                          }
                        </>
                      )
                    )}

                    <span
                      class="post-meta-separator"
                      aria-hidden="true"
                    >
                      /
                    </span>

                    <span>
                      {post.location}
                    </span>

                  </p>


                  <h2 class="post-title">

                    <a href={`/ajankohtaista/${post.slug}`}>
                      {post.title}
                    </a>

                  </h2>

                </header>


                <div class="post-body">
                  <Content />
                </div>


                <p class="source">

                  <span class="source-label">
                    Lähde
                  </span>

                  <a
                    href={post.sourceUrl}
                    target="_blank"
                    rel="noopener"
                  >
                    {post.source}
                    <span aria-hidden="true">
                      ↗
                    </span>
                  </a>

                </p>

              </article>
            );
          })
        }

      </section>

    </main>


    <script is:inline>
      (() => {
        const canvas =
          document.getElementById(
            'topography-canvas'
          );

        if (
          !(canvas instanceof HTMLCanvasElement)
        ) {
          return;
        }

        const context =
          canvas.getContext('2d');

        if (!context) {
          return;
        }

        const prefersReducedMotion =
          window.matchMedia(
            '(prefers-reduced-motion: reduce)'
          ).matches;

        const cols = 108;
        const rows = 88;
        const contourCount = 54;

        let width = 210;
        let height = 270;
        let dpr = 1;

        let lastDraw = -Infinity;
        let animationFrame = 0;


        const gaussian = (
          x,
          y,
          cx,
          cy,
          sx,
          sy,
          amplitude,
          rotation = 0
        ) => {

          const dx =
            x - cx;

          const dy =
            y - cy;

          const cos =
            Math.cos(rotation);

          const sin =
            Math.sin(rotation);

          const rx =
            dx * cos +
            dy * sin;

          const ry =
            -dx * sin +
            dy * cos;

          return amplitude * Math.exp(
            -(
              (rx * rx) /
                (2 * sx * sx) +
              (ry * ry) /
                (2 * sy * sy)
            )
          );
        };


        const terrainHeight = (
          x,
          y,
          phase
        ) => {

          const warpX =
            x +
            0.05 *
              Math.sin(
                2.45 * y +
                phase * 0.55
              ) +
            0.023 *
              Math.sin(
                5.1 * y -
                phase * 0.22
              );


          const warpY =
            y +
            0.04 *
              Math.sin(
                2.1 * x -
                phase * 0.4
              ) +
            0.017 *
              Math.cos(
                4.15 * x +
                phase * 0.28
              );


          const ridge1 =
            gaussian(
              warpX,
              warpY,
              -0.42 +
                0.018 *
                  Math.sin(phase),
              0.08,
              0.48,
              0.72,
              1,
              -0.42
            );


          const ridge2 =
            gaussian(
              warpX,
              warpY,
              0.32,
              -0.37 +
                0.016 *
                  Math.cos(
                    phase * 0.8
                  ),
              0.34,
              0.48,
              0.82,
              0.5
            );


          const ridge3 =
            gaussian(
              warpX,
              warpY,
              0.56,
              0.44,
              0.27,
              0.42,
              0.58,
              -0.18
            );


          const ridge4 =
            gaussian(
              warpX,
              warpY,
              -0.1,
              0.55,
              0.32,
              0.24,
              0.38,
              0.75
            );


          const valley1 =
            gaussian(
              warpX,
              warpY,
              0.02,
              0.04,
              0.24,
              0.42,
              -0.7,
              0.35
            );


          const valley2 =
            gaussian(
              warpX,
              warpY,
              -0.56,
              -0.5,
              0.24,
              0.27,
              -0.24,
              -0.6
            );


          const broadSlope =
            0.14 * warpX -
            0.07 * warpY;


          const geologicalWave =
            0.085 *
            Math.sin(
              2.1 * warpX -
              1.7 * warpY +
              0.22 *
                Math.sin(
                  phase * 0.45
                )
            );


          const secondaryWave =
            0.04 *
            Math.cos(
              3.4 * warpY +
              0.9 * warpX -
              phase * 0.22
            );


          return (
            ridge1 +
            ridge2 +
            ridge3 +
            ridge4 +
            valley1 +
            valley2 +
            broadSlope +
            geologicalWave +
            secondaryWave
          );
        };


        const edgeIntersection = (
          ax,
          ay,
          av,
          bx,
          by,
          bv,
          level
        ) => {

          const difference =
            bv - av;

          const t =
            Math.abs(difference) <
            0.000001
              ? 0.5
              : (level - av) /
                difference;

          return {
            x:
              ax +
              (bx - ax) * t,

            y:
              ay +
              (by - ay) * t,
          };
        };


        const resizeCanvas = () => {

          const rect =
            canvas.getBoundingClientRect();

          width =
            Math.max(
              1,
              rect.width
            );

          height =
            Math.max(
              1,
              rect.height
            );

          dpr =
            Math.min(
              window.devicePixelRatio || 1,
              2
            );

          canvas.width =
            Math.round(
              width * dpr
            );

          canvas.height =
            Math.round(
              height * dpr
            );

          context.setTransform(
            dpr,
            0,
            0,
            dpr,
            0,
            0
          );
        };


        const draw = (
          time = 0
        ) => {

          context.clearRect(
            0,
            0,
            width,
            height
          );


          const phase =
            prefersReducedMotion
              ? 0.7
              : time * 0.00045;


          const values =
            new Array(
              (cols + 1) *
              (rows + 1)
            );


          let minValue =
            Infinity;

          let maxValue =
            -Infinity;


          for (
            let gy = 0;
            gy <= rows;
            gy++
          ) {

            for (
              let gx = 0;
              gx <= cols;
              gx++
            ) {

              const nx =
                (gx / cols) *
                  2.4 -
                1.2;

              const ny =
                (gy / rows) *
                  2.08 -
                1.04;


              const value =
                terrainHeight(
                  nx,
                  ny,
                  phase
                );


              values[
                gy *
                  (cols + 1) +
                  gx
              ] =
                value;


              minValue =
                Math.min(
                  minValue,
                  value
                );


              maxValue =
                Math.max(
                  maxValue,
                  value
                );
            }
          }


          const range =
            maxValue -
            minValue ||
            1;


          for (
            let i = 0;
            i < values.length;
            i++
          ) {

            values[i] =
              (
                values[i] -
                minValue
              ) /
              range;
          }


          const cellWidth =
            width / cols;

          const cellHeight =
            height / rows;


          for (
            let contourIndex = 0;
            contourIndex < contourCount;
            contourIndex++
          ) {

            const level =
              0.03 +
              (
                contourIndex /
                (
                  contourCount -
                  1
                )
              ) *
              0.94;


            const isMajorContour =
              contourIndex %
              10 ===
              0;


            const isIndexContour =
              contourIndex %
              5 ===
              0;


            context.beginPath();


            if (isMajorContour) {

              context.strokeStyle =
                'rgba(73, 88, 76, 0.72)';

              context.lineWidth =
                1.15;

            } else if (isIndexContour) {

              context.strokeStyle =
                'rgba(91, 106, 93, 0.55)';

              context.lineWidth =
                0.78;

            } else {

              context.strokeStyle =
                'rgba(137, 149, 138, 0.36)';

              context.lineWidth =
                0.46;
            }


            context.lineCap =
              'round';

            context.lineJoin =
              'round';


            for (
              let gy = 0;
              gy < rows;
              gy++
            ) {

              for (
                let gx = 0;
                gx < cols;
                gx++
              ) {

                const x0 =
                  gx *
                  cellWidth;

                const x1 =
                  (gx + 1) *
                  cellWidth;

                const y0 =
                  gy *
                  cellHeight;

                const y1 =
                  (gy + 1) *
                  cellHeight;


                const topLeft =
                  values[
                    gy *
                    (cols + 1) +
                    gx
                  ];


                const topRight =
                  values[
                    gy *
                    (cols + 1) +
                    gx +
                    1
                  ];


                const bottomRight =
                  values[
                    (gy + 1) *
                    (cols + 1) +
                    gx +
                    1
                  ];


                const bottomLeft =
                  values[
                    (gy + 1) *
                    (cols + 1) +
                    gx
                  ];


                const points = [];


                if (
                  (
                    topLeft <
                    level
                  ) !==
                  (
                    topRight <
                    level
                  )
                ) {

                  points.push(
                    edgeIntersection(
                      x0,
                      y0,
                      topLeft,
                      x1,
                      y0,
                      topRight,
                      level
                    )
                  );
                }


                if (
                  (
                    topRight <
                    level
                  ) !==
                  (
                    bottomRight <
                    level
                  )
                ) {

                  points.push(
                    edgeIntersection(
                      x1,
                      y0,
                      topRight,
                      x1,
                      y1,
                      bottomRight,
                      level
                    )
                  );
                }


                if (
                  (
                    bottomRight <
                    level
                  ) !==
                  (
                    bottomLeft <
                    level
                  )
                ) {

                  points.push(
                    edgeIntersection(
                      x1,
                      y1,
                      bottomRight,
                      x0,
                      y1,
                      bottomLeft,
                      level
                    )
                  );
                }


                if (
                  (
                    bottomLeft <
                    level
                  ) !==
                  (
                    topLeft <
                    level
                  )
                ) {

                  points.push(
                    edgeIntersection(
                      x0,
                      y1,
                      bottomLeft,
                      x0,
                      y0,
                      topLeft,
                      level
                    )
                  );
                }


                if (
                  points.length ===
                  2
                ) {

                  context.moveTo(
                    points[0].x,
                    points[0].y
                  );

                  context.lineTo(
                    points[1].x,
                    points[1].y
                  );
                }


                if (
                  points.length ===
                  4
                ) {

                  const centre =
                    (
                      topLeft +
                      topRight +
                      bottomRight +
                      bottomLeft
                    ) / 4;


                  if (
                    centre >
                    level
                  ) {

                    context.moveTo(
                      points[0].x,
                      points[0].y
                    );

                    context.lineTo(
                      points[1].x,
                      points[1].y
                    );


                    context.moveTo(
                      points[2].x,
                      points[2].y
                    );

                    context.lineTo(
                      points[3].x,
                      points[3].y
                    );

                  } else {

                    context.moveTo(
                      points[0].x,
                      points[0].y
                    );

                    context.lineTo(
                      points[3].x,
                      points[3].y
                    );


                    context.moveTo(
                      points[1].x,
                      points[1].y
                    );

                    context.lineTo(
                      points[2].x,
                      points[2].y
                    );
                  }
                }
              }
            }


            context.stroke();
          }
        };


        const animate = (
          time
        ) => {

          if (
            time -
            lastDraw >
            55
          ) {

            draw(time);

            lastDraw =
              time;
          }


          animationFrame =
            requestAnimationFrame(
              animate
            );
        };


        resizeCanvas();

        draw(0);


        const resizeObserver =
          new ResizeObserver(
            () => {

              resizeCanvas();

              draw(
                performance.now()
              );
            }
          );


        resizeObserver.observe(
          canvas
        );


        if (
          !prefersReducedMotion
        ) {

          animationFrame =
            requestAnimationFrame(
              animate
            );
        }


        window.addEventListener(
          'pagehide',
          () => {

            cancelAnimationFrame(
              animationFrame
            );

            resizeObserver.disconnect();

          },
          {
            once: true,
          }
        );

      })();
    </script>

  </body>
</html>
