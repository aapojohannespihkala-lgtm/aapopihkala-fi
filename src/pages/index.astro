---
import '../styles/global.css';

const modules = import.meta.glob('../data/ajankohtaista/*.md', { eager: true });

const posts = Object.entries(modules)
  .map(([path, post]: any) => ({
    slug: path.split('/').pop().replace('.md', ''),
    ...post.frontmatter,
    Content: post.Content,
  }))
  .sort((a, b) => b.date.localeCompare(a.date));

const formatDate = (date: string) => {
  const [year, month, day] = date.split('-');
  return `${Number(day)}.${Number(month)}.${year}`;
};

const topicLinks: Record<string, string> = {
  Kaupunkiluonto: '/kaupunkiluonto',
  Biodiversiteetti: '/biodiversiteetti',
  Hulevedet: '/hulevedet',
  'Maisema-arkkitehtuuri': '/maisema-arkkitehti-espoo',
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Aapo Pihkala',
  jobTitle: 'Maisema-arkkitehti',
  url: 'https://aapopihkala.fi/',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Espoo',
    addressCountry: 'FI',
  },
  knowsAbout: [
    'Maisema-arkkitehtuuri',
    'Kaupunkiluonto',
    'Hulevedet',
    'Biodiversiteetti',
  ],
};
---

<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Aapo Pihkala - Maisema-arkkitehti Espoo</title>

    <meta
      name="description"
      content="Aapo Pihkala on espoolainen maisema-arkkitehti. Ajankohtaisia näkökulmia maisema-arkkitehtuuriin, kaupunkiluontoon, hulevesiin ja biodiversiteettiin."
    />

    <meta name="author" content="Aapo Pihkala" />
    <link rel="canonical" href="https://aapopihkala.fi/" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>

  <body>
    <header class="site-header">
      <h1 class="site-name">Aapo Pihkala</h1>
      <p class="site-role">Maisema-arkkitehti, Espoo</p>
      <p class="site-tagline">Kaupunki, maisema ja luonto.</p>
    </header>

    <main class="page-shell">
      <section class="feed" aria-label="Ajankohtaista">
        {
          posts.map((post) => {
            const Content = post.Content;

            return (
              <article class="feed-post">
                <header>
                  <p class="post-meta">
                    {formatDate(post.date)}
                    {' · '}
                    {post.topics.map((topic: string, index: number) => (
                      <>
                        {index > 0 && ' · '}
                        {
                          topicLinks[topic]
                            ? <a href={topicLinks[topic]}>{topic}</a>
                            : topic
                        }
                      </>
                    ))}
                    {' · '}
                    {post.location}
                  </p>

                  <h2 class="post-title">
                    <a href={`/ajankohtaista/${post.slug}`}>
                      {post.title}
                    </a>
                  </h2>
                </header>

                <div class="post-body">
                  <Content />
                </div>

                <p class="source">
                  <strong>Lähde:</strong>{' '}
                  <a href={post.sourceUrl}>
                    {post.source} ↗
                  </a>
                </p>
              </article>
            );
          })
        }
      </section>
    </main>
  </body>
</html>
