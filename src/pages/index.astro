            const Content = post.Content;

            return (
              <article class="feed-post">
                <header>
                  <p class="post-meta">
                    {formatDate(post.date)}

                    {' · '}

                    {post.topics.map(
                      (topic: string, index: number) => (
                        <>
                          {index > 0 && ' · '}

                          {
                            topicLinks[topic]
                              ? (
                                <a href={topicLinks[topic]}>
                                  {topic}
                                </a>
                              )
                              : topic
                          }
                        </>
                      )
                    )}

                    {' · '}

                    {post.location}
                  </p>

                  <h2 class="post-title">
                    <a href={`/ajankohtaista/${post.slug}`}>
                      {post.title}
                    </a>
                  </h2>
                </header>

                <div class="post-body">
                  <Content />
                </div>

                <p class="source">
                  <strong>Lähde:</strong>{' '}

                  <a href={post.sourceUrl}>
                    {post.source} ↗
                  </a>
                </p>
              </article>
            );
          })
        }
      </section>
    </main>
