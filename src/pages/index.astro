          >
            <circle cx="95" cy="55" r="2" />
            <circle cx="121" cy="48" r="1.8" />
            <circle cx="144" cy="64" r="1.5" />

            <circle cx="82" cy="91" r="1.5" />
            <circle cx="108" cy="81" r="2" />
            <circle cx="137" cy="92" r="1.7" />
            <circle cx="160" cy="108" r="1.5" />

            <circle cx="71" cy="128" r="1.8" />
            <circle cx="96" cy="119" r="1.5" />
            <circle cx="122" cy="132" r="2" />
            <circle cx="151" cy="127" r="1.5" />
            <circle cx="173" cy="145" r="1.8" />

