          </g>

          <path
            class="water-line"
            d="
              M120 48
              C105 84 132 108 114 143
              C99 172 132 196 116 226
              C103 250 126 277 120 311
            "
          />
        </svg>
      </div>

    </section>

    <main
      class="page-shell"
      id="ajankohtaista"
    >

      <section
        class="feed"
        aria-label="Ajankohtaista"
      >

        {
          posts.map((post) => {
            const Content = post.Content;

            return (
              <article class="feed-post">

                <header>

                  <p class="post-meta">

                    {formatDate(post.date)}

                    {' · '}

                    {post.topics.map(
                      (topic: string, index: number) => (
                        <>

                          {index > 0 && ' · '}

                          {
                            topicLinks[topic]
                              ? (
                                <a href={topicLinks[topic]}>
                                  {topic}
                                </a>
                              )
                              : topic
                          }

                        </>
                      )
                    )}

                    {' · '}

                    {post.location}

                  </p>

                  <h2 class="post-title">

                    <a
                      href={`/ajankohtaista/${post.slug}`}
                    >
                      {post.title}
                    </a>

                  </h2>

                </header>

                <div class="post-body">
                  <Content />
                </div>

                <p class="source">

                  <strong>Lähde:</strong>{' '}

                  <a href={post.sourceUrl}>
                    {post.source} ↗
                  </a>

                </p>

              </article>
            );
          })
        }

      </section>

    </main>

  </body>
</html>
