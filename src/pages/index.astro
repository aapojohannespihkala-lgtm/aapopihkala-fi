---
import '../styles/global.css';

const title = 'Aapo Pihkala - Maisema-arkkitehti';
const description = 'Aapo Pihkala on maisema-arkkitehti. Sivusto käsittelee maisema-arkkitehtuuria, kaupunkiluontoa, asemakaavoitusta, biodiversiteettiä ja hulevesiä.';
---
<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href="https://aapopihkala.fi/" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">AAPO PIHKALA</p>
      <h1>Maisema-arkkitehti</h1>
      <p class="lead">Maisema, kaupunki ja luonto.</p>
      <p class="status">Sivusto rakenteilla.</p>
    </main>
  </body>
</html>
