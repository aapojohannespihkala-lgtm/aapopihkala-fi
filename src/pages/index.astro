    <meta name="viewport" content="width=device-width" />

    <title>Aapo Pihkala - Maisema-arkkitehti Espoo</title>

    <meta
      name="description"
      content="Aapo Pihkala on espoolainen maisema-arkkitehti. Ajankohtaisia näkökulmia maisema-arkkitehtuuriin, kaupunkiluontoon, hulevesiin ja biodiversiteettiin."
    />

    <meta name="author" content="Aapo Pihkala" />
    <link rel="canonical" href="https://aapopihkala.fi/" />

    <script
