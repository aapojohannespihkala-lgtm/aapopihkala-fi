                 C156 104 141 86 120 83Z"
            />

            <path
              d="M120 110
                 C106 113 98 125 97 141
                 C96 158 103 172 112 180
                 C117 184 123 184 128 180
                 C137 172 144 158 143 141
                 C142 125 134 113 120 110Z"
            />

            <path
              d="M82 242
