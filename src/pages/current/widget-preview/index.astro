---
const title = 'Snapshot Widget Preview';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <main class="preview-shell">
      <header class="preview-tools">
        <div>
          <p class="eyebrow">ANDROID / SNAPSHOT</p>
          <h1>{title}</h1>
        </div>
        <nav aria-label="Widget preview controls">
          <button type="button" data-size="compact">COMPACT</button>
          <button type="button" data-size="medium">MEDIUM</button>
          <button type="button" data-size="large">LARGE</button>
          <button type="button" data-channel="prod">PROD</button>
          <button type="button" data-channel="dev">DEV</button>
        </nav>
      </header>

      <p class="preview-status" data-status>Loading widget payload...</p>
      <section class="device-stage" data-stage data-size="large">
        <article class="widget-preview" data-widget aria-live="polite"></article>
      </section>
    </main>

    <script>
      type Tone = 'neutral' | 'positive' | 'negative' | 'accent';
      type Span = 'full' | 'half';
      type Layout = 'stack' | 'split';
      type Row = { label: string; value: string; tone?: Tone; countdownTargetMs?: number };
      type Column = { label: string; value: string; tone?: Tone };
      type Section = {
        id: string;
        index: string;
        label: string;
        primary: string;
        secondary?: string;
        detail?: string;
        tone?: Tone;
        span?: Span;
        layout?: Layout;
        countdownTargetMs?: number;
        rows?: Row[];
        columns?: Column[];
        bars?: number[];
      };
      type Payload = {
        schemaVersion: number;
        channel: 'prod' | 'dev';
        generatedAt: string;
        title: string;
        pageUrl: string;
        theme: Record<string, string>;
        layouts: { compact: string[]; medium: string[]; large: string[] };
        sections: Section[];
      };

      const status = document.querySelector<HTMLElement>('[data-status]');
      const stage = document.querySelector<HTMLElement>('[data-stage]');
      const widget = document.querySelector<HTMLElement>('[data-widget]');
      const params = new URLSearchParams(window.location.search);
      let size = ['compact', 'medium', 'large'].includes(params.get('size') ?? '')
        ? (params.get('size') as 'compact' | 'medium' | 'large')
        : 'large';
      let channel = params.get('channel') === 'dev' ? 'dev' : 'prod';
      let payload: Payload | null = null;

      const escapeHtml = (value: string) => value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

      const toneClass = (tone?: Tone) => tone ? `tone-${tone}` : 'tone-neutral';

      const localTime = (value: string) => {
        const date = new Date(value);
        if (!Number.isFinite(date.getTime())) return value;
        return new Intl.DateTimeFormat('en-GB', {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZone: 'Europe/Helsinki',
        }).format(date);
      };

      const isoWeek = (year: number, month: number, day: number) => {
        const date = new Date(Date.UTC(year, month - 1, day));
        const weekday = date.getUTCDay() || 7;
        date.setUTCDate(date.getUTCDate() + 4 - weekday);
        const yearStart = new Date(Date.UTC(date.getUTCFullYear(), 0, 1));
        return Math.ceil((((date.getTime() - yearStart.getTime()) / 86_400_000) + 1) / 7);
      };

      const currentHeaderDateTime = () => {
        const now = new Date();
        const parts = new Intl.DateTimeFormat('en-GB', {
          weekday: 'short',
          day: '2-digit',
          month: 'short',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZone: 'Europe/Helsinki',
        }).formatToParts(now);
        const part = (type: Intl.DateTimeFormatPartTypes) =>
          parts.find((item) => item.type === type)?.value ?? '';
        const year = Number(part('year'));
        const monthName = part('month').slice(0, 3).toUpperCase();
        const monthNumber = Number(new Intl.DateTimeFormat('en-GB', {
          month: '2-digit',
          timeZone: 'Europe/Helsinki',
        }).format(now));
        const day = Number(part('day'));
        const week = isoWeek(year, monthNumber, day);
        return {
          time: `${part('hour')}:${part('minute')}`,
          date: `${part('weekday').toUpperCase()} ${String(day).padStart(2, '0')} ${monthName} ${year} / W${String(week).padStart(2, '0')}`,
        };
      };

      const renderRows = (rows: Row[] = []) => rows.map((row) => `
        <div class="metric-row">
          <span>${escapeHtml(row.label)}</span>
          <strong class="${toneClass(row.tone)}">${escapeHtml(row.value)}</strong>
        </div>
      `).join('');

      const renderColumns = (columns: Column[] = []) => columns.length === 0 ? '' : `
        <div class="metric-columns">
          ${columns.map((column) => `
            <div>
              <span>${escapeHtml(column.label)}</span>
              <strong class="${toneClass(column.tone)}">${escapeHtml(column.value)}</strong>
            </div>
          `).join('')}
        </div>
      `;

      const renderBars = (bars: number[] = []) => bars.length === 0 ? '' : `
        <div class="metric-bars" aria-hidden="true">
          ${bars.map((bar) => `<i style="height:${Math.max(8, Math.min(100, bar * 100))}%"></i>`).join('')}
        </div>
      `;

      const renderSupport = (section: Section) => {
        const rows = section.id === 'hsl' && section.countdownTargetMs !== undefined
          ? (section.rows ?? [])
              .filter((row) => row.countdownTargetMs !== section.countdownTargetMs)
              .slice(0, 5)
          : section.rows;
        return [
          renderColumns(section.columns),
          renderBars(section.bars),
          renderRows(rows),
        ].filter(Boolean).join('');
      };

      const renderSection = (section: Section) => {
        const span = section.span ?? 'full';
        const layout = section.layout ?? 'stack';
        const support = renderSupport(section);
        return `
          <section class="metric-section span-${span} layout-${layout}" data-section="${escapeHtml(section.id)}" data-span="${span}" data-layout="${layout}">
            <div class="metric-heading"><span>${escapeHtml(section.index)}</span><strong>${escapeHtml(section.label)}</strong></div>
            <div class="metric-body">
              <div class="metric-main">
                ${section.secondary ? `<div class="metric-secondary">${escapeHtml(section.secondary)}</div>` : ''}
                <div class="metric-primary ${toneClass(section.tone)}">${escapeHtml(section.primary)}</div>
                ${section.detail ? `<div class="metric-detail">${escapeHtml(section.detail)}</div>` : ''}
              </div>
              ${support ? `<div class="metric-support">${support}</div>` : ''}
            </div>
          </section>
        `;
      };

      const applyTheme = (theme: Record<string, string>) => {
        if (!widget) return;
        for (const [key, value] of Object.entries(theme)) {
          widget.style.setProperty(`--${key}`, value);
        }
      };

      const render = () => {
        if (!payload || !widget || !stage) return;
        stage.dataset.size = size;
        applyTheme(payload.theme);
        const header = currentHeaderDateTime();
        const byId = new Map(payload.sections.map((section) => [section.id, section]));
        const ids = payload.layouts[size] ?? [];
        const sections = ids.map((id) => byId.get(id)).filter((item): item is Section => Boolean(item));
        widget.innerHTML = `
          <header class="widget-header">
            <div>
              <strong>${escapeHtml(header.time)}</strong>
              <span>${escapeHtml(header.date)}</span>
              <span>UPDATED ${escapeHtml(localTime(payload.generatedAt))}</span>
            </div>
            <b>REFRESH</b>
          </header>
          <div class="widget-sections">${sections.map(renderSection).join('')}</div>
        `;
        if (status) status.textContent = `SCHEMA ${payload.schemaVersion} / ${payload.channel.toUpperCase()} / ${size.toUpperCase()}`;
      };

      const updateUrl = () => {
        const next = new URL(window.location.href);
        next.searchParams.set('size', size);
        next.searchParams.set('channel', channel);
        window.history.replaceState({}, '', next);
      };

      const load = async () => {
        if (status) status.textContent = 'Loading widget payload...';
        try {
          const response = await fetch(`/api/current/widget-v2?channel=${channel}`, {
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          payload = await response.json() as Payload;
          render();
        } catch (error) {
          if (status) status.textContent = `Preview unavailable: ${error instanceof Error ? error.message : 'unknown error'}`;
        }
      };

      document.querySelectorAll<HTMLButtonElement>('[data-size]').forEach((button) => {
        button.addEventListener('click', () => {
          size = button.dataset.size as typeof size;
          updateUrl();
          render();
        });
      });
      document.querySelectorAll<HTMLButtonElement>('[data-channel]').forEach((button) => {
        button.addEventListener('click', () => {
          channel = button.dataset.channel === 'dev' ? 'dev' : 'prod';
          updateUrl();
          void load();
        });
      });

      updateUrl();
      void load();
    </script>
  </body>
</html>

<style is:global>
  :root {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    background: #0f151a;
    color: #e8edf0;
  }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; background: #0f151a; }
  button { font: inherit; }
  .preview-shell { width: min(980px, 100%); margin: 0 auto; padding: 24px 16px 64px; }
  .preview-tools { display: flex; gap: 24px; align-items: flex-end; justify-content: space-between; border-bottom: 1px solid #44515b; padding-bottom: 16px; }
  .preview-tools h1 { margin: 2px 0 0; font-size: clamp(20px, 4vw, 32px); font-weight: 500; }
  .eyebrow, .preview-status { margin: 0; color: #9ca8b0; font-size: 11px; letter-spacing: .08em; }
  nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; }
  nav button { border: 1px solid #65727b; background: transparent; color: #dfe6ea; padding: 7px 9px; cursor: pointer; }
  nav button:hover { background: #24323d; }
  .preview-status { margin: 12px 0; }
  .device-stage { margin: 0 auto; transition: width .2s ease; }
  .device-stage[data-size="compact"] { width: min(100%, 360px); }
  .device-stage[data-size="medium"] { width: min(100%, 520px); }
  .device-stage[data-size="large"] { width: min(100%, 620px); }
  .widget-preview {
    --background: #1d2a35;
    --panel: #22323e;
    --foreground: #eef2f4;
    --muted: #aab4bc;
    --line: #64717b;
    --accent: #dce4e8;
    --positive: #15967f;
    --negative: #c45f6c;
    min-height: 220px;
    border-radius: 28px;
    background: var(--background);
    color: var(--foreground);
    overflow: hidden;
    padding: 18px;
    box-shadow: 0 24px 80px rgb(0 0 0 / 24%);
  }
  [data-size="large"] .widget-preview { min-height: 700px; }
  [data-size="medium"] .widget-preview { min-height: 340px; }
  .widget-header { display: flex; align-items: center; justify-content: space-between; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .widget-header div { display: grid; gap: 2px; }
  .widget-header strong { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 19px; font-weight: 500; }
  .widget-header span { color: var(--muted); font-size: 8px; }
  .widget-header b { color: var(--accent); font-size: 9px; }
  .widget-sections { display: grid; }
  [data-size="compact"] .widget-sections,
  [data-size="medium"] .widget-sections,
  [data-size="large"] .widget-sections { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .metric-section { padding: 14px 10px; min-width: 0; border-bottom: 1px solid var(--line); }
  [data-size="large"] .metric-section.span-full { grid-column: 1 / -1; }
  [data-size="large"] .metric-section.span-half { grid-column: span 1; }
  [data-size="large"] .metric-section.span-half + .metric-section.span-half { border-left: 1px solid var(--line); }
  [data-size="compact"] .metric-section:nth-child(odd),
  [data-size="medium"] .metric-section:nth-child(odd) { border-right: 1px solid var(--line); }
  .metric-heading { display: flex; gap: 10px; color: var(--muted); font-size: 11px; }
  .metric-heading strong { color: var(--muted); font-weight: 500; letter-spacing: .04em; }
  .metric-secondary { margin-top: 9px; color: var(--muted); font-size: 10px; }
  .metric-primary { margin-top: 3px; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 25px; font-weight: 400; line-height: 1; }
  [data-size="large"] .span-half .metric-primary { font-size: 22px; }
  [data-size="large"] [data-section="liiga"] .metric-secondary,
  [data-size="large"] [data-section="liiga"] .metric-detail { color: color-mix(in srgb, var(--foreground) 78%, var(--background)); }
  .metric-detail { margin-top: 7px; color: var(--muted); font-size: 11px; line-height: 1.35; white-space: pre-line; }
  .metric-row { display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px solid color-mix(in srgb, var(--line) 55%, transparent); padding: 4px 0; font-size: 11px; color: var(--muted); }
  .metric-row strong { font-weight: 500; text-align: right; }
  .metric-columns { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; margin-top: 10px; }
  .metric-columns div { display: grid; gap: 2px; color: var(--muted); font-size: 9px; }
  .metric-columns strong { color: var(--foreground); font-size: 13px; }
  .metric-bars { height: 56px; display: flex; align-items: flex-end; gap: 3px; margin-top: 10px; }
  .metric-bars i { flex: 1; min-width: 2px; background: var(--foreground); opacity: .8; }
  [data-size="large"] .layout-split .metric-body { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; align-items: center; }
  [data-size="large"] .layout-split .metric-secondary { margin-top: 4px; }
  [data-size="large"] .layout-split .metric-detail { font-size: 8px; }
  [data-size="large"] .layout-split .metric-support .metric-columns,
  [data-size="large"] .layout-split .metric-support .metric-bars { margin-top: 0; }
  [data-size="large"] .span-half .metric-row,
  [data-size="large"] .span-half .metric-columns,
  [data-size="large"] .span-half .metric-bars { display: none; }
  .tone-neutral { color: var(--foreground); }
  .tone-positive { color: var(--positive); }
  .tone-negative { color: var(--negative); }
  .tone-accent { color: var(--accent); }
  [data-size="compact"] .metric-row,
  [data-size="compact"] .metric-columns,
  [data-size="compact"] .metric-bars,
  [data-size="compact"] .metric-detail { display: none; }
  [data-size="compact"] .metric-secondary { margin-top: 5px; }
  @media (max-width: 640px) {
    .preview-tools { align-items: flex-start; flex-direction: column; }
    nav { justify-content: flex-start; }
    .widget-preview { padding: 14px; border-radius: 24px; }
  }
</style>
