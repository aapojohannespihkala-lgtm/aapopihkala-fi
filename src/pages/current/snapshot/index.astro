---
import CurrentSnapshotPage from '../../../components/current/CurrentSnapshotPage.astro';
---

<CurrentSnapshotPage />

<script>
  import { initSnapshotWeatherForecast } from '../../../features/current/snapshot-weather-forecast';

  initSnapshotWeatherForecast();
</script>

<style is:global>
  body:has(.snapshot-shell) .snapshot-weather {
    grid-template-rows: minmax(0, 1fr) auto auto;
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast {
    grid-column: 1 / -1;
    min-width: 0;
    display: grid;
    grid-template-columns: auto repeat(3, minmax(0, 1fr));
    align-items: baseline;
    gap: 7px;
    color: var(--ink-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.4rem;
    line-height: 1;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-label,
  body:has(.snapshot-shell) .snapshot-weather__forecast-time {
    color: var(--stone);
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-label {
    white-space: nowrap;
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-slot {
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 3px;
    white-space: nowrap;
    overflow: hidden;
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-temperature {
    color: var(--ink-soft);
    font-weight: 600;
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-condition {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 640px) {
    body:has(.snapshot-shell) .snapshot-grid {
      grid-template-rows:
        minmax(0, 1.22fr)
        minmax(0, 1.56fr)
        minmax(0, 1.1fr)
        minmax(0, 1fr);
    }

    body:has(.snapshot-shell) .snapshot-weather {
      row-gap: 2px;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast {
      gap: 5px;
      font-size: 0.34rem;
      letter-spacing: 0.025em;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-slot {
      gap: 2px;
    }

    body:has(.snapshot-shell) .snapshot-rates {
      gap: 2px;
    }

    body:has(.snapshot-shell) .snapshot-rates__main {
      gap: 8px;
      align-items: center;
    }

    body:has(.snapshot-shell) .snapshot-rates__change {
      margin-top: 2px;
      line-height: 1;
    }

    body:has(.snapshot-shell) .snapshot-rates .snapshot-source {
      padding-top: 2px;
    }

    body:has(.snapshot-shell) .snapshot-footer > span:first-child {
      visibility: hidden;
    }

    body:has(.snapshot-shell) [data-analytics-settings] {
      left: 20px;
      right: auto;
      bottom: 10px;
      min-height: 14px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.26rem;
      line-height: 1;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
  }

  @media (max-width: 380px), (max-height: 720px) {
    body:has(.snapshot-shell) .snapshot-grid {
      grid-template-rows:
        minmax(0, 1.18fr)
        minmax(0, 1.6fr)
        minmax(0, 1.11fr)
        minmax(0, 1fr);
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast {
      gap: 4px;
      font-size: 0.3rem;
    }

    body:has(.snapshot-shell) [data-analytics-settings] {
      left: 16px;
      bottom: 7px;
      min-height: 12px;
      font-size: 0.23rem;
    }
  }
</style>