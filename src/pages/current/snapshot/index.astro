---
import CurrentSnapshotPage from '../../../components/current/CurrentSnapshotPage.astro';
---

<CurrentSnapshotPage />

<script>
  import { initSnapshotWeatherForecast } from '../../../features/current/snapshot-weather-forecast';
  import { initSnapshotElectricityContext } from '../../../features/current/snapshot-electricity-context';
  import { initSnapshotLiiga } from '../../../features/current/snapshot-liiga';

  initSnapshotWeatherForecast();
  initSnapshotElectricityContext();
  initSnapshotLiiga();

  const snapshotRoot = document.querySelector<HTMLElement>('[data-current-snapshot]');
  const ratesOpen = snapshotRoot?.querySelector<HTMLAnchorElement>(
    '.snapshot-panel--rates .snapshot-panel__open'
  );
  if (ratesOpen) ratesOpen.href = '/current/rates/';
  snapshotRoot?.querySelector('.snapshot-rates__chart')?.remove();

  const heroClock = document.querySelector<HTMLElement>('#current-snapshot-title');
  const heroClockFormatter = new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hourCycle: 'h23',
    timeZone: 'Europe/Helsinki',
  });

  const renderHeroClock = () => {
    if (!heroClock) return;

    const formatted = heroClockFormatter.format(new Date());
    const parts = formatted.split(':');
    const seconds = parts.pop();
    const primary = parts.join(':');

    if (seconds) {
      const minor = document.createElement('span');
      minor.className = 'snapshot-number__minor snapshot-number__minor--seconds';
      minor.textContent = `:${seconds}`;
      heroClock.replaceChildren(document.createTextNode(primary), minor);
    } else {
      heroClock.textContent = formatted;
    }

    heroClock.setAttribute('aria-label', `Current time in Helsinki ${formatted}`);
  };

  const decorateDecimal = (element: HTMLElement) => {
    if (element.querySelector('.snapshot-number__minor')) return;

    const value = element.textContent?.trim() ?? '';
    const match = value.match(/^([+−-]?\d+)\.(\d+)(.*)$/);
    if (!match) return;

    const minor = document.createElement('span');
    minor.className = 'snapshot-number__minor';
    minor.textContent = match[2];

    const primary = document.createTextNode(`${match[1]}.`);
    const suffix = match[3] ?? '';
    if (suffix) {
      const unit = document.createElement('small');
      unit.className = 'snapshot-number__unit';
      unit.textContent = suffix;
      element.replaceChildren(primary, minor, unit);
    } else {
      element.replaceChildren(primary, minor);
    }
  };

  const decorateHeadlineDecimals = () => {
    if (!snapshotRoot) return;

    for (const selector of [
      '[data-snapshot-weather-temperature]',
      '[data-snapshot-electricity-now]',
      '[data-snapshot-market-median]',
      '[data-snapshot-euribor]',
    ]) {
      const element = snapshotRoot.querySelector<HTMLElement>(selector);
      if (element) decorateDecimal(element);
    }
  };

  if (snapshotRoot) {
    const observer = new MutationObserver(() => decorateHeadlineDecimals());
    observer.observe(snapshotRoot, { childList: true, subtree: true });
    decorateHeadlineDecimals();
  }

  renderHeroClock();
  window.setInterval(renderHeroClock, 1000);
</script>

<style is:global>
  body:has(.snapshot-shell) {
    --snapshot-headline-size: clamp(2.8rem, 9vw, 4.4rem);
  }

  body:has(.snapshot-shell) #current-snapshot-title,
  body:has(.snapshot-shell) .snapshot-hero,
  body:has(.snapshot-shell) .snapshot-rates__value,
  body:has(.snapshot-shell) .snapshot-markets__median strong {
    font-size: var(--snapshot-headline-size);
    line-height: 0.86;
  }

  body:has(.snapshot-shell) #current-snapshot-title {
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  body:has(.snapshot-shell) .snapshot-number__minor {
    display: inline-block;
    font-size: 0.72em;
    line-height: 1;
    letter-spacing: -0.035em;
    vertical-align: baseline;
  }

  body:has(.snapshot-shell) .snapshot-number__minor--seconds {
    margin-left: 0.015em;
  }

  body:has(.snapshot-shell) .snapshot-number__unit {
    display: inline-block;
    margin-left: 0.08em;
    font-size: 0.27em;
    line-height: 1;
    letter-spacing: 0;
    vertical-align: 0.22em;
  }

  body:has(.snapshot-shell) .snapshot-titleblock__meta span:last-child {
    display: none;
  }

  body:has(.snapshot-shell) .snapshot-panel__heading,
  body:has(.snapshot-shell) .snapshot-panel__heading h2,
  body:has(.snapshot-shell) .snapshot-electricity__stats {
    border-color: var(--line);
  }

  body:has(.snapshot-shell) .snapshot-market-row {
    border-bottom-color: var(--line-soft);
  }

  body:has(.snapshot-shell) .snapshot-weather {
    grid-template-columns: minmax(0, 0.94fr) minmax(190px, 1.06fr);
    grid-template-rows: minmax(0, 1fr) auto;
    column-gap: 12px;
  }

  body:has(.snapshot-shell) .snapshot-weather__copy {
    grid-column: 1;
    grid-row: 1;
    align-self: center;
  }

  body:has(.snapshot-shell) .snapshot-weather > .snapshot-weather__icon {
    display: none;
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    align-self: center;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    color: var(--ink-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    text-transform: uppercase;
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-slot {
    min-width: 0;
    display: grid;
    grid-template-rows: auto 24px auto;
    justify-items: center;
    align-items: center;
    gap: 2px;
    color: var(--ink-soft);
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-time {
    color: var(--stone);
    font-size: 0.42rem;
    line-height: 1;
    letter-spacing: 0.025em;
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-icon {
    width: 24px;
    height: 24px;
    overflow: visible;
    color: var(--ink-soft);
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-icon path,
  body:has(.snapshot-shell) .snapshot-weather__forecast-icon circle {
    vector-effect: non-scaling-stroke;
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-temperature {
    color: var(--ink);
    font-size: 0.62rem;
    font-weight: 650;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  body:has(.snapshot-shell) .snapshot-weather .snapshot-source {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  body:has(.snapshot-shell) [data-snapshot-electricity-month-average='true'] {
    font-weight: 600;
  }

  body:has(.snapshot-shell) .snapshot-electricity__chart {
    position: relative;
    padding-top: 10px;
  }

  body:has(.snapshot-shell) .snapshot-electricity__now-marker {
    position: absolute;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: baseline;
    gap: 3px;
    transform: translateX(-50%);
    color: var(--stone);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.39rem;
    line-height: 1;
    letter-spacing: 0.03em;
    white-space: nowrap;
    pointer-events: none;
  }

  body:has(.snapshot-shell) .snapshot-electricity__now-marker strong {
    color: var(--ink);
    font-size: 0.5rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  body:has(.snapshot-shell) .snapshot-electricity__now-marker::after {
    content: '';
    position: absolute;
    top: 10px;
    left: 50%;
    height: 30px;
    border-left: 1px solid color-mix(in srgb, var(--ink-soft) 60%, transparent);
  }

  body:has(.snapshot-shell) .snapshot-market-row strong {
    font-size: 1.1em;
    font-weight: 750 !important;
    letter-spacing: 0.025em;
  }

  body:has(.snapshot-shell) .snapshot-markets {
    grid-template-columns: minmax(0, 0.56fr) minmax(0, 0.44fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    column-gap: 14px;
    row-gap: 5px;
  }

  body:has(.snapshot-shell) .snapshot-markets > .snapshot-kicker {
    grid-column: 1 / -1;
    grid-row: 1;
  }

  body:has(.snapshot-shell) .snapshot-markets__median {
    grid-column: 1;
    grid-row: 2;
    min-width: 0;
    align-self: center;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 5px;
    font-size: 0.56rem;
    line-height: 1;
  }

  body:has(.snapshot-shell) .snapshot-markets__median strong {
    min-width: 0;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.075em;
    text-transform: none;
    white-space: nowrap;
  }

  body:has(.snapshot-shell) .snapshot-market-list {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
    align-self: stretch;
  }

  body:has(.snapshot-shell) .snapshot-markets > .snapshot-source {
    grid-column: 1 / -1;
    grid-row: 3;
  }

  body:has(.snapshot-shell) .snapshot-liiga__position {
    font-size: var(--snapshot-headline-size) !important;
    font-weight: 400 !important;
    letter-spacing: -0.075em !important;
    line-height: 0.86 !important;
  }

  body:has(.snapshot-shell) .snapshot-liiga__position-rank {
    font-size: 1em !important;
  }

  body:has(.snapshot-shell) .snapshot-liiga__position-separator {
    font-size: 0.6em !important;
    font-weight: 500 !important;
  }

  body:has(.snapshot-shell) .snapshot-liiga__position-total {
    font-size: 0.72em !important;
    font-weight: 500 !important;
  }

  @media (max-width: 640px) {
    body:has(.snapshot-shell) {
      --snapshot-headline-size: clamp(2.55rem, 12vw, 3.35rem);
    }

    body:has(.snapshot-shell) .snapshot-grid {
      grid-template-rows:
        minmax(0, 1.15fr)
        minmax(0, 1.62fr)
        minmax(0, 1.11fr)
        minmax(0, 1.02fr);
    }

    body:has(.snapshot-shell) .snapshot-weather {
      grid-template-columns: minmax(0, 0.94fr) minmax(166px, 1.06fr);
      column-gap: 6px;
      row-gap: 2px;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast {
      gap: 3px;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-time {
      font-size: 0.44rem;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-icon {
      width: 21px;
      height: 21px;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-slot {
      grid-template-rows: auto 21px auto;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-temperature {
      font-size: 0.59rem;
    }

    body:has(.snapshot-shell) .snapshot-weather__condition {
      font-size: 0.75rem;
    }

    body:has(.snapshot-shell) .snapshot-weather__range {
      font-size: 0.62rem;
    }

    body:has(.snapshot-shell) .snapshot-source {
      font-size: 0.4rem;
      line-height: 1.12;
    }

    body:has(.snapshot-shell) .snapshot-electricity__value .snapshot-micro {
      font-size: 0.43rem;
      line-height: 1.15;
    }

    body:has(.snapshot-shell) .snapshot-electricity__chart {
      padding-top: 11px;
    }

    body:has(.snapshot-shell) .snapshot-electricity__now-marker {
      font-size: 0.43rem;
    }

    body:has(.snapshot-shell) .snapshot-electricity__now-marker strong {
      font-size: 0.56rem;
    }

    body:has(.snapshot-shell) .snapshot-chart-labels {
      font-size: 0.36rem;
    }

    body:has(.snapshot-shell) .snapshot-electricity__stats {
      font-size: 0.42rem;
    }

    body:has(.snapshot-shell) .snapshot-electricity__stats dd {
      font-size: 0.78rem;
      font-weight: 550;
    }

    body:has(.snapshot-shell) .snapshot-markets {
      column-gap: 10px;
      row-gap: 4px;
    }

    body:has(.snapshot-shell) .snapshot-markets__median {
      gap: 3px;
      font-size: 0.5rem;
    }

    body:has(.snapshot-shell) .snapshot-market-list {
      font-size: 0.5rem;
    }

    body:has(.snapshot-shell) .snapshot-market-row strong {
      font-size: 0.62rem;
      font-weight: 800 !important;
    }

    body:has(.snapshot-shell) .snapshot-rates {
      gap: 2px;
    }

    body:has(.snapshot-shell) .snapshot-rates__main {
      gap: 8px;
      align-items: center;
    }

    body:has(.snapshot-shell) .snapshot-rates__label {
      font-size: 0.5rem;
    }

    body:has(.snapshot-shell) .snapshot-rates__change {
      margin-top: 2px;
      font-size: 0.43rem;
      line-height: 1;
    }

    body:has(.snapshot-shell) .snapshot-rates .snapshot-source {
      padding-top: 2px;
    }

    body:has(.snapshot-shell) .snapshot-footer {
      font-size: 0.34rem;
    }

    body:has(.snapshot-shell) .snapshot-footer > span:first-child {
      visibility: hidden;
    }

    body:has(.snapshot-shell) [data-analytics-settings] {
      left: 20px;
      right: auto;
      bottom: 10px;
      min-height: 14px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.34rem;
      line-height: 1;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
  }

  @media (max-width: 380px), (max-height: 720px) {
    body:has(.snapshot-shell) {
      --snapshot-headline-size: clamp(2.25rem, 11vw, 2.8rem);
    }

    body:has(.snapshot-shell) .snapshot-grid {
      grid-template-rows:
        minmax(0, 1.12fr)
        minmax(0, 1.64fr)
        minmax(0, 1.12fr)
        minmax(0, 1fr);
    }

    body:has(.snapshot-shell) .snapshot-weather {
      grid-template-columns: minmax(0, 0.9fr) minmax(150px, 1.1fr);
      column-gap: 3px;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast {
      gap: 2px;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-time {
      font-size: 0.39rem;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-icon {
      width: 18px;
      height: 18px;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-slot {
      grid-template-rows: auto 18px auto;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-temperature {
      font-size: 0.52rem;
    }

    body:has(.snapshot-shell) .snapshot-source {
      font-size: 0.34rem;
    }

    body:has(.snapshot-shell) .snapshot-electricity__value .snapshot-micro {
      font-size: 0.38rem;
    }

    body:has(.snapshot-shell) .snapshot-electricity__stats {
      font-size: 0.36rem;
    }

    body:has(.snapshot-shell) .snapshot-electricity__stats dd {
      font-size: 0.66rem;
    }

    body:has(.snapshot-shell) .snapshot-markets {
      column-gap: 7px;
    }

    body:has(.snapshot-shell) .snapshot-markets__median {
      font-size: 0.42rem;
    }

    body:has(.snapshot-shell) .snapshot-market-list {
      font-size: 0.43rem;
    }

    body:has(.snapshot-shell) .snapshot-market-row strong {
      font-size: 0.55rem;
      font-weight: 800 !important;
    }

    body:has(.snapshot-shell) .snapshot-rates__label {
      font-size: 0.42rem;
    }

    body:has(.snapshot-shell) .snapshot-rates__change {
      font-size: 0.37rem;
    }

    body:has(.snapshot-shell) .snapshot-footer {
      font-size: 0.29rem;
    }

    body:has(.snapshot-shell) [data-analytics-settings] {
      left: 16px;
      bottom: 7px;
      min-height: 12px;
      font-size: 0.29rem;
    }
  }
</style>