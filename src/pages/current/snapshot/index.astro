---
import CurrentSnapshotPage from '../../../components/current/CurrentSnapshotPage.astro';
---

<CurrentSnapshotPage />

<script>
  import { initSnapshotWeatherForecast } from '../../../features/current/snapshot-weather-forecast';
  import { initSnapshotElectricityContext } from '../../../features/current/snapshot-electricity-context';

  initSnapshotWeatherForecast();
  initSnapshotElectricityContext();

  const heroClock = document.querySelector<HTMLElement>('#current-snapshot-title');
  const heroClockFormatter = new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hourCycle: 'h23',
    timeZone: 'Europe/Helsinki',
  });

  const renderHeroClock = () => {
    if (!heroClock) return;
    heroClock.textContent = heroClockFormatter.format(new Date());
    heroClock.setAttribute('aria-label', `Current time in Helsinki ${heroClock.textContent}`);
  };

  renderHeroClock();
  window.setInterval(renderHeroClock, 1000);
</script>

<style is:global>
  body:has(.snapshot-shell) #current-snapshot-title {
    font-size: clamp(2.8rem, 9vw, 4.4rem);
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  body:has(.snapshot-shell) .snapshot-titleblock__meta span:last-child {
    display: none;
  }

  body:has(.snapshot-shell) .snapshot-weather {
    grid-template-columns: minmax(0, 0.94fr) minmax(190px, 1.06fr);
    grid-template-rows: minmax(0, 1fr) auto;
    column-gap: 12px;
  }

  body:has(.snapshot-shell) .snapshot-weather__copy {
    grid-column: 1;
    grid-row: 1;
    align-self: center;
  }

  body:has(.snapshot-shell) .snapshot-weather > .snapshot-weather__icon {
    display: none;
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    align-self: center;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    color: var(--ink-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    text-transform: uppercase;
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-slot {
    min-width: 0;
    display: grid;
    grid-template-rows: auto 24px auto;
    justify-items: center;
    align-items: center;
    gap: 2px;
    color: var(--ink-soft);
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-time {
    color: var(--stone);
    font-size: 0.42rem;
    line-height: 1;
    letter-spacing: 0.025em;
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-icon {
    width: 24px;
    height: 24px;
    overflow: visible;
    color: var(--ink-soft);
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-icon path,
  body:has(.snapshot-shell) .snapshot-weather__forecast-icon circle {
    vector-effect: non-scaling-stroke;
  }

  body:has(.snapshot-shell) .snapshot-weather__forecast-temperature {
    color: var(--ink);
    font-size: 0.62rem;
    font-weight: 650;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  body:has(.snapshot-shell) .snapshot-weather .snapshot-source {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  body:has(.snapshot-shell) [data-snapshot-electricity-month-average='true'] {
    font-weight: 600;
  }

  body:has(.snapshot-shell) .snapshot-electricity__chart {
    position: relative;
    padding-top: 10px;
  }

  body:has(.snapshot-shell) .snapshot-electricity__now-marker {
    position: absolute;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: baseline;
    gap: 3px;
    transform: translateX(-50%);
    color: var(--stone);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.39rem;
    line-height: 1;
    letter-spacing: 0.03em;
    white-space: nowrap;
    pointer-events: none;
  }

  body:has(.snapshot-shell) .snapshot-electricity__now-marker strong {
    color: var(--ink);
    font-size: 0.5rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  body:has(.snapshot-shell) .snapshot-electricity__now-marker::after {
    content: '';
    position: absolute;
    top: 10px;
    left: 50%;
    height: 30px;
    border-left: 1px solid color-mix(in srgb, var(--ink-soft) 60%, transparent);
  }

  body:has(.snapshot-shell) .snapshot-market-row strong {
    font-size: 1.1em;
    font-weight: 750;
    letter-spacing: 0.025em;
  }

  @media (max-width: 640px) {
    body:has(.snapshot-shell) #current-snapshot-title {
      font-size: clamp(2.55rem, 12vw, 3.35rem);
    }

    body:has(.snapshot-shell) .snapshot-grid {
      grid-template-rows:
        minmax(0, 1.15fr)
        minmax(0, 1.62fr)
        minmax(0, 1.11fr)
        minmax(0, 1.02fr);
    }

    body:has(.snapshot-shell) .snapshot-weather {
      grid-template-columns: minmax(0, 0.94fr) minmax(166px, 1.06fr);
      column-gap: 6px;
      row-gap: 2px;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast {
      gap: 3px;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-time {
      font-size: 0.4rem;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-icon {
      width: 21px;
      height: 21px;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-slot {
      grid-template-rows: auto 21px auto;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-temperature {
      font-size: 0.59rem;
    }

    body:has(.snapshot-shell) .snapshot-weather__condition {
      font-size: 0.75rem;
    }

    body:has(.snapshot-shell) .snapshot-weather__range {
      font-size: 0.62rem;
    }

    body:has(.snapshot-shell) .snapshot-source {
      font-size: 0.35rem;
      line-height: 1.12;
    }

    body:has(.snapshot-shell) .snapshot-electricity__value .snapshot-micro {
      font-size: 0.41rem;
      line-height: 1.15;
    }

    body:has(.snapshot-shell) .snapshot-electricity__chart {
      padding-top: 11px;
    }

    body:has(.snapshot-shell) .snapshot-electricity__now-marker {
      font-size: 0.4rem;
    }

    body:has(.snapshot-shell) .snapshot-electricity__now-marker strong {
      font-size: 0.52rem;
    }

    body:has(.snapshot-shell) .snapshot-chart-labels {
      font-size: 0.31rem;
    }

    body:has(.snapshot-shell) .snapshot-electricity__stats {
      font-size: 0.39rem;
    }

    body:has(.snapshot-shell) .snapshot-electricity__stats dd {
      font-size: 0.78rem;
      font-weight: 550;
    }

    body:has(.snapshot-shell) .snapshot-market-list {
      font-size: 0.5rem;
    }

    body:has(.snapshot-shell) .snapshot-market-row strong {
      font-size: 0.62rem;
      font-weight: 800;
    }

    body:has(.snapshot-shell) .snapshot-rates {
      gap: 2px;
    }

    body:has(.snapshot-shell) .snapshot-rates__main {
      gap: 8px;
      align-items: center;
    }

    body:has(.snapshot-shell) .snapshot-rates__label {
      font-size: 0.5rem;
    }

    body:has(.snapshot-shell) .snapshot-rates__change {
      margin-top: 2px;
      font-size: 0.4rem;
      line-height: 1;
    }

    body:has(.snapshot-shell) .snapshot-rates .snapshot-source {
      padding-top: 2px;
    }

    body:has(.snapshot-shell) .snapshot-footer {
      font-size: 0.29rem;
    }

    body:has(.snapshot-shell) .snapshot-footer > span:first-child {
      visibility: hidden;
    }

    body:has(.snapshot-shell) [data-analytics-settings] {
      left: 20px;
      right: auto;
      bottom: 10px;
      min-height: 14px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.28rem;
      line-height: 1;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
  }

  @media (max-width: 380px), (max-height: 720px) {
    body:has(.snapshot-shell) #current-snapshot-title {
      font-size: clamp(2.25rem, 11vw, 2.8rem);
    }

    body:has(.snapshot-shell) .snapshot-grid {
      grid-template-rows:
        minmax(0, 1.12fr)
        minmax(0, 1.64fr)
        minmax(0, 1.12fr)
        minmax(0, 1fr);
    }

    body:has(.snapshot-shell) .snapshot-weather {
      grid-template-columns: minmax(0, 0.9fr) minmax(150px, 1.1fr);
      column-gap: 3px;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast {
      gap: 2px;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-time {
      font-size: 0.35rem;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-icon {
      width: 18px;
      height: 18px;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-slot {
      grid-template-rows: auto 18px auto;
    }

    body:has(.snapshot-shell) .snapshot-weather__forecast-temperature {
      font-size: 0.52rem;
    }

    body:has(.snapshot-shell) .snapshot-source {
      font-size: 0.3rem;
    }

    body:has(.snapshot-shell) .snapshot-electricity__value .snapshot-micro {
      font-size: 0.35rem;
    }

    body:has(.snapshot-shell) .snapshot-electricity__stats {
      font-size: 0.33rem;
    }

    body:has(.snapshot-shell) .snapshot-electricity__stats dd {
      font-size: 0.66rem;
    }

    body:has(.snapshot-shell) .snapshot-market-list {
      font-size: 0.43rem;
    }

    body:has(.snapshot-shell) .snapshot-market-row strong {
      font-size: 0.55rem;
      font-weight: 800;
    }

    body:has(.snapshot-shell) .snapshot-rates__label {
      font-size: 0.42rem;
    }

    body:has(.snapshot-shell) .snapshot-rates__change {
      font-size: 0.34rem;
    }

    body:has(.snapshot-shell) .snapshot-footer {
      font-size: 0.25rem;
    }

    body:has(.snapshot-shell) [data-analytics-settings] {
      left: 16px;
      bottom: 7px;
      min-height: 12px;
      font-size: 0.25rem;
    }
  }
</style>