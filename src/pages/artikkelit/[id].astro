---
import ArticlePage from '../../components/ArticlePage.astro';
import OversizedCursorEasterEgg from '../../components/OversizedCursorEasterEgg.astro';

import {
  getPostSlug,
  getPublishedPosts,
  type PublishedPost,
} from '../../utils/posts';

interface Props {
  post: PublishedPost;
  postNumber: string;
}

export async function getStaticPaths() {
  const posts =
    await getPublishedPosts();

  return posts.map(
    (post, index) => ({
      params: {
        id: getPostSlug(post.id),
      },

      props: {
        post,

        postNumber:
          String(
            posts.length - index
          ).padStart(
            2,
            '0'
          ),
      },
    })
  );
}

const {
  post,
  postNumber,
} = Astro.props as Props;
---

<ArticlePage
  post={post}
  postNumber={postNumber}
  lang="fi"
/>
<OversizedCursorEasterEgg />
