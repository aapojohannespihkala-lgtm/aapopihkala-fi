---
import ArticlePage from '../../components/ArticlePage.astro';

import {
  getPostSlug,
  getPublishedPosts,
  type PublishedPost,
} from '../../utils/posts';

interface Props {
  post: PublishedPost;
}

export async function getStaticPaths() {
  const posts =
    await getPublishedPosts();

  return posts.map(
    (post) => ({
      params: {
        id: getPostSlug(post.id),
      },

      props: {
        post,
      },
    })
  );
}

const {
  post,
} = Astro.props as Props;
---

<ArticlePage
  post={post}
  lang="fi"
/>
