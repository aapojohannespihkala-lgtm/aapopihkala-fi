---
import '../../styles/global.css';

import {
  getCollection,
  type CollectionEntry,
} from 'astro:content';

import FeedPost from '../../components/FeedPost.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  postNumber: string;
}

export async function getStaticPaths() {
  const posts = (
    await getCollection('posts')
  )
    .filter(
      (post) =>
        post.data.status === 'published' &&
        Boolean(post.data.publishedAt)
    )
    .sort((a, b) => {
      const aTime = new Date(
        a.data.publishedAt as string
      ).getTime();

      const bTime = new Date(
        b.data.publishedAt as string
      ).getTime();

      return bTime - aTime;
    });

  return posts.map(
    (post, index) => ({
      params: {
        id: post.id,
      },

      props: {
        post,

        postNumber:
          String(
            posts.length - index
          ).padStart(
            2,
            '0'
          ),
      },
    })
  );
}

const {
  post,
  postNumber,
} = Astro.props as Props;

if (
  post.data.status !== 'published' ||
  !post.data.publishedAt
) {
  throw new Error(
    `Published article expected: ${post.id}`
  );
}

const publishedAt =
  post.data.publishedAt;

const localizedPost =
  post.data.fi;

const dateFormatter =
  new Intl.DateTimeFormat(
    'fi-FI',
    {
      day: 'numeric',
      month: 'numeric',
      year: 'numeric',
    }
  );

const datePart =
  publishedAt.slice(
    0,
    10
  );

const displayDate =
  dateFormatter.format(
    new Date(
      `${datePart}T12:00:00`
    )
  );

const canonicalUrl =
  `https://aapopihkala.fi/artikkelit/${post.id}/`;
---

<!doctype html>

<html lang="fi">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>
      {localizedPost.title} - Aapo Pihkala
    </title>

    <meta
      name="description"
      content={localizedPost.intro}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="canonical"
      href={canonicalUrl}
    />
  </head>

  <body>
    <header class="topbar">
      <nav
        class="topbar-inner"
        aria-label="Päänavigaatio"
      >
        <a
          class="topbar-name"
          href="/"
          aria-label="Aapo Pihkalan etusivu"
        >
          aapo
        </a>

        <div class="topbar-actions">
          <a
            class="language-switch"
            href="/en/"
            hreflang="en"
            lang="en"
            aria-label="English"
          >
            EN
          </a>

          <a
            class="linkedin-link"
            href="https://fi.linkedin.com/in/aapo-pihkala"
            target="_blank"
            rel="noopener"
            aria-label="Aapo Pihkala LinkedInissä"
            title="LinkedIn"
          >
            <svg
              class="linkedin-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"
              />
            </svg>
          </a>
        </div>
      </nav>
    </header>

    <main class="main-container">
      <section class="feed">
        <FeedPost
          post={post}
          lang="fi"
          postNumber={postNumber}
          displayDate={displayDate}
          perspectiveLabel="Näkökulma"
          sourceLabel="Lähde"
          headingLevel="h1"
        />
      </section>
    </main>
  </body>
</html>
