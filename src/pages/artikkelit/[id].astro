---
import {
  getCollection,
  type CollectionEntry,
} from 'astro:content';

import ArticlePage from '../../components/ArticlePage.astro';
import { getPostSlug } from '../../utils/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  postNumber: string;
}

export async function getStaticPaths() {
  const posts = (
    await getCollection('posts')
  )
    .filter(
      (post) =>
        post.data.status === 'published' &&
        Boolean(post.data.publishedAt)
    )
    .sort((a, b) => {
      const aTime = new Date(
        a.data.publishedAt as string
      ).getTime();

      const bTime = new Date(
        b.data.publishedAt as string
      ).getTime();

      return bTime - aTime;
    });

  return posts.map(
    (post, index) => ({
      params: {
        id: getPostSlug(post.id),
      },

      props: {
        post,

        postNumber:
          String(
            posts.length - index
          ).padStart(
            2,
            '0'
          ),
      },
    })
  );
}

const {
  post,
  postNumber,
} = Astro.props as Props;
---

<ArticlePage
  post={post}
  postNumber={postNumber}
  lang="fi"
/>
