        xMin: 0,
        xMax: 6.375,
        yMin: 0,
        yMax: 10.81,
      });
      const dReviewPlaneY: Record<'1F' | '2F', number> = {
        '1F': 0.08,
        '2F': 2.84,
      };
      let dCoordinateGridFloor: '1F' | '2F' | null = null;
      let dCoordinateAnchorMarker: any = null;

      const setModelScene = (root: any) => {
        modelRoot.clear();
        if (root) modelRoot.add(root);
        modelRoot.updateMatrixWorld(true);
        refreshEdgeRendering(root);
      };

      const restoreDReviewStyling = () => {
        for (const [material, baseline] of dReviewMaterialBaseline.entries()) {
          material.opacity = baseline.opacity;
          material.transparent = baseline.transparent;
          material.depthWrite = baseline.depthWrite;
          material.needsUpdate = true;
        }
        canvas.dataset.dReviewActive = 'false';
        canvas.dataset.dReviewEmphasisCount = '0';
        canvas.dataset.dReviewContextHiddenCount = '0';
        canvas.dataset.dReviewDoorMarkerVisibleCount = '0';
      };

      const restoreDVisibility = () => {
        for (const [object, visible] of dVisibilityBaseline.entries()) {
          object.visible = visible;
        }
        restoreDReviewStyling();
      };

      const clearD2FBoundaryReviewContext = () => {
        if (d2FBoundaryReviewContext) {
          d2FBoundaryReviewContext.parent?.remove(d2FBoundaryReviewContext);
          d2FBoundaryReviewContext.geometry?.dispose?.();
          const materials = Array.isArray(d2FBoundaryReviewContext.material)
            ? d2FBoundaryReviewContext.material
            : [d2FBoundaryReviewContext.material];
          for (const material of materials) material?.dispose?.();
          d2FBoundaryReviewContext = null;
        }

        canvas.dataset.d2fBoundaryContextPrepared = 'false';
        delete canvas.dataset.d2fBoundaryContextSource;
      };

      const prepareD2FBoundaryReviewContext = () => {
        clearD2FBoundaryReviewContext();
        if (activeModelSourceKind !== 'work-test' || !dInteriorScene) return;

        const z = 2.76 + 0.06;
        const points = [
          new THREE.Vector3(0, z, 0),
          new THREE.Vector3(0, z, -10.81),
          new THREE.Vector3(0, z, -10.81),
          new THREE.Vector3(6.375, z, -10.81),
          new THREE.Vector3(6.375, z, -10.81),
          new THREE.Vector3(6.375, z, 0),
          new THREE.Vector3(6.375, z, 0),
          new THREE.Vector3(0, z, 0),
        ];
        const geometry = new THREE.BufferGeometry().setFromPoints(points);
        const material = new THREE.LineBasicMaterial({
          color: 0x167c5a,
          transparent: true,
          opacity: 0.95,
          depthTest: false,
          depthWrite: false,
        });
        const context = new THREE.LineSegments(geometry, material);
        context.name = 'P137B_D2F_PERIMETER_REVIEW_CONTEXT';
        context.renderOrder = 100;
        context.userData = {
          PresentationOnly: true,
          Canonical: false,
          Pass: '137B',
          storey: '2F',
          representationKind: 'reviewBoundaryContext',
          sourceContract: 'G1_G2_D2F_PLAN_HOST_ENVELOPE',
          sourceEnvelopeYLISG1Local: {
            xM: [0, 6.375],
            yM: [0, 10.81],
            hostZ_M: 2.76,
          },
          presentationLiftM: 0.06,
          exactWallFaceClaim: false,
          wallCenterlineClaim: false,
          wallThicknessClaim: false,
          asBuiltClaim: false,
          humanReview: 'NOT_YET_REVIEWED',
        };

        dInteriorScene.add(context);
        d2FBoundaryReviewContext = context;
        canvas.dataset.d2fBoundaryContextPrepared = 'true';
        canvas.dataset.d2fBoundaryContextSource = 'G1_G2_D2F_PLAN_HOST_ENVELOPE';
      };

      const disposeCoordinateObject = (object: any) => {
        object.geometry?.dispose?.();
        const materials = Array.isArray(object.material) ? object.material : [object.material];
        for (const material of materials) material?.dispose?.();
      };

      const clearDCoordinateGrid = () => {
        for (const child of [...dCoordinateGridGroup.children]) {
          dCoordinateGridGroup.remove(child);
          disposeCoordinateObject(child);
        }
        dCoordinateGridFloor = null;
      };

      const coordinateSteps = (max: number, step: number) => {
        const values: number[] = [];
        for (let value = 0; value < max - 1e-6; value += step) {
          values.push(Number(value.toFixed(6)));
        }
        if (!values.some((value) => Math.abs(value - max) < 1e-6)) values.push(max);
        return values;
      };

      const prepareDCoordinateGrid = (floor: '1F' | '2F') => {
        if (dCoordinateGridFloor === floor && dCoordinateGridGroup.children.length > 0) return;

        clearDCoordinateGrid();
        const planeY = dReviewPlaneY[floor];
        const majorPoints: any[] = [];
        const minorPoints: any[] = [];

        const appendLine = (
          target: any[],
          x1: number,
          y1: number,
          x2: number,
          y2: number,
        ) => {
          target.push(
            new THREE.Vector3(x1, planeY, -y1),
            new THREE.Vector3(x2, planeY, -y2),
          );
        };

        for (const x of coordinateSteps(dCoordinateEnvelope.xMax, 0.5)) {
          const isBoundary =
            Math.abs(x - dCoordinateEnvelope.xMin) < 1e-6 ||
            Math.abs(x - dCoordinateEnvelope.xMax) < 1e-6;
          const isMajor = isBoundary || Math.abs(x - Math.round(x)) < 1e-6;
          appendLine(
            isMajor ? majorPoints : minorPoints,
            x,
            dCoordinateEnvelope.yMin,
            x,
            dCoordinateEnvelope.yMax,
          );
        }

        for (const y of coordinateSteps(dCoordinateEnvelope.yMax, 0.5)) {
          const isBoundary =
            Math.abs(y - dCoordinateEnvelope.yMin) < 1e-6 ||
            Math.abs(y - dCoordinateEnvelope.yMax) < 1e-6;
          const isMajor = isBoundary || Math.abs(y - Math.round(y)) < 1e-6;
          appendLine(
            isMajor ? majorPoints : minorPoints,
            dCoordinateEnvelope.xMin,
            y,
            dCoordinateEnvelope.xMax,
            y,
          );
        }

        const makeGridLines = (points: any[], opacity: number, suffix: string) => {
          const geometry = new THREE.BufferGeometry().setFromPoints(points);
          const material = new THREE.LineBasicMaterial({
            color: 0x59645f,
            transparent: true,
            opacity,
            depthTest: false,
            depthWrite: false,
          });
          const lines = new THREE.LineSegments(geometry, material);
          lines.name = `P137E_D_PLAN_GRID_${suffix}_${floor}`;
          lines.renderOrder = 80;
          lines.userData = {
            PresentationOnly: true,
            Canonical: false,
            Pass: '137E',
            storey: floor,
            representationKind: 'reviewCoordinateGrid',
            coordinateFrame: 'YLIS-G1-LOCAL',
          };
          return lines;
        };

        dCoordinateGridGroup.add(
          makeGridLines(minorPoints, 0.16, 'MINOR_0_5M'),
          makeGridLines(majorPoints, 0.36, 'MAJOR_1M'),
        );
        dCoordinateGridFloor = floor;
      };

      const clearDCoordinateAnchor = () => {
        if (dCoordinateAnchorMarker) {
          scene.remove(dCoordinateAnchorMarker);
          disposeCoordinateObject(dCoordinateAnchorMarker);
          dCoordinateAnchorMarker = null;
        }
        coordinateAnchor.textContent = 'X - / Y -';
        delete canvas.dataset.reviewAnchorX;
        delete canvas.dataset.reviewAnchorY;
      };

      const formatReviewCoordinate = (value: number) =>
        value.toFixed(3).replace('.', ',');

      const dReviewCoordinateAtClientPoint = (clientX: number, clientY: number) => {
        if (!activePlanFloor || activeCamera !== planCamera) return null;
        const rect = canvas.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return null;

        pointer.x = ((clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, planCamera);

        const planeY = dReviewPlaneY[activePlanFloor];
        const plane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -planeY);
        const world = new THREE.Vector3();
        if (!raycaster.ray.intersectPlane(plane, world)) return null;

        return { world, xM: world.x, yM: -world.z };
      };

      const updateDCoordinatePointer = (clientX: number, clientY: number) => {
        const coordinate = dReviewCoordinateAtClientPoint(clientX, clientY);
        if (!coordinate) return;
        coordinatePointer.textContent =
          `X ${formatReviewCoordinate(coordinate.xM)} m / Y ${formatReviewCoordinate(coordinate.yM)} m`;
        canvas.dataset.reviewPointerX = coordinate.xM.toFixed(3);
        canvas.dataset.reviewPointerY = coordinate.yM.toFixed(3);
      };

      const setDCoordinateAnchor = (clientX: number, clientY: number) => {
        const coordinate = dReviewCoordinateAtClientPoint(clientX, clientY);
        if (!coordinate || !activePlanFloor) return;

        clearDCoordinateAnchor();
        const radius = 0.12;
        const markerY = dReviewPlaneY[activePlanFloor] + 0.015;
        const points = [
          new THREE.Vector3(coordinate.xM - radius, markerY, coordinate.world.z),
          new THREE.Vector3(coordinate.xM + radius, markerY, coordinate.world.z),
          new THREE.Vector3(coordinate.xM, markerY, coordinate.world.z - radius),
          new THREE.Vector3(coordinate.xM, markerY, coordinate.world.z + radius),
        ];
        const geometry = new THREE.BufferGeometry().setFromPoints(points);
        const material = new THREE.LineBasicMaterial({
          color: 0xa34a2a,
          depthTest: false,
          depthWrite: false,
        });
        const marker = new THREE.LineSegments(geometry, material);
        marker.name = `P137E_D_PLAN_REVIEW_ANCHOR_${activePlanFloor}`;
        marker.renderOrder = 110;
        marker.userData = {
          PresentationOnly: true,
          Canonical: false,
          Pass: '137E',
          storey: activePlanFloor,
          representationKind: 'humanReviewAnchorMarker',
          coordinateFrame: 'YLIS-G1-LOCAL',
          approx: true,
        };
        scene.add(marker);
        dCoordinateAnchorMarker = marker;

        coordinateAnchor.textContent =
          `X ${formatReviewCoordinate(coordinate.xM)} m / Y ${formatReviewCoordinate(coordinate.yM)} m`;
        canvas.dataset.reviewAnchorX = coordinate.xM.toFixed(3);
        canvas.dataset.reviewAnchorY = coordinate.yM.toFixed(3);
      };

      const activateDCoordinateReview = (floor: '1F' | '2F') => {
        const floorChanged = dCoordinateGridFloor !== floor;
        prepareDCoordinateGrid(floor);
        dCoordinateGridGroup.visible = true;
        coordinatePanel.hidden = false;
        coordinateFloor.textContent = `D ${floor}`;
        coordinatePointer.textContent = 'X - / Y -';
        delete canvas.dataset.reviewPointerX;
        delete canvas.dataset.reviewPointerY;
        if (floorChanged) clearDCoordinateAnchor();
        canvas.dataset.reviewCoordinateFrame = 'YLIS-G1-LOCAL';
        canvas.dataset.reviewGridVisible = 'true';
        canvas.dataset.reviewGridMajorStepM = '1';
        canvas.dataset.reviewGridMinorStepM = '0.5';
      };

      const deactivateDCoordinateReview = () => {
        dCoordinateGridGroup.visible = false;
        coordinatePanel.hidden = true;
        coordinatePointer.textContent = 'X - / Y -';
        delete canvas.dataset.reviewPointerX;
        delete canvas.dataset.reviewPointerY;
        clearDCoordinateAnchor();
        canvas.dataset.reviewGridVisible = 'false';
      };

      const isP136BReviewEmphasis = (object: any) => {
        const data = object?.userData ?? {};
        if (data.PresentationOnly !== true || data.Pass !== '123C') return false;
        if (Object.prototype.hasOwnProperty.call(data, 'sourceP122BNode')) return true;
        if (Object.prototype.hasOwnProperty.call(data, 'sourceLowWallNode')) return true;
        return (
          Object.prototype.hasOwnProperty.call(data, 'sourceP123BNode') &&
          Number(data.alpha) >= 0.35
        );
      };

      const isP136BReviewContext = (object: any) => {
        const data = object?.userData ?? {};
        if (
          data.PresentationOnly === true &&
          (data.representationKind === 'referenceFootprint' ||
            data.representationKind === 'stairHostFootprint')
        ) {
          return true;
        }
        return (
          data.PresentationOnly === true &&
          data.Pass === '123C' &&
          Object.prototype.hasOwnProperty.call(data, 'sourceP123BNode') &&
          Number(data.alpha) < 0.35
        );
      };

      const isDReviewDoorMarker = (object: any) => {
        const data = object?.userData ?? {};
        if (
          !(object.isLine || object.isLineSegments) ||
          data.PresentationOnly !== true ||
          data.markerType !== 'HORIZONTAL_ONLY_REFERENCE_AT_HOST_FLOOR'
        ) {
          return false;
        }

        const sourceBacked =
          data.Pass === '128B' && typeof data.derivedFromG2Id === 'string';
        const userCurrent =
          data.Pass === '137J' &&
          data.sourceClass === 'USER_CURRENT_STATE_DIRECT_OBSERVATION' &&
          d1UserDoorReviewItems.some((item) => item.id === data.reviewDoorId);

        return sourceBacked || userCurrent;
      };

      const clearD1KnownDoorReviewLabels = () => {
        d1KnownDoorLabelBindings.length = 0;
        d1UserDoorLabelBindings.length = 0;
        d1KnownDoorLabelLayer.replaceChildren();
        d1KnownDoorLegendList.replaceChildren();
        d1UserDoorLegendList.replaceChildren();
        d1KnownDoorLabelLayer.hidden = true;
        d1KnownDoorLegend.hidden = true;
        d1UserDoorLegendSection.hidden = true;
        canvas.dataset.d1KnownDoorLabelCount = '0';
        canvas.dataset.d1KnownDoorLabelsVisible = 'false';
        canvas.dataset.d1UserDoorLabelCount = '0';
        canvas.dataset.d1UserDoorLabelsVisible = 'false';
      };

      const rebuildD1KnownDoorReviewLabels = () => {
        clearD1KnownDoorReviewLabels();
        if (activeModelSourceKind !== 'work-test') return;

        for (const item of d1KnownDoorReviewItems) {
          const marker = [...dReviewDoorMarkerLines].find(
            (candidate: any) =>
              candidate?.userData?.storey === '1F' &&
              candidate?.userData?.derivedFromG2Id === item.id,
          );
          if (!marker) continue;

          const label = document.createElement('span');
          label.className = 'd1-known-door-label';
          label.textContent = String(item.number);
          label.dataset.reviewDoorNumber = String(item.number);
          label.dataset.g2Id = item.id;
          d1KnownDoorLabelLayer.append(label);
          d1KnownDoorLabelBindings.push({ element: label, marker });

          const legendItem = document.createElement('li');
          const legendNumber = document.createElement('span');
          legendNumber.className = 'd1-known-door-legend-number';
          legendNumber.textContent = String(item.number);
          const legendBody = document.createElement('span');
          const legendName = document.createElement('span');
          legendName.className = 'd1-known-door-legend-name';
          legendName.textContent = item.name;
          const legendId = document.createElement('code');
          legendId.textContent = item.id;
          legendBody.append(legendName, legendId);
          legendItem.append(legendNumber, legendBody);
          d1KnownDoorLegendList.append(legendItem);
        }

        for (const item of d1UserDoorReviewItems) {
          const marker = [...dReviewDoorMarkerLines].find(
            (candidate: any) =>
              candidate?.userData?.storey === '1F' &&
              candidate?.userData?.reviewDoorId === item.id,
          );
          if (!marker) continue;

          const label = document.createElement('span');
          label.className = 'd1-known-door-label d1-user-door-label';
          label.textContent = item.label;
          label.dataset.reviewDoorId = item.id;
          d1KnownDoorLabelLayer.append(label);
          d1UserDoorLabelBindings.push({ element: label, marker });

          const legendItem = document.createElement('li');
          const legendNumber = document.createElement('span');
          legendNumber.className =
            'd1-known-door-legend-number d1-user-door-legend-number';
          legendNumber.textContent = item.label;
          const legendBody = document.createElement('span');
          const legendName = document.createElement('span');
          legendName.className = 'd1-known-door-legend-name';
          legendName.textContent = item.name;
          const legendId = document.createElement('code');
          legendId.textContent = item.id;
          legendBody.append(legendName, legendId);
          legendItem.append(legendNumber, legendBody);
          d1UserDoorLegendList.append(legendItem);
        }

        canvas.dataset.d1KnownDoorLabelCount = String(d1KnownDoorLabelBindings.length);
        canvas.dataset.d1UserDoorLabelCount = String(d1UserDoorLabelBindings.length);
      };

      const setD1KnownDoorReviewLabelsVisible = (visible: boolean) => {
        const show =
          visible &&
          activeModelSourceKind === 'work-test' &&
          activePlanFloor === '1F' &&
          d1KnownDoorLabelBindings.length === d1KnownDoorReviewItems.length;
        const showUserCurrent =
          show && d1UserDoorLabelBindings.length === d1UserDoorReviewItems.length;
        d1KnownDoorLabelLayer.hidden = !show;
        d1KnownDoorLegend.hidden = !show;
        d1UserDoorLegendSection.hidden = !showUserCurrent;
        canvas.dataset.d1KnownDoorLabelsVisible = show ? 'true' : 'false';
        canvas.dataset.d1UserDoorLabelsVisible = showUserCurrent ? 'true' : 'false';
      };

      const updateD1KnownDoorReviewLabelPositions = () => {
        if (
          d1KnownDoorLabelLayer.hidden ||
          activePlanFloor !== '1F' ||
          activeCamera !== planCamera
        ) {
          return;
        }

        for (const binding of [...d1KnownDoorLabelBindings, ...d1UserDoorLabelBindings]) {
          const { element, marker } = binding;
          if (!marker.visible) {
            element.hidden = true;
            continue;
          }

          marker.updateWorldMatrix(true, false);
          marker.geometry?.computeBoundingBox?.();
          const localBounds = marker.geometry?.boundingBox;
          if (!localBounds || localBounds.isEmpty()) {
            element.hidden = true;
            continue;
          }

          const worldBounds = localBounds.clone().applyMatrix4(marker.matrixWorld);
          const center = worldBounds.getCenter(new THREE.Vector3()).project(planCamera);
          const onScreen =
            center.z >= -1 &&
            center.z <= 1 &&
            center.x >= -1.05 &&
            center.x <= 1.05 &&
            center.y >= -1.05 &&
            center.y <= 1.05;
          element.hidden = !onScreen;
          if (!onScreen) continue;

          element.style.left = `${((center.x + 1) * 0.5 * canvas.clientWidth).toFixed(1)}px`;
          element.style.top = `${((1 - center.y) * 0.5 * canvas.clientHeight).toFixed(1)}px`;
        }
      };

      const prepareDReviewStyling = () => {
        dReviewEmphasisMeshes.clear();
        dReviewContextMeshes.clear();
        dReviewDoorMarkerLines.clear();
        dReviewMaterialBaseline.clear();
        canvas.dataset.dReviewPrepared = 'false';
        canvas.dataset.dReviewDoorMarkerPreparedCount = '0';
        restoreDReviewStyling();

        if (activeModelSourceKind !== 'work-test' || !dInteriorScene) return;

        dInteriorScene.traverse((object: any) => {
          if (isDReviewDoorMarker(object)) {
            dReviewDoorMarkerLines.add(object);
            const isUserCurrentDoor = object?.userData?.Pass === '137J';
            const promoteDoorMarkerMaterial = (material: any) => {
              if (!material?.clone) return material;
              const clone = material.clone();
              clone.opacity = 1;
              clone.transparent = true;
              clone.depthTest = false;
              clone.depthWrite = false;
              if (isUserCurrentDoor && clone.color?.setHex) {
                clone.color.setHex(0x7b247d);
              }
              clone.needsUpdate = true;
              return clone;
            };

            if (Array.isArray(object.material)) {
              object.material = object.material.map((material: any) =>
                promoteDoorMarkerMaterial(material),
              );
            } else {
              object.material = promoteDoorMarkerMaterial(object.material);
            }
            object.renderOrder = isUserCurrentDoor ? 140 : 120;
          }

          if (!object.isMesh) return;
          if (isP136BReviewContext(object)) dReviewContextMeshes.add(object);
          if (!isP136BReviewEmphasis(object)) return;

          dReviewEmphasisMeshes.add(object);
          const cloneAndRegister = (material: any) => {
            if (!material?.clone) return material;
            const clone = material.clone();
            dReviewMaterialBaseline.set(clone, {
              opacity: typeof clone.opacity === 'number' ? clone.opacity : 1,
              transparent: Boolean(clone.transparent),
              depthWrite: clone.depthWrite !== false,
            });
            return clone;
          };

          if (Array.isArray(object.material)) {
            object.material = object.material.map((material: any) => cloneAndRegister(material));
          } else {
            object.material = cloneAndRegister(object.material);
          }
        });

        canvas.dataset.dReviewDoorMarkerPreparedCount = String(dReviewDoorMarkerLines.size);
        canvas.dataset.dReviewPrepared =
          dReviewEmphasisMeshes.size > 0 || dReviewDoorMarkerLines.size > 0 ? 'true' : 'false';
        rebuildD1KnownDoorReviewLabels();
      };

      const applyDReviewStyling = (floor: '1F' | '2F') => {
        if (
          activeModelSourceKind !== 'work-test' ||
          (dReviewEmphasisMeshes.size === 0 && dReviewDoorMarkerLines.size === 0)
        ) {
          canvas.dataset.dReviewActive = 'false';
          canvas.dataset.dReviewDoorMarkerVisibleCount = '0';
          return;
        }

        let emphasized = 0;
        let contextHidden = 0;
        let doorMarkersVisible = 0;

        for (const object of dReviewContextMeshes) {
          if (!object.visible || !hasFloorToken(object, floor)) continue;
          object.visible = false;
          contextHidden += 1;
        }

        for (const object of dReviewEmphasisMeshes) {
          if (!object.visible || !hasFloorToken(object, floor)) continue;
          const objectMaterials = Array.isArray(object.material) ? object.material : [object.material];
          for (const material of objectMaterials) {
            if (!material) continue;
            material.opacity = 1;
            material.transparent = false;
            material.depthWrite = true;
            material.needsUpdate = true;
          }
          emphasized += 1;
        }

        for (const object of dReviewDoorMarkerLines) {
          if (!object.visible || !hasFloorToken(object, floor)) continue;
          doorMarkersVisible += 1;
        }

        canvas.dataset.dReviewActive =
          emphasized > 0 || doorMarkersVisible > 0 ? 'true' : 'false';
        canvas.dataset.dReviewEmphasisCount = String(emphasized);
        canvas.dataset.dReviewContextHiddenCount = String(contextHidden);
        canvas.dataset.dReviewDoorMarkerVisibleCount = String(doorMarkersVisible);
      };

      const semanticName = (object: any) => {
        const names: string[] = [];
        let current = object;
        let depth = 0;

        while (current && depth < 12) {
          if (current.name) names.push(String(current.name));
          current = current.parent;
          depth += 1;
        }

        return names.join(' | ').toUpperCase();
      };

      const normalizeSceneName = (name: unknown) =>
        String(name ?? '')
          .toUpperCase()
          .replace(/[^A-Z0-9]+/g, ' ')
          .trim();

      const findSourceNamedScene = (gltf: any, sourceName: string) => {
        const sourceScenes = gltf?.parser?.json?.scenes;
        if (Array.isArray(sourceScenes)) {
          const sourceIndex = sourceScenes.findIndex((candidate: any) => candidate?.name === sourceName);
          if (sourceIndex >= 0 && gltf.scenes?.[sourceIndex]) {
            return gltf.scenes[sourceIndex];
          }
        }

        const target = normalizeSceneName(sourceName);
        return (
          gltf.scenes?.find((candidate: any) => normalizeSceneName(candidate?.name) === target) ?? null
        );
      };

      const isDPlanRenderable = (object: any) =>
        object.isMesh || object.isLine || object.isLineSegments || object.isPoints;

      const hasFloorToken = (object: any, floor: '1F' | '2F') => {
        const explicitStorey = String(object?.userData?.storey ?? '').toUpperCase();
        if (explicitStorey === floor) return true;

        const name = semanticName(object);
        return new RegExp('(^|[_\\s-])(?:D[_\\s-]?)?' + floor + '([_\\s-]|$)').test(name);
      };

      const isRoofLayerMember = (object: any) => {
        const data = object?.userData ?? {};
        return (
          data.presentationLayer === 'REFERENCE_ROOF' ||
          data.representationKind === 'presentationRoofStepFace' ||
          Array.isArray(data.derivedRoofReferenceEnvelopeY_M) ||
          (
            data.sourceContract === 'R3-D09' &&
            Object.prototype.hasOwnProperty.call(data, 'physicalEaveExtentClaim')
          )
        );
      };

      const routePresentationLayers = new Set([
        'G3_LOCUS_SITE',
        'LOCUS_PARCEL_ROUTES',
        'KVV_1974_SITE_ROUTES',
        'KVV_2017_A1F_WATER',
      ]);

      const isLocusLayerMember = (object: any) =>
        routePresentationLayers.has(String(object?.userData?.presentationLayer ?? ''));

      type P161SystemLayerFamily = 'KVV_2017' | 'IV_1974_PLAN' | 'IV_1974_SECTION';

      const p161SystemLayerFamily = (object: any): P161SystemLayerFamily | null => {
        const data = object?.userData ?? {};
        if (
          data.Pass === 'P156I' &&
          data.Purpose === 'mainCandidate2017PresentationSuccessor'
        ) {
          return 'KVV_2017';
        }
        if (
          data.Pass === 'P144C' &&
          data.Purpose === 'presentationOnlyFederatedOverlay'
        ) {
          return 'IV_1974_PLAN';
        }
        if (data.Purpose === 'presentationOnlySectionSidecarRoot') {
          return 'IV_1974_SECTION';
        }
        return null;
      };

      const isP161SystemLayerMember = (object: any) => {
        if (p161SystemLayerFamily(object)) return true;

        const data = object?.userData ?? {};
        if (data.sourceFamily === 'KVV_MAIN_2017_WORK_ASSUMPTION') return true;
        if (
          data.systemDomain === 'IV' &&
          String(data.phase) === '1974' &&
          data.sourceGeometryDimension === '2D_XY_PLAN'
        ) {
          return true;
        }
        if (
          data.placementMode === 'PRESENTATION_SIDECAR' &&
          (typeof data.G3Id === 'string' || typeof data.g3Id === 'string')
        ) {
          return true;
        }
        return false;
      };

      const isP161SystemsLayerReviewRequested = () =>
        new URLSearchParams(window.location.search).get('review') === p161ReviewId;

      const edgeSemanticTokens = [
        'ANNOTATION',
        'ANCHOR',
        'BARB',
        'BOUNDARY',
        'CONTOUR',
        'GRID',
        'LABEL',
        'MARKER',
        'PROFILE',
        'ROUTE',
        'UTILITY',
      ];

      const isSemanticViewerLine = (object: any) => {
        const data = object?.userData ?? {};
        const presentationLayer = String(data.presentationLayer ?? '').toUpperCase();
        if (presentationLayer) return true;
        if (data.presentationSubgroup) return true;
        if (data.markerType) return true;

        const semantic = [
          object?.name,
          data.representationKind,
          data.geometryType,
          data.reviewScope,
          data.sourceContract,
          data.markerType,
        ]
          .map((value) => String(value ?? '').toUpperCase())
          .join(' ');

        return edgeSemanticTokens.some((token) => semantic.includes(token));
      };

      const isTreeVisible = (object: any) => {
        let current = object;
        while (current) {
          if (current.visible === false) return false;
          if (current === modelRoot) break;
          current = current.parent;
        }
        return true;
      };

      const hasVisibleEdgeMaterial = (object: any) => {
        const materials = Array.isArray(object?.material) ? object.material : [object?.material];
        return materials.some((material: any) => material && (material.opacity ?? 1) > 0.01);
      };

      const isEdgeMeshCandidate = (object: any) => {
        if (!object?.isMesh || !object.geometry || !isTreeVisible(object) || !hasVisibleEdgeMaterial(object)) {
          return false;
        }

        const data = object.userData ?? {};
        const presentationLayer = String(data.presentationLayer ?? '').toUpperCase();
        if (routePresentationLayers.has(presentationLayer)) return false;
        if (data.presentationSubgroup === 'WATER' || data.presentationSubgroup === 'WASTEWATER') {
          return false;
        }

        const semantic = [
          object.name,
          data.representationKind,
          data.geometryType,
          data.reviewScope,
          data.presentationLayer,
        ]
          .map((value) => String(value ?? '').toUpperCase())
          .join(' ');

        const nonArchitectureTokens = [
          'ANCHOR',
          'BARB',
          'CONTOUR',
          'GROUND_REVIEW',
          'LABEL',
          'MARKER',
          'POINT',
          'ROUTE',
          'TERRAIN',
          'UTILITY',
        ];
        if (nonArchitectureTokens.some((token) => semantic.includes(token))) return false;

        if (
          data.presentationOnly === true &&
          !isRoofLayerMember(object) &&
          !isArchBaseMaterial(Array.isArray(object.material) ? object.material[0] : object.material)
        ) {
          return false;
        }

        return true;
      };

      const clearEdgeOverlay = () => {
        const geometries = new Set<any>();
        const materials = new Set<any>();
        edgeOverlayGroup.traverse((object: any) => {
          if (object.geometry) geometries.add(object.geometry);
          const objectMaterials = Array.isArray(object.material) ? object.material : [object.material];
          for (const material of objectMaterials) if (material) materials.add(material);
        });
        edgeOverlayGroup.clear();
        for (const geometry of geometries) geometry.dispose?.();
        for (const material of materials) material.dispose?.();
      };

      const restoreLegacyEdgeVisibility = () => {
        for (const [object, visible] of legacyEdgeVisibilityBaseline.entries()) {
          object.visible = visible;
        }
        legacyEdgeVisibilityBaseline.clear();
      };

      const makeEdgeMaterial = (depthTest: boolean) =>
        new THREE.LineBasicMaterial({
          color: 0x6d716e,
          transparent: true,
          opacity: 0.72,
          depthTest,
          depthWrite: false,
        });

      const vertexKey = (point: any) =>
        [point.x, point.y, point.z].map((value) => Math.round(value * 10000)).join(',');

      const addUnifiedMeshEdges = (
        mesh: any,
        edgeMap: Map<string, { a: any; b: any; normals: any[] }>,
      ) => {
        const geometry = mesh.geometry;
        const position = geometry?.getAttribute?.('position');
        if (!position || position.itemSize < 3) return;

        const index = geometry.getIndex?.();
        const triangleCount = index
          ? Math.floor(index.count / 3)
          : Math.floor(position.count / 3);
        const readVertex = (vertexIndex: number) =>
          new THREE.Vector3()
            .fromBufferAttribute(position, vertexIndex)
            .applyMatrix4(mesh.matrixWorld);

        for (let triangle = 0; triangle < triangleCount; triangle += 1) {
          const i0 = index ? index.getX(triangle * 3) : triangle * 3;
          const i1 = index ? index.getX(triangle * 3 + 1) : triangle * 3 + 1;
          const i2 = index ? index.getX(triangle * 3 + 2) : triangle * 3 + 2;
          const vertices = [readVertex(i0), readVertex(i1), readVertex(i2)];
          const normal = new THREE.Vector3()
            .subVectors(vertices[1], vertices[0])
            .cross(new THREE.Vector3().subVectors(vertices[2], vertices[0]));
          if (normal.lengthSq() < 1e-12) continue;
          normal.normalize();

          for (const [aIndex, bIndex] of [[0, 1], [1, 2], [2, 0]]) {
            const a = vertices[aIndex];
            const b = vertices[bIndex];
            const aKey = vertexKey(a);
            const bKey = vertexKey(b);
            const key = aKey < bKey ? aKey + '|' + bKey : bKey + '|' + aKey;
            const record = edgeMap.get(key);
            if (record) {
              record.normals.push(normal.clone());
            } else {
              edgeMap.set(key, { a: a.clone(), b: b.clone(), normals: [normal.clone()] });
            }
          }
        }
      };

      const buildUnifiedEdgeGeometry = (meshes: any[]) => {
        const edgeMap = new Map<string, { a: any; b: any; normals: any[] }>();
        for (const mesh of meshes) addUnifiedMeshEdges(mesh, edgeMap);

        const creaseCos = Math.cos(THREE.MathUtils.degToRad(8));
        const points: any[] = [];
        for (const record of edgeMap.values()) {
          let keep = record.normals.length === 1;
          if (!keep) {
            const reference = record.normals[0];
            keep = record.normals
              .slice(1)
              .some((normal) => Math.abs(reference.dot(normal)) < creaseCos);
          }
          if (keep) points.push(record.a, record.b);
        }

        return new THREE.BufferGeometry().setFromPoints(points);
      };

      const refreshEdgeRendering = (root: any) => {
        restoreLegacyEdgeVisibility();
        clearEdgeOverlay();

        let suppressedLegacyLines = 0;
        let semanticLines = 0;
        const meshes: any[] = [];

        if (root) {
          root.updateMatrixWorld?.(true);
          root.traverse?.((object: any) => {
            if (object.isLine || object.isLineSegments) {
              if (isSemanticViewerLine(object)) {
                if (isTreeVisible(object)) semanticLines += 1;
              } else {
                legacyEdgeVisibilityBaseline.set(object, object.visible);
                if (object.visible) suppressedLegacyLines += 1;
                object.visible = false;
              }
              return;
            }
            if (isEdgeMeshCandidate(object)) meshes.push(object);
          });
        }

        let segmentCount = 0;
        const depthTest = edgeMode === 'visible';

        if (edgeMode === 'object') {
          const material = makeEdgeMaterial(false);
          for (const mesh of meshes) {
            const geometry = new THREE.EdgesGeometry(mesh.geometry, 8);
            const positions = geometry.getAttribute('position');
            if (!positions || positions.count === 0) {
              geometry.dispose();
              continue;
            }
            const edgeObject = new THREE.LineSegments(geometry, material);
            edgeObject.matrixAutoUpdate = false;
            edgeObject.matrix.copy(mesh.matrixWorld);
            edgeObject.frustumCulled = false;
            edgeOverlayGroup.add(edgeObject);
            segmentCount += Math.floor(positions.count / 2);
          }
          if (edgeOverlayGroup.children.length === 0) material.dispose();
        } else if (edgeMode === 'unified' || edgeMode === 'visible') {
          const geometry = buildUnifiedEdgeGeometry(meshes);
          const positions = geometry.getAttribute('position');
          segmentCount = positions ? Math.floor(positions.count / 2) : 0;
          if (segmentCount > 0) {
            const edgeObject = new THREE.LineSegments(geometry, makeEdgeMaterial(depthTest));
            edgeObject.frustumCulled = false;
            edgeOverlayGroup.add(edgeObject);
          } else {
            geometry.dispose();
          }
        }

        edgeModeSelect.value = edgeMode;
        canvas.dataset.edgeMode = edgeMode;
        canvas.dataset.edgeSourceMeshCount = String(meshes.length);
        canvas.dataset.edgeOverlaySegmentCount = String(segmentCount);
        canvas.dataset.edgeLegacySuppressedCount = String(suppressedLegacyLines);
        canvas.dataset.edgeSemanticLineCount = String(semanticLines);
        canvas.dataset.edgeDepthTest = String(depthTest);
      };

      const hasLocusLayerAncestor = (object: any) => {
        let current = object;
        while (current && current !== fullModelScene?.parent) {
          if (isLocusLayerMember(current)) return true;
          if (current === fullModelScene) break;
          current = current.parent;
        }
        return false;
      };

      const isArchBaseMaterial = (material: any) =>
        material?.userData?.presentationGroup === 'ARCH_BASE';

      const makeOpaqueArchBaseMaterial = (material: any) => {
        if (!isArchBaseMaterial(material) || !material?.clone) return material;
        const clone = material.clone();
        clone.opacity = 1;
        clone.transparent = false;
        clone.needsUpdate = true;
        archBaseMaterialCloneCount += 1;
        return clone;
      };

      const initializeFullModelArchBase = () => {
        archBaseMaterialCloneCount = 0;
        if (!fullModelScene) return;

        fullModelScene.traverse((object: any) => {
          if (!object.isMesh) return;
          if (Array.isArray(object.material)) {
            object.material = object.material.map((material: any) => makeOpaqueArchBaseMaterial(material));
          } else {
            object.material = makeOpaqueArchBaseMaterial(object.material);
          }
        });

        canvas.dataset.archBaseMaterialCloneCount = String(archBaseMaterialCloneCount);
        canvas.dataset.archBaseOpacity = archBaseMaterialCloneCount > 0 ? '1' : '';
      };

      const registerRoofMaterial = (material: any) => {
        if (!material || roofLayerMaterialBaseline.has(material)) return material;
        roofLayerMaterialBaseline.set(material, {
          opacity: typeof material.opacity === 'number' ? material.opacity : 1,
          transparent: Boolean(material.transparent),
        });
        return material;
      };

      const cloneRoofMeshMaterial = (mesh: any) => {
        const material = mesh.material;
        if (Array.isArray(material)) {
          mesh.material = material.map((item: any) => registerRoofMaterial(item.clone()));
        } else if (material?.clone) {
          mesh.material = registerRoofMaterial(material.clone());
        }
      };

      const applyRoofLayerState = () => {
        for (const member of roofLayerMembers) {
          const baseline = roofLayerVisibilityBaseline.get(member) ?? true;
          member.visible = baseline && roofLayerVisible;
        }

        for (const material of roofLayerMaterialBaseline.keys()) {
          material.opacity = Math.max(0, Math.min(1, roofLayerOpacity));
          material.transparent = material.opacity < 0.999;
          material.needsUpdate = true;
        }

        roofLayerOpacityValue.textContent = `${Math.round(roofLayerOpacity * 100)} %`;
        const roofMaterialOpacity = roofLayerMaterialBaseline.keys().next().value?.opacity;
        roofLayerOpacityValue.dataset.materialOpacity =
          typeof roofMaterialOpacity === 'number' ? String(roofMaterialOpacity) : '';
        refreshEdgeRendering(modelRoot.children[0] ?? null);
      };

      const initializeRoofLayer = () => {
        roofLayerMembers.clear();
        roofLayerMeshes.clear();
        roofLayerVisibilityBaseline.clear();
        roofLayerMaterialBaseline.clear();

        if (!fullModelScene) {
          roofLayerCount.textContent = '0 kohdetta';
          return;
        }

        fullModelScene.traverse((object: any) => {
          if (!isRoofLayerMember(object)) return;

          roofLayerMembers.add(object);
          roofLayerVisibilityBaseline.set(object, object.visible);

          object.traverse((child: any) => {
            if (!child.isMesh || roofLayerMeshes.has(child)) return;
            roofLayerMeshes.add(child);
            cloneRoofMeshMaterial(child);
          });
        });

        roofLayerCount.textContent = `${roofLayerMeshes.size} kohdetta`;
        applyRoofLayerState();
      };

      const applyLocusLayerState = () => {
        for (const member of locusLayerMembers) {
          const baseline = locusLayerVisibilityBaseline.get(member) ?? true;
          member.visible = baseline && locusLayerVisible;
        }

        locusLayerVisibleInput.checked = locusLayerVisible;
        locusLayerVisibleInput.disabled = locusLayerMembers.size === 0;
        canvas.dataset.locusLayerVisible = locusLayerVisible ? 'true' : 'false';

        if (isP161SystemsLayerReviewRequested()) {
          const renderables = new Set<any>();
          for (const member of locusLayerMembers) {
            member.traverse?.((object: any) => {
              if (
                object?.isMesh ||
                object?.isLine ||
                object?.isLineSegments ||
                object?.isPoints
              ) {
                renderables.add(object);
              }
            });
          }
          const visibleRenderables = [...renderables].filter((object) => isTreeVisible(object));
          canvas.dataset.p161SystemLayerRenderableCount = String(renderables.size);
          canvas.dataset.p161VisibleSystemLayerRenderableCount = String(
            visibleRenderables.length,
          );
        } else {
          delete canvas.dataset.p161SystemLayerRenderableCount;
          delete canvas.dataset.p161VisibleSystemLayerRenderableCount;
        }

        if (selectedObject && !isEffectivelyVisible(selectedObject)) clearSelection();
      };

      const applyViewerLayerState = (
        next: Partial<ViewerLayerState>,
        source: 'manual' | `preset:${string}` = 'manual',
      ) => {
        if (typeof next.roofVisible === 'boolean') roofLayerVisible = next.roofVisible;
        if (typeof next.roofOpacity === 'number') {
          roofLayerOpacity = Math.max(0, Math.min(1, next.roofOpacity));
        }
        if (typeof next.locusVisible === 'boolean') locusLayerVisible = next.locusVisible;
        if (next.edgeMode) edgeMode = next.edgeMode;

        roofLayerVisibleInput.checked = roofLayerVisible;
        roofLayerOpacityInput.value = String(Math.round(roofLayerOpacity * 100));
        locusLayerVisibleInput.checked = locusLayerVisible;
        edgeModeSelect.value = edgeMode;

        applyRoofLayerState();
        applyLocusLayerState();
        refreshEdgeRendering(modelRoot.children[0] ?? null);

        canvas.dataset.layerStateSource = source;
        canvas.dataset.layerRoofVisible = roofLayerVisible ? 'true' : 'false';
        canvas.dataset.layerRoofOpacity = String(roofLayerOpacity);
        canvas.dataset.layerLocusVisible = locusLayerVisible ? 'true' : 'false';
        canvas.dataset.layerEdgeMode = edgeMode;
      };

      const initializeLocusLayer = () => {
        locusLayerMembers.clear();
        locusLayerObjects.clear();
        locusWaterObjects.clear();
        locusWastewaterObjects.clear();
        locusLayerVisibilityBaseline.clear();

        const p161SystemsReview = isP161SystemsLayerReviewRequested();
        locusLayerVisible = p161SystemsReview;

        let p161Kvv2017Count = 0;
        let p161Iv1974PlanCount = 0;
        let p161Iv1974SectionCount = 0;

        if (fullModelScene) {
          fullModelScene.traverse((object: any) => {
            if (p161SystemsReview) {
              if (isP161SystemLayerMember(object)) {
                object.traverse?.((member: any) => {
                  if (locusLayerMembers.has(member)) return;
                  locusLayerMembers.add(member);
                  locusLayerVisibilityBaseline.set(member, member.visible);
                });
              }

              const data = object?.userData ?? {};
              if (
                data.sourceFamily === 'KVV_MAIN_2017_WORK_ASSUMPTION' &&
                Number.isFinite(Number(data.sourcePrimitiveCount))
              ) {
                p161Kvv2017Count = Math.max(
                  p161Kvv2017Count,
                  Number(data.sourcePrimitiveCount),
                );
              }
              if (
                data.systemDomain === 'IV' &&
                String(data.phase) === '1974' &&
                data.sourceGeometryDimension === '2D_XY_PLAN'
              ) {
                p161Iv1974PlanCount += 1;
              }
              if (
                data.placementMode === 'PRESENTATION_SIDECAR' &&
                (typeof data.G3Id === 'string' || typeof data.g3Id === 'string')
              ) {
                p161Iv1974SectionCount += 1;
              }
              return;
            }

            if (isLocusLayerMember(object)) {
              locusLayerMembers.add(object);
              locusLayerVisibilityBaseline.set(object, object.visible);
            }

            if (!hasLocusLayerAncestor(object)) return;
            const subgroup = object?.userData?.presentationSubgroup;
            if (subgroup !== 'WATER' && subgroup !== 'WASTEWATER') return;

            locusLayerObjects.add(object);
            if (subgroup === 'WATER') locusWaterObjects.add(object);
            if (subgroup === 'WASTEWATER') locusWastewaterObjects.add(object);
          });
        }

        if (p161SystemsReview) {
          const p161TotalCount =
            p161Kvv2017Count + p161Iv1974PlanCount + p161Iv1974SectionCount;
          const p161IvTotalCount = p161Iv1974PlanCount + p161Iv1974SectionCount;
          locusLayerCount.textContent = `${p161TotalCount} lähdekohdetta`;
          locusWaterCount.textContent = `KVV 2017: ${p161Kvv2017Count}`;
          locusWastewaterCount.textContent =
            `IV 1974: ${p161IvTotalCount} (${p161Iv1974PlanCount} suunnitelma + ${p161Iv1974SectionCount} leikkaus)`;
          canvas.dataset.locusLayerCount = String(p161TotalCount);
          canvas.dataset.locusWaterCount = String(p161Kvv2017Count);
          canvas.dataset.locusWastewaterCount = String(p161IvTotalCount);
          canvas.dataset.p161KvvLayerCount = String(p161Kvv2017Count);
          canvas.dataset.p161IvPlanLayerCount = String(p161Iv1974PlanCount);
          canvas.dataset.p161SectionSidecarLayerCount = String(p161Iv1974SectionCount);
        } else {
          const objectCount = locusLayerObjects.size || locusLayerMembers.size;
          locusLayerCount.textContent = `${objectCount} kohdetta`;
          locusWaterCount.textContent = `Vesi ${locusWaterObjects.size}`;
          locusWastewaterCount.textContent = `Jätevesi ${locusWastewaterObjects.size}`;
          canvas.dataset.locusLayerCount = String(objectCount);
          canvas.dataset.locusWaterCount = String(locusWaterObjects.size);
          canvas.dataset.locusWastewaterCount = String(locusWastewaterObjects.size);
          delete canvas.dataset.p161KvvLayerCount;
          delete canvas.dataset.p161IvPlanLayerCount;
          delete canvas.dataset.p161SectionSidecarLayerCount;
        }
        applyLocusLayerState();
      };

      const setLayersPanelOpen = (open: boolean) => {
        layersPanel.hidden = !open;
        layersButton.setAttribute('aria-expanded', String(open));
      };

      const computeVisibleBounds = (root: any, includeNonMeshGeometry = false) => {
        const bounds = new THREE.Box3();
        let found = false;

        root.updateMatrixWorld(true);
        root.traverse((object: any) => {
          const boundsEligible =
            object.isMesh ||
            (includeNonMeshGeometry && (object.isLine || object.isLineSegments || object.isPoints));
          if (!boundsEligible || !object.visible || !object.geometry) return;

          let current = object.parent;
          while (current && current !== root.parent) {
            if (!current.visible) return;
            current = current.parent;
          }

          if (!object.geometry.boundingBox) object.geometry.computeBoundingBox();
          if (!object.geometry.boundingBox) return;

          const objectBounds = object.geometry.boundingBox.clone().applyMatrix4(object.matrixWorld);
          if (objectBounds.isEmpty()) return;
          bounds.union(objectBounds);
          found = true;
        });

        return found ? bounds : null;
      };

      const isEffectivelyVisible = (object: any) => {
        let current = object;
        while (current && current !== modelRoot.parent) {
          if (!current.visible) return false;
          if (current === modelRoot) return true;
          current = current.parent;
        }
        return false;
      };

      const hasVisibleMaterial = (object: any) => {
        const materials = Array.isArray(object?.material) ? object.material : [object?.material];
        return materials.some((material: any) => !material || material.opacity === undefined || material.opacity > 0.01);
      };

      const explicitFloorToken = (object: any) => {
        const has1F = hasFloorToken(object, '1F');
        const has2F = hasFloorToken(object, '2F');
        if (has1F && has2F) return '1F / 2F';
        if (has1F) return '1F';
        if (has2F) return '2F';
        return '-';
      };

      const resetObjectVisibilityFilterState = () => {
        objectVisibilityBaseline.clear();
        objectVisibilityFilterActive = false;
        showAllObjectsButton.disabled = true;
        delete canvas.dataset.objectVisibilityMode;
        delete canvas.dataset.objectVisibilityTarget;
        canvas.dataset.objectVisibilityFilter = 'inactive';
      };

      const captureObjectVisibilityBaseline = () => {
        if (objectVisibilityFilterActive) return;
        objectVisibilityBaseline.clear();
        modelRoot.traverse((object: any) => {
          if (isObjectVisibilityRenderable(object)) {
            objectVisibilityBaseline.set(object, object.visible);
          }
        });
        objectVisibilityFilterActive = true;
        showAllObjectsButton.disabled = false;
        canvas.dataset.objectVisibilityFilter = 'active';
      };

      const renderSelectionMetadata = (object: any) => {
        selectionMetadataList.replaceChildren();
        const entries = collectSelectionMetadataEntries(object, modelRoot);
        selectionMetadataEmpty.hidden = entries.length > 0;
        canvas.dataset.selectionMetadataCount = String(entries.length);
        canvas.dataset.selectionMetadataSource = entries.length > 0 ? 'userData' : 'none';

        for (const [key, value] of entries) {
          const label = document.createElement('dt');
          label.textContent = formatSelectionMetadataKey(key);
          const content = document.createElement('dd');
          content.textContent = value;
          selectionMetadataList.append(label, content);
        }
      };

      const clearSelection = () => {
        if (selectionHelper) {
          scene.remove(selectionHelper);
          selectionHelper.geometry?.dispose?.();
          selectionHelper.material?.dispose?.();
          selectionHelper = null;
        }

        selectionPanel.hidden = true;
        selectedObject = null;
        selectionMesh.textContent = '-';
        selectionGroup.textContent = '-';
        selectionScene.textContent = '-';
        selectionFloor.textContent = '-';
        selectionKind.textContent = '-';
        selectionMetadataList.replaceChildren();
        selectionMetadataEmpty.hidden = false;
        delete canvas.dataset.selectionMetadataCount;
        delete canvas.dataset.selectionMetadataSource;
      };

      const selectObject = (object: any) => {
        clearSelection();

        selectedObject = object;
        selectionMesh.textContent = object.name ? String(object.name) : '(nimetön kohde)';
        selectionGroup.textContent = nearestNamedAncestor(object, modelRoot) || '-';
        selectionScene.textContent =
          sceneNameForObject(
            object,
            modelRoot,
            sourceSceneNames,
            activePlanFloor ? dInteriorScene : fullModelScene,
          ) || '-';
        selectionFloor.textContent = explicitFloorToken(object);
        selectionKind.textContent = selectionKindLabel(object);
        renderSelectionMetadata(object);
        selectionPanel.hidden = false;

        selectionHelper = new THREE.BoxHelper(object, 0x356a8a);
        scene.add(selectionHelper);
        selectionHelper.update();
      };

      const isolateSelectedObject = () => {
        const target = selectedObject;
        if (!target) return;

        captureObjectVisibilityBaseline();
        const keepVisible = new Set<any>();
        let current = target;
        while (current && current !== modelRoot) {
          keepVisible.add(current);
          current = current.parent;
        }
        target.traverse((object: any) => keepVisible.add(object));

        modelRoot.traverse((object: any) => {
          if (!isObjectVisibilityRenderable(object)) return;
          const baselineVisible = objectVisibilityBaseline.get(object) ?? object.visible;
          object.visible = baselineVisible && keepVisible.has(object);
        });

        canvas.dataset.objectVisibilityMode = 'isolate';
        canvas.dataset.objectVisibilityTarget = target.name ? String(target.name) : '(unnamed)';
        refreshEdgeRendering(modelRoot.children[0] ?? null);
        selectionHelper?.update?.();
        status.textContent = target.name
          ? `Eristetty kohde: ${String(target.name)}`
          : 'Eristetty valittu kohde';
      };

      const hideSelectedObject = () => {
        const target = selectedObject;
        if (!target) return;

        captureObjectVisibilityBaseline();
        target.visible = false;
        canvas.dataset.objectVisibilityMode = 'hide';
        canvas.dataset.objectVisibilityTarget = target.name ? String(target.name) : '(unnamed)';
        clearSelection();
        refreshEdgeRendering(modelRoot.children[0] ?? null);
        status.textContent = target.name
          ? `Piilotettu kohde: ${String(target.name)}`
          : 'Valittu kohde piilotettu';
      };

      const restoreObjectVisibility = () => {
        if (!objectVisibilityFilterActive) return;
        for (const [object, visible] of objectVisibilityBaseline.entries()) {
          object.visible = visible;
        }
        resetObjectVisibilityFilterState();
        clearSelection();
        refreshEdgeRendering(modelRoot.children[0] ?? null);
        status.textContent = 'Objektisuodatus poistettu - aiempi näkyvyystila palautettu';
      };

      const setHorizontalClippingState = () => {
        const requestedHeight = Number(clipPlaneHeightInput.value);
        const enabled =
          clipPlaneEnabledInput.checked &&
          !clipPlaneEnabledInput.disabled &&
          Number.isFinite(requestedHeight);

        clipPlaneHeightInput.disabled = !enabled;
        clipPlaneValue.textContent = Number.isFinite(requestedHeight)
          ? `${requestedHeight.toFixed(2)} m`
          : '-';

        if (enabled) {
          horizontalClipPlane.normal.set(0, -1, 0);
          horizontalClipPlane.constant = requestedHeight;
          renderer.clippingPlanes = [horizontalClipPlane];
          canvas.dataset.horizontalClip = 'active';
          canvas.dataset.horizontalClipHeightM = requestedHeight.toFixed(3);
          canvas.dataset.horizontalClipSide = 'above';
        } else {
          renderer.clippingPlanes = [];
          canvas.dataset.horizontalClip = 'inactive';
          delete canvas.dataset.horizontalClipHeightM;
          delete canvas.dataset.horizontalClipSide;
        }
      };

      const resetHorizontalClipping = () => {
        renderer.clippingPlanes = [];
        clipPlaneEnabledInput.checked = false;
        clipPlaneEnabledInput.disabled = true;
        clipPlaneHeightInput.disabled = true;
        clipPlaneHeightInput.min = '0';
        clipPlaneHeightInput.max = '1';
        clipPlaneHeightInput.step = '0.05';
        clipPlaneHeightInput.value = '1';
        clipPlaneValue.textContent = '-';
        canvas.dataset.horizontalClip = 'inactive';
        delete canvas.dataset.horizontalClipHeightM;
        delete canvas.dataset.horizontalClipMinY;
        delete canvas.dataset.horizontalClipMaxY;
        delete canvas.dataset.horizontalClipSide;
      };

      const configureHorizontalClippingRange = () => {
        if (!fullModelScene) return;
        fullModelScene.updateMatrixWorld(true);
        const bounds = new THREE.Box3().setFromObject(fullModelScene);
        if (
          bounds.isEmpty() ||
          !Number.isFinite(bounds.min.y) ||
          !Number.isFinite(bounds.max.y)
        ) {
          return;
        }

        const minY = bounds.min.y;
        const maxY = Math.max(bounds.max.y, minY + 0.01);
        const step = Math.max((maxY - minY) / 200, 0.01);
        clipPlaneHeightInput.min = String(minY);
        clipPlaneHeightInput.max = String(maxY);
        clipPlaneHeightInput.step = String(step);
        clipPlaneHeightInput.value = String(maxY);
        clipPlaneValue.textContent = `${maxY.toFixed(2)} m`;
        clipPlaneEnabledInput.disabled = false;
        canvas.dataset.horizontalClipMinY = minY.toFixed(3);
        canvas.dataset.horizontalClipMaxY = maxY.toFixed(3);
      };

      const selectAtClientPoint = (clientX: number, clientY: number) => {
        const rect = canvas.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return;

        pointer.x = ((clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, activeCamera);

        const hit = raycaster
          .intersectObjects(modelRoot.children, true)
          .find(
            (candidate: any) =>
              (candidate.object?.isMesh || candidate.object?.isLine || candidate.object?.isLineSegments) &&
              isEffectivelyVisible(candidate.object) &&
              hasVisibleMaterial(candidate.object),
          );

        if (!hit) {
          clearSelection();
          return;
        }

        selectObject(hit.object);
      };

      const syncViewState = (preset: 'orbit' | 'top' | 'bottom' | 'isometric' | 'd-plan' | 'elevation') => {
        canvas.dataset.viewPreset = preset;
        canvas.dataset.cameraProjection = (activeCamera as any).isOrthographicCamera === true ? 'orthographic' : 'perspective';
      };

      const setHeightScaleVisible = (visible: boolean) => {
        heightScale.hidden = !visible;
        canvas.dataset.heightScaleVisible = visible ? 'true' : 'false';
        if (!visible) {
          heightScaleTicks.replaceChildren();
          heightScaleSignature = '';
          delete canvas.dataset.heightScaleMinZ;
          delete canvas.dataset.heightScaleMaxZ;
          delete canvas.dataset.heightScaleStepM;
        }
      };

      const deactivateElevationView = () => {
        activeElevationDirection = null;
        delete canvas.dataset.elevationDirection;
        setHeightScaleVisible(false);
      };

      const heightScaleStepForSpan = (spanM: number) => {
        if (spanM <= 14) return 1;
        if (spanM <= 28) return 2;
        if (spanM <= 70) return 5;
        return 10;
      };

      const updateHeightScale = () => {
        if (!activeElevationDirection || activeCamera !== isoCamera || heightScale.hidden) return;

        const halfHeight = Math.max(
          (isoCamera.top - isoCamera.bottom) / (2 * Math.max(isoCamera.zoom, 1e-6)),
          0.001,
        );
        const centerZ = isoControls.target.y;
        const minZ = centerZ - halfHeight;
        const maxZ = centerZ + halfHeight;
        const spanZ = Math.max(maxZ - minZ, 0.001);
        const stepM = heightScaleStepForSpan(spanZ);
        const signature = [minZ, maxZ, stepM, canvas.clientHeight]
          .map((value) => Number(value).toFixed(3))
          .join('|');
        if (signature === heightScaleSignature) return;
        heightScaleSignature = signature;

        heightScaleTicks.replaceChildren();
        const first = Math.ceil((minZ - 1e-9) / stepM) * stepM;
        for (let value = first; value <= maxZ + 1e-9; value += stepM) {
          const normalized = (maxZ - value) / spanZ;
          const topPct = Math.max(0, Math.min(100, normalized * 100));

          const isZero = Math.abs(value) < 1e-8;

          const guide = document.createElement('div');
          guide.className = 'height-scale-guide';
          guide.dataset.heightM = value.toFixed(3);
          if (isZero) guide.classList.add('zero');
          guide.style.top = `${topPct}%`;

          const tick = document.createElement('div');
          tick.className = 'height-scale-tick';
          tick.dataset.heightM = value.toFixed(3);
          if (isZero) tick.classList.add('zero');
          tick.style.top = `${topPct}%`;

          const label = document.createElement('div');
          label.className = 'height-scale-label';
          label.dataset.heightM = value.toFixed(3);
          label.style.top = `${topPct}%`;
          const normalizedValue = Math.abs(value) < 0.0005 ? 0 : value;
          const prefix = normalizedValue > 0 ? '+' : '';
          label.textContent = `${prefix}${normalizedValue.toFixed(1).replace('.', ',')} m`;

          heightScaleTicks.append(guide, tick, label);
        }

        canvas.dataset.heightScaleMinZ = minZ.toFixed(3);
        canvas.dataset.heightScaleMaxZ = maxZ.toFixed(3);
        canvas.dataset.heightScaleStepM = String(stepM);
        canvas.dataset.heightScaleFrame = 'YLIS-G1-LOCAL';
      };

      const fitElevationCamera = (direction: ElevationDirection) => {
        if (!fullModelScene) return false;
        const box = computeVisibleBounds(fullModelScene, true);
        if (!box) return false;

        const center = new THREE.Vector3();
        const size = new THREE.Vector3();
        box.getCenter(center);
        box.getSize(size);

        const aspect = Math.max(canvas.clientWidth / Math.max(canvas.clientHeight, 1), 0.01);
        const horizontalSize =
          direction === 'pos-y' || direction === 'neg-y' ? size.x : size.z;
        let halfWidth = Math.max(horizontalSize * 0.56, 0.25);
        let halfHeight = Math.max(size.y * 0.56, 0.25);
        const modelAspect = halfWidth / Math.max(halfHeight, 1e-6);
        if (aspect > modelAspect) halfWidth = halfHeight * aspect;
        else halfHeight = halfWidth / aspect;

        const distance = Math.max(size.length() * 1.35, 4);
        const offset =
          direction === 'pos-y'
            ? new THREE.Vector3(0, 0, -distance)
            : direction === 'neg-y'
              ? new THREE.Vector3(0, 0, distance)
              : direction === 'pos-x'
                ? new THREE.Vector3(distance, 0, 0)
                : new THREE.Vector3(-distance, 0, 0);

        isoCamera.position.copy(center).add(offset);
        isoCamera.up.set(0, 1, 0);
        isoCamera.lookAt(center);
        isoCamera.left = -halfWidth;
        isoCamera.right = halfWidth;
        isoCamera.top = halfHeight;
        isoCamera.bottom = -halfHeight;
        isoCamera.near = Math.max(distance / 10000, 0.001);
        isoCamera.far = Math.max(distance * 4 + size.length() * 2, 1000);
        isoCamera.zoom = 1;
        isoCamera.updateProjectionMatrix();

        isoControls.target.copy(center);
        isoControls.update();
        heightScaleSignature = '';
        updateHeightScale();
        return true;
      };

      const activateElevationView = (direction: ElevationDirection) => {
        if (!fullModelScene) return;

        clearSelection();
        restoreDVisibility();
        activePlanFloor = null;
        deactivateDCoordinateReview();
        setD1KnownDoorReviewLabelsVisible(false);
        controls.enabled = false;
        planControls.enabled = false;
        isoControls.enabled = true;
        activeCamera = isoCamera;
        setModelScene(fullModelScene);
        applyRoofLayerState();
        applyLocusLayerState();

        activeElevationDirection = direction;
        canvas.dataset.elevationDirection = direction;
        setHeightScaleVisible(true);
        if (!fitElevationCamera(direction)) {
          deactivateElevationView();
          return;
        }

        syncViewState('elevation');
        const label =
          direction === 'pos-y'
            ? '+Y'
            : direction === 'neg-y'
              ? '-Y'
              : direction === 'pos-x'
                ? '+X'
                : '-X';
        status.textContent = `Ortografinen julkisivu ${label} - YLIS-G1-LOCAL Z-asteikko`;
      };

      const fitIsometricCamera = (sceneRoot: any = fullModelScene) => {
        if (!sceneRoot) return;

        const box = computeVisibleBounds(sceneRoot, true);
        if (!box) return;

        const center = new THREE.Vector3();
        const sphere = new THREE.Sphere();
        box.getCenter(center);
        box.getBoundingSphere(sphere);

        const radius = Math.max(sphere.radius, 0.25);
        canvas.dataset.isoFitCenterX = String(center.x);
        canvas.dataset.isoFitRadius = String(radius);
        const aspect = Math.max(canvas.clientWidth / Math.max(canvas.clientHeight, 1), 0.01);
        let halfHeight = radius * 1.16;
        let halfWidth = halfHeight * aspect;
        if (halfWidth < radius * 1.16) {
          halfHeight = (radius * 1.16) / aspect;
          halfWidth = halfHeight * aspect;
        }

        const direction = new THREE.Vector3(1, 1, 1).normalize();
        const distance = Math.max(radius * 3.2, 4);
        isoCamera.position.copy(center).addScaledVector(direction, distance);
        isoCamera.up.set(0, 1, 0);
        isoCamera.lookAt(center);
        isoCamera.left = -halfWidth;
        isoCamera.right = halfWidth;
        isoCamera.top = halfHeight;
        isoCamera.bottom = -halfHeight;
        isoCamera.near = Math.max(distance / 10000, 0.001);
        isoCamera.far = Math.max(distance * 4 + radius * 2, 1000);
        isoCamera.zoom = 1;
        isoCamera.updateProjectionMatrix();

        isoControls.target.copy(center);
        isoControls.update();
      };

      const activateIsometric = () => {
        if (!fullModelScene) return;

        deactivateElevationView();
        clearSelection();
        restoreDVisibility();
        activePlanFloor = null;
        deactivateDCoordinateReview();
        setD1KnownDoorReviewLabelsVisible(false);
        controls.enabled = false;
        planControls.enabled = false;
        isoControls.enabled = true;
        activeCamera = isoCamera;
        setModelScene(fullModelScene);
        applyRoofLayerState();
        fitIsometricCamera();
        syncViewState('isometric');
        status.textContent = 'Isometrinen - ortografinen 3/4-näkymä';
      };

      const activateFullModel = () => {
        deactivateElevationView();
        clearSelection();
        restoreDVisibility();
        activePlanFloor = null;
        deactivateDCoordinateReview();
        setD1KnownDoorReviewLabelsVisible(false);
        planControls.enabled = false;
        isoControls.enabled = false;
        controls.enabled = true;
        activeCamera = camera;
        setModelScene(fullModelScene);
        applyRoofLayerState();
        syncViewState('orbit');
      };

      const fitPlanCamera = () => {
        if (!dInteriorScene || !activePlanFloor) return;

        const box = computeVisibleBounds(dInteriorScene, true);
        if (!box) return;

        const center = new THREE.Vector3();
        const size = new THREE.Vector3();
        box.getCenter(center);
        box.getSize(size);

        const aspect = Math.max(canvas.clientWidth / Math.max(canvas.clientHeight, 1), 0.01);
        let halfWidth = Math.max(size.x * 0.54, 0.25);
        let halfHeight = Math.max(size.z * 0.54, 0.25);
        const modelAspect = halfWidth / halfHeight;

        if (aspect > modelAspect) {
          halfWidth = halfHeight * aspect;
        } else {
          halfHeight = halfWidth / aspect;
        }

        const distance = Math.max(size.length() * 1.25, size.y * 4, 4);
        planCamera.position.set(center.x, box.max.y + distance, center.z);
        planCamera.up.set(0, 0, -1);
        planCamera.lookAt(center);
        planCamera.left = -halfWidth;
        planCamera.right = halfWidth;
        planCamera.top = halfHeight;
        planCamera.bottom = -halfHeight;
        planCamera.near = Math.max(distance / 10000, 0.001);
        planCamera.far = Math.max(distance * 4 + size.y, 1000);
        planCamera.zoom = 1;
        planCamera.updateProjectionMatrix();

        planControls.target.copy(center);
        planControls.update();
      };

      const applyDPlanVisibility = (floor: '1F' | '2F') => {
        restoreDVisibility();
        let matchedRenderables = 0;
        let hiddenOtherFloorRenderables = 0;

        dInteriorScene.traverse((object: any) => {
          if (!isDPlanRenderable(object)) return;
          const baseline = dVisibilityBaseline.get(object) ?? object.visible;
          const show = baseline && hasFloorToken(object, floor);
          object.visible = show;
          if (show) matchedRenderables += 1;
          else if (baseline) hiddenOtherFloorRenderables += 1;
        });

        canvas.dataset.dPlanVisibleRenderableCount = String(matchedRenderables);
        canvas.dataset.dPlanHiddenOtherFloorCount = String(hiddenOtherFloorRenderables);
        applyDReviewStyling(floor);
        refreshEdgeRendering(dInteriorScene);
        return matchedRenderables;
      };

      const activateDPlan = (floor: '1F' | '2F') => {
        deactivateElevationView();
        clearSelection();
        if (!dInteriorScene) {
          status.textContent = 'D-asunnon pohjanäkymää ei löydy tästä mallista';
          return;
        }

        setModelScene(dInteriorScene);
        const matchedMeshes = applyDPlanVisibility(floor);
        if (matchedMeshes === 0) {
          restoreDVisibility();
          activateFullModel();
          status.textContent = `D ${floor} - kerrostunnistetta ei löytynyt`;
          return;
        }

        controls.enabled = false;
        isoControls.enabled = false;
        planControls.enabled = true;
        activePlanFloor = floor;
        activeCamera = planCamera;
        fitPlanCamera();
        activateDCoordinateReview(floor);
        setD1KnownDoorReviewLabelsVisible(floor === '1F');
        syncViewState('d-plan');
        status.textContent =
          floor === '2F' && canvas.dataset.d2fBoundaryContextPrepared === 'true'
            ? canvas.dataset.dReviewActive === 'true'
              ? 'D 2F - tarkastusnäkymä, sisäseinät korostettu; rajaavat seinät kontekstina'
              : 'D 2F - tarkastusnäkymä, rajaavat seinät kontekstina'
            : canvas.dataset.dReviewActive === 'true'
              ? `D ${floor} - tarkastusnäkymä, tarkastusgeometria korostettu`
              : `D ${floor} - ortografinen pohjanäkymä`;
      };

      const updateSize = () => {
        const width = Math.max(canvas.clientWidth, 1);
        const height = Math.max(canvas.clientHeight, 1);
        const pixelRatio = renderer.getPixelRatio();
        const bufferWidth = Math.floor(width * pixelRatio);
        const bufferHeight = Math.floor(height * pixelRatio);

        if (canvas.width !== bufferWidth || canvas.height !== bufferHeight) {
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
          if (activePlanFloor) fitPlanCamera();
          else if (activeCamera === isoCamera) {
            if (activeElevationDirection) fitElevationCamera(activeElevationDirection);
            else fitIsometricCamera();
          }
        }
      };

      const refreshFullModelFitMetrics = () => {
        if (!fullModelScene) return false;

        const box = computeVisibleBounds(fullModelScene, true);
        if (!box) return false;

        box.getCenter(modelCenter);
        const sphere = new THREE.Sphere();
        box.getBoundingSphere(sphere);

        const halfFov = THREE.MathUtils.degToRad(camera.fov * 0.5);
        fitDistance = Math.max((sphere.radius / Math.tan(halfFov)) * 1.3, 2);
        canvas.dataset.fitCenterX = String(modelCenter.x);
        canvas.dataset.fitRadius = String(sphere.radius);
        return true;
      };

      const fitModel = () => {
        if (!fullModelScene) return;
        activateFullModel();
        if (!refreshFullModelFitMetrics()) return;

        controls.target.copy(modelCenter);
        camera.up.set(0, 1, 0);
        camera.position.copy(modelCenter).add(
          new THREE.Vector3(fitDistance * 0.72, fitDistance * 0.55, fitDistance * 0.72),
        );
        camera.near = Math.max(fitDistance / 10000, 0.001);
        camera.far = Math.max(fitDistance * 50, 1000);
        camera.updateProjectionMatrix();
        controls.update();
      };

      const axisView = (direction: 'top' | 'bottom') => {
        if (!fullModelScene) return;
        activateFullModel();
        if (!refreshFullModelFitMetrics()) return;
        controls.target.copy(modelCenter);

        if (direction === 'top') {
          camera.position.copy(modelCenter).add(new THREE.Vector3(0, fitDistance, 0));
          camera.up.set(0, 0, -1);
        } else {
          camera.position.copy(modelCenter).add(new THREE.Vector3(0, -fitDistance, 0));
          camera.up.set(0, 0, 1);
        }

        camera.lookAt(modelCenter);
        camera.updateProjectionMatrix();
        controls.update();
        syncViewState(direction);
      };

      const activateSitePlanOnly = () => {
        if (!fullModelScene) return;

        deactivateElevationView();
        clearSelection();
        restoreDVisibility();
        activePlanFloor = null;
        deactivateDCoordinateReview();
        setD1KnownDoorReviewLabelsVisible(false);
        controls.enabled = false;
        planControls.enabled = false;
        isoControls.enabled = true;
        activeCamera = isoCamera;
        setModelScene(fullModelScene);
        applyRoofLayerState();
        applyLocusLayerState();

        const box = computeVisibleBounds(fullModelScene, true);
        if (box) {
          const center = new THREE.Vector3();
          const size = new THREE.Vector3();
          box.getCenter(center);
          box.getSize(size);

          const aspect = Math.max(canvas.clientWidth / Math.max(canvas.clientHeight, 1), 0.01);
          let halfWidth = Math.max(size.x * 0.54, 0.25);
          let halfHeight = Math.max(size.z * 0.54, 0.25);
          const modelAspect = halfWidth / halfHeight;

          if (aspect > modelAspect) halfWidth = halfHeight * aspect;
          else halfHeight = halfWidth / aspect;

          const distance = Math.max(size.length() * 1.25, size.y * 4, 4);
          isoCamera.position.set(center.x, box.max.y + distance, center.z);
          isoCamera.up.set(0, 0, -1);
          isoCamera.lookAt(center);
          isoCamera.left = -halfWidth;
          isoCamera.right = halfWidth;
          isoCamera.top = halfHeight;
          isoCamera.bottom = -halfHeight;
          isoCamera.near = Math.max(distance / 10000, 0.001);
          isoCamera.far = Math.max(distance * 4 + size.y, 1000);
          isoCamera.zoom = 1;
          isoCamera.updateProjectionMatrix();

          isoControls.target.copy(center);
          isoControls.update();
        }

        syncViewState('top');
      };

      const activateDOverview = () => {
        if (!dInteriorScene) {
          status.textContent = 'D-asunnon yhdistettyä näkymää ei löydy tästä mallista';
          return false;
        }

        deactivateElevationView();
        clearSelection();
        restoreDVisibility();
        activePlanFloor = null;
        deactivateDCoordinateReview();
        setD1KnownDoorReviewLabelsVisible(false);
        controls.enabled = false;
        planControls.enabled = false;
        isoControls.enabled = true;
        activeCamera = isoCamera;
        setModelScene(dInteriorScene);
        fitIsometricCamera(dInteriorScene);
        refreshEdgeRendering(dInteriorScene);
        syncViewState('isometric');
        status.textContent = 'D-asunto - molemmat kerrokset, ortografinen 3/4-näkymä';
        return true;
      };

      type StandardViewPreset =
        | 'whole-building'
        | 'd-apartment'
        | 'd-1f'
        | 'd-2f'
        | 'top'
        | 'site'
        | 'infra'
        | 'elev-pos-y'
        | 'elev-neg-y'
        | 'elev-pos-x'
        | 'elev-neg-x';

      const standardViewLayerDefaults: Record<StandardViewPreset, Partial<ViewerLayerState>> = {
        'whole-building': { roofVisible: true, locusVisible: false, edgeMode: 'visible' },
        'd-apartment': { roofVisible: false, locusVisible: false, edgeMode: 'visible' },
        'd-1f': { roofVisible: false, locusVisible: false, edgeMode: 'visible' },
        'd-2f': { roofVisible: false, locusVisible: false, edgeMode: 'visible' },
        top: { roofVisible: true, locusVisible: false, edgeMode: 'visible' },
        site: { roofVisible: true, locusVisible: false, edgeMode: 'visible' },
        infra: { roofVisible: false, locusVisible: true, edgeMode: 'visible' },
        'elev-pos-y': { roofVisible: true, locusVisible: false, edgeMode: 'visible' },
        'elev-neg-y': { roofVisible: true, locusVisible: false, edgeMode: 'visible' },
        'elev-pos-x': { roofVisible: true, locusVisible: false, edgeMode: 'visible' },
        'elev-neg-x': { roofVisible: true, locusVisible: false, edgeMode: 'visible' },
      };

      const applyStandardViewPreset = (preset: StandardViewPreset) => {
        canvas.dataset.standardViewPreset = preset;
        applyViewerLayerState(standardViewLayerDefaults[preset], `preset:${preset}`);

        if (preset === 'whole-building') activateIsometric();
        else if (preset === 'd-apartment') activateDOverview();
        else if (preset === 'd-1f') activateDPlan('1F');
        else if (preset === 'd-2f') activateDPlan('2F');
        else if (preset === 'top') axisView('top');
        else if (preset === 'site' || preset === 'infra') activateSitePlanOnly();
        else if (preset === 'elev-pos-y') activateElevationView('pos-y');
        else if (preset === 'elev-neg-y') activateElevationView('neg-y');
        else if (preset === 'elev-pos-x') activateElevationView('pos-x');
        else activateElevationView('neg-x');

        refreshEdgeRendering(modelRoot.children[0] ?? null);
      };

      type ComparisonCameraKind = 'perspective' | 'plan' | 'isometric';
      type ComparisonViewSnapshot = {
        cameraKind: ComparisonCameraKind;
        position: THREE.Vector3;
        quaternion: THREE.Quaternion;
        zoom: number;
        target: THREE.Vector3;
        standardViewPreset: StandardViewPreset | null;
        layerState: ViewerLayerState;
      };

      const captureComparisonView = (): ComparisonViewSnapshot => {
        const cameraKind: ComparisonCameraKind =
          activeCamera === planCamera ? 'plan' : activeCamera === isoCamera ? 'isometric' : 'perspective';
        const activeControls =
          cameraKind === 'plan' ? planControls : cameraKind === 'isometric' ? isoControls : controls;
        const preset = canvas.dataset.standardViewPreset;
        const standardViewPreset =
          preset && Object.prototype.hasOwnProperty.call(standardViewLayerDefaults, preset)
            ? (preset as StandardViewPreset)
            : null;

        return {
          cameraKind,
          position: activeCamera.position.clone(),
          quaternion: activeCamera.quaternion.clone(),
          zoom: activeCamera.zoom,
          target: activeControls.target.clone(),
          standardViewPreset,
          layerState: {
            roofVisible: roofLayerVisible,
            roofOpacity: roofLayerOpacity,
            locusVisible: locusLayerVisible,
            edgeMode,
          },
        };
      };

      const restoreComparisonView = (snapshot: ComparisonViewSnapshot) => {
        if (snapshot.standardViewPreset) {
          applyStandardViewPreset(snapshot.standardViewPreset);
        }

        controls.enabled = snapshot.cameraKind === 'perspective';
        planControls.enabled = snapshot.cameraKind === 'plan';
        isoControls.enabled = snapshot.cameraKind === 'isometric';
        activeCamera =
          snapshot.cameraKind === 'plan'
            ? planCamera
            : snapshot.cameraKind === 'isometric'
              ? isoCamera
              : camera;

        activeCamera.position.copy(snapshot.position);
        activeCamera.quaternion.copy(snapshot.quaternion);
        activeCamera.zoom = snapshot.zoom;
        activeCamera.updateProjectionMatrix();

        const activeControls =
          snapshot.cameraKind === 'plan'
            ? planControls
            : snapshot.cameraKind === 'isometric'
              ? isoControls
              : controls;
