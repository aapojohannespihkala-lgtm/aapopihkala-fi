        const terrainLegend = svgEl('text', {
          x: margin.left + 8,
          y: 14,
          class: 'profile-legend-text',
        });
        terrainLegend.textContent = 'SCALGO-maanpinta työvertailussa';
        const pipeLegend = svgEl('text', {
          x: margin.left + 220,
          y: 14,
          class: 'profile-legend-text',
        });
        pipeLegend.textContent = `${route.label} WORK_Z`;
        profileSvg.append(terrainLegend, pipeLegend);
      };

      const workTestCatalogPath = '/private-model/work-test/catalog.json';
      const workTestImportPath = '/private-model/work-test/import.json';
      const workTestUploadPrefix = '/private-model/work-test/upload/';
      const manualWorkTestUploadDebug =
        new URLSearchParams(window.location.search).get('manualWorkTestUpload') === '1';
      const workTestImportFragmentKey = 'workTestImport';
      const workTestCandidateFragmentKey = 'workTestCandidate';
      const workTestServerImportTimeoutMs = 30_000;
      const workTestCatalogTimeoutMs = 6_000;
      const workTestPendingPollIntervalMs = 1_000;
      const workTestPendingWaitMs = 30_000;
      const workTestRelaySourceTimeoutMs = 25_000;
      const workTestRelayUploadTimeoutMs = 25_000;
      const fetchWorkTestWithTimeout = async (
        input: RequestInfo | URL,
        init: RequestInit,
        timeoutMs: number,
      ) => {
        const controller = new AbortController();
        let timeoutId = 0;
        const timeout = new Promise<never>((_, reject) => {
          timeoutId = window.setTimeout(() => {
            controller.abort();
            const error = new Error('WORK_TEST fetch timeout');
            error.name = 'TimeoutError';
            reject(error);
          }, timeoutMs);
        });
        try {
          return await Promise.race([
            fetch(input, { ...init, signal: controller.signal }),
            timeout,
          ]);
        } finally {
          window.clearTimeout(timeoutId);
        }
      };
      let workTestCandidates = new Map<string, WorkTestCandidate>();

      const updateModelComparisonControls = () => {
        const candidate = workTestCandidates.get(workTestSelect.value);
        compareModelButton.disabled = !candidate;
        compareModelButton.textContent =
          activeModelSourceKind === 'work-test' ? 'Vertaa CURRENTiin' : 'Vertaa WORK_TESTiin';
      };

      const clearModelComparisonState = () => {
        canvas.dataset.modelComparison = 'inactive';
        delete canvas.dataset.modelComparisonCandidate;
        delete canvas.dataset.modelComparisonView;
        updateModelComparisonControls();
      };

      const setWorkTestUploadFallback = (candidateId: string | null) => {
        if (candidateId && manualWorkTestUploadDebug) {
          workTestUploadButton.hidden = false;
          workTestUploadButton.disabled = false;
          workTestUploadButton.dataset.candidateId = candidateId;
          canvas.dataset.workTestUploadCandidate = candidateId;
          return;
        }

        workTestUploadButton.hidden = true;
        workTestUploadButton.disabled = true;
        delete workTestUploadButton.dataset.candidateId;
        delete canvas.dataset.workTestUploadCandidate;
      };

      const setWorkTestCatalog = (candidates: WorkTestCandidate[]) => {
        workTestCandidates = new Map(candidates.map((candidate) => [candidate.id, candidate]));
        workTestSelect.replaceChildren();
        const reviewCandidateId = getRequestedReviewCandidateId();

        if (candidates.length === 0) {
          const option = document.createElement('option');
          option.value = '';
          option.textContent = 'Ei WORK_TEST-kandidaatteja';
          workTestSelect.append(option);
          workTestSelect.disabled = true;
          workTestButton.disabled = true;
          compareModelButton.disabled = true;
          setWorkTestUploadFallback(reviewCandidateId);
          canvas.dataset.workTestCatalog = 'empty';
          return;
        }

        for (const candidate of candidates) {
          const option = document.createElement('option');
          option.value = candidate.id;
          option.textContent = candidate.label;
          workTestSelect.append(option);
        }

        workTestSelect.disabled = false;
        const reviewCandidate = reviewCandidateId
          ? workTestCandidates.get(reviewCandidateId)
          : null;
        workTestSelect.value = reviewCandidate?.id ?? candidates[0].id;
        workTestButton.disabled = false;
        updateModelComparisonControls();
        canvas.dataset.workTestCatalog = 'ready';
        if (reviewCandidate) {
          canvas.dataset.workTestReviewCandidate = reviewCandidate.id;
          setWorkTestUploadFallback(null);
        } else {
          delete canvas.dataset.workTestReviewCandidate;
          setWorkTestUploadFallback(reviewCandidateId);
        }
      };

      const loadWorkTestCatalog = async () => {
        try {
          const response = await fetchWorkTestWithTimeout(
            workTestCatalogPath,
            {
              headers: { Accept: 'application/json' },
              cache: 'no-store',
            },
            workTestCatalogTimeoutMs,
          );
          if (!response.ok) throw new Error(`WORK_TEST catalog HTTP ${response.status}`);

          const payload = (await response.json()) as { candidates?: unknown };
          const candidates = Array.isArray(payload.candidates)
            ? payload.candidates.filter(isWorkTestCandidate)
            : [];
          setWorkTestCatalog(candidates);
        } catch (error) {
          console.error(error);
          setWorkTestCatalog([]);
          canvas.dataset.workTestCatalog = 'unavailable';
        }
      };

      const waitForWorkTestCandidate = async (candidateId: string) => {
        const deadline = Date.now() + workTestPendingWaitMs;
        while (Date.now() < deadline) {
          await loadWorkTestCatalog();
          const candidate = workTestCandidates.get(candidateId);
          if (candidate) return candidate;
          await new Promise<void>((resolve) => {
            window.setTimeout(resolve, workTestPendingPollIntervalMs);
          });
        }
        return null;
      };

      const hasP139abZRouteAncestor = (object: any) => {
        let current = object;
        while (current) {
          if (String(current?.userData?.presentationLayer ?? '') === p139abZPresentationLayer) {
            return true;
          }
          current = current.parent;
        }
        return false;
      };

      const cloneP139SourceNodeFromParser = async (
        gltf: any,
        nodeIndex: number,
      ): Promise<THREE.Object3D> => {
        const parser = gltf?.parser;
        const sourceNode = await parser?.getDependency?.('node', nodeIndex);
        if (!sourceNode) throw new Error(`p139 source node missing: ${nodeIndex}`);

        const nodeDef = parser?.json?.nodes?.[nodeIndex] ?? {};
        const rawChildIndices = Array.isArray(nodeDef.children) ? nodeDef.children : [];
        const rawChildSources = await Promise.all(
          rawChildIndices.map((childIndex: number) => parser.getDependency('node', childIndex)),
        );

        const clone = sourceNode.clone(true);
        const rawChildSet = new Set(rawChildSources);
        const sourceChildren = [...sourceNode.children];
        sourceChildren.forEach((child: THREE.Object3D, index: number) => {
          if (rawChildSet.has(child) && clone.children[index]) {
            clone.remove(clone.children[index]);
          }
        });

        for (const childIndex of rawChildIndices) {
          clone.add(await cloneP139SourceNodeFromParser(gltf, childIndex));
        }
        return clone;
      };

      const cloneP139SourceNamedSceneFromParser = async (gltf: any, sceneName: string) => {
        const parser = gltf?.parser;
        const sceneDefs = Array.isArray(parser?.json?.scenes) ? parser.json.scenes : [];
        const sceneDef = sceneDefs.find((scene: any) => scene?.name === sceneName);
        if (!sceneDef) {
          const runtimeScene = findSourceNamedScene(gltf, sceneName);
          return runtimeScene ? runtimeScene.clone(true) : null;
        }

        const clone = new THREE.Group();
        clone.name = sceneName;
        for (const nodeIndex of Array.isArray(sceneDef.nodes) ? sceneDef.nodes : []) {
          clone.add(await cloneP139SourceNodeFromParser(gltf, nodeIndex));
        }
        return clone;
      };

      const buildP139abVisibleReviewScene = async (gltf: any, zScene: any) => {
        const buildingClone = await cloneP139SourceNamedSceneFromParser(
          gltf,
          p139abBuildingSceneName,
        );
        if (!buildingClone) throw new Error('p139AB building context scene missing');

        const zRouteClone = await cloneP139SourceNamedSceneFromParser(gltf, p139abZSceneName);
        if (!zRouteClone) throw new Error('p139AB Z credibility scene missing');

        const composite = new THREE.Group();
        composite.name = 'P139AB VISIBLE BUILDING + Z ROUTES REVIEW';

        let buildingRenderableCount = 0;
        buildingClone.traverse((object: any) => {
          const name = String(object?.name ?? '').toUpperCase();
          if (
            name.includes('P139C_WATER_CONNECTION_ZONE_REVIEW_HELPER') ||
            name.includes('P139E_WASTEWATER_CONNECTION_ZONE_REVIEW_HELPER')
          ) {
            object.visible = false;
            return;
          }

          const renderable =
            object.isMesh || object.isLine || object.isLineSegments || object.isPoints;
          if (renderable && !hasP139abZRouteAncestor(object) && object.visible !== false) {
            buildingRenderableCount += 1;
          }
        });

        let sourceZRenderableCount = 0;
        zRouteClone.traverse((object: any) => {
          const renderable =
            object.isMesh || object.isLine || object.isLineSegments || object.isPoints;
          if (!renderable) return;
          if (hasP139abZRouteAncestor(object)) {
            sourceZRenderableCount += 1;
          } else {
            object.visible = false;
          }
        });

        const sourceHasMeshes =
          Array.isArray(gltf?.parser?.json?.meshes) && gltf.parser.json.meshes.length > 0;
        if (sourceHasMeshes && buildingRenderableCount === 0) {
          throw new Error('p139AB building context has no reconstructed renderables');
        }
        if (sourceZRenderableCount === 0) {
          throw new Error('p139AB source-Z review has no reconstructed renderables');
        }

        composite.add(buildingClone, zRouteClone);
        composite.userData = {
          ...composite.userData,
          reviewScope: 'Z_CREDIBILITY_ONLY',
          buildingContext: true,
          sourceBuildingScene: p139abBuildingSceneName,
          sourceZScene: p139abZSceneName,
          runtimeCarrierScene: 'PARSER_RECONSTRUCTED_BUILDING_PLUS_Z',
          buildingRenderableCount,
          sourceZRenderableCount,
          rawSceneReconstruction: true,
        };
        return composite;
      };

