      const populateInfraProfileRoutes = () => {
        const previous = profileRouteSelect.value;
        profileRouteSelect.replaceChildren();
        for (const route of p139adLocusWorkZRoutes) {
          const option = document.createElement('option');
          option.value = route.name;
          option.textContent = route.label;
          profileRouteSelect.append(option);
        }
        const defaultRoute = 'P139AD_LOCUS_WASTEWATER_PARCEL_WORK_Z';
        profileRouteSelect.value =
          p139adLocusWorkZRoutes.some((route) => route.name === previous)
            ? previous
            : defaultRoute;
      };

      const findScalgoTerrainMeshes = (root: any) => {
        const meshes: any[] = [];
        root?.traverse?.((object: any) => {
          if (!object?.isMesh) return;
          let cursor: any = object;
          while (cursor) {
            const name = String(cursor.name ?? '').toUpperCase();
            const geometryType = String(cursor.userData?.geometryType ?? '').toLowerCase();
            if (
              geometryType === 'terrainreferencesurface' ||
              name.includes('P143A_SCALGO_CURRENT_TERRAIN_WORKTEST')
            ) {
              meshes.push(object);
              return;
            }
            cursor = cursor.parent;
          }
        });
        return [...new Set(meshes)];
      };

      const sampleRouteAtOneMetre = (route: (typeof p139adLocusWorkZRoutes)[number]) => {
        const samples: Omit<InfraProfileSample, 'terrainElevationM' | 'coverM'>[] = [];
        let cumulativeM = 0;

        for (let index = 0; index < route.points.length - 1; index += 1) {
          const start = route.points[index];
          const end = route.points[index + 1];
          const segmentLengthM = Math.hypot(end[0] - start[0], end[1] - start[1]);
          const steps = Math.max(1, Math.ceil(segmentLengthM / p143eProfileSampleSpacingM));

          for (let step = 0; step <= steps; step += 1) {
            if (index > 0 && step === 0) continue;
            const t = step / steps;
            samples.push({
              chainageM: cumulativeM + segmentLengthM * t,
              x: start[0] + (end[0] - start[0]) * t,
              y: start[1] + (end[1] - start[1]) * t,
              pipeElevationM: start[2] + (end[2] - start[2]) * t,
            });
          }
          cumulativeM += segmentLengthM;
        }

        return samples;
      };

      const sampleScalgoTerrainAtRoute = (
        route: (typeof p139adLocusWorkZRoutes)[number],
      ): InfraProfileSample[] => {
        if (!fullModelScene) return [];
        const terrainMeshes = findScalgoTerrainMeshes(fullModelScene);
        if (terrainMeshes.length === 0) return [];

        fullModelScene.updateMatrixWorld(true);
        const terrainBounds = new THREE.Box3();
        for (const mesh of terrainMeshes) terrainBounds.expandByObject(mesh);
        if (terrainBounds.isEmpty()) return [];

        const rawSamples = sampleRouteAtOneMetre(route);
        const terrainRaycaster = new THREE.Raycaster();
        const topY = terrainBounds.max.y + 10;
        const bottomY = terrainBounds.min.y - 10;
        const rayLength = Math.max(topY - bottomY, 20);
        const down = new THREE.Vector3(0, -1, 0);
        const up = new THREE.Vector3(0, 1, 0);

        return rawSamples.map((sample) => {
          const z = -sample.y;
          const intersections: any[] = [];

          terrainRaycaster.set(new THREE.Vector3(sample.x, topY, z), down);
          terrainRaycaster.far = rayLength;
          intersections.push(...terrainRaycaster.intersectObjects(terrainMeshes, false));

          if (intersections.length === 0) {
            terrainRaycaster.set(new THREE.Vector3(sample.x, bottomY, z), up);
            terrainRaycaster.far = rayLength;
            intersections.push(...terrainRaycaster.intersectObjects(terrainMeshes, false));
          }

          const hit =
            intersections.length > 0
              ? intersections.reduce((highest, candidate) =>
                  candidate.point.y > highest.point.y ? candidate : highest,
                )
              : null;
          const terrainElevationM = hit ? hit.point.y + p139acVerticalReferenceM : null;
          return {
            ...sample,
            terrainElevationM,
            coverM:
              terrainElevationM === null ? null : terrainElevationM - sample.pipeElevationM,
          };
        });
      };

      const svgEl = <K extends keyof SVGElementTagNameMap>(
        name: K,
        attributes: Record<string, string | number> = {},
      ) => {
        const element = document.createElementNS('http://www.w3.org/2000/svg', name);
        for (const [key, value] of Object.entries(attributes)) {
          element.setAttribute(key, String(value));
        }
        return element;
      };

      const renderSelectedInfraProfile = () => {
        if (!p143eProfileAvailable || !fullModelScene) return;
        const route =
          p139adLocusWorkZRoutes.find((candidate) => candidate.name === profileRouteSelect.value) ??
          p139adLocusWorkZRoutes[0];
        if (!route) return;

        const samples = sampleScalgoTerrainAtRoute(route);
        const valid = samples.filter(
          (sample): sample is InfraProfileSample & { terrainElevationM: number; coverM: number } =>
            sample.terrainElevationM !== null && sample.coverM !== null,
        );
        profileSvg.replaceChildren();

        canvas.dataset.profileRoute = route.name;
        canvas.dataset.profileSampleCount = String(samples.length);
        canvas.dataset.profileTerrainHitCount = String(valid.length);

        if (samples.length === 0) {
          profileSummary.textContent = 'SCALGO terrain-meshiä ei löytynyt tästä katselusta.';
          delete canvas.dataset.profileMinCoverM;
          delete canvas.dataset.profileMeanCoverM;
          delete canvas.dataset.profileMaxCoverM;
          return;
        }

        const covers = valid.map((sample) => sample.coverM);
        if (covers.length > 0) {
          const minCover = Math.min(...covers);
          const maxCover = Math.max(...covers);
          const meanCover = covers.reduce((sum, value) => sum + value, 0) / covers.length;
          canvas.dataset.profileMinCoverM = minCover.toFixed(3);
          canvas.dataset.profileMeanCoverM = meanCover.toFixed(3);
          canvas.dataset.profileMaxCoverM = maxCover.toFixed(3);
          const coveragePct = Math.round((valid.length / samples.length) * 100);
          profileSummary.textContent =
            `${route.label}: peitto min ${minCover.toFixed(2).replace('.', ',')} m / keski ${meanCover.toFixed(2).replace('.', ',')} m / max ${maxCover.toFixed(2).replace('.', ',')} m - terrain-osumat ${valid.length}/${samples.length} (${coveragePct} %)`;
        } else {
          profileSummary.textContent =
            `${route.label}: reitti ei osu nykyisen SCALGO-terrain-cropin alueelle.`;
          delete canvas.dataset.profileMinCoverM;
          delete canvas.dataset.profileMeanCoverM;
          delete canvas.dataset.profileMaxCoverM;
        }

        const width = 760;
        const height = 250;
        const margin = { left: 52, right: 18, top: 24, bottom: 36 };
        const plotWidth = width - margin.left - margin.right;
        const plotHeight = height - margin.top - margin.bottom;
        const totalLengthM = Math.max(samples[samples.length - 1]?.chainageM ?? 1, 1);

        const elevations = [
          ...samples.map((sample) => sample.pipeElevationM),
          ...valid.map((sample) => sample.terrainElevationM),
        ];
        let minElevation = Math.min(...elevations);
        let maxElevation = Math.max(...elevations);
        const padding = Math.max((maxElevation - minElevation) * 0.12, 0.4);
        minElevation -= padding;
        maxElevation += padding;
        const elevationSpan = Math.max(maxElevation - minElevation, 0.1);

        const xFor = (chainageM: number) =>
          margin.left + (chainageM / totalLengthM) * plotWidth;
        const yFor = (elevationM: number) =>
          margin.top + ((maxElevation - elevationM) / elevationSpan) * plotHeight;

        for (let tick = 0; tick <= 4; tick += 1) {
          const value = maxElevation - (elevationSpan * tick) / 4;
          const y = yFor(value);
          const line = svgEl('line', {
            x1: margin.left,
            y1: y,
            x2: width - margin.right,
            y2: y,
            class: 'profile-grid-line',
          });
          const label = svgEl('text', {
            x: margin.left - 7,
            y: y + 3,
            'text-anchor': 'end',
            class: 'profile-axis-label',
          });
          label.textContent = `${value.toFixed(1).replace('.', ',')} m`;
          profileSvg.append(line, label);
        }

        for (let tick = 0; tick <= 4; tick += 1) {
          const chainageM = (totalLengthM * tick) / 4;
          const x = xFor(chainageM);
          const line = svgEl('line', {
            x1: x,
            y1: margin.top,
            x2: x,
            y2: height - margin.bottom,
            class: 'profile-grid-line',
          });
          const label = svgEl('text', {
            x,
            y: height - 15,
            'text-anchor': 'middle',
            class: 'profile-axis-label',
          });
          label.textContent = `${chainageM.toFixed(0)} m`;
          profileSvg.append(line, label);
        }

        profileSvg.append(
          svgEl('line', {
            x1: margin.left,
            y1: height - margin.bottom,
            x2: width - margin.right,
            y2: height - margin.bottom,
            class: 'profile-axis-line',
          }),
          svgEl('line', {
            x1: margin.left,
            y1: margin.top,
            x2: margin.left,
            y2: height - margin.bottom,
            class: 'profile-axis-line',
          }),
        );

        const terrainPathParts: string[] = [];
        let terrainOpen = false;
        for (const sample of samples) {
          if (sample.terrainElevationM === null) {
            terrainOpen = false;
            continue;
          }
          const command = terrainOpen ? 'L' : 'M';
          terrainPathParts.push(
            `${command}${xFor(sample.chainageM).toFixed(2)},${yFor(sample.terrainElevationM).toFixed(2)}`,
          );
          terrainOpen = true;
        }
        if (terrainPathParts.length > 0) {
          profileSvg.append(
            svgEl('path', {
              d: terrainPathParts.join(' '),
              class: 'profile-terrain-path',
              'data-series': 'terrain',
            }),
          );
        }

        const pipePath = samples
          .map(
            (sample, index) =>
              `${index === 0 ? 'M' : 'L'}${xFor(sample.chainageM).toFixed(2)},${yFor(sample.pipeElevationM).toFixed(2)}`,
          )
          .join(' ');
        profileSvg.append(
          svgEl('path', {
            d: pipePath,
            class: `profile-pipe-path ${route.system === 'WASTEWATER' ? 'wastewater' : ''}`,
            'data-series': 'pipe',
