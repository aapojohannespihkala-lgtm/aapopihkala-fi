              </label>
              <label class="clip-range" for="clip-plane-height">
                <span>Korkeus</span>
                <output id="clip-plane-value" for="clip-plane-height">-</output>
                <input id="clip-plane-height" type="range" min="0" max="1" step="0.05" value="1" disabled />
              </label>
            </div>
            <button id="profile-button" type="button" aria-expanded="false" aria-controls="profile-panel" disabled>Pituusleikkaus</button>
          </div>
