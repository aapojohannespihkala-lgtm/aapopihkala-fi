            <button id="reset-view-defaults-button" type="button">Palauta näkymän oletukset</button>
            <button id="show-all-objects-button" type="button" disabled>Näytä kaikki</button>
            <div class="clip-control" aria-label="Leikkaustaso">
              <label class="clip-toggle" for="clip-plane-enabled">
                <span>Leikkaa yläpuoli</span>
