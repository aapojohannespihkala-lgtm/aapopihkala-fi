      const workTestPendingWaitMs = 30_000;
      const workTestRelaySourceTimeoutMs = 25_000;
      const workTestRelayUploadTimeoutMs = 25_000;
      const fetchWorkTestWithTimeout = async (
        input: RequestInfo | URL,
        init: RequestInit,
        timeoutMs: number,
      ) => {
        const controller = new AbortController();
        let timeoutId = 0;
        const timeout = new Promise<never>((_, reject) => {
          timeoutId = window.setTimeout(() => {
            controller.abort();
            const error = new Error('WORK_TEST fetch timeout');
            error.name = 'TimeoutError';
            reject(error);
          }, timeoutMs);
        });
        try {
          return await Promise.race([
            fetch(input, { ...init, signal: controller.signal }),
            timeout,
          ]);
        } finally {
          window.clearTimeout(timeoutId);
        }
      };
      let workTestCandidates = new Map<string, WorkTestCandidate>();

      const updateModelComparisonControls = () => {
        const candidate = workTestCandidates.get(workTestSelect.value);
        compareModelButton.disabled = !candidate;
        compareModelButton.textContent =
          activeModelSourceKind === 'work-test' ? 'Vertaa CURRENTiin' : 'Vertaa WORK_TESTiin';
      };

      const clearModelComparisonState = () => {
        canvas.dataset.modelComparison = 'inactive';
        delete canvas.dataset.modelComparisonCandidate;
        delete canvas.dataset.modelComparisonView;
        updateModelComparisonControls();
      };

      const setWorkTestUploadFallback = (candidateId: string | null) => {
        if (candidateId && manualWorkTestUploadDebug) {
          workTestUploadButton.hidden = false;
          workTestUploadButton.disabled = false;
          workTestUploadButton.dataset.candidateId = candidateId;
          canvas.dataset.workTestUploadCandidate = candidateId;
          return;
        }

        workTestUploadButton.hidden = true;
        workTestUploadButton.disabled = true;
        delete workTestUploadButton.dataset.candidateId;
        delete canvas.dataset.workTestUploadCandidate;
      };

      const setWorkTestCatalog = (candidates: WorkTestCandidate[]) => {
        workTestCandidates = new Map(candidates.map((candidate) => [candidate.id, candidate]));
        workTestSelect.replaceChildren();
        const reviewCandidateId = getRequestedReviewCandidateId();

        if (candidates.length === 0) {
          const option = document.createElement('option');
          option.value = '';
          option.textContent = 'Ei WORK_TEST-kandidaatteja';
          workTestSelect.append(option);
          workTestSelect.disabled = true;
          workTestButton.disabled = true;
          compareModelButton.disabled = true;
          setWorkTestUploadFallback(reviewCandidateId);
          canvas.dataset.workTestCatalog = 'empty';
          return;
        }

        for (const candidate of candidates) {
          const option = document.createElement('option');
          option.value = candidate.id;
          option.textContent = candidate.label;
          workTestSelect.append(option);
        }

        workTestSelect.disabled = false;
        const reviewCandidate = reviewCandidateId
          ? workTestCandidates.get(reviewCandidateId)
          : null;
        workTestSelect.value = reviewCandidate?.id ?? candidates[0].id;
        workTestButton.disabled = false;
        updateModelComparisonControls();
        canvas.dataset.workTestCatalog = 'ready';
        if (reviewCandidate) {
          canvas.dataset.workTestReviewCandidate = reviewCandidate.id;
          setWorkTestUploadFallback(null);
        } else {
          delete canvas.dataset.workTestReviewCandidate;
          setWorkTestUploadFallback(reviewCandidateId);
        }
      };

      const loadWorkTestCatalog = async () => {
        try {
          const response = await fetchWorkTestWithTimeout(
            workTestCatalogPath,
            {
              headers: { Accept: 'application/json' },
              cache: 'no-store',
            },
            workTestCatalogTimeoutMs,
          );
          if (!response.ok) throw new Error(`WORK_TEST catalog HTTP ${response.status}`);

          const payload = (await response.json()) as { candidates?: unknown };
          const candidates = Array.isArray(payload.candidates)
            ? payload.candidates.filter(isWorkTestCandidate)
            : [];
          setWorkTestCatalog(candidates);
        } catch (error) {
          console.error(error);
          setWorkTestCatalog([]);
          canvas.dataset.workTestCatalog = 'unavailable';
        }
      };

      const waitForWorkTestCandidate = async (candidateId: string) => {
        const deadline = Date.now() + workTestPendingWaitMs;
        while (Date.now() < deadline) {
          await loadWorkTestCatalog();
          const candidate = workTestCandidates.get(candidateId);
          if (candidate) return candidate;
          await new Promise<void>((resolve) => {
            window.setTimeout(resolve, workTestPendingPollIntervalMs);
          });
        }
        return null;
      };

