      const setDrainageLayerForResearchPreset = (preset: ViewerResearchPreset) => {
        const control = document.querySelector<HTMLInputElement>('#drainage-layer-visible');
        if (!control) return;
        const nextVisible = preset === 'drainage';
        if (control.checked === nextVisible) return;
        control.checked = nextVisible;
        control.dispatchEvent(new Event('change', { bubbles: true }));
      };

      const setElectricalLayerForResearchPreset = (preset: ViewerResearchPreset) => {
        const nextVisible = preset === 'electrical';
        if (electricalLayerVisibleInput.checked === nextVisible) return;
        electricalLayerVisibleInput.checked = nextVisible;
        electricalLayerVisibleInput.dispatchEvent(new Event('change', { bubbles: true }));
      };

      const activateStandardViewCamera = (preset: StandardViewPreset) => {
        if (preset === 'whole-building') fitModel();
        else if (preset === 'd-apartment') activateDOverview();
        else if (preset === 'd-1f') activateDPlan('1F');
        else if (preset === 'd-2f') activateDPlan('2F');
        else if (preset === 'drainage' || preset === 'electrical') fitModel();
        else if (preset === 'top') axisView('top');
        else if (preset === 'site' || preset === 'infra') activateSitePlanOnly();
        else if (preset === 'elev-pos-y') activateElevationView('pos-y');
        else if (preset === 'elev-neg-y') activateElevationView('neg-y');
        else if (preset === 'elev-pos-x') activateElevationView('pos-x');
