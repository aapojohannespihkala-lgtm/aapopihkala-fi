      type IsoRotationMode = 'disabled' | 'yaw-only' | 'free';
      const isoControls = new OrbitControls(isoCamera, canvas);
      isoControls.enableDamping = true;
      isoControls.dampingFactor = 0.08;
      isoControls.screenSpacePanning = true;
