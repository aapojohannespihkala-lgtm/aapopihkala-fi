      const cloneP139SourceNodeFromParser = async (
        gltf: any,
        nodeIndex: number,
      ): Promise<THREE.Object3D> => {
        const parser = gltf?.parser;
        const sourceNode = await parser?.getDependency?.('node', nodeIndex);
        if (!sourceNode) throw new Error(`p139 source node missing: ${nodeIndex}`);

        const nodeDef = parser?.json?.nodes?.[nodeIndex] ?? {};
        const rawChildIndices = Array.isArray(nodeDef.children) ? nodeDef.children : [];
        const rawChildSources = await Promise.all(
          rawChildIndices.map((childIndex: number) => parser.getDependency('node', childIndex)),
        );

        const clone = sourceNode.clone(true);
        const rawChildSet = new Set(rawChildSources);
        const sourceChildren = [...sourceNode.children];
        sourceChildren.forEach((child: THREE.Object3D, index: number) => {
          if (rawChildSet.has(child) && clone.children[index]) {
            clone.remove(clone.children[index]);
          }
        });

        for (const childIndex of rawChildIndices) {
          clone.add(await cloneP139SourceNodeFromParser(gltf, childIndex));
        }
        return clone;
      };

      const cloneP139SourceNamedSceneFromParser = async (gltf: any, sceneName: string) => {
        const parser = gltf?.parser;
        const sceneDefs = Array.isArray(parser?.json?.scenes) ? parser.json.scenes : [];
        const sceneDef = sceneDefs.find((scene: any) => scene?.name === sceneName);
        if (!sceneDef) {
          const runtimeScene = findSourceNamedScene(gltf, sceneName);
          return runtimeScene ? runtimeScene.clone(true) : null;
        }

        const clone = new THREE.Group();
        clone.name = sceneName;
        for (const nodeIndex of Array.isArray(sceneDef.nodes) ? sceneDef.nodes : []) {
          clone.add(await cloneP139SourceNodeFromParser(gltf, nodeIndex));
        }
        return clone;
      };

      const buildP139abVisibleReviewScene = async (gltf: any, zScene: any) => {
        const buildingClone = await cloneP139SourceNamedSceneFromParser(
          gltf,
          p139abBuildingSceneName,
        );
        if (!buildingClone) throw new Error('p139AB building context scene missing');

        const zRouteClone = await cloneP139SourceNamedSceneFromParser(gltf, p139abZSceneName);
        if (!zRouteClone) throw new Error('p139AB Z credibility scene missing');

        const composite = new THREE.Group();
        composite.name = 'P139AB VISIBLE BUILDING + Z ROUTES REVIEW';

        let buildingRenderableCount = 0;
        buildingClone.traverse((object: any) => {
          const name = String(object?.name ?? '').toUpperCase();
          if (
            name.includes('P139C_WATER_CONNECTION_ZONE_REVIEW_HELPER') ||
            name.includes('P139E_WASTEWATER_CONNECTION_ZONE_REVIEW_HELPER')
          ) {
            object.visible = false;
            return;
          }

          const renderable =
            object.isMesh || object.isLine || object.isLineSegments || object.isPoints;
          if (renderable && !hasP139abZRouteAncestor(object) && object.visible !== false) {
            buildingRenderableCount += 1;
          }
        });

        let sourceZRenderableCount = 0;
        zRouteClone.traverse((object: any) => {
          const renderable =
            object.isMesh || object.isLine || object.isLineSegments || object.isPoints;
          if (!renderable) return;
          if (hasP139abZRouteAncestor(object)) {
            sourceZRenderableCount += 1;
          } else {
            object.visible = false;
          }
        });

        const sourceHasMeshes =
          Array.isArray(gltf?.parser?.json?.meshes) && gltf.parser.json.meshes.length > 0;
        if (sourceHasMeshes && buildingRenderableCount === 0) {
          throw new Error('p139AB building context has no reconstructed renderables');
        }
        if (sourceZRenderableCount === 0) {
          throw new Error('p139AB source-Z review has no reconstructed renderables');
        }

        composite.add(buildingClone, zRouteClone);
        composite.userData = {
          ...composite.userData,
          reviewScope: 'Z_CREDIBILITY_ONLY',
          buildingContext: true,
          sourceBuildingScene: p139abBuildingSceneName,
          sourceZScene: p139abZSceneName,
          runtimeCarrierScene: 'PARSER_RECONSTRUCTED_BUILDING_PLUS_Z',
          buildingRenderableCount,
          sourceZRenderableCount,
          rawSceneReconstruction: true,
        };
        return composite;
      };

