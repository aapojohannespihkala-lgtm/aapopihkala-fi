        const groundGroup = new THREE.Group();
        groundGroup.name = 'P139AC_HISTORICAL_GROUND_REVIEW';

        const positions = p139acGroundControls.flatMap(([x, y, elevation]) => [
          x,
          elevation - p139acVerticalReferenceM,
          -y,
        ]);
        const indices = p139acGroundTriangles.flatMap((triangle) => [...triangle]);
        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
        geometry.setIndex(indices);
        geometry.computeVertexNormals();

        const material = new THREE.MeshBasicMaterial({
          color: 0x7c9061,
          transparent: true,
          opacity: 0.42,
          side: THREE.DoubleSide,
          depthWrite: false,
        });
        const ground = new THREE.Mesh(geometry, material);
        ground.name = 'P139AC_HISTORICAL_GROUND_REVIEW_SURFACE';
        ground.renderOrder = 1;
        ground.userData = {
          Canonical: false,
          ModelStage: 'WORK_TEST_VIEW',
          presentationOnly: true,
          source: '1974-204-A-P-1.tif / G1 T02',
          minimumSourceGroundElevationM: 18.3,
          currentGroundClaim: false,
          asBuiltClaim: false,
          verticalDatumStatus: 'OPEN_UNVERIFIED',
        };
        groundGroup.add(ground);

        const boundaryPositions: number[] = [];
        const boundaryControlIndexes = [0, 1, 2, 3, 4, 0];
        for (let index = 0; index < boundaryControlIndexes.length - 1; index += 1) {
          for (const controlIndex of [boundaryControlIndexes[index], boundaryControlIndexes[index + 1]]) {
            const [x, y, elevation] = p139acGroundControls[controlIndex];
            boundaryPositions.push(x, elevation - p139acVerticalReferenceM + 0.015, -y);
          }
        }
        const boundaryGeometry = new THREE.BufferGeometry();
        boundaryGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(boundaryPositions, 3),
        );
        const boundary = new THREE.LineSegments(
          boundaryGeometry,
          new THREE.LineBasicMaterial({ color: 0x252525, transparent: true, opacity: 0.85 }),
        );
        boundary.name = 'P139AC_HISTORICAL_LOT_GROUND_REVIEW_BOUNDARY';
        groundGroup.add(boundary);

        groundGroup.userData = {
          reviewScope: 'GROUND_PLUS_Z_BACKED_UNDERGROUND_INFRA',
          groundMinimumElevationM: 18.3,
          undergroundInfraHardCeilingOnLotM: 18.3,
          noZRoutesPhysical: false,
