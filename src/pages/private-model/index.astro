---
const title = 'Private 3D viewer';
---

<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f4f4f1;
        color: #20211f;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #f4f4f1;
      }

      body {
        height: 100vh;
        height: 100dvh;
        min-height: 0;
        padding: 10px;
      }

      .viewer-shell {
        width: 100%;
        height: calc(100vh - 20px);
        height: calc(100dvh - 20px);
        min-height: 0;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        gap: 10px;
      }

      .toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        padding: 9px 10px;
        background: #fff;
        border: 1px solid #d7d7d2;
        border-radius: 10px;
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.10);
      }

      .title {
        margin-right: 8px;
        font-weight: 650;
        white-space: nowrap;
      }

      .model-source-badge {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: 5px 8px;
        border: 1px solid #d7d7d2;
        border-radius: 999px;
        background: #f7f7f4;
        color: #555853;
        font-size: 12px;
        line-height: 1;
        white-space: nowrap;
      }

      .toolbar-menu {
        position: relative;
        flex: 0 0 auto;
      }

      .toolbar-menu > summary {
        display: inline-flex;
        min-height: 34px;
        align-items: center;
        gap: 6px;
        border: 1px solid #b9bbb5;
        border-radius: 7px;
        padding: 8px 11px;
        background: #fff;
        color: #20211f;
        font: inherit;
        line-height: 1;
        cursor: pointer;
        list-style: none;
        user-select: none;
      }

      .toolbar-menu > summary::-webkit-details-marker { display: none; }
      .toolbar-menu > summary:hover { border-color: #8f928c; }
      .toolbar-menu > summary:focus-visible {
        outline: 3px solid rgba(61, 95, 114, 0.24);
        outline-offset: 1px;
      }

      .toolbar-menu[open] > summary {
        border-color: #8f928c;
        background: #f7f7f4;
      }

      .toolbar-menu-panel {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        z-index: 20;
        display: grid;
        min-width: 220px;
        max-width: min(360px, calc(100vw - 32px));
        max-height: calc(100dvh - 24px);
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-gutter: stable;
        gap: 6px;
        padding: 8px;
        border: 1px solid #d7d7d2;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 10px 30px rgba(25, 28, 25, 0.16);
      }

      .toolbar-menu-panel.right {
        right: 0;
        left: auto;
      }

      .toolbar-menu-panel button,
      .toolbar-menu-panel select {
        width: 100%;
      }

      .toolbar-menu-panel button {
        text-align: left;
      }

      .clip-control {
        display: grid;
        gap: 6px;
        padding: 7px 6px;
        border-top: 1px solid #e2e3de;
        color: #555853;
        font-size: 12px;
      }

      .clip-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        font-weight: 650;
      }

      .clip-toggle input {
        margin: 0;
      }

      .clip-range {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 5px 8px;
        align-items: center;
      }

      .clip-range input {
        grid-column: 1 / -1;
        width: 100%;
      }

      .clip-range output {
        font-variant-numeric: tabular-nums;
      }

      .toolbar-menu-label {
        padding: 5px 6px 2px;
        color: #777a75;
        font-size: 10px;
        font-weight: 750;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .toolbar-menu-separator {
        height: 1px;
        margin: 3px 0;
        background: #e2e3de;
      }

      .source-menu > summary {
        min-height: 28px;
        padding: 0;
        border: 0;
        border-radius: 999px;
        background: transparent;
      }

      .source-menu[open] > summary {
        border: 0;
        background: transparent;
      }

      .source-menu .toolbar-menu-panel {
        min-width: 280px;
      }

      .more-menu > summary {
        min-width: 36px;
        justify-content: center;
        padding-inline: 9px;
        font-size: 18px;
        font-weight: 700;
      }

      button {
        border: 1px solid #b9bbb5;
        border-radius: 7px;
        padding: 8px 11px;
        background: #fff;
        color: #20211f;
        font: inherit;
        line-height: 1;
        cursor: pointer;
      }

      button:hover { border-color: #8f928c; }

      .status {
        margin-left: auto;
        min-width: 220px;
        color: #6c6e69;
        font-size: 13px;
        text-align: right;
      }

      .layers-panel {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 2;
        width: min(290px, calc(100% - 24px));
        padding: 12px;
        border: 1px solid #d7d7d2;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.14);
      }

      .layers-panel[hidden] { display: none; }

      .layers-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
      }

      .layers-header h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 650;
      }

      .layers-header button {
        padding: 6px 9px;
        font-size: 12px;
      }

      .layer-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
      }

      .layer-opacity {
        display: grid;
        grid-template-columns: auto minmax(90px, 1fr) auto;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
        font-size: 12px;
        color: #555853;
      }

      .layer-opacity input { width: 100%; }

      .layer-count {
        margin-top: 8px;
        color: #777a75;
        font-size: 11px;
      }

      .layer-select {
        display: grid;
        gap: 6px;
        font-size: 12px;
        color: #555853;
      }

      .layer-select select {
        width: 100%;
        border: 1px solid #c8cac4;
        border-radius: 6px;
        padding: 6px 7px;
        background: #fff;
        color: #20211f;
        font: inherit;
      }

      .layer-note {
        margin-top: 7px;
        color: #777a75;
        font-size: 11px;
        line-height: 1.35;
      }

      .layer-section {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #e2e3de;
      }

      .layer-legend {
        display: grid;
        gap: 5px;
        margin-top: 8px;
        color: #62655f;
        font-size: 11px;
      }

      .legend-item {
        display: flex;
        align-items: center;
        gap: 7px;
      }

      .legend-swatch {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex: 0 0 auto;
      }

      .legend-swatch.water { background: #2f80ed; }
      .legend-swatch.wastewater { background: #c04472; }

      .coordinate-panel {
        position: absolute;
        bottom: 12px;
        left: 12px;
        z-index: 3;
        width: min(330px, calc(100% - 24px));
        padding: 10px 12px;
        border: 1px solid #c9cbc5;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.12);
        pointer-events: none;
      }

      .coordinate-panel[hidden] { display: none; }

      .coordinate-title-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 7px;
      }

      .coordinate-title {
        font-size: 13px;
        font-weight: 700;
      }

      .coordinate-floor {
        color: #62655f;
        font-size: 12px;
        font-weight: 650;
      }

      .coordinate-line {
        display: grid;
        grid-template-columns: 64px minmax(0, 1fr);
        gap: 8px;
        margin-top: 4px;
        font-size: 12px;
      }

      .coordinate-line span {
        color: #6c6e69;
      }

      .coordinate-line > span:last-child {
        color: #20211f;
        font-variant-numeric: tabular-nums;
        font-weight: 650;
      }

      .coordinate-note {
        margin-top: 7px;
        color: #777a75;
        font-size: 10px;
      }

      .height-scale {
        position: absolute;
        top: 12px;
        right: 12px;
        bottom: 12px;
        left: 12px;
        z-index: 1;
        pointer-events: none;
        color: #343733;
        font-size: 11px;
      }

      .height-scale[hidden] { display: none; }

      .height-scale-title {
        position: absolute;
        top: 0;
        right: 0;
        padding: 3px 5px;
        border-radius: 5px;
        background: rgba(255, 255, 255, 0.9);
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
      }

      .height-scale-ticks {
        position: absolute;
        top: 28px;
        right: 0;
        bottom: 0;
        left: 0;
        border-right: 1px solid rgba(52, 55, 51, 0.6);
      }

      :global(.height-scale-guide) {
        position: absolute;
        right: 0;
        left: 0;
        border-top: 1px solid rgba(52, 55, 51, 0.13);
      }

      :global(.height-scale-guide.zero) {
        border-top-color: rgba(32, 33, 31, 0.32);
        border-top-width: 2px;
      }

      :global(.height-scale-tick) {
        position: absolute;
        right: 0;
        width: 9px;
        border-top: 1px solid rgba(52, 55, 51, 0.55);
      }

      :global(.height-scale-tick.zero) {
        width: 15px;
        border-top-width: 2px;
        border-top-color: rgba(32, 33, 31, 0.85);
      }

      :global(.height-scale-label) {
        position: absolute;
        right: 13px;
        transform: translateY(-50%);
        padding: 1px 3px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.82);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }

      .d1-known-door-label-layer {
        position: absolute;
        inset: 0;
        z-index: 4;
        overflow: hidden;
        pointer-events: none;
      }

      .d1-known-door-label-layer[hidden],
      .d1-known-door-legend[hidden] {
        display: none;
      }

      :global(.d1-known-door-label) {
        position: absolute;
        display: grid;
        width: 24px;
        height: 24px;
        place-items: center;
        border: 2px solid #a34a2a;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 2px 8px rgba(25, 28, 25, 0.22);
        color: #7f321d;
        font-size: 12px;
        font-weight: 800;
        line-height: 1;
        transform: translate(-50%, -145%);
      }

      :global(.d1-user-door-label) {
        border-color: #7b247d;
        background: rgba(255, 248, 255, 0.98);
        color: #611563;
        box-shadow: 0 2px 10px rgba(97, 21, 99, 0.3);
      }

      .d1-known-door-legend {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 3;
        width: min(390px, calc(100% - 24px));
        max-height: calc(100% - 24px);
        overflow: auto;
        padding: 10px 12px;
        border: 1px solid #d7d7d2;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.12);
        pointer-events: none;
      }

      .d1-known-door-legend h2 {
        margin: 0 0 6px;
        font-size: 13px;
        font-weight: 750;
      }

      .d1-known-door-legend ol {
        display: grid;
        gap: 5px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .d1-known-door-legend :global(li) {
        display: grid;
        grid-template-columns: 24px minmax(0, 1fr);
        gap: 7px;
        align-items: start;
        font-size: 10px;
      }

      .d1-known-door-legend :global(.d1-known-door-legend-number) {
        display: grid;
        width: 20px;
        height: 20px;
        place-items: center;
        border: 1px solid #a34a2a;
        border-radius: 999px;
        color: #7f321d;
        font-size: 10px;
        font-weight: 800;
      }

      .d1-known-door-legend :global(.d1-user-door-legend-number) {
        border-color: #7b247d;
        color: #611563;
      }

      .d1-known-door-legend :global(.d1-known-door-legend-name) {
        display: block;
        margin-bottom: 1px;
        font-weight: 700;
      }

      .d1-known-door-legend :global(code) {
        display: block;
        color: #656862;
        font-size: 9px;
        overflow-wrap: anywhere;
      }

      .d1-known-door-legend-note {
        margin-top: 7px;
        color: #777a75;
        font-size: 10px;
      }

      .d1-user-door-legend-section {
        margin-top: 10px;
        padding-top: 8px;
        border-top: 1px solid #d7d7d2;
      }

      .d1-user-door-legend-section[hidden] {
        display: none;
      }

      .d1-user-door-legend-section h3 {
        margin: 0 0 6px;
        font-size: 11px;
        font-weight: 750;
      }

      .d1-user-door-legend-note {
        margin-top: 6px;
        color: #777a75;
        font-size: 9px;
      }

      .profile-panel {
        position: absolute;
        right: 12px;
        bottom: 12px;
        left: 12px;
        z-index: 5;
        max-height: min(410px, calc(100% - 24px));
        overflow: auto;
        padding: 12px;
        border: 1px solid #c9cbc5;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.97);
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.18);
      }

      .profile-panel[hidden] { display: none; }

      .profile-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 8px;
      }

      .profile-header h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
      }

      .profile-header button {
        padding: 6px 9px;
        font-size: 12px;
      }

      .profile-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        gap: 10px 16px;
        margin-bottom: 7px;
        font-size: 12px;
      }

      .profile-controls label {
        display: grid;
        gap: 3px;
        color: #555852;
      }

      .profile-controls select {
        min-width: min(330px, 72vw);
      }

      .profile-summary {
        color: #20211f;
        font-size: 12px;
        font-variant-numeric: tabular-nums;
        font-weight: 650;
      }

      .profile-chart {
        display: block;
        width: 100%;
        height: min(250px, 32vh);
        min-height: 190px;
        border: 1px solid #e0e1dc;
        border-radius: 7px;
        background: #fafaf7;
      }

      :global(.profile-grid-line) {
        stroke: rgba(65, 69, 63, 0.15);
        stroke-width: 1;
      }

      :global(.profile-axis-line) {
        stroke: rgba(42, 45, 41, 0.58);
        stroke-width: 1;
      }

      :global(.profile-axis-label) {
        fill: #555852;
        font-size: 10px;
        font-variant-numeric: tabular-nums;
      }

      :global(.profile-terrain-path) {
        fill: none;
        stroke: #71895f;
        stroke-width: 2.2;
      }

      :global(.profile-pipe-path) {
        fill: none;
        stroke: #2d6f9f;
        stroke-width: 2.2;
      }

      :global(.profile-pipe-path.wastewater) {
        stroke: #a55f2f;
      }

      :global(.profile-legend-text) {
        fill: #3e413c;
        font-size: 10px;
      }

      .profile-note {
        margin-top: 6px;
        color: #6c6f69;
        font-size: 10px;
        line-height: 1.35;
      }

      .selection-panel {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 2;
        width: min(340px, calc(100% - 24px));
        max-height: calc(100% - 24px);
        overflow: auto;
        padding: 12px;
        border: 1px solid #d7d7d2;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.14);
      }

      .selection-panel[hidden] { display: none; }

      .selection-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
      }

      .selection-header h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 650;
      }

      .selection-header button {
        padding: 6px 9px;
        font-size: 12px;
      }

      .selection-grid {
        display: grid;
        grid-template-columns: minmax(80px, auto) minmax(0, 1fr);
        gap: 6px 10px;
        margin: 0;
        font-size: 13px;
      }

      .selection-grid dt {
        color: #6c6e69;
      }

      .selection-grid dd {
        margin: 0;
        overflow-wrap: anywhere;
      }

      .selection-metadata {
        display: grid;
        gap: 6px;
        margin-top: 11px;
        padding-top: 10px;
        border-top: 1px solid #e2e3de;
      }

      .selection-metadata > summary {
        color: #555853;
        cursor: pointer;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .selection-metadata-list {
        display: grid;
        grid-template-columns: minmax(92px, auto) minmax(0, 1fr);
        gap: 5px 10px;
        margin: 0;
        font-size: 12px;
      }

      .selection-metadata-list dt {
        color: #6c6e69;
        overflow-wrap: anywhere;
      }

      .selection-metadata-list dd {
        margin: 0;
        overflow-wrap: anywhere;
        font-variant-numeric: tabular-nums;
      }

      .selection-metadata-empty {
        color: #777a75;
        font-size: 11px;
      }

      .selection-metadata-empty[hidden] { display: none; }

      .selection-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 11px;
        padding-top: 10px;
        border-top: 1px solid #e2e3de;
      }

      .selection-actions button {
        flex: 1 1 auto;
        padding: 7px 9px;
        font-size: 12px;
      }

      .viewport {
        position: relative;
        width: 100%;
        min-height: 0;
        height: auto;
        overflow: hidden;
        border: 1px solid #d7d7d2;
        border-radius: 10px;
        background: #ecece8;
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.10);
      }

      canvas {
        width: 100%;
        height: 100%;
        display: block;
        touch-action: none;
        outline: none;
      }

      @media (max-width: 760px) {
        body { padding: 6px; }
        .viewer-shell {
          height: calc(100vh - 12px);
          height: calc(100dvh - 12px);
          min-height: 0;
          grid-template-rows: auto minmax(0, 1fr);
        }
        .viewport {
          min-height: 0;
          height: auto;
        }
        .status {
          width: 100%;
          margin-left: 0;
          text-align: left;
        }
      }
    </style>
  </head>
  <body>
    <main class="viewer-shell">
      <!-- P149A compact primary toolbar: advanced actions stay available through menus. -->
      <div class="toolbar" aria-label="3D-katselun ohjaimet">
        <div class="title">Ylisrinne 3D</div>

        <details id="view-menu" class="toolbar-menu">
          <summary>Näkymä</summary>
          <div class="toolbar-menu-panel" aria-label="Vakioidut näkymät">
            <div class="toolbar-menu-label">Vakionäkymät</div>
            <button id="whole-building-preset-button" type="button">Koko rakennus</button>
            <button id="d-overview-preset-button" type="button">D-asunto</button>
            <button id="orbit-button" type="button">Vapaa 3D</button>
            <button id="iso-button" type="button">Isometrinen</button>
            <button id="top-button" type="button">Ylhäältä</button>
            <button id="bottom-button" type="button">Alhaalta</button>
            <div class="toolbar-menu-separator"></div>
            <div class="toolbar-menu-label">D-asunto / kerros</div>
            <button id="d1-plan-button" type="button">D 1F</button>
            <button id="d2-plan-button" type="button">D 2F</button>
            <div class="toolbar-menu-separator"></div>
            <div class="toolbar-menu-label">Alue</div>
            <button id="site-preset-button" type="button">Tontti</button>
            <button id="infra-preset-button" type="button">Infra</button>
            <div class="toolbar-menu-separator"></div>
            <div class="toolbar-menu-label">Julkisivut</div>
            <button id="elev-pos-y-button" type="button" title="Ortografinen julkisivu YLIS-G1-LOCAL +Y suunnasta">Julk +Y</button>
            <button id="elev-neg-y-button" type="button" title="Ortografinen julkisivu YLIS-G1-LOCAL -Y suunnasta">Julk -Y</button>
            <button id="elev-pos-x-button" type="button" title="Ortografinen julkisivu YLIS-G1-LOCAL +X suunnasta">Julk +X</button>
            <button id="elev-neg-x-button" type="button" title="Ortografinen julkisivu YLIS-G1-LOCAL -X suunnasta">Julk -X</button>
          </div>
        </details>

        <button id="layers-button" type="button" aria-expanded="false" aria-controls="layers-panel">Layerit</button>

        <details id="model-menu" class="toolbar-menu source-menu">
