            <button id="compare-model-button" type="button" disabled>Vertaa WORK_TESTiin</button>
            <button id="work-test-upload-button" type="button" hidden>Tuo WORK_TEST .glb</button>
            <input id="work-test-upload-input" type="file" accept=".glb,model/gltf-binary,application/octet-stream" hidden />
            <button id="current-model-button" type="button" hidden>Palaa CURRENTiin</button>
