---
const title = 'Private 3D viewer';
---

<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f4f4f1;
        color: #20211f;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #f4f4f1;
      }

      body {
        height: 100vh;
        height: 100dvh;
        min-height: 0;
        padding: 10px;
      }

      .viewer-shell {
        width: 100%;
        height: calc(100vh - 20px);
        height: calc(100dvh - 20px);
        min-height: 0;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        gap: 10px;
      }

      .toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        padding: 9px 10px;
        background: #fff;
        border: 1px solid #d7d7d2;
        border-radius: 10px;
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.10);
      }

      .title {
        margin-right: 8px;
        font-weight: 650;
        white-space: nowrap;
      }

      button {
        border: 1px solid #b9bbb5;
        border-radius: 7px;
        padding: 8px 11px;
        background: #fff;
        color: #20211f;
        font: inherit;
        line-height: 1;
        cursor: pointer;
      }

      button:hover { border-color: #8f928c; }

      .status {
        margin-left: auto;
        min-width: 220px;
        color: #6c6e69;
        font-size: 13px;
        text-align: right;
      }

      .selection-panel {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 2;
        width: min(340px, calc(100% - 24px));
        max-height: calc(100% - 24px);
        overflow: auto;
        padding: 12px;
        border: 1px solid #d7d7d2;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.14);
      }

      .selection-panel[hidden] { display: none; }

      .selection-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
      }

      .selection-header h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 650;
      }

      .selection-header button {
        padding: 6px 9px;
        font-size: 12px;
      }

      .selection-grid {
        display: grid;
        grid-template-columns: minmax(80px, auto) minmax(0, 1fr);
        gap: 6px 10px;
        margin: 0;
        font-size: 13px;
      }

      .selection-grid dt {
        color: #6c6e69;
      }

      .selection-grid dd {
        margin: 0;
        overflow-wrap: anywhere;
      }

      .viewport {
        position: relative;
        width: 100%;
        min-height: 0;
        height: auto;
        overflow: hidden;
        border: 1px solid #d7d7d2;
        border-radius: 10px;
        background: #ecece8;
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.10);
      }

      canvas {
        width: 100%;
        height: 100%;
        display: block;
        touch-action: none;
        outline: none;
      }

      @media (max-width: 760px) {
        body { padding: 6px; }
        .viewer-shell {
          height: calc(100vh - 12px);
          height: calc(100dvh - 12px);
          min-height: 0;
          grid-template-rows: auto minmax(0, 1fr);
        }
        .viewport {
          min-height: 0;
          height: auto;
        }
        .status {
          width: 100%;
          margin-left: 0;
          text-align: left;
        }
      }
    </style>
  </head>
  <body>
    <main class="viewer-shell">
      <div class="toolbar" aria-label="3D-katselun ohjaimet">
        <div class="title">Private 3D viewer</div>
        <button id="fit-button" type="button">Fit / Reset</button>
        <button id="orbit-button" type="button">Orbit</button>
        <button id="top-button" type="button">Ylhäältä</button>
        <button id="bottom-button" type="button">Alhaalta</button>
        <button id="d1-plan-button" type="button">D 1F</button>
        <button id="d2-plan-button" type="button">D 2F</button>
        <div id="viewer-status" class="status" role="status">Ladataan suojattua mallia...</div>
      </div>

      <section class="viewport" aria-label="Suojattu 3D-katseluportti">
        <canvas id="private-model-canvas" tabindex="0"></canvas>
        <aside id="selection-panel" class="selection-panel" aria-live="polite" hidden>
          <div class="selection-header">
            <h2>Valittu kohde</h2>
            <button id="clear-selection-button" type="button">Tyhjennä</button>
          </div>
          <dl class="selection-grid">
            <dt>Mesh</dt>
            <dd id="selection-mesh">-</dd>
            <dt>Ryhmä</dt>
            <dd id="selection-group">-</dd>
            <dt>Scene</dt>
            <dd id="selection-scene">-</dd>
            <dt>Kerros</dt>
            <dd id="selection-floor">-</dd>
          </dl>
        </aside>
      </section>
    </main>

    <script>
      import { THREE, OrbitControls, GLTFLoader } from '../../scripts/threeRuntime';

      const canvas = document.querySelector<HTMLCanvasElement>('#private-model-canvas');
      const status = document.querySelector<HTMLElement>('#viewer-status');
      const fitButton = document.querySelector<HTMLButtonElement>('#fit-button');
      const orbitButton = document.querySelector<HTMLButtonElement>('#orbit-button');
      const topButton = document.querySelector<HTMLButtonElement>('#top-button');
      const bottomButton = document.querySelector<HTMLButtonElement>('#bottom-button');
      const d1PlanButton = document.querySelector<HTMLButtonElement>('#d1-plan-button');
      const d2PlanButton = document.querySelector<HTMLButtonElement>('#d2-plan-button');
      const selectionPanel = document.querySelector<HTMLElement>('#selection-panel');
      const selectionMesh = document.querySelector<HTMLElement>('#selection-mesh');
      const selectionGroup = document.querySelector<HTMLElement>('#selection-group');
      const selectionScene = document.querySelector<HTMLElement>('#selection-scene');
      const selectionFloor = document.querySelector<HTMLElement>('#selection-floor');
      const clearSelectionButton = document.querySelector<HTMLButtonElement>('#clear-selection-button');

      if (
        !canvas ||
        !status ||
        !fitButton ||
        !orbitButton ||
        !topButton ||
        !bottomButton ||
        !d1PlanButton ||
        !d2PlanButton ||
        !selectionPanel ||
        !selectionMesh ||
        !selectionGroup ||
        !selectionScene ||
        !selectionFloor ||
        !clearSelectionButton
      ) {
        throw new Error('Private viewer controls are missing');
      }

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.setClearColor(0xecece8, 1);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(38, 1, 0.01, 5000);
      camera.up.set(0, 1, 0);

      const planCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.01, 5000);
      planCamera.up.set(0, 0, -1);

      const controls = new OrbitControls(camera, canvas);
      controls.enableDamping = true;
      controls.dampingFactor = 0.08;
      controls.screenSpacePanning = true;

      const planControls = new OrbitControls(planCamera, canvas);
      planControls.enableDamping = true;
      planControls.dampingFactor = 0.08;
      planControls.screenSpacePanning = true;
      planControls.enableRotate = false;
      planControls.enabled = false;

      const ambient = new THREE.HemisphereLight(0xffffff, 0x777777, 2.2);
      scene.add(ambient);

      const keyLight = new THREE.DirectionalLight(0xffffff, 2.0);
      keyLight.position.set(8, 14, 10);
      scene.add(keyLight);

      const modelRoot = new THREE.Group();
      scene.add(modelRoot);

      const modelCenter = new THREE.Vector3();
      let fitDistance = 10;
      let activeCamera: typeof camera | typeof planCamera = camera;
      let fullModelScene: any = null;
      let dInteriorScene: any = null;
      let activePlanFloor: '1F' | '2F' | null = null;
      const dVisibilityBaseline = new Map<any, boolean>();
      let sourceSceneNames = new WeakMap<any, string>();
      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2();
      let selectionHelper: any = null;
      let pointerDown: { pointerId: number; x: number; y: number } | null = null;
      const pickDragThresholdPx = 6;

      const setModelScene = (root: any) => {
        modelRoot.clear();
        if (root) modelRoot.add(root);
        modelRoot.updateMatrixWorld(true);
      };

      const restoreDVisibility = () => {
        for (const [object, visible] of dVisibilityBaseline.entries()) {
          object.visible = visible;
        }
      };

      const semanticName = (object: any) => {
        const names: string[] = [];
        let current = object;
        let depth = 0;

        while (current && depth < 12) {
          if (current.name) names.push(String(current.name));
          current = current.parent;
          depth += 1;
        }

        return names.join(' | ').toUpperCase();
      };

      const normalizeSceneName = (name: unknown) =>
        String(name ?? '')
          .toUpperCase()
          .replace(/[^A-Z0-9]+/g, ' ')
          .trim();

      const findSourceNamedScene = (gltf: any, sourceName: string) => {
        const sourceScenes = gltf?.parser?.json?.scenes;
        if (Array.isArray(sourceScenes)) {
          const sourceIndex = sourceScenes.findIndex((candidate: any) => candidate?.name === sourceName);
          if (sourceIndex >= 0 && gltf.scenes?.[sourceIndex]) {
            return gltf.scenes[sourceIndex];
          }
        }

        const target = normalizeSceneName(sourceName);
        return (
          gltf.scenes?.find((candidate: any) => normalizeSceneName(candidate?.name) === target) ?? null
        );
      };

      const hasFloorToken = (object: any, floor: '1F' | '2F') => {
        const name = semanticName(object);
        return new RegExp('(^|[_\\s-])' + floor + '([_\\s-]|$)').test(name);
      };

      const computeVisibleBounds = (root: any) => {
        const bounds = new THREE.Box3();
        let found = false;

        root.updateMatrixWorld(true);
        root.traverse((object: any) => {
          if (!object.isMesh || !object.visible || !object.geometry) return;

          let current = object.parent;
          while (current && current !== root.parent) {
            if (!current.visible) return;
            current = current.parent;
          }

          if (!object.geometry.boundingBox) object.geometry.computeBoundingBox();
          if (!object.geometry.boundingBox) return;

          const meshBounds = object.geometry.boundingBox.clone().applyMatrix4(object.matrixWorld);
          if (meshBounds.isEmpty()) return;
          bounds.union(meshBounds);
          found = true;
        });

        return found ? bounds : null;
      };

      const isEffectivelyVisible = (object: any) => {
        let current = object;
        while (current && current !== modelRoot.parent) {
          if (!current.visible) return false;
          if (current === modelRoot) return true;
          current = current.parent;
        }
        return false;
      };

      const nearestNamedAncestor = (object: any) => {
        let current = object.parent;
        while (current && current !== modelRoot) {
          if (current.name) return String(current.name);
          current = current.parent;
        }
        return '';
      };

      const sceneNameForObject = (object: any) => {
        let current = object;
        while (current && current !== modelRoot) {
          if (current.isScene) {
            return sourceSceneNames.get(current) || (current.name ? String(current.name) : '');
          }
          current = current.parent;
        }

        const fallback = activePlanFloor ? dInteriorScene : fullModelScene;
        if (!fallback) return '';
        return sourceSceneNames.get(fallback) || (fallback.name ? String(fallback.name) : '');
      };

      const explicitFloorToken = (object: any) => {
        const has1F = hasFloorToken(object, '1F');
        const has2F = hasFloorToken(object, '2F');
        if (has1F && has2F) return '1F / 2F';
        if (has1F) return '1F';
        if (has2F) return '2F';
        return '-';
      };

      const clearSelection = () => {
        if (selectionHelper) {
          scene.remove(selectionHelper);
          selectionHelper.geometry?.dispose?.();
          selectionHelper.material?.dispose?.();
          selectionHelper = null;
        }

        selectionPanel.hidden = true;
        selectionMesh.textContent = '-';
        selectionGroup.textContent = '-';
        selectionScene.textContent = '-';
        selectionFloor.textContent = '-';
      };

      const selectObject = (object: any) => {
        clearSelection();

        selectionMesh.textContent = object.name ? String(object.name) : '(nimetön mesh)';
        selectionGroup.textContent = nearestNamedAncestor(object) || '-';
        selectionScene.textContent = sceneNameForObject(object) || '-';
        selectionFloor.textContent = explicitFloorToken(object);
        selectionPanel.hidden = false;

        selectionHelper = new THREE.BoxHelper(object, 0x356a8a);
        scene.add(selectionHelper);
        selectionHelper.update();
      };

      const selectAtClientPoint = (clientX: number, clientY: number) => {
        const rect = canvas.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return;

        pointer.x = ((clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, activeCamera);

        const hit = raycaster
          .intersectObjects(modelRoot.children, true)
          .find((candidate: any) => candidate.object?.isMesh && isEffectivelyVisible(candidate.object));

        if (!hit) {
          clearSelection();
          return;
        }

        selectObject(hit.object);
      };

      const activateFullModel = () => {
        clearSelection();
        restoreDVisibility();
        activePlanFloor = null;
        planControls.enabled = false;
        controls.enabled = true;
        activeCamera = camera;
        setModelScene(fullModelScene);
      };

      const fitPlanCamera = () => {
        if (!dInteriorScene || !activePlanFloor) return;

        const box = computeVisibleBounds(dInteriorScene);
        if (!box) return;

        const center = new THREE.Vector3();
        const size = new THREE.Vector3();
        box.getCenter(center);
        box.getSize(size);

        const aspect = Math.max(canvas.clientWidth / Math.max(canvas.clientHeight, 1), 0.01);
        let halfWidth = Math.max(size.x * 0.54, 0.25);
        let halfHeight = Math.max(size.z * 0.54, 0.25);
        const modelAspect = halfWidth / halfHeight;

        if (aspect > modelAspect) {
          halfWidth = halfHeight * aspect;
        } else {
          halfHeight = halfWidth / aspect;
        }

        const distance = Math.max(size.length() * 1.25, size.y * 4, 4);
        planCamera.position.set(center.x, box.max.y + distance, center.z);
        planCamera.up.set(0, 0, -1);
        planCamera.lookAt(center);
        planCamera.left = -halfWidth;
        planCamera.right = halfWidth;
        planCamera.top = halfHeight;
        planCamera.bottom = -halfHeight;
        planCamera.near = Math.max(distance / 10000, 0.001);
        planCamera.far = Math.max(distance * 4 + size.y, 1000);
        planCamera.zoom = 1;
        planCamera.updateProjectionMatrix();

        planControls.target.copy(center);
        planControls.update();
      };

      const applyDPlanVisibility = (floor: '1F' | '2F') => {
        restoreDVisibility();
        let matchedMeshes = 0;

        dInteriorScene.traverse((object: any) => {
          if (!object.isMesh) return;
          const baseline = dVisibilityBaseline.get(object) ?? object.visible;
          const show = baseline && hasFloorToken(object, floor);
          object.visible = show;
          if (show) matchedMeshes += 1;
        });

        return matchedMeshes;
      };

      const activateDPlan = (floor: '1F' | '2F') => {
        clearSelection();
        if (!dInteriorScene) {
          status.textContent = 'D-asunnon pohjanäkymää ei löydy tästä mallista';
          return;
        }

        setModelScene(dInteriorScene);
        const matchedMeshes = applyDPlanVisibility(floor);
        if (matchedMeshes === 0) {
          restoreDVisibility();
          activateFullModel();
          status.textContent = `D ${floor} - kerrostunnistetta ei löytynyt`;
          return;
        }

        controls.enabled = false;
        planControls.enabled = true;
        activePlanFloor = floor;
        activeCamera = planCamera;
        fitPlanCamera();
        status.textContent = `D ${floor} - ortografinen pohjanäkymä`;
      };

      const updateSize = () => {
        const width = Math.max(canvas.clientWidth, 1);
        const height = Math.max(canvas.clientHeight, 1);
        const pixelRatio = renderer.getPixelRatio();
        const bufferWidth = Math.floor(width * pixelRatio);
        const bufferHeight = Math.floor(height * pixelRatio);

        if (canvas.width !== bufferWidth || canvas.height !== bufferHeight) {
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
          if (activePlanFloor) fitPlanCamera();
        }
      };

      const fitModel = () => {
        if (!fullModelScene) return;
        activateFullModel();

        const box = new THREE.Box3().setFromObject(modelRoot);
        if (box.isEmpty()) return;

        box.getCenter(modelCenter);
        const sphere = new THREE.Sphere();
        box.getBoundingSphere(sphere);

        const halfFov = THREE.MathUtils.degToRad(camera.fov * 0.5);
        fitDistance = Math.max((sphere.radius / Math.tan(halfFov)) * 1.3, 2);

        controls.target.copy(modelCenter);
        camera.up.set(0, 1, 0);
        camera.position.copy(modelCenter).add(
          new THREE.Vector3(fitDistance * 0.72, fitDistance * 0.55, fitDistance * 0.72),
        );
        camera.near = Math.max(fitDistance / 10000, 0.001);
        camera.far = Math.max(fitDistance * 50, 1000);
        camera.updateProjectionMatrix();
        controls.update();
      };

      const axisView = (direction: 'top' | 'bottom') => {
        if (!fullModelScene) return;
        activateFullModel();
        controls.target.copy(modelCenter);

        if (direction === 'top') {
          camera.position.copy(modelCenter).add(new THREE.Vector3(0, fitDistance, 0));
          camera.up.set(0, 0, -1);
        } else {
          camera.position.copy(modelCenter).add(new THREE.Vector3(0, -fitDistance, 0));
          camera.up.set(0, 0, 1);
        }

        camera.lookAt(modelCenter);
        camera.updateProjectionMatrix();
        controls.update();
      };

      const loadModel = async () => {
        const loader = new GLTFLoader();

        try {
          const gltf = await loader.loadAsync('/private-model/model.glb');
          sourceSceneNames = new WeakMap<any, string>();
          const sourceScenes = gltf?.parser?.json?.scenes;
          if (Array.isArray(sourceScenes)) {
            gltf.scenes?.forEach((candidate: any, index: number) => {
              const sourceName = sourceScenes[index]?.name;
              if (sourceName) sourceSceneNames.set(candidate, String(sourceName));
            });
          }

          fullModelScene = gltf.scene;
          dInteriorScene = findSourceNamedScene(gltf, 'D CURRENT INTERIOR - BABYLON Y-UP');

          dVisibilityBaseline.clear();
          if (dInteriorScene) {
            dInteriorScene.traverse((object: any) => {
              if (object.isMesh) dVisibilityBaseline.set(object, object.visible);
            });
          }

          setModelScene(fullModelScene);
          fitModel();
          status.textContent = dInteriorScene ? 'Malli ladattu - D-pohjat käytettävissä' : 'Malli ladattu';
        } catch (error) {
          console.error(error);
          status.textContent = 'Suojattua mallia ei ole vielä käytettävissä';
        }
      };

      fitButton.addEventListener('click', fitModel);
      orbitButton.addEventListener('click', fitModel);
      topButton.addEventListener('click', () => axisView('top'));
      bottomButton.addEventListener('click', () => axisView('bottom'));
      d1PlanButton.addEventListener('click', () => activateDPlan('1F'));
      d2PlanButton.addEventListener('click', () => activateDPlan('2F'));
      clearSelectionButton.addEventListener('click', clearSelection);

      canvas.addEventListener('pointerdown', (event) => {
        pointerDown = { pointerId: event.pointerId, x: event.clientX, y: event.clientY };
      });

      canvas.addEventListener('pointerup', (event) => {
        if (!pointerDown || pointerDown.pointerId !== event.pointerId) return;

        const distance = Math.hypot(event.clientX - pointerDown.x, event.clientY - pointerDown.y);
        pointerDown = null;
        if (distance <= pickDragThresholdPx) selectAtClientPoint(event.clientX, event.clientY);
      });

      canvas.addEventListener('pointercancel', () => {
        pointerDown = null;
      });

      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') clearSelection();
      });

      const resizeObserver = new ResizeObserver(updateSize);
      resizeObserver.observe(canvas.parentElement ?? canvas);

      renderer.setAnimationLoop(() => {
        updateSize();
        controls.update();
        planControls.update();
        selectionHelper?.update?.();
        renderer.render(scene, activeCamera);
      });

      void loadModel();
    </script>
  </body>
</html>
