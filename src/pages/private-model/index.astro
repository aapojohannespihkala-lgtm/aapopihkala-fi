---
const title = 'Private 3D viewer';
---

<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f4f4f1;
        color: #20211f;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #f4f4f1;
      }

      body {
        height: 100vh;
        height: 100dvh;
        min-height: 0;
        padding: 10px;
      }

      .viewer-shell {
        width: 100%;
        height: calc(100vh - 20px);
        height: calc(100dvh - 20px);
        min-height: 0;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        gap: 10px;
      }

      .toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        padding: 9px 10px;
        background: #fff;
        border: 1px solid #d7d7d2;
        border-radius: 10px;
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.10);
      }

      .title {
        margin-right: 8px;
        font-weight: 650;
        white-space: nowrap;
      }

      button {
        border: 1px solid #b9bbb5;
        border-radius: 7px;
        padding: 8px 11px;
        background: #fff;
        color: #20211f;
        font: inherit;
        line-height: 1;
        cursor: pointer;
      }

      button:hover { border-color: #8f928c; }

      .status {
        margin-left: auto;
        min-width: 220px;
        color: #6c6e69;
        font-size: 13px;
        text-align: right;
      }

      .layers-panel {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 2;
        width: min(290px, calc(100% - 24px));
        padding: 12px;
        border: 1px solid #d7d7d2;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.14);
      }

      .layers-panel[hidden] { display: none; }

      .layers-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
      }

      .layers-header h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 650;
      }

      .layers-header button {
        padding: 6px 9px;
        font-size: 12px;
      }

      .layer-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
      }

      .layer-opacity {
        display: grid;
        grid-template-columns: auto minmax(90px, 1fr) auto;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
        font-size: 12px;
        color: #555853;
      }

      .layer-opacity input { width: 100%; }

      .layer-count {
        margin-top: 8px;
        color: #777a75;
        font-size: 11px;
      }

      .layer-section {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #e2e3de;
      }

      .layer-legend {
        display: grid;
        gap: 5px;
        margin-top: 8px;
        color: #62655f;
        font-size: 11px;
      }

      .legend-item {
        display: flex;
        align-items: center;
        gap: 7px;
      }

      .legend-swatch {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex: 0 0 auto;
      }

      .legend-swatch.water { background: #2f80ed; }
      .legend-swatch.wastewater { background: #c04472; }

      .selection-panel {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 2;
        width: min(340px, calc(100% - 24px));
        max-height: calc(100% - 24px);
        overflow: auto;
        padding: 12px;
        border: 1px solid #d7d7d2;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.14);
      }

      .selection-panel[hidden] { display: none; }

      .selection-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
      }

      .selection-header h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 650;
      }

      .selection-header button {
        padding: 6px 9px;
        font-size: 12px;
      }

      .selection-grid {
        display: grid;
        grid-template-columns: minmax(80px, auto) minmax(0, 1fr);
        gap: 6px 10px;
        margin: 0;
        font-size: 13px;
      }

      .selection-grid dt {
        color: #6c6e69;
      }

      .selection-grid dd {
        margin: 0;
        overflow-wrap: anywhere;
      }

      .viewport {
        position: relative;
        width: 100%;
        min-height: 0;
        height: auto;
        overflow: hidden;
        border: 1px solid #d7d7d2;
        border-radius: 10px;
        background: #ecece8;
        box-shadow: 0 8px 28px rgba(25, 28, 25, 0.10);
      }

      canvas {
        width: 100%;
        height: 100%;
        display: block;
        touch-action: none;
        outline: none;
      }

      @media (max-width: 760px) {
        body { padding: 6px; }
        .viewer-shell {
          height: calc(100vh - 12px);
          height: calc(100dvh - 12px);
          min-height: 0;
          grid-template-rows: auto minmax(0, 1fr);
        }
        .viewport {
          min-height: 0;
          height: auto;
        }
        .status {
          width: 100%;
          margin-left: 0;
          text-align: left;
        }
      }
    </style>
  </head>
  <body>
    <main class="viewer-shell">
      <div class="toolbar" aria-label="3D-katselun ohjaimet">
        <div class="title">Private 3D viewer</div>
        <button id="fit-button" type="button">Fit / Reset</button>
        <button id="orbit-button" type="button">Orbit</button>
        <button id="top-button" type="button">Ylhäältä</button>
        <button id="bottom-button" type="button">Alhaalta</button>
        <button id="iso-button" type="button">Iso</button>
        <button id="d1-plan-button" type="button">D 1F</button>
        <button id="d2-plan-button" type="button">D 2F</button>
        <button id="layers-button" type="button" aria-expanded="false" aria-controls="layers-panel">Layerit</button>
        <div id="viewer-status" class="status" role="status">Ladataan suojattua mallia...</div>
      </div>

      <section class="viewport" aria-label="Suojattu 3D-katseluportti">
        <canvas id="private-model-canvas" tabindex="0"></canvas>
        <aside id="layers-panel" class="layers-panel" hidden>
          <div class="layers-header">
            <h2>Layerit</h2>
            <button id="close-layers-button" type="button">Sulje</button>
          </div>
          <label class="layer-row">
            <input id="roof-layer-visible" type="checkbox" checked />
            <span>Katto (testi)</span>
          </label>
          <label class="layer-opacity">
            <span>Peittävyys</span>
            <input id="roof-layer-opacity" type="range" min="0" max="100" step="5" value="100" />
            <output id="roof-layer-opacity-value">100 %</output>
          </label>
          <div id="roof-layer-count" class="layer-count">0 kohdetta</div>
          <div class="layer-section">
            <label class="layer-row">
              <input id="locus-layer-visible" type="checkbox" disabled />
              <span>Locus kunnallistekniikka (WORK_TEST)</span>
            </label>
            <div id="locus-layer-count" class="layer-count">0 kohdetta</div>
            <div class="layer-legend" aria-label="Locus kunnallistekniikan selite">
              <span class="legend-item">
                <span class="legend-swatch water" aria-hidden="true"></span>
                <span id="locus-water-count">Vesi 0</span>
              </span>
              <span class="legend-item">
                <span class="legend-swatch wastewater" aria-hidden="true"></span>
                <span id="locus-wastewater-count">Jätevesi 0</span>
              </span>
            </div>
          </div>
        </aside>
        <aside id="selection-panel" class="selection-panel" aria-live="polite" hidden>
          <div class="selection-header">
            <h2>Valittu kohde</h2>
            <button id="clear-selection-button" type="button">Tyhjennä</button>
          </div>
          <dl class="selection-grid">
            <dt>Kohde</dt>
            <dd id="selection-mesh">-</dd>
            <dt>Ryhmä</dt>
            <dd id="selection-group">-</dd>
            <dt>Scene</dt>
            <dd id="selection-scene">-</dd>
            <dt>Kerros</dt>
            <dd id="selection-floor">-</dd>
          </dl>
        </aside>
      </section>
    </main>

    <script>
      import { THREE, OrbitControls, GLTFLoader } from '../../scripts/threeRuntime';

      const canvas = document.querySelector<HTMLCanvasElement>('#private-model-canvas');
      const status = document.querySelector<HTMLElement>('#viewer-status');
      const fitButton = document.querySelector<HTMLButtonElement>('#fit-button');
      const orbitButton = document.querySelector<HTMLButtonElement>('#orbit-button');
      const topButton = document.querySelector<HTMLButtonElement>('#top-button');
      const bottomButton = document.querySelector<HTMLButtonElement>('#bottom-button');
      const isoButton = document.querySelector<HTMLButtonElement>('#iso-button');
      const d1PlanButton = document.querySelector<HTMLButtonElement>('#d1-plan-button');
      const d2PlanButton = document.querySelector<HTMLButtonElement>('#d2-plan-button');
      const layersButton = document.querySelector<HTMLButtonElement>('#layers-button');
      const layersPanel = document.querySelector<HTMLElement>('#layers-panel');
      const closeLayersButton = document.querySelector<HTMLButtonElement>('#close-layers-button');
      const roofLayerVisibleInput = document.querySelector<HTMLInputElement>('#roof-layer-visible');
      const roofLayerOpacityInput = document.querySelector<HTMLInputElement>('#roof-layer-opacity');
      const roofLayerOpacityValue = document.querySelector<HTMLOutputElement>('#roof-layer-opacity-value');
      const roofLayerCount = document.querySelector<HTMLElement>('#roof-layer-count');
      const locusLayerVisibleInput = document.querySelector<HTMLInputElement>('#locus-layer-visible');
      const locusLayerCount = document.querySelector<HTMLElement>('#locus-layer-count');
      const locusWaterCount = document.querySelector<HTMLElement>('#locus-water-count');
      const locusWastewaterCount = document.querySelector<HTMLElement>('#locus-wastewater-count');
      const selectionPanel = document.querySelector<HTMLElement>('#selection-panel');
      const selectionMesh = document.querySelector<HTMLElement>('#selection-mesh');
      const selectionGroup = document.querySelector<HTMLElement>('#selection-group');
      const selectionScene = document.querySelector<HTMLElement>('#selection-scene');
      const selectionFloor = document.querySelector<HTMLElement>('#selection-floor');
      const clearSelectionButton = document.querySelector<HTMLButtonElement>('#clear-selection-button');

      if (
        !canvas ||
        !status ||
        !fitButton ||
        !orbitButton ||
        !topButton ||
        !bottomButton ||
        !isoButton ||
        !d1PlanButton ||
        !d2PlanButton ||
        !layersButton ||
        !layersPanel ||
        !closeLayersButton ||
        !roofLayerVisibleInput ||
        !roofLayerOpacityInput ||
        !roofLayerOpacityValue ||
        !roofLayerCount ||
        !locusLayerVisibleInput ||
        !locusLayerCount ||
        !locusWaterCount ||
        !locusWastewaterCount ||
        !selectionPanel ||
        !selectionMesh ||
        !selectionGroup ||
        !selectionScene ||
        !selectionFloor ||
        !clearSelectionButton
      ) {
        throw new Error('Private viewer controls are missing');
      }

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.setClearColor(0xecece8, 1);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(38, 1, 0.01, 5000);
      camera.up.set(0, 1, 0);

      const planCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.01, 5000);
      planCamera.up.set(0, 0, -1);

      const isoCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.01, 5000);
      isoCamera.up.set(0, 1, 0);

      const controls = new OrbitControls(camera, canvas);
      controls.enableDamping = true;
      controls.dampingFactor = 0.08;
      controls.screenSpacePanning = true;

      const planControls = new OrbitControls(planCamera, canvas);
      planControls.enableDamping = true;
      planControls.dampingFactor = 0.08;
      planControls.screenSpacePanning = true;
      planControls.enableRotate = false;
      planControls.enabled = false;

      const isoControls = new OrbitControls(isoCamera, canvas);
      isoControls.enableDamping = true;
      isoControls.dampingFactor = 0.08;
      isoControls.screenSpacePanning = true;
      isoControls.enableRotate = false;
      isoControls.enabled = false;

      const ambient = new THREE.HemisphereLight(0xffffff, 0x777777, 2.2);
      scene.add(ambient);

      const keyLight = new THREE.DirectionalLight(0xffffff, 2.0);
      keyLight.position.set(8, 14, 10);
      scene.add(keyLight);

      const modelRoot = new THREE.Group();
      scene.add(modelRoot);

      const modelCenter = new THREE.Vector3();
      let fitDistance = 10;
      let activeCamera: typeof camera | typeof planCamera | typeof isoCamera = camera;
      let fullModelScene: any = null;
      let dInteriorScene: any = null;
      let activePlanFloor: '1F' | '2F' | null = null;
      const dVisibilityBaseline = new Map<any, boolean>();
      let sourceSceneNames = new WeakMap<any, string>();
      const raycaster = new THREE.Raycaster();
      raycaster.params.Line.threshold = 0.08;
      const pointer = new THREE.Vector2();
      let selectionHelper: any = null;
      let selectedObject: any = null;
      let pointerDown: { pointerId: number; x: number; y: number } | null = null;
      const pickDragThresholdPx = 6;
      const roofLayerMembers = new Set<any>();
      const roofLayerMeshes = new Set<any>();
      const roofLayerVisibilityBaseline = new Map<any, boolean>();
      const roofLayerMaterialBaseline = new Map<any, { opacity: number; transparent: boolean }>();
      let roofLayerVisible = true;
      let roofLayerOpacity = 1;
      const locusLayerMembers = new Set<any>();
      const locusLayerObjects = new Set<any>();
      const locusWaterObjects = new Set<any>();
      const locusWastewaterObjects = new Set<any>();
      const locusLayerVisibilityBaseline = new Map<any, boolean>();
      let locusLayerVisible = false;
      let archBaseMaterialCloneCount = 0;

      const setModelScene = (root: any) => {
        modelRoot.clear();
        if (root) modelRoot.add(root);
        modelRoot.updateMatrixWorld(true);
      };

      const restoreDVisibility = () => {
        for (const [object, visible] of dVisibilityBaseline.entries()) {
          object.visible = visible;
        }
      };

      const semanticName = (object: any) => {
        const names: string[] = [];
        let current = object;
        let depth = 0;

        while (current && depth < 12) {
          if (current.name) names.push(String(current.name));
          current = current.parent;
          depth += 1;
        }

        return names.join(' | ').toUpperCase();
      };

      const normalizeSceneName = (name: unknown) =>
        String(name ?? '')
          .toUpperCase()
          .replace(/[^A-Z0-9]+/g, ' ')
          .trim();

      const findSourceNamedScene = (gltf: any, sourceName: string) => {
        const sourceScenes = gltf?.parser?.json?.scenes;
        if (Array.isArray(sourceScenes)) {
          const sourceIndex = sourceScenes.findIndex((candidate: any) => candidate?.name === sourceName);
          if (sourceIndex >= 0 && gltf.scenes?.[sourceIndex]) {
            return gltf.scenes[sourceIndex];
          }
        }

        const target = normalizeSceneName(sourceName);
        return (
          gltf.scenes?.find((candidate: any) => normalizeSceneName(candidate?.name) === target) ?? null
        );
      };

      const hasFloorToken = (object: any, floor: '1F' | '2F') => {
        const name = semanticName(object);
        return new RegExp('(^|[_\\s-])' + floor + '([_\\s-]|$)').test(name);
      };

      const isRoofLayerMember = (object: any) => {
        const data = object?.userData ?? {};
        return (
          data.presentationLayer === 'REFERENCE_ROOF' ||
          data.representationKind === 'presentationRoofStepFace' ||
          Array.isArray(data.derivedRoofReferenceEnvelopeY_M) ||
          (
            data.sourceContract === 'R3-D09' &&
            Object.prototype.hasOwnProperty.call(data, 'physicalEaveExtentClaim')
          )
        );
      };

      const isLocusLayerMember = (object: any) =>
        object?.userData?.presentationLayer === 'G3_LOCUS_SITE';

      const hasLocusLayerAncestor = (object: any) => {
        let current = object;
        while (current && current !== fullModelScene?.parent) {
          if (isLocusLayerMember(current)) return true;
          if (current === fullModelScene) break;
          current = current.parent;
        }
        return false;
      };

      const isArchBaseMaterial = (material: any) =>
        material?.userData?.presentationGroup === 'ARCH_BASE';

      const makeOpaqueArchBaseMaterial = (material: any) => {
        if (!isArchBaseMaterial(material) || !material?.clone) return material;
        const clone = material.clone();
        clone.opacity = 1;
        clone.transparent = false;
        clone.needsUpdate = true;
        archBaseMaterialCloneCount += 1;
        return clone;
      };

      const initializeFullModelArchBase = () => {
        archBaseMaterialCloneCount = 0;
        if (!fullModelScene) return;

        fullModelScene.traverse((object: any) => {
          if (!object.isMesh) return;
          if (Array.isArray(object.material)) {
            object.material = object.material.map((material: any) => makeOpaqueArchBaseMaterial(material));
          } else {
            object.material = makeOpaqueArchBaseMaterial(object.material);
          }
        });

        canvas.dataset.archBaseMaterialCloneCount = String(archBaseMaterialCloneCount);
        canvas.dataset.archBaseOpacity = archBaseMaterialCloneCount > 0 ? '1' : '';
      };

      const registerRoofMaterial = (material: any) => {
        if (!material || roofLayerMaterialBaseline.has(material)) return material;
        roofLayerMaterialBaseline.set(material, {
          opacity: typeof material.opacity === 'number' ? material.opacity : 1,
          transparent: Boolean(material.transparent),
        });
        return material;
      };

      const cloneRoofMeshMaterial = (mesh: any) => {
        const material = mesh.material;
        if (Array.isArray(material)) {
          mesh.material = material.map((item: any) => registerRoofMaterial(item.clone()));
        } else if (material?.clone) {
          mesh.material = registerRoofMaterial(material.clone());
        }
      };

      const applyRoofLayerState = () => {
        for (const member of roofLayerMembers) {
          const baseline = roofLayerVisibilityBaseline.get(member) ?? true;
          member.visible = baseline && roofLayerVisible;
        }

        for (const material of roofLayerMaterialBaseline.keys()) {
          material.opacity = Math.max(0, Math.min(1, roofLayerOpacity));
          material.transparent = material.opacity < 0.999;
          material.needsUpdate = true;
        }

        roofLayerOpacityValue.textContent = `${Math.round(roofLayerOpacity * 100)} %`;
        const roofMaterialOpacity = roofLayerMaterialBaseline.keys().next().value?.opacity;
        roofLayerOpacityValue.dataset.materialOpacity =
          typeof roofMaterialOpacity === 'number' ? String(roofMaterialOpacity) : '';
      };

      const initializeRoofLayer = () => {
        roofLayerMembers.clear();
        roofLayerMeshes.clear();
        roofLayerVisibilityBaseline.clear();
        roofLayerMaterialBaseline.clear();

        if (!fullModelScene) {
          roofLayerCount.textContent = '0 kohdetta';
          return;
        }

        fullModelScene.traverse((object: any) => {
          if (!isRoofLayerMember(object)) return;

          roofLayerMembers.add(object);
          roofLayerVisibilityBaseline.set(object, object.visible);

          object.traverse((child: any) => {
            if (!child.isMesh || roofLayerMeshes.has(child)) return;
            roofLayerMeshes.add(child);
            cloneRoofMeshMaterial(child);
          });
        });

        roofLayerCount.textContent = `${roofLayerMeshes.size} kohdetta`;
        applyRoofLayerState();
      };

      const applyLocusLayerState = () => {
        for (const member of locusLayerMembers) {
          const baseline = locusLayerVisibilityBaseline.get(member) ?? true;
          member.visible = baseline && locusLayerVisible;
        }

        locusLayerVisibleInput.checked = locusLayerVisible;
        locusLayerVisibleInput.disabled = locusLayerMembers.size === 0;
        canvas.dataset.locusLayerVisible = locusLayerVisible ? 'true' : 'false';

        if (selectedObject && !isEffectivelyVisible(selectedObject)) clearSelection();
      };

      const initializeLocusLayer = () => {
        locusLayerMembers.clear();
        locusLayerObjects.clear();
        locusWaterObjects.clear();
        locusWastewaterObjects.clear();
        locusLayerVisibilityBaseline.clear();
        locusLayerVisible = false;

        if (fullModelScene) {
          fullModelScene.traverse((object: any) => {
            if (isLocusLayerMember(object)) {
              locusLayerMembers.add(object);
              locusLayerVisibilityBaseline.set(object, object.visible);
            }

            if (!hasLocusLayerAncestor(object)) return;
            const subgroup = object?.userData?.presentationSubgroup;
            if (subgroup !== 'WATER' && subgroup !== 'WASTEWATER') return;

            locusLayerObjects.add(object);
            if (subgroup === 'WATER') locusWaterObjects.add(object);
            if (subgroup === 'WASTEWATER') locusWastewaterObjects.add(object);
          });
        }

        const objectCount = locusLayerObjects.size || locusLayerMembers.size;
        locusLayerCount.textContent = `${objectCount} kohdetta`;
        locusWaterCount.textContent = `Vesi ${locusWaterObjects.size}`;
        locusWastewaterCount.textContent = `Jätevesi ${locusWastewaterObjects.size}`;
        canvas.dataset.locusLayerCount = String(objectCount);
        canvas.dataset.locusWaterCount = String(locusWaterObjects.size);
        canvas.dataset.locusWastewaterCount = String(locusWastewaterObjects.size);
        applyLocusLayerState();
      };

      const setLayersPanelOpen = (open: boolean) => {
        layersPanel.hidden = !open;
        layersButton.setAttribute('aria-expanded', String(open));
      };

      const computeVisibleBounds = (root: any, includeNonMeshGeometry = false) => {
        const bounds = new THREE.Box3();
        let found = false;

        root.updateMatrixWorld(true);
        root.traverse((object: any) => {
          const boundsEligible =
            object.isMesh ||
            (includeNonMeshGeometry && (object.isLine || object.isLineSegments || object.isPoints));
          if (!boundsEligible || !object.visible || !object.geometry) return;

          let current = object.parent;
          while (current && current !== root.parent) {
            if (!current.visible) return;
            current = current.parent;
          }

          if (!object.geometry.boundingBox) object.geometry.computeBoundingBox();
          if (!object.geometry.boundingBox) return;

          const objectBounds = object.geometry.boundingBox.clone().applyMatrix4(object.matrixWorld);
          if (objectBounds.isEmpty()) return;
          bounds.union(objectBounds);
          found = true;
        });

        return found ? bounds : null;
      };

      const isEffectivelyVisible = (object: any) => {
        let current = object;
        while (current && current !== modelRoot.parent) {
          if (!current.visible) return false;
          if (current === modelRoot) return true;
          current = current.parent;
        }
        return false;
      };

      const hasVisibleMaterial = (object: any) => {
        const materials = Array.isArray(object?.material) ? object.material : [object?.material];
        return materials.some((material: any) => !material || material.opacity === undefined || material.opacity > 0.01);
      };

      const nearestNamedAncestor = (object: any) => {
        let current = object.parent;
        while (current && current !== modelRoot) {
          if (current.name) return String(current.name);
          current = current.parent;
        }
        return '';
      };

      const sceneNameForObject = (object: any) => {
        let current = object;
        while (current && current !== modelRoot) {
          if (current.isScene) {
            return sourceSceneNames.get(current) || (current.name ? String(current.name) : '');
          }
          current = current.parent;
        }

        const fallback = activePlanFloor ? dInteriorScene : fullModelScene;
        if (!fallback) return '';
        return sourceSceneNames.get(fallback) || (fallback.name ? String(fallback.name) : '');
      };

      const explicitFloorToken = (object: any) => {
        const has1F = hasFloorToken(object, '1F');
        const has2F = hasFloorToken(object, '2F');
        if (has1F && has2F) return '1F / 2F';
        if (has1F) return '1F';
        if (has2F) return '2F';
        return '-';
      };

      const clearSelection = () => {
        if (selectionHelper) {
          scene.remove(selectionHelper);
          selectionHelper.geometry?.dispose?.();
          selectionHelper.material?.dispose?.();
          selectionHelper = null;
        }

        selectionPanel.hidden = true;
        selectedObject = null;
        selectionMesh.textContent = '-';
        selectionGroup.textContent = '-';
        selectionScene.textContent = '-';
        selectionFloor.textContent = '-';
      };

      const selectObject = (object: any) => {
        clearSelection();

        selectedObject = object;
        selectionMesh.textContent = object.name ? String(object.name) : '(nimetön kohde)';
        selectionGroup.textContent = nearestNamedAncestor(object) || '-';
        selectionScene.textContent = sceneNameForObject(object) || '-';
        selectionFloor.textContent = explicitFloorToken(object);
        selectionPanel.hidden = false;

        selectionHelper = new THREE.BoxHelper(object, 0x356a8a);
        scene.add(selectionHelper);
        selectionHelper.update();
      };

      const selectAtClientPoint = (clientX: number, clientY: number) => {
        const rect = canvas.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return;

        pointer.x = ((clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, activeCamera);

        const hit = raycaster
          .intersectObjects(modelRoot.children, true)
          .find(
            (candidate: any) =>
              (candidate.object?.isMesh || candidate.object?.isLine || candidate.object?.isLineSegments) &&
              isEffectivelyVisible(candidate.object) &&
              hasVisibleMaterial(candidate.object),
          );

        if (!hit) {
          clearSelection();
          return;
        }

        selectObject(hit.object);
      };

      const syncViewState = (preset: 'orbit' | 'top' | 'bottom' | 'isometric' | 'd-plan') => {
        canvas.dataset.viewPreset = preset;
        canvas.dataset.cameraProjection = (activeCamera as any).isOrthographicCamera === true ? 'orthographic' : 'perspective';
      };

      const fitIsometricCamera = () => {
        if (!fullModelScene) return;

        const box = computeVisibleBounds(fullModelScene, true);
        if (!box) return;

        const center = new THREE.Vector3();
        const sphere = new THREE.Sphere();
        box.getCenter(center);
        box.getBoundingSphere(sphere);

        const radius = Math.max(sphere.radius, 0.25);
        canvas.dataset.isoFitCenterX = String(center.x);
        canvas.dataset.isoFitRadius = String(radius);
        const aspect = Math.max(canvas.clientWidth / Math.max(canvas.clientHeight, 1), 0.01);
        let halfHeight = radius * 1.16;
        let halfWidth = halfHeight * aspect;
        if (halfWidth < radius * 1.16) {
          halfHeight = (radius * 1.16) / aspect;
          halfWidth = halfHeight * aspect;
        }

        const direction = new THREE.Vector3(1, 1, 1).normalize();
        const distance = Math.max(radius * 3.2, 4);
        isoCamera.position.copy(center).addScaledVector(direction, distance);
        isoCamera.up.set(0, 1, 0);
        isoCamera.lookAt(center);
        isoCamera.left = -halfWidth;
        isoCamera.right = halfWidth;
        isoCamera.top = halfHeight;
        isoCamera.bottom = -halfHeight;
        isoCamera.near = Math.max(distance / 10000, 0.001);
        isoCamera.far = Math.max(distance * 4 + radius * 2, 1000);
        isoCamera.zoom = 1;
        isoCamera.updateProjectionMatrix();

        isoControls.target.copy(center);
        isoControls.update();
      };

      const activateIsometric = () => {
        if (!fullModelScene) return;

        clearSelection();
        restoreDVisibility();
        activePlanFloor = null;
        controls.enabled = false;
        planControls.enabled = false;
        isoControls.enabled = true;
        activeCamera = isoCamera;
        setModelScene(fullModelScene);
        applyRoofLayerState();
        fitIsometricCamera();
        syncViewState('isometric');
        status.textContent = 'Isometrinen - ortografinen 3/4-näkymä';
      };

      const activateFullModel = () => {
        clearSelection();
        restoreDVisibility();
        activePlanFloor = null;
        planControls.enabled = false;
        isoControls.enabled = false;
        controls.enabled = true;
        activeCamera = camera;
        setModelScene(fullModelScene);
        applyRoofLayerState();
        syncViewState('orbit');
      };

      const fitPlanCamera = () => {
        if (!dInteriorScene || !activePlanFloor) return;

        const box = computeVisibleBounds(dInteriorScene);
        if (!box) return;

        const center = new THREE.Vector3();
        const size = new THREE.Vector3();
        box.getCenter(center);
        box.getSize(size);

        const aspect = Math.max(canvas.clientWidth / Math.max(canvas.clientHeight, 1), 0.01);
        let halfWidth = Math.max(size.x * 0.54, 0.25);
        let halfHeight = Math.max(size.z * 0.54, 0.25);
        const modelAspect = halfWidth / halfHeight;

        if (aspect > modelAspect) {
          halfWidth = halfHeight * aspect;
        } else {
          halfHeight = halfWidth / aspect;
        }

        const distance = Math.max(size.length() * 1.25, size.y * 4, 4);
        planCamera.position.set(center.x, box.max.y + distance, center.z);
        planCamera.up.set(0, 0, -1);
        planCamera.lookAt(center);
        planCamera.left = -halfWidth;
        planCamera.right = halfWidth;
        planCamera.top = halfHeight;
        planCamera.bottom = -halfHeight;
        planCamera.near = Math.max(distance / 10000, 0.001);
        planCamera.far = Math.max(distance * 4 + size.y, 1000);
        planCamera.zoom = 1;
        planCamera.updateProjectionMatrix();

        planControls.target.copy(center);
        planControls.update();
      };

      const applyDPlanVisibility = (floor: '1F' | '2F') => {
        restoreDVisibility();
        let matchedMeshes = 0;

        dInteriorScene.traverse((object: any) => {
          if (!object.isMesh) return;
          const baseline = dVisibilityBaseline.get(object) ?? object.visible;
          const show = baseline && hasFloorToken(object, floor);
          object.visible = show;
          if (show) matchedMeshes += 1;
        });

        return matchedMeshes;
      };

      const activateDPlan = (floor: '1F' | '2F') => {
        clearSelection();
        if (!dInteriorScene) {
          status.textContent = 'D-asunnon pohjanäkymää ei löydy tästä mallista';
          return;
        }

        setModelScene(dInteriorScene);
        const matchedMeshes = applyDPlanVisibility(floor);
        if (matchedMeshes === 0) {
          restoreDVisibility();
          activateFullModel();
          status.textContent = `D ${floor} - kerrostunnistetta ei löytynyt`;
          return;
        }

        controls.enabled = false;
        isoControls.enabled = false;
        planControls.enabled = true;
        activePlanFloor = floor;
        activeCamera = planCamera;
        fitPlanCamera();
        syncViewState('d-plan');
        status.textContent = `D ${floor} - ortografinen pohjanäkymä`;
      };

      const updateSize = () => {
        const width = Math.max(canvas.clientWidth, 1);
        const height = Math.max(canvas.clientHeight, 1);
        const pixelRatio = renderer.getPixelRatio();
        const bufferWidth = Math.floor(width * pixelRatio);
        const bufferHeight = Math.floor(height * pixelRatio);

        if (canvas.width !== bufferWidth || canvas.height !== bufferHeight) {
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
          if (activePlanFloor) fitPlanCamera();
          else if (activeCamera === isoCamera) fitIsometricCamera();
        }
      };

      const refreshFullModelFitMetrics = () => {
        if (!fullModelScene) return false;

        const box = computeVisibleBounds(fullModelScene, true);
        if (!box) return false;

        box.getCenter(modelCenter);
        const sphere = new THREE.Sphere();
        box.getBoundingSphere(sphere);

        const halfFov = THREE.MathUtils.degToRad(camera.fov * 0.5);
        fitDistance = Math.max((sphere.radius / Math.tan(halfFov)) * 1.3, 2);
        canvas.dataset.fitCenterX = String(modelCenter.x);
        canvas.dataset.fitRadius = String(sphere.radius);
        return true;
      };

      const fitModel = () => {
        if (!fullModelScene) return;
        activateFullModel();
        if (!refreshFullModelFitMetrics()) return;

        controls.target.copy(modelCenter);
        camera.up.set(0, 1, 0);
        camera.position.copy(modelCenter).add(
          new THREE.Vector3(fitDistance * 0.72, fitDistance * 0.55, fitDistance * 0.72),
        );
        camera.near = Math.max(fitDistance / 10000, 0.001);
        camera.far = Math.max(fitDistance * 50, 1000);
        camera.updateProjectionMatrix();
        controls.update();
      };

      const axisView = (direction: 'top' | 'bottom') => {
        if (!fullModelScene) return;
        activateFullModel();
        if (!refreshFullModelFitMetrics()) return;
        controls.target.copy(modelCenter);

        if (direction === 'top') {
          camera.position.copy(modelCenter).add(new THREE.Vector3(0, fitDistance, 0));
          camera.up.set(0, 0, -1);
        } else {
          camera.position.copy(modelCenter).add(new THREE.Vector3(0, -fitDistance, 0));
          camera.up.set(0, 0, 1);
        }

        camera.lookAt(modelCenter);
        camera.updateProjectionMatrix();
        controls.update();
        syncViewState(direction);
      };

      const loadModel = async () => {
        const loader = new GLTFLoader();

        try {
          const gltf = await loader.loadAsync('/private-model/model.glb');
          sourceSceneNames = new WeakMap<any, string>();
          const sourceScenes = gltf?.parser?.json?.scenes;
          if (Array.isArray(sourceScenes)) {
            gltf.scenes?.forEach((candidate: any, index: number) => {
              const sourceName = sourceScenes[index]?.name;
              if (sourceName) sourceSceneNames.set(candidate, String(sourceName));
            });
          }

          fullModelScene = gltf.scene;
          dInteriorScene = findSourceNamedScene(gltf, 'D CURRENT INTERIOR - BABYLON Y-UP');

          initializeFullModelArchBase();
          initializeRoofLayer();
          initializeLocusLayer();

          dVisibilityBaseline.clear();
          if (dInteriorScene) {
            dInteriorScene.traverse((object: any) => {
              if (object.isMesh) dVisibilityBaseline.set(object, object.visible);
            });
          }

          setModelScene(fullModelScene);
          fitModel();
          status.textContent = dInteriorScene ? 'Malli ladattu - D-pohjat käytettävissä' : 'Malli ladattu';
        } catch (error) {
          console.error(error);
          status.textContent = 'Suojattua mallia ei ole vielä käytettävissä';
        }
      };

      fitButton.addEventListener('click', fitModel);
      orbitButton.addEventListener('click', fitModel);
      topButton.addEventListener('click', () => axisView('top'));
      bottomButton.addEventListener('click', () => axisView('bottom'));
      isoButton.addEventListener('click', activateIsometric);
      d1PlanButton.addEventListener('click', () => activateDPlan('1F'));
      d2PlanButton.addEventListener('click', () => activateDPlan('2F'));
      layersButton.addEventListener('click', () => setLayersPanelOpen(layersPanel.hidden));
      closeLayersButton.addEventListener('click', () => setLayersPanelOpen(false));
      roofLayerVisibleInput.addEventListener('change', () => {
        roofLayerVisible = roofLayerVisibleInput.checked;
        applyRoofLayerState();
        if (selectedObject && !isEffectivelyVisible(selectedObject)) clearSelection();
      });
      roofLayerOpacityInput.addEventListener('input', () => {
        roofLayerOpacity = Math.max(0, Math.min(1, Number(roofLayerOpacityInput.value) / 100));
        if (selectedObject && roofLayerMeshes.has(selectedObject) && roofLayerOpacity <= 0.01) clearSelection();
        applyRoofLayerState();
      });
      locusLayerVisibleInput.addEventListener('change', () => {
        locusLayerVisible = locusLayerVisibleInput.checked;
        applyLocusLayerState();
      });
      clearSelectionButton.addEventListener('click', clearSelection);

      canvas.addEventListener('pointerdown', (event) => {
        pointerDown = { pointerId: event.pointerId, x: event.clientX, y: event.clientY };
      });

      canvas.addEventListener('pointerup', (event) => {
        if (!pointerDown || pointerDown.pointerId !== event.pointerId) return;

        const distance = Math.hypot(event.clientX - pointerDown.x, event.clientY - pointerDown.y);
        pointerDown = null;
        if (distance <= pickDragThresholdPx) selectAtClientPoint(event.clientX, event.clientY);
      });

      canvas.addEventListener('pointercancel', () => {
        pointerDown = null;
      });

      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') clearSelection();
      });

      const resizeObserver = new ResizeObserver(updateSize);
      resizeObserver.observe(canvas.parentElement ?? canvas);

      renderer.setAnimationLoop(() => {
        updateSize();
        controls.update();
        planControls.update();
        isoControls.update();
        selectionHelper?.update?.();
        renderer.render(scene, activeCamera);
      });

      void loadModel();
    </script>
  </body>
</html>
