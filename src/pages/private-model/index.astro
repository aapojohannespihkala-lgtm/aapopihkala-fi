      const isWorkTestCandidate = (value: unknown): value is WorkTestCandidate => {
        if (!value || typeof value !== 'object') return false;
        const candidate = value as Record<string, unknown>;
        return (
          typeof candidate.id === 'string' &&
          /^[a-z0-9-]+$/.test(candidate.id) &&
          typeof candidate.label === 'string' &&
          candidate.label.trim().length > 0 &&
          typeof candidate.path === 'string' &&
          /^\/private-model\/work-test\/[a-z0-9-]+\.glb$/.test(candidate.path)
        );
      };

      const setWorkTestCatalog = (candidates: WorkTestCandidate[]) => {
        workTestCandidates = new Map(candidates.map((candidate) => [candidate.id, candidate]));
        workTestSelect.replaceChildren();

        if (candidates.length === 0) {
          const option = document.createElement('option');
          option.value = '';
          option.textContent = 'Ei WORK_TEST-kandidaatteja';
          workTestSelect.append(option);
          workTestSelect.disabled = true;
          workTestButton.disabled = true;
          canvas.dataset.workTestCatalog = 'empty';
          return;
        }

        for (const candidate of candidates) {
          const option = document.createElement('option');
          option.value = candidate.id;
          option.textContent = candidate.label;
          workTestSelect.append(option);
        }

        workTestSelect.disabled = false;
        workTestSelect.value = candidates[0].id;
        workTestButton.disabled = false;
        canvas.dataset.workTestCatalog = 'ready';
      };

      const loadWorkTestCatalog = async () => {
        try {
          const response = await fetch(workTestCatalogPath, {
            headers: { Accept: 'application/json' },
            cache: 'no-store',
          });
          if (!response.ok) throw new Error(`WORK_TEST catalog HTTP ${response.status}`);

          const payload = (await response.json()) as { candidates?: unknown };
          const candidates = Array.isArray(payload.candidates)
            ? payload.candidates.filter(isWorkTestCandidate)
            : [];
          setWorkTestCatalog(candidates);
        } catch (error) {
          console.error(error);
          setWorkTestCatalog([]);
          canvas.dataset.workTestCatalog = 'unavailable';
        }
      };

      const hasP139abZRouteAncestor = (object: any) => {
        let current = object;
        while (current) {
          if (String(current?.userData?.presentationLayer ?? '') === p139abZPresentationLayer) {
            return true;
          }
          current = current.parent;
        }
        return false;
      };

      const cloneP139SourceNodeFromParser = async (
        gltf: any,
        nodeIndex: number,
      ): Promise<THREE.Object3D> => {
        const parser = gltf?.parser;
        const sourceNode = await parser?.getDependency?.('node', nodeIndex);
        if (!sourceNode) throw new Error(`p139 source node missing: ${nodeIndex}`);

        const nodeDef = parser?.json?.nodes?.[nodeIndex] ?? {};
        const rawChildIndices = Array.isArray(nodeDef.children) ? nodeDef.children : [];
        const rawChildSources = await Promise.all(
          rawChildIndices.map((childIndex: number) => parser.getDependency('node', childIndex)),
        );

        const clone = sourceNode.clone(true);
        const rawChildSet = new Set(rawChildSources);
        const sourceChildren = [...sourceNode.children];
        sourceChildren.forEach((child: THREE.Object3D, index: number) => {
          if (rawChildSet.has(child) && clone.children[index]) {
            clone.remove(clone.children[index]);
          }
        });

        for (const childIndex of rawChildIndices) {
          clone.add(await cloneP139SourceNodeFromParser(gltf, childIndex));
        }
        return clone;
      };

      const cloneP139SourceNamedSceneFromParser = async (gltf: any, sceneName: string) => {
        const parser = gltf?.parser;
        const sceneDefs = Array.isArray(parser?.json?.scenes) ? parser.json.scenes : [];
        const sceneDef = sceneDefs.find((scene: any) => scene?.name === sceneName);
        if (!sceneDef) {
          const runtimeScene = findSourceNamedScene(gltf, sceneName);
          return runtimeScene ? runtimeScene.clone(true) : null;
        }

        const clone = new THREE.Group();
        clone.name = sceneName;
        for (const nodeIndex of Array.isArray(sceneDef.nodes) ? sceneDef.nodes : []) {
          clone.add(await cloneP139SourceNodeFromParser(gltf, nodeIndex));
        }
        return clone;
      };

      const buildP139abVisibleReviewScene = async (gltf: any, zScene: any) => {
        const buildingClone = await cloneP139SourceNamedSceneFromParser(
          gltf,
          p139abBuildingSceneName,
        );
        if (!buildingClone) throw new Error('p139AB building context scene missing');

        const zRouteClone = await cloneP139SourceNamedSceneFromParser(gltf, p139abZSceneName);
        if (!zRouteClone) throw new Error('p139AB Z credibility scene missing');

        const composite = new THREE.Group();
        composite.name = 'P139AB VISIBLE BUILDING + Z ROUTES REVIEW';

        let buildingRenderableCount = 0;
        buildingClone.traverse((object: any) => {
          const name = String(object?.name ?? '').toUpperCase();
          if (
            name.includes('P139C_WATER_CONNECTION_ZONE_REVIEW_HELPER') ||
            name.includes('P139E_WASTEWATER_CONNECTION_ZONE_REVIEW_HELPER')
          ) {
            object.visible = false;
            return;
          }

          const renderable =
            object.isMesh || object.isLine || object.isLineSegments || object.isPoints;
          if (renderable && !hasP139abZRouteAncestor(object) && object.visible !== false) {
            buildingRenderableCount += 1;
          }
        });

        let sourceZRenderableCount = 0;
        zRouteClone.traverse((object: any) => {
          const renderable =
            object.isMesh || object.isLine || object.isLineSegments || object.isPoints;
          if (!renderable) return;
          if (hasP139abZRouteAncestor(object)) {
            sourceZRenderableCount += 1;
          } else {
            object.visible = false;
          }
        });

        const sourceHasMeshes =
          Array.isArray(gltf?.parser?.json?.meshes) && gltf.parser.json.meshes.length > 0;
        if (sourceHasMeshes && buildingRenderableCount === 0) {
          throw new Error('p139AB building context has no reconstructed renderables');
        }
        if (sourceZRenderableCount === 0) {
          throw new Error('p139AB source-Z review has no reconstructed renderables');
        }

        composite.add(buildingClone, zRouteClone);
        composite.userData = {
          ...composite.userData,
          reviewScope: 'Z_CREDIBILITY_ONLY',
          buildingContext: true,
          sourceBuildingScene: p139abBuildingSceneName,
          sourceZScene: p139abZSceneName,
          runtimeCarrierScene: 'PARSER_RECONSTRUCTED_BUILDING_PLUS_Z',
          buildingRenderableCount,
          sourceZRenderableCount,
          rawSceneReconstruction: true,
        };
        return composite;
      };

      const isP139acGroundInfraReviewRequested = () =>
        new URLSearchParams(window.location.search).get(p139acReviewQueryKey) === p139acReviewId;

      const buildP139acGroundInfraReviewScene = async (gltf: any, zScene: any) => {
        const composite = await buildP139abVisibleReviewScene(gltf, zScene);
        composite.name = 'P139AC GROUND + Z-BACKED UNDERGROUND INFRA REVIEW';

        const groundGroup = new THREE.Group();
        groundGroup.name = 'P139AC_HISTORICAL_GROUND_REVIEW';

        const positions = p139acGroundControls.flatMap(([x, y, elevation]) => [
          x,
          elevation - p139acVerticalReferenceM,
          -y,
        ]);
        const indices = p139acGroundTriangles.flatMap((triangle) => [...triangle]);
        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
        geometry.setIndex(indices);
        geometry.computeVertexNormals();

        const material = new THREE.MeshBasicMaterial({
          color: 0x7c9061,
          transparent: true,
          opacity: 0.42,
          side: THREE.DoubleSide,
          depthWrite: false,
        });
        const ground = new THREE.Mesh(geometry, material);
        ground.name = 'P139AC_HISTORICAL_GROUND_REVIEW_SURFACE';
        ground.renderOrder = 1;
        ground.userData = {
          Canonical: false,
          ModelStage: 'WORK_TEST_VIEW',
          presentationOnly: true,
          source: '1974-204-A-P-1.tif / G1 T02',
          minimumSourceGroundElevationM: 18.3,
          currentGroundClaim: false,
          asBuiltClaim: false,
          verticalDatumStatus: 'OPEN_UNVERIFIED',
        };
        groundGroup.add(ground);

        const boundaryPositions: number[] = [];
        const boundaryControlIndexes = [0, 1, 2, 3, 4, 0];
        for (let index = 0; index < boundaryControlIndexes.length - 1; index += 1) {
          for (const controlIndex of [boundaryControlIndexes[index], boundaryControlIndexes[index + 1]]) {
            const [x, y, elevation] = p139acGroundControls[controlIndex];
            boundaryPositions.push(x, elevation - p139acVerticalReferenceM + 0.015, -y);
          }
        }
        const boundaryGeometry = new THREE.BufferGeometry();
        boundaryGeometry.setAttribute(
          'position',
          new THREE.Float32BufferAttribute(boundaryPositions, 3),
        );
        const boundary = new THREE.LineSegments(
          boundaryGeometry,
          new THREE.LineBasicMaterial({ color: 0x252525, transparent: true, opacity: 0.85 }),
        );
        boundary.name = 'P139AC_HISTORICAL_LOT_GROUND_REVIEW_BOUNDARY';
        groundGroup.add(boundary);

        groundGroup.userData = {
          reviewScope: 'GROUND_PLUS_Z_BACKED_UNDERGROUND_INFRA',
          groundMinimumElevationM: 18.3,
          undergroundInfraHardCeilingOnLotM: 18.3,
          noZRoutesPhysical: false,
          currentClaim: false,
          asBuiltClaim: false,
        };
        composite.add(groundGroup);
        composite.userData = {
          ...composite.userData,
          reviewScope: 'GROUND_PLUS_Z_BACKED_UNDERGROUND_INFRA',
          groundMinimumElevationM: 18.3,
          undergroundInfraHardCeilingOnLotM: 18.3,
        };
        return composite;
      };

      const isP139adLocusWorkZReviewRequested = () =>
        new URLSearchParams(window.location.search).get(p139acReviewQueryKey) === p139adReviewId;

      const buildP139adLocusWorkZReviewScene = async (gltf: any, zScene: any) => {
        const composite = await buildP139acGroundInfraReviewScene(gltf, zScene);
        composite.name = 'P139AD LOCUS WORK Z + GROUND REVIEW';

        const workZGroup = new THREE.Group();
        workZGroup.name = 'P139AD_LOCUS_WORK_Z_ASSUMPTIONS';

        for (const route of p139adLocusWorkZRoutes) {
          const elevations = route.points.map((point) => point[2]);
          const maxElevationM = Math.max(...elevations);
          if (maxElevationM >= p139adGroundHardCeilingM) {
            throw new Error(`p139AD route exceeds underground hard ceiling: ${route.name}`);
          }

          const positions = route.points.flatMap(([x, y, elevation]) => [
            x,
            elevation - p139acVerticalReferenceM,
            -y,
          ]);
          const geometry = new THREE.BufferGeometry();
          geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));

          const material = new THREE.LineBasicMaterial({
            color: route.system === 'WATER' ? 0x1f7fc9 : 0xb2672d,
            transparent: true,
            opacity: 0.95,
          });
          const line = new THREE.Line(geometry, material);
          line.name = route.name;
          line.renderOrder = 3;
          line.userData = {
            Canonical: false,
            ModelStage: 'WORK_TEST_VIEW',
            presentationOnly: true,
            sourceObject: route.sourceObject,
            sourceXYState: 'PRESERVED_EXACT_FROM_G3_LOCUS_SITE_P02',
            sourceZPreservedAsProvenance: true,
            workZAssumption: true,
            refinable: true,
            workZBasis: route.workZBasis,
            sourceZNote: route.sourceZNote,
            minimumWorkElevationM: Math.min(...elevations),
            maximumWorkElevationM: maxElevationM,
            undergroundHardCeilingM: p139adGroundHardCeilingM,
            physicalZClaim: false,
            samePipeClaim: false,
            topologyLinkClaim: false,
            currentClaim: false,
            asBuiltClaim: false,
            verticalDatumStatus: 'OPEN_UNVERIFIED',
          };
          workZGroup.add(line);
        }

        workZGroup.userData = {
          Canonical: false,
          ModelStage: 'WORK_TEST_VIEW',
          reviewScope: 'LOCUS_WORK_Z_ASSUMPTIONS',
          routeCount: p139adLocusWorkZRoutes.length,
          verticalReferenceElevationM: p139acVerticalReferenceM,
          undergroundHardCeilingM: p139adGroundHardCeilingM,
          sourceXYMutation: false,
          sourceZMutation: false,
          physicalZClaim: false,
          currentClaim: false,
          asBuiltClaim: false,
        };
        composite.add(workZGroup);
        composite.userData = {
          ...composite.userData,
          reviewScope: 'GROUND_PLUS_SOURCE_Z_PLUS_LOCUS_WORK_Z',
          locusWorkZRouteCount: p139adLocusWorkZRoutes.length,
          locusWorkZMaxElevationM: Math.max(
            ...p139adLocusWorkZRoutes.flatMap((route) => route.points.map((point) => point[2])),
          ),
          locusWorkZAssumptionsRefinable: true,
        };
        return composite;
      };

      const loadWorkTestCandidate = async (candidate: WorkTestCandidate) => {
        const loader = new GLTFLoader();
        status.textContent = 'Avataan WORK_TEST-kandidaattia...';

        try {
          const gltf = await loader.loadAsync(candidate.path);
          const isP139nReview = candidate.id === p139nCandidateId;
          const isP139abZReview = candidate.id === p139abCandidateId;
          const isP139acGroundInfraReview =
            isP139abZReview && isP139acGroundInfraReviewRequested();
          const isP139adLocusWorkZReview =
            isP139abZReview && isP139adLocusWorkZReviewRequested();

          if (isP139nReview) {
            const planScene = findSourceNamedScene(gltf, p139nPlanSceneName);
            if (!planScene) throw new Error('p139N SITE_PLAN_OVERLAY scene missing');
            gltf.scene = planScene;
          } else if (isP139abZReview) {
            const zScene = findSourceNamedScene(gltf, p139abZSceneName);
            if (!zScene) throw new Error('p139AB Z credibility scene missing');
            gltf.scene = isP139adLocusWorkZReview
              ? await buildP139adLocusWorkZReviewScene(gltf, zScene)
              : isP139acGroundInfraReview
                ? await buildP139acGroundInfraReviewScene(gltf, zScene)
                : await buildP139abVisibleReviewScene(gltf, zScene);
          }

          applyLoadedModel(gltf, 'work-test', `WORK_TEST: ${candidate.label}`);
          locusLayerLabel.textContent = isP139nReview
            ? 'Kunnallistekniikka / KVV-reitit (WORK_TEST)'
            : isP139adLocusWorkZReview
              ? 'Locus work-Z + maanpinta + source-Z referenssi'
              : isP139acGroundInfraReview
                ? 'Maanpinta + Z-lähteistetty maanalainen infra'
                : isP139abZReview
                  ? 'Z-review: vain Z-lähteistetty jätevesi'
                  : 'Locus kunnallistekniikka (WORK_TEST)';

          if (isP139nReview) {
            canvas.dataset.workTestReviewMode = 'site-plan-only';
            activateSitePlanOnly();
            status.textContent = 'SITE ORTHO / PLAN ONLY - Z UNKNOWN / NOT AS-BUILT';
          } else if (isP139abZReview) {
            canvas.dataset.workTestReviewMode = isP139adLocusWorkZReview
              ? 'locus-work-z-review'
              : isP139acGroundInfraReview
                ? 'ground-infra-review'
                : 'z-credibility-only';
            canvas.dataset.p139abBuildingRenderableCount = String(
              gltf.scene?.userData?.buildingRenderableCount ?? 0,
            );
            canvas.dataset.p139abSourceZRenderableCount = String(
              gltf.scene?.userData?.sourceZRenderableCount ?? 0,
            );
            if (isP139adLocusWorkZReview) {
              canvas.dataset.locusWorkZRouteCount = String(p139adLocusWorkZRoutes.length);
              canvas.dataset.locusWorkZMaxElevation = '18.150';
            } else {
              delete canvas.dataset.locusWorkZRouteCount;
              delete canvas.dataset.locusWorkZMaxElevation;
            }
            activateIsometric();
            status.textContent = isP139adLocusWorkZReview
              ? 'LOCUS WORK-Z - 4 reittiä oletuskoroilla - max +18,15 < maanpintaraja +18,30 - ei as-built'
              : isP139acGroundInfraReview
                ? 'MAANPINTA + INFRA - alin maanpinta +18,30 - vain Z-lähteistetty maanalainen infra - ei as-built'
                : 'Z-KATSELU - vain lähteistetyt jätevesikorkeudet - datum sitomatta / ei as-built';
          } else {
            delete canvas.dataset.workTestReviewMode;
            delete canvas.dataset.locusWorkZRouteCount;
            delete canvas.dataset.locusWorkZMaxElevation;
            delete canvas.dataset.p139abBuildingRenderableCount;
            delete canvas.dataset.p139abSourceZRenderableCount;
          }
        } catch (error) {
          console.error(error);
          delete canvas.dataset.workTestReviewMode;
          status.textContent = 'WORK_TEST-kandidaattia ei voitu avata';
        }
      };

      const readWorkTestImportIntent = () => {
        if (!window.location.hash.startsWith('#')) return null;
        const params = new URLSearchParams(window.location.hash.slice(1));
        const sourceUrl = params.get(workTestImportFragmentKey);
        const candidateId = params.get(workTestCandidateFragmentKey);
        if (
          !sourceUrl ||
          sourceUrl.length > 5000 ||
          !candidateId ||
          !/^[a-z0-9-]+$/.test(candidateId)
        ) {
          return null;
        }

        return { candidateId, sourceUrl };
      };

      const clearWorkTestImportFragment = () => {
        if (!window.location.hash) return;
        window.history.replaceState(
          null,
          '',
          `${window.location.pathname}${window.location.search}`,
        );
      };

      const importWorkTestCandidateFromFragment = async () => {
        const intent = readWorkTestImportIntent();
        if (!intent) return false;

        clearWorkTestImportFragment();
        canvas.dataset.workTestImport = 'loading';
        status.textContent = 'Valmistellaan suojattua WORK_TEST-kandidaattia...';

        try {
          const response = await fetch(workTestImportPath, {
            method: 'POST',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
            },
            cache: 'no-store',
            body: JSON.stringify(intent),
          });
          if (!response.ok) throw new Error(`WORK_TEST import HTTP ${response.status}`);

          const payload = (await response.json()) as {
            candidate?: unknown;
            ready?: unknown;
          };
          if (!isWorkTestCandidate(payload.candidate) || payload.ready !== true) {
            throw new Error('WORK_TEST import response invalid');
          }
          if (payload.candidate.id !== intent.candidateId) {
            throw new Error('WORK_TEST import candidate mismatch');
          }

          await loadWorkTestCatalog();
          const candidate = workTestCandidates.get(intent.candidateId);
          if (!candidate) throw new Error('WORK_TEST candidate missing after import');

          workTestSelect.value = candidate.id;
          workTestButton.disabled = false;
          canvas.dataset.workTestImport = 'ready';
          await loadWorkTestCandidate(candidate);
          return true;
        } catch (error) {
          console.error(error);
          canvas.dataset.workTestImport = 'failed';
          status.textContent = 'WORK_TEST-kandidaatin valmistelu epäonnistui';
          await loadWorkTestCatalog();
          return false;
        }
      };

      fitButton.addEventListener('click', fitModel);
      orbitButton.addEventListener('click', fitModel);
      topButton.addEventListener('click', () => axisView('top'));
      bottomButton.addEventListener('click', () => axisView('bottom'));
      isoButton.addEventListener('click', activateIsometric);
      elevPosYButton.addEventListener('click', () => activateElevationView('pos-y'));
      elevNegYButton.addEventListener('click', () => activateElevationView('neg-y'));
      elevPosXButton.addEventListener('click', () => activateElevationView('pos-x'));
      elevNegXButton.addEventListener('click', () => activateElevationView('neg-x'));
      d1PlanButton.addEventListener('click', () => activateDPlan('1F'));
      d2PlanButton.addEventListener('click', () => activateDPlan('2F'));
      workTestSelect.addEventListener('change', () => {
        workTestButton.disabled = !workTestCandidates.has(workTestSelect.value);
      });
      workTestButton.addEventListener('click', () => {
        const candidate = workTestCandidates.get(workTestSelect.value);
        if (!candidate) {
          status.textContent = 'Valitse WORK_TEST-kandidaatti';
          return;
        }
        void loadWorkTestCandidate(candidate);
      });
      currentModelButton.addEventListener('click', () => {
        void loadCurrentModel();
      });
      layersButton.addEventListener('click', () => setLayersPanelOpen(layersPanel.hidden));
      closeLayersButton.addEventListener('click', () => setLayersPanelOpen(false));
      roofLayerVisibleInput.addEventListener('change', () => {
        roofLayerVisible = roofLayerVisibleInput.checked;
        applyRoofLayerState();
        if (selectedObject && !isEffectivelyVisible(selectedObject)) clearSelection();
      });
      roofLayerOpacityInput.addEventListener('input', () => {
        roofLayerOpacity = Math.max(0, Math.min(1, Number(roofLayerOpacityInput.value) / 100));
        if (selectedObject && roofLayerMeshes.has(selectedObject) && roofLayerOpacity <= 0.01) clearSelection();
        applyRoofLayerState();
      });
      locusLayerVisibleInput.addEventListener('change', () => {
        locusLayerVisible = locusLayerVisibleInput.checked;
        applyLocusLayerState();
      });
      clearSelectionButton.addEventListener('click', clearSelection);

      canvas.addEventListener('pointermove', (event) => {
        if (activePlanFloor) updateDCoordinatePointer(event.clientX, event.clientY);
      });

      canvas.addEventListener('pointerdown', (event) => {
        pointerDown = { pointerId: event.pointerId, x: event.clientX, y: event.clientY };
      });

      canvas.addEventListener('pointerup', (event) => {
        if (!pointerDown || pointerDown.pointerId !== event.pointerId) return;

        const distance = Math.hypot(event.clientX - pointerDown.x, event.clientY - pointerDown.y);
        pointerDown = null;
        if (distance <= pickDragThresholdPx) {
          if (activePlanFloor) setDCoordinateAnchor(event.clientX, event.clientY);
          selectAtClientPoint(event.clientX, event.clientY);
        }
      });

      canvas.addEventListener('pointercancel', () => {
        pointerDown = null;
      });

      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') clearSelection();
      });

      const resizeObserver = new ResizeObserver(updateSize);
      resizeObserver.observe(canvas.parentElement ?? canvas);

      renderer.setAnimationLoop(() => {
        updateSize();
        controls.update();
        planControls.update();
        isoControls.update();
        selectionHelper?.update?.();
        updateD1KnownDoorReviewLabelPositions();
        updateHeightScale();
        renderer.render(scene, activeCamera);
      });

      void (async () => {
        await loadCurrentModel();
        const imported = await importWorkTestCandidateFromFragment();
        if (!imported) await loadWorkTestCatalog();
      })();
    </script>
  </body>
</html>
