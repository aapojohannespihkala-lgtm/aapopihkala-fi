      const populateInfraProfileRoutes = () => {
        const previous = profileRouteSelect.value;
        profileRouteSelect.replaceChildren();
        for (const route of p139adLocusWorkZRoutes) {
          const option = document.createElement('option');
          option.value = route.name;
