      const isTrustedWorkTestBrowserSourceUrl = (value: string, requireSignature = true) => {
        try {
          const url = new URL(value);
          return (
            url.protocol === 'https:' &&
            !url.username &&
            !url.password &&
            !url.port &&
            url.hostname.endsWith('.oaiusercontent.com') &&
            url.pathname.startsWith('/files/') &&
            url.pathname.endsWith('/raw') &&
            (!requireSignature || (url.searchParams.has('sig') && url.searchParams.has('se'))) &&
            !url.hash
          );
        } catch {
          return false;
        }
      };

      const readWorkTestImportIntent = () => {
        if (!window.location.hash.startsWith('#')) return null;
        const params = new URLSearchParams(window.location.hash.slice(1));
        const sourceUrl = params.get(workTestImportFragmentKey);
        const candidateId = params.get(workTestCandidateFragmentKey);
        if (
          !sourceUrl ||
          sourceUrl.length > 5000 ||
          !isTrustedWorkTestBrowserSourceUrl(sourceUrl) ||
          !candidateId ||
          !/^[a-z0-9-]+$/.test(candidateId)
        ) {
          return null;
        }

        return { candidateId, sourceUrl };
      };

      const clearWorkTestImportFragment = () => {
        if (!window.location.hash) return;
        window.history.replaceState(
          null,
          '',
          `${window.location.pathname}${window.location.search}`,
        );
      };

      const relayWorkTestCandidateFromSource = async (intent: {
        candidateId: string;
        sourceUrl: string;
      }) => {
        if (!isTrustedWorkTestBrowserSourceUrl(intent.sourceUrl)) return false;

        canvas.dataset.workTestRelay = 'loading';
        delete canvas.dataset.workTestRelayError;
        status.textContent = 'Valmistellaan WORK_TEST-kandidaattia automaattisesti...';
        let relayPhase: 'source' | 'upload' | 'catalog' = 'source';
        let relayErrorCode: string | null = null;

        try {
          const sourceResponse = await fetchWorkTestWithTimeout(
            intent.sourceUrl,
            {
              headers: {
                Accept: 'model/gltf-binary, application/octet-stream;q=0.9, */*;q=0.1',
              },
              cache: 'no-store',
              credentials: 'omit',
              referrerPolicy: 'no-referrer',
            },
            workTestRelaySourceTimeoutMs,
          );
          if (
            !sourceResponse.ok ||
            !sourceResponse.url ||
            !isTrustedWorkTestBrowserSourceUrl(sourceResponse.url, false)
          ) {
            relayErrorCode = `relay-source-http-${sourceResponse.status}`;
            throw new Error(`WORK_TEST browser source HTTP ${sourceResponse.status}`);
          }

          relayPhase = 'upload';
          const bytes = await sourceResponse.arrayBuffer();
          const uploadResponse = await fetchWorkTestWithTimeout(
            `${workTestUploadPrefix}${encodeURIComponent(intent.candidateId)}.glb`,
            {
              method: 'PUT',
              headers: {
                Accept: 'application/json',
                'Content-Type': 'model/gltf-binary',
              },
              cache: 'no-store',
              body: bytes,
            },
            workTestRelayUploadTimeoutMs,
          );
          if (!uploadResponse.ok) {
            relayErrorCode = `relay-upload-http-${uploadResponse.status}`;
            throw new Error(`WORK_TEST relay upload HTTP ${uploadResponse.status}`);
          }

          const payload = (await uploadResponse.json()) as {
            candidate?: unknown;
            ready?: unknown;
          };
          if (!isWorkTestCandidate(payload.candidate) || payload.ready !== true) {
            relayErrorCode = 'relay-upload-response-invalid';
            throw new Error('WORK_TEST relay upload response invalid');
          }
          if (payload.candidate.id !== intent.candidateId) {
            relayErrorCode = 'relay-upload-candidate-mismatch';
            throw new Error('WORK_TEST relay upload candidate mismatch');
          }

          relayPhase = 'catalog';
          await loadWorkTestCatalog();
          const candidate = workTestCandidates.get(intent.candidateId);
          if (!candidate) {
            relayErrorCode = 'relay-catalog-missing';
            throw new Error('WORK_TEST candidate missing after browser relay');
          }

          workTestSelect.value = candidate.id;
          workTestButton.disabled = false;
          setWorkTestUploadFallback(null);
          canvas.dataset.workTestRelay = 'ready';
          delete canvas.dataset.workTestRelayError;
          canvas.dataset.workTestImport = 'ready';
          await loadWorkTestCandidate(candidate);
          return true;
        } catch (error) {
          console.error(error);
          const timeoutCode =
            error instanceof Error && error.name === 'TimeoutError'
              ? `relay-${relayPhase}-timeout`
              : null;
          canvas.dataset.workTestRelay = 'failed';
          canvas.dataset.workTestRelayError =
            relayErrorCode ?? timeoutCode ?? `relay-${relayPhase}-failed`;
          return false;
        }
      };

      const uploadWorkTestCandidateFile = async (file: File) => {
        const candidateId =
          workTestUploadButton.dataset.candidateId ?? getRequestedReviewCandidateId();
        if (!candidateId || !/^[a-z0-9-]+$/.test(candidateId)) {
          status.textContent = 'WORK_TEST-kandidaattia ei tunnistettu';
          return false;
        }

        workTestUploadButton.disabled = true;
        canvas.dataset.workTestUpload = 'loading';
        status.textContent = 'Tarkistetaan ja tallennetaan WORK_TEST-tiedostoa...';

        try {
          const response = await fetch(
            `${workTestUploadPrefix}${encodeURIComponent(candidateId)}.glb`,
            {
              method: 'PUT',
              headers: {
                Accept: 'application/json',
                'Content-Type': 'model/gltf-binary',
              },
              cache: 'no-store',
              body: file,
            },
          );
          if (!response.ok) throw new Error(`WORK_TEST upload HTTP ${response.status}`);

          const payload = (await response.json()) as {
            candidate?: unknown;
            ready?: unknown;
          };
          if (!isWorkTestCandidate(payload.candidate) || payload.ready !== true) {
            throw new Error('WORK_TEST upload response invalid');
          }
          if (payload.candidate.id !== candidateId) {
            throw new Error('WORK_TEST upload candidate mismatch');
          }

          await loadWorkTestCatalog();
          const candidate = workTestCandidates.get(candidateId);
          if (!candidate) throw new Error('WORK_TEST candidate missing after upload');

          workTestSelect.value = candidate.id;
          workTestButton.disabled = false;
          setWorkTestUploadFallback(null);
          canvas.dataset.workTestUpload = 'ready';
          await loadWorkTestCandidate(candidate);
          return true;
        } catch (error) {
          console.error(error);
          canvas.dataset.workTestUpload = 'failed';
          setWorkTestUploadFallback(candidateId);
          status.textContent =
            'Tiedosto ei kelvannut tähän WORK_TEST-kandidaattiin tai tallennus epäonnistui';
          return false;
        } finally {
          workTestUploadInput.value = '';
          if (!workTestUploadButton.hidden) workTestUploadButton.disabled = false;
        }
      };

      const importWorkTestCandidateFromFragment = async () => {
        const intent = readWorkTestImportIntent();
        if (!intent) return false;

        clearWorkTestImportFragment();
        canvas.dataset.workTestImport = 'loading';
        status.textContent = 'Valmistellaan suojattua WORK_TEST-kandidaattia...';

        try {
          const response = await fetchWorkTestWithTimeout(
            workTestImportPath,
            {
              method: 'POST',
              headers: {
                Accept: 'application/json',
                'Content-Type': 'application/json',
              },
              cache: 'no-store',
              body: JSON.stringify(intent),
            },
            workTestServerImportTimeoutMs,
          );
          if (!response.ok) {
            let importError = `http-${response.status}`;
            try {
              const errorPayload = (await response.json()) as { error?: unknown };
              if (typeof errorPayload.error === 'string' && errorPayload.error) {
                importError = errorPayload.error;
              }
            } catch {
              // Keep the HTTP fallback code when the private response body is unavailable.
            }
            canvas.dataset.workTestImportError = importError;
            throw new Error(`WORK_TEST import ${importError}`);
          }

          delete canvas.dataset.workTestImportError;
          const payload = (await response.json()) as {
            candidate?: unknown;
            ready?: unknown;
            pending?: unknown;
          };
          if (!isWorkTestCandidate(payload.candidate)) {
            throw new Error('WORK_TEST import response invalid');
          }
          if (payload.candidate.id !== intent.candidateId) {
            throw new Error('WORK_TEST import candidate mismatch');
          }

          let candidate: WorkTestCandidate | null = null;
          if (payload.ready === true) {
            await loadWorkTestCatalog();
            candidate = workTestCandidates.get(intent.candidateId) ?? null;
          } else if (payload.pending === true) {
            canvas.dataset.workTestImport = 'pending';
            status.textContent = 'Valmistellaan WORK_TEST-kandidaattia palvelimella...';
            candidate = await waitForWorkTestCandidate(intent.candidateId);
          } else {
            throw new Error('WORK_TEST import response invalid');
          }

          if (!candidate) throw new Error('WORK_TEST candidate missing after import');

          workTestSelect.value = candidate.id;
          workTestButton.disabled = false;
          canvas.dataset.workTestImport = 'ready';
          await loadWorkTestCandidate(candidate);
          return true;
        } catch (error) {
          console.error(error);
          if (!canvas.dataset.workTestImportError) {
            canvas.dataset.workTestImportError =
              error instanceof Error && error.name === 'TimeoutError'
                ? 'client-import-timeout'
                : 'client-import-failed';
          }
          const relayed = await relayWorkTestCandidateFromSource(intent);
          if (relayed) return true;

          canvas.dataset.workTestImport = 'failed';
          await loadWorkTestCatalog();
          if (!workTestCandidates.has(intent.candidateId)) {
            setWorkTestUploadFallback(intent.candidateId);
            const importError = canvas.dataset.workTestImportError;
            const relayError = canvas.dataset.workTestRelayError;
            status.textContent = relayError
              ? `WORK_TEST-julkaisu epäonnistui (server: ${importError}; relay: ${relayError})`
              : `WORK_TEST-julkaisu epäonnistui palvelimella (${importError})`;
          }
          return false;
        }
      };

      const toggleModelComparison = async () => {
        const candidate = workTestCandidates.get(workTestSelect.value);
        if (!candidate) {
          status.textContent = 'Valitse WORK_TEST-kandidaatti vertailua varten';
          return;
        }

        const snapshot = captureComparisonView();
        const targetKind: ModelSourceKind =
          activeModelSourceKind === 'work-test' ? 'current' : 'work-test';

        canvas.dataset.modelComparison = 'switching';
        canvas.dataset.modelComparisonCandidate = candidate.id;

        if (targetKind === 'current') {
          await loadCurrentModel();
        } else {
          await loadWorkTestCandidate(candidate);
        }

        if (activeModelSourceKind !== targetKind) {
          clearModelComparisonState();
          return;
        }

        restoreComparisonView(snapshot);
        canvas.dataset.modelComparison = 'active';
        canvas.dataset.modelComparisonCandidate = candidate.id;
        updateModelComparisonControls();
        status.textContent =
          targetKind === 'work-test'
            ? `A/B-vertailu: WORK_TEST - ${candidate.label}`
            : 'A/B-vertailu: CURRENT';
      };

      layersButton.addEventListener('click', () => closeToolbarMenus());
      fitButton.addEventListener('click', fitModel);
      resetViewDefaultsButton.addEventListener('click', resetActiveViewDefaults);
      wholeBuildingPresetButton.addEventListener('click', () => applyStandardViewPreset('whole-building'));
      dOverviewPresetButton.addEventListener('click', () => applyStandardViewPreset('d-apartment'));
      sitePresetButton.addEventListener('click', () => applyStandardViewPreset('site'));
      infraPresetButton.addEventListener('click', () => applyStandardViewPreset('infra'));
      drainagePresetButton.addEventListener('click', applyDrainageResearchPreset);
      electricalPresetButton.addEventListener('click', applyElectricalResearchPreset);
      orbitButton.addEventListener('click', fitModel);
      topButton.addEventListener('click', () => applyStandardViewPreset('top'));
      bottomButton.addEventListener('click', () => axisView('bottom'));
      isoButton.addEventListener('click', activateIsometric);
      elevPosYButton.addEventListener('click', () => applyStandardViewPreset('elev-pos-y'));
      elevNegYButton.addEventListener('click', () => applyStandardViewPreset('elev-neg-y'));
      elevPosXButton.addEventListener('click', () => applyStandardViewPreset('elev-pos-x'));
      elevNegXButton.addEventListener('click', () => applyStandardViewPreset('elev-neg-x'));
      d1PlanButton.addEventListener('click', () => applyStandardViewPreset('d-1f'));
      d2PlanButton.addEventListener('click', () => applyStandardViewPreset('d-2f'));
      workTestSelect.addEventListener('change', () => {
        workTestButton.disabled = !workTestCandidates.has(workTestSelect.value);
        clearModelComparisonState();
      });
      workTestButton.addEventListener('click', () => {
        const candidate = workTestCandidates.get(workTestSelect.value);
        if (!candidate) {
          status.textContent = 'Valitse WORK_TEST-kandidaatti';
          return;
        }
        clearModelComparisonState();
        void loadWorkTestCandidate(candidate);
      });
      compareModelButton.addEventListener('click', () => {
        void toggleModelComparison();
      });
      workTestUploadButton.addEventListener('click', () => {
        workTestUploadInput.value = '';
        workTestUploadInput.click();
      });
      workTestUploadInput.addEventListener('change', () => {
        const file = workTestUploadInput.files?.[0];
        if (!file) return;
        void uploadWorkTestCandidateFile(file);
      });
      currentModelButton.addEventListener('click', () => {
        clearModelComparisonState();
        void loadCurrentModel();
      });
      layersButton.addEventListener('click', () => setLayersPanelOpen(layersPanel.hidden));
      closeLayersButton.addEventListener('click', () => setLayersPanelOpen(false, true));
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || event.defaultPrevented || layersPanel.hidden) return;
        event.preventDefault();
        setLayersPanelOpen(false, true);
      });
      edgeModeSelect.addEventListener('change', () => {
        const requestedMode = edgeModeSelect.value as EdgeMode;
        if (!['none', 'object', 'unified', 'visible'].includes(requestedMode)) return;
        applyViewerLayerState({ edgeMode: requestedMode }, 'manual');
      });
      profileButton.addEventListener('click', () => setProfilePanelOpen(profilePanel.hidden));
      closeProfileButton.addEventListener('click', () => setProfilePanelOpen(false));
      profileRouteSelect.addEventListener('change', renderSelectedInfraProfile);
      roofLayerVisibleInput.addEventListener('change', () => {
        applyViewerLayerState({ roofVisible: roofLayerVisibleInput.checked }, 'manual');
        if (selectedObject && !isEffectivelyVisible(selectedObject, modelRoot)) clearSelection();
      });
      roofLayerOpacityInput.addEventListener('input', () => {
        const requestedOpacity = Math.max(
          0,
          Math.min(1, Number(roofLayerOpacityInput.value) / 100),
        );
        applyViewerLayerState({ roofOpacity: requestedOpacity }, 'manual');
        if (selectedObject && roofLayerMeshes.has(selectedObject) && roofLayerOpacity <= 0.01) {
          clearSelection();
        }
      });
      locusLayerVisibleInput.addEventListener('change', () => {
        const requestedVisible = locusLayerVisibleInput.checked;
        if (isP161SystemsLayerReviewRequested()) {
          if (p161KvvObjects.size > 0) p161KvvVisible = requestedVisible;
          if (p161IvPlanObjects.size > 0) p161IvPlanVisible = requestedVisible;
          if (p161IvSectionObjects.size > 0) p161IvSectionVisible = requestedVisible;
        } else {
          if (locusWaterObjects.size > 0) locusWaterVisible = requestedVisible;
          if (locusWastewaterObjects.size > 0) locusWastewaterVisible = requestedVisible;
        }
        applyViewerLayerState({ locusVisible: requestedVisible }, 'manual');
      });
      locusWaterVisibleInput.addEventListener('change', () => {
        locusWaterVisible = locusWaterVisibleInput.checked;
        locusLayerVisible =
          locusWaterVisible ||
          (locusWastewaterObjects.size > 0 && locusWastewaterVisible);
        applyLocusLayerState();
        refreshEdgeRendering(modelRoot.children[0] ?? null);
        canvas.dataset.layerStateSource = 'manual';
        canvas.dataset.layerLocusVisible = locusLayerVisible ? 'true' : 'false';
        standardViewLayerDefaultsInitialized = true;
      });
      locusWastewaterVisibleInput.addEventListener('change', () => {
        locusWastewaterVisible = locusWastewaterVisibleInput.checked;
        locusLayerVisible =
          locusWastewaterVisible ||
          (locusWaterObjects.size > 0 && locusWaterVisible);
        applyLocusLayerState();
        refreshEdgeRendering(modelRoot.children[0] ?? null);
        canvas.dataset.layerStateSource = 'manual';
        canvas.dataset.layerLocusVisible = locusLayerVisible ? 'true' : 'false';
        standardViewLayerDefaultsInitialized = true;
      });

      const applyP161ChildLayerChange = () => {
        locusLayerVisible =
          (p161KvvObjects.size > 0 && p161KvvVisible) ||
          (p161IvPlanObjects.size > 0 && p161IvPlanVisible) ||
          (p161IvSectionObjects.size > 0 && p161IvSectionVisible);
        applyLocusLayerState();
        refreshEdgeRendering(modelRoot.children[0] ?? null);
        canvas.dataset.layerStateSource = 'manual';
        canvas.dataset.layerLocusVisible = locusLayerVisible ? 'true' : 'false';
        standardViewLayerDefaultsInitialized = true;
      };

      p161KvvVisibleInput.addEventListener('change', () => {
        p161KvvVisible = p161KvvVisibleInput.checked;
        applyP161ChildLayerChange();
      });
      p161IvPlanVisibleInput.addEventListener('change', () => {
        p161IvPlanVisible = p161IvPlanVisibleInput.checked;
        applyP161ChildLayerChange();
      });
      p161IvSectionVisibleInput.addEventListener('change', () => {
        p161IvSectionVisible = p161IvSectionVisibleInput.checked;
        applyP161ChildLayerChange();
      });
      electricalLayerVisibleInput.addEventListener('change', () => {
        electricalLayerVisible = electricalLayerVisibleInput.checked;
        applyElectricalLayerState();
        refreshEdgeRendering(modelRoot.children[0] ?? null);
        canvas.dataset.layerStateSource = 'manual';
        standardViewLayerDefaultsInitialized = true;
      });
      navigateToolButton.addEventListener('click', () => setViewerToolMode('navigate'));
      selectionToolButton.addEventListener('click', () => setViewerToolMode('select'));
      clearSelectionButton.addEventListener('click', clearSelection);
      isolateSelectionButton.addEventListener('click', isolateSelectedObject);
      hideSelectionButton.addEventListener('click', hideSelectedObject);
      showAllObjectsButton.addEventListener('click', restoreObjectVisibility);
      clipPlaneEnabledInput.addEventListener('change', setHorizontalClippingState);
      clipPlaneHeightInput.addEventListener('input', setHorizontalClippingState);

      canvas.addEventListener('pointermove', (event) => {
        if (activePlanFloor) updateDCoordinatePointer(event.clientX, event.clientY);
      });

      canvas.addEventListener('pointerdown', (event) => {
        pointerDown = { pointerId: event.pointerId, x: event.clientX, y: event.clientY };
      });

      canvas.addEventListener('pointerup', (event) => {
        if (!pointerDown || pointerDown.pointerId !== event.pointerId) return;

        const distance = Math.hypot(event.clientX - pointerDown.x, event.clientY - pointerDown.y);
        pointerDown = null;
        if (distance <= pickDragThresholdPx) {
          if (activePlanFloor) setDCoordinateAnchor(event.clientX, event.clientY);
          selectAtClientPoint(event.clientX, event.clientY);
        }
      });

      canvas.addEventListener('pointercancel', () => {
        pointerDown = null;
      });

      window.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        if (!profilePanel.hidden) setProfilePanelOpen(false);
        else clearSelection();
      });

      const resizeObserver = new ResizeObserver(updateSize);
      resizeObserver.observe(canvas.parentElement ?? canvas);

      renderer.setAnimationLoop(() => {
        updateSize();
        controls.update();
        planControls.update();
        isoControls.update();
        selectionHighlightController.update();
        updateD1KnownDoorReviewLabelPositions();
        updateHeightScale();
        orientationGizmoController.render({
          quaternion: activeCamera.quaternion,
          projection: (activeCamera as any).isOrthographicCamera === true ? 'orthographic' : 'perspective',
        });
        renderer.render(scene, activeCamera);
      });

      void (async () => {
        await loadCurrentModel();
        const imported = await importWorkTestCandidateFromFragment();
        if (imported) return;

        await loadWorkTestCatalog();
        const reviewCandidateId = getRequestedReviewCandidateId();
        const reviewCandidate = reviewCandidateId
          ? workTestCandidates.get(reviewCandidateId)
          : null;
        if (reviewCandidate) {
          await loadWorkTestCandidate(reviewCandidate);
          canvas.dataset.workTestReviewAutoload = 'true';
        } else {
          delete canvas.dataset.workTestReviewAutoload;
          if (reviewCandidateId) {
            setWorkTestUploadFallback(reviewCandidateId);
            if (canvas.dataset.workTestImport !== 'failed') {
              status.textContent =
                'WORK_TEST ei ole palvelinpuolen katalogissa - tekninen julkaisu on kesken';
            }
          }
        }
      })();
    </script>
  </body>
</html>
