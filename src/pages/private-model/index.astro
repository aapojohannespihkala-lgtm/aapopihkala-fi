      const dReviewEmphasisMeshes = new Set<any>();
      const dReviewContextMeshes = new Set<any>();
      const dReviewDoorMarkerLines = new Set<any>();
      const d1KnownDoorReviewItems = [
        { number: 1, id: 'G2_DOOR_EXT_D_1F_S_001', name: 'Etelä - ulko-ovi' },
        { number: 2, id: 'G2_DOOR_EXT_D_1F_N_001', name: 'Pohjoinen - ulko-ovi' },
        { number: 3, id: 'G2_DOOR_INT_D_1F_VH_WEST_2015_001', name: 'VH WEST' },
        { number: 4, id: 'G2_DOOR_INT_D_1F_WC_001', name: 'WC' },
        { number: 5, id: 'G2_DOOR_INT_D_1F_SAUNA_PESUH_2015_001', name: 'SAUNA-PESUH' },
        { number: 6, id: 'G2_DOOR_INT_D_1F_VH_NORTH_2015_001', name: 'VH NORTH' },
        { number: 7, id: 'G2_DOOR_INT_D_1F_VARASTO_2015_001', name: 'VARASTO' },
      ] as const;
      const d1UserDoorReviewItems = [
        { label: 'A', id: 'D1F_USER_CURRENT_DOOR_A', name: 'Nykytilaovi A' },
        { label: 'B', id: 'D1F_USER_CURRENT_DOOR_B', name: 'Nykytilaovi B' },
      ] as const;
      const d1KnownDoorLabelBindings: Array<{ element: HTMLElement; marker: any }> = [];
      const d1UserDoorLabelBindings: Array<{ element: HTMLElement; marker: any }> = [];
      const dReviewMaterialBaseline = new Map<
        any,
        { opacity: number; transparent: boolean; depthWrite: boolean }
      >();
      let d2FBoundaryReviewContext: any = null;
      const dCoordinateGridGroup = new THREE.Group();
      dCoordinateGridGroup.name = 'P137E_D_PLAN_YLIS_G1_LOCAL_GRID';
      dCoordinateGridGroup.visible = false;
      scene.add(dCoordinateGridGroup);
      const dCoordinateEnvelope = Object.freeze({
        xMin: 0,
        xMax: 6.375,
        yMin: 0,
