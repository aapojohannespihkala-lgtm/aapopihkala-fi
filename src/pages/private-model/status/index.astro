---
const title = 'Ylisrinne AI - tilanne';
---
<!doctype html>
<html lang="fi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>{title}</title>
    <style>
      :root {
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #172033;
        background: #f5f7fa;
      }
      * { box-sizing: border-box; }
      body { margin: 0; }
      main { width: min(1100px, calc(100% - 32px)); margin: 32px auto 64px; }
      h1 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.7rem); }
      h2 { margin: 0 0 12px; font-size: 1.15rem; }
      p { line-height: 1.5; }
      .muted { color: #657086; }
      .summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin: 24px 0;
      }
      .metric, .panel, .work {
        background: #fff;
        border: 1px solid #dfe4ea;
        border-radius: 10px;
      }
      .metric { padding: 16px; }
      .metric strong { display: block; font-size: 1.8rem; margin-top: 4px; }
      .journeys { margin: 24px 0 16px; }
      .journeys-note { margin: 0; font-size: .9rem; }
      .journey-list { display: grid; gap: 12px; margin-top: 14px; }
      .journey-card {
        padding: 16px;
        border: 1px solid #dfe4ea;
        border-radius: 10px;
        background: #fbfcfe;
      }
      .journey-card.human { border-color: #e7c99d; background: #fffaf2; }
      .journey-head {
        display: flex;
        gap: 12px;
        justify-content: space-between;
        align-items: start;
      }
      .journey-card h3 { margin: 0; font-size: 1.02rem; line-height: 1.35; }
      .journey-track {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 6px;
        margin: 14px 0 12px;
      }
      .journey-step {
        min-width: 0;
        padding: 8px 9px;
        border: 1px solid #e4e8ee;
        border-radius: 7px;
        background: #f7f9fb;
      }
      .journey-step.before { opacity: .7; }
      .journey-step.current { border-color: #9fb2cf; background: #edf3fb; }
      .journey-step.after { color: #7b8494; background: #fafbfc; }
      .journey-step-number {
        display: block;
        margin-bottom: 6px;
        color: #7b8494;
        font-size: .66rem;
        font-weight: 700;
        letter-spacing: .07em;
      }
      .journey-step-label { display: block; font-size: .76rem; font-weight: 700; }
      .journey-now, .journey-work, .journey-remaining { margin: 6px 0 0; }
      .journey-now { font-weight: 700; }
      .journey-work { font-size: .9rem; }
      .journey-remaining { font-size: .86rem; color: #4f5b70; }
      .development { margin-bottom: 16px; }
      .development-note { margin: 0; font-size: .86rem; }
      .development-flow {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 8px;
        margin-top: 14px;
      }
      .development-stage {
        min-width: 0;
        padding: 11px 12px;
        border: 1px solid #dfe4ea;
        border-radius: 8px;
        background: #f8fafc;
      }
      .development-stage.active { border-color: #9fb2cf; background: #f1f5fb; }
      .development-stage.pass { border-color: #b9d7c1; background: #f3faf5; }
      .development-stage.human { border-color: #e7c99d; background: #fff8ee; }
      .stage-kicker {
        display: block;
        margin-bottom: 4px;
        color: #7b8494;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .08em;
      }
      .development-stage strong { display: block; font-size: .9rem; }
      .stage-state {
        display: block;
        margin-top: 6px;
        color: #657086;
        font-size: .69rem;
        font-weight: 700;
      }
      .development-tree {
        margin-top: 14px;
        border-top: 1px solid #e7ebf0;
      }
      .development-tree details { border-bottom: 1px solid #e7ebf0; }
      .development-tree summary {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 11px 0;
        cursor: pointer;
        list-style: none;
      }
      .development-tree summary::-webkit-details-marker { display: none; }
      .development-tree summary::before {
        content: "+";
        flex: 0 0 16px;
        color: #657086;
        font-weight: 700;
      }
      .development-tree details[open] summary::before { content: "-"; }
      .tree-label { min-width: 0; flex: 1 1 auto; font-weight: 700; }
      .tree-status {
        flex: 0 0 auto;
        color: #657086;
        font-size: .7rem;
        font-weight: 700;
      }
      .tree-status.active { color: #385d91; }
      .tree-status.pass { color: #267043; }
      .tree-status.human { color: #8f4a00; }
      .tree-branch { padding: 0 0 12px 28px; }
      .tree-item { padding: 9px 0; border-top: 1px solid #eef1f4; }
      .tree-item:first-child { border-top: 0; padding-top: 0; }
      .tree-item strong { font-size: .88rem; }
      .tree-item p { margin: 3px 0 0; font-size: .82rem; color: #657086; }
      .layout {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(280px, .8fr);
        gap: 16px;
        align-items: start;
      }
      .panel { padding: 18px; }
      .work { padding: 16px; margin-top: 10px; }
      .work:first-of-type { margin-top: 0; }
      .work-head { display: flex; gap: 12px; justify-content: space-between; align-items: start; }
      .work h3 { margin: 2px 0 8px; font-size: 1rem; }
      .badge {
        flex: 0 0 auto;
        display: inline-block;
        border-radius: 999px;
        padding: 4px 8px;
        font-size: .72rem;
        font-weight: 700;
        background: #e8eef8;
      }
      .badge.pass { background: #e4f4e9; color: #176234; }
      .badge.action { background: #fff0dc; color: #8f4a00; }
      .goal { margin: 0; }
      .meta { margin: 10px 0 0; font-size: .82rem; color: #657086; }
      .events { list-style: none; margin: 0; padding: 0; }
      .events li { padding: 10px 0; border-top: 1px solid #eef1f4; }
      .events li:first-child { border-top: 0; padding-top: 0; }
      .events time { display: block; font-size: .78rem; color: #657086; margin-bottom: 3px; }
      .events strong { font-size: .9rem; }
      .events p { margin: 3px 0 0; font-size: .85rem; color: #657086; }
      #human-action { margin-bottom: 16px; }
      #human-action[hidden] { display: none; }
      .error { color: #8f2600; }
      @media (max-width: 760px) {
        main { width: min(100% - 20px, 1100px); margin-top: 20px; }
        .summary { grid-template-columns: 1fr; }
        .journey-track { grid-template-columns: 1fr; }
        .development-flow { grid-template-columns: 1fr; }
        .layout { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>Ylisrinne AI - tilanne</h1>
        <p class="muted">Näet ensin, mitä konkreettisia asioita viedään kohti valmista. Tekniset työpaketit ja passit löytyvät alempaa. Lähdetieto pysyy Drivessä.</p>
        <p id="freshness" class="muted" aria-live="polite">Haetaan tilatietoa...</p>
      </header>

      <section class="panel journeys" aria-labelledby="journeys-title">
        <h2 id="journeys-title">Matkat kohti valmista</h2>
        <p class="muted journeys-note">Kortit johdetaan samoista aktiivisista työpaketeista. Korostettu vaihe kertoo, missä työ on juuri nyt. Tämä ei ole valmistumisprosentti.</p>
        <div id="journey-list">
          <p class="muted">Tavoiteketjuja ei ole vielä ladattu.</p>
        </div>
      </section>

      <section class="summary" aria-label="Tekninen yhteenveto">
        <div class="metric"><span>Aktiivisia työpaketteja</span><strong id="active-packages">-</strong></div>
        <div class="metric"><span>Aktiivisia linjoja</span><strong id="active-lines">-</strong></div>
        <div class="metric"><span>Valmistuneita passeja tänään</span><strong id="passes-today">-</strong></div>
      </section>

      <section class="panel development" aria-labelledby="development-title">
        <h2 id="development-title">Kehitysketju</h2>
        <p class="muted development-note">Johdettu samoista työpaketeista ja tapahtumista. Ei valmistumisprosentti. Vaiheet voivat edetä rinnakkain. PASS tarkoittaa viimeisintä teknistä onnistumista, ei koko vaiheen valmistumista.</p>
        <div id="development-flow" class="development-flow" role="list" aria-label="Kehityksen vaiheet">
          <p class="muted">Tilatietoa ei ole vielä ladattu.</p>
        </div>
        <div id="development-tree" class="development-tree">
          <p class="muted">Kehityspuuta ei ole vielä ladattu.</p>
        </div>
      </section>

      <div class="layout">
        <section class="panel">
          <h2>Nyt työn alla</h2>
          <div id="active-list"><p class="muted">Tilatietoa ei ole vielä ladattu.</p></div>
        </section>

        <aside>
          <section id="human-action" class="panel" hidden>
            <span class="badge action">SINULTA TARVITAAN</span>
            <h2 id="human-title" style="margin-top: 10px;">Ihmisen tehtävä</h2>
            <p id="human-detail"></p>
          </section>

          <section class="panel">
            <h2>Viimeisimmät tapahtumat</h2>
            <ol id="events" class="events"><li class="muted">Tilatietoa ei ole vielä ladattu.</li></ol>
          </section>
        </aside>
      </div>
    </main>

    <script src="/private-model/status.js" defer></script>
  </body>
</html>
