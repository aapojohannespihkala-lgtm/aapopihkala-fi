---
import '../../../styles/global.css';

import {
  getCollection,
  type CollectionEntry,
} from 'astro:content';

import FeedPost from '../../../components/FeedPost.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { getPostSlug } from '../../../utils/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  postNumber: string;
}

export async function getStaticPaths() {
  const posts = (
    await getCollection('posts')
  )
    .filter(
      (post) =>
        post.data.status === 'published' &&
        Boolean(post.data.publishedAt)
    )
    .sort((a, b) => {
      const aTime = new Date(
        a.data.publishedAt as string
      ).getTime();

      const bTime = new Date(
        b.data.publishedAt as string
      ).getTime();

      return bTime - aTime;
    });

  return posts.map(
    (post, index) => ({
      params: {
        id: getPostSlug(post.id),
      },

      props: {
        post,

        postNumber:
          String(
            posts.length - index
          ).padStart(
            2,
            '0'
          ),
      },
    })
  );
}

const {
  post,
  postNumber,
} = Astro.props as Props;

if (
  post.data.status !== 'published' ||
  !post.data.publishedAt
) {
  throw new Error(
    `Published article expected: ${post.id}`
  );
}

const publishedAt =
  post.data.publishedAt;

const localizedPost =
  post.data.en;

const slug =
  getPostSlug(post.id);

const dateFormatter =
  new Intl.DateTimeFormat(
    'en-GB',
    {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    }
  );

const datePart =
  publishedAt.slice(
    0,
    10
  );

const displayDate =
  dateFormatter.format(
    new Date(
      `${datePart}T12:00:00`
    )
  );

const canonicalUrl =
  `https://aapopihkala.fi/en/articles/${slug}/`;

const finnishUrl =
  `https://aapopihkala.fi/artikkelit/${slug}/`;

const imageUrl =
  post.data.graphic
    ? `https://aapopihkala.fi${post.data.graphic}`
    : undefined;

const blogPostingSchema = {
  '@context':
    'https://schema.org',

  '@type':
    'BlogPosting',

  headline:
    localizedPost.title,

  description:
    localizedPost.intro,

  url:
    canonicalUrl,

  mainEntityOfPage: {
    '@type':
      'WebPage',

    '@id':
      canonicalUrl,
  },

  datePublished:
    publishedAt,

  inLanguage:
    'en-GB',

  author: {
    '@type':
      'Person',

    name:
      'Aapo Pihkala',

    url:
      'https://aapopihkala.fi/en/',
  },

  keywords:
    localizedPost.tags,

  ...(imageUrl
    ? {
        image:
          imageUrl,
      }
    : {}),
};
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>
      {localizedPost.title} - Aapo Pihkala
    </title>

    <meta
      name="description"
      content={localizedPost.intro}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <link
      rel="alternate"
      hreflang="fi"
      href={finnishUrl}
    />

    <link
      rel="alternate"
      hreflang="en"
      href={canonicalUrl}
    />

    <link
      rel="alternate"
      hreflang="x-default"
      href={finnishUrl}
    />

    <meta
      property="og:type"
      content="article"
    />

    <meta
      property="og:site_name"
      content="Aapo Pihkala"
    />

    <meta
      property="og:locale"
      content="en_GB"
    />

    <meta
      property="og:locale:alternate"
      content="fi_FI"
    />

    <meta
      property="og:title"
      content={localizedPost.title}
    />

    <meta
      property="og:description"
      content={localizedPost.intro}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="article:published_time"
      content={publishedAt}
    />

    {
      localizedPost.tags.map(
        (tag) => (
          <meta
            property="article:tag"
            content={tag}
          />
        )
      )
    }

    {
      imageUrl && (
        <>
          <meta
            property="og:image"
            content={imageUrl}
          />

          {
            localizedPost.graphicAlt && (
              <meta
                property="og:image:alt"
                content={localizedPost.graphicAlt}
              />
            )
          }
        </>
      )
    }

    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        blogPostingSchema
      )}
    />
  </head>

  <body>
    <SiteHeader
      lang="en"
      languageHref={`/artikkelit/${slug}/`}
    />

    <main class="main-container">
      <section class="feed">
        <FeedPost
          post={post}
          lang="en"
          postNumber={postNumber}
          displayDate={displayDate}
          perspectiveLabel="Perspective"
          sourceLabel="Source"
          headingLevel="h1"
        />
      </section>
    </main>
  </body>
</html>
