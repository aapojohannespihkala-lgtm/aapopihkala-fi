---
import '../../../styles/global.css';

import {
  getCollection,
  type CollectionEntry,
} from 'astro:content';

import FeedPost from '../../../components/FeedPost.astro';
import { getPostSlug } from '../../../utils/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  postNumber: string;
}

export async function getStaticPaths() {
  const posts = (
    await getCollection('posts')
  )
    .filter(
      (post) =>
        post.data.status === 'published' &&
        Boolean(post.data.publishedAt)
    )
    .sort((a, b) => {
      const aTime = new Date(
        a.data.publishedAt as string
      ).getTime();

      const bTime = new Date(
        b.data.publishedAt as string
      ).getTime();

      return bTime - aTime;
    });

  return posts.map(
    (post, index) => ({
      params: {
        id: getPostSlug(post.id),
      },

      props: {
        post,

        postNumber:
          String(
            posts.length - index
          ).padStart(
            2,
            '0'
          ),
      },
    })
  );
}

const {
  post,
  postNumber,
} = Astro.props as Props;

if (
  post.data.status !== 'published' ||
  !post.data.publishedAt
) {
  throw new Error(
    `Published article expected: ${post.id}`
  );
}

const publishedAt =
  post.data.publishedAt;

const localizedPost =
  post.data.en;

const slug =
  getPostSlug(post.id);

const dateFormatter =
  new Intl.DateTimeFormat(
    'en-GB',
    {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    }
  );

const datePart =
  publishedAt.slice(
    0,
    10
  );

const displayDate =
  dateFormatter.format(
    new Date(
      `${datePart}T12:00:00`
    )
  );

const canonicalUrl =
  `https://aapopihkala.fi/en/articles/${slug}/`;

const finnishUrl =
  `https://aapopihkala.fi/artikkelit/${slug}/`;

const imageUrl =
  post.data.graphic
    ? `https://aapopihkala.fi${post.data.graphic}`
    : undefined;

const blogPostingSchema = {
  '@context':
    'https://schema.org',

  '@type':
    'BlogPosting',

  headline:
    localizedPost.title,

  description:
    localizedPost.intro,

  url:
    canonicalUrl,

  mainEntityOfPage: {
    '@type':
      'WebPage',

    '@id':
      canonicalUrl,
  },

  datePublished:
    publishedAt,

  inLanguage:
    'en-GB',

  author: {
    '@type':
      'Person',

    name:
      'Aapo Pihkala',

    url:
      'https://aapopihkala.fi/en/',
  },

  keywords:
    localizedPost.tags,

  ...(imageUrl
    ? {
        image:
          imageUrl,
      }
    : {}),
};
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>
      {localizedPost.title} - Aapo Pihkala
    </title>

    <meta
      name="description"
      content={localizedPost.intro}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <link
      rel="alternate"
      hreflang="fi"
      href={finnishUrl}
    />

    <link
      rel="alternate"
      hreflang="en"
      href={canonicalUrl}
    />

    <link
      rel="alternate"
      hreflang="x-default"
      href={finnishUrl}
    />

    <meta
      property="og:type"
      content="article"
    />

    <meta
      property="og:site_name"
      content="Aapo Pihkala"
    />

    <meta
      property="og:locale"
      content="en_GB"
    />

    <meta
      property="og:locale:alternate"
      content="fi_FI"
    />

    <meta
      property="og:title"
      content={localizedPost.title}
    />

    <meta
      property="og:description"
      content={localizedPost.intro}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="article:published_time"
      content={publishedAt}
    />

    {
      localizedPost.tags.map(
        (tag) => (
          <meta
            property="article:tag"
            content={tag}
          />
        )
      )
    }

    {
      imageUrl && (
        <>
          <meta
            property="og:image"
            content={imageUrl}
          />

          {
            localizedPost.graphicAlt && (
              <meta
                property="og:image:alt"
                content={localizedPost.graphicAlt}
              />
            )
          }
        </>
      )
    }

    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        blogPostingSchema
      )}
    />
  </head>

  <body>
    <header class="topbar">
      <nav
        class="topbar-inner"
        aria-label="Main navigation"
      >
        <a
          class="topbar-name"
          href="/en/"
          aria-label="Aapo Pihkala homepage"
        >
          aapo
        </a>

        <div class="topbar-actions">
          <a
            class="language-switch"
            href={`/artikkelit/${slug}/`}
            hreflang="fi"
            lang="fi"
            aria-label="Suomeksi"
          >
            FI
          </a>

          <a
            class="linkedin-link"
            href="https://fi.linkedin.com/in/aapo-pihkala"
            target="_blank"
            rel="noopener"
            aria-label="Aapo Pihkala on LinkedIn"
            title="LinkedIn"
          >
            <svg
              class="linkedin-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"
              />
            </svg>
          </a>
        </div>
      </nav>
    </header>

    <main class="main-container">
      <section class="feed">
        <FeedPost
          post={post}
          lang="en"
          postNumber={postNumber}
          displayDate={displayDate}
          perspectiveLabel="Perspective"
          sourceLabel="Source"
          headingLevel="h1"
        />
      </section>
    </main>
  </body>
</html>
