---
export function getStaticPaths() {
  const modules = import.meta.glob('../../data/ajankohtaista/*.md', {
    eager: true,
  });

  return Object.entries(modules).map(([path, post]: any) => {
    const slug = path.split('/').pop().replace('.md', '');

    return {
      params: { slug },
      props: { post, slug },
    };
  });
}

const { post, slug } = Astro.props;
const { Content, frontmatter } = post;

const {
  title,
  description,
  date,
  topics,
  location,
  source,
  sourceUrl,
} = frontmatter;

const formatDate = (date: string) => {
  const [year, month, day] = date.split('-');
  return `${Number(day)}.${Number(month)}.${year}`;
};

const canonical =
  `https://aapopihkala.fi/ajankohtaista/${slug}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: date,
  mainEntityOfPage: canonical,
  about: topics,
  author: {
    '@type': 'Person',
    name: 'Aapo Pihkala',
    jobTitle: 'Maisema-arkkitehti',
    url: 'https://aapopihkala.fi/',
  },
  publisher: {
    '@type': 'Person',
    name: 'Aapo Pihkala',
    url: 'https://aapopihkala.fi/',
  },
  citation: sourceUrl,
};
---

<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title} - Aapo Pihkala</title>

    <meta name="description" content={description} />
    <meta name="author" content="Aapo Pihkala" />

    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema)}
    />
  </head>

  <body>
    <main>
      <article>
        <header>
          <p>
            {formatDate(date)} · {topics.join(' · ')} · {location}
          </p>

          <h1>{title}</h1>
        </header>

        <Content />

        <footer>
          <p>
            <strong>Lähde:</strong>{' '}
            <a href={sourceUrl}>{source}</a>
          </p>

          <p>
            <strong>Aapo Pihkala</strong><br />
            Maisema-arkkitehti, Espoo
          </p>

          <p>
            <a href="/">Takaisin etusivulle</a>
          </p>
        </footer>
      </article>
    </main>
  </body>
</html>
