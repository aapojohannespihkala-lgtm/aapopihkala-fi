---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import '../../styles/current-electricity-polish.css';
import '../../styles/current-electricity-summary.css';
import '../../styles/current-weather-compact.css';
import '../../styles/current-layout.css';
import NightModeToggle from '../../components/NightModeToggle.astro';
import CurrentWeather from '../../components/current/CurrentWeather.astro';
import CurrentElectricity from '../../components/current/CurrentElectricity.astro';
import CurrentMarketsCustom from '../../components/current/CurrentMarketsCustom.astro';
import Current2SectionNavigator from '../../components/current/Current2SectionNavigator.astro';

const canonicalUrl = `${site.url}/current2/`;
---

<BaseLayout
  lang="en"
  title="Current2 | Aapo Pihkala"
  description="Responsive Current layout comparison page."
  canonicalUrl={canonicalUrl}
  finnishUrl={canonicalUrl}
  englishUrl={canonicalUrl}
  languageHref="/current/"
  initialNightMode
  includeDefaultSocialMeta={false}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <main id="main-content" tabindex="-1" class="current-shell current2-shell">
    <header class="current2-status" aria-label="Current2 viewport diagnostics">
      <span>CURRENT2</span>
      <span aria-hidden="true">/</span>
      <span data-current2-viewport>VIEWPORT</span>
      <span aria-hidden="true">/</span>
      <span data-current2-dpr>DPR</span>
      <span aria-hidden="true">/</span>
      <span data-current2-rem>REM</span>
    </header>

    <div class="current2-section" data-current2-section="weather">
      <CurrentWeather />
    </div>

    <div class="current2-section" data-current2-section="electricity">
      <CurrentElectricity />
    </div>

    <div class="current2-section" data-current2-section="markets">
      <CurrentMarketsCustom />
    </div>
  </main>

  <Current2SectionNavigator />

  <Fragment slot="afterAnalytics">
    <script>
      import { initCurrentElectricityPresentation } from '../../features/current/electricityPresentation';
      import { initCurrentElectricitySummary } from '../../features/current/electricitySummary';

      initCurrentElectricityPresentation();
      initCurrentElectricitySummary();
    </script>

    <script is:inline>
      (() => {
        const viewport = document.querySelector('[data-current2-viewport]')
        const dpr = document.querySelector('[data-current2-dpr]')
        const rem = document.querySelector('[data-current2-rem]')

        const update = () => {
          if (viewport) viewport.textContent = `${window.innerWidth} × ${window.innerHeight} CSS PX`
          if (dpr) dpr.textContent = `DPR ${window.devicePixelRatio}`
          if (rem) rem.textContent = `1REM ${getComputedStyle(document.documentElement).fontSize}`
        }

        update()
        window.addEventListener('resize', update, { passive: true })
      })()
    </script>

    <NightModeToggle lang="en" />
  </Fragment>
</BaseLayout>

<style>
  :global(html:has(.current2-shell)),
  :global(body:has(.current2-shell)) {
    overflow-x: clip !important;
  }

  .current2-shell {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(20px, 2.4vw, 32px) clamp(18px, 3vw, 32px) 96px;
  }

  .current2-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 7px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line-soft);
    color: var(--stone-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.055em;
  }

  .current2-section {
    min-width: 0;
    min-height: 0;
    max-width: 100%;
  }

  .current2-section + .current2-section {
    margin-top: clamp(30px, 4.5vw, 56px);
    border-top: 1px solid var(--line);
  }

  :global(.current2-shell .current-weather) {
    padding-top: clamp(18px, 2.2vw, 24px);
  }

  :global(.current2-shell .weather-temperature) {
    font-size: clamp(4.35rem, 7.2vw, 6.1rem) !important;
  }

  :global(.current2-shell .current-electricity),
  :global(.current2-shell .current-markets) {
    padding-top: clamp(22px, 2.6vw, 30px);
  }

  :global(.current2-shell .electricity-price) {
    font-size: clamp(4.6rem, 7.4vw, 6.5rem);
  }

  :global(.current2-shell .weather-daily-chart-frame),
  :global(.current2-shell .weather-daily-chart) {
    min-height: clamp(132px, 14vw, 168px);
    height: clamp(132px, 14vw, 168px);
  }

  :global(.current2-shell .electricity-chart) {
    height: clamp(170px, 17vw, 205px);
  }

  @media (max-width: 640px) {
    .current2-shell {
      padding: 20px 20px 80px;
    }

    .current2-status {
      font-size: 9px;
    }

    .current2-section + .current2-section {
      margin-top: 28px;
    }

    :global(.current2-shell .weather-temperature) {
      font-size: clamp(3.55rem, 18vw, 4.65rem) !important;
    }

    :global(.current2-shell .electricity-price) {
      font-size: clamp(3.8rem, 18vw, 4.9rem);
    }
  }
</style>
