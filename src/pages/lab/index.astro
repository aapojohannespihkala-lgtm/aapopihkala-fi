---
import '../../styles/global.css';
import MorphingTopography from '../../components/MorphingTopography.astro';
import PointButterfly from '../../components/PointButterfly.astro';
import TreeField from '../../components/TreeField.astro';
import PointBee from '../../components/PointBee.astro';
import WaterDropMorph from '../../components/WaterDropMorph.astro';
import RiverFlow from '../../components/RiverFlow.astro';
import AccessibilityStep from '../../components/AccessibilityStep.astro';
import SegmentedRing from '../../components/SegmentedRing.astro';
import PhotogrammetryModel from '../../components/PhotogrammetryModel.astro';
import MeshyPixelatedPoise from '../../components/MeshyPixelatedPoise.astro';
import MeshyPixelatedPoiseVol4 from '../../components/MeshyPixelatedPoiseVol4.astro';
---

<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Animation Lab | Aapo Pihkala</title>
    <meta name="description" content="Aapo Pihkalan animaatioiden ja interaktiivisten kokeilujen testialusta." />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <header class="topbar">
      <nav class="topbar-inner labbar" aria-label="Lab-navigaatio">
        <a class="topbar-name" href="/" aria-label="Takaisin etusivulle">aapo</a>
        <span class="labbar-label">animation lab</span>
      </nav>
    </header>

    <main class="lab-shell">
      <section class="portrait-priority" aria-labelledby="meshy-pixelated-poise-vol4-title">
        <article class="experiment experiment--priority">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">P09</p>
              <h2 id="meshy-pixelated-poise-vol4-title">Pixelated Poise vol 4</h2>
            </div>
            <p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p>
          </header>
          <div class="experiment-stage experiment-stage--portrait-multiview">
            <div class="experiment-viewport experiment-viewport--portrait-multiview">
              <MeshyPixelatedPoiseVol4 />
            </div>
          </div>
          <footer class="experiment-footer">
            <p>Pixelated Poise -pistepinta, jossa silmälasialueen pisteitä on tihennetty ja näkymän takana olevia pisteitä vaalennetaan kamerasyvyyden mukaan. Etuala jää selvästi luettavammaksi.</p>
            <p>Surface points · denser glasses · depth fade · static · free orbit · zoom</p>
          </footer>
        </article>
      </section>

      <section class="portrait-priority" aria-labelledby="meshy-pixelated-poise-title">
        <article class="experiment experiment--priority">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">P06</p>
              <h2 id="meshy-pixelated-poise-title">Pixelated Poise</h2>
            </div>
            <p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p>
          </header>
          <div class="experiment-stage experiment-stage--portrait-multiview">
            <div class="experiment-viewport experiment-viewport--portrait-multiview">
              <MeshyPixelatedPoise />
            </div>
          </div>
          <footer class="experiment-footer">
            <p>Meshy AI:lla tuotettu GLB-malli uutena vertailuversiona. Mallia voi pyörittää vapaasti, zoomata ja siirtää.</p>
            <p>Meshy · GLB · free orbit · zoom</p>
          </footer>
        </article>
      </section>

      <section class="portrait-priority" aria-labelledby="photogrammetry-title">
        <article class="experiment experiment--priority">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">P04</p>
              <h2 id="photogrammetry-title">Photogrammetry model</h2>
            </div>
            <p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p>
          </header>
          <div class="experiment-stage experiment-stage--portrait-multiview">
            <div class="experiment-viewport experiment-viewport--portrait-multiview">
              <PhotogrammetryModel />
            </div>
          </div>
          <footer class="experiment-footer">
            <p>Valokuvista rekonstruoitu GLB-malli. Mallia voi pyörittää vapaasti, zoomata ja siirtää suoraan selaimessa.</p>
            <p>GLB · free orbit · zoom · photogrammetry</p>
          </footer>
        </article>
      </section>

      <header class="lab-intro">
        <p class="lab-kicker">Other studies</p>
        <h1>Animation Lab</h1>
        <p class="lab-lead">Pyöriteltävien, muuntuvien ja muiden interaktiivisten animaatioiden kokeilualue.</p>
      </header>

      <section class="experiments" aria-label="Muut animaatiokokeilut">
        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">01</p><h2>Morphing topography</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage"><div class="experiment-viewport"><MorphingTopography /></div></div>
          <footer class="experiment-footer"><p>Muuntuva pistepilvimaasto, jonka korkeuskäyrät päivittyvät pinnan mukana.</p><p>Auto-rotate · zoom · contours · morph</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">02</p><h2>Point butterfly</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--butterfly"><div class="experiment-viewport experiment-viewport--butterfly"><PointButterfly /></div></div>
          <footer class="experiment-footer"><p>Pistepilvenä rakennettu perhonen, jossa siipisuonet muodostavat topografian korkeuskäyriä muistuttavan viivaston.</p><p>Auto-rotate · zoom · wing veins · slow flap</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">03</p><h2>Tree as field</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--tree"><div class="experiment-viewport experiment-viewport--tree"><TreeField /></div></div>
          <footer class="experiment-footer"><p>Puhdas pöytä -tutkielma, jossa latvus ja juuriston tila ovat järjestettyjä pistekenttiä. Runko yhdistää kaksi topografista tilavuutta ja käyrät seuraavat suoraan niiden geometriaa.</p><p>Auto-rotate · zoom · ordered points · contours · canopy field · root field</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">04</p><h2>Point bee</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--bee"><div class="experiment-viewport experiment-viewport--bee"><PointBee /></div></div>
          <footer class="experiment-footer"><p>Pistepilvenä rakennettu mehiläinen, jossa vartalo, raidat ja läpikuultavat siivet muodostavat kevyen kolmiulotteisen hyönteistutkielman.</p><p>Auto-rotate · zoom · wing buzz · point cloud</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">05</p><h2>Water drop</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--waterdrop"><div class="experiment-viewport experiment-viewport--waterdrop"><WaterDropMorph /></div></div>
          <footer class="experiment-footer"><p>Pintajännityksen koossa pitämä leijuva vesipisara, jonka pistepinta väreilee hitaasti ja hienovaraisesti.</p><p>Auto-rotate · zoom · surface tension · surface waves</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">06</p><h2>River flow</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--river-flow"><div class="experiment-viewport experiment-viewport--river-flow"><RiverFlow /></div></div>
          <footer class="experiment-footer"><p>Mutkitteleva pistepinta toimii itse vetenä. Pinnassa kulkevat aallot ja niiden mukana jatkuvasti muovautuvat korkeuskäyrät tekevät virtauksen näkyväksi.</p><p>Auto-rotate · zoom · water surface · moving contours · flow</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">07</p><h2>Accessibility step</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage"><div class="experiment-viewport"><AccessibilityStep /></div></div>
          <footer class="experiment-footer"><p>Pieni porras muuntuu hitaasti luiskaksi ja takaisin. Sama tasoero vaihtuu esteestä kuljettavaksi reitiksi yhdellä geometrisella eleellä.</p><p>Auto-rotate · zoom · step · ramp · morph</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">08</p><h2>Segmented ring</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--segmented-ring"><div class="experiment-viewport experiment-viewport--segmented-ring"><SegmentedRing /></div></div>
          <footer class="experiment-footer"><p>Kuvan kaksiosainen rengas on rakennettu paksuksi kolmiulotteiseksi muodoksi. Kaksi vastakkaista katkosta pysyvät mukana, kun rengas kiertyy hitaasti tilassa.</p><p>Auto-rotate · zoom · segmented ring · continuous rotation</p></footer>
        </article>
      </section>
    </main>
  </body>
</html>

<style>
  .labbar { max-width: 1160px; }

  .labbar-label,
  .lab-kicker,
  .experiment-index {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    text-transform: uppercase;
  }

  .labbar-label {
    color: var(--stone);
    font-size: 0.66rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .lab-shell {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: 42px 32px 120px;
  }

  .portrait-priority { margin-bottom: 108px; }

  .lab-kicker,
  .experiment-index {
    margin: 0 0 12px;
    color: var(--moss);
    font-size: 0.62rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.09em;
  }

  .lab-intro h1,
  .experiment-header h2 {
    color: var(--ink);
    font-family: "Times New Roman", Times, serif;
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .lab-lead { margin: 0; color: var(--stone); font-size: 0.96rem; line-height: 1.65; }

  .experiments { display: grid; gap: 84px; }
  .experiment { padding-top: 28px; border-top: 1px solid var(--line-soft); }
  .experiment--priority { border-top-color: var(--ink); }
  .experiment-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 28px;
  }

  .experiment-header h2 { margin: 0; font-size: clamp(2.1rem, 4vw, 3.3rem); line-height: 1; }
  .experiment-hint { margin: 0 0 4px; color: var(--stone-light); font-size: 0.72rem; line-height: 1.4; text-align: right; }

  .experiment-stage {
    position: relative;
    min-height: 420px;
    padding: 26px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .experiment-viewport { position: relative; width: min(100%, 920px); height: clamp(380px, 50vw, 560px); margin: 0 auto; }

  .experiment-stage--portrait-multiview { min-height: 540px; }
  .experiment-viewport--portrait-multiview { width: min(100%, 880px); height: clamp(500px, 58vw, 650px); }
  .experiment-stage--portrait-multiview { background: linear-gradient(to bottom, rgba(0,0,0,0.018), rgba(0,0,0,0)); }

  .experiment-stage--butterfly, .experiment-stage--bee { min-height: 500px; }
  .experiment-viewport--butterfly, .experiment-viewport--bee { height: clamp(440px, 52vw, 620px); }

  .experiment-stage--tree,
  .experiment-stage--river-flow { min-height: 540px; }

  .experiment-viewport--tree,
  .experiment-viewport--river-flow { height: clamp(480px, 56vw, 660px); }

  .experiment-stage--waterdrop, .experiment-stage--segmented-ring { min-height: 500px; }
  .experiment-viewport--waterdrop, .experiment-viewport--segmented-ring { height: clamp(440px, 54vw, 620px); }

  .experiment-footer {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    padding-top: 18px;
    color: var(--stone);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .experiment-footer p { margin: 0; }
  .experiment-footer p:first-child { max-width: 680px; }
  .experiment-footer p:last-child { color: var(--stone-light); text-align: right; }

  .lab-intro { max-width: 720px; margin: 0 0 72px; padding-top: 36px; border-top: 1px solid var(--line-soft); }
  .lab-intro h1 { margin: 0 0 22px; font-size: clamp(3.2rem, 7vw, 6rem); line-height: 0.92; }

  @media (max-width: 700px) {
    .lab-shell { padding: 26px 16px 80px; }
    .portrait-priority { margin-bottom: 78px; }
    .experiments { gap: 66px; }
    .experiment-header, .experiment-footer { display: block; }
    .experiment-hint { margin-top: 14px; text-align: left; }

    .experiment-stage,
    .experiment-stage--portrait-multiview,
    .experiment-stage--butterfly,
    .experiment-stage--bee,
    .experiment-stage--tree,
    .experiment-stage--waterdrop,
    .experiment-stage--river-flow,
    .experiment-stage--segmented-ring { min-height: 390px; padding: 18px 0; }

    .experiment-viewport,
    .experiment-viewport--portrait-multiview,
    .experiment-viewport--butterfly,
    .experiment-viewport--bee,
    .experiment-viewport--tree,
    .experiment-viewport--waterdrop,
    .experiment-viewport--river-flow,
    .experiment-viewport--segmented-ring { width: 100%; height: 390px; }

    .experiment-footer p + p { margin-top: 8px; text-align: left; }
    .lab-intro { margin-bottom: 54px; }
  }
</style>
