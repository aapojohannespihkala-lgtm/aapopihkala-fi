---
import '../../styles/global.css';
import MorphingTopography from '../../components/MorphingTopography.astro';
import PointButterfly from '../../components/PointButterfly.astro';
import PointTree from '../../components/PointTree.astro';
import PointTreeStudy from '../../components/PointTreeStudy.astro';
import TreeField from '../../components/TreeField.astro';
import PointBee from '../../components/PointBee.astro';
import StormwaterCatchment from '../../components/StormwaterCatchment.astro';
import RootNetwork from '../../components/RootNetwork.astro';
import WaterDropMorph from '../../components/WaterDropMorph.astro';
import RiverFlow from '../../components/RiverFlow.astro';
import AccessibilityStep from '../../components/AccessibilityStep.astro';
import SegmentedRing from '../../components/SegmentedRing.astro';
import PointPortrait from '../../components/PointPortrait.astro';
import PhotoPointPortrait from '../../components/PhotoPointPortrait.astro';
import MultiViewPortrait from '../../components/MultiViewPortrait.astro';
import PhotogrammetryModel from '../../components/PhotogrammetryModel.astro';
import PhotogrammetrySurfacePointCloud from '../../components/PhotogrammetrySurfacePointCloud.astro';
import MeshyPixelatedPoise from '../../components/MeshyPixelatedPoise.astro';
import MeshyPixelatedPoiseVol2 from '../../components/MeshyPixelatedPoiseVol2.astro';
import MeshyPixelatedPoiseVol3 from '../../components/MeshyPixelatedPoiseVol3.astro';
import MeshyPixelatedPoiseVol4 from '../../components/MeshyPixelatedPoiseVol4.astro';
import MeshyPixelatedPoiseVol5 from '../../components/MeshyPixelatedPoiseVol5.astro';
---

<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Animation Lab | Aapo Pihkala</title>
    <meta name="description" content="Aapo Pihkalan animaatioiden ja interaktiivisten kokeilujen testialusta." />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <header class="topbar">
      <nav class="topbar-inner labbar" aria-label="Lab-navigaatio">
        <a class="topbar-name" href="/" aria-label="Takaisin etusivulle">aapo</a>
        <span class="labbar-label">animation lab</span>
      </nav>
    </header>

    <main class="lab-shell">
      <section class="portrait-priority" aria-labelledby="meshy-pixelated-poise-vol5-title">
        <article class="experiment experiment--priority">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">P10</p>
              <h2 id="meshy-pixelated-poise-vol5-title">Pixelated Poise vol 5</h2>
            </div>
            <p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p>
          </header>
          <div class="experiment-stage experiment-stage--portrait-multiview">
            <div class="experiment-viewport experiment-viewport--portrait-multiview">
              <MeshyPixelatedPoiseVol5 />
            </div>
          </div>
          <footer class="experiment-footer">
            <p>Pixelated Poise -pistepinta, jossa silmälasien etupinnan pistejakaumaa on tihennetty selvästi. Oikean mesh-pinnan taakse jäävät pisteet näkyvät vain haaleana ghost-kerroksena, kun taas silmälle näkyvä pinta piirtyy tummempana.</p>
            <p>Surface points · dense glasses · true occlusion fade · static · free orbit · zoom</p>
          </footer>
        </article>
      </section>

      <section class="portrait-priority" aria-labelledby="meshy-pixelated-poise-vol4-title">
        <article class="experiment experiment--priority">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">P09</p>
              <h2 id="meshy-pixelated-poise-vol4-title">Pixelated Poise vol 4</h2>
            </div>
            <p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p>
          </header>
          <div class="experiment-stage experiment-stage--portrait-multiview">
            <div class="experiment-viewport experiment-viewport--portrait-multiview">
              <MeshyPixelatedPoiseVol4 />
            </div>
          </div>
          <footer class="experiment-footer">
            <p>Pixelated Poise -pistepinta, jossa silmälasialueen pisteitä on tihennetty ja näkymän takana olevia pisteitä vaalennetaan kamerasyvyyden mukaan. Etuala jää selvästi luettavammaksi.</p>
            <p>Surface points · denser glasses · depth fade · static · free orbit · zoom</p>
          </footer>
        </article>
      </section>

      <section class="portrait-priority" aria-labelledby="meshy-pixelated-poise-vol3-title">
        <article class="experiment experiment--priority">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">P08</p>
              <h2 id="meshy-pixelated-poise-vol3-title">Pixelated Poise vol 3</h2>
            </div>
            <p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p>
          </header>
          <div class="experiment-stage experiment-stage--portrait-multiview">
            <div class="experiment-viewport experiment-viewport--portrait-multiview">
              <MeshyPixelatedPoiseVol3 />
            </div>
          </div>
          <footer class="experiment-footer">
            <p>Pixelated Poise -pistepinta, jossa kaulan alaosan vaakasuoraa leikkauspintaa on vaimennettu. Pään ja kaulan muu pistejakauma säilyy ennallaan.</p>
            <p>Surface points · neck-cut suppression · static · free orbit · zoom</p>
          </footer>
        </article>
      </section>

      <section class="portrait-priority" aria-labelledby="meshy-pixelated-poise-vol2-title">
        <article class="experiment experiment--priority">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">P07</p>
              <h2 id="meshy-pixelated-poise-vol2-title">Pixelated Poise vol 2</h2>
            </div>
            <p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p>
          </header>
          <div class="experiment-stage experiment-stage--portrait-multiview">
            <div class="experiment-viewport experiment-viewport--portrait-multiview">
              <MeshyPixelatedPoiseVol2 />
            </div>
          </div>
          <footer class="experiment-footer">
            <p>Pixelated Poise -mallista muodostettu staattinen pistepinta. Pisteet näytteistetään vain mallin pinnalta, jotta pään siluetti ja tilavuus säilyvät ilman näkyvää mesh-pintaa.</p>
            <p>Surface points · static · Meshy · free orbit · zoom</p>
          </footer>
        </article>
      </section>

      <section class="portrait-priority" aria-labelledby="meshy-pixelated-poise-title">
        <article class="experiment experiment--priority">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">P06</p>
              <h2 id="meshy-pixelated-poise-title">Pixelated Poise</h2>
            </div>
            <p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p>
          </header>
          <div class="experiment-stage experiment-stage--portrait-multiview">
            <div class="experiment-viewport experiment-viewport--portrait-multiview">
              <MeshyPixelatedPoise />
            </div>
          </div>
          <footer class="experiment-footer">
            <p>Meshy AI:lla tuotettu GLB-malli uutena vertailuversiona. Mallia voi pyörittää vapaasti, zoomata ja siirtää.</p>
            <p>Meshy · GLB · free orbit · zoom</p>
          </footer>
        </article>
      </section>

      <section class="portrait-priority" aria-labelledby="photogrammetry-surface-points-title">
        <article class="experiment experiment--priority">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">P05</p>
              <h2 id="photogrammetry-surface-points-title">Photogrammetry surface points</h2>
            </div>
            <p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p>
          </header>
          <div class="experiment-stage experiment-stage--portrait-multiview">
            <div class="experiment-viewport experiment-viewport--portrait-multiview">
              <PhotogrammetrySurfacePointCloud />
            </div>
          </div>
          <footer class="experiment-footer">
            <p>Alkuperäisen fotogrammetriamallin pinnalta tasaisesti näytteistetty pistepilvi. Pisteitä ei muodosteta mallin sisätilaan, vaan ainoastaan rekonstruoidulle pinnalle.</p>
            <p>Surface samples · point cloud · free orbit · zoom</p>
          </footer>
        </article>
      </section>

      <section class="portrait-priority" aria-labelledby="photogrammetry-title">
        <article class="experiment experiment--priority">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">P04</p>
              <h2 id="photogrammetry-title">Photogrammetry model</h2>
            </div>
            <p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p>
          </header>
          <div class="experiment-stage experiment-stage--portrait-multiview">
            <div class="experiment-viewport experiment-viewport--portrait-multiview">
              <PhotogrammetryModel />
            </div>
          </div>
          <footer class="experiment-footer">
            <p>Valokuvista rekonstruoitu GLB-malli. Mallia voi pyörittää vapaasti, zoomata ja siirtää suoraan selaimessa.</p>
            <p>GLB · free orbit · zoom · photogrammetry</p>
          </footer>
        </article>
      </section>

      <section class="portrait-priority" aria-labelledby="portrait-title">
        <header class="portrait-priority__header">
          <p class="lab-kicker">Portrait / input</p>
          <h1 id="portrait-title">Portrait studies</h1>
          <p class="portrait-priority__lead">
            Kuva-aineistoon perustuvat muotokuvakokeilut ovat Labin alussa. P03 käyttää kuvia suoraan 3D-pisteinä ilman geneeristä pääkuorta. P01 ja P02 jäävät vertailuun.
          </p>
        </header>

        <div class="portrait-reference-grid" aria-label="Muotokuvan referenssikuvat">
          <figure class="portrait-reference">
            <img src="/lab/portrait-front.jpg" alt="Muotokuvan referenssi etuviistosta" width="320" height="400" loading="eager" decoding="async" />
            <figcaption>INPUT / FRONT 3-4</figcaption>
          </figure>
          <figure class="portrait-reference">
            <img src="/lab/portrait-side.jpg" alt="Muotokuvan referenssi sivuprofiilista" width="320" height="400" loading="eager" decoding="async" />
            <figcaption>INPUT / PROFILE</figcaption>
          </figure>
        </div>

        <div class="portrait-experiments">
          <article class="experiment experiment--priority experiment--multiview">
            <header class="experiment-header">
              <div>
                <p class="experiment-index">P03</p>
                <h2>Multi-view portrait volume</h2>
              </div>
              <p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p>
            </header>
            <div class="experiment-stage experiment-stage--portrait-multiview">
              <div class="experiment-viewport experiment-viewport--portrait-multiview">
                <MultiViewPortrait />
              </div>
            </div>
            <footer class="experiment-footer">
              <p>
                Uusi kuva-aineistolähtöinen kokeilu. Pisteet syntyvät suoraan valokuvien pikseleistä kahdella dokumentoidulla katselukulmalla, ja näkymät sulautuvat rajatun pyörityksen aikana. Tässä ei käytetä geneeristä kallokuorta.
              </p>
              <p>Direct image points · multi-view blend · constrained orbit</p>
            </footer>
          </article>

          <article class="experiment experiment--priority">
            <header class="experiment-header">
              <div><p class="experiment-index">P01</p><h2>Survey portrait</h2></div>
              <p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p>
            </header>
            <div class="experiment-stage experiment-stage--portrait">
              <div class="experiment-viewport experiment-viewport--portrait"><PointPortrait /></div>
            </div>
            <footer class="experiment-footer">
              <p>Toimiva 3D-pistepilvimuotokuva. Tämä versio pidetään vakaana vertailupohjana, kun realistisempaa rekonstruktiota kehitetään erikseen.</p>
              <p>Stable 3D · drag · zoom · point cloud</p>
            </footer>
          </article>

          <article class="experiment experiment--priority experiment--photo">
            <header class="experiment-header">
              <div><p class="experiment-index">P02</p><h2>Photo point portrait</h2></div>
              <p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p>
            </header>
            <div class="experiment-stage experiment-stage--portrait-photo">
              <div class="experiment-viewport experiment-viewport--portrait-photo"><PhotoPointPortrait /></div>
            </div>
            <footer class="experiment-footer">
              <p>Erillinen aiempi rekonstruktioprototyyppi, jossa valokuvien värit projisoidaan parametriseen 3D-pintaan. Se säilytetään vertailua varten.</p>
              <p>Photo colours · limited yaw · prototype</p>
            </footer>
          </article>
        </div>
      </section>

      <header class="lab-intro">
        <p class="lab-kicker">Other studies</p>
        <h1>Animation Lab</h1>
        <p class="lab-lead">Pyöriteltävien, muuntuvien ja muiden interaktiivisten animaatioiden kokeilualue. Muut tutkimukset jatkuvat portrait-kokeilujen jälkeen.</p>
      </header>

      <section class="experiments" aria-label="Muut animaatiokokeilut">
        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">01</p><h2>Morphing topography</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage"><div class="experiment-viewport"><MorphingTopography /></div></div>
          <footer class="experiment-footer"><p>Muuntuva pistepilvimaasto, jonka korkeuskäyrät päivittyvät pinnan mukana.</p><p>Auto-rotate · zoom · contours · morph</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">02</p><h2>Point butterfly</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--butterfly"><div class="experiment-viewport experiment-viewport--butterfly"><PointButterfly /></div></div>
          <footer class="experiment-footer"><p>Pistepilvenä rakennettu perhonen, jossa siipisuonet muodostavat topografian korkeuskäyriä muistuttavan viivaston.</p><p>Auto-rotate · zoom · wing veins · slow flap</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">03</p><h2>Tree footprint</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--tree"><div class="experiment-viewport experiment-viewport--tree"><PointTree /></div></div>
          <footer class="experiment-footer"><p>Kaupunkipuun mittakaavaa tutkiva piste- ja viivamalli. Latvuksen leveys, juurten ulottuvuus ja puuta väistävä kaupunkirakenteen linja näkyvät samassa kolmiulotteisessa kaaviossa.</p><p>Auto-rotate · zoom · canopy · root zone · setback</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">03B</p><h2>Tree field study</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--tree"><div class="experiment-viewport experiment-viewport--tree"><PointTreeStudy /></div></div>
          <footer class="experiment-footer"><p>Uusi puututkielma, jossa puuaines, latvuksen epätasainen pistekenttä, kevyet tiheyskäyrät, hienojuuret ja maanpinnan datum muodostavat yhden graafisen järjestelmän.</p><p>Auto-rotate · zoom · woody hierarchy · canopy contours · root field</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">03C</p><h2>Tree as field</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--tree"><div class="experiment-viewport experiment-viewport--tree"><TreeField /></div></div>
          <footer class="experiment-footer"><p>Puhdas pöytä -tutkielma, jossa latvus ja juuriston tila ovat järjestettyjä pistekenttiä. Runko yhdistää kaksi topografista tilavuutta ja käyrät seuraavat suoraan niiden geometriaa.</p><p>Auto-rotate · zoom · ordered points · contours · canopy field · root field</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">04</p><h2>Point bee</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--bee"><div class="experiment-viewport experiment-viewport--bee"><PointBee /></div></div>
          <footer class="experiment-footer"><p>Pistepilvenä rakennettu mehiläinen, jossa vartalo, raidat ja läpikuultavat siivet muodostavat kevyen kolmiulotteisen hyönteistutkielman.</p><p>Auto-rotate · zoom · wing buzz · point cloud</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">05</p><h2>Stormwater catchment</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage"><div class="experiment-viewport"><StormwaterCatchment /></div></div>
          <footer class="experiment-footer"><p>Hulevesien valuma-aluetta kuvaava pistepilvimalli, jossa sade, virtausreitit, painanne ja ylivuoto muodostavat yhden liikkuvan järjestelmän.</p><p>Auto-rotate · zoom · rain · flow · basin</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">06</p><h2>Root network</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--root-network"><div class="experiment-viewport experiment-viewport--root-network"><RootNetwork /></div></div>
          <footer class="experiment-footer"><p>Maanalaista juuriverkostoa tutkiva kolmiulotteinen malli, jossa pääjuuret, hienojuuret, kasvualusta ja kosteuden liike muodostavat yhden järjestelmän.</p><p>Auto-rotate · zoom · roots · soil · moisture pulse</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">07</p><h2>Water drop</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--waterdrop"><div class="experiment-viewport experiment-viewport--waterdrop"><WaterDropMorph /></div></div>
          <footer class="experiment-footer"><p>Pintajännityksen koossa pitämä leijuva vesipisara, jonka pistepinta väreilee hitaasti ja hienovaraisesti.</p><p>Auto-rotate · zoom · surface tension · surface waves</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">08</p><h2>River flow</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--river-flow"><div class="experiment-viewport experiment-viewport--river-flow"><RiverFlow /></div></div>
          <footer class="experiment-footer"><p>Mutkitteleva pistepinta toimii itse vetenä. Pinnassa kulkevat aallot ja niiden mukana jatkuvasti muovautuvat korkeuskäyrät tekevät virtauksen näkyväksi.</p><p>Auto-rotate · zoom · water surface · moving contours · flow</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">09</p><h2>Accessibility step</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage"><div class="experiment-viewport"><AccessibilityStep /></div></div>
          <footer class="experiment-footer"><p>Pieni porras muuntuu hitaasti luiskaksi ja takaisin. Sama tasoero vaihtuu esteestä kuljettavaksi reitiksi yhdellä geometrisella eleellä.</p><p>Auto-rotate · zoom · step · ramp · morph</p></footer>
        </article>

        <article class="experiment">
          <header class="experiment-header"><div><p class="experiment-index">10</p><h2>Segmented ring</h2></div><p class="experiment-hint">Vedä pyörittääksesi · rullaa zoomataksesi</p></header>
          <div class="experiment-stage experiment-stage--segmented-ring"><div class="experiment-viewport experiment-viewport--segmented-ring"><SegmentedRing /></div></div>
          <footer class="experiment-footer"><p>Kuvan kaksiosainen rengas on rakennettu paksuksi kolmiulotteiseksi muodoksi. Kaksi vastakkaista katkosta pysyvät mukana, kun rengas kiertyy hitaasti tilassa.</p><p>Auto-rotate · zoom · segmented ring · continuous rotation</p></footer>
        </article>
      </section>
    </main>
  </body>
</html>

<style>
  .labbar { max-width: 1160px; }

  .labbar-label,
  .lab-kicker,
  .experiment-index,
  .portrait-reference figcaption {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    text-transform: uppercase;
  }

  .labbar-label {
    color: var(--stone);
    font-size: 0.66rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .lab-shell {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: 42px 32px 120px;
  }

  .portrait-priority { margin-bottom: 108px; }
  .portrait-priority__header { max-width: 760px; margin-bottom: 30px; }

  .lab-kicker,
  .experiment-index {
    margin: 0 0 12px;
    color: var(--moss);
    font-size: 0.62rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.09em;
  }

  .portrait-priority h1,
  .lab-intro h1,
  .experiment-header h2 {
    color: var(--ink);
    font-family: "Times New Roman", Times, serif;
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .portrait-priority h1 { margin: 0 0 16px; font-size: clamp(3rem, 7vw, 5.8rem); line-height: 0.94; }
  .portrait-priority__lead, .lab-lead { margin: 0; color: var(--stone); font-size: 0.96rem; line-height: 1.65; }

  .portrait-reference-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 72px;
  }

  .portrait-reference { margin: 0; border-top: 1px solid var(--line-soft); padding-top: 10px; }
  .portrait-reference img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center; }
  .portrait-reference figcaption { margin-top: 8px; color: var(--stone-light); font-size: 0.56rem; letter-spacing: 0.08em; }

  .portrait-experiments, .experiments { display: grid; gap: 84px; }
  .experiment { padding-top: 28px; border-top: 1px solid var(--line-soft); }
  .experiment--priority { border-top-color: var(--ink); }
  .experiment-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 28px;
  }

  .experiment-header h2 { margin: 0; font-size: clamp(2.1rem, 4vw, 3.3rem); line-height: 1; }
  .experiment-hint { margin: 0 0 4px; color: var(--stone-light); font-size: 0.72rem; line-height: 1.4; text-align: right; }

  .experiment-stage {
    position: relative;
    min-height: 420px;
    padding: 26px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

