---
import '../../styles/global.css';
import MorphingTopography from '../../components/MorphingTopography.astro';
import PointButterfly from '../../components/PointButterfly.astro';
import PointTree from '../../components/PointTree.astro';
import PointTreeStudy from '../../components/PointTreeStudy.astro';
import TreeField from '../../components/TreeField.astro';
import PointBee from '../../components/PointBee.astro';
import StormwaterCatchment from '../../components/StormwaterCatchment.astro';
import RootNetwork from '../../components/RootNetwork.astro';
import WaterDropMorph from '../../components/WaterDropMorph.astro';
import RiverFlow from '../../components/RiverFlow.astro';
import AccessibilityStep from '../../components/AccessibilityStep.astro';
import SegmentedRing from '../../components/SegmentedRing.astro';
import PointPortrait from '../../components/PointPortrait.astro';
---

<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Animation Lab | Aapo Pihkala</title>

    <meta
      name="description"
      content="Aapo Pihkalan animaatioiden ja interaktiivisten kokeilujen testialusta."
    />

    <meta name="robots" content="noindex,nofollow" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <header class="topbar">
      <nav class="topbar-inner labbar" aria-label="Lab-navigaatio">
        <a class="topbar-name" href="/" aria-label="Takaisin etusivulle">
          aapo
        </a>

        <span class="labbar-label">animation lab</span>
      </nav>
    </header>

    <main class="lab-shell">
      <header class="lab-intro">
        <p class="lab-kicker">Testialusta</p>

        <h1>Animation Lab</h1>

        <p class="lab-lead">
          Pyöriteltävien, muuntuvien ja muiden interaktiivisten animaatioiden kokeilualue.
          Sivulle voidaan lisätä uusia tutkimuksia rinnakkain ilman, että etusivun toteutusta tarvitsee muuttaa.
        </p>
      </header>

      <section class="experiments" aria-label="Animaatiokokeilut">
        <article class="experiment">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">01</p>
              <h2>Morphing topography</h2>
            </div>

            <p class="experiment-hint">
              Vedä pyörittääksesi · rullaa zoomataksesi
            </p>
          </header>

          <div class="experiment-stage">
            <div class="experiment-viewport">
              <MorphingTopography />
            </div>
          </div>

          <footer class="experiment-footer">
            <p>
              Muuntuva pistepilvimaasto, jonka korkeuskäyrät päivittyvät pinnan mukana.
            </p>

            <p>
              Auto-rotate · zoom · contours · morph
            </p>
          </footer>
        </article>

        <article class="experiment">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">02</p>
              <h2>Point butterfly</h2>
            </div>

            <p class="experiment-hint">
              Vedä pyörittääksesi · rullaa zoomataksesi
            </p>
          </header>

          <div class="experiment-stage experiment-stage--butterfly">
            <div class="experiment-viewport experiment-viewport--butterfly">
              <PointButterfly />
            </div>
          </div>

          <footer class="experiment-footer">
            <p>
              Pistepilvenä rakennettu perhonen, jossa siipisuonet muodostavat topografian korkeuskäyriä muistuttavan viivaston.
            </p>

            <p>
              Auto-rotate · zoom · wing veins · slow flap
            </p>
          </footer>
        </article>

        <article class="experiment">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">03</p>
              <h2>Tree footprint</h2>
            </div>

            <p class="experiment-hint">
              Vedä pyörittääksesi · rullaa zoomataksesi
            </p>
          </header>

          <div class="experiment-stage experiment-stage--tree">
            <div class="experiment-viewport experiment-viewport--tree">
              <PointTree />
            </div>
          </div>

          <footer class="experiment-footer">
            <p>
              Kaupunkipuun mittakaavaa tutkiva piste- ja viivamalli. Latvuksen leveys, juurten ulottuvuus ja puuta väistävä kaupunkirakenteen linja näkyvät samassa kolmiulotteisessa kaaviossa.
            </p>

            <p>
              Auto-rotate · zoom · canopy · root zone · setback
            </p>
          </footer>
        </article>

        <article class="experiment">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">03B</p>
              <h2>Tree field study</h2>
            </div>

            <p class="experiment-hint">
              Vedä pyörittääksesi · rullaa zoomataksesi
            </p>
          </header>

          <div class="experiment-stage experiment-stage--tree">
            <div class="experiment-viewport experiment-viewport--tree">
              <PointTreeStudy />
            </div>
          </div>

          <footer class="experiment-footer">
            <p>
              Uusi puututkielma, jossa puuaines, latvuksen epätasainen pistekenttä, kevyet tiheyskäyrät, hienojuuret ja maanpinnan datum muodostavat yhden graafisen järjestelmän.
            </p>

            <p>
              Auto-rotate · zoom · woody hierarchy · canopy contours · root field
            </p>
          </footer>
        </article>

        <article class="experiment">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">03C</p>
              <h2>Tree as field</h2>
            </div>

            <p class="experiment-hint">
              Vedä pyörittääksesi · rullaa zoomataksesi
            </p>
          </header>

          <div class="experiment-stage experiment-stage--tree">
            <div class="experiment-viewport experiment-viewport--tree">
              <TreeField />
            </div>
          </div>

          <footer class="experiment-footer">
            <p>
              Puhdas pöytä -tutkielma, jossa latvus ja juuriston tila ovat järjestettyjä pistekenttiä. Runko yhdistää kaksi topografista tilavuutta ja käyrät seuraavat suoraan niiden geometriaa.
            </p>

            <p>
              Auto-rotate · zoom · ordered points · contours · canopy field · root field
            </p>
          </footer>
        </article>

        <article class="experiment">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">04</p>
              <h2>Point bee</h2>
            </div>

            <p class="experiment-hint">
              Vedä pyörittääksesi · rullaa zoomataksesi
            </p>
          </header>

          <div class="experiment-stage experiment-stage--bee">
            <div class="experiment-viewport experiment-viewport--bee">
              <PointBee />
            </div>
          </div>

          <footer class="experiment-footer">
            <p>
              Pistepilvenä rakennettu mehiläinen, jossa vartalo, raidat ja läpikuultavat siivet muodostavat kevyen kolmiulotteisen hyönteistutkielman.
            </p>

            <p>
              Auto-rotate · zoom · wing buzz · point cloud
            </p>
          </footer>
        </article>

        <article class="experiment">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">05</p>
              <h2>Stormwater catchment</h2>
            </div>

            <p class="experiment-hint">
              Vedä pyörittääksesi · rullaa zoomataksesi
            </p>
          </header>

          <div class="experiment-stage">
            <div class="experiment-viewport">
              <StormwaterCatchment />
            </div>
          </div>

          <footer class="experiment-footer">
            <p>
              Hulevesien valuma-aluetta kuvaava pistepilvimalli, jossa sade, virtausreitit, painanne ja ylivuoto muodostavat yhden liikkuvan järjestelmän.
            </p>

            <p>
              Auto-rotate · zoom · rain · flow · basin
            </p>
          </footer>
        </article>

        <article class="experiment">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">06</p>
              <h2>Root network</h2>
            </div>

            <p class="experiment-hint">
              Vedä pyörittääksesi · rullaa zoomataksesi
            </p>
          </header>

          <div class="experiment-stage experiment-stage--root-network">
            <div class="experiment-viewport experiment-viewport--root-network">
              <RootNetwork />
            </div>
          </div>

          <footer class="experiment-footer">
            <p>
              Maanalaista juuriverkostoa tutkiva kolmiulotteinen malli, jossa pääjuuret, hienojuuret, kasvualusta ja kosteuden liike muodostavat yhden järjestelmän.
            </p>

            <p>
              Auto-rotate · zoom · roots · soil · moisture pulse
            </p>
          </footer>
        </article>

        <article class="experiment">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">07</p>
              <h2>Water drop</h2>
            </div>

            <p class="experiment-hint">
              Vedä pyörittääksesi · rullaa zoomataksesi
            </p>
          </header>

          <div class="experiment-stage experiment-stage--waterdrop">
            <div class="experiment-viewport experiment-viewport--waterdrop">
              <WaterDropMorph />
            </div>
          </div>

          <footer class="experiment-footer">
            <p>
              Pintajännityksen koossa pitämä leijuva vesipisara, jonka pistepinta väreilee hitaasti ja hienovaraisesti.
            </p>

            <p>
              Auto-rotate · zoom · surface tension · surface waves
            </p>
          </footer>
        </article>

        <article class="experiment">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">08</p>
              <h2>River flow</h2>
            </div>

            <p class="experiment-hint">
              Vedä pyörittääksesi · rullaa zoomataksesi
            </p>
          </header>

          <div class="experiment-stage experiment-stage--river-flow">
            <div class="experiment-viewport experiment-viewport--river-flow">
              <RiverFlow />
            </div>
          </div>

          <footer class="experiment-footer">
            <p>
              Mutkitteleva pistepinta toimii itse vetenä. Pinnassa kulkevat aallot ja niiden mukana jatkuvasti muovautuvat korkeuskäyrät tekevät virtauksen näkyväksi.
            </p>

            <p>
              Auto-rotate · zoom · water surface · moving contours · flow
            </p>
          </footer>
        </article>

        <article class="experiment">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">09</p>
              <h2>Accessibility step</h2>
            </div>

            <p class="experiment-hint">
              Vedä pyörittääksesi · rullaa zoomataksesi
            </p>
          </header>

          <div class="experiment-stage">
            <div class="experiment-viewport">
              <AccessibilityStep />
            </div>
          </div>

          <footer class="experiment-footer">
            <p>
              Pieni porras muuntuu hitaasti luiskaksi ja takaisin. Sama tasoero vaihtuu esteestä kuljettavaksi reitiksi yhdellä geometrisella eleellä.
            </p>

            <p>
              Auto-rotate · zoom · step · ramp · morph
            </p>
          </footer>
        </article>

        <article class="experiment">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">10</p>
              <h2>Segmented ring</h2>
            </div>

            <p class="experiment-hint">
              Vedä pyörittääksesi · rullaa zoomataksesi
            </p>
          </header>

          <div class="experiment-stage experiment-stage--segmented-ring">
            <div class="experiment-viewport experiment-viewport--segmented-ring">
              <SegmentedRing />
            </div>
          </div>

          <footer class="experiment-footer">
            <p>
              Kuvan kaksiosainen rengas on rakennettu paksuksi kolmiulotteiseksi muodoksi. Kaksi vastakkaista katkosta pysyvät mukana, kun rengas kiertyy hitaasti tilassa.
            </p>

            <p>
              Auto-rotate · zoom · segmented ring · continuous rotation
            </p>
          </footer>
        </article>

        <article class="experiment">
          <header class="experiment-header">
            <div>
              <p class="experiment-index">11</p>
              <h2>Survey portrait</h2>
            </div>

            <p class="experiment-hint">
              Vedä pyörittääksesi · rullaa zoomataksesi
            </p>
          </header>

          <div class="experiment-stage">
            <div class="experiment-viewport">
              <PointPortrait />
            </div>
          </div>

          <footer class="experiment-footer">
            <p>
              Muotokuvatutkielma, jossa pää rakentuu pistepilvestä, poikkileikkauksista ja tarkasta viivageometriasta. Silmälasit, hiusten virtaus ja kasvojen pienet maamerkit käsitellään kuin mitattua maastoa.
            </p>

            <p>
              Auto-rotate · zoom · portrait field · contours · glasses · hair flow
            </p>
          </footer>
        </article>
      </section>
    </main>
  </body>
</html>

<style>
  .labbar {
    max-width: 1160px;
  }

  .labbar-label {
    color: var(--stone);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.66rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lab-shell {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: 74px 32px 120px;
  }

  .lab-intro {
    max-width: 720px;
    margin-bottom: 86px;
  }

  .lab-kicker,
  .experiment-index {
    margin: 0 0 14px;
    color: var(--moss);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.62rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .lab-intro h1 {
    margin: 0 0 24px;
    color: var(--ink);
    font-family:
      "Times New Roman",
      Times,
      serif;
    font-size: clamp(3.4rem, 8vw, 6.6rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .lab-lead {
    max-width: 660px;
    margin: 0;
    color: var(--stone);
    font-size: 1rem;
    line-height: 1.7;
  }

  .experiments {
    display: grid;
    gap: 84px;
  }

  .experiment {
    padding-top: 28px;
    border-top: 1px solid var(--line-soft);
  }

  .experiment-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 28px;
  }

  .experiment-header h2 {
    margin: 0;
    color: var(--ink);
    font-family:
      "Times New Roman",
      Times,
      serif;
    font-size: clamp(2.1rem, 4vw, 3.3rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .experiment-hint {
    margin: 0 0 4px;
    color: var(--stone-light);
    font-size: 0.72rem;
    line-height: 1.4;
    text-align: right;
  }

  .experiment-stage {
    position: relative;
    min-height: 420px;
    padding: 34px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .experiment-viewport {
    --lab-hit-width: min(62%, 560px);
    position: relative;
    width: calc(100% - 110px);
    height: clamp(380px, 50vw, 560px);
    margin: 15px auto;
  }

  .experiment-viewport::before,
  .experiment-viewport::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 20;
    width: calc((100% - var(--lab-hit-width)) / 2);
    background: transparent;
    cursor: default;
    pointer-events: auto;
  }

  .experiment-viewport::before {
    left: 0;
  }

  .experiment-viewport::after {
    right: 0;
  }

  .experiment-stage--butterfly,
  .experiment-stage--bee {
    min-height: 500px;
  }

  .experiment-viewport--butterfly,
  .experiment-viewport--bee {
    --lab-hit-width: min(60%, 520px);
    width: min(100%, 900px);
    height: clamp(440px, 52vw, 620px);
    margin: 0 auto;
  }

  .experiment-stage--tree {
    min-height: 560px;
  }

  .experiment-viewport--tree {
    --lab-hit-width: min(54%, 520px);
    width: min(100%, 980px);
    height: clamp(500px, 58vw, 660px);
    margin: 0 auto;
  }

  .experiment-stage--root-network {
    min-height: 540px;
  }

  .experiment-viewport--root-network {
    --lab-hit-width: min(58%, 520px);
    width: min(100%, 960px);
    height: clamp(480px, 56vw, 640px);
    margin: 0 auto;
  }

  .experiment-stage--waterdrop {
    min-height: 500px;
  }

  .experiment-viewport--waterdrop {
    --lab-hit-width: min(42%, 360px);
    width: min(100%, 900px);
    height: clamp(440px, 52vw, 600px);
    margin: 0 auto;
  }

  .experiment-stage--river-flow {
    min-height: 540px;
  }

  .experiment-viewport--river-flow {
    --lab-hit-width: min(64%, 600px);
    width: min(100%, 980px);
    height: clamp(480px, 56vw, 640px);
    margin: 0 auto;
  }

  .experiment-stage--segmented-ring {
    min-height: 520px;
  }

  .experiment-viewport--segmented-ring {
    --lab-hit-width: min(54%, 480px);
    width: min(100%, 900px);
    height: clamp(460px, 54vw, 620px);
    margin: 0 auto;
  }

  .experiment-footer {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    padding-top: 18px;
    color: var(--stone);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .experiment-footer p {
    margin: 0;
  }

  .experiment-footer p:first-child {
    max-width: 680px;
  }

  .experiment-footer p:last-child {
    color: var(--stone-light);
    text-align: right;
  }

  @media (max-width: 700px) {
    .lab-shell {
      padding: 56px 16px 80px;
    }

    .lab-intro {
      margin-bottom: 64px;
    }

    .lab-lead {
      font-size: 0.96rem;
    }

    .experiment-header,
    .experiment-footer {
      display: block;
    }

    .experiment-hint {
      margin-top: 14px;
      text-align: left;
    }

    .experiment-stage {
      min-height: 360px;
      padding: 20px 0;
    }

    .experiment-viewport {
      --lab-hit-width: 68%;
      width: calc(100% - 110px);
      height: 360px;
    }

    .experiment-stage--butterfly,
    .experiment-stage--bee {
      min-height: 390px;
    }

    .experiment-viewport--butterfly,
    .experiment-viewport--bee {
      --lab-hit-width: 64%;
      width: 100%;
      height: 390px;
    }

    .experiment-stage--tree {
      min-height: 470px;
    }

    .experiment-viewport--tree {
      --lab-hit-width: 60%;
      width: 100%;
      height: 470px;
    }

    .experiment-stage--root-network {
      min-height: 450px;
    }

    .experiment-viewport--root-network {
      --lab-hit-width: 62%;
      width: 100%;
      height: 450px;
    }

    .experiment-stage--waterdrop {
      min-height: 390px;
    }

    .experiment-viewport--waterdrop {
      --lab-hit-width: 48%;
      width: 100%;
      height: 390px;
    }

    .experiment-stage--river-flow {
      min-height: 430px;
    }

    .experiment-viewport--river-flow {
      --lab-hit-width: 68%;
      width: 100%;
      height: 430px;
    }

    .experiment-stage--segmented-ring {
      min-height: 400px;
    }

    .experiment-viewport--segmented-ring {
      --lab-hit-width: 62%;
      width: 100%;
      height: 400px;
    }

    .experiment-footer p + p {
      margin-top: 8px;
      text-align: left;
    }
  }
</style>